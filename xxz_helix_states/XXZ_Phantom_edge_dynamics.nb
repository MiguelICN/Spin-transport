 RowBox[{
  RowBox[{
   RowBox[{"recordDifference", "[", 
    RowBox[{"a_List", ",", "b_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "errs", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "a", "]"}], "!=", 
          RowBox[{"Length", "[", "b", "]"}]}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"And", "@@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Keys", "[", "#1", "]"}], "===", 
               RowBox[{"Keys", "[", "#2", "]"}]}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}]}]}], ",", 
        RowBox[{"Return", "[", "Infinity", "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"errs", "=", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ra", ",", "rb"}], "}"}], ",", 
           RowBox[{"Max", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"Sequence", "@@", 
              RowBox[{"MapThread", "[", "\n", "  ", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"MissingQ", "[", "#1", "]"}], " ", "&&", " ", 
                    RowBox[{"MissingQ", "[", "#2", "]"}]}], ",", "0.", ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"MissingQ", "[", "#1", "]"}], " ", "||", " ", 
                    RowBox[{"MissingQ", "[", "#2", "]"}]}], ",", "Infinity", ",", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"NumberQ", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], ",", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}], ",", 
                    RowBox[{"maxAbs", "[", 
                    RowBox[{"#1", "-", "#2"}], "]"}]}], "]"}]}], "]"}]}], 
                  "]"}], "&"}], ",", "\n", "  ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Values", "[", "ra", "]"}], ",", 
                  RowBox[{"Values", "[", "rb", "]"}]}], "}"}]}], "]"}]}]}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"Max", "[", 
       RowBox[{"0.", ",", 
        RowBox[{"Sequence", "@@", "errs"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
