                    RowBox[{"1", ",", "4"}], "]"}]}], "]"}]}]}], "|>"}]}], 
              "]"}]}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"stateRecord", "[", 
             RowBox[{
              RowBox[{"ts", "[", 
               RowBox[{"[", "k", "]"}], "]"}], ",", 
              RowBox[{"a", " ", ".", " ", 
               RowBox[{"task", "[", "\"\<EdgeFactor\>\"", "]"}]}], ",", "eng",
               ",", 
              RowBox[{"task", "[", "\"\<InitialFactor\>\"", "]"}], ",", 
              RowBox[{"task", "[", "\"\<InitialRhoAB\>\"", "]"}], ",", 
              RowBox[{"task", "[", "\"\<InitialPurity\>\"", "]"}]}], "]"}], ",",
             "raw"}], "}"}]}], ",", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "ts", "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"state", "=", 
       RowBox[{"pairs", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      RowBox[{"channel", "=", 
       RowBox[{"finishChannel", "[", 
        RowBox[{
         RowBox[{"pairs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "ts", ",", "cfg"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"drop", "=", 
       RowBox[{"Boole", "[", 
        RowBox[{"TrueQ", "[", 
