Cell["\<\
 Optional benchmark: change False to True in the next input cell to run. It \
uses saved run inputs and evaluates the trajectory twice. Launch is timed \
separately; setup, transfer and cleaning remain inside run timings. After the \
final context-restoration cell, qualify workflow symbols with \
XXZPhantomDynamics`. \
\>", "Text",ExpressionUUID->"410122f3-2c53-924c-8709-81a1bf701477"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[400]:=",ExpressionUUID->"1373656d-78a9-7f45-a066-f28b90ea8554"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{"False", ",", "\n", " ", 
     RowBox[{
      RowBox[{"exBenchmark", "=", 
       RowBox[{"benchmarkDynamics", "[", 
        RowBox[{
        "exEngine", ",", "exEdgeStateUsed", ",", "exTimes", ",", 
         "exSettingsUsed", ",", "exProbesUsed"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Print", "[", 
       RowBox[{"Dataset", "[", 
        RowBox[{"{", "exBenchmark", "}"}], "]"}], "]"}], ";"}]}], "\n", "]"}],
    ";"}], "\n"}]], "Code",
 CellLabel->
  "In[401]:=",ExpressionUUID->"1b1225cd-0083-6944-a42b-1287070cef16"],

Cell["\<\
  Raw data access, with k a time index: exRecords[[k]][\"RhoAB\"] : reduced \
edge state, trace 1. exMapRecords[[k]][\"Choi\"] : unnormalized Choi, trace \
4. exMapRecords[[k]][\"ChoiState\"]: normalized Choi, trace 1. \
exMapRecords[[k]][\"Transfer\"] : row-vectorized map. \
applyTransfer[exMapRecords[[k]][\"Transfer\"],yourEdgeDensityMatrix] For ZZ, \
\"DephasingFactors\" is the complete 4x4 Gamma(t).  \
\>", "Text",ExpressionUUID->"c8a7c8fa-2661-0a49-be38-45c03b310d45"]
}, Closed]],

