     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"a", "==", "b"}], ",", 
        RowBox[{
         RowBox[{"a", "-=", "1"}], ";", 
         RowBox[{"b", "+=", "1"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"#", ",", 
           RowBox[{"tex", "[", 
