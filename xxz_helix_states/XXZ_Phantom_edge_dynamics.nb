Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Plot", " ", "one", " ", "vector"}], "-", 
    RowBox[{
    "valued", " ", "observable", " ", "without", " ", "constructing", " ", 
     "other", " ", 
     RowBox[{"figures", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"selectedVectorPlot", "[", 
      RowBox[{
      "records_", ",", "field_", ",", "n_", ",", "ylabel_", ",", "title_", ",",
        "legends_", ",", "snap_", ",", 
       RowBox[{"log_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"curves", ",", "styles", ",", "g"}], "}"}], ",", 
       RowBox[{
        RowBox[{"curves", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"v", "=", 
                   RowBox[{"Lookup", "[", 
                    RowBox[{"r", ",", "field", ",", 
                    RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], 
                    "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"r", "[", "\"\<Time\>\"", "]"}], ",", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"ListQ", "[", "v", "]"}], "&&", 
                    RowBox[{
                    RowBox[{"Length", "[", "v", "]"}], ">=", "k"}]}], ",", 
                    RowBox[{"v", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", 
                    RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], 
                    "]"}]}], "}"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"r", ",", "records"}], "}"}]}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"NumericQ", "[", 
                RowBox[{"Last", "[", "#", "]"}], "]"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"!", "log"}], "||", 
                 RowBox[{
                  RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], ")"}]}], 
              "&"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"curves", ",", 
            RowBox[{
             RowBox[{"#", "===", 
              RowBox[{"{", "}"}]}], "&"}]}], "]"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"Column", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"tex", "[", 
               RowBox[{"title", ",", "20"}], "]"}], ",", 
              RowBox[{"tex", "[", 
               
               RowBox[{"\"\<\\\\text{No valid samples under the selected \
tolerances.}\>\"", ",", "14"}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"styles", "=", 
         RowBox[{"curveStyles", "[", "n", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"g", "=", 
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
           RowBox[{"framePlot", "[", 
            RowBox[{
            "curves", ",", "\"\<t\>\"", ",", "ylabel", ",", "styles", ",", 
             "legends", ",", "False", ",", "log", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
               RowBox[{"{", "n", "}"}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"plotPanel", "[", 
         RowBox[{"title", ",", 
          RowBox[{"trajectoryCaption", "[", 
           RowBox[{"snap", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Build", " ", "only", " ", "the", " ", "figures", " ", "selected", " ", 
     "in", " ", "your", " ", 
     RowBox[{"screenshot", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"selectedDynamicsPlots", "[", 
      RowBox[{"records_", ",", "mapRecords_", ",", "snap_", ",", 
       RowBox[{"log_", ":", "False"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"state", "=", 
          RowBox[{"<|", "|>"}]}], ",", 
         RowBox[{"channel", "=", 
          RowBox[{"<|", "|>"}]}], ",", "stateKeys", ",", "channelKeys", ",", 
         "pairs", ",", "basis", ",", "curves", ",", "g"}], "}"}], ",", 
       RowBox[{
        RowBox[{"stateKeys", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<Concurrence\>\"", ",", "\"\<CurrentLeft\>\"", 
           ",", "\"\<CurrentRight\>\"", ",", "\"\<EntropyA\>\"", 
           ",", "\"\<EntropyAB\>\"", ",", "\"\<EntropyB\>\"", 
           ",", "\"\<FullOverlap\>\"", ",", "\"\<MutualInfo\>\"", 
           ",", "\"\<Negativity\>\"", ",", "\"\<Purity\>\"", 
           ",", "\"\<PurityA\>\"", ",", "\"\<PurityB\>\""}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"AssociateTo", "[", 
           RowBox[{"state", ",", 
            RowBox[{"key", "->", 
             RowBox[{"recordPlot", "[", 
              RowBox[{"records", ",", 
               RowBox[{"{", "key", "}"}], ",", 
               RowBox[{"observableLabel", "[", "key", "]"}], ",", 
               RowBox[{"observableTitle", "[", "key", "]"}], ",", "snap", ",",
                "log"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "stateKeys"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AssociateTo", "[", 
         RowBox[{"state", ",", 
          RowBox[{"\"\<EdgeDensityEigenvalues\>\"", "->", 
