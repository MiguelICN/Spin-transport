        RowBox[{"FindDivisions", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"a", ",", "b"}], "}"}], ",", "5"}], "]"}]}], ")"}]}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"logTicks", "[", 
     RowBox[{
      RowBox[{"lo_", "?", "NumericQ"}], ",", 
      RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"#", " ", 
           RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
