        RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
        RowBox[{"\"\<ChoiState\>\"", "->", 
         RowBox[{"c", "/", "4"}]}], ",", 
        RowBox[{"\"\<Transfer\>\"", "->", 
         RowBox[{"choiToTransfer", "[", "c", "]"}]}], ",", 
        RowBox[{"\"\<TransferDerivative\>\"", "->", 
         RowBox[{"choiToTransfer", "[", "cd", "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"finishChannel", "[", 
    RowBox[{"recs_List", ",", "times_List", ",", "cfg_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dist", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"recs", ",", "\"\<BLPDistance\>\""}], "]"}]}], ",", "rhp", ",",
        "dt", ",", "out", ",", "acc", ",", "ratio"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"acc", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "dist", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], ",", 
         "0."}], "]"}]}], ";", "\n", " ", 
      RowBox[{"out", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dt", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"times", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "-", 
              RowBox[{"times", "[", 
               RowBox[{"[", 
                RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"rhp", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"recs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                 "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
                RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",",
                "\n", "   ", 
               RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
               "\n", "   ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"KeyExistsQ", "[", 
                  RowBox[{
                   RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], 
                   ",", "\"\<DephasingFactors\>\""}], "]"}], ",", "\n", 
                 "    ", 
                 RowBox[{
                  RowBox[{"ratio", "=", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}], "/", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}]}]}], ";", 
                  RowBox[{"Max", "[", 
                   RowBox[{"0.", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"traceNormHermitian", "[", "ratio", "]"}], "/", 
                    "4"}], "-", "1"}]}], "]"}]}], ",", "\n", "    ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"0.", ",", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"traceNormHermitian", "[", 
                    RowBox[{"transferToChoi", "[", 
                    RowBox[{"rightSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Transfer\>\"", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<Transfer\>\"", "]"}]}], "]"}], "]"}], "]"}], "/",
                     "4"}], "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
          ";", "\n", "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"recs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<BLPAccumulated\>\"", "->", 
               RowBox[{"acc", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<RHPFiniteStep\>\"", "->", "rhp"}], ",", "\n", 
              "   ", 
              RowBox[{"\"\<RHPFiniteStepRate\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MissingQ", "[", "rhp", "]"}], ",", "rhp", ",", 
                 RowBox[{"rhp", "/", "dt"}]}], "]"}]}]}], "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "recs", "]"}]}], "}"}]}], "]"}]}], ";", 
      "out"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"cleanRecords", "[", 
    RowBox[{"records_List", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"rec", ",", 
       RowBox[{"Association", "[", 
        RowBox[{"KeyValueMap", "[", "\n", " ", 
