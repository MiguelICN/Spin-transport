Cell["\<\
  0.3 Bulk fields, table energies and complex Hermitian diagonalization  \
\>", "Subsection",ExpressionUUID->"aa139d9d-6a45-5548-9247-5db3cdc419da"],

Cell[BoxData[""], "Input",
 CellLabel->"In[45]:=",ExpressionUUID->"8aea15a4-93fc-da4a-b140-bac31e5bfc82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"phantomModel", "[", 
    RowBox[{"cfg_Association", ",", "regime_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "j", ",", "gam", ",", "f", ",", "s", ",", "b", ",", "phi"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "j", ",", "gam", ",", "f", ",", "s", ",", "b"}], 
        "}"}], "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"cfg", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<N\>\"", ",", "\"\<J\>\"", ",", "\"\<Gamma\>\"", 
           ",", "\"\<Family\>\"", ",", "\"\<Handedness\>\"", 
           ",", "\"\<BoundaryBranch\>\""}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "n", "]"}], " ", "&&", " ", 
         RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
         RowBox[{"realQ", "[", "j", "]"}], " ", "&&", " ", 
         RowBox[{"j", "!=", "0"}], " ", "&&", " ", 
         RowBox[{"realQ", "[", "gam", "]"}]}], 
        ",", "\"\<Invalid N, J or Gamma.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"1", ",", "2"}], "}"}], ",", "f"}], "]"}], " ", "&&", " ", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", "s"}], "]"}], " ", "&&",
          " ", 
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<PMC\>\"", ",", "\"\<Alternative\>\""}], "}"}], ",", 
           "b"}], "]"}]}], 
        ",", "\"\<Invalid helix family, sign or branch.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<ZZ\>\"", ",", "\"\<Exchange\>\""}], "}"}], ",", 
           "regime"}], "]"}], " ", "&&", " ", 
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<g\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<g\>\"", "]"}], "!=", "0"}]}], 
        ",", "\"\<Choose ZZ/Exchange and a nonzero real g.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"phi", "=", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"b", "===", "\"\<Alternative\>\""}], ",", 
           RowBox[{
            RowBox[{"s", 
             RowBox[{"(", 
              RowBox[{"n", "-", "1"}], ")"}], "gam"}], "+", "Pi"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"f", "==", "1"}], ",", 
             RowBox[{"s", 
              RowBox[{"(", 
               RowBox[{"n", "-", "3"}], ")"}], "gam"}], ",", 
             RowBox[{"s", 
              RowBox[{"(", 
               RowBox[{"n", "+", "1"}], ")"}], "gam"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<N\>\"", "->", "n"}], ",", 
        RowBox[{"\"\<L\>\"", "->", 
         RowBox[{"n", "+", "2"}]}], ",", 
        RowBox[{"\"\<J\>\"", "->", "j"}], ",", 
        RowBox[{"\"\<Gamma\>\"", "->", "gam"}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", 
         RowBox[{"Cos", "[", "gam", "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<DeltaZ\>\"", "->", 
         RowBox[{"j", " ", 
          RowBox[{"Cos", "[", "gam", "]"}]}]}], ",", 
        RowBox[{"\"\<Family\>\"", "->", "f"}], ",", 
        RowBox[{"\"\<Handedness\>\"", "->", "s"}], ",", 
        RowBox[{"\"\<BoundaryBranch\>\"", "->", "b"}], ",", "\n", "  ", 
        RowBox[{"\"\<Phi\>\"", "->", "phi"}], ",", 
        RowBox[{"\"\<g\>\"", "->", 
         RowBox[{"cfg", "[", "\"\<g\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Regime\>\"", "->", "regime"}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"phantomKet", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"productKet", "[", 
    RowBox[{"Table", "[", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "\"\<Family\>\"", "]"}], "==", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", 
           RowBox[{"Exp", "[", 
            RowBox[{"I", " ", 
             RowBox[{"p", "[", "\"\<Handedness\>\"", "]"}], 
             RowBox[{"(", 
              RowBox[{"k", "-", "2"}], ")"}], 
             RowBox[{"p", "[", "\"\<Gamma\>\"", "]"}]}], "]"}]}]}], "}"}], ",",
         "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", " ", 
            RowBox[{"p", "[", "\"\<Handedness\>\"", "]"}], " ", "k", " ", 
            RowBox[{"p", "[", "\"\<Gamma\>\"", "]"}]}], "]"}]}], "}"}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chooseBulkKet", "[", 
    RowBox[{"p_", ",", "choice_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"choice", "===", "\"\<Analytic\>\""}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"phantomKet", "[", "p", "]"}], "]"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<UploadedPhantom\>\"", 
             ",", "\"\<UploadedSpinCurMax\>\""}], "}"}], ",", "choice"}], 
          "]"}], " ", "&&", " ", 
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"suppliedBulkData", ",", 
           RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], "]"}]}], ",", "\n", 
        "  ", "\"\<Uploaded choices exist only for N=4,...,10; use Analytic \
for another size.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "\"\<Family\>\"", "]"}], "==", "1"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Handedness\>\"", "]"}], "==", "1"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"p", "[", "\"\<BoundaryBranch\>\"", "]"}], 
          "===", "\"\<PMC\>\""}], " ", "&&", "\n", "  ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"p", "[", "\"\<Gamma\>\"", "]"}], "-", 
             RowBox[{"Pi", "/", "3"}]}], "]"}], "]"}], "<", 
          RowBox[{"10", "^", 
           RowBox[{"-", "13"}]}]}]}], 
        ",", "\"\<The uploaded vectors require Family 1, sign +, PMC, \
Gamma=Pi/3.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"v", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"suppliedBulkData", "[", 
          RowBox[{"p", "[", "\"\<N\>\"", "]"}], "]"}], "[", "choice", "]"}], 
        "]"}]}], ";", 
      RowBox[{"v", "/", 
       RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tableEnergy", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"eb", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<DeltaZ\>\"", "]"}], "/", "4"}]}], ",", "el", ",",
        "er"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"el", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "\"\<Family\>\"", "]"}], "==", "1"}], ",", 
         RowBox[{"-", "eb"}], ",", "eb"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"er", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "\"\<BoundaryBranch\>\"", "]"}], 
          "===", "\"\<PMC\>\""}], ",", "el", ",", 
         RowBox[{"-", "el"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<BondEnergy\>\"", "->", "eb"}], ",", 
        RowBox[{"\"\<LeftFieldEnergy\>\"", "->", "el"}], ",", 
        RowBox[{"\"\<RightFieldEnergy\>\"", "->", "er"}], ",", "\n", "  ", 
        RowBox[{"\"\<TotalEnergy\>\"", "->", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<N\>\"", "]"}], "-", "1"}], ")"}], "eb"}], 
          "+", "el", "+", "er"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkParts", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], ",", "x", ",", "y", ",", "z", 
       ",", "bonds", ",", "left", ",", "right"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"#", "/", "2"}], "]"}], "&"}], " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"PauliMatrix", " ", "/@", " ", 
          RowBox[{"Range", "[", "3", "]"}]}], ")"}]}]}], ";", "\n", " ", 
      RowBox[{"bonds", "=", 
       RowBox[{
        RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bondOp", "[", 
            RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
           RowBox[{"bondOp", "[", 
            RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", 
           RowBox[{
            RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
            RowBox[{"bondOp", "[", 
             RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"left", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], "/", "2"}], " ", 
        RowBox[{"siteOp", "[", 
         RowBox[{"x", ",", "1", ",", "n"}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"right", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], "/", "2"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Cos", "[", 
            RowBox[{"p", "[", "\"\<Phi\>\"", "]"}], "]"}], " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"x", ",", "n", ",", "n"}], "]"}]}], "+", 
          RowBox[{
           RowBox[{"Sin", "[", 
            RowBox[{"p", "[", "\"\<Phi\>\"", "]"}], "]"}], " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"y", ",", "n", ",", "n"}], "]"}]}]}], ")"}]}]}], ";", 
      "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Bonds\>\"", "->", 
         RowBox[{"N", "[", "bonds", "]"}]}], ",", 
        RowBox[{"\"\<LeftField\>\"", "->", 
         RowBox[{"N", "[", "left", "]"}]}], ",", 
        RowBox[{"\"\<RightField\>\"", "->", 
         RowBox[{"N", "[", "right", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkHamiltonian", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Values", "[", 
     RowBox[{"bulkParts", "[", "p", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fullHamiltonian", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], ",", 
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "x", ",", "y", ",", "z", 
       ",", "h"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{"#", "/", "2"}], "]"}], "&"}], " ", "/@", " ", 
        RowBox[{"(", 
         RowBox[{"PauliMatrix", " ", "/@", " ", 
          RowBox[{"Range", "[", "3", "]"}]}], ")"}]}]}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"id", "[", "2", "]"}], ",", 
         RowBox[{"bulkHamiltonian", "[", "p", "]"}], ",", 
         RowBox[{"id", "[", "2", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"h", "+", 
       RowBox[{"N", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"p", "[", "\"\<Regime\>\"", "]"}], "===", "\"\<ZZ\>\""}], ",", 
          RowBox[{
           RowBox[{"p", "[", "\"\<g\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "1", ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", 
               RowBox[{"l", "-", "1"}], ",", "l"}], "]"}]}], ")"}]}], ",", 
          "\n", "  ", 
          RowBox[{
           RowBox[{"p", "[", "\"\<g\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "1", ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "1", ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", 
               RowBox[{"l", "-", "1"}], ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", 
               RowBox[{"l", "-", "1"}], ",", "l"}], "]"}]}], ")"}]}]}], "]"}],
         "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"complexED", "[", 
    RowBox[{"h0_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"N", "[", 
         RowBox[{"SparseArray", "[", "h0", "]"}], "]"}]}], ",", "d", ",", 
       "scale", ",", "est", ",", "e", ",", "rows", ",", "order", ",", "v", ",",
        "ix", ",", "res", ",", "orth"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"Length", "[", "h", "]"}]}], ";", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"h", "-", 
           RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], "]"}], "<=", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], " ", "scale"}]}], 
        ",", "\"\<Hamiltonian is not Hermitian.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"est", "=", 
       RowBox[{"8.", " ", "16.", " ", 
        RowBox[{
         RowBox[{"d", "^", "2"}], "/", 
         RowBox[{"2", "^", "20"}]}]}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"est", "<=", 
         RowBox[{"cfg", "[", "\"\<DenseWorkingMemoryMB\>\"", "]"}]}], 
        ",", "\"\<Conservative dense ED memory estimate exceeds \
DenseWorkingMemoryMB. Reduce N or raise the explicit memory limit.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "rows"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{
         RowBox[{"Normal", "[", "h", "]"}], "+", 
         RowBox[{"0.", "I"}]}], "]"}]}], ";", 
      RowBox[{"order", "=", 
       RowBox[{"Ordering", "[", 
        RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"e", "[", 
         RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"v", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"rows", "[", 
         RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"ix", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"d", "/", "2"}], "]"}], ",", "d"}], "}"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"res", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{"h", " ", ".", " ", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "ix"}], "]"}], "]"}]}], "-", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "ix", "]"}], "]"}], " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "ix"}], "]"}], "]"}], "]"}]}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"orth", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "ix"}], "]"}], "]"}], "]"}], " ", ".", " ", 
          RowBox[{"v", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "ix"}], "]"}], "]"}]}], "-", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"Length", "[", "ix", "]"}], "]"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{"res", "/", "scale"}], ",", "orth"}], "]"}], "<", 
         RowBox[{"100", " ", 
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}]}]}], 
        ",", "\"\<Complex ED residual/orthogonality check failed.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<E\>\"", "->", "e"}], ",", 
        RowBox[{"\"\<V\>\"", "->", "v"}], ",", 
        RowBox[{"\"\<Dimension\>\"", "->", "d"}], ",", 
        RowBox[{"\"\<EstimatedDenseWorkingMemoryMB\>\"", "->", "est"}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<SampledEigenvectorResidual\>\"", "->", "res"}], ",", 
        RowBox[{"\"\<SampledOrthogonalityError\>\"", "->", "orth"}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkEigenAudit", "[", 
    RowBox[{"p_", ",", "v_", ",", "cfg_", ",", 
     RowBox[{"ed_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "parts", ",", "en", ",", "e0", ",", "energy", ",", "res", ",",
        "dec", ",", "near", ",", "weight", ",", "contrib", ",", "scale"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"parts", "=", 
       RowBox[{"bulkParts", "[", "p", "]"}]}], ";", 
      RowBox[{"h", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Values", "[", "parts", "]"}], "]"}]}], ";", 
      RowBox[{"en", "=", 
       RowBox[{"tableEnergy", "[", "p", "]"}]}], ";", 
      RowBox[{"e0", "=", 
       RowBox[{"N", "[", 
        RowBox[{"en", "[", "\"\<TotalEnergy\>\"", "]"}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"energy", "=", 
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", 
         RowBox[{"(", 
          RowBox[{"h", " ", ".", " ", "v"}], ")"}]}], "]"}]}], ";", 
      RowBox[{"res", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{"h", " ", ".", " ", "v"}], "-", 
         RowBox[{"e0", " ", "v"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"dec", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ed", "===", "Automatic"}], ",", 
         RowBox[{"complexED", "[", 
          RowBox[{"h", ",", "cfg"}], "]"}], ",", "ed"}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"near", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"dec", "[", "\"\<E\>\"", "]"}], "-", "e0"}], "]"}], ",", 
          RowBox[{"x_", "/;", 
           RowBox[{"x", "<=", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], " ", 
             "scale"}]}]}]}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"weight", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"near", "===", 
          RowBox[{"{", "}"}]}], ",", "0.", ",", 
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", 
             RowBox[{
              RowBox[{"dec", "[", "\"\<V\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "near"}], "]"}], "]"}], "]"}], " ", ".", 
            " ", "v"}], "]"}], "^", "2"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"contrib", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{"#", " ", ".", " ", "v"}], ")"}]}], "]"}], "&"}], ",", 
         "parts"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"res", "<", 
          RowBox[{"100", " ", 
           RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], " ", "scale"}]}],
          " ", "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"weight", "-", "1"}], "]"}], "<", 
          RowBox[{"100", " ", 
           RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}]}]}]}], ",", "\n", 
        "  ", "\"\<The chosen bulk vector failed the table-energy / \
eigenspace-projection test.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<N\>\"", "->", 
         RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], ",", 
        RowBox[{"\"\<L\>\"", "->", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Family\>\"", "->", 
         RowBox[{"p", "[", "\"\<Family\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Handedness\>\"", "->", 
         RowBox[{"p", "[", "\"\<Handedness\>\"", "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<BoundaryBranch\>\"", "->", 
         RowBox[{"p", "[", "\"\<BoundaryBranch\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Phi\>\"", "->", 
         RowBox[{"p", "[", "\"\<Phi\>\"", "]"}]}], ",", 
        RowBox[{"\"\<TableEnergy\>\"", "->", "e0"}], ",", "\n", "  ", 
        RowBox[{"\"\<ExpectationEnergy\>\"", "->", "energy"}], ",", 
        RowBox[{"\"\<ClosestDiagonalizedEnergy\>\"", "->", 
         RowBox[{"First", "[", 
          RowBox[{"MinimalBy", "[", 
           RowBox[{
            RowBox[{"dec", "[", "\"\<E\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#", "-", "e0"}], "]"}], "&"}]}], "]"}], "]"}]}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<EnergyError\>\"", "->", 
         RowBox[{"Abs", "[", 
          RowBox[{"energy", "-", "e0"}], "]"}]}], ",", 
        RowBox[{"\"\<EigenstateResidual\>\"", "->", "res"}], ",", "\n", "  ", 
        RowBox[{"\"\<DegenerateEigenspaceDimension\>\"", "->", 
         RowBox[{"Length", "[", "near", "]"}]}], ",", 
        RowBox[{"\"\<WeightInCorrectEigenspace\>\"", "->", "weight"}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<Contributions\>\"", "->", "contrib"}], ",", 
        RowBox[{"\"\<HelixTableContributions\>\"", "->", "en"}], ",", "\n", 
        "  ", 
        RowBox[{"\"\<FidelityWithAnalyticHelix\>\"", "->", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Conjugate", "[", 
