Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"helix", "[", 
    RowBox[{"n_Integer", ",", "q_", ",", 
     RowBox[{"theta_", ":", 
      RowBox[{"Pi", "/", "2"}]}], ",", 
     RowBox[{"phi_", ":", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"productKet", "[", "\n", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"theta", "/", "2"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", 
           RowBox[{"(", 
            RowBox[{"phi", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}], "q"}]}], ")"}]}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Code",
 CellLabel->"In[38]:=",ExpressionUUID->"3725b6cb-ce5f-4c4e-bb45-c11b1de24835"],

Cell["\<\
  Accept a vector or a positive, trace-one density matrix .  \
\>", "Text",ExpressionUUID->"0f94406f-2d1e-5c44-ba31-3163b83627e3"],

Cell[BoxData[""], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"241a3c39-4b3b-ec45-9f97-f05ecddd7f40"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stateFactor", "[", 
    RowBox[{"input_", ",", "dim_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Normal", "[", "input", " ", "]"}], "]"}]}], ",", "e", ",", 
       "v", ",", "keep"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"VectorQ", "[", 
         RowBox[{"x", ",", "NumericQ"}], "]"}], ",", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "x", "]"}], "==", "dim"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Norm", "[", "x", "]"}], ">", "0"}]}], 
           ",", "\"\<Invalid state vector.\>\""}], "]"}], ";", "\n", "  ", 
         RowBox[{"Return", "[", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"x", "/", 
             RowBox[{"Norm", "[", "x", "]"}]}], "}"}], "]"}], "]"}]}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixQ", "[", 
          RowBox[{"x", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Dimensions", "[", "x", "]"}], "==", 
          RowBox[{"{", 
           RowBox[{"dim", ",", "dim"}], "}"}]}]}], 
        ",", "\"\<Invalid density-matrix dimensions.\>\""}], "]"}], ";", "\n",
       " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{"x", "-", 
             RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], 
            ",", "\"\<Frobenius\>\""}], "]"}], "<=", "tol"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Tr", "[", "x", "]"}], "-", "1"}], "]"}], "<=", "tol"}]}],
         ",", "\n", 
        "  ", "\"\<Density matrix must be Hermitian with trace one.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "v"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"herm", "[", "x", " ", "]"}], "]"}]}], ";", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Min", "[", 
          RowBox[{"Re", "[", "e", " ", "]"}], "]"}], ">=", 
         RowBox[{"-", "tol"}]}], 
        ",", "\"\<Density matrix is not positive.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"e", "=", 
       RowBox[{"Clip", "[", 
        RowBox[{
         RowBox[{"Re", "[", "e", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
      RowBox[{"e", "/=", 
       RowBox[{"Total", "[", "e", "]"}]}], ";", 
      RowBox[{"keep", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", "dim", "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"e", "[", 
            RowBox[{"[", "#", " ", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}],
       ";", "\n", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{
        RowBox[{"Sqrt", "[", 
         RowBox[{"e", "[", 
          RowBox[{"[", "keep", " ", "]"}], "]"}], "]"}], " ", 
        RowBox[{"v", "[", 
         RowBox[{"[", "keep", " ", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]], "Code",
 CellLabel->"In[40]:=",ExpressionUUID->"1dd1b279-3e89-c84c-98e7-0347d0ba08cc"],

Cell["\<\
  Reorder (edge 1,edge L,middle) to physical sites 1,...,L.  \
