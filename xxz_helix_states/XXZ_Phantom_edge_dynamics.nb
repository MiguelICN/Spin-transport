Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ptB", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"r", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
