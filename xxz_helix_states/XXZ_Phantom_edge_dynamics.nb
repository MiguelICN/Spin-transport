Cell[CellGroupData[{

Cell["  1. ZZ coupling: reduced edge state and Choi dynamics  ", "Title",ExpressionUUID->"69735fd7-2e64-dd41-803d-35784efcc813"],

Cell["\<\
  The bulk fields and helix parameters are fixed independently of the two \
probes. The channel is computed from all four edge basis inputs with this one \
fixed bulk state. Editing EdgeState changes the reduced-state experiment, not \
the channel.  \
\>", "Text",ExpressionUUID->"52edb59f-f20b-004b-a2be-1c0c50a3fc92"],

Cell[CellGroupData[{

Cell["  1.1 Independent settings  ", "Subsection",ExpressionUUID->"dd53ed30-2ffe-c240-b2f1-43b0a748dc37"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<N\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Gamma\>\"", "->", 
      RowBox[{"Pi", "/", "3"}]}], ",", 
     RowBox[{"\"\<Family\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Handedness\>\"", "->", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<BoundaryBranch\>\"", "->", "\"\<PMC\>\""}], ",", 
     RowBox[{"\"\<g\>\"", "->", 
      RowBox[{"1", "/", "10"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzBulkChoice", "=", "\"\<UploadedPhantom\>\""}], ";"}]}], "Code",
 CellChangeTimes->{{4.002654045744091*^9, 4.0026540466622505`*^9}, {
  4.002656457553505*^9, 4.0026564576120777`*^9}, {4.0026570201738987`*^9, 
  4.0026570202373447`*^9}, {4.002657607371895*^9, 4.002657607451292*^9}, {
  4.002658202491085*^9, 4.0026582025384216`*^9}, {4.0026587827380886`*^9, 
  4.0026587827860756`*^9}, {4.0026593828297462`*^9, 4.002659383350996*^9}},
 CellLabel->
  "In[369]:=",ExpressionUUID->"a496f59a-b34b-f54e-882a-a9440b595112"],

Cell["\<\
  Choices: \"UploadedPhantom\", \"UploadedSpinCurMax\" (given N=4,...,10), or \
\"Analytic\" (either family/sign/branch and arbitrary real Gamma). Delta is \
derived from Gamma; do not choose them independently. N is bulk length, so \
N=10 means L=12 total spins.  \
\>", "Text",ExpressionUUID->"de5f4c70-a577-2f46-ba04-eecec7eaa9a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeState", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", "4"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Separable", " ", "|", 
    RowBox[{"+", 
     RowBox[{">", "_A"}]}], " ", "|", 
    RowBox[{"+", 
     RowBox[{">", 
      RowBox[{"_B", "."}]}]}]}], " ", "*)"}]}]], "Code",
 CellLabel->
  "In[371]:=",ExpressionUUID->"243fc00a-8920-a849-8c0d-b93c0247c8fd"],

Cell["\<\
  Other pure or mixed edge states are accepted. An initially entangled edge \
state tests its evolution, not generation from a separable preparation.  \
\>", "Text",ExpressionUUID->"9f53ef83-e2ab-2245-a2b8-a6189367ff8b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"zzTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "2000."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}]], "Code",
 CellChangeTimes->{{4.0026540564668427`*^9, 4.0026540571925945`*^9}},
 CellLabel->
  "In[372]:=",ExpressionUUID->"3ba75cc2-d360-f640-94b2-b081b5b4057d"],

Cell["\<\
  ParallelKernels defaults to 12; choose no more than your physical cores \
(preferably leave one for the master). Eight is an alternative only if the \
machine supports it. ParallelMemoryMB limits estimated total master/worker \
working memory. Set ParallelEnabled=False for an optimized serial comparison. \
Diagonalization remains on the master; time propagation and all per-sample \
diagnostics run on workers. Sampling times, observables and export settings \
are preserved; captions explicitly identify spin normalization.  \
\>", "Text",ExpressionUUID->"815e7580-5943-cc4f-8ee1-9531d34fc752"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzSettings", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<DenseWorkingMemoryMB\>\"", "->", "4096"}], ",", 
     RowBox[{"\"\<BatchTimes\>\"", "->", "32"}], ",", 
     RowBox[{"\"\<RecordChop\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<RankTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<DirectReferenceMaximumL\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<ParallelEnabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<ParallelKernels\>\"", "->", "12"}], ",", "\n", " ", 
     RowBox[{"\"\<ParallelMemoryMB\>\"", "->", "16384"}], ",", 
     RowBox[{"\"\<ParallelVerify\>\"", "->", "True"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzProbes", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Rho1\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<Rho2\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1", ",", 
          RowBox[{"-", "1"}]}], "}"}], "/", "2"}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<RhoB\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], "|>"}]}], ";"}]}], "Code",
 CellChangeTimes->{{4.002654064261257*^9, 4.0026540643253403`*^9}, {
  4.002655705056801*^9, 4.0026557051208*^9}},
 CellLabel->
  "In[373]:=",ExpressionUUID->"a48c19f7-25ce-7548-98e9-3a4133d2dd19"],

Cell["\<\
  These probes define only BLP/signalling witnesses, never the channel.  \
\>", "Text",ExpressionUUID->"3dd509a8-2101-cd49-8ca7-dc8587c439b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzEnabled", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzMakePlots", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzExportResults", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzLogHorizontalAxis", "=", "False"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Caption", " ", "and", " ", "log", " ", "axis", " ", "do", " ", "not", " ",
     "change", " ", 
    RowBox[{"samples", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"zzOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzRunLabel", "=", "\"\<Phantom_ZZ_N4\>\""}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Keep", " ", "short", " ", "for", " ", "Windows", " ", 
    RowBox[{"paths", "."}]}], " ", "*)"}]}]}], "Code",
 CellLabel->
  "In[375]:=",ExpressionUUID->"d22fd809-f4e7-db49-9a70-a60787cfdd55"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.2 Verify this bulk ket, then construct only occupied invariant blocks  \
\>", "Subsection",ExpressionUUID->"455c3314-a2d6-cf43-afff-d0c3178f049d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "zzEnabled", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"zzModelUsed", "=", 
      RowBox[{"phantomModel", "[", 
       RowBox[{"zzModel", ",", "\"\<ZZ\>\""}], "]"}]}], ";", "\n", " ", 
     RowBox[{"zzBulkChoiceUsed", "=", "zzBulkChoice"}], ";", 
     RowBox[{"zzSettingsUsed", "=", "zzSettings"}], ";", "\n", " ", 
     RowBox[{"zzBulkKet", "=", 
      RowBox[{"chooseBulkKet", "[", 
       RowBox[{"zzModelUsed", ",", "zzBulkChoiceUsed"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"zzBulkAudit", "=", 
      RowBox[{"bulkEigenAudit", "[", 
       RowBox[{"zzModelUsed", ",", "zzBulkKet", ",", "zzSettingsUsed"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"{", "zzBulkAudit", "}"}], "]"}], "]"}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"zzSetupSeconds", ",", "zzEngine"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"buildEngine", "[", 
        RowBox[{"zzModelUsed", ",", "zzBulkKet", ",", "zzSettingsUsed"}], 
        "]"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{"zzEngine", "[", "\"\<BulkMagnetizationAudit\>\"", "]"}], 
