           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<N\>\"", "->", "n"}], ",", 
             RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<Gamma\>\"", "->", 
              RowBox[{"Pi", "/", "3"}]}], ",", 
             RowBox[{"\"\<Family\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<Handedness\>\"", "->", "1"}], ",", 
             RowBox[{"\"\<BoundaryBranch\>\"", "->", "\"\<PMC\>\""}], ",", 
             RowBox[{"\"\<g\>\"", "->", 
              RowBox[{"1", "/", "10"}]}]}], "|>"}], ",", "\"\<ZZ\>\""}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"h", "=", 
         RowBox[{"bulkHamiltonian", "[", "p", "]"}]}], ";", 
        RowBox[{"ed", "=", 
         RowBox[{"complexED", "[", 
          RowBox[{"h", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"vec", "=", 
            RowBox[{"chooseBulkKet", "[", 
             RowBox[{"p", ",", "key"}], "]"}]}], ";", 
           RowBox[{"audit", "=", 
            RowBox[{"bulkEigenAudit", "[", 
             RowBox[{"p", ",", "vec", ",", "cfg", ",", "ed"}], "]"}]}], ";", 
           "\n", "  ", 
           RowBox[{"uploaded", "=", 
            RowBox[{
             RowBox[{"suppliedBulkData", "[", "n", "]"}], "[", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"key", "===", "\"\<UploadedPhantom\>\""}], 
               ",", "\"\<UploadedPhantomEnergy\>\"", 
               ",", "\"\<UploadedSpinCurMaxEnergy\>\""}], "]"}], "]"}]}], ";",
            "\n", "  ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"KeyTake", "[", 
              RowBox[{"audit", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<N\>\"", ",", "\"\<L\>\"", ",", "\"\<Phi\>\"", 
                 ",", "\"\<TableEnergy\>\"", 
                 ",", "\"\<ClosestDiagonalizedEnergy\>\"", 
                 ",", "\"\<EigenstateResidual\>\"", ",", "\n", 
                 "    ", "\"\<DegenerateEigenspaceDimension\>\"", 
                 ",", "\"\<WeightInCorrectEigenspace\>\"", 
                 ",", "\"\<Passed\>\""}], "}"}]}], "]"}], ",", "\n", "   ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<State\>\"", "->", "key"}], ",", 
               RowBox[{"\"\<UploadedEnergy\>\"", "->", "uploaded"}], ",", 
               "\n", "    ", 
               RowBox[{"\"\<DiagonalizedEnergyInUploadedConvention\>\"", "->", 
                RowBox[{
                 RowBox[{"-", "4"}], " ", 
                 RowBox[{
                 "audit", "[", "\"\<ClosestDiagonalizedEnergy\>\"", "]"}]}]}],
                ",", "\n", "    ", 
               RowBox[{"\"\<UploadedConventionEnergyError\>\"", "->", 
                RowBox[{"Abs", "[", 
                 RowBox[{"uploaded", "+", 
                  RowBox[{"4", " ", 
                   RowBox[{
                   "audit", "[", "\"\<ClosestDiagonalizedEnergy\>\"", 
                    "]"}]}]}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"\"\<UploadedEnergyPlus4TableEnergy\>\"", "->", 
                RowBox[{"Chop", "[", 
                 RowBox[{
                  RowBox[{"uploaded", "+", 
                   RowBox[{"4", " ", 
                    RowBox[{"audit", "[", "\"\<TableEnergy\>\"", "]"}]}]}], ",", 
                  RowBox[{"10", "^", 
                   RowBox[{"-", "12"}]}]}], "]"}]}]}], "|>"}]}], "]"}]}], ",",
           "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"key", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<UploadedPhantom\>\"", 
              ",", "\"\<UploadedSpinCurMax\>\""}], "}"}]}], "}"}]}], 
         "]"}]}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "4", ",", "10"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
