            "v"}], "]"}], "^", "2"}]}], ",", 
        RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"verifySuppliedSizes", "[", "cfg_", "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", 
