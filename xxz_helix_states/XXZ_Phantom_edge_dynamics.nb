Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"entropy", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"e", "=", 
       RowBox[{"Select", "[", 
