Cell[CellGroupData[{

Cell["\<\
  2. Exchange coupling: reduced edge state and Choi dynamics  \
\>", "Title",ExpressionUUID->"1cb64198-d7ce-6d45-bd18-5c9b03abc0de"],

Cell["\<\
  The bulk fields and helix parameters are fixed independently of the two \
probes. The channel is computed from all four edge basis inputs with this one \
fixed bulk state. Editing EdgeState changes the reduced-state experiment, not \
the channel.  \
\>", "Text",ExpressionUUID->"59a13a9f-4067-1648-a837-3665455ab269"],

Cell[CellGroupData[{

Cell["  2.1 Independent settings  ", "Subsection",ExpressionUUID->"5d4ad586-bdab-e84e-9706-687e1d37516f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<N\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Gamma\>\"", "->", 
      RowBox[{"Pi", "/", "3"}]}], ",", 
     RowBox[{"\"\<Family\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Handedness\>\"", "->", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<BoundaryBranch\>\"", "->", "\"\<PMC\>\""}], ",", 
     RowBox[{"\"\<g\>\"", "->", 
      RowBox[{"1", "/", "10"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exBulkChoice", "=", "\"\<UploadedPhantom\>\""}], ";"}]}], "Code",
 CellChangeTimes->{{4.0026544909027214`*^9, 4.002654490961378*^9}, {
  4.0026564713358307`*^9, 4.0026564716919327`*^9}, {4.0026570306673946`*^9, 
  4.002657031268202*^9}, {4.002657618537174*^9, 4.002657618849846*^9}, {
  4.0026582145372677`*^9, 4.0026582149195595`*^9}, {4.002658793812956*^9, 
  4.002658794241213*^9}, {4.002659393885252*^9, 4.0026593943224792`*^9}},
 CellLabel->
  "In[386]:=",ExpressionUUID->"04c16f2d-2212-684e-bb1d-6eda57460c70"],

Cell["\<\
  Choices: \"UploadedPhantom\", \"UploadedSpinCurMax\" (given N=4,...,10), or \
\"Analytic\" (either family/sign/branch and arbitrary real Gamma). Delta is \
derived from Gamma; do not choose them independently. N is bulk length, so \
N=10 means L=12 total spins.  \
\>", "Text",ExpressionUUID->"b0ad2cf4-d9f8-754d-a5eb-7deeee351d95"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"exEdgeState", "=", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"1", "/", "2"}], ",", "4"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Separable", " ", "|", 
    RowBox[{"+", 
     RowBox[{">", "_A"}]}], " ", "|", 
    RowBox[{"+", 
     RowBox[{">", 
      RowBox[{"_B", "."}]}]}]}], " ", "*)"}]}]], "Code",
 CellLabel->
  "In[388]:=",ExpressionUUID->"554b0e2a-0ac3-824d-aab7-5419df4ca8d6"],

Cell["\<\
  Other pure or mixed edge states are accepted. An initially entangled edge \
state tests its evolution, not generation from a separable preparation.  \
\>", "Text",ExpressionUUID->"8c044900-6184-bb4c-8273-444a22d3c81b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"exTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "2000."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}]], "Code",
 CellChangeTimes->{{4.0026544947760468`*^9, 4.0026544953322334`*^9}},
 CellLabel->
  "In[389]:=",ExpressionUUID->"29013966-896d-2346-a486-f7569a099ef7"],

Cell["\<\
  ParallelKernels defaults to 12; choose no more than your physical cores \
(preferably leave one for the master). Eight is an alternative only if the \
machine supports it. ParallelMemoryMB limits estimated total master/worker \
working memory. Set ParallelEnabled=False for an optimized serial comparison. \
Diagonalization remains on the master; time propagation and all per-sample \
diagnostics run on workers. Sampling times, observables and export settings \
are preserved; captions explicitly identify spin normalization.  \
\>", "Text",ExpressionUUID->"55f7acd4-e6eb-c440-8442-0db1017f8fc8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exSettings", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<DenseWorkingMemoryMB\>\"", "->", "4096"}], ",", 
     RowBox[{"\"\<BatchTimes\>\"", "->", "32"}], ",", 
     RowBox[{"\"\<RecordChop\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<RankTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<DirectReferenceMaximumL\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<ParallelEnabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<ParallelKernels\>\"", "->", "12"}], ",", "\n", " ", 
     RowBox[{"\"\<ParallelMemoryMB\>\"", "->", "16384"}], ",", 
     RowBox[{"\"\<ParallelVerify\>\"", "->", "True"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exProbes", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Rho1\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<Rho2\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}], ",", "1", ",", 
          RowBox[{"-", "1"}]}], "}"}], "/", "2"}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<RhoB\>\"", "->", 
      RowBox[{"ketRho", "[", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1"}], "}"}], "]"}]}]}], "|>"}]}], ";"}]}], "Code",
 CellLabel->
  "In[390]:=",ExpressionUUID->"22093f4f-0d4d-4d42-8e82-a94a5281cd0a"],

Cell["\<\
  These probes define only BLP/signalling witnesses, never the channel.  \
\>", "Text",ExpressionUUID->"0a00f70e-3c48-a94f-b79c-fa7cec1fef56"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exEnabled", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exMakePlots", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exExportResults", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exLogHorizontalAxis", "=", "False"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Caption", " ", "and", " ", "log", " ", "axis", " ", "do", " ", "not", " ",
     "change", " ", 
    RowBox[{"samples", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"exOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exRunLabel", "=", "\"\<Phantom_Exchange_N4\>\""}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Keep", " ", "short", " ", "for", " ", "Windows", " ", 
    RowBox[{"paths", "."}]}], " ", "*)"}]}]}], "Code",
 CellLabel->
  "In[392]:=",ExpressionUUID->"0e113aff-389a-0d40-b7fb-354556fff70c"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  2.2 Verify this bulk ket, then construct only occupied invariant blocks  \
\>", "Subsection",ExpressionUUID->"ec80ae94-370d-564e-8f13-c075d0e0cb53"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "exEnabled", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"exModelUsed", "=", 
      RowBox[{"phantomModel", "[", 
       RowBox[{"exModel", ",", "\"\<Exchange\>\""}], "]"}]}], ";", "\n", " ", 
     RowBox[{"exBulkChoiceUsed", "=", "exBulkChoice"}], ";", 
     RowBox[{"exSettingsUsed", "=", "exSettings"}], ";", "\n", " ", 
     RowBox[{"exBulkKet", "=", 
      RowBox[{"chooseBulkKet", "[", 
       RowBox[{"exModelUsed", ",", "exBulkChoiceUsed"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"exBulkAudit", "=", 
      RowBox[{"bulkEigenAudit", "[", 
       RowBox[{"exModelUsed", ",", "exBulkKet", ",", "exSettingsUsed"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"{", "exBulkAudit", "}"}], "]"}], "]"}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"exSetupSeconds", ",", "exEngine"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"buildEngine", "[", 
        RowBox[{"exModelUsed", ",", "exBulkKet", ",", "exSettingsUsed"}], 
        "]"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{"exEngine", "[", "\"\<BulkMagnetizationAudit\>\"", "]"}], 
        "[", "\"\<InitialMagnetizationWeights\>\"", "]"}], "]"}], "]"}], ";", 
     "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"exEngine", "[", "\"\<Occupation\>\"", "]"}], "]"}], "]"}], ";",
      "\n", " ", 
     RowBox[{
     "Print", "[", "\"\<Magnetization is not a conserved block label with \
transverse fields. All connected magnetization slices are retained.\>\"", 
      "]"}], ";"}]}], "\n", "]"}], ";"}]], "Code",
 CellLabel->
  "In[398]:=",ExpressionUUID->"5771a4fa-a142-4c40-9721-5522029c3b04"],

