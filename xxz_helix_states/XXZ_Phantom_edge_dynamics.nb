Cell["\<\
 Optional benchmark: change False to True in the next input cell to run. It \
uses saved run inputs and evaluates the trajectory twice. Launch is timed \
separately; setup, transfer and cleaning remain inside run timings. After the \
final context-restoration cell, qualify workflow symbols with \
XXZPhantomDynamics`. \
\>", "Text",ExpressionUUID->"2f63e697-ad20-de4f-8a9f-a2ccc078984b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{"False", ",", "\n", " ", 
    RowBox[{
     RowBox[{"zzBenchmark", "=", 
      RowBox[{"benchmarkDynamics", "[", 
       RowBox[{
       "zzEngine", ",", "zzEdgeStateUsed", ",", "zzTimes", ",", 
        "zzSettingsUsed", ",", "zzProbesUsed"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"{", "zzBenchmark", "}"}], "]"}], "]"}], ";"}]}], "\n", "]"}], 
  ";"}]], "Code",
 CellChangeTimes->{4.0026540872080746`*^9},
 CellLabel->
  "In[383]:=",ExpressionUUID->"1b633dd6-807e-9c40-b744-906bf926deb7"],

Cell["\<\
  Raw data access, with k a time index: zzRecords[[k]][\"RhoAB\"] : reduced \
edge state, trace 1. zzMapRecords[[k]][\"Choi\"] : unnormalized Choi, trace \
4. zzMapRecords[[k]][\"ChoiState\"]: normalized Choi, trace 1. \
zzMapRecords[[k]][\"Transfer\"] : row-vectorized map. \
applyTransfer[zzMapRecords[[k]][\"Transfer\"],yourEdgeDensityMatrix] For ZZ, \
\"DephasingFactors\" is the complete 4x4 Gamma(t).  \
\>", "Text",ExpressionUUID->"8d56ab3d-6b9d-1a49-9e3c-8285a2191568"]
}, Closed]],

