Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"observables", "[", 
     RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", "z", 
        ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"a", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
       RowBox[{"a1", "=", 
        RowBox[{"traceB", "[", "r", "]"}]}], ";", 
       RowBox[{"b1", "=", 
        RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
        RowBox[{"entropy", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "z"}], "}"}], "=", 
        RowBox[{"PauliMatrix", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
       RowBox[{"ma", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
       RowBox[{"mb", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Sort", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
         RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
         RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
         RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
         RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
         RowBox[{"\"\<Purity\>\"", "->", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
         RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
         RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
         RowBox[{"\"\<MutualInfo\>\"", "->", 
          RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
         RowBox[{"\"\<Concurrence\>\"", "->", 
          RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
         RowBox[{"\"\<Negativity\>\"", "->", 
          RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<InitialOverlap\>\"", "->", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
         RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
         RowBox[{"\"\<ConnectedZZ\>\"", "->", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
            "]"}], "-", 
           RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
         RowBox[{"\"\<ConnectedXX\>\"", "->", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
            "]"}], "-", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
         "\n", "  ", 
