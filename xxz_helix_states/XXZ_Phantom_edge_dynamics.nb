       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<FirstIndex\>\"", "->", 
         RowBox[{"spec", "[", "\"\<FirstIndex\>\"", "]"}]}], ",", 
        RowBox[{"\"\<State\>\"", "->", 
         RowBox[{"Drop", "[", 
          RowBox[{"state", ",", "drop"}], "]"}]}], ",", 
        RowBox[{"\"\<Channel\>\"", "->", 
         RowBox[{"Drop", "[", 
          RowBox[{"channel", ",", "drop"}], "]"}]}], ",", 
        RowBox[{"\"\<KernelID\>\"", "->", "$KernelID"}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chooseParallelPool", "[", 
    RowBox[{"task_", ",", "chunks_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "requested", ",", "enabled", ",", "batch", ",", "d", ",", "bytes", ",", 
       "master", ",", "perWorker", ",", "limit", ",", "target", ",", 
       "available", ",", "pool"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"requested", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"cfg", ",", "\"\<ParallelKernels\>\"", ",", "12"}], "]"}]}], ";", 
      RowBox[{"enabled", "=", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"cfg", ",", "\"\<ParallelEnabled\>\"", ",", "True"}], "]"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "requested", "]"}], " ", "&&", " ", 
         RowBox[{"requested", ">=", "1"}]}], 
        ",", "\"\<ParallelKernels must be a positive integer.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"batch", "=", 
       RowBox[{
        RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "+", "1"}]}], ";", 
      RowBox[{"d", "=", 
       RowBox[{
        RowBox[{"task", "[", "\"\<Engine\>\"", "]"}], "[", "\"\<Dimension\>\"",
         "]"}]}], ";", 
      RowBox[{"bytes", "=", 
       RowBox[{"ByteCount", "[", "task", "]"}]}], ";", "\n", " ", 
      RowBox[{"master", "=", 
       RowBox[{"4.", " ", 
        RowBox[{"bytes", "/", 
         RowBox[{"2", "^", "20"}]}]}]}], ";", 
      RowBox[{"perWorker", "=", 
       RowBox[{"256.", "+", 
        RowBox[{"3.", " ", 
         RowBox[{"bytes", "/", 
          RowBox[{"2", "^", "20"}]}]}], "+", 
        RowBox[{"10.", " ", "16.", " ", "d", " ", "4", " ", 
         RowBox[{"batch", "/", 
          RowBox[{"2", "^", "20"}]}]}]}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{"cfg", ",", "\"\<ParallelMemoryMB\>\"", ",", "16384"}], 
           "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"cfg", ",", "\"\<ParallelMemoryMB\>\"", ",", "16384"}], 
           "]"}], ">", "0"}]}], 
        ",", "\"\<ParallelMemoryMB must be positive.\>\""}], "]"}], ";", "\n",
       " ", 
      RowBox[{"limit", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Lookup", "[", 
              RowBox[{"cfg", ",", "\"\<ParallelMemoryMB\>\"", ",", "16384"}], 
              "]"}], "-", "master"}], ")"}], "/", "perWorker"}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"target", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"requested", ",", 
         RowBox[{"Length", "[", "chunks", "]"}], ",", "limit"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", "enabled"}], " ", "||", " ", 
         RowBox[{"target", "<", "2"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Pool\>\"", "->", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"\"\<RequestedKernels\>\"", "->", "requested"}], ",", "\n",
            "  ", 
           RowBox[{"\"\<EstimatedMasterMB\>\"", "->", "master"}], ",", 
           RowBox[{"\"\<EstimatedPerWorkerMB\>\"", "->", "perWorker"}], ",", 
           "\n", "  ", 
           RowBox[{"\"\<Reason\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"!", "enabled"}], 
              ",", "\"\<ParallelEnabled is False\>\"", 
              ",", "\"\<Fewer than two batches/workers fit the requested \
memory budget\>\""}], "]"}]}]}], "|>"}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"available", "=", 
       RowBox[{"Length", "[", 
        RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"available", "<", "target"}], ",", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"LaunchKernels", "[", 
            RowBox[{"target", "-", "available"}], "]"}], ",", "Null"}], "]"}],
          "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"pool", "=", 
       RowBox[{"Take", "[", 
        RowBox[{
         RowBox[{"Kernels", "[", "]"}], ",", 
         RowBox[{"UpTo", "[", "target", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "pool", "]"}], "<", "2"}], ",", 
        RowBox[{"pool", "=", 
         RowBox[{"{", "}"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Pool\>\"", "->", "pool"}], ",", 
        RowBox[{"\"\<RequestedKernels\>\"", "->", "requested"}], ",", 
        RowBox[{"\"\<EstimatedMasterMB\>\"", "->", "master"}], ",", "\n", 
        "  ", 
        RowBox[{"\"\<EstimatedPerWorkerMB\>\"", "->", "perWorker"}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<Reason\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"pool", "===", 
            RowBox[{"{", "}"}]}], 
           ",", "\"\<Parallel subkernels unavailable; explicit serial \
fallback\>\"", ",", "\"\<Parallel\>\""}], "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"configureWorkerThreads", "[", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"applied", ",", "mkl", ",", "parallel"}], "}"}], ",", "\n", 
      " ", 
      RowBox[{
       RowBox[{"applied", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", "\n", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"SetSystemOptions", "[", 
             RowBox[{"\"\<ParallelOptions\>\"", "->", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<MKLThreadNumber\>\"", "->", "1"}], ",", 
                RowBox[{"\"\<ParallelThreadNumber\>\"", "->", "1"}]}], 
               "}"}]}], "]"}], ";", "True"}], ",", "False"}], "]"}], "]"}]}], 
       ";", "\n", " ", 
       RowBox[{"mkl", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"SystemOptions", "[", 
            
            RowBox[{"\"\<ParallelOptions\>\"", 
             "->", "\"\<MKLThreadNumber\>\""}], "]"}], ",", "$Failed"}], 
          "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"parallel", "=", 
        RowBox[{"Quiet", "[", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"SystemOptions", "[", 
            
            RowBox[{"\"\<ParallelOptions\>\"", 
             "->", "\"\<ParallelThreadNumber\>\""}], "]"}], ",", "$Failed"}], 
          "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Confirmed\>\"", "->", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"applied", " ", "&&", " ", 
            RowBox[{"mkl", "===", 
             RowBox[{"{", 
              RowBox[{"\"\<ParallelOptions\>\"", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<MKLThreadNumber\>\"", "->", "1"}], "}"}]}], 
              "}"}]}], " ", "&&", "\n", "   ", 
            RowBox[{"parallel", "===", 
             RowBox[{"{", 
              RowBox[{"\"\<ParallelOptions\>\"", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<ParallelThreadNumber\>\"", "->", "1"}], "}"}]}], 
              "}"}]}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<MKLThreadSetting\>\"", "->", "mkl"}], ",", 
         RowBox[{"\"\<ParallelThreadSetting\>\"", "->", "parallel"}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evaluateChunks", "[", 
    RowBox[{"task_", ",", "chunks_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "choice", ",", "pool", ",", "setup", ",", "compute", ",", "results", ",",
        "groups", ",", "ids", ",", "serial", ",", "remote", ",", "testSpec", ",", 
       RowBox[{"err", "=", 
        RowBox[{"Missing", "[", "\"\<NotRun\>\"", "]"}]}], ",", "status", ",",
        "workerInfo", ",", "cleanup"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"choice", "=", 
       RowBox[{"chooseParallelPool", "[", 
        RowBox[{"task", ",", "chunks", ",", "cfg"}], "]"}]}], ";", 
      RowBox[{"pool", "=", 
       RowBox[{"choice", "[", "\"\<Pool\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pool", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Serial execution: \>\"", ",", 
           RowBox[{"choice", "[", "\"\<Reason\>\"", "]"}]}], "]"}], ";", "\n",
          "  ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"compute", ",", "results"}], "}"}], "=", 
          RowBox[{"AbsoluteTiming", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dynamicsChunk", "[", 
              RowBox[{"task", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
            "chunks"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Results\>\"", "->", "results"}], ",", 
            RowBox[{"\"\<Performance\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"KeyDrop", "[", 
                RowBox[{"choice", ",", 
                 RowBox[{"{", "\"\<Pool\>\"", "}"}]}], "]"}], ",", "\n", 
               "   ", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<ExecutionMode\>\"", "->", "\"\<Serial\>\""}], ",", 
                 RowBox[{"\"\<KernelsUsed\>\"", "->", "0"}], ",", 
                 RowBox[{"\"\<KernelIDs\>\"", "->", 
                  RowBox[{"{", "0", "}"}]}], ",", 
                 RowBox[{"\"\<WorkerSetupSeconds\>\"", "->", "0."}], ",", 
                 "\n", "    ", 
                 RowBox[{"\"\<BatchComputeSeconds\>\"", "->", "compute"}], ",", 
                 RowBox[{"\"\<ParallelVerificationError\>\"", "->", "err"}]}],
                 "|>"}]}], "]"}]}]}], "|>"}], "]"}]}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Parallel execution: \>\"", ",", 
        RowBox[{"Length", "[", "pool", "]"}], 
        ",", "\"\< kernels (requested \>\"", ",", 
        RowBox[{"choice", "[", "\"\<RequestedKernels\>\"", "]"}], ",", "\n", 
        "  ", "\"\<); \>\"", ",", 
        RowBox[{"Length", "[", "chunks", "]"}], 
        ",", "\"\< time batches; checking worker thread limits.\>\""}], "]"}],
       ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"setup", ",", "status"}], "}"}], "=", 
       RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
        RowBox[{
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{"dynamicsChunk", ",", "configureWorkerThreads"}], "]"}], ";",
          "\n", "  ", 
         RowBox[{"ids", "=", 
          RowBox[{"ParallelEvaluate", "[", 
           RowBox[{"$KernelID", ",", "pool", ",", 
            RowBox[{"DistributedContexts", "->", "None"}]}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"groups", "=", 
          RowBox[{"AssociationThread", "[", 
           RowBox[{"ids", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Pick", "[", 
               RowBox[{"chunks", ",", 
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "chunks", "]"}], "]"}], "-", "1"}],
                   ",", 
                  RowBox[{"Length", "[", "pool", "]"}]}], "]"}], ",", 
                RowBox[{"k", "-", "1"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "pool", "]"}]}], "}"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"packet", "=", "task"}], ",", 
             RowBox[{"assignments", "=", "groups"}]}], "}"}], ",", "\n", 
           "   ", 
           RowBox[{"ParallelEvaluate", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"parallelTask", "=", "packet"}], ";", 
              RowBox[{"parallelJobs", "=", 
               RowBox[{"Lookup", "[", 
                RowBox[{"assignments", ",", "$KernelID"}], "]"}]}], ";", "\n",
               "    ", 
              RowBox[{"parallelThreadLimit", "=", 
               RowBox[{"configureWorkerThreads", "[", "]"}]}], ";", "\n", 
              "    ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<DefinitionsReady\>\"", "->", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Length", "[", 
                    RowBox[{"DownValues", "[", "dynamicsChunk", "]"}], "]"}], 
                   ">", "0"}], ")"}]}], ",", 
                RowBox[{"\"\<KernelID\>\"", "->", "$KernelID"}], ",", "\n", 
                "      ", 
                
                RowBox[{"\"\<ThreadLimit\>\"", "->", 
                 "parallelThreadLimit"}]}], "|>"}]}], ",", "pool", ",", 
             RowBox[{"DistributedContexts", "->", "None"}]}], "]"}]}], 
          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"cleanup", "[", "]"}], " ", ":=", " ", 
       RowBox[{"ParallelEvaluate", "[", 
        RowBox[{
         RowBox[{"Clear", "[", 
          RowBox[{"parallelTask", ",", "parallelJobs"}], "]"}], ",", "pool", ",", 
         RowBox[{"DistributedContexts", "->", "None"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{"ListQ", "[", "status", "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Length", "[", "status", "]"}], "==", 
            RowBox[{"Length", "[", "pool", "]"}]}], " ", "&&", "\n", "   ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"status", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
               RowBox[{"TrueQ", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"#", ",", "\"\<DefinitionsReady\>\"", ",", "False"}],
                  "]"}], "]"}]}], "&"}]}], "]"}]}], "]"}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"cleanup", "[", "]"}], ";", 
         RowBox[{"check", "[", 
          RowBox[{
          "False", 
           ",", "\"\<Worker definitions were not initialized \
correctly.\>\""}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"status", ",", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"#", "[", "\"\<ThreadLimit\>\"", "]"}], 
              "[", "\"\<Confirmed\>\"", "]"}], "]"}], "&"}]}], "]"}]}], ",", 
        "\n", "  ", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"\"\<Worker thread settings: \>\"", ",", "status"}], "]"}], 
         ";", 
         RowBox[{"cleanup", "[", "]"}], ";", "\n", "  ", 
         RowBox[{"check", "[", 
          RowBox[{
          "False", 
           ",", "\"\<Worker thread limits could not be verified. Set \
ParallelEnabled=False for serial execution, or correct the local kernel \
configuration.\>\""}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{
      "Print", "[", "\"\<Confirmed on every worker: MKLThreadNumber=1 and \
ParallelThreadNumber=1.\>\"", "]"}], ";", "\n", " ", 
      RowBox[{"results", "=", 
       RowBox[{"CheckAbort", "[", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"cfg", ",", "\"\<ParallelVerify\>\"", ",", "True"}], 
              "]"}], "]"}], ",", "\n", "   ", 
            RowBox[{
             RowBox[{"testSpec", "=", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<FirstIndex\>\"", "->", "1"}], ",", 
                RowBox[{"\"\<Times\>\"", "->", 
                 RowBox[{"Take", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"First", "[", "chunks", "]"}], 
                    "[", "\"\<Times\>\"", "]"}], ",", 
                   RowBox[{"UpTo", "[", "3", "]"}]}], "]"}]}], ",", 
                RowBox[{"\"\<DropFirst\>\"", "->", "False"}]}], "|>"}]}], ";",
              "\n", "   ", 
             RowBox[{"serial", "=", 
              RowBox[{"dynamicsChunk", "[", 
               RowBox[{"task", ",", "testSpec"}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"remote", "=", 
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"specification", "=", "testSpec"}], "}"}], ",", 
                RowBox[{"First", "[", 
                 RowBox[{"ParallelEvaluate", "[", 
                  RowBox[{
                   RowBox[{"dynamicsChunk", "[", 
                    RowBox[{"parallelTask", ",", "specification"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"First", "[", "pool", "]"}], "}"}], ",", 
                   RowBox[{"DistributedContexts", "->", "None"}]}], "]"}], 
                 "]"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"err", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"AssociationQ", "[", "remote", "]"}], ",", 
                RowBox[{"Max", "[", 
                 RowBox[{
                  RowBox[{"recordDifference", "[", 
                   RowBox[{
                    RowBox[{"serial", "[", "\"\<State\>\"", "]"}], ",", 
                    RowBox[{"remote", "[", "\"\<State\>\"", "]"}]}], "]"}], ",",
                   "\n", "    ", 
                  RowBox[{"recordDifference", "[", 
                   RowBox[{
                    RowBox[{"serial", "[", "\"\<Channel\>\"", "]"}], ",", 
                    RowBox[{"remote", "[", "\"\<Channel\>\"", "]"}]}], 
                   "]"}]}], "]"}], ",", "Infinity"}], "]"}]}], ";", "\n", 
             "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"!", 
                RowBox[{"TrueQ", "[", 
                 RowBox[{"err", "<", 
                  RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
                 "]"}]}], ",", 
               RowBox[{
                RowBox[{"cleanup", "[", "]"}], ";", 
                RowBox[{"check", "[", 
                 RowBox[{
                 "False", 
                  ",", "\"\<Serial/parallel startup comparison failed. No \
trajectory was accepted.\>\""}], "]"}]}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"compute", ",", "remote"}], "}"}], "=", 
           RowBox[{"AbsoluteTiming", "[", 
            RowBox[{"ParallelEvaluate", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"dynamicsChunk", "[", 
                 RowBox[{"parallelTask", ",", "#"}], "]"}], "&"}], " ", "/@", 
               " ", "parallelJobs"}], ",", "pool", ",", 
              RowBox[{"DistributedContexts", "->", "None"}]}], "]"}], "]"}]}],
           ";", "\n", "  ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"remote", ",", "1"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"cleanup", "[", "]"}], ";", 
          RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"cleanup", "[", "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "results", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "results", "]"}], "==", 
          RowBox[{"Length", "[", "chunks", "]"}]}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"results", ",", "AssociationQ"}], "]"}]}], 
        ",", "\"\<A parallel batch failed; no partial trajectory was \
accepted.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Results\>\"", "->", 
         RowBox[{"SortBy", "[", 
          RowBox[{"results", ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<FirstIndex\>\"", "]"}], "&"}]}], "]"}]}], ",",
         "\n", "  ", 
        RowBox[{"\"\<Performance\>\"", "->", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"KeyDrop", "[", 
            RowBox[{"choice", ",", 
             RowBox[{"{", "\"\<Pool\>\"", "}"}]}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ExecutionMode\>\"", "->", "\"\<Parallel\>\""}], ",",
              "\n", "   ", 
             RowBox[{"\"\<KernelsUsed\>\"", "->", 
              RowBox[{"Length", "[", "pool", "]"}]}], ",", 
             RowBox[{"\"\<KernelIDs\>\"", "->", "ids"}], ",", 
             RowBox[{"\"\<WorkerReport\>\"", "->", "status"}], ",", "\n", 
             "   ", 
             RowBox[{"\"\<WorkerSetupSeconds\>\"", "->", "setup"}], ",", 
             RowBox[{"\"\<BatchComputeSeconds\>\"", "->", "compute"}], ",", 
             RowBox[{"\"\<ParallelVerificationError\>\"", "->", "err"}]}], 
            "|>"}]}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}]}], "Code",
 CellLabel->"In[97]:=",ExpressionUUID->"7509f28d-a25f-e24d-9850-1acf69023100"],

Cell["\<\
  ParallelEnabled=True requests ParallelKernels workers, subject to the \
license, available kernels, number of batches and ParallelMemoryMB. \
ParallelVerify=True compares the complete records of an initial batch on the \
master and a worker before accepting the parallel trajectory. Performance \
reports the actual execution mode, kernel IDs and timing. An unavailable \
parallel license produces a clearly printed serial fallback. All worker task \
data are cleared after the run; existing kernels remain open.  \
\>", "Text",ExpressionUUID->"e5aa6b63-4e8a-c843-a691-1b1ef89970f0"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[111]:=",ExpressionUUID->"3608025b-4f22-df4e-bf6a-1742e6ea0990"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"runDynamics", "[", 
    RowBox[{
    "eng_", ",", "edgeInput_", ",", "times_List", ",", "cfg_", ",", 
     "probes_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "ef", ",", "fac0", ",", "rho0", ",", "purity0", ",", "state", ",", 
       "channel", ",", "chunks", ",", "checks", ",", "s0", ",", "stateMag", ",",
        "edgeSupport", ",", "task", ",", "execution", ",", "acc", ",", 
       "assembly", ",", "rows", ",", "cleanState", ",", "cleanChannel"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">", "0"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "times", "]"}], "==", "1"}], " ", "||", 
           " ", 
           RowBox[{"And", "@@", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], 
             "]"}]}]}], ")"}]}], ",", "\"\<Times must increase.\>\""}], "]"}],
       ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<RecordChop\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<RecordChop\>\"", "]"}], ">=", "0"}], " ", "&&",
          "\n", "  ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], ">", 
          "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<Invalid batching, chopping or channel tolerances.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"MatrixQ", "[", 
            RowBox[{
             RowBox[{"probes", "[", "key", "]"}], ",", "NumericQ"}], "]"}], 
           ",", "\"\<Channel witness probes must be density matrices.\>\""}], 
          "]"}], ";", "\n", "  ", 
         RowBox[{"stateFactor", "[", 
          RowBox[{
           RowBox[{"probes", "[", "key", "]"}], ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"key", "===", "\"\<RhoB\>\""}], ",", "2", ",", "4"}], 
            "]"}], ",", 
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
          "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"key", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Rho1\>\"", ",", "\"\<Rho2\>\"", ",", "\"\<RhoB\>\""}],
            "}"}]}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"ef", "=", 
       RowBox[{"stateFactor", "[", 
        RowBox[{"edgeInput", ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}]}], 
      ";", 
      RowBox[{"fac0", "=", 
       RowBox[{
        RowBox[{"eng", "[", "\"\<InputFactor\>\"", "]"}], " ", ".", " ", 
        "ef"}]}], ";", "\n", " ", 
      RowBox[{"rho0", "=", 
       RowBox[{"ef", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "ef", "]"}]}]}], ";", 
      RowBox[{"purity0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", " ", 
            "fac0"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"stateMag", "=", 
       RowBox[{"magnetizationAudit", "[", 
        RowBox[{
         RowBox[{"fullHamiltonian", "[", 
          RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], "]"}], ",", "fac0",
          ",", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"edgeSupport", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<sA\>\"", "->", 
            RowBox[{
             RowBox[{"1", "/", "2"}], "-", 
             RowBox[{"Quotient", "[", 
              RowBox[{
               RowBox[{"k", "-", "1"}], ",", "2"}], "]"}]}]}], ",", 
           RowBox[{"\"\<sB\>\"", "->", 
            RowBox[{
             RowBox[{"1", "/", "2"}], "-", 
             RowBox[{"Mod", "[", 
              RowBox[{
               RowBox[{"k", "-", "1"}], ",", "2"}], "]"}]}]}], ",", "\n", 
           "  ", 
           RowBox[{"\"\<InitialWeight\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"rho0", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "k"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<UsedForState\>\"", "->", 
            RowBox[{"!", 
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"ef", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "]"}], "^", "2"}], "==", 
               "0"}], "]"}]}]}], ",", "\n", "  ", 
           RowBox[{"\"\<RequiredForChoi\>\"", "->", "True"}]}], "|>"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"s0", "=", 
       RowBox[{
        RowBox[{"channelValue", "[", 
         RowBox[{
          RowBox[{"eng", "[", "\"\<InputFactor\>\"", "]"}], ",", 
          RowBox[{"0.", " ", 
           RowBox[{"eng", "[", "\"\<InputFactor\>\"", "]"}]}], ",", "eng"}], 
         "]"}], "[", "\"\<Transfer\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"s0", "-", 
           RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Initial channel is not identity.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"gksBasis", "[", "]"}], ";", 
      RowBox[{"gksDiagonalBasis", "[", "]"}], ";", 
      RowBox[{"twoEdgePaulis", "[", "]"}], ";", 
      RowBox[{"swapSuper", "[", "]"}], ";", 
      RowBox[{"flipSuper", "[", "]"}], ";", 
      RowBox[{"rfSuper", "[", "]"}], ";", 
      RowBox[{"u1Mask", "[", "]"}], ";", "\n", " ", 
      RowBox[{"chunks", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"ix", ",", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"i", "=", 
                RowBox[{"First", "[", "ix", "]"}]}], ",", 
               RowBox[{"j", "=", 
                RowBox[{"Last", "[", "ix", "]"}]}]}], "}"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<FirstIndex\>\"", "->", "i"}], ",", "\n", "   ", 
               RowBox[{"\"\<Times\>\"", "->", 
                RowBox[{"times", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"Max", "[", 
                    RowBox[{"1", ",", 
                    RowBox[{"i", "-", "1"}]}], "]"}], ";;", "j"}], "]"}], 
                 "]"}]}], ",", 
               RowBox[{"\"\<DropFirst\>\"", "->", 
                RowBox[{"(", 
                 RowBox[{"i", ">", "1"}], ")"}]}]}], "|>"}]}], "]"}]}], "]"}],
          ",", 
         RowBox[{"Partition", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "times", "]"}], "]"}], ",", 
           RowBox[{"UpTo", "[", 
            RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], "]"}]}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"task", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Engine\>\"", "->", 
          RowBox[{"KeyTake", "[", 
           RowBox[{"eng", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<L\>\"", ",", "\"\<Dimension\>\"", 
              ",", "\"\<Parameters\>\"", ",", "\"\<Blocks\>\""}], "}"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<EdgeFactor\>\"", "->", "ef"}], ",", "\n", "  ", 
         RowBox[{"\"\<InitialFactor\>\"", "->", "fac0"}], ",", 
         RowBox[{"\"\<InitialRhoAB\>\"", "->", "rho0"}], ",", 
         RowBox[{"\"\<InitialPurity\>\"", "->", "purity0"}], ",", 
         RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", "\n", "  ", 
         RowBox[{"\"\<Probes\>\"", "->", 
          RowBox[{"prepareChannelProbes", "[", "probes", "]"}]}]}], "|>"}]}], 
      ";", "\n", " ", 
      RowBox[{"execution", "=", 
       RowBox[{"evaluateChunks", "[", 
        RowBox[{"task", ",", "chunks", ",", "cfg"}], "]"}]}], ";", 
      RowBox[{"rows", "=", 
       RowBox[{"execution", "[", "\"\<Results\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"assembly", "=", 
       RowBox[{"First", "[", 
        RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
         RowBox[{
          RowBox[{"state", "=", 
           RowBox[{"Join", "@@", 
            RowBox[{"Lookup", "[", 
             RowBox[{"rows", ",", "\"\<State\>\""}], "]"}]}]}], ";", 
          RowBox[{"channel", "=", 
           RowBox[{"Join", "@@", 
            RowBox[{"Lookup", "[", 
             RowBox[{"rows", ",", "\"\<Channel\>\""}], "]"}]}]}], ";", "\n", 
          "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "state", "]"}], "==", 
              RowBox[{"Length", "[", "times", "]"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"state", ",", "\"\<Time\>\""}], "]"}], "===", 
              "times"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"channel", ",", "\"\<Time\>\""}], "]"}], "===", 
              "times"}]}], ",", "\n", 
            "   ", "\"\<Parallel assembly lost, repeated or reordered time \
samples.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"acc", "=", 
           RowBox[{"Prepend", "[", 
            RowBox[{
             RowBox[{"Accumulate", "[", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"Differences", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"channel", ",", "\"\<BLPDistance\>\""}], "]"}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], ",", 
             "0."}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"channel", "=", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{"#1", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<BLPAccumulated\>\"", "->", "#2"}], "|>"}]}], 
               "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"channel", ",", "acc"}], "}"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"checks", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<StateTraceError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"state", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}], 
             ",", "\n", "   ", 
             RowBox[{"\"\<StateMinimumEigenvalue\>\"", "->", 
              RowBox[{"Min", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"state", ",", "\"\<MinEigenvalue\>\""}], "]"}], 
               "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<ChoiTPError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"channel", ",", "\"\<TPError\>\""}], "]"}], "]"}]}], ",", 
             RowBox[{"\"\<ChoiTraceError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"channel", ",", "\"\<ChoiTraceError\>\""}], "]"}], 
               "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<ChoiMinimumEigenvalue\>\"", "->", 
              RowBox[{"Min", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"channel", ",", "\"\<MinChoiEigenvalue\>\""}], "]"}], 
               "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<ChannelAppliedToInputError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"MapThread", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{"applyTransfer", "[", 
                    RowBox[{
                    RowBox[{"#1", "[", "\"\<Transfer\>\"", "]"}], ",", 
                    "rho0"}], "]"}], "-", 
                    RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], "]"}], "&"}],
                  ",", 
                 RowBox[{"{", 
                  RowBox[{"channel", ",", "state"}], "}"}]}], "]"}], 
               "]"}]}]}], "|>"}]}], ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"checks", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<StateTraceError\>\"", 
                   ",", "\"\<ChoiTPError\>\"", ",", "\"\<ChoiTraceError\>\"", 
                   ",", "\"\<ChannelAppliedToInputError\>\""}], "}"}]}], 
                "]"}], "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ",
              "&&", "\n", "   ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"checks", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<StateMinimumEigenvalue\>\"", 
                   ",", "\"\<ChoiMinimumEigenvalue\>\""}], "}"}]}], "]"}], 
               "]"}], ">=", 
              RowBox[{"-", 
               RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}],
             ",", "\"\<State/channel CP/TP or reconstruction check \
failed.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"cleanState", "=", 
           RowBox[{"cleanRecords", "[", 
            RowBox[{"state", ",", 
             RowBox[{"cfg", "[", "\"\<RecordChop\>\"", "]"}]}], "]"}]}], ";", 
          RowBox[{"cleanChannel", "=", 
           RowBox[{"cleanRecords", "[", 
            RowBox[{"channel", ",", 
             RowBox[{"cfg", "[", "\"\<RecordChop\>\"", "]"}]}], "]"}]}], ";", 
          "Null"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Model\>\"", "->", 
         RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
        RowBox[{"\"\<BulkKet\>\"", "->", 
         RowBox[{"eng", "[", "\"\<BulkKet\>\"", "]"}]}], ",", 
        RowBox[{"\"\<InitialEdgeDensityMatrix\>\"", "->", "rho0"}], ",", "\n",
         "  ", 
        RowBox[{"\"\<Times\>\"", "->", "times"}], ",", 
        RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
        RowBox[{"\"\<Probes\>\"", "->", "probes"}], ",", 
        RowBox[{"\"\<Checks\>\"", "->", "checks"}], ",", "\n", "  ", 
        RowBox[{"\"\<Performance\>\"", "->", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"execution", "[", "\"\<Performance\>\"", "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<ChunkCount\>\"", "->", 
              RowBox[{"Length", "[", "chunks", "]"}]}], ",", 
             RowBox[{"\"\<BatchTimes\>\"", "->", 
              RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}]}], ",", 
             RowBox[{"\"\<AssemblySeconds\>\"", "->", "assembly"}]}], 
            "|>"}]}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<StateMagnetizationAudit\>\"", "->", "stateMag"}], ",", 
        RowBox[{"\"\<BulkMagnetizationAudit\>\"", "->", 
         RowBox[{"eng", "[", "\"\<BulkMagnetizationAudit\>\"", "]"}]}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<ChannelMagnetizationAudit\>\"", "->", 
         RowBox[{"eng", "[", "\"\<ChannelMagnetizationAudit\>\"", "]"}]}], ",", 
        RowBox[{"\"\<InvariantComponentOccupation\>\"", "->", 
         RowBox[{"eng", "[", "\"\<Occupation\>\"", "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<FixedEdgeOccupation\>\"", "->", "edgeSupport"}], ",", 
        RowBox[{"\"\<Records\>\"", "->", "cleanState"}], ",", 
        RowBox[{"\"\<MapRecords\>\"", "->", "cleanChannel"}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}]], "Code",
 CellLabel->
  "In[112]:=",ExpressionUUID->"27d2e943-ccd2-cf4a-8f66-0411f941ac96"],

Cell["\<\
 Optional full-trajectory benchmark. Launches the requested kernels before \
timing; compares every returned state/channel quantity for the same engine, \
times and settings. It runs the trajectory twice, temporarily retains both \
results, and does not replace production data. Set ParallelKernels to a \
suitable physical-core count before calling. A serial fallback is explicitly \
NOT a parallel speedup. Plotting, export and ED are outside these timings. \
\>", "Text",ExpressionUUID->"e22581d0-960c-ea4b-8b41-a6c88cbdab06"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[113]:=",ExpressionUUID->"ffbdf14a-797d-3e4f-b3d7-42f68b8c1f53"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"benchmarkDynamics", "[", 
     RowBox[{
     "eng_", ",", "edgeInput_", ",", "times_List", ",", "cfg_", ",", 
      "probes_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "requested", ",", "launchSeconds", ",", "serialSeconds", ",", 
        "parallelSeconds", ",", "serialRun", ",", "parallelRun", ",", "err", ",",
         "usedParallel"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"requested", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"cfg", ",", "\"\<ParallelKernels\>\"", ",", "12"}], "]"}]}], 
       ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "requested", "]"}], " ", "&&", " ", 
          RowBox[{"requested", ">=", "2"}]}], 
         ",", "\"\<Benchmark requires ParallelKernels >= 2.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"launchSeconds", "=", 
        RowBox[{"First", "[", 
         RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"Kernels", "[", "]"}], "]"}], "<", "requested"}], ",", 
             RowBox[{"Quiet", "[", 
              RowBox[{"Check", "[", 
               RowBox[{
                RowBox[{"LaunchKernels", "[", 
                 RowBox[{"requested", "-", 
                  RowBox[{"Length", "[", 
                   RowBox[{"Kernels", "[", "]"}], "]"}]}], "]"}], ",", 
                "Null"}], "]"}], "]"}]}], "]"}], ";", "Null"}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"serialSeconds", ",", "serialRun"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{"runDynamics", "[", 
          RowBox[{"eng", ",", "edgeInput", ",", "times", ",", "\n", "   ", 
           RowBox[{"Join", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<ParallelEnabled\>\"", "->", "False"}], "|>"}]}], 
            "]"}], ",", "probes"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"parallelSeconds", ",", "parallelRun"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{"runDynamics", "[", 
          RowBox[{"eng", ",", "edgeInput", ",", "times", ",", "\n", "   ", 
           RowBox[{"Join", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<ParallelEnabled\>\"", "->", "True"}], "|>"}]}], 
            "]"}], ",", "probes"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"err", "=", 
        RowBox[{"Max", "[", 
         RowBox[{
          RowBox[{"recordDifference", "[", 
           RowBox[{
            RowBox[{"serialRun", "[", "\"\<Records\>\"", "]"}], ",", 
            RowBox[{"parallelRun", "[", "\"\<Records\>\"", "]"}]}], "]"}], ",",
           "\n", "   ", 
          RowBox[{"recordDifference", "[", 
           RowBox[{
            RowBox[{"serialRun", "[", "\"\<MapRecords\>\"", "]"}], ",", 
            RowBox[{"parallelRun", "[", "\"\<MapRecords\>\"", "]"}]}], 
           "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"usedParallel", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"parallelRun", "[", "\"\<Performance\>\"", "]"}], 
          "[", "\"\<ExecutionMode\>\"", "]"}], "===", "\"\<Parallel\>\""}]}], 
       ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<KernelLaunchSeconds\>\"", "->", "launchSeconds"}], ",", 
         RowBox[{"\"\<SerialSeconds\>\"", "->", "serialSeconds"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<ParallelRequestedSeconds\>\"", "->", 
          "parallelSeconds"}], ",", 
         RowBox[{"\"\<ParallelExecuted\>\"", "->", "usedParallel"}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<Speedup\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"usedParallel", " ", "&&", " ", 
             RowBox[{"parallelSeconds", ">", "0"}]}], ",", 
            RowBox[{"serialSeconds", "/", "parallelSeconds"}], ",", 
            RowBox[{"Missing", "[", "\"\<ParallelNotExecuted\>\"", "]"}]}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<MaximumRecordDifference\>\"", "->", "err"}], ",", 
         RowBox[{"\"\<RecordsAgree\>\"", "->", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"err", "<", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<SampleCount\>\"", "->", 
          RowBox[{"Length", "[", "times", "]"}]}], ",", 
         RowBox[{"\"\<ParallelPerformance\>\"", "->", 
          RowBox[{"parallelRun", "[", "\"\<Performance\>\"", "]"}]}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->
  "In[114]:=",ExpressionUUID->"6a639861-d7f6-a44e-91b1-0d10d1bd4f97"]
}, Closed]],

Cell[CellGroupData[{

