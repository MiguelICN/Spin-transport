Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"neel", "[", 
    RowBox[{"n_Integer", ",", 
     RowBox[{"first_", ":", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"productKet", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"UnitVector", "[", 
       RowBox[{"2", ",", 
        RowBox[{"1", "+", 
         RowBox[{"Mod", "[", 
          RowBox[{
           RowBox[{"k", "-", "1", "+", "first"}], ",", "2"}], "]"}]}]}], 
       "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}]], "Code",
 CellLabel->"In[36]:=",ExpressionUUID->"e1ab2261-c615-ed48-a4c5-c5a7aa57c79f"],

Cell["  phi is the azimuth of the first spin in this vector.  ", "Text",ExpressionUUID->"60fa222d-54f4-b348-91e5-0c1a425821e4"],

