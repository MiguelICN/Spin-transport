Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "zzEnabled", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"zzTimeUsed", "=", "zzTime"}], ";", 
     RowBox[{"zzTimes", "=", 
      RowBox[{"timeGrid", "[", "zzTimeUsed", "]"}]}], ";", "\n", " ", 
     RowBox[{"zzEdgeStateUsed", "=", "zzEdgeState"}], ";", 
     RowBox[{"zzProbesUsed", "=", "zzProbes"}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"zzSeconds", ",", "zzRun"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"runDynamics", "[", 
        RowBox[{
        "zzEngine", ",", "zzEdgeStateUsed", ",", "zzTimes", ",", 
         "zzSettingsUsed", ",", "zzProbesUsed"}], "]"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"zzReference", "=", 
      RowBox[{"smallReferenceCheck", "[", 
       RowBox[{"zzEngine", ",", "zzEdgeStateUsed", ",", 
        RowBox[{"{", 
         RowBox[{"0.", ",", "0.137", ",", "1."}], "}"}], ",", " ", 
        "zzSettingsUsed"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"zzRun", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"zzRun", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TimeSettings\>\"", "->", "zzTimeUsed"}], ",", 
          RowBox[{"\"\<BulkChoice\>\"", "->", "zzBulkChoiceUsed"}], ",", "\n",
           "  ", 
          RowBox[{"\"\<BulkEigenstateAudit\>\"", "->", "zzBulkAudit"}], ",", 
          RowBox[{"\"\<DirectReference\>\"", "->", "zzReference"}], ",", "\n",
           "  ", 
          RowBox[{"\"\<SetupSeconds\>\"", "->", "zzSetupSeconds"}], ",", 
          RowBox[{"\"\<EvolutionSeconds\>\"", "->", "zzSeconds"}], ",", "\n", 
          "  ", 
          
          RowBox[{"\"\<UploadedSizeVerification\>\"", "->", 
           "verificationUploaded"}], ",", 
          RowBox[{"\"\<TableVerification\>\"", "->", "verificationTable"}]}], 
         "|>"}]}], "]"}]}], ";", "\n", " ", 
     RowBox[{"zzRecords", "=", 
      RowBox[{"zzRun", "[", "\"\<Records\>\"", "]"}]}], ";", 
     RowBox[{"zzMapRecords", "=", 
      RowBox[{"zzRun", "[", "\"\<MapRecords\>\"", "]"}]}], ";", "\n", " ", 
     RowBox[{"zzPlotSnapshot", "=", 
      RowBox[{"<|", 
