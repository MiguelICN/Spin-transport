            "records", ",", "\"\<EigenvaluesAB\>\"", ",", "4", 
             ",", "\"\<\\\\lambda_k(\\\\rho_{AB})\>\"", 
             ",", "\"\<\\\\text{Edge density spectrum}\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\"\<\\\\lambda_\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], 
