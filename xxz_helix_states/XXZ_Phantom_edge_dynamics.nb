               RowBox[{"{", 
                RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", "snap", ",", 
             "log"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"channelKeys", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<ChoiNegativity\>\"", ",", "\"\<MapEntropy\>\"", 
           ",", "\"\<MinimumRate\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"AssociateTo", "[", 
           RowBox[{"channel", ",", 
            RowBox[{"key", "->", 
             RowBox[{"recordPlot", "[", 
              RowBox[{"mapRecords", ",", 
               RowBox[{"{", "key", "}"}], ",", 
               RowBox[{"observableLabel", "[", "key", "]"}], ",", 
               RowBox[{"observableTitle", "[", "key", "]"}], ",", "snap", ",",
                "log"}], "]"}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "channelKeys"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AssociateTo", "[", 
         RowBox[{"channel", ",", 
          RowBox[{"\"\<ChoiEigenvalues\>\"", "->", 
           RowBox[{"selectedVectorPlot", "[", 
            RowBox[{
            "mapRecords", ",", "\"\<ChoiEigenvalues\>\"", ",", "16", 
             ",", "\"\<\\\\lambda_k(C_t)\>\"", 
             ",", "\"\<\\\\text{Choi eigenvalues}\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\"\<\\\\lambda_\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<(C_t)\>\""}], 
               ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "16"}], "}"}]}], "]"}], ",", "snap", ",", 
             "log"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"AssociateTo", "[", 
         RowBox[{"channel", ",", 
          RowBox[{"\"\<CanonicalRates\>\"", "->", 
           RowBox[{"selectedVectorPlot", "[", 
            RowBox[{
            "mapRecords", ",", "\"\<CanonicalRates\>\"", ",", "15", 
             ",", "\"\<\\\\gamma_k(t)\>\"", 
             ",", "\"\<\\\\text{Canonical rates}\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"\"\<\\\\gamma_\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<(t)\>\""}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "15"}], "}"}]}], "]"}], ",", "snap", ",", 
             "log"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "These", " ", "two", " ", "figures", " ", "apply", " ", "only", " ", 
          "to", " ", "the", " ", "ZZ", " ", "Schur", " ", 
          RowBox[{"channel", "."}]}], "*)"}], 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{
            RowBox[{"First", "[", "mapRecords", "]"}], 
            ",", "\"\<DephasingFactors\>\""}], "]"}], ",", 
          RowBox[{
           RowBox[{"AssociateTo", "[", 
            RowBox[{"channel", ",", 
             RowBox[{"\"\<EntanglingConcurrence\>\"", "->", 
              RowBox[{"recordPlot", "[", 
               RowBox[{"mapRecords", ",", 
                RowBox[{"{", "\"\<EntanglingConcurrence\>\"", "}"}], ",", 
                RowBox[{
                "observableLabel", "[", "\"\<EntanglingConcurrence\>\"", 
                 "]"}], ",", 
                RowBox[{
                "observableTitle", "[", "\"\<EntanglingConcurrence\>\"", 
                 "]"}], ",", "snap", ",", "log"}], "]"}]}]}], "]"}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"pairs", "=", 
            RowBox[{"Subsets", "[", 
             RowBox[{
              RowBox[{"Range", "[", "4", "]"}], ",", 
              RowBox[{"{", "2", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"basis", "=", 
            RowBox[{"{", 
             
             RowBox[{"\"\<00\>\"", ",", "\"\<01\>\"", ",", "\"\<10\>\"", 
              ",", "\"\<11\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"curves", "=", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                    RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<DephasingFactors\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], 
                    "}"}], "&"}], "/@", "mapRecords"}], ")"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"!", "log"}], "||", 
                  RowBox[{
                   RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"pair", ",", "pairs"}], "}"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"g", "=", 
            RowBox[{"Block", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
              RowBox[{"framePlot", "[", 
               RowBox[{
               "curves", ",", "\"\<t\>\"", 
                ",", "\"\<\\\\operatorname{Re}\\\\Gamma_{ab}(t)\>\"", ",", 
                RowBox[{"curveStyles", "[", "6", "]"}], ",", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"\"\<\\\\Gamma_{\>\"", "<>", 
                    RowBox[{"basis", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], 
                    "<>", "\"\<,\>\"", "<>", 
                    RowBox[{"basis", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], 
                    "<>", "\"\<}\>\""}], "&"}], "/@", "pairs"}], ")"}], ",", 
                "False", ",", "log", ",", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
                  RowBox[{"{", "6", "}"}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"channel", ",", 
             RowBox[{"\"\<Gamma_Re\>\"", "->", 
              RowBox[{"plotPanel", "[", 
               RowBox[{"\"\<\\\\text{Conditional bulk overlaps}\>\"", ",", 
                RowBox[{"trajectoryCaption", "[", 
                 RowBox[{"snap", ",", "mapRecords"}], "]"}], ",", "g"}], 
               "]"}]}]}], "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<State\>\"", "->", "state"}], ",", 
          RowBox[{"\"\<Channel\>\"", "->", "channel"}]}], "|>"}]}]}], "]"}]}],
     ";"}]}]}]], "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"8196725a-7f60-8842-951e-87061bc90269"]
