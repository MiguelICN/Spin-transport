Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"joinStates", "[", 
    RowBox[{"ef_", ",", "mf_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"ef", ",", "mf"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"a", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"l", "-", "2"}], ")"}]}], ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "a", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "l"}], ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "a", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "]"}]}], 
  ";"}]], "Code",
 CellLabel->"In[42]:=",ExpressionUUID->"c4478ee1-6142-d243-8e27-d47fc9bdadb0"]
