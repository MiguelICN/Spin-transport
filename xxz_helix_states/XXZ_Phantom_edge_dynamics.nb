Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"siteOp", "[", 
    RowBox[{"a_", ",", "k_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]}], "]"}], ",", 
     RowBox[{"SparseArray", "[", "a", "]"}], ",", 
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"l", "-", "k"}], ")"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bondOp", "[", 
     RowBox[{"a_", ",", "b_", ",", "k_", ",", "l_"}], "]"}], " ", ":=", " ", 
    RowBox[{"KroneckerProduct", "[", "\n", " ", 
     RowBox[{
      RowBox[{"id", "[", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]}], "]"}], ",", 
      RowBox[{"SparseArray", "[", "a", "]"}], ",", 
      RowBox[{"SparseArray", "[", "b", "]"}], ",", 
      RowBox[{"id", "[", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{"l", "-", "k", "-", "1"}], ")"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"partitionFactor", "[", 
    RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", "rest"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"rest", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", "l", "]"}], ",", "sites"}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"fac", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"2", ",", "l"}], "]"}], ",", 
              RowBox[{"{", "r", "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
          RowBox[{"Ordering", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"sites", ",", "rest", ",", 
             RowBox[{"{", 
              RowBox[{"l", "+", "1"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"Length", "[", "sites", "]"}]}], ",", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"Length", "[", "rest", "]"}]}], " ", "r"}]}], "}"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedState", "[", 
    RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
