Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"t", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "0.", "}"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"Subdivide", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}],
                "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "=", 
           RowBox[{"N", "[", 
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], ",",
          "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"texNumber", "[", 
    RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{"x", "==", "0"}], "]"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", "x", "]"}], ",", "6", ",", "\n", " ", 
         RowBox[{"NumberPadding", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
         RowBox[{"ExponentFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], "<", "#", "<", "6"}], ",", "Null", ",", 
              "#"}], "]"}], "&"}], ")"}]}], ",", "\n", " ", 
         RowBox[{"NumberFormat", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#3", "==", "\"\<\>\""}], ",", 
              RowBox[{"StringReplace", "[", 
               RowBox[{"#1", ",", 
                RowBox[{
                 RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
                 "->", "\"\<\>\""}]}], "]"}], ",", 
              RowBox[{
               RowBox[{"StringReplace", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{
                  RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
                  "->", "\"\<\>\""}]}], "]"}], "<>", "\"\<\\\\times 10^{\>\"",
                "<>", "#3", "<>", "\"\<}\>\""}]}], "]"}], "&"}], ")"}]}]}], 
        "]"}], ",", "OutputForm"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"samplingCaption", "[", 
    RowBox[{"ts_List", ",", 
     RowBox[{"cfg_", ":", 
      RowBox[{"<|", "|>"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dt", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Differences", "[", "ts", "]"}], "]"}]}], ",", "eps", ",", 
       "uniform", ",", "note", ",", 
       RowBox[{"grid", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"cfg", ",", "\"\<Grid\>\"", ",", "Automatic"}], "]"}]}], ",",
        "pos", ",", "ld"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ts", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "\"\<\\\\text{no time samples}\>\"", "]"}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"eps", "=", 
       RowBox[{"64", " ", "$MachineEpsilon", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "ts", "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
      "\n", " ", 
      RowBox[{"uniform", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "dt", "]"}], "<", "2"}], " ", "||", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "dt", "]"}], "-", 
          RowBox[{"Min", "[", "dt", "]"}]}], "<=", "eps"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"note", "=", 
       RowBox[{"\"\<t\\\\in[\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"First", "[", "ts", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"Last", "[", "ts", "]"}], "]"}], 
        "<>", "\"\<];\\\\quad N_t=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "[", "ts", "]"}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dt", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"note", "=", 
         RowBox[{"note", "<>", 
          RowBox[{"If", "[", 
           RowBox[{"uniform", ",", 
            RowBox[{"\"\<;\\\\quad \\\\delta t=\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Mean", "[", "dt", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<;\\\\quad \\\\delta t\\\\in[\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Min", "[", "dt", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Max", "[", "dt", "]"}], "]"}], "<>", "\"\<]\>\""}]}], 
           "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Infer", " ", "log", " ", "sampling", " ", "only", " ", "if", " ", 
        "no", " ", "saved", " ", "grid", " ", "specification", " ", "is", " ", 
        RowBox[{"supplied", "."}]}], " ", "*)"}], "\n", " ", 
      RowBox[{"pos", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"N", "[", "ts", "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"ld", "=", 
       RowBox[{"Differences", "[", 
        RowBox[{"Log", "[", "pos", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"grid", "===", "\"\<Log\>\""}], " ", "||", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"grid", "===", "Automatic"}], " ", "&&", " ", 
           RowBox[{"!", "uniform"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Length", "[", "ld", "]"}], ">=", "2"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", "ld", "]"}], "-", 
             RowBox[{"Min", "[", "ld", "]"}]}], "<", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "10"}]}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"Abs", "[", "ld", "]"}], "]"}]}], "]"}]}]}]}], 
          ")"}]}], ",", 
        RowBox[{"note", "=", 
         RowBox[{
         "note", "<>", "\"\<;\\\\quad \\\\text{logarithmic \
sampling}\>\""}]}]}], "]"}], ";", "\n", " ", "note"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ticks", "[", 
    RowBox[{
     RowBox[{"lo_", "?", "NumericQ"}], ",", 
     RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
