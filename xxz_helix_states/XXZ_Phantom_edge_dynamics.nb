Cell["\<\
  Concurrence from an exact reduced-state factor; stable at rank deficiency.  \
\>", "Text",ExpressionUUID->"c839ae67-9383-3246-96ad-e171a980679d"],

Cell[BoxData[""], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"c5ea3a18-c302-3d4b-b2e8-d8a046688195"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"concurrence", "[", "a_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"q", ",", "r", ",", "f", ",", "s"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"q", ",", "r"}], "}"}], "=", 
        RowBox[{"QRDecomposition", "[", 
         RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}], "]"}]}], ";", 
       " ", 
       RowBox[{"f", "=", 
        RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], ";", "\n", " ", 
       RowBox[{"s", "=", 
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"Reverse", "[", 
           RowBox[{"Sort", "[", 
            RowBox[{"SingularValueList", "[", "\n", "  ", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", "f", "]"}], " ", ".", " ", 
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{
                 RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
                 RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
               " ", "f"}], ",", 
              RowBox[{"Tolerance", "->", "0"}]}], "]"}], "]"}], "]"}], ",", 
          "4"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"0.", ",", 
         RowBox[{
          RowBox[{"First", "[", "s", "]"}], "-", 
          RowBox[{"Total", "[", 
           RowBox[{"Rest", "[", "s", " ", "]"}], "]"}]}]}], "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"productKet", "[", "locals_List", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"locals", ",", "\n", "  ", 
           RowBox[{
            RowBox[{
             RowBox[{"VectorQ", "[", 
              RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], "]"}]}],
         ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"v", "=", 
       RowBox[{"Fold", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"#1", ",", 
             RowBox[{"N", "[", 
              RowBox[{"#2", "/", 
               RowBox[{"Norm", "[", "#2", " ", "]"}]}], "]"}]}], "]"}], "]"}],
           "&"}], ",", 
         RowBox[{"{", "1.", "}"}], ",", "locals"}], "]"}]}], ";", " ", 
      RowBox[{"v", "/", 
       RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}]}], "Code",
 CellLabel->"In[33]:=",ExpressionUUID->"cfd18271-9a76-8c4c-ac3f-5ca8c694074f"],

