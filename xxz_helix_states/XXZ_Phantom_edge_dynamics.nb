         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"e", "===", 
        RowBox[{"{", "}"}]}], ",", "0.", ",", 
       RowBox[{"-", 
        RowBox[{"Total", "[", 
         RowBox[{"e", " ", 
          RowBox[{"Log", "[", "e", " ", "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
