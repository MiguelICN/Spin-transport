          RowBox[{
           RowBox[{"\"\<10^{\>\"", "<>", 
            RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<}\>\""}], ",", 
           "14"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", "\n", 
      "  ", 
      RowBox[{"Range", "[", 
