 CellLabel->"In[57]:=",ExpressionUUID->"667c1a04-6ef2-4646-8f62-4654a7350f7b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magnetizationWeights", "[", 
    RowBox[{"fac_", ",", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nd", ",", "groups", ",", "total"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"nd", "=", 
       RowBox[{"Total", " ", "/@", " ", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"2", "^", "n"}], "-", "1"}]}], "]"}], ",", "2", ",", 
          "n"}], "]"}]}]}], ";", 
      RowBox[{"groups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"2", "^", "n"}], "]"}], ",", 
         RowBox[{
          RowBox[{"nd", "[", 
           RowBox[{"[", "#", "]"}], "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"total", "=", 
       RowBox[{
        RowBox[{"Norm", "[", 
         RowBox[{"fac", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}]}], ";", 
      "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Magnetization\>\"", "->", 
           RowBox[{
            RowBox[{"n", "/", "2"}], "-", 
            RowBox[{"nd", "[", 
             RowBox[{"[", 
              RowBox[{"First", "[", "ix", "]"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"\"\<Dimension\>\"", "->", 
           RowBox[{"Length", "[", "ix", "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<InitialWeight\>\"", "->", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{"fac", "[", 
                RowBox[{"[", "ix", "]"}], "]"}], ",", "\"\<Frobenius\>\""}], 
              "]"}], "^", "2"}], "/", "total"}]}]}], "|>"}], ",", 
        RowBox[{"{", 
         RowBox[{"ix", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"magnetizationAudit", "[", 
    RowBox[{"h_", ",", "fac_", ",", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rules", ",", "nd", ",", "off", ",", "leak"}], "}"}], ",", "\n",
      " ", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"Most", "[", 
        RowBox[{"ArrayRules", "[", 
         RowBox[{"SparseArray", "[", "h", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"nd", "=", 
       RowBox[{"Total", " ", "/@", " ", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"2", "^", "n"}], "-", "1"}]}], "]"}], ",", "2", ",", 
          "n"}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"off", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"rules", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"nd", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "!=", 
           RowBox[{"nd", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], "&"}]}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"leak", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"off", "===", 
          RowBox[{"{", "}"}]}], ",", "0.", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Last", " ", "/@", " ", "off"}], "]"}], "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<InitialMagnetizationWeights\>\"", "->", 
         RowBox[{"magnetizationWeights", "[", 
          RowBox[{"fac", ",", "n"}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<MaximumMagnetizationChangingMatrixElement\>\"", "->", 
         "leak"}], ",", "\n", "  ", 
        RowBox[{"\"\<MagnetizationConservedExactly\>\"", "->", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"leak", "==", "0"}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<UsedAsIndependentEvolutionBlocks\>\"", "->", "False"}]}],
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exactComponents", "[", "h_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rules", ",", "edges", ",", 
       RowBox[{"d", "=", 
        RowBox[{"Length", "[", "h", "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rules", "=", 
       RowBox[{"Most", "[", 
        RowBox[{"ArrayRules", "[", 
         RowBox[{"SparseArray", "[", "h", "]"}], "]"}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"edges", "=", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{"Sort", " ", "/@", " ", 
         RowBox[{"(", 
          RowBox[{"First", " ", "/@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{"rules", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "!=", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}]}], " ", "&&", " ", 
               RowBox[{"!", 
                RowBox[{"TrueQ", "[", 
                 RowBox[{
                  RowBox[{"Last", "[", "#", "]"}], "==", "0"}], "]"}]}]}], 
              "&"}]}], "]"}]}], ")"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"edges", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"List", " ", "/@", " ", 
         RowBox[{"Range", "[", "d", "]"}]}], ",", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"ConnectedComponents", "[", 
           RowBox[{"Graph", "[", 
            RowBox[{
             RowBox[{"Range", "[", "d", "]"}], ",", 
             RowBox[{"UndirectedEdge", "@@@", "edges"}]}], "]"}], "]"}], ",", 
          "Min"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeIndices", "[", 
    RowBox[{"a_Integer", ",", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"1", "+", 
       RowBox[{
        RowBox[{"Quotient", "[", 
         RowBox[{
          RowBox[{"a", "-", "1"}], ",", "2"}], "]"}], " ", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"n", "+", "1"}], ")"}]}]}], "+", 
       RowBox[{"2", " ", "k"}], "+", 
       RowBox[{"Mod", "[", 
        RowBox[{
         RowBox[{"a", "-", "1"}], ",", "2"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", 
        RowBox[{
         RowBox[{"2", "^", "n"}], "-", "1"}]}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"occupiedBlocks", "[", 
    RowBox[{
    "h_", ",", "input_", ",", "globalIndices_", ",", "columns_", ",", "cfg_", 
     ",", "label_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"groups", ",", 
       RowBox[{"blocks", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"occupation", "=", 
        RowBox[{"{", "}"}]}], ",", "ix", ",", "w", ",", "active", ",", "ed", ",",
        "c", ",", 
       RowBox[{"total", "=", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{"input", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}]}]}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"groups", "=", 
       RowBox[{"exactComponents", "[", "h", "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"w", "=", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"input", "[", 
              RowBox[{"[", "ix", "]"}], "]"}], ",", "\"\<Frobenius\>\""}], 
            "]"}], "^", "2"}]}], ";", "\n", "  ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"occupation", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Labels\>\"", "->", "label"}], ",", 
             RowBox[{"\"\<ComponentDimension\>\"", "->", 
              RowBox[{"Length", "[", "ix", "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<InputWeight\>\"", "->", 
              RowBox[{"w", "/", "total"}]}], ",", 
             RowBox[{"\"\<Evolved\>\"", "->", 
              RowBox[{"!", 
               RowBox[{"TrueQ", "[", 
                RowBox[{"w", "==", "0"}], "]"}]}]}]}], "|>"}]}], "]"}], ";", 
         "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"w", "==", "0"}], "]"}], ",", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"active", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "columns", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"TrueQ", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{"input", "[", 
                   RowBox[{"[", 
                    RowBox[{"ix", ",", "#"}], "]"}], "]"}], "]"}], "^", "2"}],
                 "==", "0"}], "]"}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"ed", "=", 
          RowBox[{"complexED", "[", 
           RowBox[{
            RowBox[{"h", "[", 
             RowBox[{"[", 
              RowBox[{"ix", ",", "ix"}], "]"}], "]"}], ",", "cfg"}], "]"}]}], 
         ";", 
         RowBox[{"c", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", 
            RowBox[{"ed", "[", "\"\<V\>\"", "]"}], "]"}], " ", ".", " ", 
           RowBox[{"input", "[", 
            RowBox[{"[", 
             RowBox[{"ix", ",", "active"}], "]"}], "]"}]}]}], ";", "\n", "  ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"blocks", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"KeyTake", "[", 
              RowBox[{"ed", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<E\>\"", ",", "\"\<V\>\"", 
                 ",", "\"\<Dimension\>\"", 
                 ",", "\"\<EstimatedDenseWorkingMemoryMB\>\""}], "}"}]}], 
              "]"}], ",", "\n", "   ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Indices\>\"", "->", 
                RowBox[{"globalIndices", "[", 
                 RowBox[{"[", "ix", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Columns\>\"", "->", 
                RowBox[{"columns", "[", 
                 RowBox[{"[", "active", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<C\>\"", "->", "c"}], ",", 
               RowBox[{"\"\<H\>\"", "->", 
                RowBox[{"N", "[", 
                 RowBox[{"SparseArray", "[", 
                  RowBox[{"h", "[", 
                   RowBox[{"[", 
                    RowBox[{"ix", ",", "ix"}], "]"}], "]"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Labels\>\"", "->", "label"}]}], "|>"}]}], "]"}]}],
           "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ix", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Blocks\>\"", "->", "blocks"}], ",", 
        RowBox[{"\"\<Occupation\>\"", "->", "occupation"}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"buildEngine", "[", 
    RowBox[{"p_", ",", "bulk_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"p", "[", "\"\<N\>\"", "]"}]}], ",", 
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "d", ",", "h", ",", "f", 
       ",", 
       RowBox[{"blocks", "=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{"occupation", "=", 
        RowBox[{"{", "}"}]}], ",", "b", ",", "spins", ",", "z", ",", "hc", ",",
        "ix"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"2", "^", "l"}]}], ";", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "bulk", "]"}], "==", 
          RowBox[{"2", "^", "n"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Norm", "[", "bulk", "]"}], "-", "1"}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}], 
        ",", "\"\<Invalid bulk ket.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"bulkHamiltonian", "[", "p", "]"}]}], ";", 
      RowBox[{"f", "=", 
       RowBox[{"joinStates", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", "bulk", "}"}], "]"}], ",", "l"}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "\"\<Regime\>\"", "]"}], "===", "\"\<ZZ\>\""}], ",", 
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"spins", "=", 
             RowBox[{
              RowBox[{"1", "/", "2"}], "-", 
              RowBox[{"IntegerDigits", "[", 
               RowBox[{
                RowBox[{"a", "-", "1"}], ",", "2", ",", "2"}], "]"}]}]}], ";", 
            RowBox[{"hc", "=", 
             RowBox[{"h", "+", 
              RowBox[{
               RowBox[{"p", "[", "\"\<g\>\"", "]"}], 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"spins", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], " ", 
                  RowBox[{"siteOp", "[", 
                   RowBox[{"z", ",", "1", ",", "n"}], "]"}]}], "+", 
                 RowBox[{
                  RowBox[{"spins", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], " ", 
                  RowBox[{"siteOp", "[", 
                   RowBox[{"z", ",", "n", ",", "n"}], "]"}]}]}], ")"}]}]}]}], 
            ";", "\n", "   ", 
            RowBox[{"ix", "=", 
             RowBox[{"edgeIndices", "[", 
              RowBox[{"a", ",", "n"}], "]"}]}], ";", 
            RowBox[{"b", "=", 
             RowBox[{"occupiedBlocks", "[", 
              RowBox[{"hc", ",", 
               RowBox[{"Transpose", "[", 
                RowBox[{"{", "bulk", "}"}], "]"}], ",", "ix", ",", 
               RowBox[{"{", "a", "}"}], ",", "cfg", ",", "\n", "    ", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<sA\>\"", "->", 
                  RowBox[{"spins", "[", 
                   RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<sB\>\"", "->", 
                  RowBox[{"spins", "[", 
                   RowBox[{"[", "2", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"blocks", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"blocks", ",", 
               RowBox[{"b", "[", "\"\<Blocks\>\"", "]"}]}], "]"}]}], ";", 
            RowBox[{"occupation", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"occupation", ",", 
               RowBox[{"b", "[", "\"\<Occupation\>\"", "]"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"a", ",", "4"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"hc", "=", 
          RowBox[{"fullHamiltonian", "[", "p", "]"}]}], ";", 
         RowBox[{"b", "=", 
          RowBox[{"occupiedBlocks", "[", 
           RowBox[{"hc", ",", "f", ",", 
            RowBox[{"Range", "[", "d", "]"}], ",", 
            RowBox[{"Range", "[", "4", "]"}], ",", "cfg", ",", 
            RowBox[{"<|", 
             
             RowBox[{"\"\<Invariant\>\"", 
              "->", "\"\<Reachable computational component\>\""}], "|>"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"blocks", "=", 
          RowBox[{"b", "[", "\"\<Blocks\>\"", "]"}]}], ";", 
         RowBox[{"occupation", "=", 
          RowBox[{"b", "[", "\"\<Occupation\>\"", "]"}]}]}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
        RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
        RowBox[{"\"\<Dimension\>\"", "->", "d"}], ",", 
        RowBox[{"\"\<BulkKet\>\"", "->", "bulk"}], ",", 
        RowBox[{"\"\<Blocks\>\"", "->", "blocks"}], ",", "\n", "  ", 
        RowBox[{"\"\<Occupation\>\"", "->", "occupation"}], ",", 
        RowBox[{"\"\<InputFactor\>\"", "->", "f"}], ",", "\n", "  ", 
        RowBox[{"\"\<BulkMagnetizationAudit\>\"", "->", 
         RowBox[{"magnetizationAudit", "[", 
          RowBox[{"h", ",", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", "bulk", "}"}], "]"}], ",", "n"}], "]"}]}], ",", "\n",
         "  ", 
        RowBox[{"\"\<ChannelMagnetizationAudit\>\"", "->", 
         RowBox[{"magnetizationAudit", "[", 
          RowBox[{
           RowBox[{"fullHamiltonian", "[", "p", "]"}], ",", "f", ",", "l"}], 
          "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<ZeroComponentPruning\>\"", 
         "->", "\"\<Exact zero only; all magnetization-changing matrix \
elements retained\>\""}]}], "|>"}]}]}], "\n", "]"}]}], ";"}]}], "Code",
 CellLabel->"In[58]:=",ExpressionUUID->"b8fae2b9-7772-ae4e-ba60-2ce7bacc70d6"],

Cell["\<\
  Batched BLAS products. No full U(t), no full density matrix and no \
numerical time integration. Derivatives are evaluated analytically using \
sparse Hamiltonian products.  \
\>", "Text",ExpressionUUID->"4f6831f3-96dd-7046-a104-96f3fcc692fa"],

Cell[BoxData[""], "Input",
 CellLabel->"In[64]:=",ExpressionUUID->"a21b6934-fdcb-8d43-aa84-7a6056db4909"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"evolveInputs", "[", 
    RowBox[{"eng_", ",", "ts_List"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "aa", ",", "dd", ",", "ix", ",", "cols", ",", "e", ",", "v", ",", "c", ",",
        "ph", ",", "weighted", ",", "b", ",", "bd"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"aa", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"0.", "+", 
          RowBox[{"0.", "I"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", "ts", "]"}], ",", 
           RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}], ",", "4"}], 
          "}"}]}], "]"}]}], ";", 
      RowBox[{"dd", "=", "aa"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ix", ",", "cols", ",", "e", ",", "v", ",", "c"}], "}"}], "=", 
          RowBox[{"Lookup", "[", 
           RowBox[{"blk", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Indices\>\"", ",", "\"\<Columns\>\"", 
              ",", "\"\<E\>\"", ",", "\"\<V\>\"", ",", "\"\<C\>\""}], "}"}]}],
            "]"}]}], ";", "\n", "  ", 
         RowBox[{"ph", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", "e", ",", 
              RowBox[{"N", "[", "ts", "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
         "  ", 
         RowBox[{"weighted", "=", 
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Outer", "[", 
                RowBox[{"Times", ",", "#1", ",", "#2"}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"ph", ",", "c"}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "e", "]"}], ",", 
              RowBox[{
               RowBox[{"Length", "[", "ts", "]"}], " ", 
               RowBox[{"Length", "[", "cols", "]"}]}]}], "}"}]}], "]"}]}], ";",
          "\n", "  ", 
         RowBox[{"b", "=", 
          RowBox[{"v", " ", ".", " ", "weighted"}]}], ";", 
         RowBox[{"bd", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"blk", ",", "\"\<H\>\""}], "]"}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"blk", "[", "\"\<H\>\"", "]"}]}], ")"}], " ", ".", " ",
              "b"}], ",", 
            RowBox[{"v", " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"-", "I"}], " ", "e", " ", "weighted"}], ")"}]}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"aa", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "ix", ",", "cols"}], "]"}], "]"}], "=", 
             RowBox[{"b", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"k", "-", "1"}], ")"}], 
                  RowBox[{"Length", "[", "cols", "]"}]}], "+", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "cols", "]"}], "]"}]}]}], "]"}], 
              "]"}]}], ";", "\n", "   ", 
            RowBox[{
             RowBox[{"dd", "[", 
              RowBox[{"[", 
               RowBox[{"k", ",", "ix", ",", "cols"}], "]"}], "]"}], "=", 
             RowBox[{"bd", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", 
                RowBox[{
                 RowBox[{
