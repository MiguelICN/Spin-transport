         RowBox[{"cfg", "[", "\"\<DirectReferenceMaximumL\>\"", "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<SizeAboveReferenceLimit\>\"", "]"}], 
         "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"fullHamiltonian", "[", 
         RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"ef", "=", 
       RowBox[{"stateFactor", "[", 
        RowBox[{"edge", ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}]}], 
      ";", "\n", " ", 
      RowBox[{"f", "=", 
       RowBox[{"eng", "[", "\"\<InputFactor\>\"", "]"}]}], ";", 
      RowBox[{"ev", "=", 
       RowBox[{"evolveInputs", "[", 
        RowBox[{"eng", ",", "ts"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"t", "=", 
          RowBox[{"ts", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ";", 
         RowBox[{"u", "=", 
          RowBox[{"MatrixExp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "t", " ", "h"}], "]"}]}], ";", 
         RowBox[{"exact", "=", 
          RowBox[{"u", " ", ".", " ", "f"}]}], ";", "\n", "  ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"errs", ",", 
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"exact", " ", ".", " ", "ef"}], "-", 
             RowBox[{
              RowBox[{
               RowBox[{"ev", "[", "\"\<Factors\>\"", "]"}], "[", 
               RowBox[{"[", "k", "]"}], "]"}], " ", ".", " ", "ef"}]}], 
            "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Independent", " ", "explicit", " ", "sum", " ", "over", " ", 
           "bulk", " ", "basis", " ", "and", " ", "edge", " ", 
           RowBox[{"input", "/", "output"}], " ", 
           RowBox[{"indices", "."}]}], " ", "*)"}], "\n", "  ", 
         RowBox[{"c", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"exact", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"edgeIndices", "[", 
                    RowBox[{"o", ",", 
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], 
                    "]"}], "[", 
                   RowBox[{"[", "m", "]"}], "]"}], ",", "i"}], "]"}], "]"}], " ", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"exact", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"edgeIndices", "[", 
                    RowBox[{"oo", ",", 
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], 
                    "]"}], "[", 
                    RowBox[{"[", "m", "]"}], "]"}], ",", "ii"}], "]"}], "]"}],
                 "]"}]}], ",", "\n", "   ", 
              RowBox[{"{", 
               RowBox[{"m", ",", 
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"eng", "[", "\"\<L\>\"", "]"}], "-", "2"}], 
                  ")"}]}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"o", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ii", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"oo", ",", "4"}], "}"}]}], "]"}]}], ";", 
         RowBox[{"c", "=", 
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"c", ",", 
            RowBox[{"{", 
             RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"cherrs", ",", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"c", "-", 
             RowBox[{
              RowBox[{"channelValue", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ev", "[", "\"\<Factors\>\"", "]"}], "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"ev", "[", "\"\<Derivatives\>\"", "]"}], "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", "eng"}], "]"}], 
              "[", "\"\<Choi\>\"", "]"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "ts", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"errs", ",", "cherrs"}], "]"}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Direct full-space reference check failed.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Times\>\"", "->", "ts"}], ",", 
        RowBox[{"\"\<MaximumStateFactorError\>\"", "->", 
         RowBox[{"Max", "[", "errs", "]"}]}], ",", 
        RowBox[{"\"\<MaximumChoiError\>\"", "->", 
         RowBox[{"Max", "[", "cherrs", "]"}]}], ",", 
        RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", "]"}]}],
   ";"}]], "Code",
 CellLabel->
  "In[148]:=",ExpressionUUID->"b1ec7a5a-60d7-d646-a56c-3f818c61eddc"]
}, Closed]],

