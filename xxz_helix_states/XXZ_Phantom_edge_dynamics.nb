        RowBox[{"\"\<BulkChoice\>\"", "->", 
         RowBox[{"zzRun", "[", "\"\<BulkChoice\>\"", "]"}]}]}], "|>"}]}], ";",
      "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"{", 
        RowBox[{"zzRun", "[", "\"\<Checks\>\"", "]"}], "}"}], "]"}], "]"}], ";",
      "\n", " ", 
