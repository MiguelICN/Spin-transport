Cell[CellGroupData[{

Cell["\<\
  0B. Recover the table energies before adding either probe  \
\>", "Section",ExpressionUUID->"be8e5090-773e-0f47-9c11-847dda70a4ae"],

Cell["\<\
  The verification diagonalizes the isolated field-dressed bulk. A degenerate \
level is checked by projection onto its full eigenspace, not by comparing \
with one arbitrary ED eigenvector.  \
\>", "Text",ExpressionUUID->"e1146d91-a7d3-b445-b1d6-b32d3de5b456"],

Cell["  Verification controls  ", "Text",ExpressionUUID->"fbdf08e9-a22d-264a-bf02-98c1b036afa2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"verificationSettings", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", 
     RowBox[{"\"\<DenseWorkingMemoryMB\>\"", "->", "4096"}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"verifyAllUploadedSizes", "=", "True"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"N", "=", "4"}], ",", "...", ",", 
    RowBox[{"10", ";", " ", 
     RowBox[{
     "both", " ", "vectors", " ", "in", " ", "every", " ", "supplied", " ", 
      RowBox[{"file", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"verifyAllEightTableRows", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"verificationN", "=", "4"}], ";", 
  RowBox[{"verificationGamma", "=", 
   RowBox[{"Pi", "/", "3"}]}], ";", 
  RowBox[{"verificationJ", "=", "1"}], ";"}]}], "Code",
 CellLabel->
  "In[151]:=",ExpressionUUID->"7ef27b33-ab3d-2c43-bec3-e38ec83adec4"],

Cell["  Diagonalization and energy verification  ", "Text",ExpressionUUID->"ded547e9-bcf4-4941-a1a8-ad8a018ed16c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"verificationUploaded", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "verifyAllUploadedSizes", "]"}], ",", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"verifySuppliedSizes", "[", "verificationSettings", "]"}], ",",
        "1"}], "]"}], ",", 
     RowBox[{"{", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"verificationUploaded", "=!=", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", "verificationUploaded", "]"}], "]"}], ";", "\n",
      " ", 
     RowBox[{
     "Print", "[", "\"\<Uploaded .txt energies equal -4 times the \
screenshot/benchmark energies at J=1. The Hamiltonian below uses the \
screenshot/benchmark convention.\>\"", "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"verificationTable", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "verifyAllEightTableRows", "]"}], ",", 
     RowBox[{"verifyTableBranches", "[", 
      RowBox[{
