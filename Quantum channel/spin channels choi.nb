    ";"}], "      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"rhoABref", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"rhoA", ",", " ", "rhoB"}], "]"}]}], ";"}], 
   "                        ", "*)"}]}]], "Input",
