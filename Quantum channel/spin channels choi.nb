    RowBox[{"HBlocal", " ", "=", " ", 
     RowBox[{"\[CapitalDelta]b", " ", "*", " ", "\[Sigma]z"}]}], ";"}], 
   "       ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"2", "\[Times]", "2"}], ",", " ", 
     RowBox[{"field", " ", "on", " ", "spin", " ", "B"}]}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "Boundary"}]}], " ", "coupling", " ", 
      RowBox[{"terms", " ", "--"}]}], "-"}], 
    "                                  ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Format", ":", " ", 
      RowBox[{"list", " ", "of", " ", 
       RowBox[{"{", 
        RowBox[{"opLeft", ",", " ", "opRight"}], "}"}], " ", "pairs"}]}], ",",
      " ", 
     RowBox[{"scaled", " ", "by", " ", "\[Lambda]"}]}], "            ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Each", " ", "pair", " ", "becomes", " ", "one", " ", "term", " ", "in", " ",
      "the", " ", "interaction", " ", 
     RowBox[{"Hamiltonian", "."}]}], "      ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"couplingA", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]a", ",", "\[Sigma]p", ",", "\[Sigma]m"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]a", ",", "\[Sigma]m", ",", "\[Sigma]p"}], "}"}]}], 
      "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"couplingB", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Lambda]b", ",", "\[Sigma]p", ",", "\[Sigma]m"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]b", ",", "\[Sigma]m", ",", "\[Sigma]p"}], "}"}]}], 
      "}"}]}], ";"}], 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"flip", "-", 
      RowBox[{"flop", " ", "chain"}]}], "\[LeftRightArrow]", "B"}], "  ", 
    "*)"}]}]}]], "Input",
