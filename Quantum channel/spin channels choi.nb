Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Option", " ", 
     RowBox[{"B", ":", " ", 
      RowBox[{"fully", " ", "factored", " ", "state"}]}]}], " ", "\[LongDash]",
     " ", 
    RowBox[{"swap", " ", "the", " ", "two", " ", "lines", " ", "above", " ", 
     RowBox[{"with", ":"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"rho0", "     ", "=", " ", 
