Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"BLOCK", " ", "15"}], " ", "\[LongDash]", " ", 
    RowBox[{"Precomputation", " ", "sequence"}]}], 
   "                               ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Required", " ", "inputs", " ", "already", " ", "defined", " ", 
    RowBox[{"upstream", ":"}]}], "                        ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"Eval", ",", " ", "Evec"}], "}"}], "  ", "from", " ", 
    RowBox[{"DiagonalizeH", "[", "HT", "]"}]}], "                           ",
    "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{"rho0", "          ", "from", " ", "BuildInitialState", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Correlated", "|", "Product"}], ")"}], "[", "...", "]"}]}], 
   "  ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{
   "rhoABref", "      ", "4", "\[Times]", "4", " ", "reference", " ", "spin", 
    " ", "state", " ", 
    RowBox[{"(", 
     RowBox[{"for", " ", "survival"}], ")"}]}], "         ", "*)"}], "\n", 
  RowBox[{"(*", "                 ", 
   RowBox[{"=", " ", 
    RowBox[{"rhoAB", " ", "for", " ", "correlated", " ", "case"}]}], 
   "                      ", "*)"}], "\n", 
  RowBox[{"(*", "                 ", 
   RowBox[{"=", " ", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"rhoA", ",", " ", "rhoB"}], "]"}], " ", "for", " ", "product", " ",
      "case"}]}], "  ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
