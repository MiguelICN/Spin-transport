Cell[BoxData[{
 RowBox[{
  RowBox[{"visited", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"False", ",", 
     RowBox[{"2", "^", "L"}], ",", "SparseArray"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oddMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"visited", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"j", "=", 
        RowBox[{"revIndex", "[", 
         RowBox[{"i", ",", "L"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evenMap", ",", 
           RowBox[{"{", "i", "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"evenMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oddMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";"}]}], 
