Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Assume", " ", "'"}], 
     RowBox[{"rhoGeneral", "'"}], " ", "is", " ", "your", " ", "arbitrary"}], 
    ",", " ", 
    RowBox[{"correlated", " ", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"2", "^", "L"}]}], ")"}], " ", "x", " ", 
     RowBox[{"(", 
      RowBox[{"4", "*", 
       RowBox[{"2", "^", "L"}]}], ")"}], " ", "matrix"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Layout", " ", "of", " ", "rhoGeneral", " ", 
    RowBox[{"is", " ", "[", 
     RowBox[{"Q1", ",", " ", "Q2", ",", " ", "Chain"}], "]"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dimC", " ", "=", " ", 
     RowBox[{"2", "^", "L"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "but", " ", "calculate", " ", "the", " ", "position", " ", "of", " ", 
     "that", " ", "state", " ", "in", " ", "the", " ", 
     RowBox[{"old", " ", "[", 
      RowBox[{"q1", ",", " ", "q2", ",", " ", "c"}], "]"}], " ", "layout"}], 
    " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"permList", " ", "=", " ", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Table", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"q1", " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"L", " ", "+", " ", "1"}], ")"}]}], ")"}]}], " ", "+", 
         " ", 
         RowBox[{"q2", " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{"2", "^", "L"}], ")"}]}], " ", "+", " ", "c", " ", "+", 
         " ", "1"}], ",", " ", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"q1", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"c", ",", " ", "0", ",", " ", 
          RowBox[{"dimC", " ", "-", " ", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"q2", ",", " ", "0", ",", " ", "1"}], "}"}]}], "\n", "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Transform", " ", "the", " ", "general", " ", "matrix", " ", "into", " ", 
     "your", " ", "physical", " ", 
     RowBox[{"layout", " ", "[", 
      RowBox[{"Q1", ",", " ", "Chain", ",", " ", "Q2"}], "]"}]}], " ", "*)"}],
    "\n", 
   RowBox[{
    RowBox[{"initial", " ", "=", " ", 
     RowBox[{"tempInitial", "[", 
      RowBox[{"[", 
       RowBox[{"permList", ",", " ", "permList"}], "]"}], "]"}]}], 
    ";"}]}]}]], "Input",
