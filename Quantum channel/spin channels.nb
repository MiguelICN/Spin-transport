Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "\n", 
    "   ", "PARAMETERS", "\n", "   ", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"nChain", " ", "=", " ", "4"}], ";"}], "          ", 
   RowBox[{"(*", " ", 
    RowBox[{"number", " ", "of", " ", "chain", " ", "spins"}], 
    "                  ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"nTotal", " ", "=", " ", 
     RowBox[{"nChain", " ", "+", " ", "2"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"+", "2"}], " ", "for", " ", "the", " ", "two", " ", "boundary", 
     " ", "system", " ", "spins"}], "   ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"site", " ", "1"}], " ", "=", " ", "S_A"}], ",", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"sites", " ", "2"}], ".."}], "nChain"}], "+", "1"}], " ", "=",
       " ", "chain"}], ",", "  ", 
     RowBox[{
      RowBox[{"site", " ", "nTotal"}], " ", "=", " ", "S_B"}]}], " ", "*)"}], 
   "\n", 
   RowBox[{
    RowBox[{"siteA", " ", "=", " ", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"siteB", " ", "=", " ", "nTotal"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"chainSites", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"2", ",", " ", 
       RowBox[{"nChain", " ", "+", " ", "1"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"PAULI", " ", "MATRICES", " ", "AND", " ", "SINGLE"}], "-", 
      RowBox[{"SITE", " ", "OPERATORS"}]}], "\n", "   ", "===", "===", "===", 
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "==="}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"id2", " ", "=", " ", 
     RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sx", "  ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sy", "  ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "I"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"I", ",", " ", "0"}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sz", "  ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}], "/", "2"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Embed", " ", "a", " ", "2", "x2", " ", "operator", " ", "at", " ", 
     "site", " ", "k", " ", "in", " ", "the", " ", "full", " ", 
     RowBox[{"2", "^", "nTotal"}], " ", "Hilbert", " ", "space"}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"siteOp", "[", 
      RowBox[{"op_", ",", " ", "k_"}], "]"}], " ", ":=", " ", 
     RowBox[{"KroneckerProduct", " ", "@@", " ", 
      RowBox[{"ReplacePart", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{"id2", ",", " ", "nTotal"}], "]"}], ",", "\n", "  ", 
        RowBox[{"k", " ", "->", " ", "op"}]}], "\n", "]"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9887262441209145`*^9, 3.988726244432829*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"e5a0bd83-90db-8444-9578-f923cc038424"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "\n", 
    "   ", "HAMILTONIAN", "\n", "   ", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Local"}]}], " ", "fields", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"customize", " ", "hA"}], ",", " ", "hB", ",", " ", 
        RowBox[{"hChain", " ", "as", " ", "needed"}]}], ")"}], " ", "--"}]}], 
    "-"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"hA", "     ", "=", " ", "1"}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{"field", " ", "on", " ", "S_A"}], "          ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hB", "     ", "=", " ", "1"}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{"field", " ", "on", " ", "S_B"}], "          ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"hChain", " ", "=", " ", "0.5"}], ";"}], "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"uniform", " ", "field", " ", "on", " ", "chain"}], " ", "*)"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{"HAlocal", " ", "=", " ", 
     RowBox[{"hA", " ", "*", " ", 
      RowBox[{"siteOp", "[", 
       RowBox[{"sz", ",", " ", "siteA"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"HBlocal", " ", "=", " ", 
     RowBox[{"hB", " ", "*", " ", 
      RowBox[{"siteOp", "[", 
       RowBox[{"sz", ",", " ", "siteB"}], "]"}]}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"HChainlocal", " ", "=", " ", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{"hChain", " ", "*", " ", 
        RowBox[{"siteOp", "[", 
         RowBox[{"sz", ",", " ", "k"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", "chainSites"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988726081279793*^9, 3.9887260918393383`*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"8d73d27a-3ec1-1044-a2d1-4bf936b71e84"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", "Nearest"}]}], "-", 
    RowBox[{"neighbor", " ", "chain", " ", "Heisenberg", " ", 
     RowBox[{"interactions", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "J_chain", " ", "between", " ", "adjacent", " ", "chain", " ", "spins"}], 
   " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"jChain", " ", "=", " ", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"HChainint", " ", "=", " ", 
     RowBox[{"Sum", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"jChain", " ", "*", " ", 
        RowBox[{"(", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"siteOp", "[", 
            RowBox[{"sx", ",", " ", "k"}], "]"}], " ", ".", " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"sx", ",", " ", 
             RowBox[{"k", "+", "1"}]}], "]"}]}], " ", "+", "\n", "    ", 
          RowBox[{
           RowBox[{"siteOp", "[", 
            RowBox[{"sy", ",", " ", "k"}], "]"}], " ", ".", " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"sy", ",", " ", 
             RowBox[{"k", "+", "1"}]}], "]"}]}], " ", "+", "\n", "    ", 
          RowBox[{
           RowBox[{"siteOp", "[", 
            RowBox[{"sz", ",", " ", "k"}], "]"}], " ", ".", " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"sz", ",", " ", 
             RowBox[{"k", "+", "1"}]}], "]"}]}]}], "\n", "  ", ")"}]}], ",", 
       "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"chainSites", "[", 
          RowBox[{"[", 
           RowBox[{"1", " ", ";;", " ", 
            RowBox[{"-", "2"}]}], "]"}], "]"}]}], "}"}]}], "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"pairs", " ", "within", " ", "chain"}], " ", "*)"}], "\n", 
      "]"}]}], ";"}]}]}]], "Input",
