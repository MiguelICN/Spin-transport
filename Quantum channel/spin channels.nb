Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "DEFINE", " ", "FAST", " ", "ENTROPY", " ", "AND", " ", "TRACE",
     " ", "FUNCTIONS"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{
    "VNEntropy", ",", " ", "TraceOutQubit2", ",", " ", "TraceOutQubit1"}], 
    "]"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Safely", " ", "computes", " ", "Von", " ", "Neumann", " ", "entropy", " ",
      "for", " ", "any", " ", "density", " ", "matrix"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"VNEntropy", "[", "rho_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "evals", "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Extract", " ", "strictly", " ", "positive", " ", "eigenvalues", " ", 
        "to", " ", "avoid", " ", 
        RowBox[{"Log", "[", "0", "]"}], " ", "errors"}], " ", "*)"}], "\n", 
      "  ", 
      RowBox[{
       RowBox[{"evals", " ", "=", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Chop", "[", 
            RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}], "]"}], ",", " ", 
          
          RowBox[{
           RowBox[{"#", " ", ">", " ", 
            RowBox[{"10", "^", 
             RowBox[{"-", "10"}]}]}], " ", "&"}]}], "]"}]}], ";", "\n", "  ", 
       
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{"-", "evals"}], "*", 
         RowBox[{"Log", "[", "evals", "]"}]}], "]"}]}]}], "\n", "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Fast", " ", "manual", " ", "partial", " ", "trace", " ", "to", " ", 
     "get", " ", "Spin", " ", "1", " ", 
     RowBox[{"(", 
      RowBox[{"traces", " ", "out", " ", "Spin", " ", "2"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"TraceOutQubit2", "[", "rho_", "]"}], " ", ":=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "3"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "4"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "3"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"4", ",", " ", "4"}], "]"}], "]"}]}]}], "}"}]}], "\n", 
     "}"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Fast", " ", "manual", " ", "partial", " ", "trace", " ", "to", " ", 
     "get", " ", "Spin", " ", "2", " ", 
     RowBox[{"(", 
      RowBox[{"traces", " ", "out", " ", "Spin", " ", "1"}], ")"}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"TraceOutQubit1", "[", "rho_", "]"}], " ", ":=", " ", 
    RowBox[{"{", "\n", "  ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "3"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"3", ",", " ", "4"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
      "  ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"rho", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], " ", "+", " ", 
         RowBox[{"rho", "[", 
          RowBox[{"[", 
