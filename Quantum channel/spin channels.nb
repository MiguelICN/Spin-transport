Cell[BoxData[{
 RowBox[{"ClearAll", "[", "Concurrence", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Concurrence", "[", "rho_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "sigmaY", ",", " ", "spinFlip", ",", " ", "rhoTilde", ",", " ", 
       "RmatrixEvals", ",", " ", "lambdas"}], "}"}], ",", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"1.", " ", "Define", " ", "the", " ", "global", " ", "spin"}], 
       "-", 
       RowBox[{"flip", " ", "operator"}]}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{"sigmaY", " ", "=", " ", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}], ";", "\n", "  ", 
      RowBox[{"spinFlip", " ", "=", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"sigmaY", ",", " ", "sigmaY"}], "]"}]}], ";", "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"2.", " ", "Calculate", " ", "the", " ", "spin"}], "-", 
        RowBox[{"flipped", " ", "density", " ", "matrix"}]}], " ", "*)"}], 
      "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Note", ":", " ", 
        RowBox[{
        "Conjugate", " ", "applies", " ", "complex", " ", "conjugation", " ", 
         "to", " ", "the", " ", "matrix", " ", "elements"}]}], " ", "*)"}], 
      "\n", "  ", 
      RowBox[{"rhoTilde", " ", "=", " ", 
       RowBox[{"spinFlip", " ", ".", " ", 
        RowBox[{"Conjugate", "[", "rho", "]"}], " ", ".", " ", "spinFlip"}]}],
       ";", "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "3.", " ", "Find", " ", "the", " ", "eigenvalues", " ", "of", " ", 
        "the", " ", "product", " ", 
        RowBox[{"rho", " ", ".", " ", "rhoTilde"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{"RmatrixEvals", " ", "=", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"rho", " ", ".", " ", "rhoTilde"}], "]"}], "]"}]}], ";", 
      "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "4.", " ", "Take", " ", "the", " ", "square", " ", "roots", " ", "and",
         " ", "sort", " ", "them", " ", "from", " ", "largest", " ", "to", " ",
         "smallest"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"We", " ", "use", " ", 
        RowBox[{"Re", "[", "]"}], " ", "to", " ", "strip", " ", "any", " ", 
        "microscopic", " ", "imaginary", " ", "numerical", " ", "artifacts"}],
        " ", "*)"}], "\n", "  ", 
      RowBox[{"lambdas", " ", "=", " ", 
       RowBox[{"Reverse", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Sqrt", "[", "RmatrixEvals", "]"}], "]"}], "]"}], "]"}]}], ";",
       "\n", "    ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "5.", " ", "Apply", " ", "the", " ", "Wootters", " ", "formula"}], " ",
        "*)"}], "\n", "  ", 
      RowBox[{"Max", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{
         RowBox[{"lambdas", "[", 
          RowBox[{"[", "1", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"lambdas", "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"lambdas", "[", 
          RowBox[{"[", "3", "]"}], "]"}], " ", "-", " ", 
         RowBox[{"lambdas", "[", 
          RowBox[{"[", "4", "]"}], "]"}]}]}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988918930718672*^9, 3.988918950658695*^9}},
 CellLabel->
  "In[475]:=",ExpressionUUID->"49d1a9c7-a64c-7e47-9a5c-2227f16f84a5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculate", " ", "Concurrence", " ", "for", " ", "all", " ", "501", " ", 
    "time", " ", "steps"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"concurrenceList", " ", "=", " ", 
     RowBox[{"Concurrence", " ", "/@", " ", "rhoevolved"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Zip", " ", "with", " ", "your", " ", "time", " ", "list", " ", "for", " ",
      "plotting"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"concurrenceData", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", " ", "concurrenceList"}], "}"}], "]"}]}], ";"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plot", " ", "Concurrence", " ", "to", " ", "see", " ", "the", " ", 
     "exact", " ", "moment", " ", "entanglement", " ", "dies"}], " ", "*)"}], 
   "\n", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"concurrenceData", ",", "\n", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (t)\>\"", ",", " ", "\"\<Concurrence\>\""}], "}"}]}],
      ",", "\[IndentingNewLine]", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "20"}], "]"}]}], ",", "\n", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"Darker", "[", "Red", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "600"}]}], "\n", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.988918960276518*^9, 3.988919008494177*^9}},
 CellLabel->
  "In[477]:=",ExpressionUUID->"7651ec79-e87b-f24a-8b96-f264c3379111"],

