   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"tlist", ",", "entropyList"}], "}"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Joined", "->", "True"}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]], "Input",
