Cell[BoxData[{
 RowBox[{
  RowBox[{"rhoevolved", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{"MatrixPartialTrace", "[", 
       RowBox[{
        RowBox[{"Dyad", "[", "i", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", ",", 
