Cell[BoxData[{
 RowBox[{"ClearAll", "[", "Survivalrho", "]"}], "\n", 
 RowBox[{
  RowBox[{"Survivalrho", "[", 
   RowBox[{"rho0_", ",", " ", "rhot_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sqrtRho0", "}"}], ",", "\n", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Check", " ", "if", " ", "rho0", " ", "is", " ", "pure", " ", "to", " ", 
      "use", " ", "the", " ", "faster", " ", "standard", " ", "trace", " ", 
      "method"}], " ", "*)"}], "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"rho0", " ", ".", " ", "rho0"}], "]"}], "]"}], " ", ">=", 
       " ", "0.999"}], ",", "\n", "   ", 
      RowBox[{"Chop", "[", 
       RowBox[{"Tr", "[", 
        RowBox[{"rho0", " ", ".", " ", "rhot"}], "]"}], "]"}], ",", " ", "\n",
       "   ", 
      RowBox[{"(*", " ", 
       RowBox[{"Otherwise", ",", " ", 
        RowBox[{
         RowBox[{"use", " ", "the", " ", "full", " ", "mixed"}], "-", 
         RowBox[{
         "state", " ", "Uhlmann", " ", "fidelity", " ", "definition"}]}]}], 
       " ", "*)"}], "\n", "   ", 
      RowBox[{
       RowBox[{"sqrtRho0", " ", "=", " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"rho0", ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{
            "sqrtRho0", " ", ".", " ", "rhot", " ", ".", " ", "sqrtRho0"}], ",",
             " ", 
            RowBox[{"1", "/", "2"}]}], "]"}], "]"}], "]"}], "^", "2"}]}]}], 
     "\n", "  ", "]"}]}], "\n", "]"}]}]}], "Input",
