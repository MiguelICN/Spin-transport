  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", "[", "\"\<Time\>\"", "]"}], ",", 
       RowBox[{"d", "[", "\"\<Survival\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "globalEvolutionData"}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (t)\>\"", ",", "\"\<Global Survival Probability\>\""}],
      "}"}]}], ",", 
