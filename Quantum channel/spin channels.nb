Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculate", " ", "entropy", " ", "for", " ", "every", " ", "time", " ", 
    "step"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"entropyList", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"VNentropy", " ", "/@", " ", 
        RowBox[{"Chop", "[", 
         RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rho", ",", " ", "rhoevolved"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
