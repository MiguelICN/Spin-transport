Cell[BoxData[{
 RowBox[{"ClearAll", "[", "VNentropy", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", 
    RowBox[{"0", " ", "|", " ", "0."}], "]"}], " ", "=", " ", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "x"}], "*", 
    RowBox[{"Log", "[", "x", "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[1302]:=",ExpressionUUID->"87faa6f7-ffe9-7740-96a3-b1de6828528d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculate", " ", "entropy", " ", "for", " ", "every", " ", "time", " ", 
    "step"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"entropyList", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"VNentropy", " ", "/@", " ", 
        RowBox[{"Chop", "[", 
         RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rho", ",", " ", "rhoevolved"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9888936458161945`*^9, 3.988893683900694*^9}},
 CellLabel->
  "In[1287]:=",ExpressionUUID->"0e627028-1fdf-614e-8fc0-161340cc0961"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
