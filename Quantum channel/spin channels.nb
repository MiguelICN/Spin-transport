Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Hlocal", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Hlocal", "[", 
    RowBox[{"\[CapitalDelta]a_", ",", "\[CapitalDelta]b_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"H1", "[", "\[CapitalDelta]a", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"2", "^", "L"}], "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", "Ha", ",", 
      RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"2", "^", "L"}], "]"}], ",", 
      RowBox[{"H2", "[", "\[CapitalDelta]b", "]"}]}], "]"}]}]}], 
  ";"}]}], "Input",
