         RowBox[{"Pauliplus", ",", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Pauliminus", ",", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "+", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Pauliplus", ",", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"Pauliminus", ",", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spin", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H2c", "[", "\[Lambda]b_", "]"}], ":=", 
     RowBox[{"\[Lambda]b", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
