Cell[BoxData[{
 RowBox[{
  RowBox[{"Ha", "=", 
   RowBox[{"IsingHamiltonian", "[", 
    RowBox[{"J", ",", "g", ",", "J", ",", "L", ",", 
     RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"system", "=", 
