Cell[BoxData[{
 RowBox[{
  RowBox[{"Pauliplus", "=", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "1", "]"}], "+", 
    RowBox[{"I", "*", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pauliminus", "=", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "1", "]"}], "-", 
    RowBox[{"I", "*", 
     RowBox[{"PauliMatrix", "[", "2", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.988890334364403*^9, 3.9888903910170727`*^9}},
