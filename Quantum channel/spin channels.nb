Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "DensityMatrixEvolution", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DensityMatrixEvolution", "[", 
   RowBox[{
   "t_", ",", " ", "rho0_", ",", " ", "eigenvals_", ",", " ", "eigenvecs_"}], 
   "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rhoEnergy", ",", " ", "phaseMatrix", ",", " ", "rhoEnergyT"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rhoEnergy", " ", "=", " ", 
      RowBox[{"eigenvecs", " ", ".", " ", "rho0", " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "eigenvecs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"phaseMatrix", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{"m", " ", "-", " ", "n"}], ")"}], " ", "*", " ", "t"}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "eigenvals"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "eigenvals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rhoEnergyT", " ", "=", " ", 
      RowBox[{"rhoEnergy", " ", "*", " ", "phaseMatrix"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "eigenvecs", "]"}], ".", 
       "rhoEnergyT", ".", "eigenvecs"}], "]"}]}]}], "\n", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9888941827108517`*^9, 3.988894251632736*^9}},
 CellLabel->
  "In[1495]:=",ExpressionUUID->"284c03d4-431e-c147-b779-3f32359dcddb"],

Cell[BoxData[{
 RowBox[{"ClearAll", "[", "Survivalrho", "]"}], "\n", 
 RowBox[{
  RowBox[{"Survivalrho", "[", 
   RowBox[{"rho0_", ",", " ", "rhot_"}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "sqrtRho0", "}"}], ",", "\n", "  ", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Check", " ", "if", " ", "rho0", " ", "is", " ", "pure", " ", "to", " ", 
      "use", " ", "the", " ", "faster", " ", "standard", " ", "trace", " ", 
      "method"}], " ", "*)"}], "\n", "  ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Chop", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"rho0", " ", ".", " ", "rho0"}], "]"}], "]"}], " ", ">=", 
       " ", "0.999"}], ",", "\n", "   ", 
      RowBox[{"Chop", "[", 
       RowBox[{"Tr", "[", 
        RowBox[{"rho0", " ", ".", " ", "rhot"}], "]"}], "]"}], ",", " ", "\n",
       "   ", 
      RowBox[{"(*", " ", 
       RowBox[{"Otherwise", ",", " ", 
        RowBox[{
         RowBox[{"use", " ", "the", " ", "full", " ", "mixed"}], "-", 
         RowBox[{
         "state", " ", "Uhlmann", " ", "fidelity", " ", "definition"}]}]}], 
       " ", "*)"}], "\n", "   ", 
      RowBox[{
       RowBox[{"sqrtRho0", " ", "=", " ", 
        RowBox[{"MatrixPower", "[", 
         RowBox[{"rho0", ",", " ", 
          RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\n", "   ", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{
            RowBox[{
            "sqrtRho0", " ", ".", " ", "rhot", " ", ".", " ", "sqrtRho0"}], ",",
             " ", 
            RowBox[{"1", "/", "2"}]}], "]"}], "]"}], "]"}], "^", "2"}]}]}], 
     "\n", "  ", "]"}]}], "\n", "]"}]}]}], "Input",
 CellChangeTimes->{{3.98889434300766*^9, 3.988894355338211*^9}},
 CellLabel->
  "In[1497]:=",ExpressionUUID->"a94b4d9d-8c8b-f747-942e-735ff0198b22"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Run", " ", "the", " ", "full", " ", "matrix", " ", "evolution", " ", 
    "loop"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"globalEvolutionData", " ", "=", " ", 
    RowBox[{"ParallelTable", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhoGlobal", ",", " ", "surv", ",", "rhoReduced"}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rhoGlobal", "=", 
          RowBox[{"DensityMatrixEvolution", "[", 
           RowBox[{"t", ",", " ", "initial", ",", "fullval", ",", "fullvec"}],
            "]"}]}], ";", "\[IndentingNewLine]", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "2.", " ", "Compute", " ", "global", " ", "survival", " ", 
           "probability"}], " ", "*)"}], "\n", "    ", 
         RowBox[{"surv", " ", "=", " ", 
          RowBox[{"Survivalrho", "[", 
           RowBox[{"initial", ",", " ", "rhoGlobal"}], "]"}]}], ";", "    ", 
         "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "3.", " ", "Compute", " ", "the", " ", "reduced", " ", "4", "x4", " ",
            "density", " ", "matrix", " ", "for", " ", "your", " ", "spins"}],
           " ", "*)"}], "\n", "    ", 
         RowBox[{"rhoReduced", " ", "=", " ", 
          RowBox[{"Chop", "[", 
           RowBox[{"MatrixPartialTrace", "[", 
            RowBox[{"rhoGlobal", ",", " ", 
             RowBox[{"{", "2", "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", 
               RowBox[{"2", "^", "L"}], ",", " ", "2"}], "}"}]}], "]"}], 
           "]"}]}], ";", "    ", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Return", " ", "everything", " ", "in", " ", "a", " ", "structured",
            " ", "association", " ", "for", " ", "easy", " ", "access"}], " ",
           "*)"}], "\n", "    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
           RowBox[{"\"\<Survival\>\"", " ", "->", " ", "surv"}], ",", " ", 
           RowBox[{"\"\<RhoReduced\>\"", " ", "->", " ", "rhoReduced"}]}], 
          "|>"}]}]}], "\n", "   ", "]"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "   ", 
      RowBox[{"DistributedContexts", " ", "->", " ", "Full"}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.988894390816843*^9, 3.9888945041689796`*^9}, {
  3.988894601569704*^9, 3.9888946042486706`*^9}, {3.9888946470838394`*^9, 
  3.988894651760084*^9}},
 CellLabel->
  "In[1499]:=",ExpressionUUID->"b85a1aee-dee0-7c4c-b8ac-f523dd9b4e62"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", "[", "\"\<Time\>\"", "]"}], ",", 
       RowBox[{"d", "[", "\"\<Survival\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"d", ",", "globalEvolutionData"}], "}"}]}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (t)\>\"", ",", "\"\<Global Survival Probability\>\""}],
      "}"}]}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9888945256534367`*^9, 3.988894542560215*^9}},
 CellLabel->
  "In[1500]:=",ExpressionUUID->"d70d7698-37c1-bf4e-a2c9-bf4f29519b16"],

