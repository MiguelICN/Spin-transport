     RowBox[{"{", 
      RowBox[{"i", ",", "stateevolved"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"puritya", "=", 
