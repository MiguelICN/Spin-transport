       RowBox[{"Eigensystem", "[", 
        RowBox[{"system", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
