   3.988892356168127*^9}, {3.9888965363068733`*^9, 3.9888965367852726`*^9}, 
   3.9889178377362995`*^9, {3.9889179938724747`*^9, 3.9889179954793835`*^9}, {
   3.9889201867225018`*^9, 3.9889201894339314`*^9}},
 CellLabel->
  "In[461]:=",ExpressionUUID->"a07a1c0e-9464-0746-a255-bd9bcfc856a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Run", " ", "the", " ", "full", " ", "matrix", " ", "evolution", " ", 
    "loop"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"globalEvolutionData", " ", "=", " ", 
    RowBox[{"ParallelTable", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rhoGlobal", ",", " ", "surv", ",", "rhoReduced"}], "}"}], ",",
         "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rhoGlobal", "=", 
          RowBox[{"DensityMatrixEvolution", "[", 
           RowBox[{"t", ",", " ", "initial", ",", "fullval", ",", "fullvec"}],
            "]"}]}], ";", "\[IndentingNewLine]", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "2.", " ", "Compute", " ", "global", " ", "survival", " ", 
           "probability"}], " ", "*)"}], "\n", "    ", 
         RowBox[{"surv", " ", "=", " ", 
          RowBox[{"Survivalrho", "[", 
           RowBox[{"initial", ",", " ", "rhoGlobal"}], "]"}]}], ";", "    ", 
         "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "3.", " ", "Compute", " ", "the", " ", "reduced", " ", "4", "x4", " ",
            "density", " ", "matrix", " ", "for", " ", "your", " ", "spins"}],
           " ", "*)"}], "\n", "    ", 
         RowBox[{"rhoReduced", " ", "=", " ", 
          RowBox[{"Chop", "[", 
           RowBox[{"MatrixPartialTrace", "[", 
            RowBox[{"rhoGlobal", ",", " ", 
             RowBox[{"{", "2", "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", 
               RowBox[{"2", "^", "L"}], ",", " ", "2"}], "}"}]}], "]"}], 
           "]"}]}], ";", "    ", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Return", " ", "everything", " ", "in", " ", "a", " ", "structured",
            " ", "association", " ", "for", " ", "easy", " ", "access"}], " ",
           "*)"}], "\n", "    ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
           RowBox[{"\"\<Survival\>\"", " ", "->", " ", "surv"}], ",", " ", 
           RowBox[{"\"\<RhoReduced\>\"", " ", "->", " ", "rhoReduced"}]}], 
          "|>"}]}]}], "\n", "   ", "]"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "   ", 
      RowBox[{"DistributedContexts", " ", "->", " ", "Full"}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.988894390816843*^9, 3.9888945041689796`*^9}, {
  3.988894601569704*^9, 3.9888946042486706`*^9}, {3.9888946470838394`*^9, 
  3.988894651760084*^9}},
 CellLabel->
  "In[462]:=",ExpressionUUID->"a6aa0875-29a9-6c4d-9c3b-a8d59a46269f"],

