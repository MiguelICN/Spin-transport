Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "1.", " ", "Setup", " ", "states", " ", "exactly", " ", "as", " ", "you", " ",
     "have", " ", "them"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"bellState", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}], "*", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"rho12", " ", "=", " ", 
     RowBox[{"Dyad", "[", "bellState", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhochain", " ", "=", " ", 
     RowBox[{"Dyad", "[", 
      RowBox[{"coherentstate", "[", 
       RowBox[{
        RowBox[{"qubit", "[", 
         RowBox[{"1.", ",", " ", "0"}], "]"}], ",", " ", "L"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"2.", " ", "Build", " ", "temporary", " ", "matrix", " ", 
     RowBox[{"in", " ", "[", 
      RowBox[{"Q1", ",", " ", "Q2", ",", " ", "Chain"}], "]"}], " ", 
     "order"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"tempInitial", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"rho12", ",", " ", "rhochain"}], "]"}]}], ";"}]}]}]], "Input",
