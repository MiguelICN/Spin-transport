Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "2.", " ", "COMPUTE", " ", "ALL", " ", "METRICS", " ", "ACROSS", " ", 
    "TIME"}], "         ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "==="}], " ", "*)"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Survival", " ", "Probability", " ", "and", " ", "Concurrence", " ", 
    RowBox[{"(", 
     RowBox[{"using", " ", "your", " ", "existing", " ", "functions"}], 
     ")"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"spinSurvivalList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"SurvivalProbability", "[", 
        RowBox[{"rho12", ",", " ", "#"}], "]"}], " ", "&"}], " ", "/@", " ", 
      "rhoevolved"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"concurrenceList", " ", "=", " ", 
     RowBox[{"Concurrence", " ", "/@", " ", "rhoevolved"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Purity", " ", "of", " ", "the", " ", "joint", " ", "4", "x4", " ", 
     RowBox[{"state", ":", " ", 
      RowBox[{"Tr", 
       RowBox[{"(", 
        RowBox[{"rho", "^", "2"}], ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"purityList", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"#", " ", ".", " ", "#"}], "]"}], "]"}], "]"}], " ", "&"}], 
      " ", "/@", " ", "rhoevolved"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Von", " ", "Neumann", " ", "Entropy", " ", "of", " ", "just", " ", 
     "Spin", " ", "1"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoSpin1List", " ", "=", " ", 
     RowBox[{"TraceOutQubit2", " ", "/@", " ", "rhoevolved"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"entropySpin1List", " ", "=", " ", 
     RowBox[{"VNEntropy", " ", "/@", " ", "rhoSpin1List"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Mutual", " ", 
     RowBox[{"Information", ":", " ", 
      RowBox[{"Total", " ", "correlations", " ", 
       RowBox[{"(", 
        RowBox[{"Classical", " ", "+", " ", "Quantum"}], ")"}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"I", 
      RowBox[{"(", 
       RowBox[{"A", ":", "B"}], ")"}]}], " ", "=", " ", 
     RowBox[{
      RowBox[{"S", 
       RowBox[{"(", "A", ")"}]}], " ", "+", " ", 
      RowBox[{"S", 
       RowBox[{"(", "B", ")"}]}], " ", "-", " ", 
      RowBox[{"S", 
       RowBox[{"(", "AB", ")"}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoSpin2List", " ", "=", " ", 
     RowBox[{"TraceOutQubit1", " ", "/@", " ", "rhoevolved"}]}], ";"}], "\n", 
   
   RowBox[{
    RowBox[{"mutualInfoList", " ", "=", " ", 
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"VNEntropy", "[", 
         RowBox[{"rhoSpin1List", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", "+", " ", 
        RowBox[{"VNEntropy", "[", 
         RowBox[{"rhoSpin2List", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}], " ", "-", " ", 
        RowBox[{"VNEntropy", "[", 
         RowBox[{"rhoevolved", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", 
         RowBox[{"Length", "[", "rhoevolved", "]"}]}], "}"}]}], "\n", "]"}]}],
     ";"}]}]}]], "Input",
