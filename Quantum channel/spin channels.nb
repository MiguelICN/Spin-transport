Cell[CellGroupData[{

Cell["Subsystem evolution", "Chapter",
 CellChangeTimes->{{3.9888915369175854`*^9, 
  3.988891543804064*^9}},ExpressionUUID->"78e7c62f-dc7a-7e4c-9bb3-\
815ad34b61c8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Evolve", " ", "the", " ", "full", " ", "density", " ", "matrix", " ", 
    "and", " ", "isolate", " ", "ONLY", " ", "Spin", " ", "1"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"rhoevolved", " ", "=", " ", 
    RowBox[{"ParallelTable", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "rhoGlobal", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rhoGlobal", " ", "=", " ", 
          RowBox[{"DensityMatrixEvolution", "[", 
           RowBox[{
           "t", ",", " ", "initial", ",", " ", "fullval", ",", " ", 
            "fullvec"}], "]"}]}], ";", 
         RowBox[{"Chop", "[", 
          RowBox[{"MatrixPartialTrace", "[", 
           RowBox[{"rhoGlobal", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", 
              RowBox[{"2", "^", "L"}], ",", " ", "2"}], "}"}]}], "]"}], 
