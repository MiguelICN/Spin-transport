Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Spin", " ", "1", " ", "coupling"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"H1c", "[", "\[Lambda]a_", "]"}], ":=", 
     RowBox[{"\[Lambda]a", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"Pauliplus", ",", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Pauliminus", ",", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "+", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Pauliplus", ",", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"Pauliminus", ",", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spin", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H2c", "[", "\[Lambda]b_", "]"}], ":=", 
     RowBox[{"\[Lambda]b", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"L", "-", "1"}], ")"}]}], "]"}], ",", "Pauliplus"}], 
           "]"}], ",", "Pauliminus"}], "]"}], "+", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"L", "-", "1"}], ")"}]}], "]"}], ",", "Pauliplus"}], 
            "]"}], ",", "Pauliminus"}], "]"}], "]"}]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9888902367088947`*^9, 3.988890289857876*^9}, {
