Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Ensure", " ", "the", " ", "function", " ", "is", " ", "defined", " ", 
    "just", " ", "in", " ", "case"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ClearAll", "[", "SurvivalProbability", "]"}], "\n", 
   RowBox[{
    RowBox[{"SurvivalProbability", "[", 
     RowBox[{"rho0_", ",", " ", "rhot_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "sqrtRho0", "}"}], ",", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Check", " ", "if", " ", "rho0", " ", "is", " ", "pure", " ", "to", " ",
         "use", " ", "the", " ", "faster", " ", "standard", " ", "trace", " ",
         "method"}], " ", "*)"}], "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Chop", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"rho0", " ", ".", " ", "rho0"}], "]"}], "]"}], " ", ">=", 
         " ", "0.999"}], ",", "\n", "   ", 
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"rho0", " ", ".", " ", "rhot"}], "]"}], "]"}], ",", " ", 
        "\n", "   ", 
        RowBox[{"(*", " ", 
         RowBox[{"Otherwise", ",", " ", 
          RowBox[{
           RowBox[{"use", " ", "the", " ", "full", " ", "mixed"}], "-", 
           RowBox[{
           "state", " ", "Uhlmann", " ", "fidelity", " ", "definition"}]}]}], 
         " ", "*)"}], "\n", "   ", 
        RowBox[{
         RowBox[{"sqrtRho0", " ", "=", " ", 
          RowBox[{"MatrixPower", "[", 
           RowBox[{"rho0", ",", " ", 
            RowBox[{"1", "/", "2"}]}], "]"}]}], ";", "\n", "   ", 
         RowBox[{
          RowBox[{"Chop", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{
              RowBox[{
              "sqrtRho0", " ", ".", " ", "rhot", " ", ".", " ", "sqrtRho0"}], 
              ",", " ", 
              RowBox[{"1", "/", "2"}]}], "]"}], "]"}], "]"}], "^", "2"}]}]}], 
       "\n", "  ", "]"}]}], "\n", "]"}]}]}]}]], "Input",
 CellLabel->
  "In[469]:=",ExpressionUUID->"8d7334af-094c-8d4c-926f-628e8dd1f3e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Evolve", " ", "the", " ", "full", " ", "density", " ", "matrix", " ", 
    "and", " ", "isolate", " ", "ONLY", " ", "Spin", " ", "1"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"rhoevolved", " ", "=", " ", 
    RowBox[{"ParallelTable", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "rhoGlobal", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rhoGlobal", " ", "=", " ", 
          RowBox[{"DensityMatrixEvolution", "[", 
           RowBox[{
           "t", ",", " ", "initial", ",", " ", "fullval", ",", " ", 
            "fullvec"}], "]"}]}], ";", 
         RowBox[{"Chop", "[", 
          RowBox[{"MatrixPartialTrace", "[", 
           RowBox[{"rhoGlobal", ",", " ", 
            RowBox[{"{", "2", "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", 
              RowBox[{"2", "^", "L"}], ",", " ", "2"}], "}"}]}], "]"}], 
          "]"}]}]}], "\n", "     ", "]"}], ",", " ", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", " ", "\n", "     ", 
      RowBox[{"DistributedContexts", " ", "->", " ", "Full"}]}], "\n", "   ", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9889183763065186`*^9, 3.988918376921526*^9}},
 CellLabel->
  "In[471]:=",ExpressionUUID->"25ae1249-df65-1d43-bcf3-fb8109567fbf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "1.", " ", "Calculate", " ", "the", " ", "survival", " ", "probability", " ",
      "of", " ", "the", " ", "2"}], "-", 
    RowBox[{"qubit", " ", "state", " ", "over", " ", "time"}]}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"spinSurvivalList", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"SurvivalProbability", "[", 
       RowBox[{"rho12", ",", " ", "rhot"}], "]"}], ",", " ", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"rhot", ",", " ", "rhoevolved"}], "}"}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[472]:=",ExpressionUUID->"3c9a617b-2ada-794e-8e89-0dc15fbd0ea8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "2.", " ", "Zip", " ", "it", " ", "with", " ", "your", " ", "time", " ", 
    "list", " ", "so", " ", "you", " ", "can", " ", "plot", " ", "it"}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"spinSurvivalData", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", " ", "spinSurvivalList"}], "}"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"3.", " ", "Plot", " ", "the", " ", "result"}], " ", "*)"}], "\n", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"spinSurvivalData", ",", "\n", " ", 
     RowBox[{"PlotRange", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", " ", "1.05"}], "}"}]}], ",", "\n", " ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", "\n", " ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Time (t)\>\"", ",", " ", "\"\<Spin Survival\>\""}], 
       "}"}]}], ",", "\[IndentingNewLine]", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "20"}], "]"}]}], ",", "\n", " ", 
     RowBox[{"PlotStyle", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", " ", 
        RowBox[{"Darker", "[", "Blue", "]"}]}], "}"}]}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"ImageSize", "->", "600"}]}], "\n", "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9889183060728493`*^9, 3.9889183373437386`*^9}, {
  3.9889183951133957`*^9, 3.988918450320738*^9}},
