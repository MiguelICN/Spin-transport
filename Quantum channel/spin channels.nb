Cell[BoxData[{
 RowBox[{"ClearAll", "[", "VNentropy", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", 
    RowBox[{"0", " ", "|", " ", "0."}], "]"}], " ", "=", " ", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"-", "x"}], "*", 
    RowBox[{"Log", "[", "x", "]"}]}]}], ";"}]}], "Input",
 CellLabel->
  "In[1504]:=",ExpressionUUID->"e4749d47-a8d9-444f-83c5-ad44884a1c3f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Calculate", " ", "entropy", " ", "for", " ", "every", " ", "time", " ", 
    "step"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"entropyList", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{"VNentropy", " ", "/@", " ", 
        RowBox[{"Chop", "[", 
         RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"rho", ",", " ", "rhoevolved"}], "}"}]}], "]"}]}], 
   ";"}]}]], "Input",
 CellChangeTimes->{{3.9888936458161945`*^9, 3.988893683900694*^9}},
 CellLabel->
  "In[1507]:=",ExpressionUUID->"42ae97b5-0f84-6b4f-abda-048b71040425"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
