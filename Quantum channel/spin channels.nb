Cell[CellGroupData[{

Cell["Subsystem evolution", "Chapter",
 CellChangeTimes->{{3.9888915369175854`*^9, 
  3.988891543804064*^9}},ExpressionUUID->"9c90b910-21cd-2d40-8883-\
f58d8899550f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Evolve", " ", "the", " ", "full", " ", "density", " ", "matrix", " ", 
    "and", " ", "isolate", " ", "ONLY", " ", "Spin", " ", "1"}], " ", "*)"}], 
  "\n", 
  RowBox[{
   RowBox[{"rhoevolved", " ", "=", " ", 
    RowBox[{"ParallelTable", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "rhoGlobal", "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"rhoGlobal", " ", "=", " ", 
          RowBox[{"DensityMatrixEvolution", "[", 
           RowBox[{
           "t", ",", " ", "initial", ",", " ", "fullval", ",", " ", 
            "fullvec"}], "]"}]}], ";", 
         RowBox[{"Chop", "[", 
          RowBox[{"MatrixPartialTrace", "[", 
           RowBox[{"rhoGlobal", ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{"2", ",", " ", 
              RowBox[{"2", "^", "L"}], ",", " ", "2"}], "}"}]}], "]"}], 
          "]"}]}]}], "\n", "     ", "]"}], ",", " ", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", " ", "\n", "     ", 
      RowBox[{"DistributedContexts", " ", "->", " ", "Full"}]}], "\n", "   ", 
     "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.988896443726633*^9, 3.9888964683368225`*^9}},
 CellLabel->
  "In[464]:=",ExpressionUUID->"d471da65-bd76-434d-900e-29306b823bb7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"purity", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{"Tr", "[", 
       RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "rhoevolved"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9888922317669983`*^9, 3.988892253070326*^9}, {
  3.988892291779896*^9, 3.9888922941792183`*^9}},
