Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"--", 
     RowBox[{"-", " ", "System"}]}], "-", 
    RowBox[{"chain", " ", "boundary", " ", 
     RowBox[{"coupling", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "S_A", " ", "couples", " ", "to", " ", "first", " ", "chain", " ", 
     "site"}], ",", " ", 
    RowBox[{"S_B", " ", "to", " ", "last"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"jBoundary", " ", "=", " ", "0.5"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"HAcouple", " ", "=", " ", 
     RowBox[{"jBoundary", " ", "*", " ", 
      RowBox[{"(", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"siteOp", "[", 
          RowBox[{"sx", ",", " ", "siteA"}], "]"}], " ", ".", " ", 
         RowBox[{"siteOp", "[", 
          RowBox[{"sx", ",", " ", 
           RowBox[{"chainSites", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "+", "\n", "  ", 
        RowBox[{
         RowBox[{"siteOp", "[", 
          RowBox[{"sy", ",", " ", "siteA"}], "]"}], " ", ".", " ", 
         RowBox[{"siteOp", "[", 
          RowBox[{"sy", ",", " ", 
           RowBox[{"chainSites", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], " ", "+", "\n", "  ", 
        RowBox[{
         RowBox[{"siteOp", "[", 
          RowBox[{"sz", ",", " ", "siteA"}], "]"}], " ", ".", " ", 
         RowBox[{"siteOp", "[", 
          RowBox[{"sz", ",", " ", 
           RowBox[{"chainSites", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}]}], "\n", ")"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"HBcouple", " ", "=", " ", 
