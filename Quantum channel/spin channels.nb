2907bf0233af"],

Cell[BoxData[
 RowBox[{
  RowBox[{"L", "=", "6"}], ";"}]], "Input",
 CellChangeTimes->{{3.988916181992977*^9, 3.98891618244998*^9}, {
  3.9889178876275387`*^9, 3.988917887962145*^9}, {3.9889179761544647`*^9, 
  3.988917976267166*^9}},
 CellLabel->
  "In[118]:=",ExpressionUUID->"28be2b2e-1aeb-d74f-ac2d-ba16d0e6266f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"visited", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"False", ",", 
     RowBox[{"2", "^", "L"}], ",", "SparseArray"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oddMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"visited", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"j", "=", 
        RowBox[{"revIndex", "[", 
         RowBox[{"i", ",", "L"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evenMap", ",", 
           RowBox[{"{", "i", "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"evenMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oddMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "L"}], ")"}], "-", "1"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[119]:=",ExpressionUUID->"80b19b5e-66ca-064e-8a90-7d64eea48d07"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Spin", " ", "1"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"H1", "[", "\[CapitalDelta]a_", "]"}], ":=", 
     RowBox[{"\[CapitalDelta]a", "*", 
      RowBox[{"Pauli", "[", "3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spin", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H2", "[", "\[CapitalDelta]b_", "]"}], ":=", 
     RowBox[{"\[CapitalDelta]b", "*", 
      RowBox[{"Pauli", "[", "3", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pauliplus", "=", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], "+", 
      RowBox[{"I", "*", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Pauliminus", "=", 
     RowBox[{
      RowBox[{"PauliMatrix", "[", "1", "]"}], "-", 
      RowBox[{"I", "*", 
       RowBox[{"PauliMatrix", "[", "2", "]"}]}]}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"ae5566a2-64e2-d54d-aedd-820d5bcc27a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Spin", " ", "1", " ", "coupling"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"H1c", "[", "\[Lambda]a_", "]"}], ":=", 
     RowBox[{"\[Lambda]a", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"Pauliplus", ",", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Pauliminus", ",", 
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "+", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"Pauliplus", ",", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{"Pauliminus", ",", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"L", "-", "1"}], ")"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "]"}], "]"}]}], 
       ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Spin", " ", "2"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H2c", "[", "\[Lambda]b_", "]"}], ":=", 
     RowBox[{"\[Lambda]b", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"L", "-", "1"}], ")"}]}], "]"}], ",", "Pauliplus"}], 
           "]"}], ",", "Pauliminus"}], "]"}], "+", 
        RowBox[{"ConjugateTranspose", "[", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", "2", "]"}], ",", 
           RowBox[{"KroneckerProduct", "[", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"L", "-", "1"}], ")"}]}], "]"}], ",", "Pauliplus"}], 
            "]"}], ",", "Pauliminus"}], "]"}], "]"}]}], ")"}]}]}], 
    ";"}]}]}]], "Input",
 CellLabel->
  "In[127]:=",ExpressionUUID->"77cb5b91-a61f-484a-be91-fa6a0364eedb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "DensityMatrixEvolution", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DensityMatrixEvolution", "[", 
   RowBox[{
   "t_", ",", " ", "rho0_", ",", " ", "eigenvals_", ",", " ", "eigenvecs_"}], 
   "]"}], " ", ":=", " ", "\n", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"rhoEnergy", ",", " ", "phaseMatrix", ",", " ", "rhoEnergyT"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"rhoEnergy", " ", "=", " ", 
      RowBox[{"eigenvecs", " ", ".", " ", "rho0", " ", ".", " ", 
       RowBox[{"ConjugateTranspose", "[", "eigenvecs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"phaseMatrix", " ", "=", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "*", " ", 
          RowBox[{"(", 
           RowBox[{"m", " ", "-", " ", "n"}], ")"}], " ", "*", " ", "t"}], 
         "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"m", ",", " ", "eigenvals"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"n", ",", " ", "eigenvals"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"rhoEnergyT", " ", "=", " ", 
      RowBox[{"rhoEnergy", " ", "*", " ", "phaseMatrix"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Chop", "[", 
      RowBox[{
