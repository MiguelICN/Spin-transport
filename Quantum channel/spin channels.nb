 RowBox[{
  RowBox[{"m", "=", 
   RowBox[{"2", "^", "La"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"2", "^", "Lb"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
