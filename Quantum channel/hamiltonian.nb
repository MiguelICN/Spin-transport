       RowBox[{
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"Pi", " ", "/", " ", "4"}], ")"}]}], " ", "*", " ", 
        RowBox[{"s", "^", "2"}]}], "]"}]}]}], ";"}]}]}]], "Input",
