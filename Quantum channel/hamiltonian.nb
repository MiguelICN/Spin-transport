Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"3.", " ", "Loop", " ", "over", " ", "all", " ", "Magnetization", " ", 
    RowBox[{"(", "k", ")"}], " ", "and", " ", "Parity", " ", 
    RowBox[{"(", "p", ")"}], " ", "sectors"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<Starting spectral analysis across all sectors...\>\"", 
     "]"}], ";"}], "\n", 
   RowBox[{"AbsoluteTiming", "[", "\n", "  ", 
    RowBox[{"Do", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Do", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "V", ",", " ", "dimSector", ",", " ", "HSector", ",", " ", 
            "sectorEnergies", ",", " ", "rStat"}], "}"}], ",", "\n", 
          "        ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Build", " ", "Projector", " ", "for", " ", "this", " ", 
            "specific", " ", "k", " ", "and", " ", "p"}], " ", "*)"}], "\n", 
          "        ", 
          RowBox[{
           RowBox[{"V", " ", "=", " ", 
            RowBox[{"BuildSectorProjector", "[", 
             RowBox[{"L", ",", " ", "k", ",", " ", "p"}], "]"}]}], ";", "\n", 
           "        ", 
           RowBox[{"dimSector", " ", "=", " ", 
            RowBox[{"Last", "[", 
             RowBox[{"Dimensions", "[", "V", "]"}], "]"}]}], ";", "\n", 
           "        ", "\n", "        ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "Only", " ", "compute", " ", "statistics", " ", "if", " ", "the", 
             " ", "sector", " ", "has", " ", "at", " ", "least", " ", "3", " ",
              "levels"}], " ", "*)"}], "\n", "        ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"dimSector", " ", ">=", " ", "3"}], ",", "\n", 
             "          ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{
               "Project", " ", "H", " ", "into", " ", "the", " ", "sub"}], "-", 
               RowBox[{
               "basis", " ", "and", " ", "explicitly", " ", "make", " ", "it",
                 " ", "Normal", " ", 
                RowBox[{"(", "dense", ")"}], " ", "\n", "             ", "to",
                 " ", "prevent", " ", "the", " ", 
                RowBox[{"Eigenvalues", "::", "arh"}], " ", "warning"}]}], " ",
               "*)"}], "\n", "          ", 
             RowBox[{
              RowBox[{"HSector", " ", "=", " ", 
               RowBox[{"Normal", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", "V", "]"}], " ", ".", " ", "HT", 
                 " ", ".", " ", "V"}], "]"}]}], ";", "\n", "          ", "\n",
               "          ", 
              RowBox[{"(*", " ", 
               RowBox[{
                RowBox[{"Diagonalize", " ", "and", " ", "compute"}], " ", "<",
                 "r", ">"}], " ", "*)"}], "\n", "          ", 
              RowBox[{"sectorEnergies", " ", "=", " ", 
               RowBox[{"Eigenvalues", "[", "HSector", "]"}]}], ";", "\n", 
              "          ", 
              RowBox[{"rStat", " ", "=", " ", 
               RowBox[{"LevelSpacingRatio", "[", "sectorEnergies", "]"}]}], ";",
               "\n", "          ", "\n", "          ", 
              RowBox[{"(*", " ", 
               RowBox[{"Store", " ", "result"}], " ", "*)"}], "\n", 
              "          ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"spectralResults", ",", " ", 
                RowBox[{"{", 
                 RowBox[{
                 "k", ",", " ", "p", ",", " ", "dimSector", ",", " ", 
                  "rStat"}], "}"}]}], "]"}], ";"}]}], "\n", "        ", "]"}],
            ";"}]}], "\n", "      ", "]"}], ",", "\n", "      ", 
        RowBox[{"{", 
         RowBox[{"p", ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", " ", 
            RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"Parity", " ", "can", " ", "be"}], " ", "+", 
         RowBox[{"1", " ", 
          RowBox[{"(", "Symmetric", ")"}], " ", "or"}], " ", "-", 
         RowBox[{"1", " ", 
          RowBox[{"(", "Antisymmetric", ")"}]}]}], " ", "*)"}], "\n", "    ", 
       "]"}], ",", "\n", "    ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "Nspins"}], "}"}]}], " ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Magnetization", " ", "ranges", " ", "from", " ", "0", " ", "to", " ", 
       "Total", " ", "Spins"}], " ", "*)"}], "\n", "  ", "]"}], "\n", "]"}], 
   "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "4.", " ", "Format", " ", "and", " ", "display", " ", "the", " ", 
     "results"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
    "Print", "[", "\"\<\\n=== FULL SPECTRUM SYMMETRY ANALYSIS ===\>\"", "]"}],
     ";"}], "\n", 
   RowBox[{
    RowBox[{"PrependTo", "[", 
     RowBox[{"spectralResults", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<k (Up-spins)\>\"", ",", " ", "\"\<Parity (p)\>\"", ",", 
        " ", "\"\<Dimension\>\"", ",", " ", "\"\<<r> Ratio\>\""}], "}"}]}], 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{"Grid", "[", 
    RowBox[{"spectralResults", ",", " ", "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "All"}], ",", " ", "\n", "  ", 
     RowBox[{"Background", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{"LightBlue", ",", " ", "None"}], "}"}]}], "}"}]}], ",", " ", 
     "\n", "  ", 
     RowBox[{"Alignment", " ", "->", " ", "Center"}]}], "\n", 
    "]"}]}]}]], "Input",
