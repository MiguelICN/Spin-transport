    "Analytical", " ", "P", 
    RowBox[{"(", "s", ")"}]}], "                    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "GetNormalizedSpacings", ",", " ", "PPoissonS", ",", " ", "PGOES"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"GetNormalizedSpacings", "[", "unfoldedEnergies_List", "]"}], 
     " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "spacings", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"spacings", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{"Sort", "[", "unfoldedEnergies", "]"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"spacings", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"spacings", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", ">", " ", "1.*^-10"}], " ", "&"}]}], "]"}]}], ";",
         " ", 
        RowBox[{"(*", " ", 
         RowBox[{"Remove", " ", "degeneracies"}], " ", "*)"}], "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spacings", "]"}], " ", "<", " ", "1"}], ",",
           " ", 
          RowBox[{"Return", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}], ";", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Normalize", " ", "so", " ", "the", " ", "mean", " ", "spacing", " ",
           "is", " ", "exactly", " ", "1"}], " ", "*)"}], "\n", "  ", 
        RowBox[{"spacings", " ", "/", " ", 
         RowBox[{"Mean", "[", "spacings", "]"}]}]}]}], "\n", "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Analytical", " ", "distributions", " ", "for", " ", "P", 
     RowBox[{"(", "s", ")"}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PPoissonS", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{"-", "s"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PGOES", "[", "s_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
