Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"1.", " ", "ENSEMBLE", " ", "GENERATION", " ", 
    RowBox[{"(", 
     RowBox[{"XXZ", " ", "MODEL"}], ")"}]}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"L", "=", "12"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetK", "=", "7"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"targetP", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nspins", "=", 
     RowBox[{"L", "+", "2"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "\[CapitalDelta]a", ",", "\[CapitalDelta]b", ",", "\[Lambda]a", ",", 
       "\[Lambda]b"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"1.", ",", "1.", ",", "1.", ",", "1."}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"baseJz", "=", "0.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"Jxy", ",", "w", ",", "ed", ",", "d"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1."}], ",", "0.", ",", "0", ",", "7"}], "}"}]}], ";"}], 
   " ", 
   RowBox[{"(*", 
    RowBox[{"ed", "=", 
     RowBox[{"1.5", " ", "for", " ", "Chaos"}]}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nRealizations", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"trimFraction", "=", "0.05"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{"BuildSectorProjector", "[", 
      RowBox[{"L", ",", "targetK", ",", "targetP"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"HTemplate", "[", "Jz_", "]"}], ":=", 
     RowBox[{"Chop", "[", 
      RowBox[{"BuildFullHamiltonian", "[", 
       RowBox[{"HAlocal", ",", 
        RowBox[{"XXZwLocalDefectHamiltonian", "[", 
         RowBox[{"Jxy", ",", "Jz", ",", "w", ",", "ed", ",", "L", ",", "d"}], 
         "]"}], ",", "HBlocal", ",", "couplingA", ",", "couplingB", ",", 
        "L"}], "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unfoldedEnsemble", "=", 
     RowBox[{"{", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Generating ensemble of \>\"", ",", "nRealizations", 
      ",", "\"\< spectra...\>\""}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "currentJz", ",", "HT", ",", "HSector", ",", "sectorEnergies", ",", 
          "data", ",", "unfoldedLevels", ",", "nTrim", ",", "trimmedLevels"}],
          "}"}], ",", 
        RowBox[{
         RowBox[{"currentJz", "=", 
          RowBox[{"baseJz", "*", 
           RowBox[{"(", 
            RowBox[{"1.", "+", 
             RowBox[{"RandomReal", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"-", "0.005"}], ",", "0.005"}], "}"}], "]"}]}], 
            ")"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"HT", "=", 
          RowBox[{"HTemplate", "[", "currentJz", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"HSector", "=", 
          RowBox[{"Normal", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "V", "]"}], ".", "HT", ".", "V"}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sectorEnergies", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Eigenvalues", "[", "HSector", "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"data", "=", 
          RowBox[{"Unfold", "[", "sectorEnergies", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"unfoldedLevels", "=", 
          RowBox[{"data", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"nTrim", "=", 
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"Length", "[", "unfoldedLevels", "]"}], "*", 
            "trimFraction"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "unfoldedLevels", "]"}], "-", 
             RowBox[{"2", "*", "nTrim"}]}], ">", "10"}], ",", 
           RowBox[{
            RowBox[{"trimmedLevels", "=", 
             RowBox[{"unfoldedLevels", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"1", "+", "nTrim"}], ";;", 
                RowBox[{
                 RowBox[{"-", "1"}], "-", "nTrim"}]}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"unfoldedEnsemble", ",", "trimmedLevels"}], "]"}], 
            ";"}]}], "]"}], ";"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"n", ",", "1", ",", "nRealizations"}], "}"}]}], "]"}], 
