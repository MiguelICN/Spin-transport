Cell[CellGroupData[{

Cell["2 - Von Neumann entropy", "Section",ExpressionUUID->"b380dd7c-06bf-b249-8832-bee3ec4236f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"VNEntropy2x2", ",", " ", "VNEntropy4x4"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"VNEntropy2x2", " ", "=", " ", 
   RowBox[{"Compile", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", " ", "_Complex", ",", " ", "2"}], "}"}], "}"}], 
     ",", "\n", "  ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r11", ",", " ", "r22", ",", " ", "r12r", ",", " ", "r12i", ",", " ", 
         "absq", ",", " ", "disc", ",", " ", "\[Lambda]1", ",", " ", 
         "\[Lambda]2"}], "}"}], ",", "\n", "    ", 
       RowBox[{
        RowBox[{"r11", "  ", "=", " ", 
         RowBox[{"Re", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"r22", " ", "=", " ", 
         RowBox[{"Re", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"r12r", " ", "=", " ", 
         RowBox[{"Re", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ";", " ", 
        RowBox[{"r12i", " ", "=", " ", 
         RowBox[{"Im", "[", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"absq", " ", "=", " ", 
         RowBox[{
          RowBox[{"r12r", "^", "2"}], " ", "+", " ", 
          RowBox[{"r12i", "^", "2"}]}]}], ";", "\n", "    ", 
        RowBox[{"disc", " ", "=", " ", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"r11", " ", "-", " ", "r22"}], ")"}], "^", "2"}], " ", "+",
            " ", 
           RowBox[{"4.", "*", "absq"}]}], "]"}]}], ";", "\n", "    ", 
        RowBox[{"\[Lambda]1", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r11", " ", "+", " ", "r22", " ", "+", " ", "disc"}], 
           ")"}], "/", "2."}]}], ";", " ", 
        RowBox[{"\[Lambda]2", " ", "=", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"r11", " ", "+", " ", "r22", " ", "-", " ", "disc"}], 
           ")"}], "/", "2."}]}], ";", "\n", "    ", 
