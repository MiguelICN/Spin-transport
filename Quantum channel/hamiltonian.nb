Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"2.", " ", "SFF", " ", "IN", " ", "HEISENBERG", " ", "UNITS"}], 
     "&"}], " ", "SMOOTHING"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"SmoothSFF", ",", "EnsembleKFromEnergies"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SmoothSFF", "[", 
      RowBox[{"kVec_List", ",", "tauVec_List", ",", 
       RowBox[{"sigmaTau_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"GaussianFilter", "[", 
      RowBox[{"kVec", ",", 
       RowBox[{"sigmaTau", "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"tauVec", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "-", 
          RowBox[{"tauVec", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], ")"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"EnsembleKFromEnergies", "[", 
      RowBox[{"ensEnergies_List", ",", 
       RowBox[{"tauMax_", "?", "NumericQ"}], ",", "nPts_Integer"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tauList", ",", "allK"}], "}"}], ",", 
       RowBox[{
        RowBox[{"tauList", "=", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"1", ",", "nPts"}], "]"}], " ", 
           RowBox[{"(", 
            RowBox[{"tauMax", "/", "nPts"}], ")"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"allK", "=", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"en", "=", "ensEnergies"}], ",", 
             RowBox[{"tL", "=", "tauList"}]}], "}"}], ",", 
           RowBox[{"ParallelTable", "[", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"energies", "=", 
                  RowBox[{"en", "[", 
                   RowBox[{"[", "i", "]"}], "]"}]}], ",", "tauFactors"}], 
                "}"}], ",", 
               RowBox[{"(*", 
                RowBox[{
                 RowBox[{"For", " ", "unfolded", " ", "energies"}], ",", 
                 RowBox[{
                 "phase", " ", "is", " ", "exactly", " ", "2", " ", "\[Pi]", " ",
                   "\[Tau]", " ", "E"}]}], "*)"}], 
               RowBox[{
                RowBox[{"tauFactors", "=", 
                 RowBox[{"tL", "*", "2", "*", "Pi"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{
                    RowBox[{"-", "I"}], "*", 
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", "tauFactors", ",", "energies"}], 
                    "]"}]}], "]"}], ".", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Length", "[", "energies", "]"}]}], "]"}]}], 
                   "]"}], "^", "2"}], "/", 
                 RowBox[{"Length", "[", "energies", "]"}]}]}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", 
               RowBox[{"Length", "[", "ensEnergies", "]"}]}], "}"}], ",", 
             RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Tau\>\"", "->", "tauList"}], ",", 
          RowBox[{"\"\<AllK\>\"", "->", "allK"}], ",", 
          RowBox[{"\"\<MeanK\>\"", "->", 
           RowBox[{"Mean", "[", "allK", "]"}]}]}], "|>"}]}]}], "]"}]}], ";"}],
    "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Parameters", " ", "for", " ", "computation"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tauMaxSFF", "=", "3.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"nPtsSFF", "=", "10000"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{
    "Reduced", " ", "slightly", " ", "from", " ", "10", "k", " ", "so", " ", 
     "it", " ", "computes", " ", "in", " ", "seconds"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"sigmaSmSFF", "=", "0.05"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Adjusted", " ", "smoothing", " ", "width"}], "*)"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Computing SFF over \[Tau]...\>\"", "]"}], 
    ";"}], "\n", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"sffData", "=", 
      RowBox[{"EnsembleKFromEnergies", "[", 
       RowBox[{"unfoldedEnsemble", ",", "tauMaxSFF", ",", "nPtsSFF"}], 
       "]"}]}], ";"}], "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"tauGrid", "=", 
     RowBox[{"sffData", "[", "\"\<Tau\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kAllSm", "=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"SmoothSFF", "[", 
         RowBox[{"#", ",", "tauGrid", ",", "sigmaSmSFF"}], "]"}], "&"}], ",", 
       RowBox[{"sffData", "[", "\"\<AllK\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"kMeanSm", "=", 
     RowBox[{"Mean", "[", "kAllSm", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"GOE", " ", "analytical", " ", "SFF", " ", 
     RowBox[{"(", 
      RowBox[{
      "Mathematically", " ", "identical", " ", "to", " ", "your", " ", "COE", 
       " ", "form"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"kGOEAn", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"t", "<=", "1."}], ",", 
         RowBox[{
          RowBox[{"2", " ", "t"}], "-", 
          RowBox[{"t", " ", 
           RowBox[{"Log", "[", 
            RowBox[{"1", "+", 
             RowBox[{"2", " ", "t"}]}], "]"}]}]}], ",", 
         RowBox[{"2", "-", 
          RowBox[{"t", " ", 
           RowBox[{"Log", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "t"}], "+", "1"}], ")"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"2", " ", "t"}], "-", "1"}], ")"}]}], "]"}]}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "tauGrid"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9925195327494583`*^9, 3.9925195327494583`*^9}, {
  3.992519752136038*^9, 3.9925197526521206`*^9}, {3.992520901705015*^9, 
  3.9925209046075573`*^9}, {3.9925209642618484`*^9, 3.9925209650598717`*^9}, {
  3.9925210547195873`*^9, 3.992521069938095*^9}},
