Cell[CellGroupData[{

Cell["\<\
Method 2 -- Transfer-Tensor Choi Construction (proposed optimization)\
\>", "Chapter",ExpressionUUID->"28fa1660-219b-e640-9af5-f9d4b2dc3cc2"],

Cell["\<\
Uses the Choi-Jamiolkowski operator-basis identity
  J(eps) = Sum_ij |i><j| (x) eps(|i><j|)
instead of the teleportation (doubled-space) construction. eps(|i><j|)
is computed with the SAME transfer-tensor / K-matrix machinery already
validated for the reduced edge-spin propagation, fed with the input
operator |i><j| (x) rhoChain instead of rhoAB (x) rhoChain. Works 
directly in the native [Q1,Chain,Q2] layout -- no PermuteEvecsToSE, 
no SpectralUnitary, no doubled-space Kronecker products, no generic 
MatrixPartialTrace call. Hermiticity (eps(|i><j|) = eps(|j><i|)^dagger)
is used to compute only the 10 of 16 (i,j) blocks with i<=j; the 
remaining 6 are filled by conjugate transpose -- exact, not approximate.\
\>", "Text",ExpressionUUID->"eb1d7fbe-de8c-254a-ba3b-70c7d0d5a7f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Transfer", " ", "tensor", " ", "builder"}], ",", " ", 
    RowBox[{
     RowBox[{"[", 
      RowBox[{"Q1", ",", "Chain", ",", "Q2"}], "]"}], " ", 
     RowBox[{"eigenvectors", "."}]}]}], "              ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"T", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"q1", "+", "1"}], ",", 
        RowBox[{"q2", "+", "1"}], ",", 
        RowBox[{"q1p", "+", "1"}], ",", 
        RowBox[{"q2p", "+", "1"}]}], "]"}], "]"}], " ", "is", " ", "a", " ", 
     "D_total", " ", "x", " ", "D_total", " ", "matrix"}], ",", " ", 
    RowBox[{"OUTPUT", "-"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"basis", " ", 
    RowBox[{"indexed", ".", " ", "Depends"}], " ", "only", " ", "on", " ", 
    RowBox[{"Evec", " ", "--"}], " ", "shared", " ", "by", " ", "every", " ", 
    RowBox[{"(", 
     RowBox[{"i", ",", "j"}], ")"}], " ", "input"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"pair", " ", "below"}], ",", " ", 
    RowBox[{"built", " ", 
     RowBox[{"once", "."}]}]}], "                                           ",
    "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "BuildTransferTensors", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BuildTransferTensors", "[", 
      RowBox[{"U_", ",", " ", "L_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"dC", ",", " ", "idxFull", ",", " ", "getCols"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"dC", "       ", "=", " ", 
         RowBox[{"2", "^", "L"}]}], ";", "\n", "  ", 
        RowBox[{"idxFull", "  ", "=", " ", 
         RowBox[{"Compile", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"q1", ",", "_Integer"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"c", ",", "_Integer"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"q2", ",", "_Integer"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"dC", ",", "_Integer"}], "}"}]}], "}"}], ",", "\n", 
           "               ", 
           RowBox[{
            RowBox[{"q1", "*", 
             RowBox[{"(", 
              RowBox[{"2", "*", "dC"}], ")"}]}], " ", "+", " ", 
            RowBox[{"c", "*", "2"}], " ", "+", " ", "q2", " ", "+", " ", 
            "1"}], ",", "\n", "               ", 
           RowBox[{"CompilationTarget", " ", "->", " ", "$CompileTarget"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"getCols", "[", 
          RowBox[{"q1_", ",", " ", "q2_"}], "]"}], " ", ":=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"idxFull", "[", 
            RowBox[{"q1", ",", " ", "c", ",", " ", "q2", ",", " ", "dC"}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"c", ",", " ", "0", ",", " ", 
             RowBox[{"dC", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"ParallelTable", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"Conjugate", "[", 
            RowBox[{"U", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{"getCols", "[", 
                RowBox[{"q1", ",", " ", "q2"}], "]"}]}], "]"}], "]"}], "]"}], 
           " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"U", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", 
               RowBox[{"getCols", "[", 
                RowBox[{"q1p", ",", " ", "q2p"}], "]"}]}], "]"}], "]"}], 
            "]"}]}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"q1", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q2", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q1p", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"q2p", ",", " ", "0", ",", " ", "1"}], "}"}]}], "\n", "  ",
          "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"fd21d10d-ef61-5749-941d-0c356b44b8ce"],

