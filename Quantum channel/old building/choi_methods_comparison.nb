Cell[CellGroupData[{

Cell["Pointwise Cross-Check (before committing to the full sweep)", "Chapter",ExpressionUUID->"42c161f2-e436-f146-8f1b-aae55cc820fe"],

Cell["\<\
t=0 alone is a weak test (both methods trivially return |Phi+><Phi+| 
there by construction). The checks below test the actual time-
dependent propagation at several nontrivial t values before running 
the full tlist sweep -- same discipline as choi_test_flat.m.\
\>", "Text",ExpressionUUID->"ef79b207-5584-ce45-bff9-16467a0f51ca"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"pointwiseCheckTs", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"1.3", ",", " ", "4.7", ",", " ", "9.9"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"cOld", " ", "=", " ", 
         RowBox[{"choiFnOld", "[", "tCheck", "]"}]}], ",", " ", 
        RowBox[{"cNew", " ", "=", " ", 
         RowBox[{"choiFnNew", "[", "tCheck", "]"}]}], ",", " ", "maxDiff"}], 
       "}"}], ",", "\n", "    ", 
      RowBox[{
       RowBox[{"maxDiff", " ", "=", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{"cOld", " ", "-", " ", "cNew"}], "]"}], "]"}], "]"}]}], ";",
        "\n", "    ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<t = \>\"", ",", " ", "tCheck", ",", 
         " ", "\"\<   max|choiMat_Old - choiMat_New| = \>\"", ",", " ", 
         "maxDiff", ",", "\n", "          ", "\"\<   Tr[choiMat_Old] = \>\"", 
         ",", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Re", "@", 
           RowBox[{"Tr", "[", "cOld", "]"}]}]}], ",", "\n", 
         "          ", "\"\<   Tr[choiMat_New] = \>\"", ",", " ", 
         RowBox[{"N", "@", 
          RowBox[{"Re", "@", 
           RowBox[{"Tr", "[", "cNew", "]"}]}]}]}], "]"}], ";"}]}], "\n", "  ",
      "]"}], ",", "\n", "  ", 
    RowBox[{"{", 
     RowBox[{"tCheck", ",", " ", "pointwiseCheckTs"}], "}"}]}], "\n", "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[296]:=",ExpressionUUID->"cff90d9e-71da-f04e-8ee1-de053d704ed6"],

