Cell["Numerical Comparison", "Chapter",ExpressionUUID->"f07d0433-26dd-b44a-b0f4-ae9b04ff4e05"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Merge", " ", "per", " ", "time", " ", 
    RowBox[{
     RowBox[{"step", ".", " ", "Old"}], "/", "Fast"}], " ", "prefixes", " ", 
    "avoid", " ", "key", " ", 
    RowBox[{"collisions", "."}]}], "      ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"combinedResults", " ", "=", " ", 
     RowBox[{"MapThread", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"<|", 
           RowBox[{"\"\<Time\>\"", " ", "->", " ", 
            RowBox[{"#1", "[", "\"\<Time\>\"", "]"}]}], "|>"}], ",", "\n", 
          "       ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<Old\>\"", " ", "<>", " ", "#"}], ")"}], " ", "&"}],
             ",", " ", 
            RowBox[{"KeyDrop", "[", 
             RowBox[{"#1", ",", " ", "\"\<Time\>\""}], "]"}]}], "]"}], ",", 
          "\n", "       ", 
          RowBox[{"KeyMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"\"\<Fast\>\"", " ", "<>", " ", "#"}], ")"}], " ", 
             "&"}], ",", " ", 
            RowBox[{"KeyDrop", "[", 
             RowBox[{"#2", ",", " ", "\"\<Time\>\""}], "]"}]}], "]"}]}], 
         "]"}], " ", "&"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"choiResultsOld", ",", " ", "choiResultsNew"}], "}"}]}], "\n",
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<combinedResults[[1]]: \>\"", ",", " ", 
      RowBox[{"combinedResults", "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}]}]}]], "Input",
