Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dirL", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"baseDir", ",", " ", 
          RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", "\n",
       "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "dirL", "]"}]}], ",", " ", 
        RowBox[{"CreateDirectory", "[", "dirL", "]"}]}], "]"}], ";", "\n", 
      "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Build", " ", "and", " ", "diagonalise", " ", "ONCE", " ", "per", " ",
          "L"}], ",", " ", 
        RowBox[{"at", " ", "fixed", " ", "delta"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{"Ha", "           ", "=", " ", 
       RowBox[{"XXZwLocalDefectHamiltonian", "[", 
        RowBox[{
        "Jxy", ",", " ", "Jz", ",", " ", "w", ",", " ", "ed", ",", " ", "L", ",",
          " ", "L"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"HT", "           ", "=", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"BuildFullHamiltonian", "[", 
         RowBox[{
         "HAlocal", ",", " ", "Ha", ",", " ", "HBlocal", ",", "\n", 
          "                       ", "couplingA", ",", " ", "couplingB", ",", 
          " ", "L"}], "]"}], "]"}]}], ";", "\n", "  ", 
