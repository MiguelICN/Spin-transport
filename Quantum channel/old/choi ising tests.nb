  "In[128]:=",ExpressionUUID->"89f0d2cb-c401-4858-8e7e-38d83fcc0f48"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"assuming", " ", "`data`", " ", "is", " ", "the", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "..."}], "}"}], " ", 
    "list", " ", "shown"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ys", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zmin", ",", "zmax"}], "}"}], "=", 
     RowBox[{"MinMax", "[", 
      RowBox[{"data", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ldp", "=", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{"data", ",", 
       RowBox[{"(*", 
        RowBox[{"smooth", " ", "but", " ", "not", " ", "overdone"}], "*)"}], 
       RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{"uniform", " ", "scientific", " ", "palette"}], "*)"}], 
       RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"zmin", ",", "zmax"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", "16"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ")"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"ImageSize", "->", "600"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"BarLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<BlueGreenYellow\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"zmin", ",", "zmax"}], "}"}]}], "}"}], ",", 
          RowBox[{"LabelStyle", "->", "14"}], ",", 
          RowBox[{"LegendLabel", "->", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<z\>\"", ",", "14"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"Mesh", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "xs", "]"}], ",", 
          RowBox[{"Length", "[", "ys", "]"}]}], "}"}]}], ",", 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", 
          RowBox[{"Opacity", "[", ".2", "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "x"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "xs"}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y", ",", "y"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "ys"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", "ldp", "\n"}]}]], "Input",
 CellChangeTimes->{{3.971503873191551*^9, 3.971503910919756*^9}, {
  3.971504148949993*^9, 3.971504153717229*^9}, {3.971504189497452*^9, 
  3.9715042065210114`*^9}},
