Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"productstate2", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"RandomChainProductState", "[", "L", "]"}], ",", "50"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"productstate2", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{
          RowBox[{"haar", "[", "1", "]"}], ",", 
          RowBox[{"haar", "[", 
           RowBox[{"L", "-", "1"}], "]"}]}], "]"}], "]"}], ",", "50"}], 
      "]"}]}], ";"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"iprs", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Quiet", "[", 
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Conjugate", "[", "allvecs", "]"}], ".", "i"}], "]"}], "^", 
        "4"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "productstate2"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"energies", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Conjugate", "[", "i", "]"}], ".", "Ha", ".", "i"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "productstate2"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}]}], "Input",
