Cell[BoxData[{
 RowBox[{
  RowBox[{"visited", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"False", ",", 
     RowBox[{"2", "^", "L"}], ",", "SparseArray"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"oddMap", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"!", 
       RowBox[{"visited", "[", 
        RowBox[{"[", 
         RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"j", "=", 
        RowBox[{"revIndex", "[", 
         RowBox[{"i", ",", "L"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"i", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"visited", "[", 
         RowBox[{"[", 
          RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evenMap", ",", 
           RowBox[{"{", "i", "}"}]}], "]"}], ",", 
         RowBox[{
          RowBox[{"AppendTo", "[", 
           RowBox[{"evenMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"oddMap", ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}]}], "]"}], ";"}]}], 
        "\[IndentingNewLine]", "]"}], ";"}]}], "]"}], "\[IndentingNewLine]", 
    ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "L"}], ")"}], "-", "1"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[185]:=",ExpressionUUID->"8c019739-bf76-407b-9359-4d706ba85c51"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ha", "=", 
   RowBox[{"IsingHamiltonian", "[", 
    RowBox[{"1", ",", "g", ",", "J", ",", "L", ",", 
     RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"system", "=", 
   RowBox[{"BlockDiagonalize", "[", 
    RowBox[{"Ha", ",", " ", 
     RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"system", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Quiet", "[", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"system", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"neweven", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ExpandBlockVector", "[", 
      RowBox[{"i", ",", "evenMap", ",", "\"\<even\>\"", ",", "L"}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "eveneigenvec"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newodd", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ExpandBlockVector", "[", 
      RowBox[{"i", ",", "oddMap", ",", "\"\<odd\>\"", ",", "L"}], "]"}], ",", 
     
     RowBox[{"{", 
      RowBox[{"i", ",", "oddeigenvec"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvecs", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"neweven", ",", "newodd"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvals", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newall", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", "First"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvecs", "=", 
   RowBox[{"newall", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvals", "=", 
   RowBox[{"newall", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}]}], "Input",
