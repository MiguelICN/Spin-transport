Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"unitary", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{"Transpose", "[", "allvecs", "]"}], ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "allvals", "*", "t"}], "]"}], "]"}], ".", 
