Cell[CellGroupData[{

Cell["Slow code via krauss code", "Chapter",
 CellChangeTimes->{{3.971504246967141*^9, 3.9715042506589327`*^9}, {
  3.9715071266475153`*^9, 
  3.971507129930212*^9}},ExpressionUUID->"c2080fb4-5aac-4584-af5f-\
77117b46126e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Dimensions", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dA", "=", 
     RowBox[{"2", "^", "La"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"system", " ", "size"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dB", "=", 
     RowBox[{"2", "^", "Lb"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"environment", " ", "size"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Maximally", " ", "entangled", " ", "projector", " ", "on", " ", 
     RowBox[{
      RowBox[{"A", "'"}], "\[CircleTimes]", "A"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"vecPhi", "=", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"IdentityMatrix", "[", "dA", "]"}], "]"}], "/", 
      RowBox[{"Sqrt", "[", "dA", "]"}]}]}], ";"}], "       ", 
   RowBox[{"(*", " ", 
    RowBox[{"|", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "+"}], ">", 
      RowBox[{"as", " ", "a", " ", "vector"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Phi", "=", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "vecPhi", ",", 
       RowBox[{"Conjugate", "[", "vecPhi", "]"}]}], "]"}]}], ";"}], "    ", 
   RowBox[{"(*", " ", 
    RowBox[{"|", 
     RowBox[{
      RowBox[{"\[CapitalPhi]", "+"}], ">", "<", 
      RowBox[{"\[CapitalPhi]", "+"}]}], "|"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Big", " ", 
     RowBox[{"unitary", ":", 
      RowBox[{"I_", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", "'"}], "}"}], "\[CircleTimes]", "U_"}], 
       RowBox[{"{", "AE", "}"}], 
       RowBox[{"(", "t", ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "Ubig", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Ubig", "[", "t_", "]"}], ":=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "dA", "]"}], ",", 
       RowBox[{"U", "[", "t", "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Partial", " ", "trace", " ", "over", " ", "the", " ", "environment", 
      " ", "E", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
        "the", " ", "last", " ", "factor", " ", "of", " ", "AE", " ", "after",
          " ", "evolution"}], ")"}], ".", "We"}], " ", "reshape", " ", "to", 
      " ", 
      RowBox[{"A", "'"}], " ", 
      RowBox[{"(", "dA", ")"}]}], ",", 
     RowBox[{"A_out", " ", 
      RowBox[{"(", "dA", ")"}]}], ",", 
     RowBox[{"E_out", " ", 
      RowBox[{"(", "dB", ")"}], " ", "on", " ", 
      RowBox[{"bra", "/", "ket"}], " ", "and", " ", "contract", " ", 
      RowBox[{"E", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"Clear", "[", "PartialTraceEnv", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PartialTraceEnv", "[", 
      RowBox[{"X_", "?", "MatrixQ"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"T", ",", "Y"}], "}"}], ",", 
       RowBox[{
        RowBox[{"T", "=", 
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"X", ",", 
           RowBox[{"{", 
            RowBox[{
            "dA", ",", "dA", ",", "dB", ",", "dA", ",", "dA", ",", "dB"}], 
            "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Y", "=", 
         RowBox[{"TensorContract", "[", 
          RowBox[{"T", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"3", ",", "6"}], "}"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"trace", " ", "over", " ", "E", " ", "indices"}], "*)"}], 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"Y", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dA", "*", "dA"}], ",", 
            RowBox[{"dA", "*", "dA"}]}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Choi", " ", "state", " ", "of", " ", "the", " ", "reduced", " ", 
     "channel", " ", "at", " ", "time", " ", "t", " ", 
     RowBox[{"(", 
      RowBox[{"trace", "=", 
       RowBox[{"1", " ", "by", " ", "construction"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "ChoiState", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ChoiState", "[", "t_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "X", "}"}], ",", 
       RowBox[{
        RowBox[{"X", "=", 
         RowBox[{
          RowBox[{"Ubig", "[", "t", "]"}], ".", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"Phi", ",", 
            RowBox[{"Transpose", "[", "rho", "]"}]}], "]"}], ".", 
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"Ubig", "[", "t", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Chop", "@", 
         RowBox[{"PartialTraceEnv", "[", "X", "]"}]}]}]}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Purity", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"no", " ", "extra", " ", "normalization", " ", "needed"}], ";", 
       RowBox[{
        RowBox[{"Tr", "[", "J", "]"}], "==", "1"}]}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Clear", "[", "ChoiPurityAt", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ChoiPurityAt", "[", "t_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"J", "=", 
         RowBox[{"ChoiState", "[", "t", "]"}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"J", ".", "J"}], "]"}], "//", "Chop"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.971506623644224*^9, 3.971506643539997*^9}},
 CellLabel->
  "In[439]:=",ExpressionUUID->"a4828e9e-604f-4c43-965e-01a5dfc2967c"],

