Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"plot", "=", 
    RowBox[{"ListLogLogPlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
      RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"\"\<L = \>\"", "<>", 
          RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
          
          RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
          
          RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
          
          RowBox[{"ToString", "[", "g", "]"}], "<>", 
          "\"\<, RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",", 
         "30", ",", "Black"}], "]"}]}], ",", 
      RowBox[{"Joined", "->", "True"}], ",", 
      RowBox[{"Axes", "->", "True"}], ",", 
      RowBox[{"GridLines", "->", "None"}], ",", 
      RowBox[{"FrameStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", 
         RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
         RowBox[{"Style", "[", "\"\<Choi's Purity\>\"", "]"}]}], "}"}]}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"finalb", "=", 
    RowBox[{"Show", "[", 
     RowBox[{"{", 
      RowBox[{"plot", ",", 
       RowBox[{"LogLogPlot", "[", 
        RowBox[{
         RowBox[{"1", "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"2", "^", "La"}], ")"}], "^", "2"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"10", "^", 
            RowBox[{"-", "1"}]}], ",", 
           RowBox[{"tlist", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], "]"}]}],
    ";", "\n", 
   RowBox[{
    RowBox[{"Show", "[", 
     RowBox[{"{", 
      RowBox[{"final", ",", "finalb"}], "}"}], "]"}], "\[IndentingNewLine]", 
    RowBox[{"decoherence", "[", 
