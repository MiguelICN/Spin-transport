         RowBox[{"ToString", "[", "g", "]"}], "<>", 
         "\"\<, \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\) = RPS\>\""}], ",", 
        "30", ",", "Black"}], "]"}]}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"GridLines", "->", "None"}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", 
        RowBox[{"FontSize", "->", "30"}]}], "]"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Style", "[", "\"\<t\>\"", "]"}], ",", 
        RowBox[{"Style", "[", "\"\<Svn(t)\>\"", "]"}]}], "}"}]}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "1000"}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"colorMapping", "[", 
        RowBox[{"sorted", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}]}]}], "]"}]}]}]], "Input",\

