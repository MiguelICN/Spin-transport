Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"assumes", " ", "psi"}], ",", "la", ",", 
    RowBox[{"lb", " ", "are", " ", "already", " ", "defined"}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"2", "^", "La"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"2", "^", "Lb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho", "=", 
     RowBox[{
      RowBox[{"MatrixPartialTrace", "[", 
       RowBox[{
        RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}]}], "]"}], "//", "Chop"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"id", "=", 
     RowBox[{
      RowBox[{"IdentityMatrix", "[", "n", "]"}], "/", "m"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"a", "=", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"id", ",", "rho"}], "]"}]}], ";"}]}]}]], "Input",
