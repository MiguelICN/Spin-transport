Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Reusable", " ", "channel", " ", "utilities"}], "*)"}], 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Developer`\>\"", "]"}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"0", ")"}], " ", "Helpers"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "PackC", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PackC", "[", "x_", "]"}], ":=", 
     RowBox[{"Developer`ToPackedArray", "[", "x", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"1", ")"}], " ", "Environment", " ", "state", " ", "from", " ", 
      "a", " ", "global", " ", "pure", " ", "state"}], "|", 
     RowBox[{"\[Psi]\:27e9", " ", "on", " ", 
      RowBox[{"S", "\[CircleTimes]", "E"}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "EnvStateFromPsi", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"EnvStateFromPsi", "[", 
      RowBox[{"psi_", ",", 
       RowBox[{"m_Integer", "?", "Positive"}], ",", 
       RowBox[{"n_Integer", "?", "Positive"}]}], "]"}], ":=", 
     RowBox[{"PackC", "@", 
      RowBox[{"Chop", "@", 
       RowBox[{"MatrixPartialTrace", "[", 
        RowBox[{
         RowBox[{"Dyad", "[", "psi", "]"}], ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"2", ")"}], " ", "Fast", " ", "spectral", " ", "unitary", " ", 
       
       RowBox[{"builder", ":", 
        RowBox[{"U", 
         RowBox[{"(", "t", ")"}]}]}]}], "=", 
      RowBox[{
       RowBox[{"V", ".", "diag"}], 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"e", "^", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", "i"}], " ", "\[Lambda]", " ", "t"}], "}"}]}], ")"}], 
        ".", 
        RowBox[{"V", "^", "\[Dagger]"}]}]}]}], ",", 
     RowBox[{"implemented", " ", "via", " ", "column", " ", "scaling", " ", 
      RowBox[{"(", 
       RowBox[{"no", " ", "DiagonalMatrix", " ", "allocation"}], ")"}]}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "SpectralUnitary", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"SpectralUnitary", "[", 
      RowBox[{"allvecs_", ",", "allvals_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "=", 
          RowBox[{"PackC", "@", 
           RowBox[{"Transpose", "[", "allvecs", "]"}]}]}], ",", 
         RowBox[{"Pinv", "=", 
          RowBox[{"PackC", "@", 
           RowBox[{"Conjugate", "[", "allvecs", "]"}]}]}]}], "}"}], ",", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "t", "}"}], ",", 
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"ph", "=", 
             RowBox[{"PackC", "@", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "I"}], " ", "allvals", " ", "t"}], "]"}]}]}], 
            "}"}], ",", 
           RowBox[{"PackC", "@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", "P", "]"}], "*", "ph"}], "]"}], ".",
               "Pinv"}], ")"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"3", ")"}], " ", "Maximally", " ", "entangled", " ", "projector",
      " ", "on", " ", 
     RowBox[{"R", "\[CircleTimes]", "S"}], " ", 
     RowBox[{"(", 
      RowBox[{"dimension", " ", "m"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "PhiProjector", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"PhiProjector", "[", 
      RowBox[{"m_Integer", "?", "Positive"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"phi", "=", 
         RowBox[{"PackC", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"IdentityMatrix", "[", "m", "]"}], "]"}], "/", 
            RowBox[{"Sqrt", "[", "m", "]"}]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"PackC", "@", 
        RowBox[{"Dyad", "[", "phi", "]"}]}]}], "               ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"m", "^", "2"}], "\[Times]", 
        RowBox[{"m", "^", "2"}]}], "*)"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"4", ")"}], " ", "Choi", " ", "of", " ", "reduced", " ", 
      "system", " ", "channel", " ", "via", " ", "ancilla", " ", 
      RowBox[{"definition", ".", 
       RowBox[{"Inputs", ":", 
        RowBox[{"-", "m"}]}]}]}], ",", 
     RowBox[{
      RowBox[{"n", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"system", "/", "env"}], " ", "dims"}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"unitaryF", "[", "t_", "]"}], " ", 
       RowBox[{"(", 
        RowBox[{"Function", " ", "returning", " ", "U", 
         RowBox[{"(", "t", ")"}], " ", "on", " ", 
         RowBox[{"S", "\[CircleTimes]", "E"}]}], ")"}]}], "-", 
      RowBox[{"rhoE", " ", 
       RowBox[{"(", 
        RowBox[{"n", "\[Times]", "n"}], ")"}], " ", "OR", " ", "psi", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"mn", "-", "vector"}], ")"}], "[", 
        RowBox[{"set", " ", "exactly", " ", "one"}], "]"}], " ", "Returns", 
       " ", "a", " ", 
       RowBox[{"Function", "[", 
        RowBox[{
         RowBox[{"{", "t", "}"}], ",", 
         RowBox[{"J", 
          RowBox[{"(", "t", ")"}]}]}], "]"}], " ", "with", " ", "J", 
       RowBox[{"(", "t", ")"}], " ", "size", " ", 
       RowBox[{"m", "^", "2"}], "\[Times]", 
       RowBox[{"m", "^", "2."}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ChoiSysBuilder", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "ChoiSysBuilder", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\"\<rhoE\>\"", "->", "None"}], ",", 
       RowBox[{"\"\<psi\>\"", "->", "None"}]}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ChoiSysBuilder", "[", 
      RowBox[{
       RowBox[{"m_Integer", "?", "Positive"}], ",", 
       RowBox[{"n_Integer", "?", "Positive"}], ",", "unitaryF_Function", ",", 
       
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"rhoE", "=", 
          RowBox[{"OptionValue", "[", "\"\<rhoE\>\"", "]"}]}], ",", 
         RowBox[{"psi", "=", 
          RowBox[{"OptionValue", "[", "\"\<psi\>\"", "]"}]}], ",", "projPhi", 
         ",", "idm"}], "}"}], ",", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rhoE", "===", "None"}], "&&", 
           RowBox[{"psi", "===", "None"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"ChoiSysBuilder", "::", "envspec"}], "]"}], ";", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"rhoE", "=!=", "None"}], "&&", 
           RowBox[{"psi", "=!=", "None"}]}], ",", 
          RowBox[{
           RowBox[{"Message", "[", 
            RowBox[{"ChoiSysBuilder", "::", "envboth"}], "]"}], ";", 
           RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rhoE", "=", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"rhoE", "===", "None"}], ",", 
            RowBox[{"EnvStateFromPsi", "[", 
             RowBox[{"psi", ",", "m", ",", "n"}], "]"}], ",", "rhoE"}], "]"}],
           "//", "PackC"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"projPhi", "=", 
         RowBox[{"PhiProjector", "[", "m", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"idm", "=", 
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{"m", ",", "SparseArray"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"sparse", " ", "identity"}], "*)"}], 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", "t", "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"U", "=", 
               RowBox[{"unitaryF", "[", "t", "]"}]}], ",", "UR", ",", "Omega",
               ",", "X"}], "}"}], ",", 
            RowBox[{
             RowBox[{"UR", "=", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"idm", ",", "U"}], "]"}]}], ";", 
             RowBox[{"(*", 
              RowBox[{"acts", " ", "on", " ", 
               RowBox[{"R", "\[CircleTimes]", "S", "\[CircleTimes]", "E"}]}], 
              "*)"}], 
             RowBox[{"Omega", "=", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"projPhi", ",", "rhoE"}], "]"}]}], ";", 
             RowBox[{"(*", " ", 
              RowBox[{"|", "\[CapitalPhi]\:27e9\:27e8\[CapitalPhi]", "|", 
               RowBox[{"\[CircleTimes]", "\[Rho]E"}]}], "*)"}], 
             RowBox[{"X", "=", 
              RowBox[{"UR", ".", "Omega", ".", 
               RowBox[{"ConjugateTranspose", "[", "UR", "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"PackC", "@", 
              RowBox[{"Chop", "@", 
               RowBox[{"MatrixPartialTrace", "[", 
                RowBox[{"X", ",", "3", ",", 
                 RowBox[{"{", 
                  RowBox[{"m", ",", "m", ",", "n"}], "}"}]}], "]"}]}]}]}]}], 
           "  ", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{"trace", " ", "E"}], ",", 
             RowBox[{"keep", " ", 
              RowBox[{"R", "\[CircleTimes]", "S_out"}]}]}], "*)"}], "]"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ChoiSysBuilder", "::", "envspec"}], "=", 
     "\"\<Provide either \\\"rhoE\\\" -> (n\[Times]n matrix) or \\\"psi\\\" \
-> (mn-vector).\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ChoiSysBuilder", "::", "envboth"}], "=", 
     "\"\<Provide only one of \\\"rhoE\\\" or \\\"psi\\\", not both.\>\""}], 
    ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"5", ")"}], " ", "Process"}], "-", 
