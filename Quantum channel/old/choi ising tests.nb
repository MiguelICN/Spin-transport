Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ha", "=", 
      RowBox[{"IsingHamiltonian", "[", 
       RowBox[{"1", ",", 
        RowBox[{"i", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"i", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "L", ",", 
        RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"system", "=", 
      RowBox[{"BlockDiagonalize", "[", 
       RowBox[{"Ha", ",", " ", 
        RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"neweven", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "evenMap", ",", "\"\<even\>\"", ",", "L"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newodd", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "oddMap", ",", "\"\<odd\>\"", ",", "L"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"neweven", ",", "newodd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"unitary", "[", "t_", "]"}], ":=", 
      RowBox[{
       RowBox[{"Transpose", "[", "allvecs", "]"}], ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "allvals", "*", "t"}], "]"}], "]"}], ".", 
       RowBox[{"Conjugate", "[", "allvecs", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"reshuffledUnitary", "[", "t_", "]"}], ":=", 
      RowBox[{"reshuffle", "[", 
       RowBox[{
        RowBox[{"unitary", "[", "t", "]"}], ",", "m", ",", "n"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"choiMatrixFast", "[", "t_", "]"}], ":=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "ur", "}"}], ",", 
        RowBox[{
         RowBox[{"ur", "=", 
          RowBox[{"reshuffledUnitary", "[", "t", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Chop", "[", 
          RowBox[{"ur", ".", "a", ".", 
           RowBox[{"ConjugateTranspose", "[", "ur", "]"}]}], "]"}]}]}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Tr", "[", 
            RowBox[{"#", ".", "#"}], "]"}], "&"}], "@*", "choiMatrixFast"}], 
         "]"}], ",", "tlist"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"i", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"decoherence", "[", 
          RowBox[{"purity", ",", "tlist"}], "]"}]}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "parameters"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Export", "[", 
    RowBox[{"\"\<test_fullmesh_ising_choipurity.m\>\"", ",", "data"}], "]"}], 
   "*)"}]}]}], "Input",
