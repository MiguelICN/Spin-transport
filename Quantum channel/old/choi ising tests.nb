Cell[BoxData[{
 RowBox[{"ClearAll", "[", "reshuffle", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reshuffle", "[", 
    RowBox[{"a_", ",", "m_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "reshaped", "}"}], ",", 
     RowBox[{
      RowBox[{"reshaped", "=", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"a", ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "n", ",", "m", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"reshaped", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"m", "*", "n"}], ",", 
          RowBox[{"m", "*", "n"}]}], "}"}]}], "]"}]}]}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.971507716541543*^9, 3.971507717584981*^9}, 
   3.9715088114296827`*^9, 3.971508931370716*^9},
 CellLabel->
  "In[641]:=",ExpressionUUID->"8b723867-3165-4095-85f9-3cdd1219ebbb"],

