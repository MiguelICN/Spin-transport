Cell[BoxData[{
 RowBox[{
  RowBox[{"J0", "=", 
   RowBox[{"ChoiState", "[", "0", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Tr", "[", "J0", "]"}], ",", 
    RowBox[{"Tr", "[", 
     RowBox[{"J0", ".", "J0"}], "]"}]}], "}"}], "//", "Chop"}]}], "Input",
