   RowBox[{"(*", 
    RowBox[{"Build", " ", "U", 
     RowBox[{"(", "t", ")"}], " ", "from", " ", "your", " ", "spectrum"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"unitaryF", "=", 
     RowBox[{"SpectralUnitary", "[", 
      RowBox[{"allvecs", ",", "allvals"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Build", " ", 
     RowBox[{"Choi", "[", "J", "]"}], 
     RowBox[{"(", "t", ")"}], " ", "for", " ", "the", " ", "system", " ", 
     "channel"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"choiF", "=", 
     RowBox[{"ChoiSysBuilder", "[", 
      RowBox[{"m", ",", "n", ",", "unitaryF", ",", 
       RowBox[{"\"\<rhoE\>\"", "->", "rhoE"}]}], "]"}]}], ";"}]}]}]], "Input",\

