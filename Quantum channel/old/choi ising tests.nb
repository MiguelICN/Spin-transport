Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"choiMatrixFast", "[", "t_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "ur", "}"}], ",", 
     RowBox[{
      RowBox[{"ur", "=", 
       RowBox[{"reshuffledUnitary", "[", "t", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"ur", ".", "a", ".", 
        RowBox[{"ConjugateTranspose", "[", "ur", "]"}]}], "//", "Chop"}]}]}], 
    "]"}]}], ";"}]], "Input",
