UID->"f19e8613-04b5-4f39-a6ba-7780781247ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"system", "/", "env"}], " ", "sizes"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"m", "=", 
     RowBox[{"2", "^", "La"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"2", "^", "Lb"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"m", " ", "n"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Needs", "[", "\"\<Developer`\>\"", "]"}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"environment", " ", "state", " ", "\[Rho]_E", " ", 
     RowBox[{"(", 
      RowBox[{"n", "\[Times]", "n"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"rhoE", "=", 
     RowBox[{"Developer`ToPackedArray", "@", 
      RowBox[{"Chop", "@", 
       RowBox[{"MatrixPartialTrace", "[", 
        RowBox[{
         RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"spectral", " ", 
     RowBox[{"unitary", ":", 
      RowBox[{"scale", " ", "columns", " ", 
       RowBox[{"(", 
        RowBox[{
        "faster", " ", "than", " ", "DiagonalMatrix", " ", "every", " ", 
         "t"}], ")"}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"P", "=", 
     RowBox[{"Developer`ToPackedArray", "@", 
      RowBox[{"Transpose", "[", "allvecs", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Pinv", "=", 
     RowBox[{"Developer`ToPackedArray", "@", 
      RowBox[{"Conjugate", "[", "allvecs", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"unitary", "[", "t_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ph", "=", 
         RowBox[{"Developer`ToPackedArray", "@", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "allvals", " ", "t"}], "]"}]}]}], "}"}], 
       ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"Pph", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", "P", "]"}], "*", "ph"}], "]"}]}], 
          "}"}], ",", 
         RowBox[{"Developer`ToPackedArray", "@", 
          RowBox[{"(", 
           RowBox[{"Pph", ".", "Pinv"}], ")"}]}]}], "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"maximally", " ", "entangled"}], "|", 
     RowBox[{
     "\[CapitalPhi]_m\:27e9", " ", "on", " ", "reference", " ", "R", " ", 
      "and", " ", "input", " ", "S"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{"Developer`ToPackedArray", "@", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"IdentityMatrix", "[", "m", "]"}], "]"}], "/", 
        RowBox[{"Sqrt", "[", "m", "]"}]}], ")"}]}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"length", " ", 
     RowBox[{"m", "^", "2"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"projPhi", "=", 
     RowBox[{"Developer`ToPackedArray", "@", 
      RowBox[{"Dyad", "[", "phi", "]"}]}]}], ";"}], 
   "                          ", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"m", "^", "2"}], "\[Times]", 
     RowBox[{"m", "^", "2"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Choi", " ", "of", " ", "the", " ", "reduced", " ", "channel", " ", "on", 
     " ", "the", " ", "SYSTEM", " ", 
     RowBox[{"(", 
      RowBox[{"size", " ", 
       RowBox[{"m", "^", "2"}], "\[Times]", 
       RowBox[{"m", "^", "2"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"choiSys", "[", "t_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"U", "=", 
          RowBox[{"unitary", "[", "t", "]"}]}], ",", "UR", ",", "Omega", ",", 
         "X"}], "}"}], ",", 
       RowBox[{
        RowBox[{"UR", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"m", ",", "SparseArray"}], "]"}], ",", "U"}], "]"}]}], 
        ";", 
        RowBox[{"(*", 
         RowBox[{"acts", " ", "on", " ", 
          RowBox[{"R", "\[CircleTimes]", "S", "\[CircleTimes]", "E"}]}], 
         "*)"}], 
        RowBox[{"Omega", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"projPhi", ",", "rhoE"}], "]"}]}], ";", 
        RowBox[{"(*", " ", 
         RowBox[{"|", "\[CapitalPhi]\:27e9\:27e8\[CapitalPhi]", "|", 
          RowBox[{"\[CircleTimes]", "\[Rho]_E"}]}], "*)"}], 
        RowBox[{"X", "=", 
         RowBox[{"UR", ".", "Omega", ".", 
          RowBox[{"ConjugateTranspose", "[", "UR", "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Developer`ToPackedArray", "@", 
         RowBox[{"Chop", "@", 
          RowBox[{"MatrixPartialTrace", "[", 
           RowBox[{"X", ",", "3", ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "m", ",", "n"}], "}"}]}], "]"}]}]}]}]}], "  ", 
      
      RowBox[{"(*", 
       RowBox[{"trace", " ", "E"}], "*)"}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{3.971559246084836*^9},
 CellLabel->
  "In[135]:=",ExpressionUUID->"5971a359-a418-461c-a088-e62171ca2680"],

