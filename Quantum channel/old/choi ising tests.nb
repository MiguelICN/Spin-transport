            RowBox[{"Max", "[", "tlist", "]"}]}], "}"}], ",", 
          RowBox[{"PlotStyle", "->", 
           RowBox[{"{", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "Dashed"}], "]"}], "}"}]}]}], "]"}]}], 
       "}"}], "]"}], ",", 
     RowBox[{"BarLegend", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<FruitPunchColors\>\"", ",", 
         RowBox[{"{", 
          RowBox[{"Emin", ",", "Emax"}], "}"}]}], "}"}], ",", 
       RowBox[{"LabelStyle", "->", 
        RowBox[{"{", 
         RowBox[{"FontSize", "->", "12"}], "}"}]}]}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{
     RowBox[{"fakesvn", "[", 
      RowBox[{"[", "i", "]"}], "]"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<L = \>\"", "<>", 
         RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
         RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
