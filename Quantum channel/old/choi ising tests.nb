      RowBox[{"function", ":", 
       RowBox[{"Tr", "[", 
        RowBox[{"J", 
         RowBox[{
          RowBox[{"(", "t", ")"}], "^", "2"}]}], "]"}]}]}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "ProcessPurity", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "ProcessPurity", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{"\"\<Parallel\>\"", "->", "True"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ProcessPurity", "[", 
      RowBox[{"choiF_Function", ",", "tlist_List", ",", 
       RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"par", "=", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"OptionValue", "[", "\"\<Parallel\>\"", "]"}], "]"}]}], 
        "}"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{"par", ",", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Chop", "@", 
               RowBox[{"Re", "@", 
                RowBox[{"Tr", "[", 
                 RowBox[{"#", ".", "#"}], "]"}]}]}], ")"}], "&"}], "@*", 
            "choiF"}], ",", "tlist", ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",", 
         
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Chop", "@", 
               RowBox[{"Re", "@", 
                RowBox[{"Tr", "[", 
