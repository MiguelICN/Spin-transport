Cell[BoxData[
 RowBox[{
  RowBox[{"newdata", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
       RowBox[{"1", "-", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "3"}], "]"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.971549219027884*^9, 3.971549247152905*^9}},
 CellLabel->"In[96]:=",ExpressionUUID->"6e811894-481f-47af-b204-daba842d6682"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"assuming", " ", "`data`", " ", "is", " ", "the", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "..."}], "}"}], " ", 
    "list", " ", "shown"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"newdata", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"ys", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"newdata", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zmin", ",", "zmax"}], "}"}], "=", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Chop", "[", "newdata", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ldp", "=", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{
       RowBox[{"Chop", "[", "newdata", "]"}], ",", 
       RowBox[{"(*", 
        RowBox[{"smooth", " ", "but", " ", "not", " ", "overdone"}], "*)"}], 
       RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
       RowBox[{"(*", 
        RowBox[{"uniform", " ", "scientific", " ", "palette"}], "*)"}], 
       RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"zmin", ",", "zmax"}], "}"}]}], ",", 
       RowBox[{"Frame", "->", "True"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"#", ",", "25"}], "]"}], "&"}], "/@", 
          RowBox[{"{", 
           RowBox[{"\"\<hx\>\"", ",", "\"\<hz\>\""}], "}"}]}], ")"}]}], ",", 
       RowBox[{"FrameStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
       RowBox[{"AspectRatio", "->", "1"}], ",", 
       RowBox[{"ImageSize", "->", "600"}], ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"BarLegend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<BlueGreenYellow\>\"", ",", 
            RowBox[{"{", 
             RowBox[{"zmin", ",", "zmax"}], "}"}]}], "}"}], ",", 
          RowBox[{"LabelStyle", "->", "14"}], ",", 
          RowBox[{"LegendLabel", "->", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<1-U(t)\>\"", ",", "20"}], "]"}]}]}], "]"}]}], ",", 
       RowBox[{"Mesh", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "xs", "]"}], ",", 
          RowBox[{"Length", "[", "ys", "]"}]}], "}"}]}], ",", 
       RowBox[{"MeshStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{"White", ",", 
          RowBox[{"Opacity", "[", ".2", "]"}]}], "]"}]}], ",", 
       RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
       RowBox[{"Ticks", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"x", ",", "x"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"x", ",", "xs"}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"y", ",", "y"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"y", ",", "ys"}], "}"}]}], "]"}]}], "}"}]}]}], "]"}]}], 
    ";"}], "\n", "ldp"}]}]], "Input",
 CellChangeTimes->{{3.9715492521399508`*^9, 3.971549273601701*^9}, {
  3.971549351843274*^9, 3.9715494240938463`*^9}},
 CellLabel->
  "In[148]:=",ExpressionUUID->"7a9d60fc-bf7c-4824-83a9-56f041771c05"],

