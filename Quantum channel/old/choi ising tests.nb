Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"assuming", " ", "`data`", " ", "is", " ", "the", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "..."}], "}"}], " ", 
    "list", " ", "shown"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"xs", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"ys", "=", 
     RowBox[{"Sort", "@", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"zmin", ",", "zmax"}], "}"}], "=", 
     RowBox[{"MinMax", "[", 
      RowBox[{"Chop", "[", "data", "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"ldp", "=", 
     RowBox[{"ListDensityPlot", "[", 
      RowBox[{
       RowBox[{"Chop", "[", "data", "]"}], ",", 
       RowBox[{"(*", 
