Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"newdata", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"1", "-", 
         RowBox[{"data", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "3"}], "]"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"assuming", " ", "`data`", " ", "is", " ", "the", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", "..."}], "}"}], " ", 
    "list", " ", "shown"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xs", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Chop", "[", 
      RowBox[{"newdata", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"ys", "=", 
   RowBox[{"Sort", "@", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Chop", "[", 
      RowBox[{"newdata", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"zmin", ",", "zmax"}], "}"}], "=", 
    RowBox[{"MinMax", "[", 
     RowBox[{"Chop", "[", "newdata", "]"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ldp", "=", 
   RowBox[{"ListDensityPlot", "[", 
    RowBox[{
     RowBox[{"Chop", "[", "newdata", "]"}], ",", 
     RowBox[{"(*", 
      RowBox[{"smooth", " ", "but", " ", "not", " ", "overdone"}], "*)"}], 
     RowBox[{"ColorFunction", "->", "\"\<BlueGreenYellow\>\""}], ",", 
     RowBox[{"(*", 
      RowBox[{"uniform", " ", "scientific", " ", "palette"}], "*)"}], 
     RowBox[{"ColorFunctionScaling", "->", "True"}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"zmin", ",", "zmax"}], "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"#", ",", "25"}], "]"}], "&"}], "/@", 
        RowBox[{"{", 
         RowBox[{"\"\<hx\>\"", ",", "\"\<hz\>\""}], "}"}]}], ")"}]}], ",", 
     RowBox[{"FrameStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
     RowBox[{"AspectRatio", "->", "1"}], ",", 
     RowBox[{"ImageSize", "->", "600"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"BarLegend", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<BlueGreenYellow\>\"", ",", 
          RowBox[{"{", 
           RowBox[{"zmin", ",", "zmax"}], "}"}]}], "}"}], ",", 
        RowBox[{"LabelStyle", "->", "14"}], ",", 
        RowBox[{"LegendLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{"\"\<1-U(t)\>\"", ",", "20"}], "]"}]}]}], "]"}]}], ",", 
     RowBox[{"Mesh", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Length", "[", "xs", "]"}], ",", 
        RowBox[{"Length", "[", "ys", "]"}]}], "}"}]}], ",", 
     RowBox[{"MeshStyle", "->", 
