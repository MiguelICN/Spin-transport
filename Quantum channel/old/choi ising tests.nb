Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "VNentropy", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", 
    RowBox[{"0", "|", "0."}], "]"}], "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"VNentropy", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "x"}], "*", 
    RowBox[{"Log", "[", "x", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "sdiag", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sdiag", "[", 
     RowBox[{"L_", ",", "La_", ",", "Lb_", ",", "ini_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"state", "=", 
         RowBox[{"Dyad", "[", "ini", "]"}]}], ",", 
        RowBox[{"dima", "=", 
         RowBox[{"2", "^", 
          RowBox[{"(", "La", ")"}]}]}], ",", 
        RowBox[{"dimb", "=", 
         RowBox[{"2", "^", 
          RowBox[{"(", "Lb", ")"}]}]}], ",", "rho"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rho", "=", 
        RowBox[{"MatrixPartialTrace", "[", 
         RowBox[{"state", ",", "2", ",", 
          RowBox[{"{", 
           RowBox[{"dima", ",", "dimb"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Chop", "[", 
        RowBox[{"Total", "[", 
         RowBox[{"Map", "[", 
          RowBox[{"VNentropy", ",", 
           RowBox[{"Chop", "[", 
            RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}]}], "]"}], "]"}], 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Clear", "[", "svn", "]"}], ";", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"svn", "[", 
      RowBox[{
      "L_", ",", "La_", ",", "Lb_", ",", "ini_", ",", "eigenval_", ",", 
       "eigenvec_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"state", "=", 
          RowBox[{"StateEvolution", "[", 
           RowBox[{"t", ",", "ini", ",", "eigenval", ",", "eigenvec"}], 
           "]"}]}], ",", "rho", ",", "\[Lambda]", ",", "purity", ",", 
         RowBox[{"dima", "=", 
          RowBox[{"2", "^", 
           RowBox[{"(", "La", ")"}]}]}], ",", 
         RowBox[{"dimb", "=", 
          RowBox[{"2", "^", 
           RowBox[{"(", "Lb", ")"}]}]}], ",", "vn"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"rho", "=", 
         RowBox[{"MatrixPartialTrace", "[", 
          RowBox[{
           RowBox[{"Dyad", "[", "state", "]"}], ",", "2", ",", 
           RowBox[{"{", 
            RowBox[{"dima", ",", "dimb"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Chop", "[", 
         RowBox[{"Total", "[", 
          RowBox[{"Map", "[", 
           RowBox[{"VNentropy", ",", 
            RowBox[{"Sort", "[", 
             RowBox[{"Chop", "[", 
              RowBox[{"Eigenvalues", "[", "rho", "]"}], "]"}], "]"}]}], "]"}],
           "]"}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pageEntropy", "[", 
    RowBox[{"La_", ",", "Lb_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"PolyGamma", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"2", "^", "La"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"2", "^", "Lb"}], ")"}]}], "+", "1"}]}], "]"}], "-", 
    RowBox[{"PolyGamma", "[", 
     RowBox[{"0", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "Lb"}], ")"}], "+", "1"}]}], "]"}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"2", "^", "La"}], ")"}], "-", "1"}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"2", "^", "Lb"}], ")"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "haar", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"haar", "[", "L_Integer", "]"}], ":=", 
   RowBox[{"Normalize", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"RandomVariate", "[", 
        RowBox[{"NormalDistribution", "[", 
         RowBox[{"0", ",", "1"}], "]"}], "]"}], "+", 
       RowBox[{"I", " ", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{"NormalDistribution", "[", 
          RowBox[{"0", ",", "1"}], "]"}], "]"}]}]}], ",", 
      RowBox[{"{", 
       RowBox[{"2", "^", "L"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "svn", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"svn", "[", 
     RowBox[{
     "L_", ",", "La_", ",", "Lb_", ",", "ini_", ",", "eigenval_", ",", 
      "eigenvec_", ",", "t_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"state", "=", 
         RowBox[{"StateEvolution", "[", 
          RowBox[{"t", ",", "ini", ",", "eigenval", ",", "eigenvec"}], 
          "]"}]}], ",", "rho", ",", "\[Lambda]", ",", "purity", ",", 
        RowBox[{"dima", "=", 
         RowBox[{"2", "^", 
          RowBox[{"(", "La", ")"}]}]}], ",", 
        RowBox[{"dimb", "=", 
         RowBox[{"2", "^", 
          RowBox[{"(", "Lb", ")"}]}]}], ",", "vn"}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"rho", "=", 
        RowBox[{"MatrixPartialTrace", "[", 
         RowBox[{
          RowBox[{"Dyad", "[", "state", "]"}], ",", "2", ",", 
          RowBox[{"{", 
           RowBox[{"dima", ",", "dimb"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tr", "[", 
        RowBox[{"Chop", "[", 
         RowBox[{"rho", ".", "rho"}], "]"}], "]"}]}]}], "\[IndentingNewLine]",
      "]"}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Compute", " ", "total", " ", "decoherence", " ", "via", " ", 
    "trapezoidal", " ", "rule"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"decoherence", "[", 
   RowBox[{"purity_", ",", "tlist_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"pur", "=", 
      RowBox[{"Chop", "[", "purity", "]"}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", "/", 
       RowBox[{"tlist", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}]}], ")"}], 
     RowBox[{"Total", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"pur", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "+", 
            RowBox[{"pur", "[", 
             RowBox[{"[", 
              RowBox[{"i", "+", "1"}], "]"}], "]"}]}], ")"}], "/", "2"}], "*", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"tlist", "[", 
            RowBox[{"[", 
             RowBox[{"i", "+", "1"}], "]"}], "]"}], "-", 
           RowBox[{"tlist", "[", 
            RowBox[{"[", "i", "]"}], "]"}]}], ")"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "purity", "]"}], "-", "1"}]}], "}"}]}], 
       "]"}], "]"}]}]}], "]"}]}]}], "Input",
