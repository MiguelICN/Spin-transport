Cell[BoxData[{
 RowBox[{
  RowBox[{"hx", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "2", ",", "0.1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hz", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "1", ",", "0.1"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971502750265101*^9, 
  3.971502774071721*^9}},ExpressionUUID->"56019ab1-a46d-482e-bc11-\
802e6342294c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ha", "=", 
      RowBox[{"IsingHamiltonian", "[", 
       RowBox[{
        RowBox[{"i", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"i", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "1", ",", "L", ",", 
        RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"system", "=", 
      RowBox[{"BlockDiagonalize", "[", 
       RowBox[{"Ha", ",", " ", 
        RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"neweven", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "evenMap", ",", "\"\<even\>\"", ",", "L"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newodd", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "oddMap", ",", "\"\<odd\>\"", ",", "L"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"neweven", ",", "newodd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"Transpose", "[", "allvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pinv", "=", 
      RowBox[{"Conjugate", "[", "allvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "[", "t_", "]"}], ":=", 
      RowBox[{"P", ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "allvals", "*", "t"}], "]"}], "]"}], ".", 
       "Pinv"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"chois", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ChoiMatrix", "[", 
         RowBox[{
          RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"Chop", "[", 
       RowBox[{"Map", "[", 
        RowBox[{"Tr", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"#", ".", "#"}], "&"}], ",", "chois"}], "]"}]}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"i", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"decoherence", "[", 
          RowBox[{"purity", ",", "tlist"}], "]"}]}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "parameters"}], "}"}]}], "]"}], ";"}]}], "Input",
