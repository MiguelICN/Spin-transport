Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "arrayt", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrayt", "[", 
    RowBox[{"t_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "val", "*", "t"}], "]"}], "*", "vec"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "statet", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"statet", "[", 
    RowBox[{"ini_", ",", "t_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"schmidt", ",", "psit", ",", 
       RowBox[{"ck", "=", 
        RowBox[{
         RowBox[{"Conjugate", "[", "vec", "]"}], " ", ".", " ", "ini"}]}], 
       ",", 
       RowBox[{"phases", "=", 
        RowBox[{"arrayt", "[", 
         RowBox[{"t", ",", "val", ",", "vec"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"psit", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Total", "[", " ", 
         RowBox[{"phases", "*", "ck"}], "  ", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "psit", "]"}], ".", "ini"}], "]"}], "^", 
       "2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "purity", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"purity", "[", 
    RowBox[{"ini_", ",", "t_", ",", "La_", ",", "val_", ",", "vec_"}], "]"}], 
   ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"schmidt", ",", "psit", ",", 
       RowBox[{"ck", "=", 
        RowBox[{
         RowBox[{"Conjugate", "[", "vec", "]"}], " ", ".", " ", "ini"}]}], 
       ",", 
       RowBox[{"a", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "La", ")"}]}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"L", "-", "La"}], ")"}]}]}], ",", 
       RowBox[{"phases", "=", 
        RowBox[{"arrayt", "[", 
         RowBox[{"t", ",", "val", ",", "vec"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"psit", "=", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Total", "[", " ", 
           RowBox[{"phases", "*", "ck"}], "  ", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"schmidt", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Chop", "[", 
           RowBox[{"SingularValueList", "[", "psit", "]"}], "]"}], "^", "4"}],
          ")"}], "]"}]}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}]}], "Input",\

