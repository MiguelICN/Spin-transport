Cell[BoxData[{
 RowBox[{
  RowBox[{"plotsmag", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{
        RowBox[{"hlist", "[", 
         RowBox[{"[", "h", "]"}], "]"}], ",", "g", ",", "J", ",", "L"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Heven", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H", ".", 
       "Beven"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Hodd", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H", ".", 
       "Bodd"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Heven", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Hodd", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uno", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Beven", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dos", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Bodd", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"uno", ",", "dos"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newall", "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", "First"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"magnetization", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"mag", "[", 
           RowBox[{
           "L", ",", "productstatesfull", ",", "t", ",", "allvals", ",", 
            "allvecs"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     RowBox[{"plot", "=", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"MovingAverage", "[", 
         RowBox[{"magnetization", ",", "100"}], "]"}], ",", 
        RowBox[{"PlotStyle", "->", 
         RowBox[{"{", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"reds", "[", 
             RowBox[{"[", "h", "]"}], "]"}], ",", 
            RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], "}"}]}], ",", 
        RowBox[{"PlotRange", "->", "All"}], ",", 
        RowBox[{"Joined", "->", "True"}], ",", 
        RowBox[{"ImageSize", "->", "1000"}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        RowBox[{"FrameStyle", "->", 
         RowBox[{"Directive", "[", 
          RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<L = \>\"", "<>", 
            RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, J = \>\"", "<>", 
            RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, g = \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"N", "[", "g", "]"}], "]"}]}], ",", "35", ",", "Black"}],
           "]"}]}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<t\>\"", ",", "25", ",", "Black"}], "]"}], ",", 
           RowBox[{"Style", "[", 
            RowBox[{"\"\<M(t)\>\"", ",", "25", ",", "Black"}], "]"}]}], 
          "}"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"plotsmag", ",", "plot"}], "]"}], ";"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"h", ",", 
      RowBox[{"Length", "[", "hlist", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
