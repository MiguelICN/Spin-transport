Cell[CellGroupData[{

Cell["Kicked Ising", "Chapter",
 CellChangeTimes->{{3.963300763194694*^9, 3.963300764955628*^9}, {
  3.9653494987814417`*^9, 
  3.9653495005737877`*^9}},ExpressionUUID->"1830e30e-7f65-4a52-bc26-\
54c661ff8968"],

Cell["\<\
I will use the Transverse Field Ising Model as the integrable model because \
it does not have degeneracies in the spectrum which the other integrable \
limit has.\
\>", "Text",
 CellChangeTimes->{{3.96534950932544*^9, 
  3.965349589199095*^9}},ExpressionUUID->"94e37e88-6234-45ea-87ca-\
cb9e6d77bca4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"basis", "=", 
   RowBox[{"Tuples", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}], ",", "L"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ToIndex", "[", "state_List", "]"}], ":=", 
   RowBox[{
    RowBox[{"FromDigits", "[", 
     RowBox[{"state", ",", "2"}], "]"}], "+", "1"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permutation", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ToIndex", "[", 
      RowBox[{"Reverse", "[", 
       RowBox[{"basis", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "basis", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"permCycles", "=", 
   RowBox[{"PermutationCycles", "[", "permutation", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"R", "=", 
   RowBox[{"PermutationMatrix", "[", 
    RowBox[{"permCycles", ",", 
     RowBox[{"2", "^", "L"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evalR", ",", "evecR"}], "}"}], "=", 
   RowBox[{"Eigensystem", "[", "R", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddIndices", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Position", "[", 
     RowBox[{"evalR", ",", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evenBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "evenIndices", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"oddBasis", "=", 
   RowBox[{"evecR", "[", 
    RowBox[{"[", "oddIndices", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Beven", "=", 
   RowBox[{"Transpose", "[", "evenBasis", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Bodd", "=", 
   RowBox[{"Transpose", "[", "oddBasis", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9653504260060253`*^9, 3.965350426164212*^9}, {
   3.9653506684084253`*^9, 3.9653506947911463`*^9}, 3.9653519793307037`*^9, {
   3.965352118362051*^9, 3.9653521186062107`*^9}},
 CellLabel->
  "In[766]:=",ExpressionUUID->"80b8aa84-ee5e-4fe2-ba8f-491a07f4a4ce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"J", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", "0."}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"H0", "=", 
   RowBox[{"IsingNNOpenHamiltonian", "[", 
    RowBox[{"h", ",", "g", ",", "J", ",", "L"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Heven", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H0", ".", 
    "Beven"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hodd", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H0", ".", 
    "Bodd"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"N", "[", "Heven", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{"Transpose", "[", 
      RowBox[{"Eigensystem", "[", 
       RowBox[{"N", "[", "Hodd", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"uno", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Beven", ".", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "eveneigenvec"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dos", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"Bodd", ".", "i"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "oddeigenvec"}], "}"}], ",", 
     RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvecs", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"uno", ",", "dos"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvals", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newall", "=", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", "First"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvecs", "=", 
   RowBox[{"newall", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "2"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allvals", "=", 
   RowBox[{"newall", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965349632751585*^9, 3.965349678163385*^9}, {
  3.965350437513598*^9, 3.965350439015587*^9}},
