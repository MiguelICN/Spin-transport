Cell[BoxData[{
 RowBox[{
  RowBox[{"plotsent", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"alldata", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{
        RowBox[{"hlist", "[", 
         RowBox[{"[", "h", "]"}], "]"}], ",", "g", ",", "J", ",", "L"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Heven", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H", ".", 
       "Beven"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Hodd", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H", ".", 
       "Bodd"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Heven", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Hodd", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uno", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Beven", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dos", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Bodd", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"uno", ",", "dos"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newall", "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", "First"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"entropy2", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"new", "[", 
           RowBox[{"productstatesfull", ",", "t", ",", 
            RowBox[{"L", "/", "2"}], ",", "allvals", ",", "allvecs"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"MovingAverage", "[", 
       RowBox[{"entropy2", ",", "100"}], "]"}]}], ";", "\[IndentingNewLine]", 
     
     RowBox[{"AppendTo", "[", 
      RowBox[{"alldata", ",", "data"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"plot1", "=", 
      RowBox[{"Show", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ListLogLinearPlot", "[", 
          RowBox[{"data", ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"{", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"reds", "[", 
                RowBox[{"[", "h", "]"}], "]"}], ",", 
               RowBox[{"Opacity", "[", "1", "]"}]}], "]"}], "}"}]}], ",", 
           RowBox[{"Joined", "->", "True"}], ",", 
           RowBox[{"ImageSize", "->", "1000"}], ",", 
           RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
           RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<L = \>\"", "<>", 
               RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, J = \>\"", "<>", 
               RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, g = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"N", "[", "g", "]"}], "]"}], "<>", "\"\<, h = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"hlist", "[", 
                 RowBox[{"[", "h", "]"}], "]"}], "]"}]}], ",", "30", ",", 
              "Black"}], "]"}]}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<t\>\"", ",", "25", ",", "Black"}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<Svn(t)\>\"", ",", "25", ",", "Black"}], "]"}]}], 
             "}"}]}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"tlist", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"tlist", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
              "All"}], "}"}]}]}], "]"}], "}"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Log", "[", 
              RowBox[{"tlist", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
             RowBox[{"Log", "[", 
              RowBox[{"tlist", "[", 
               RowBox[{"[", 
                RowBox[{"-", "1"}], "]"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "1.05"}], "}"}]}], "}"}]}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"plotsent", ",", "plot1"}], "]"}], ";"}], "\[IndentingNewLine]",
     "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"h", ",", 
      RowBox[{"Length", "[", "hlist", "]"}]}], "}"}]}], "]"}], 
  ";"}]}], "Input",
