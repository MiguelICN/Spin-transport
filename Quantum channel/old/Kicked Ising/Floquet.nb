 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{"h", ",", "g", ",", "J", ",", "L"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Heven", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Beven", "]"}], ".", "H", ".", 
       "Beven"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Hodd", "=", 
      RowBox[{
       RowBox[{"ConjugateTranspose", "[", "Bodd", "]"}], ".", "H", ".", 
       "Bodd"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Heven", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
      "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", "Hodd", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"uno", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Beven", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dos", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Bodd", ".", "i"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"uno", ",", "dos"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newall", "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"allvals", ",", "allvecs"}], "}"}], "]"}], ",", "First"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"newall", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]",
      "\[IndentingNewLine]", 
     RowBox[{"allstates", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"RandomChainProductState", "[", "L", "]"}], ",", "1000"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"iprs", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Quiet", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Conjugate", "[", "allvecs", "]"}], ".", "i"}], "]"}], 
           "^", "4"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "allstates"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"data", "=", 
      RowBox[{"SortBy", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "iprs"}], ",", "allstates"}], "}"}], "]"}], ",", 
        "First"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"productstatesfull", "=", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{"-", "10"}], ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"entropy2", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"new", "[", 
           RowBox[{"j", ",", "t", ",", "L", ",", "allvals", ",", "allvecs"}], 
           "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "productstatesfull"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}], ",", 
        RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"plot2", "=", 
      RowBox[{"Show", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ListLogLinearPlot", "[", 
          RowBox[{
           RowBox[{"Mean", "[", "entropy2", "]"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"tlist", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"tlist", "[", 
                 RowBox[{"[", 
                  RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", 
                RowBox[{
                 RowBox[{"pageEntropy", "[", 
                  RowBox[{"La", ",", "Lb"}], "]"}], "+", "0.1"}]}], "}"}]}], 
             "}"}]}], ",", 
           RowBox[{"Joined", "->", "False"}], ",", 
           RowBox[{"ImageSize", "->", "1000"}], ",", 
           RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
           RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", "20"}], "]"}]}], ",", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"\"\<L = \>\"", "<>", 
               RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
               RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
               RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, h = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"N", "[", "h", "]"}], "]"}], "<>", "\"\<, g = \>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"N", "[", "g", "]"}], "]"}]}], ",", "35", ",", 
              "Black"}], "]"}]}], ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Style", "[", 
               RowBox[{"\"\<t\>\"", ",", "25", ",", "Black"}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{"\"\<S(t)\>\"", ",", "25", ",", "Black"}], "]"}]}], 
             "}"}]}], ",", 
           RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}], ",", 
         RowBox[{"LogLinearPlot", "[", 
          RowBox[{
           RowBox[{"pageEntropy", "[", 
            RowBox[{
             RowBox[{"L", "/", "2"}], ",", 
             RowBox[{"L", "/", "2"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"tlist", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"PlotStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Red", ",", "Dashed"}], "]"}]}]}], "]"}]}], "}"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"\"\<mean_plots_L_\>\"", "<>", 
        RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<_h_1_g_\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"N", "[", "g", "]"}], "]"}], "<>", "\"\<_.png\>\""}], ",", 
       "plot2"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"plots2", ",", "plot2"}], "]"}], ";"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"g", ",", "glist"}], "}"}]}], "]"}], ";"}]}], "Input",
 CellChangeTimes->{{3.961705517572206*^9, 3.961705674751225*^9}, {
   3.961706417903225*^9, 3.9617064525101843`*^9}, {3.9617064903358183`*^9, 
