         RowBox[{"n", ",", "val", ",", "vec"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"psit", "=", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"Total", "[", " ", 
           RowBox[{"phases", "*", "ck"}], "  ", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"schmidt", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Chop", "[", 
