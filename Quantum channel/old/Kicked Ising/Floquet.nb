   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"schmidt", ",", "psit", ",", 
       RowBox[{"ck", "=", 
        RowBox[{
         RowBox[{"Conjugate", "[", "vec", "]"}], " ", ".", " ", "ini"}]}], 
       ",", 
       RowBox[{"a", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", "La", ")"}]}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
