Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "arrayt", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrayt", "[", 
    RowBox[{"t_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "val", "*", "t"}], "]"}], "*", "vec"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "new", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"new", "[", 
    RowBox[{"ini_", ",", "t_", ",", "L_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
