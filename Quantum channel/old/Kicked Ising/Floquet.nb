Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "Isingnoisy", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Isingnoisy", "[", 
    RowBox[{"h_", ",", "g_", ",", "J_", ",", "L_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"NNIndices", ",", "A", ",", "B", ",", 
       RowBox[{"\[Epsilon]", "=", 
        RowBox[{"RandomVariate", "[", 
         RowBox[{
          RowBox[{"NormalDistribution", "[", 
           RowBox[{"0", ",", "1"}], "]"}], ",", "L"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"NNIndices", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", 
                RowBox[{"#", "+", "1"}]}], "}"}], "->", "3"}], "]"}], ",", 
            RowBox[{"{", "L", "}"}]}], "]"}], "&"}], "/@", 
         RowBox[{"Range", "[", 
          RowBox[{"L", "-", "1"}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", "=", 
       RowBox[{"-", 
        RowBox[{"Normal", "[", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"h", "*", 
                 RowBox[{"Pauli", "[", "#", "]"}]}], "+", 
                RowBox[{"g", "*", 
                 RowBox[{"Pauli", "[", 
                  RowBox[{"3", "#"}], "]"}]}]}], "&"}], "/@", 
              RowBox[{"IdentityMatrix", "[", "L", "]"}]}], ",", 
             RowBox[{"J", "*", 
              RowBox[{"(", 
               RowBox[{"Pauli", "/@", "NNIndices"}], ")"}]}]}], "}"}], ",", 
           "2"}], "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"B", "=", 
       RowBox[{"0.001", "*", 
        RowBox[{"\[Epsilon]", ".", " ", 
         RowBox[{"(", 
          RowBox[{"Pauli", "/@", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"3", ",", "L"}], "]"}], "]"}]}], ")"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"A", "+", "B"}]}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{3.964146790016994*^9},
 CellLabel->"In[20]:=",ExpressionUUID->"3911fef5-73a1-4e16-ab4e-6e7199c7d30b"]
}, Closed]],

