Cell[CellGroupData[{

Cell["Integral of purity", "Title",
 CellChangeTimes->{{3.959028291126177*^9, 3.959028291494177*^9}, {
  3.9618189649981194`*^9, 3.961818967646879*^9}, {3.962063144566065*^9, 
  3.962063148389513*^9}},ExpressionUUID->"96e34d4c-f0e3-4d2a-b625-\
6f5128aff469"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "arrayt", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"arrayt", "[", 
    RowBox[{"n_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "I"}], "*", "val", "*", "n"}], "]"}], "*", "vec"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "statet", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"statet", "[", 
    RowBox[{"ini_", ",", "n_", ",", "val_", ",", "vec_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"schmidt", ",", "psit", ",", 
       RowBox[{"ck", "=", 
        RowBox[{
         RowBox[{"Conjugate", "[", "vec", "]"}], " ", ".", " ", "ini"}]}], 
       ",", 
       RowBox[{"phases", "=", 
        RowBox[{"arrayt", "[", 
         RowBox[{"n", ",", "val", ",", "vec"}], "]"}]}]}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"psit", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Total", "[", " ", 
         RowBox[{"phases", "*", "ck"}], "  ", "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"Conjugate", "[", "psit", "]"}], ".", "ini"}], "]"}], "^", 
       "2"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", "purity", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"purity", "[", 
    RowBox[{"ini_", ",", "n_", ",", "La_", ",", "val_", ",", "vec_"}], "]"}], 
