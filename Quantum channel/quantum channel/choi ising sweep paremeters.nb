Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"data", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ha", "=", 
      RowBox[{"IsingHamiltonian", "[", 
       RowBox[{"1", ",", 
        RowBox[{"i", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", 
        RowBox[{"i", "[", 
         RowBox[{"[", "2", "]"}], "]"}], ",", "L", ",", 
        RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"system", "=", 
      RowBox[{"BlockDiagonalize", "[", 
       RowBox[{"Ha", ",", " ", 
        RowBox[{"Symmetry", "->", "\"\<Parity\>\""}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eveneigenval", ",", "eveneigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"oddeigenval", ",", "oddeigenvec"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"system", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "]"}], "]"}], 
       "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"neweven", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "evenMap", ",", "\"\<even\>\"", ",", "L"}], "]"}], 
        ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "eveneigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newodd", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"ExpandBlockVector", "[", 
         RowBox[{"i", ",", "oddMap", ",", "\"\<odd\>\"", ",", "L"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "oddeigenvec"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvecs", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"neweven", ",", "newodd"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"allvals", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eveneigenval", ",", "oddeigenval"}], "]"}]}], ";", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Build", " ", "U", 
       RowBox[{"(", "t", ")"}], " ", "from", " ", "your", " ", "spectrum"}], 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{"unitaryF", "=", 
      RowBox[{"SpectralUnitary", "[", 
       RowBox[{"allvecs", ",", "allvals"}], "]"}]}], ";", "\n", 
     RowBox[{"(*", 
      RowBox[{"Build", " ", 
       RowBox[{"Choi", "[", "J", "]"}], 
       RowBox[{"(", "t", ")"}], " ", "for", " ", "the", " ", "system", " ", 
       "channel"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{"choiF", "=", 
      RowBox[{"ChoiSysBuilder", "[", 
       RowBox[{"m", ",", "n", ",", "unitaryF", ",", 
        RowBox[{"\"\<rhoE\>\"", "->", "rhoE"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Purity", " ", "over", " ", "your", " ", "tlist"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"ProcessPurity", "[", 
       RowBox[{"choiF", ",", "tlist"}], "]"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"data", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"i", "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{"i", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"decoherence", "[", 
          RowBox[{"purity", ",", "tlist"}], "]"}]}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", "parameters"}], "}"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<test_fullmesh_ising_choipurity_JA.m\>\"", ",", "data"}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.9525465026031446`*^9, 3.952546510998187*^9}, {
