          RowBox[{"j", "+", "1"}], "]"}], "]"}], "=", "True"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"i", "==", "j"}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"evenMap", ",", 
