Cell[BoxData[{
 RowBox[{
  RowBox[{"visited", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"False", ",", 
     RowBox[{"2", "^", "L"}], ",", "SparseArray"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"evenMap", "=", 
