 CellLabel->"In[86]:=",ExpressionUUID->"7f514904-eeae-4aa2-a94a-24e020ef3235"],

Cell[BoxData[
 RowBox[{
  RowBox[{"chois", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"ChoiMatrix", "[", 
      RowBox[{
       RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], "]"}], 
     ",", 
