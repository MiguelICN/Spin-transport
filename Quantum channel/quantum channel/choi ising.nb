Cell[BoxData[
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Lb", "=", 
      RowBox[{"L", "-", "La"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"\[Psi]", "=", 
      RowBox[{"productstate", "[", 
       RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rho", "=", 
      RowBox[{"MatrixPartialTrace", "[", 
       RowBox[{
        RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "^", "La"}], ",", 
          RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"A", "=", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IdentityMatrix", "[", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", "Lb", ")"}]}], ",", "SparseArray"}], "]"}], "/", 
         RowBox[{"2", "^", 
          RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"H", "=", 
      RowBox[{"IsingNNOpenHamiltonian", "[", 
       RowBox[{"hx", ",", "hz", ",", "J", ",", "L"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"eigenvals", ",", "eigenvecs"}], "}"}], "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"Sort", "[", 
        RowBox[{"Transpose", "[", 
         RowBox[{"Eigensystem", "[", "H", "]"}], "]"}], "]"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"P", "=", 
      RowBox[{"Transpose", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Pinv", "=", 
      RowBox[{"Conjugate", "[", "eigenvecs", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"ClearAll", "[", "U", "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"U", "[", "t_", "]"}], ":=", 
      RowBox[{"P", ".", 
       RowBox[{"DiagonalMatrix", "[", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], "*", "eigenvals", "*", "t"}], "]"}], "]"}], ".",
        "Pinv"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"chois", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"ChoiMatrix", "[", 
