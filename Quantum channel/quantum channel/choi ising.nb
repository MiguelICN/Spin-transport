Cell[BoxData[{
 RowBox[{
  RowBox[{"plot", "=", 
   RowBox[{"ListLogLinearPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<L = \>\"", "<>", 
         RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
         RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
         RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, Jxy = \>\"", "<>", 
         
         RowBox[{"ToString", "[", "Jxy", "]"}], 
         "<>", "\"\<, RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",",
         "30", ",", "Black"}], "]"}]}], ",", 
     RowBox[{"Joined", "->", "True"}], ",", 
     RowBox[{"Axes", "->", "True"}], ",", 
     RowBox[{"GridLines", "->", "None"}], ",", 
