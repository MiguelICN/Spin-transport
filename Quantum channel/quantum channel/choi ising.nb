          RowBox[{"U", "[", "t", "]"}], ",", "A", ",", "La", ",", "Lb"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "tlist"}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"purity", "=", 
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"Chop", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"i", ".", "i"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Chop", "[", "chois", "]"}]}], "}"}], ",", 
        RowBox[{"DistributedContexts", "->", "Full"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"plot", "=", 
      RowBox[{"ListLogLinearPlot", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
        RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
        RowBox[{"PlotLabel", "->", 
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{"\"\<L = \>\"", "<>", 
            RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
            RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
            RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
            RowBox[{"ToString", "[", "hz", "]"}], 
            "<>", "\"\<,RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",",
