Cell[BoxData[{
 RowBox[{
  RowBox[{"i", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lb", "=", 
   RowBox[{"L", "-", "La"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]", "=", 
   RowBox[{"productstate", "[", 
    RowBox[{"[", "i", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"MatrixPartialTrace", "[", 
    RowBox[{
     RowBox[{"Dyad", "[", "\[Psi]", "]"}], ",", "1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"2", "^", "La"}], ",", 
       RowBox[{"2", "^", "Lb"}]}], "}"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[79]:=",ExpressionUUID->"8c5ce274-4420-4dd8-9088-85a939b6fdc7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"A", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"IdentityMatrix", "[", 
       RowBox[{"2", "^", 
        RowBox[{"(", "Lb", ")"}]}], "]"}], "/", 
      RowBox[{"2", "^", 
       RowBox[{"(", "La", ")"}]}]}], ",", "rho"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"P", "=", 
   RowBox[{"Transpose", "[", "eigenvec", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Pinv", "=", 
   RowBox[{"Conjugate", "[", "eigenvec", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.962062567430932*^9, 3.962062567753159*^9}, {
  3.962062677905128*^9, 3.962062683276774*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"d41cbcb1-85cc-4a57-90bb-031390c17054"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "U", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"U", "[", "t_", "]"}], ":=", 
   RowBox[{"P", ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], "*", "eigenval", "*", "t"}], "]"}], "]"}], ".", 
    "Pinv"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9620613592621613`*^9, 3.9620613913690987`*^9}, {
   3.962061822751155*^9, 3.9620618254868507`*^9}, {3.9620619109605637`*^9, 
   3.962061911118848*^9}, {3.962062428031801*^9, 3.962062434063393*^9}, {
