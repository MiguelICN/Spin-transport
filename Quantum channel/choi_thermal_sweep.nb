    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"BuildFullHamiltonian", ",", " ", "DiagonalizeH"}], "]"}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BuildFullHamiltonian", "[", 
      RowBox[{
