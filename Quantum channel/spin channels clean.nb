\!\(\*StyleBox[RowBox[{SubscriptBox[\"\[Epsilon]\", \"d\"]}], \"TI\"]\) at \
site \!\(\*StyleBox[\"d\", \"TI\"]\), and couplings \
\!\(\*StyleBox[RowBox[{SubscriptBox[\"J\", \"xy\"]}], \"TI\"]\) and \
