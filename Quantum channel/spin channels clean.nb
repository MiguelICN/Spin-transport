              RowBox[{"1.05", ",", "delta", ",", "1", ",", "L", ",", 
               RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], 
              "]"}]}], ";"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"HT", "           ", "=", " ", 
           RowBox[{"Chop", "[", 
            RowBox[{"BuildFullHamiltonian", "[", 
             RowBox[{
             "HAlocal", ",", " ", "Ha", ",", " ", "HBlocal", ",", "\n", 
              "                         ", "couplingA", ",", " ", "couplingB",
               ",", " ", "L"}], "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Eval", ",", " ", "Evec"}], "}"}], " ", "=", " ", 
           RowBox[{"DiagonalizeH", "[", "HT", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Ha", ",", " ", "HT"}], "]"}], ";", "\n", "\n", "    ", 
          RowBox[{"(*", " ", "Precompute", " ", "*)"}], "\n", "    ", 
          RowBox[{"rhoE", "   ", "=", " ", 
           RowBox[{"ProjectToEnergyBasis", "[", 
            RowBox[{"Evec", ",", " ", "rho0sweep"}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"Tmat", "   ", "=", " ", 
           RowBox[{"BuildTransferTensors", "[", 
            RowBox[{"Evec", ",", " ", "L"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Kmat", "   ", "=", " ", 
           RowBox[{"BuildKMatrix", "[", 
            RowBox[{"rhoE", ",", " ", "Tmat"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Tmat", ",", " ", "Evec"}], "]"}], ";", "\n", "    ", 
          RowBox[{"dEflat", " ", "=", " ", 
           RowBox[{"BuildEnergyDiffs", "[", 
            RowBox[{"Chop", "[", "Eval", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Gflat", "  ", "=", " ", 
           RowBox[{"BuildGflat", "[", "rhoE", "]"}]}], ";", "\n", "    ", 
