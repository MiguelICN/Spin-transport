   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "ThermalChainState", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ThermalChainState", "[", 
      RowBox[{"Ha_", ",", " ", "beta_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
