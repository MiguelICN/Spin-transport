\[Sigma]\", RowBox[{\"i\", \"+\", \"1\"}]], RowBox[{\"z\"}]]\) ] + 1/2 \
\!\(\*StyleBox[\"\[Omega]\", \"TI\"]\) \!\(\*SuperscriptBox[SubscriptBox[\"\
\[Sum]\", RowBox[{\"i\", \"=\", \"1\"}]], RowBox[{\"L\"}]]\) \
