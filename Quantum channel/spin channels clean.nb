\"}]]\) + 1/2 \!\(\*StyleBox[RowBox[{SubscriptBox[\"\[Epsilon]\", \"d\"]}], \
\"TI\"]\) \!\(\*SuperscriptBox[SubscriptBox[\"\[Sigma]\", \
RowBox[{StyleBox[\"d\", \"TI\"]}]], RowBox[{\"z\"}]]\).\n\
\!\(\*StyleBox[\"XXZwLocalDefectHamiltonian\", \"MR\"]\) \
\!\(\*StyleBox[\"Options\", \"MR\"]\): BoundaryConditions and MagnonSector.\n\
