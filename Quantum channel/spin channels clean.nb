        ",", "\n", "  ", 
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Infinite", " ", 
          RowBox[{"temperature", ":", " ", 
           RowBox[{"maximally", " ", "mixed", " ", "state"}]}]}], " ", "*)"}],
         "\n", "    ", 
        RowBox[{
         RowBox[{"beta", " ", "==", " ", "0."}], ",", "\n", "      ", 
