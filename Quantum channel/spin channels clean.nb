              RowBox[{"vals", " ", "-", " ", 
               RowBox[{"Min", "[", "vals", "]"}]}], ")"}]}], "]"}]}], ";", 
          "\n", "      ", 
          RowBox[{"Z", " ", "=", " ", 
           RowBox[{"Total", "[", "weights", "]"}]}], ";", "\n", "      ", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "vecs", "]"}], " ", ".", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"N", "[", 
             RowBox[{"weights", " ", "/", " ", "Z"}], "]"}], "]"}], " ", ".", 
