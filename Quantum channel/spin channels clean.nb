   "                      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Ha", ":", " ", 
    RowBox[{
     RowBox[{"2", "^", "L"}], " ", "x", " ", 
     RowBox[{"2", "^", "L"}], " ", "chain", " ", "Hamiltonian", " ", 
     RowBox[{"(", "numerical", ")"}]}]}], "                  ", "*)"}], "\n", 
  
  RowBox[{"(*", " ", 
   RowBox[{"beta", ":", " ", 
    RowBox[{"inverse", " ", "temperature", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0", " ", "=", " ", 
        RowBox[{"infinite", " ", "T"}]}], ",", " ", 
       RowBox[{"Infinity", " ", "=", " ", 
