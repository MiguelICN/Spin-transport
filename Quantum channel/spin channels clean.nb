 CellChangeTimes->{{3.989584975232004*^9, 
  3.989584975537094*^9}},ExpressionUUID->"ab1b115a-6e66-1a45-a2d4-\
122d99c51fe8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"kDeltaList", " ", "=", " ", 
    RowBox[{"Range", "[", 
     RowBox[{"4", ",", "16", ",", "2"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"integer", " ", 
      RowBox[{"keys", ":", " ", "delta"}]}], " ", "=", " ", 
     RowBox[{"k", "/", "10"}]}], ",", " ", 
    RowBox[{"exact", " ", "values"}]}], " ", "*)"}]}]], "Input",
 CellChangeTimes->{{3.9895913158350716`*^9, 3.989591317202389*^9}, {
  3.9895933387188587`*^9, 3.9895933501342487`*^9}},
 CellLabel->
  "In[230]:=",ExpressionUUID->"97c7664d-8b43-fe4c-b519-e97616e0a723"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dirL", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"baseDir", ",", " ", 
          RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", "\n",
       "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "dirL", "]"}]}], ",", " ", 
        RowBox[{"CreateDirectory", "[", "dirL", "]"}]}], "]"}], ";", "\n", 
      "\n", "  ", 
      RowBox[{"Do", "[", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "\[HorizontalLine]\[HorizontalLine]", " ", "delta", " ", "loop", " ", 
         "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"delta", " ", "=", " ", 
          RowBox[{"N", "[", 
           RowBox[{"k", "/", "10"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<L = \>\"", ",", " ", "L", ",", 
           " ", "\"\<   \[CapitalDelta] = \>\"", ",", " ", 
           RowBox[{"NumberForm", "[", 
            RowBox[{"delta", ",", " ", 
             RowBox[{"{", 
              RowBox[{"3", ",", "1"}], "}"}]}], "]"}], ",", 
           " ", "\"\<   ...\>\""}], "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Build", " ", "and", " ", "diagonalise", " ", "ONCE", " ", "per", " ", 
           RowBox[{"(", 
            RowBox[{"L", ",", " ", "delta"}], ")"}]}], " ", "*)"}], "\n", 
         "    ", 
         RowBox[{"Ha", "           ", "=", " ", 
          RowBox[{"OpenXXZHamiltonian", "[", 
           RowBox[{
           "L", ",", " ", "delta", ",", " ", "h1sweep", ",", " ", "h2sweep"}],
            "]"}]}], ";", "\n", "    ", 
         RowBox[{"HT", "           ", "=", " ", 
          RowBox[{"Chop", "[", 
           RowBox[{"BuildFullHamiltonian", "[", 
            RowBox[{
            "HAlocal", ",", " ", "Ha", ",", " ", "HBlocal", ",", "\n", 
             "                         ", "couplingA", ",", " ", "couplingB", 
             ",", " ", "L"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Eval", ",", " ", "Evec"}], "}"}], " ", "=", " ", 
          RowBox[{"DiagonalizeH", "[", "HT", "]"}]}], ";", "\n", "    ", 
         RowBox[{"Clear", "[", "HT", "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"beta", "-", "independent"}], " ", "\[LongDash]", " ", 
           RowBox[{"compute", " ", "once", " ", "per", " ", 
            RowBox[{"(", 
             RowBox[{"L", ",", " ", "delta"}], ")"}]}], ",", " ", 
           RowBox[{"reuse", " ", "across", " ", "beta"}]}], " ", "*)"}], "\n",
          "    ", 
         RowBox[{"Tmat", "   ", "=", " ", 
          RowBox[{"BuildTransferTensors", "[", 
           RowBox[{"Evec", ",", " ", "L"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"dEflat", " ", "=", " ", 
          RowBox[{"BuildEnergyDiffs", "[", 
           RowBox[{"Chop", "[", "Eval", "]"}], "]"}]}], ";", "\n", "\n", 
         "    ", 
         RowBox[{"Do", "[", "   ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "\[HorizontalLine]\[HorizontalLine]", " ", "beta", " ", "loop", " ",
             "\[HorizontalLine]\[HorizontalLine]"}], " ", "*)"}], "\n", 
          "      ", 
          RowBox[{
           RowBox[{
            RowBox[{"beta", " ", "=", " ", 
             RowBox[{"betaList", "[", 
              RowBox[{"[", "ib", "]"}], "]"}]}], ";", "\n", "      ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<    \[Beta] = \>\"", ",", " ", 
              RowBox[{"BetaLabel", "[", "beta", "]"}], ",", 
              " ", "\"\<   ...\>\""}], "]"}], ";", "\n", "      ", 
            RowBox[{"t0", " ", "=", " ", 
             RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\n", "\n", "      ", 
            
            RowBox[{"rhoChainSweep", " ", "=", " ", 
             RowBox[{"ThermalChainState", "[", 
              RowBox[{"Ha", ",", " ", "beta"}], "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"rho0sweep", "     ", "=", " ", 
             RowBox[{"BuildInitialStateCorrelated", "[", 
              RowBox[{"rhoABspin", ",", " ", "rhoChainSweep", ",", " ", "L"}],
               "]"}]}], ";", "\n", "\n", "      ", 
            RowBox[{"rhoE", "  ", "=", " ", 
             RowBox[{"ProjectToEnergyBasis", "[", 
              RowBox[{"Evec", ",", " ", "rho0sweep"}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"Kmat", "  ", "=", " ", 
             RowBox[{"BuildKMatrix", "[", 
              RowBox[{"rhoE", ",", " ", "Tmat"}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"Gflat", " ", "=", " ", 
             RowBox[{"BuildGflat", "[", "rhoE", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"Clear", "[", "rhoE", "]"}], ";", "\n", "\n", "      ", 
            RowBox[{"DistributeDefinitions", "[", "\n", "        ", 
             RowBox[{
             "Kmat", ",", " ", "dEflat", ",", " ", "Gflat", ",", " ", 
              "rhoABref", ",", " ", "spinFlip", ",", "\n", "        ", 
              "TraceOutA", ",", " ", "TraceOutB", ",", " ", "VNEntropy2x2", ",",
               " ", "VNEntropy4x4", ",", "\n", "        ", "Concurrence", ",",
               " ", "ComputeAllObservables", ",", "\n", "        ", 
              "ComputeRhoAB", ",", " ", "ComputeSurvivalGlobal"}], "\n", 
             "      ", "]"}], ";", "\n", "\n", "      ", 
            RowBox[{"allResults", " ", "=", " ", 
             RowBox[{"ParallelTable", "[", "\n", "        ", 
              RowBox[{
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"rhoABt", ",", " ", "survGlobal", ",", " ", "obs"}],
                   "}"}], ",", "\n", "          ", 
                 RowBox[{
                  RowBox[{"rhoABt", "     ", "=", " ", 
                   RowBox[{"Chop", "[", 
                    RowBox[{"ComputeRhoAB", "[", 
                    RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], 
                    "]"}], "]"}]}], ";", "\n", "          ", 
                  RowBox[{"survGlobal", " ", "=", " ", 
                   RowBox[{"ComputeSurvivalGlobal", "[", 
                    RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], 
                    "]"}]}], ";", "\n", "          ", 
                  RowBox[{"obs", "        ", "=", " ", 
                   RowBox[{"ComputeAllObservables", "[", 
                    RowBox[{"rhoABt", ",", " ", "rhoABref"}], "]"}]}], ";", 
                  "\n", "          ", 
                  RowBox[{"Join", "[", 
                   RowBox[{
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
                    
                    RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                    "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], 
                "\n", "        ", "]"}], ",", "\n", "        ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], 
              "\n", "      ", "]"}]}], ";", "\n", "      ", 
            RowBox[{"Clear", "[", 
             RowBox[{"Kmat", ",", " ", "Gflat"}], "]"}], ";", "\n", "\n", 
            "      ", 
            RowBox[{"MakePlots", "[", 
             RowBox[{
             "allResults", ",", " ", "L", ",", " ", "k", ",", " ", "beta", ",",
               " ", "dirL"}], "]"}], ";", "\n", "      ", 
            RowBox[{"Clear", "[", "allResults", "]"}], ";", "\n", "      ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<      done in \>\"", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",",
                 " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], "]"}], ";"}], 
           "\n", "\n", "      ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"ib", ",", " ", 
             RowBox[{"Length", "[", "betaList", "]"}]}], "}"}]}], "\n", 
          "    ", "]"}], ";", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{"end", " ", "beta", " ", "loop"}], " ", "*)"}], "\n", "\n", 
         "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "cleared", " ", "AFTER", " ", "the", " ", "full", " ", "beta", " ", 
           "loop", " ", "for", " ", "this", " ", 
           RowBox[{"(", 
            RowBox[{"L", ",", " ", "delta"}], ")"}]}], " ", "*)"}], "\n", 
         "    ", 
         RowBox[{"Clear", "[", 
          RowBox[{
          "Ha", ",", " ", "Tmat", ",", " ", "Evec", ",", " ", "Eval", ",", 
           " ", "dEflat"}], "]"}], ";"}], "\n", "\n", "    ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "kDeltaList"}], "}"}]}], "\n", "  ", "]"}], 
      ";"}], "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"end", " ", "delta", " ", "loop"}], " ", "*)"}], "\n", "\n", 
     "  ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"L", ",", " ", "LList"}], "}"}]}], "\n", "]"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"end", " ", "L", " ", "loop"}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Sweep complete.\>\"", "]"}], ";"}]}], "Input",
