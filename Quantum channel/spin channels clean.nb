     "    ", "\[RightArrow]", " ", 
     RowBox[{"packed", " ", "array", " ", "op"}]}], ",", " ", 
    RowBox[{"no", " ", "loop"}]}], "              ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{
    RowBox[{
     RowBox[{"2.", " ", 
      RowBox[{"Kmat", " ", ".", " ", "phaseVec"}]}], "     ", "\[RightArrow]",
      " ", 
     RowBox[{"BLAS", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "\[Times]", "4", "\[Times]", "D\.b2"}], ")"}], "\[CenterDot]", 
       RowBox[{"(", "D\.b2", ")"}]}]}]}], " ", "=", " ", 
    RowBox[{"4", "\[Times]", "4", " ", "matrix"}]}], "      ", "*)"}], "\n", 
  RowBox[{"(*", "   ", 
   RowBox[{
    RowBox[{"3.", " ", "All", " ", "observables"}], "     ", "\[RightArrow]", 
    " ", 
    RowBox[{
    "from", " ", "4", "\[Times]", "4", " ", "\[Rho]AB", " ", "only"}]}], 
   "                     ", "*)"}], "\n", 
  RowBox[{
  "(*", "                                                                   ",
    "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "tMax", " ", "and", " ", "dt", " ", "are", " ", "free", " ", 
     "parameters"}], " ", "\[LongDash]", " ", 
    RowBox[{"set", " ", "them", " ", "before", " ", "this", " ", 
     RowBox[{"block", "."}]}]}], "    ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"tMax", "=", "50."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tlist", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "tMax", ",", " ", "dt"}], "]"}]}], ";"}], 
   "                ", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"set", " ", "tMax"}], ",", " ", 
     RowBox[{"dt", " ", "upstream"}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"allResults", " ", "=", " ", 
      RowBox[{"ParallelTable", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rhoAB", ",", " ", "survGlobal", ",", " ", "obs"}], "}"}], 
          ",", "\n", "    ", 
          RowBox[{
           RowBox[{"rhoAB", "      ", "=", " ", 
            RowBox[{"Chop", "[", 
             RowBox[{"ComputeRhoAB", "[", 
              RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], "]"}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"survGlobal", " ", "=", " ", 
            RowBox[{"ComputeSurvivalGlobal", "[", 
             RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], "]"}]}], ";",
            "\n", "    ", 
           RowBox[{"obs", "        ", "=", " ", 
            RowBox[{"ComputeAllObservables", "[", 
             RowBox[{"rhoAB", ",", " ", "rhoABref"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
               
               RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], "\n", 
         "  ", "]"}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "  ", 
        RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "        ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "already", " ", "distributed", " ", "in", " ", "Block", " ", "16"}], 
        " ", "*)"}], "\n", "]"}]}], ";"}], "]"}]}]}]], "Input",
