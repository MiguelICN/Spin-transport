            RowBox[{"Kmat", "  ", "=", " ", 
             RowBox[{"BuildKMatrix", "[", 
              RowBox[{"rhoE", ",", " ", "Tmat"}], "]"}]}], ";", "\n", 
            "      ", 
            RowBox[{"Gflat", " ", "=", " ", 
             RowBox[{"BuildGflat", "[", "rhoE", "]"}]}], ";", "\n", "      ", 
            
            RowBox[{"Clear", "[", "rhoE", "]"}], ";", "\n", "\n", "      ", 
            RowBox[{"DistributeDefinitions", "[", "\n", "        ", 
             RowBox[{
             "Kmat", ",", " ", "dEflat", ",", " ", "Gflat", ",", " ", 
              "rhoABref", ",", " ", "spinFlip", ",", "\n", "        ", 
              "TraceOutA", ",", " ", "TraceOutB", ",", " ", "VNEntropy2x2", ",",
               " ", "VNEntropy4x4", ",", "\n", "        ", "Concurrence", ",",
               " ", "ComputeAllObservables", ",", "\n", "        ", 
              "ComputeRhoAB", ",", " ", "ComputeSurvivalGlobal"}], "\n", 
             "      ", "]"}], ";", "\n", "\n", "      ", 
            RowBox[{"allResults", " ", "=", " ", 
             RowBox[{"ParallelTable", "[", "\n", "        ", 
              RowBox[{
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"rhoABt", ",", " ", "survGlobal", ",", " ", "obs"}],
                   "}"}], ",", "\n", "          ", 
                 RowBox[{
                  RowBox[{"rhoABt", "     ", "=", " ", 
                   RowBox[{"Chop", "[", 
                    RowBox[{"ComputeRhoAB", "[", 
                    RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], 
                    "]"}], "]"}]}], ";", "\n", "          ", 
                  RowBox[{"survGlobal", " ", "=", " ", 
                   RowBox[{"ComputeSurvivalGlobal", "[", 
                    RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], 
                    "]"}]}], ";", "\n", "          ", 
                  RowBox[{"obs", "        ", "=", " ", 
                   RowBox[{"ComputeAllObservables", "[", 
                    RowBox[{"rhoABt", ",", " ", "rhoABref"}], "]"}]}], ";", 
                  "\n", "          ", 
                  RowBox[{"Join", "[", 
                   RowBox[{
                    RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
                    
                    RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                    "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], 
                "\n", "        ", "]"}], ",", "\n", "        ", 
               RowBox[{"{", 
                RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", 
               "        ", 
               RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], 
              "\n", "      ", "]"}]}], ";", "\n", "      ", 
            RowBox[{"Clear", "[", 
             RowBox[{"Kmat", ",", " ", "Gflat"}], "]"}], ";", "\n", "\n", 
            "      ", 
            RowBox[{"MakePlots", "[", 
             RowBox[{
             "allResults", ",", " ", "L", ",", " ", "k", ",", " ", "beta", ",",
               " ", "dirL"}], "]"}], ";", "\n", "      ", 
            RowBox[{"Clear", "[", "allResults", "]"}], ";", "\n", "      ", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<      done in \>\"", ",", " ", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",",
                 " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], "]"}], ";"}], 
           "\n", "\n", "      ", ",", " ", 
           RowBox[{"{", 
            RowBox[{"ib", ",", " ", 
             RowBox[{"Length", "[", "betaList", "]"}]}], "}"}]}], "\n", 
          "    ", "]"}], ";", "   ", 
         RowBox[{"(*", " ", 
          RowBox[{"end", " ", "beta", " ", "loop"}], " ", "*)"}], "\n", "\n", 
         "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "cleared", " ", "AFTER", " ", "the", " ", "full", " ", "beta", " ", 
           "loop", " ", "for", " ", "this", " ", 
           RowBox[{"(", 
            RowBox[{"L", ",", " ", "delta"}], ")"}]}], " ", "*)"}], "\n", 
         "    ", 
         RowBox[{"Clear", "[", 
          RowBox[{
          "Ha", ",", " ", "Tmat", ",", " ", "Evec", ",", " ", "Eval", ",", 
           " ", "dEflat"}], "]"}], ";"}], "\n", "\n", "    ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", "kDeltaList"}], "}"}]}], "\n", "  ", "]"}], 
      ";"}], "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"end", " ", "delta", " ", "loop"}], " ", "*)"}], "\n", "\n", 
     "  ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"L", ",", " ", "LList"}], "}"}]}], "\n", "]"}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"end", " ", "L", " ", "loop"}], " ", "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Sweep complete.\>\"", "]"}], ";"}]}], "Input",
