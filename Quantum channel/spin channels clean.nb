                    RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
                    
                    RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                    "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], 
              "\n", "      ", "]"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "      ", 
             RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "\n", 
            "    ", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "Gflat"}], "]"}], ";",
           "\n", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Export", " ", "all", " ", "plots", " ", "for", " ", "this", " ", 
            "run"}], " ", "*)"}], "\n", "    ", 
          RowBox[{"MakePlots", "[", 
           RowBox[{
           "allResults", ",", " ", "L", ",", " ", "k", ",", " ", "dirL"}], 
           "]"}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", "allResults", "]"}], ";", "\n", "\n", "    ", 
          
          RowBox[{"Print", "[", 
           RowBox[{"\"\<      done in \>\"", ",", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",",
