        "vals", ",", " ", "vecs", ",", " ", "weights", ",", " ", "Z"}], "}"}],
        ",", "\n", "  ", 
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Infinite", " ", 
          RowBox[{"temperature", ":", " ", 
           RowBox[{"maximally", " ", "mixed", " ", "state"}]}]}], " ", "*)"}],
         "\n", "    ", 
        RowBox[{
         RowBox[{"beta", " ", "==", " ", "0."}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"Length", "[", "Ha", "]"}], "]"}], "]"}], " ", "/", " ", 
          RowBox[{"Length", "[", "Ha", "]"}]}], ",", "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Zero", " ", 
           RowBox[{"temperature", ":", " ", 
            RowBox[{"ground", " ", "state", " ", "projector"}]}]}], " ", 
          "*)"}], "\n", "    ", 
