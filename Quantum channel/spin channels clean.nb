\!\(\*SubscriptBox[\"\[Sum]\", RowBox[{\"i\"}]]\) [ \
\!\(\*StyleBox[RowBox[{SubscriptBox[\"J\", RowBox[{\"xy\"}]]}], \"TI\"]\) (\!\
