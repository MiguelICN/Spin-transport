Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\n", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{"dirL", " ", "=", " ", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"baseDir", ",", " ", 
          RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
           RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", "\n",
       "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"DirectoryQ", "[", "dirL", "]"}]}], ",", " ", 
        RowBox[{"CreateDirectory", "[", "dirL", "]"}]}], "]"}], ";", "\n", 
      "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
        "Build", " ", "and", " ", "diagonalise", " ", "ONCE", " ", "per", " ",
          "L"}], ",", " ", 
        RowBox[{"at", " ", "fixed", " ", "delta"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{"Ha", "           ", "=", " ", 
       RowBox[{"XXZwLocalDefectHamiltonian", "[", 
        RowBox[{
        "Jxy", ",", " ", "Jz", ",", " ", "w", ",", " ", "ed", ",", " ", "L", ",",
          " ", "L"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"HT", "           ", "=", " ", 
       RowBox[{"Chop", "[", 
        RowBox[{"BuildFullHamiltonian", "[", 
         RowBox[{
         "HAlocal", ",", " ", "Ha", ",", " ", "HBlocal", ",", "\n", 
          "                       ", "couplingA", ",", " ", "couplingB", ",", 
          " ", "L"}], "]"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Eval", ",", " ", "Evec"}], "}"}], " ", "=", " ", 
       RowBox[{"DiagonalizeH", "[", "HT", "]"}]}], ";", "\n", "  ", 
      RowBox[{"Clear", "[", "HT", "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
         "Transfer", " ", "tensors", " ", "and", " ", "energy", " ", "diffs", 
          " ", "are", " ", "\[Beta]"}], "-", "independent"}], " ", "\[RightArrow]",
         " ", 
        RowBox[{"compute", " ", "once", " ", "per", " ", "L"}]}], " ", "*)"}],
       "\n", "  ", 
      RowBox[{"Tmat", "   ", "=", " ", 
       RowBox[{"BuildTransferTensors", "[", 
        RowBox[{"Evec", ",", " ", "L"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"dEflat", " ", "=", " ", 
       RowBox[{"BuildEnergyDiffs", "[", 
        RowBox[{"Chop", "[", "Eval", "]"}], "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"\[Beta]", " ", 
         RowBox[{"loop", ":", " ", 
          RowBox[{"only", " ", "rhoE"}]}]}], ",", " ", "Kmat", ",", " ", 
        RowBox[{"Gflat", " ", "change"}]}], " ", "*)"}], "\n", "  ", 
      RowBox[{"Do", "[", "\n", "    ", 
       RowBox[{
        RowBox[{
         RowBox[{"beta", " ", "=", " ", 
          RowBox[{"betaList", "[", 
           RowBox[{"[", "ib", "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<L = \>\"", ",", " ", "L", ",", 
           " ", "\"\<   \[Beta] = \>\"", ",", " ", 
           RowBox[{"BetaLabel", "[", "beta", "]"}], ",", 
           " ", "\"\<   ...\>\""}], "]"}], ";", "\n", "    ", 
         RowBox[{"t0", " ", "=", " ", 
          RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"rhoChainSweep", " ", "=", " ", 
          RowBox[{"ThermalChainState", "[", 
           RowBox[{"Ha", ",", " ", "beta"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"rho0sweep", "     ", "=", " ", 
          RowBox[{"BuildInitialStateCorrelated", "[", 
           RowBox[{"rhoABspin", ",", " ", "rhoChainSweep", ",", " ", "L"}], 
           "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"rhoE", "  ", "=", " ", 
          RowBox[{"ProjectToEnergyBasis", "[", 
           RowBox[{"Evec", ",", " ", "rho0sweep"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"Kmat", "  ", "=", " ", 
          RowBox[{"BuildKMatrix", "[", 
           RowBox[{"rhoE", ",", " ", "Tmat"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"Gflat", " ", "=", " ", 
          RowBox[{"BuildGflat", "[", "rhoE", "]"}]}], ";", "\n", "    ", 
         RowBox[{"Clear", "[", "rhoE", "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"DistributeDefinitions", "[", "\n", "      ", 
          RowBox[{
          "Kmat", ",", " ", "dEflat", ",", " ", "Gflat", ",", " ", "rhoABref",
            ",", " ", "spinFlip", ",", "\n", "      ", "TraceOutA", ",", " ", 
           "TraceOutB", ",", " ", "VNEntropy2x2", ",", " ", "VNEntropy4x4", ",",
            "\n", "      ", "Concurrence", ",", " ", "ComputeAllObservables", 
           ",", "\n", "      ", "ComputeRhoAB", ",", " ", 
           "ComputeSurvivalGlobal"}], "\n", "    ", "]"}], ";", "\n", "\n", 
         "    ", 
         RowBox[{"allResults", " ", "=", " ", 
          RowBox[{"ParallelTable", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"rhoABt", ",", " ", "survGlobal", ",", " ", "obs"}], 
               "}"}], ",", "\n", "        ", 
              RowBox[{
               RowBox[{"rhoABt", "     ", "=", " ", 
                RowBox[{"Chop", "[", 
                 RowBox[{"ComputeRhoAB", "[", 
                  RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], "]"}], 
                 "]"}]}], ";", "\n", "        ", 
               RowBox[{"survGlobal", " ", "=", " ", 
                RowBox[{"ComputeSurvivalGlobal", "[", 
                 RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], 
                 "]"}]}], ";", "\n", "        ", 
               RowBox[{"obs", "        ", "=", " ", 
                RowBox[{"ComputeAllObservables", "[", 
                 RowBox[{"rhoABt", ",", " ", "rhoABref"}], "]"}]}], ";", "\n",
                "        ", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
                   
                   RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                    "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], 
             "\n", "      ", "]"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "      ", 
            RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "\n", 
           "    ", "]"}]}], ";", "\[IndentingNewLine]", "\n", "    ", 
         RowBox[{"Clear", "[", 
          RowBox[{"Kmat", ",", " ", "Gflat"}], "]"}], ";", "\n", "    ", 
         RowBox[{"MakePlots", "[", 
          RowBox[{
          "allResults", ",", " ", "L", ",", " ", "k", ",", " ", "beta", ",", 
           " ", "dirL"}], "]"}], ";", "\n", "    ", 
         RowBox[{"Clear", "[", "allResults", "]"}], ";", "\n", "    ", 
         RowBox[{"Print", "[", 
          RowBox[{"\"\<      done in \>\"", ",", " ", 
           RowBox[{"Round", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",", 
             " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], "]"}], ";"}], 
        "\n", "    ", ",", " ", 
        RowBox[{"{", 
         RowBox[{"ib", ",", " ", 
          RowBox[{"Length", "[", "betaList", "]"}]}], "}"}]}], "\n", "  ", 
       "]"}], ";", "\n", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{"Ha", ",", " ", "Tmat", ",", " ", "Evec", ",", " ", 
        RowBox[{
        "Eval", " ", "cleared", " ", "after", " ", "the", " ", "full", " ", 
         "\[Beta]", " ", "loop", " ", "for", " ", "this", " ", "L"}]}], " ", 
       "*)"}], "\n", "  ", 
      RowBox[{"Clear", "[", 
       RowBox[{
       "Ha", ",", " ", "Tmat", ",", " ", "Evec", ",", " ", "Eval", ",", " ", 
        "dEflat"}], "]"}], ";"}], "\n", "\n", "  ", ",", " ", 
     RowBox[{"{", 
      RowBox[{"L", ",", " ", "LList"}], "}"}]}], "\n", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Sweep complete.\>\"", "]"}], ";"}]}], "Input",
