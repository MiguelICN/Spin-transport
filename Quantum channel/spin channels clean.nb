  RowBox[{
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
      "Create", " ", "output", " ", "folder", " ", "for", " ", "this", " ", 
       "L"}], " ", "*)"}], "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"dirL", " ", "=", " ", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{"baseDir", ",", " ", 
           RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
            RowBox[{"ToString", "[", "L", "]"}]}]}], "}"}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"DirectoryQ", "[", "dirL", "]"}]}], ",", " ", 
         RowBox[{"CreateDirectory", "[", "dirL", "]"}]}], "]"}], ";", "\n", 
       "\n", "  ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "Chain", " ", "initial", " ", "state", " ", "depends", " ", "on", " ",
           "L", " ", "only"}], " ", "\[LongDash]", " ", 
         RowBox[{"built", " ", "once", " ", "per", " ", "L"}]}], " ", "*)"}], 
       "\n", "  ", 
       RowBox[{"rhoChainSweep", " ", "=", " ", 
        RowBox[{"Dyad", "[", 
         RowBox[{"coherentstate", "[", 
          RowBox[{
           RowBox[{"QubitStateFromBlochVector", "[", 
            RowBox[{"0.", ",", " ", "0"}], "]"}], ",", " ", "L"}], "]"}], 
         "]"}]}], ";", "\n", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"rhoChainSweep", " ", "=", " ", 
          RowBox[{"Dyad", "[", 
           RowBox[{"RandomChainProductState", "[", "L", "]"}], "]"}]}], ";"}],
         "*)"}], "\n", 
       RowBox[{"rho0sweep", "     ", "=", " ", 
        RowBox[{"BuildInitialStateCorrelated", "[", 
         RowBox[{"rhoABspin", ",", " ", "rhoChainSweep", ",", " ", "L"}], 
         "]"}]}], ";", "\n", "\n", "  ", 
       RowBox[{"Do", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"t0", "    ", "=", " ", 
           RowBox[{"AbsoluteTime", "[", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<L = \>\"", ",", " ", "L", ",", 
            " ", "\"\<   \[CapitalDelta] = \>\"", ",", " ", "delta", ",", 
            " ", "\"\<   ...\>\""}], "]"}], ";", "\n", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Build", " ", "and", " ", "diagonalize"}], " ", "*)"}], 
          "\n", "    ", 
          RowBox[{"Ha", "           ", "=", " ", 
           RowBox[{"XXZwLocalDefectHamiltonian", "[", 
            RowBox[{
            "Jxy", ",", " ", "delta", ",", " ", "w", ",", " ", "ed", ",", " ",
              "L", ",", " ", "L"}], "]"}]}], ";", "\n", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"Ha", "=", 
             RowBox[{"IsingHamiltonian", "[", 
              RowBox[{"1.05", ",", "delta", ",", "1", ",", "L", ",", 
               RowBox[{"BoundaryConditions", "->", "\"\<Open\>\""}]}], 
              "]"}]}], ";"}], "*)"}], "\n", 
          RowBox[{"HT", "           ", "=", " ", 
           RowBox[{"Chop", "[", 
            RowBox[{"BuildFullHamiltonian", "[", 
             RowBox[{
             "HAlocal", ",", " ", "Ha", ",", " ", "HBlocal", ",", "\n", 
              "                         ", "couplingA", ",", " ", "couplingB",
               ",", " ", "L"}], "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"Eval", ",", " ", "Evec"}], "}"}], " ", "=", " ", 
           RowBox[{"DiagonalizeH", "[", "HT", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Ha", ",", " ", "HT"}], "]"}], ";", "\n", "\n", "    ", 
          RowBox[{"(*", " ", "Precompute", " ", "*)"}], "\n", "    ", 
          RowBox[{"rhoE", "   ", "=", " ", 
           RowBox[{"ProjectToEnergyBasis", "[", 
            RowBox[{"Evec", ",", " ", "rho0sweep"}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"Tmat", "   ", "=", " ", 
           RowBox[{"BuildTransferTensors", "[", 
            RowBox[{"Evec", ",", " ", "L"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Kmat", "   ", "=", " ", 
           RowBox[{"BuildKMatrix", "[", 
            RowBox[{"rhoE", ",", " ", "Tmat"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Tmat", ",", " ", "Evec"}], "]"}], ";", "\n", "    ", 
          RowBox[{"dEflat", " ", "=", " ", 
           RowBox[{"BuildEnergyDiffs", "[", 
            RowBox[{"Chop", "[", "Eval", "]"}], "]"}]}], ";", "\n", "    ", 
          RowBox[{"Gflat", "  ", "=", " ", 
           RowBox[{"BuildGflat", "[", "rhoE", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"rhoE", ",", " ", "Eval"}], "]"}], ";", "\n", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Distribute", " ", "to", " ", "parallel", " ", "kernels"}],
            " ", "*)"}], "\n", "    ", 
          RowBox[{"DistributeDefinitions", "[", "\n", "      ", 
           RowBox[{
           "Kmat", ",", " ", "dEflat", ",", " ", "Gflat", ",", " ", 
            "rhoABref", ",", " ", "spinFlip", ",", "\n", "      ", 
            "TraceOutA", ",", " ", "TraceOutB", ",", " ", "VNEntropy2x2", ",",
             " ", "VNEntropy4x4", ",", "\n", "      ", "Concurrence", ",", 
            " ", "ComputeAllObservables", ",", "\n", "      ", "ComputeRhoAB",
             ",", " ", "ComputeSurvivalGlobal"}], "\n", "    ", "]"}], ";", 
          "\n", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{"Time", " ", "evolution"}], " ", "*)"}], "\n", "    ", 
          RowBox[{"allResults", " ", "=", " ", 
           RowBox[{"ParallelTable", "[", "\n", "      ", 
            RowBox[{
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"rhoABt", ",", " ", "survGlobal", ",", " ", "obs"}], 
                "}"}], ",", "\n", "        ", 
               RowBox[{
                RowBox[{"rhoABt", "     ", "=", " ", 
                 RowBox[{"Chop", "[", 
                  RowBox[{"ComputeRhoAB", "[", 
                   RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], "]"}],
                   "]"}]}], ";", "\n", "        ", 
                RowBox[{"survGlobal", " ", "=", " ", 
                 RowBox[{"ComputeSurvivalGlobal", "[", 
                  RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], 
                  "]"}]}], ";", "\n", "        ", 
                RowBox[{"obs", "        ", "=", " ", 
                 RowBox[{"ComputeAllObservables", "[", 
                  RowBox[{"rhoABt", ",", " ", "rhoABref"}], "]"}]}], ";", 
                "\n", "        ", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
                    
                    RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                    "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], 
              "\n", "      ", "]"}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "      ", 
             RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "\n", 
            "    ", "]"}]}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", 
           RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "Gflat"}], "]"}], ";",
           "\n", "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
           "Export", " ", "all", " ", "plots", " ", "for", " ", "this", " ", 
            "run"}], " ", "*)"}], "\n", "    ", 
          RowBox[{"MakePlots", "[", 
           RowBox[{
           "allResults", ",", " ", "L", ",", " ", "delta", ",", " ", "dirL"}],
            "]"}], ";", "\n", "    ", 
          RowBox[{"Clear", "[", "allResults", "]"}], ";", "\n", "\n", "    ", 
          
          RowBox[{"Print", "[", 
           RowBox[{"\"\<      done in \>\"", ",", " ", 
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"AbsoluteTime", "[", "]"}], " ", "-", " ", "t0"}], ",",
               " ", "0.1"}], "]"}], ",", " ", "\"\< s\>\""}], "]"}], ";"}], 
         "\n", "\n", "    ", ",", " ", 
         RowBox[{"{", 
          RowBox[{"delta", ",", " ", "deltaList"}], "}"}]}], "\n", "  ", 
        "]"}], ";"}], "\n", "\n", "  ", ",", " ", 
      RowBox[{"{", 
       RowBox[{"L", ",", " ", "LList"}], "}"}]}], "\n", "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Print", "[", "\"\<Sweep complete.\>\"", "]"}], 
    ";"}]}]}]], "Input",
