         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"Eigensystem", "[", 
               RowBox[{"N", "[", "Ha", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "      ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", 
            RowBox[{"vecs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"vecs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
         "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"General", " ", 
           RowBox[{"case", ":", " ", 
