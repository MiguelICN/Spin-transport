Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Initial"}]}], " ", 
     RowBox[{"state", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Option", " ", 
     RowBox[{"A", ":", " ", 
      RowBox[{"Bell", " ", "state", " ", "on", " ", "spins"}]}]}], ",", " ", 
    RowBox[{"coherent", " ", "state", " ", "on", " ", "chain"}]}], 
   "          ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"bellState", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "0", ",", " ", "0", ",", " ", "1"}], "}"}], " ",
       "/", " ", 
      RowBox[{"Sqrt", "[", "2.", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoAB", "     ", "=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", " ", "bellState", ",", " ", 
       RowBox[{"Conjugate", "[", "bellState", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoChain", "  ", "=", " ", 
     RowBox[{"Dyad", "[", 
      RowBox[{"coherentstate", "[", 
       RowBox[{
        RowBox[{"QubitStateFromBlochVector", "[", 
         RowBox[{"0.", ",", " ", "0"}], "]"}], ",", " ", "L"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho0", "      ", "=", " ", 
     RowBox[{"BuildInitialStateCorrelated", "[", 
      RowBox[{"rhoAB", ",", " ", "rhoChain", ",", " ", "L"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"reference", " ", "for", " ", "spin", " ", "survival"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rhoABref", "  ", "=", " ", "rhoAB"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.988979143334938*^9, 3.988979155641691*^9}, {
  3.9889792088705177`*^9, 3.9889792100359497`*^9}, {3.9889793299879646`*^9, 
  3.988979336104376*^9}, {3.9889794355175304`*^9, 3.9889794958081875`*^9}, {
  3.9899400129123516`*^9, 3.989940028705677*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"8cd6571a-9d56-1847-aa34-9326d3b6050d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Option", " ", 
     RowBox[{"B", ":", " ", 
      RowBox[{"fully", " ", "factored", " ", "state"}]}]}], " ", "\[LongDash]",
     " ", 
    RowBox[{"swap", " ", "the", " ", "two", " ", "lines", " ", "above", " ", 
     RowBox[{"with", ":"}]}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"rho0", "     ", "=", " ", 
     RowBox[{"BuildInitialStateProduct", "[", 
      RowBox[{"rhoA", ",", " ", "rhoChain", ",", " ", "rhoB"}], "]"}]}], 
    ";"}], "      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"rhoABref", " ", "=", " ", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"rhoA", ",", " ", "rhoB"}], "]"}]}], ";"}], 
   "                        ", "*)"}]}]], "Input",
 CellLabel->"In[71]:=",ExpressionUUID->"cd575b59-221c-7640-ada6-8ff22eb81b32"]
