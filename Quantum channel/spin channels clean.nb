     RowBox[{"set", " ", "tMax"}], ",", " ", 
     RowBox[{"dt", " ", "upstream"}]}], " ", "*)"}], "\n", "\n", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{
     RowBox[{"allResults", " ", "=", " ", 
      RowBox[{"ParallelTable", "[", "\n", "  ", 
       RowBox[{
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rhoAB", ",", " ", "survGlobal", ",", " ", "obs"}], "}"}], 
          ",", "\n", "    ", 
          RowBox[{
           RowBox[{"rhoAB", "      ", "=", " ", 
            RowBox[{"Chop", "[", 
             RowBox[{"ComputeRhoAB", "[", 
              RowBox[{"Kmat", ",", " ", "dEflat", ",", " ", "t"}], "]"}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"survGlobal", " ", "=", " ", 
            RowBox[{"ComputeSurvivalGlobal", "[", 
             RowBox[{"Gflat", ",", " ", "dEflat", ",", " ", "t"}], "]"}]}], ";",
            "\n", "    ", 
           RowBox[{"obs", "        ", "=", " ", 
            RowBox[{"ComputeAllObservables", "[", 
             RowBox[{"rhoAB", ",", " ", "rhoABref"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
               
               RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], "\n", 
         "  ", "]"}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "  ", 
        RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "        ", 
       RowBox[{"(*", " ", 
        RowBox[{
        "already", " ", "distributed", " ", "in", " ", "Block", " ", "16"}], 
        " ", "*)"}], "\n", "]"}]}], ";"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.9889795977488537`*^9, 3.988979616842346*^9}, {
