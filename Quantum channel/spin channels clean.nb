                  "]"}]}], ";", "\n", "        ", 
                RowBox[{"obs", "        ", "=", " ", 
                 RowBox[{"ComputeAllObservables", "[", 
                  RowBox[{"rhoABt", ",", " ", "rhoABref"}], "]"}]}], ";", 
