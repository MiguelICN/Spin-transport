Cell["1 - Compiled partial traces (4x4 rhoAB, layout (q1,q2))", "Section",ExpressionUUID->"1ef2bf37-f185-8b46-a6f1-1dbff8caee5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"TraceOutA", ",", " ", "TraceOutB"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TraceOutB", " ", "=", " ", 
   RowBox[{"Compile", "[", "                  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"keep", " ", "spin", " ", "A"}], ",", " ", 
      RowBox[{"trace", " ", "out", " ", "B"}]}], " ", "*)"}], "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"\[Rho]", ",", " ", "_Complex", ",", " ", "2"}], "}"}], "}"}], 
     ",", "\n", "  ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", "  ", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "3"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
       "   ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "1"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ",", "  ", 
         RowBox[{
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"3", ",", "3"}], "]"}], "]"}], " ", "+", " ", 
          RowBox[{"\[Rho]", "[", 
           RowBox[{"[", 
            RowBox[{"4", ",", "4"}], "]"}], "]"}]}]}], "}"}]}], "}"}], ",", 
     "\n", "  ", 
     RowBox[{"CompilationTarget", " ", "->", " ", "$CompileTarget"}], ",", 
     " ", 
     RowBox[{"RuntimeOptions", " ", "->", " ", "\"\<Speed\>\""}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"TraceOutA", " ", "=", " ", 
   RowBox[{"Compile", "[", "                  ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"keep", " ", "spin", " ", "B"}], ",", " ", 
      RowBox[{"trace", " ", "out", " ", "A"}]}], " ", "*)"}], "\n", "  ", 
