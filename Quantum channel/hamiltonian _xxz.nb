Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "2.", " ", "Select", " ", "our", " ", "target", " ", "symmetry", " ", 
    "sector"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Nspins", "=", "L"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"targetK", " ", "=", " ", 
     RowBox[{"Nspins", "/", "2"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"Half", "-", 
     RowBox[{"filling", ":", " ", 
      RowBox[{
       RowBox[{"5", " ", "up"}], "-", "spins"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"targetP", " ", "=", " ", "1"}], ";"}], "          ", 
   RowBox[{"(*", " ", 
    RowBox[{"Even", " ", "Parity"}], " ", "*)"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "3.", " ", "Build", " ", "Projector", " ", "and", " ", "reduce", " ", 
     "the", " ", "Hamiltonian"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"V", " ", "=", " ", 
     RowBox[{"BuildSectorProjector", "[", 
      RowBox[{"L", ",", " ", "targetK", ",", " ", "targetP"}], "]"}]}], ";"}],
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Full Hilbert Space Dimension: \>\"", ",", " ", 
      RowBox[{"2", "^", "Nspins"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Target Sector Dimension: \>\"", ",", " ", 
      RowBox[{"Last", "[", 
       RowBox[{"Dimensions", "[", "V", "]"}], "]"}]}], "]"}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"H_sector", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"V", "^", "T"}], " ", ".", " ", "H", " ", ".", " ", "V"}], "  ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
        "Projects", " ", "H", " ", "into", " ", "the", " ", "symmetric", " ", 
         "sub"}], "-", "basis"}], ")"}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"HSector", " ", "=", " ", 
     RowBox[{
      RowBox[{"Transpose", "[", "V", "]"}], " ", ".", " ", "HT", " ", ".", 
      " ", "V"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "4.", " ", "Diagonalize", " ", "the", " ", "sector", " ", "and", " ", 
      "compute", " ", "the", " ", "r"}], "-", "statistic"}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"sectorEnergies", " ", "=", " ", 
     RowBox[{"Eigenvalues", "[", "HSector", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rStat", " ", "=", " ", 
     RowBox[{"LevelSpacingRatio", "[", "sectorEnergies", "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nMean Level Spacing Ratio <r> for (k=\>\"", ",", " ", 
      "targetK", ",", " ", "\"\<, P=\>\"", ",", " ", "targetP", ",", 
      " ", "\"\<): \>\"", ",", " ", "rStat"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"INTERPRETATION", " ", 
     RowBox[{"GUIDE", ":", "\n", "   ", 
      RowBox[{"<", "r", ">", " ", 
       RowBox[{
        RowBox[{"~", " ", "0.386"}], " ", "indicates", " ", "Integrability", " ", 
        RowBox[{"(", 
         RowBox[{"Poisson", " ", "statistics"}], ")"}]}], "\n", "   ", "<", 
       "r", ">", " ", 
       RowBox[{
        RowBox[{"~", " ", "0.530"}], " ", "indicates", " ", "Quantum", " ", 
        "Chaos", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"GOE", " ", "/", " ", "Wigner"}], "-", 
          RowBox[{"Dyson", " ", "statistics"}]}], ")"}]}]}]}]}], "\n", "*)"}],
    "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plot", " ", "the", " ", "density", " ", "of", " ", "states", " ", "to", " ",
      "see", " ", "the", " ", "spectrum"}], " ", "*)"}], "\n", 
   RowBox[{"Histogram", "[", 
    RowBox[{
    "sectorEnergies", ",", " ", "30", ",", " ", "\"\<PDF\>\"", ",", " ", "\n",
      "  ", 
     RowBox[{"PlotTheme", " ", "->", " ", "\"\<Detailed\>\""}], ",", " ", 
     "\n", "  ", 
     RowBox[{"FrameLabel", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Energy\>\"", ",", " ", "\"\<Density of States\>\""}], 
       "}"}]}], ",", " ", "\n", "  ", 
     RowBox[{"PlotLabel", " ", "->", " ", 
      RowBox[{"Row", "[", 
       RowBox[{"{", 
        RowBox[{"\"\<Spectrum in Sector k=\>\"", ",", " ", "targetK", ",", 
