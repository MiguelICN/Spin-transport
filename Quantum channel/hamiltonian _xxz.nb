  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "\!\(\*StyleBox[RowBox[{\"Unfold\", \"[\", StyleBox[\"spectrum\", \
\"TI\"], \"]\"}], \"MR\"]\) returns an Association containing the unfolded \!\
\(\*StyleBox[\"spectrum\", \"TI\"]\) and smoothed density functions \
calculated via Kernel Density Estimation (KDE).\n\
\!\(\*StyleBox[RowBox[{\"Unfold\", \"[\", StyleBox[\"spectrum\", \"TI\"], \",\
\", StyleBox[\"opts\", \"TI\"], \"]\"}], \"MR\"]\) allows specifying options \
for the kernel distribution.\n\!\(\)\n\!\(\)**Output Association Keys**\n\!\(\
\)* \"UnfoldedLevels\": List of unfolded eigenvalues (mean spacing = 1).\n\
\!\(\)* \"SmoothCDF\": Pure function representing the cumulative mean level \
number N(E).\n\!\(\)* \"SmoothPDF\": Pure function representing the mean \
level density \[Rho](E).\n\!\(\)* \"Bandwidth\": The bandwidth parameter used \
in the KDE.\n\!\(\)* \"OriginalLevels\": The sorted input spectrum.\n\!\(\)\n\
\!\(\)**Options**\n\!\(\)* \"Bandwidth\": (Default: Automatic) Controls the \
smoothing scale. Set a Real number to manually tune the separation between \
secular variation and fluctuations.\n\!\(\)* \"Kernel\": (Default: \"Gaussian\
\") Specifies the kernel function type (e.g., \"Epanechnikov\", \"Rectangular\
\").", "Documentation" -> None, "OwnValues" -> None, "UpValues" -> None, 
    "DownValues" -> 
    Information`InformationValueForm[DownValues, QMB`Unfold, {QMB`Unfold[
         Pattern[QMB`Private`spectrum, 
          Blank[List]], 
         Pattern[QMB`Private`opts, 
          OptionsPattern[]]] :> 
       Module[{QMB`Private`sortedSpectrum, QMB`Private`nLevels, 
          QMB`Private`skd, QMB`Private`unfoldedLevels, 
          QMB`Private`smoothCDFFunc, QMB`Private`smoothPDFFunc, 
          QMB`Private`bwParam, QMB`Private`kernelType}, 
         QMB`Private`sortedSpectrum = Sort[
            Select[QMB`Private`spectrum, NumericQ]]; 
         QMB`Private`nLevels = Length[QMB`Private`sortedSpectrum]; 
         If[QMB`Private`nLevels < 3, Message[
             MessageName[QMB`Unfold, "notEnoughLevels"], QMB`Private`nLevels]; 
           Return[$Failed]]; QMB`Private`bwParam = OptionValue["Bandwidth"]; 
         QMB`Private`kernelType = OptionValue["Kernel"]; 
         QMB`Private`skd = 
          SmoothKernelDistribution[
           QMB`Private`sortedSpectrum, QMB`Private`bwParam, 
            QMB`Private`kernelType]; 
         QMB`Private`unfoldedLevels = 
          QMB`Private`nLevels 
           CDF[QMB`Private`skd, QMB`Private`sortedSpectrum]; 
         With[{QMB`Private`distObject = QMB`Private`skd, QMB`Private`n = 
            QMB`Private`nLevels}, 
           QMB`Private`smoothCDFFunc = 
            Function[
             QMB`Private`e, QMB`Private`n 
              CDF[QMB`Private`distObject, QMB`Private`e]]; 
           QMB`Private`smoothPDFFunc = 
            Function[
             QMB`Private`e, QMB`Private`n 
              PDF[QMB`Private`distObject, QMB`Private`e]]; Null]; <|
          "UnfoldedLevels" -> QMB`Private`unfoldedLevels, "SmoothCDF" -> 
           QMB`Private`smoothCDFFunc, "SmoothPDF" -> 
           QMB`Private`smoothPDFFunc, "Bandwidth" -> 
           QMB`Private`skd["Bandwidth"], "OriginalLevels" -> 
           QMB`Private`sortedSpectrum|>]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {"Bandwidth" -> Automatic, "Kernel" -> "Gaussian"}, 
    "Attributes" -> {}, "FullName" -> "QMB`Unfold"|>, False]]], "Output",
 CellChangeTimes->{3.9925148849475727`*^9, 3.992517223429428*^9, 
  3.9925187494697895`*^9, 3.9925193423913746`*^9, 3.9925264077862434`*^9, 
