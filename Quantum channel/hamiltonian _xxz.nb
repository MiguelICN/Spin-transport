Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"MODULE", ":", " ", 
    RowBox[{"Symmetry", " ", "Sector", " ", "Projector", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"U", 
        RowBox[{"(", "1", ")"}]}], " ", "+", " ", "Parity"}], ")"}]}]}], 
   "                ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "BuildSectorProjector", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BuildSectorProjector", "[", 
      RowBox[{"L_Integer", ",", " ", "k_Integer", ",", " ", "p_Integer"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "Nspins", ",", " ", "dim", ",", " ", "basisK", ",", " ", "Vrules", ",",
          " ", "col", ",", " ", "state", ",", " ", "revState", ",", " ", 
         "row1", ",", " ", "row2"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"Nspins", " ", "=", " ", "L"}], ";", "\n", "  ", 
        RowBox[{"dim", " ", "=", " ", 
         RowBox[{"2", "^", "Nspins"}]}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
          RowBox[{
          "Generate", " ", "all", " ", "integers", " ", "with", " ", 
           "exactly", " ", "k", " ", "up"}], "-", "spins"}], " ", "*)"}], 
        "\n", "  ", 
        RowBox[{"basisK", " ", "=", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"FromDigits", "[", 
             RowBox[{"#", ",", " ", "2"}], "]"}], " ", "&"}], " ", "/@", " ", 
           RowBox[{"Permutations", "[", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", " ", "k"}], "]"}], ",", " ", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"Nspins", " ", "-", " ", "k"}]}], "]"}]}], "]"}], 
            "]"}]}], "]"}]}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"Vrules", " ", "=", " ", 
         RowBox[{"{", "}"}]}], ";", "\n", "  ", 
        RowBox[{"col", " ", "=", " ", "1"}], ";", "\n", "  ", "\n", "  ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"state", " ", "=", " ", 
            RowBox[{"basisK", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"Reflect", " ", "the", " ", "state", " ", "bit"}], "-", 
             "by", "-", "bit"}], " ", "*)"}], "\n", "    ", 
           RowBox[{"revState", " ", "=", " ", 
            RowBox[{"FromDigits", "[", 
             RowBox[{
              RowBox[{"Reverse", "[", 
               RowBox[{"IntegerDigits", "[", 
                RowBox[{"state", ",", " ", "2", ",", " ", "Nspins"}], "]"}], 
               "]"}], ",", " ", "2"}], "]"}]}], ";", "\n", "    ", "\n", 
           "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{
             "Match", " ", "the", " ", "row", " ", "indexing", " ", "of", " ",
               "our", " ", "Hamiltonian", " ", 
              RowBox[{"builder", ":", " ", "row"}]}], " ", "=", " ", 
             RowBox[{"dim", " ", "-", " ", "state"}]}], " ", "*)"}], "\n", 
           "    ", 
           RowBox[{"row1", " ", "=", " ", 
            RowBox[{"dim", " ", "-", " ", "state"}]}], ";", "\n", "    ", 
           RowBox[{"row2", " ", "=", " ", 
            RowBox[{"dim", " ", "-", " ", "revState"}]}], ";", "\n", "    ", 
           "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"state", " ", "<", " ", "revState"}], ",", "\n", 
             "      ", 
             RowBox[{"(*", " ", 
              RowBox[{"Form", " ", "the", " ", 
               RowBox[{"symmetric", "/", "antisymmetric"}], " ", "pair"}], 
              " ", "*)"}], "\n", "      ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"Vrules", ",", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"row1", ",", " ", "col"}], "}"}], " ", "->", " ", 
                 RowBox[{"1.", " ", "/", " ", 
                  RowBox[{"Sqrt", "[", "2.", "]"}]}]}]}], "]"}], ";", "\n", 
              "      ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"Vrules", ",", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"row2", ",", " ", "col"}], "}"}], " ", "->", " ", 
                 RowBox[{"p", " ", "/", " ", 
                  RowBox[{"Sqrt", "[", "2.", "]"}]}]}]}], "]"}], ";", "\n", 
              "      ", 
              RowBox[{"col", "++"}], ";"}]}], "\n", "    ", "]"}], ";", "\n", 
           "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"state", " ", "==", " ", "revState"}], " ", "&&", " ", 
              RowBox[{"p", " ", "==", " ", "1"}]}], ",", "\n", "      ", 
             RowBox[{"(*", " ", 
              RowBox[{
               RowBox[{"State", " ", "is", " ", "its", " ", "own", " ", 
                RowBox[{"reflection", ".", " ", "It"}], " ", "only", " ", 
                "exists", " ", "in", " ", "the", " ", "Parity"}], " ", "+", 
               RowBox[{"1", " ", "sector"}]}], " ", "*)"}], "\n", "      ", 
             RowBox[{
              RowBox[{"AppendTo", "[", 
               RowBox[{"Vrules", ",", " ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"row1", ",", " ", "col"}], "}"}], " ", "->", " ", 
                 "1."}]}], "]"}], ";", "\n", "      ", 
              RowBox[{"col", "++"}], ";"}]}], "\n", "    ", "]"}], ";"}], 
          "\n", "    ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"If", " ", "state"}], " ", ">", " ", "revState"}], ",", 
            " ", 
            RowBox[{
            "we", " ", "already", " ", "counted", " ", "it", " ", "when", " ",
              "i", " ", "was", " ", "at", " ", "revState"}]}], " ", "*)"}], 
          "\n", "  ", ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", 
            RowBox[{"Length", "[", "basisK", "]"}]}], "}"}]}], "]"}], ";", 
        "\n", "  ", "\n", "  ", 
        RowBox[{"(*", " ", 
         RowBox[{
         "Return", " ", "a", " ", "Sparse", " ", "Matrix", " ", "of", " ", 
          "size", " ", 
          RowBox[{"(", 
           RowBox[{"Full", " ", "Dimension"}], ")"}], " ", "x", " ", 
          RowBox[{"(", 
           RowBox[{"Sector", " ", "Dimension"}], ")"}]}], " ", "*)"}], "\n", 
        "  ", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"Vrules", ",", " ", 
          RowBox[{"{", 
           RowBox[{"dim", ",", " ", 
            RowBox[{"col", " ", "-", " ", "1"}]}], "}"}]}], "]"}]}]}], "\n", 
      "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], " ", "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"MODULE", ":", " ", 
     RowBox[{"Mean", " ", "Level", " ", "Spacing", " ", "Ratio", " ", 
      RowBox[{"(", 
       RowBox[{"r", "-", "statistic"}], ")"}]}]}], "                   ", 
    "*)"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
       "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}],
      "="}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "LevelSpacingRatio", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"LevelSpacingRatio", "[", "energies_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"spacings", ",", " ", "ratios"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"spacings", " ", "=", " ", 
         RowBox[{"Differences", "[", 
          RowBox[{"Sort", "[", "energies", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"spacings", " ", "=", " ", 
         RowBox[{"Select", "[", 
          RowBox[{"spacings", ",", " ", 
           RowBox[{
            RowBox[{"#", " ", ">", " ", "1.*^-10"}], " ", "&"}]}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "spacings", "]"}], " ", "<", " ", "2"}], ",",
           " ", 
          RowBox[{"Return", "[", 
           RowBox[{"Missing", "[", "\"\<NotEnoughLevels\>\"", "]"}], "]"}]}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"ratios", " ", "=", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#1", ",", " ", "#2"}], "]"}], " ", "/", " ", 
             RowBox[{"Max", "[", 
              RowBox[{"#1", ",", " ", "#2"}], "]"}]}], " ", "&"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Drop", "[", 
              RowBox[{"spacings", ",", " ", 
               RowBox[{"-", "1"}]}], "]"}], ",", " ", 
             RowBox[{"Rest", "[", "spacings", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"Mean", "[", "ratios", "]"}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
