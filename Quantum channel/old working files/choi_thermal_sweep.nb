arxiv:2512.11030 [Eq. (11).]", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, QMB`ManyBody`XXZwLocalDefectHamiltonian, {
      QMB`ManyBody`XXZwLocalDefectHamiltonian[
         PatternTest[
          Pattern[QMB`ManyBody`SpinChains`Private`Jxy, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[QMB`ManyBody`SpinChains`Private`Jz, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[QMB`ManyBody`SpinChains`Private`Omega, 
           Blank[]], NumericQ], 
         PatternTest[
          Pattern[QMB`ManyBody`SpinChains`Private`EpsD, 
           Blank[]], NumericQ], 
         Pattern[QMB`ManyBody`SpinChains`Private`NumSites, 
          Blank[Integer]], 
         Pattern[QMB`ManyBody`SpinChains`Private`DSite, 
          Blank[Integer]], 
         Pattern[QMB`ManyBody`SpinChains`Private`Opts, 
          OptionsPattern[]]] :> 
       Module[{QMB`ManyBody`SpinChains`Private`bc, 
          QMB`ManyBody`SpinChains`Private`mag, 
          QMB`ManyBody`SpinChains`Private`DefectField, 
          QMB`ManyBody`SpinChains`Private`HamFull, 
          QMB`ManyBody`SpinChains`Private`SectorIndices}, 
         QMB`ManyBody`SpinChains`Private`bc = 
          OptionValue[QMB`ManyBody`BoundaryConditions]; 
         QMB`ManyBody`SpinChains`Private`mag = 
          OptionValue[QMB`ManyBody`MagnonSector]; If[
           Not[
            QMB`ManyBody`SpinChains`Private`ValidateHamiltonianOptions[
            QMB`ManyBody`SpinChains`Private`NumSites, 
             QMB`ManyBody`SpinChains`Private`bc, "All", "None", 
             QMB`ManyBody`SpinChains`Private`mag]], 
           Return[$Failed]]; 
         QMB`ManyBody`SpinChains`Private`DefectField = Normal[
            
            SparseArray[{
             QMB`ManyBody`SpinChains`Private`DSite -> 
              QMB`ManyBody`SpinChains`Private`EpsD}, 
             QMB`ManyBody`SpinChains`Private`NumSites]]; 
         QMB`ManyBody`SpinChains`Private`HamFull = (1./4) 
            QMB`ManyBody`SpinChains`Private`Jxy 
            QMB`ManyBody`SpinChains`Private`TwoSiteSum[
             1, QMB`ManyBody`SpinChains`Private`bc, 
              QMB`ManyBody`SpinChains`Private`NumSites] + (1./4) 
            QMB`ManyBody`SpinChains`Private`Jxy 
            QMB`ManyBody`SpinChains`Private`TwoSiteSum[
             2, QMB`ManyBody`SpinChains`Private`bc, 
              QMB`ManyBody`SpinChains`Private`NumSites] + (1./4) 
            QMB`ManyBody`SpinChains`Private`Jz 
            QMB`ManyBody`SpinChains`Private`TwoSiteSum[
             3, QMB`ManyBody`SpinChains`Private`bc, 
              QMB`ManyBody`SpinChains`Private`NumSites] + (1./2) 
            QMB`ManyBody`SpinChains`Private`Omega 
            QMB`ManyBody`SpinChains`Private`OneSiteSum[
              ConstantArray[1., QMB`ManyBody`SpinChains`Private`NumSites], 
              3] + (1./2) 
            QMB`ManyBody`SpinChains`Private`OneSiteSum[
             QMB`ManyBody`SpinChains`Private`DefectField, 3]; 
         If[QMB`ManyBody`SpinChains`Private`mag =!= "All", 
           QMB`ManyBody`SpinChains`Private`SectorIndices = 
            QMB`ManyBody`SpinChains`Private`MagnonSectorIndices[
             QMB`ManyBody`SpinChains`Private`NumSites, 
              QMB`ManyBody`SpinChains`Private`mag]; Return[
             Part[
             QMB`ManyBody`SpinChains`Private`HamFull, 
              QMB`ManyBody`SpinChains`Private`SectorIndices, 
              QMB`ManyBody`SpinChains`Private`SectorIndices]]]; 
         QMB`ManyBody`SpinChains`Private`HamFull]}], "SubValues" -> None, 
