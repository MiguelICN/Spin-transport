    "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
      "===", "===", "===", "===", "===", "===", "===", "===", "===", "==="}], 
    "="}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]x", "  ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"PauliMatrix", "[", "1", "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]y", "  ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"PauliMatrix", "[", "2", "]"}], "]"}]}], ";"}], "\n", 
