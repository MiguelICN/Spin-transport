     RowBox[{"{", 
      RowBox[{
       RowBox[{"P", "=", 
        RowBox[{"PackC", "@", 
         RowBox[{"Transpose", "[", "allvecs", "]"}]}]}], ",", 
       RowBox[{"Pinv", "=", 
        RowBox[{"PackC", "@", 
         RowBox[{"Conjugate", "[", "allvecs", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"Function", "[", 
