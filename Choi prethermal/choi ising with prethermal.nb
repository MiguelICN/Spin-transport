Cell[BoxData[{
 RowBox[{
  RowBox[{"plot", "=", 
   RowBox[{"ListLogLogPlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tlist", ",", "purity"}], "}"}], "]"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Detailed\>\""}], ",", 
     RowBox[{"PlotLabel", "->", 
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<L = \>\"", "<>", 
         RowBox[{"ToString", "[", "L", "]"}], "<>", "\"\<, La = \>\"", "<>", 
         RowBox[{"ToString", "[", "La", "]"}], "<>", "\"\<, J = \>\"", "<>", 
         RowBox[{"ToString", "[", "J", "]"}], "<>", "\"\<, hz = \>\"", "<>", 
         RowBox[{"ToString", "[", "g", "]"}], 
         "<>", "\"\<, RPS \!\(\*SubscriptBox[\(\[Psi]\), \(E\)]\)\>\""}], ",",
         "30", ",", "Black"}], "]"}]}], ",", 
