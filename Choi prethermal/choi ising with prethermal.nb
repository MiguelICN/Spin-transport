          RowBox[{"(", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{
              RowBox[{"Transpose", "[", "P", "]"}], "*", "ph"}], "]"}], ".", 
            "Pinv"}], ")"}]}]}], "]"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
