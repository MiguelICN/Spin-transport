             RowBox[{"MatrixPartialTrace", "[", 
              RowBox[{"X", ",", "3", ",", 
               RowBox[{"{", 
                RowBox[{"m", ",", "m", ",", "n"}], "}"}]}], "]"}]}]}]}]}], 
         "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
