Cell[CellGroupData[{

Cell["Prethermalization", "Title",
 CellChangeTimes->{{3.974270679439684*^9, 
  3.974270683850176*^9}},ExpressionUUID->"751feadf-a2e9-4548-8020-\
029411fafebe"],

Cell[CellGroupData[{

Cell["Improved code c", "Chapter",
 CellChangeTimes->{{3.971507137001164*^9, 3.971507140697521*^9}, {
  3.971556652017054*^9, 3.971556656784602*^9}, {3.971557111289875*^9, 
  3.971557111815671*^9}, {3.971559574093359*^9, 
  3.971559574140647*^9}},ExpressionUUID->"101bfe86-58dd-4b5f-bb87-\
1ffa8a1008d6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Needs", "[", "\"\<Developer`\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "PackC", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"PackC", "[", "x_", "]"}], ":=", 
    RowBox[{"Developer`ToPackedArray", "[", "x", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"1", ")"}], " ", "Environment", " ", "state", " ", "from", " ", 
     "a", " ", "global", " ", "pure", " ", "state"}], "|", 
    RowBox[{"\[Psi]\:27e9", " ", "on", " ", 
     RowBox[{"S", "\[CircleTimes]", "E"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ClearAll", "[", "EnvStateFromPsi", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EnvStateFromPsi", "[", 
     RowBox[{"psi_", ",", 
      RowBox[{"m_Integer", "?", "Positive"}], ",", 
      RowBox[{"n_Integer", "?", "Positive"}]}], "]"}], ":=", 
    RowBox[{"PackC", "@", 
     RowBox[{"Chop", "@", 
      RowBox[{"MatrixPartialTrace", "[", 
       RowBox[{
        RowBox[{"Dyad", "[", "psi", "]"}], ",", "1", ",", 
        RowBox[{"{", 
         RowBox[{"m", ",", "n"}], "}"}]}], "]"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", ")"}], " ", "Fast", " ", "spectral", " ", "unitary", " ", 
      RowBox[{"builder", ":", 
       RowBox[{"U", 
        RowBox[{"(", "t", ")"}]}]}]}], "=", 
     RowBox[{
      RowBox[{"V", ".", "diag"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"e", "^", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "i"}], " ", "\[Lambda]", " ", "t"}], "}"}]}], ")"}], ".", 
       RowBox[{"V", "^", "\[Dagger]"}]}]}]}], ",", 
    RowBox[{"implemented", " ", "via", " ", "column", " ", "scaling", " ", 
     RowBox[{"(", 
