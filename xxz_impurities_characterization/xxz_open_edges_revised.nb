                    RowBox[{
                    "full", " ", "eigenvectors", " ", "are", " ", "computed", 
                    " ", "at", " ", "each", " ", 
                    RowBox[{"point", "."}]}]}], " ", "*)"}], "\n", 
                    RowBox[{
                    RowBox[{"sweepParallel", "[", 
                    RowBox[{"grid_", ",", "p_", ",", "tol_", ",", "cfg_"}], 
                    "]"}], " ", ":=", " ", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "n", "}"}], ",", "\n", " ", 
                    RowBox[{
