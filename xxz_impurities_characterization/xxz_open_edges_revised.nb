Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoPlots", " ", "=", " ", 
   RowBox[{"densityPanels", "[", 
    RowBox[{"evoData", ",", "evoUsed", ",", "evoTimeUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
