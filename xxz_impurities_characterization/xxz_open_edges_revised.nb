       "dynValidationToleranceUsed"}], ",", "\n", "  ", 
      RowBox[{"\"\<SweepSeconds\>\"", "->", "dynSweepSeconds"}], ",", 
      RowBox[{"\"\<Results\>\"", "->", "dynResults"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dynDir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
    "\n", " ", 
    RowBox[{"StringRiffle", "[", 
     RowBox[{
      RowBox[{"{", "\n", "  ", 
       RowBox[{
        RowBox[{"\"\<Model: \>\"", "<>", 
