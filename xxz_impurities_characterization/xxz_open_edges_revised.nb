Cell["6.3 State of the middle spins", "Subsection",ExpressionUUID->"a12e1921-8050-ef49-89a6-5b2038095eb3"],

Cell["\<\
Dimension 2^(L\[Minus]2), physical order {2,\[Ellipsis],L\[Minus]1}. \
neel[n,0] starts with up on physical site 2; neel[n,1] starts with down. A \
middle helix starts its phase at physical site 2.\
\>", "Text",ExpressionUUID->"a2b3b903-e8c6-804e-89f2-e32a5bd430ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
