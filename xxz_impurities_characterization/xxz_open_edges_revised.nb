    ";"}], "\n", 
   RowBox[{
    RowBox[{"dynPlotSpecs", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"dynPlotSpecs", ",", "\n", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "  ", 
