Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Full", " ", "open"}], "-", 
    RowBox[{"chain", " ", "XXZ", " ", 
     RowBox[{"Hamiltonian", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"xxzH", "[", "p_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"p", "[", "\"\<Delta\>\"", "]"}]}], ",", "h", ",", "x", ",", 
        "y", ",", "z"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "l", "]"}], " ", "&&", " ", 
          RowBox[{"l", ">=", "3"}]}], 
         ",", "\"\<L must be an integer >=3.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"p", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<h\>\"", 
               ",", "\"\<bLeft\>\"", ",", "\"\<bRight\>\""}], "}"}]}], "]"}], 
           ",", "realQ"}], "]"}], ",", "\n", 
         "  ", "\"\<J, Delta and fields must be finite real numbers.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", " ", 
       RowBox[{"h", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "^", "l"}], ",", 
            RowBox[{"2", "^", "l"}]}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"h", "+=", 
          RowBox[{
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}], "+", 
             RowBox[{"d", " ", 
              RowBox[{"bondOp", "[", 
               RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}]}]}], 
            ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"h", "+=", 
          RowBox[{
           RowBox[{"p", "[", "\"\<h\>\"", "]"}], " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"z", ",", "k", ",", "l"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "l"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"h", "+", 
         RowBox[{
          RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}], " ", 
          RowBox[{"siteOp", "[", 
           RowBox[{"z", ",", "1", ",", "l"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"p", "[", "\"\<bRight\>\"", "]"}], " ", 
          RowBox[{"siteOp", "[", 
           RowBox[{"z", ",", "l", ",", "l"}], " ", "]"}]}]}], "]"}]}]}], "\n",
      "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"80638e3d-17da-4848-aad8-1e53215f63e3"]
}, Closed]],

