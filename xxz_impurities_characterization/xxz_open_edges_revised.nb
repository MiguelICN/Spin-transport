Cell["4.7 Export sweep plots and data", "Subsection",ExpressionUUID->"2b096067-fe0e-3d41-b5bf-a1f3c96d19e8"],

Cell[BoxData[
 RowBox[{"sweepDir", " ", "=", " ", 
  RowBox[{"newFolder", "[", 
   RowBox[{"outputRoot", ",", 
    RowBox[{"sweepLabel", "<>", "\"\<_L\>\"", "<>", 
     RowBox[{"ToString", "[", 
      RowBox[{"sweepUsed", "[", 
