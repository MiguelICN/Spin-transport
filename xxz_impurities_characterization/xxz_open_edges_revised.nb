Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Batches", " ", "limit", " ", "memory"}], ";", " ", 
    RowBox[{"each", " ", "worker", " ", "gets", " ", "one", " ", "engine", " ", 
     RowBox[{"copy", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"evolveChunks", "[", 
    RowBox[{
    "times_", ",", "engine_", ",", "rho0_", ",", "tol_", ",", "cfg_"}], "]"}],
    " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "n", ",", "batch", ",", "room", ",", "chunks", ",", "packets", ",", 
       "records", ",", "reference", ",", "error"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
      RowBox[{"room", "=", 
       RowBox[{
        RowBox[{"cfg", "[", "\"\<MemoryBudgetGB\>\"", "]"}], " ", 
        RowBox[{"1024.", "^", "3"}]}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"4.", " ", "n", " ", 
           RowBox[{"ByteCount", "[", "engine", "]"}]}], ">", "room"}]}], ",", 
        "\n", "  ", 
        RowBox[{
         RowBox[{
         "Print", 
          "[", "\"\<Engine copies exceed the memory budget; using serial \
batches.\>\"", "]"}], ";", 
         RowBox[{"n", "=", "0"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"batch", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ",", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"room", "/", "\n", "  ", 
               RowBox[{"(", 
                RowBox[{"4.", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"1", ",", "n"}], "]"}], " ", "16", " ", 
                 RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], " ", 
                 RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], ")"}]}], 
              RowBox[{"]", "]"}]}], "]"}], ";", "\n", " ", 
            RowBox[{"chunks", "=", 
             RowBox[{"Partition", "[", 
              RowBox[{"times", ",", 
               RowBox[{"UpTo", "[", 
                RowBox[{
                 RowBox[{"batch", 
                  RowBox[{"]", "]"}]}], ";", "\n", " ", 
                 RowBox[{"Print", "[", 
                  RowBox[{"\"\<Time batches: \>\"", ",", 
                   RowBox[{"Length", "[", "chunks", "]"}], 
                   ",", "\"\<; maximum points per batch: \>\"", ",", 
                   "batch"}], "]"}], ";", "\n", " ", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"n", ">=", "2"}], ",", "\n", "  ", 
                   RowBox[{
                    RowBox[{"sharedEngine", "=", "engine"}], ";", 
                    RowBox[{"sharedRho0", "=", "rho0"}], ";", 
                    RowBox[{"sharedTolerance", "=", "tol"}], ";", "\n", "  ", 
                    RowBox[{"DistributeDefinitions", "[", 
                    RowBox[{
                    "timeChunk", ",", "sharedEngine", ",", "sharedRho0", ",", 
                    "sharedTolerance"}], "]"}], ";", "\n", "  ", 
                    RowBox[{"packets", "=", 
                    RowBox[{"ParallelMap", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"timeChunk", "[", 
                    RowBox[{
                    "#", ",", "sharedEngine", ",", "sharedRho0", ",", 
                    "sharedTolerance"}], "]"}], "&"}], ",", "\n", "   ", 
                    "chunks", ",", 
                    RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], 
                    "]"}]}], ";", "\n", "  ", 
                    RowBox[{"ParallelEvaluate", "[", 
                    RowBox[{
                    RowBox[{"Clear", "[", 
                    RowBox[{"sharedEngine", ",", "sharedRho0", ",", 
                    RowBox[{
                    RowBox[{"sharedTolerance", 
                    RowBox[{"]", "]"}]}], ";", "\n", "  ", 
                    RowBox[{"Clear", "[", 
                    RowBox[{
                    "sharedEngine", ",", "sharedRho0", ",", 
                    "sharedTolerance"}], "]"}]}], ",", "\n", "  ", 
                    RowBox[{"packets", "=", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"timeChunk", "[", 
                    RowBox[{"#", ",", "engine", ",", "rho0", ",", "tol"}], 
                    "]"}], "&"}], " ", "/@", " ", "chunks"}]}]}], "]"}], ";", 
                    "\n", " ", 
                    RowBox[{"check", "[", 
                    RowBox[{
                    RowBox[{"AllTrue", "[", 
                    RowBox[{"packets", ",", "ListQ"}], "]"}], 
                    ",", "\"\<A time batch failed.\>\""}], "]"}], ";", "\n", 
                    " ", 
                    RowBox[{"records", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"packets", ",", "1"}], "]"}]}], ";", 
                    RowBox[{"check", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], "===", 
                    "times"}], ",", "\"\<Time ordering failed.\>\""}], "]"}], 
                    ";", "\n", " ", 
                    RowBox[{"reference", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{"observables", "[", 
                    RowBox[{"t", ",", 
                    RowBox[{
                    RowBox[{"partitionFactor", "[", 
                    RowBox[{
                    RowBox[{"evolve", "[", 
                    RowBox[{"t", ",", "engine"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", 
                    RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
                    RowBox[{"engine", "[", 
                    RowBox[{
                    RowBox[{"\"\<L\>\"", 
                    RowBox[{"]", "]"}]}], ",", "rho0"}], "]"}], ",", "\n", 
                    "  ", 
                    RowBox[{"{", 
                    RowBox[{"t", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", "[", "times", "]"}], ",", 
                    RowBox[{"Last", "[", "times", "]"}]}], "}"}]}], "}"}]}], 
                    "]"}], ";", "\n", " ", 
                    RowBox[{"error", "=", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"MapThread", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#1", "[", "\"\<RhoAB\>\"", "]"}], "-", 
                    RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], 
                    ",", "\"\<Frobenius\>\""}], "]"}], "&"}], ",", "\n", "  ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"First", "[", "records", "]"}], ",", 
                    RowBox[{"Last", "[", "records", "]"}]}], "}"}], ",", 
                    "reference"}], "}"}], 
                    RowBox[{"]", "]"}]}], ";", "\n", " ", 
                    RowBox[{"check", "[", 
                    RowBox[{
                    RowBox[{"error", "<", "tol"}], 
                    ",", "\"\<Batched/single-time endpoint comparison failed.\
\>\""}], "]"}], ";", "records"}]}], "\n", "]"}], 
                    ";"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]], "Input",
