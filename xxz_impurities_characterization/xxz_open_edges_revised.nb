     RowBox[{"neel", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
      "]"}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", "\[IndentingNewLine]", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"helix", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
    RowBox[{"or", " ", "your", " ", 
     RowBox[{"vector", "/", "density"}], " ", 
     RowBox[{"matrix", "."}]}]}], " ", "*)"}]}]], "Input",
