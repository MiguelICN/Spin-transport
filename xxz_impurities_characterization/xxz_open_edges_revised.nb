 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dynDir", ",", "\"\<delta_dynamics.wxf\>\""}], "}"}], "]"}], ",",
     "\n", " ", 
    RowBox[{"<|", 
