Cell["5.3 Diagonalize this Hamiltonian", "Subsection",ExpressionUUID->"2758f97b-637f-c44f-bb80-d36b0e2a60e2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoUsed", " ", "=", " ", "evoModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"evoEDSeconds", ",", "evoED"}], "}"}], " ", "=", " ", 
  RowBox[{"AbsoluteTiming", "[", 
   RowBox[{"sectorED", "[", 
    RowBox[{"evoUsed", ",", 
     RowBox[{
      RowBox[{"edTolerance", 
