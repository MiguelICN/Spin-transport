Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Reuse", " ", "existing", " ", "kernels"}], ";", " ", 
    RowBox[{"no", " ", "kernels", " ", "are", " ", 
     RowBox[{"closed", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"startKernels", "[", "cfg_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", "\n", " ", 
     RowBox[{"If", "[", 
      RowBox[{"!", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"cfg", "[", 
         RowBox[{
          RowBox[{"\"\<Enabled\>\"", 
           RowBox[{"]", "]"}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{"0", 
             RowBox[{"]", "]"}]}], ";", "\n", " ", 
            RowBox[{"n", "=", 
             RowBox[{"Length", "[", 
              RowBox[{"Kernels", "[", 
               RowBox[{
                RowBox[{"]", "]"}], ";", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"n", "<", 
                   RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
                  RowBox[{"Quiet", "[", 
                   RowBox[{
                    RowBox[{"LaunchKernels", "[", 
                    RowBox[{
                    RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "-", 
                    RowBox[{"n", 
                    RowBox[{"]", "]"}]}]}], "]"}], ";", "\n", " ", 
                    RowBox[{"n", "=", 
                    RowBox[{"Length", "[", 
                    RowBox[{
                    RowBox[{"Kernels", "[", 
                    RowBox[{
                    RowBox[{"]", "]"}], ";", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"\<Available parallel kernels: \>\"", ",", 
                    "n"}], "]"}], ";", "n"}], "\n", "]"}], ";", "\n", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{"Independent", " ", "Delta", " ", "points"}], ";",
