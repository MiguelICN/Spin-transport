Cell[CellGroupData[{

Cell["4. Delta sweep: independent inputs and execution", "Section",ExpressionUUID->"0e0b9497-a51a-ed43-89f5-b298a4e5677c"],

Cell[CellGroupData[{

Cell["4.1 Choose sweep parameters", "Subsection",ExpressionUUID->"7e141953-bb72-084d-8bb9-118c0632cecd"],

Cell["\<\
These parameters apply only to the sweep. Evolution parameters are entered \
separately in section 5.\
\>", "Text",ExpressionUUID->"f6ecf021-855e-e547-bb60-e8f158e49547"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepModel", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaGrid", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "5"}], ",", "5", ",", 
     RowBox[{"1", "/", "100"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepLabel", " ", "=", " ", "\"\<sweep01\>\""}], ";"}]}], "Input",
 CellLabel->"",ExpressionUUID->"4c349efe-5f8a-7943-bea0-fe6934a40df9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Diagonalize and calculate eigenstate entropies", "Subsection",ExpressionUUID->"3d2ce86c-dfd9-0c4f-8aba-4851231d9fec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepUsed", " ", "=", " ", "sweepModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaUsed", " ", "=", " ", "deltaGrid"}], ";"}], "\n", 
 RowBox[{"check", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Length", "[", "deltaUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{"deltaUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
   RowBox[{"And", "@@", 
    RowBox[{"Thread", "[", 
     RowBox[{
      RowBox[{"Differences", "[", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{"deltaUsed", 
           RowBox[{"]", "]"}]}], ">", "0"}], "]"}], 
        ",", "\"\<Delta grid must be strictly increasing.\>\""}], "]"}], ";", 
      "\n", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sweepSeconds", ",", "sweepData"}], "}"}], " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "\n", " ", 
        RowBox[{"sweepParallel", "[", 
         RowBox[{"deltaUsed", ",", "sweepUsed", ",", "edTolerance", ",", 
          RowBox[{
           RowBox[{"parallel", 
            RowBox[{"]", "]"}]}], ";", "\n", 
           RowBox[{"Print", "[", 
            RowBox[{"\"\<Sweep seconds: \>\"", ",", "sweepSeconds"}], "]"}], 
           ";"}]}]}]}]}]}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"41dc8362-8133-b546-9e24-873acb4d4e78"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 Identify matching sectors", "Subsection",ExpressionUUID->"9b71091f-a06f-8b4c-a5b9-61924a70e86c"],

Cell[BoxData[
 RowBox[{"sweepKeys", " ", "=", " ", 
  RowBox[{"Keys", "[", 
   RowBox[{"First", "[", 
    RowBox[{
     RowBox[{"sweepData", 
      RowBox[{"]", "]"}]}], ";", "\n", 
     RowBox[{"check", "[", 
      RowBox[{"AllTrue", "[", 
       RowBox[{"sweepData", ",", 
        RowBox[{
         RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", 
              RowBox[{"]", "]"}]}], "==", 
             RowBox[{"Sort", "[", "sweepKeys", "]"}]}], " ", "&&", "\n", " ", 
            RowBox[{"Total", "[", 
             RowBox[{"Length", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"\"\<Energies\>\"", 
                    RowBox[{"]", "]"}]}], "&"}], " ", "/@", " ", 
                  RowBox[{"Values", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", 
                    RowBox[{"]", "]"}]}], "==", 
                    RowBox[{"2", "^", 
                    RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}]}]}], "&"}], 
                   "]"}]}], ",", "\"\<Incomplete sweep.\>\""}], "]"}], ";", 
               "\n", 
               RowBox[{"sweepGroups", " ", "=", " ", 
                RowBox[{"Gather", "[", 
                 RowBox[{"sweepKeys", ",", 
                  RowBox[{
                   RowBox[{"sameSpectrum", "[", 
                    RowBox[{
                    "#1", ",", "#2", ",", "sweepData", ",", 
                    "matchingTolerance"}], "]"}], "&"}]}], "]"}]}], ";", "\n", 
               RowBox[{"Print", "[", 
                RowBox[{"\"\<Sectors: \>\"", ",", 
                 RowBox[{"Length", "[", "sweepKeys", "]"}], 
                 ",", "\"\<; groups: \>\"", ",", 
                 RowBox[{"Length", "[", 
                  RowBox[{
                   RowBox[{"sweepGroups", 
                    RowBox[{"]", "]"}]}], 
                   ";"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]], "Input",
 CellLabel->"",ExpressionUUID->"f48221e3-d1a5-024c-8ddc-5e0f292bfbd5"]
}, Open  ]],

