Cell["\<\
Basis {00,01,10,11}. Enter a four-component vector or a 4*4 density matrix. \
Used only in Factorized mode.\
\>", "Text",ExpressionUUID->"d4ff25bc-75e3-c049-9317-647d6527da50"],

Cell[BoxData[
 RowBox[{
