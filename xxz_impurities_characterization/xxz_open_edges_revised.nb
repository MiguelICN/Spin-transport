                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"sweepPoint", "[", 
                    RowBox[{"#", ",", "p", ",", "tol"}], "]"}], "&"}], " ", "/@",
                     " ", "grid"}], 
                    RowBox[{"]", "]"}]}], ";", "\n", " ", 
                    RowBox[{"DistributeDefinitions", "[", "sweepPoint", "]"}],
                     ";", "\n", " ", 
                    RowBox[{"With", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"pp", "=", "p"}], ",", 
                    RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
