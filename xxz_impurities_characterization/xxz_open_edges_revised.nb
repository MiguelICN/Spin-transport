                RowBox[{"[", "["}], "k", 
                RowBox[{"]", "]"}]}]}], "]"}], ",", "\n", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "halfPlots", "]"}]}], "}"}]}], "]"}], ";",
            "\n", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"savePNG", "[", 
              RowBox[{
               RowBox[{"FileNameJoin", "[", 
                RowBox[{"{", 
                 RowBox[{"sweepDir", ",", 
