  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedEdgePlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<EdgesEntropy\>\"", ",", 
     "\n", " ", "\"\<S_{AB|E}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Edges versus middle eigenstate entanglement}\>\""}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->"",ExpressionUUID->"041fcc7a-fda1-3846-b6b6-e197ab6e0389"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["6. Initial states for this evolution", "Section",ExpressionUUID->"3f26394f-aa08-4a4b-9d08-c9fb41584ecc"],

Cell[CellGroupData[{

Cell["6.1 Choose factorized or full-chain mode", "Subsection",ExpressionUUID->"d3423f34-b3e7-2844-a7b7-a393fe77bcb4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stateMode", " ", "=", " ", "\"\<Factorized\>\""}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{"Factorized", " ", "or", " ", "Full"}], " ", "*)"}]}]], "Input",
 CellLabel->"",ExpressionUUID->"9c00eaa2-8890-444b-b4d8-9ff44d7f9074"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 State of the two edge spins", "Subsection",ExpressionUUID->"45ac683c-8d35-c44c-8c98-a1002167f91a"],

Cell["\<\
Basis {00,01,10,11}. Enter a four-component vector or a 4\[Times]4 density \
matrix. Used only in Factorized mode.\
\>", "Text",ExpressionUUID->"77ce822f-c098-384b-9791-c8efb35a94b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgeState", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4."}]}], " ", 
   "*)"}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"149b0e8f-d9ec-ab48-aee6-568edb632d5b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3 State of the middle spins", "Subsection",ExpressionUUID->"ab72eb8c-9d6e-d649-a6ba-ad7762aefc0a"],

Cell["\<\
Dimension 2^(L\[Minus]2), physical order {2,\[Ellipsis],L\[Minus]1}. \
neel[n,0] starts with up on physical site 2; neel[n,1] starts with down. A \
middle helix starts its phase at physical site 2.\
\>", "Text",ExpressionUUID->"3e81b62e-30d0-5140-8258-af24bb4dfec5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"middleState", " ", "=", " ", 
   RowBox[{"neel", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"helix", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
    RowBox[{"or", " ", "your", " ", 
     RowBox[{"vector", "/", "density"}], " ", 
     RowBox[{"matrix", "."}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"78d493c4-4548-aa4a-8fab-9163e5112cad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4 Full initial state", "Subsection",ExpressionUUID->"6f557e67-c6b7-1b47-8fca-dd379d5358c6"],

Cell["\<\
Used only in Full mode. Enter a full-chain vector/density matrix in site \
order {1,\[Ellipsis],L}, or select an eigenvector using evoSectors. A single \
eigenvector gives stationary reduced observables.\
\>", "Text",ExpressionUUID->"13b97239-3884-a74d-8848-7d93e404edb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullState", " ", "=", " ", 
   RowBox[{"groundKet", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"eigenket", "[", 
      RowBox[{"evoED", ",", "3", ",", "1"}], "]"}]}], ",", " ", 
    RowBox[{"neel", "[", 
     RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "]"}], ",", "\n", "   ", 
    RowBox[{"helix", "[", 
     RowBox[{
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], ",", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"or", " ", "your", " ", "full"}], "-", 
     RowBox[{"chain", " ", 
      RowBox[{"state", "."}]}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"53f4bf8e-aef2-1443-b616-bb3c1c75e60b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.5 Assemble and inspect the initial state", "Subsection",ExpressionUUID->"b12cf44f-e734-184c-9ce7-50f75cfc64f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "stateMode"}], "]"}], ",", "\"\<Invalid stateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"stateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
   RowBox[{
    RowBox[{"edgeFactor", " ", "=", " ", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"edgeState", ",", "4", ",", "validationTolerance"}], "]"}]}], ";",
     "\n", " ", 
    RowBox[{"middleFactor", " ", "=", " ", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"middleState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}], ",",
        "validationTolerance"}], "]"}]}], ";", "\n", " ", 
    RowBox[{"fullFactor", " ", "=", " ", 
     RowBox[{"joinStates", "[", 
      RowBox[{"edgeFactor", ",", "middleFactor", ",", 
       RowBox[{
        RowBox[{"evoUsed", "[", 
         RowBox[{
          RowBox[{"\"\<L\>\"", 
           RowBox[{"]", "]"}]}], ",", "\n", " ", 
          RowBox[{"fullFactor", " ", "=", " ", 
           RowBox[{"stateFactor", "[", 
            RowBox[{"fullState", ",", 
             RowBox[{"2", "^", 
              RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
             "validationTolerance"}], "]"}]}]}], "\n", "]"}], ";", "\n", 
        RowBox[{"rhoEdge0", " ", "=", " ", 
         RowBox[{"reducedState", "[", 
          RowBox[{"fullFactor", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
           RowBox[{"evoUsed", "[", 
            RowBox[{
             RowBox[{"\"\<L\>\"", 
              RowBox[{"]", "]"}]}], ";", "\n", 
             RowBox[{
             "MatrixForm", "[", "rhoEdge0", 
              "]"}]}]}]}]}]}]}]}]}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"ef693967-cbbc-654b-ae84-103445e8cfe2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.6 Prepare the evolution coefficients", "Subsection",ExpressionUUID->"d8ba4a91-cc0f-5d42-b9ef-0a812107b072"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"engine", " ", "=", " ", 
   RowBox[{"makeEngine", "[", 
    RowBox[{"evoED", ",", "fullFactor"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Occupied sectors: \>\"", ",", 
   RowBox[{"Length", "[", 
    RowBox[{"engine", "[", 
     RowBox[{
      RowBox[{"\"\<Sectors\>\"", 
       RowBox[{"]", "]"}]}], ",", "\n", 
      " ", "\"\<; initial factor columns: \>\"", ",", 
      RowBox[{"engine", "[", 
       RowBox[{
        RowBox[{"\"\<Columns\>\"", 
         RowBox[{"]", "]"}]}], ";"}]}]}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"e732d39d-806b-674b-b4d0-49f49868ba57"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["7. Evolution, observables, and exports", "Section",ExpressionUUID->"ca1ebff2-b405-1a46-ab0f-26f5212688e0"],

Cell[CellGroupData[{

Cell["7.1 Generate the time grid", "Subsection",ExpressionUUID->"8a741e3b-8989-8c47-9075-955d0ce4456a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoTimeUsed", " ", "=", " ", "evoTime"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"times", " ", "=", " ", 
   RowBox[{"timeGrid", "[", "evoTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Time points: \>\"", ",", 
   RowBox[{"Length", "[", "times", "]"}], ",", "\"\<; last time: \>\"", ",", 
   RowBox[{"Last", "[", 
    RowBox[{
     RowBox[{"times", 
      RowBox[{"]", "]"}]}], ";"}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"cf7f2ba0-4410-da4a-ac4e-cade72138764"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 Evolve and calculate edge observables", "Subsection",ExpressionUUID->"45c5d02b-e7ab-4044-a564-e8981f19e537"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3 onward.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"engine", "[", "\"\<Parameters\>\"", "]"}], "===", "evoUsed"}], 
    ",", "\"\<Engine belongs to another Hamiltonian: rerun section \
6.6.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"evolutionSeconds", ",", "evoData"}], "}"}], " ", "=", " ", 
  RowBox[{"AbsoluteTiming", "[", "\n", " ", 
   RowBox[{"evolveChunks", "[", 
    RowBox[{
    "times", ",", "engine", ",", "rhoEdge0", ",", "validationTolerance", ",", 
     RowBox[{
      RowBox[{"parallel", 
       RowBox[{"]", "]"}]}], ";", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Evolution seconds: \>\"", ",", "evolutionSeconds"}], 
       "]"}], ";"}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"a4ec2b34-428d-644f-94f2-e642e5526f88"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3 Numerical checks", "Subsection",ExpressionUUID->"2041ca06-9a08-e248-9a2b-210b6ead4cfe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"evoChecks", " ", "=", " ", 
    RowBox[{"<|", "\n", " ", 
     RowBox[{
      RowBox[{"\"\<InitialFactorError\>\"", " ", "->", " ", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"evolve", "[", 
           RowBox[{"0.", ",", "engine"}], "]"}], "-", "fullFactor"}], 
         ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", " ", 
      RowBox[{"\"\<InitialEdgeError\>\"", " ", "->", " ", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "evoData", "]"}], "[", "\"\<RhoAB\>\"", 
           "]"}], "-", "rhoEdge0"}], ",", "\"\<Frobenius\>\""}], "]"}]}], ",",
       "\n", " ", 
      RowBox[{"\"\<MaxTraceError\>\"", " ", "->", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"evoData", ",", 
          RowBox[{"\"\<TraceError\>\"", 
           RowBox[{"]", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<MaxHermiticityError\>\"", " ", "->", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"evoData", ",", 
              RowBox[{"\"\<HermiticityError\>\"", 
               RowBox[{"]", "]"}]}], ",", "\n", " ", 
              RowBox[{"\"\<MinEigenvalue\>\"", " ", "->", " ", 
               RowBox[{"Min", "[", "Lookup", 
                RowBox[{"[", 
                 RowBox[{"evoData", ",", 
                  RowBox[{"\"\<MinEigenvalue\>\"", 
                   RowBox[{"]", "]"}]}]}], "\n"}]}]}]}]}]}]}]}]}]}]}]}]}]}], 
   "|>"}], ";"}], "\n", 
 RowBox[{"check", "[", 
  RowBox[{"Max", "[", 
   RowBox[{
    RowBox[{"Values", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"evoChecks", ",", 
          RowBox[{"\"\<MinEigenvalue\>\"", 
           RowBox[{"]", "]"}]}]}], "]"}], "<", "validationTolerance"}], " ", "&&",
        "\n", " ", 
       RowBox[{
        RowBox[{"evoChecks", "[", "\"\<MinEigenvalue\>\"", "]"}], ">=", 
        RowBox[{"-", "validationTolerance"}]}]}], 
      ",", "\"\<Evolution validation failed.\>\""}], "]"}], ";", "\n", 
    "evoChecks"}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"389d438b-6538-c14f-98c8-6226afd4f85e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.4 Build and inspect the plots", "Subsection",ExpressionUUID->"0016ec9e-53b7-fc4a-9583-45609f43358b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoPlots", " ", "=", " ", 
   RowBox[{"densityPanels", "[", 
    RowBox[{"evoData", ",", "evoUsed", ",", "evoTimeUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"TrueQ", "[", "exportLogTime", "]"}], ",", 
   RowBox[{"evoPlots", "=", 
    RowBox[{"Join", "[", 
     RowBox[{"evoPlots", ",", 
      RowBox[{
       RowBox[{"densityPanels", "[", 
        RowBox[{"evoData", ",", "evoUsed", ",", "evoTimeUsed", ",", 
         RowBox[{"True", 
          RowBox[{"]", "]"}]}]}], "]"}], ";", "\n", 
       RowBox[{
       "evoPlots", "[", "\"\<03_entropies_mutual_information\>\"", 
        "]"}]}]}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"c8a17d47-75b0-074b-a522-0bb1acaa00c2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.5 Export plots", "Subsection",ExpressionUUID->"98562d65-cf17-e145-bd8f-9089087e98f6"],

Cell[BoxData[
 RowBox[{"evoDir", " ", "=", " ", 
  RowBox[{"newFolder", "[", 
   RowBox[{"outputRoot", ",", 
    RowBox[{"evoLabel", "<>", "\"\<_L\>\"", "<>", 
     RowBox[{"ToString", "[", 
      RowBox[{"evoUsed", "[", 
       RowBox[{"\"\<L\>\"", 
        RowBox[{
         RowBox[{"]", "]"}], "<>", "\n", " ", "\"\<_J\>\"", "<>", 
         RowBox[{"safeToken", "[", 
          RowBox[{"evoUsed", "[", 
           RowBox[{"\"\<J\>\"", 
            RowBox[{
             RowBox[{"]", "]"}], "<>", "\"\<_Delta\>\"", "<>", 
             RowBox[{"safeToken", "[", 
              RowBox[{
               RowBox[{"evoUsed", "[", 
                RowBox[{"\"\<Delta\>\"", 
                 RowBox[{"]", "]"}]}], "]"}], ";", "\n", 
               RowBox[{"Do", "[", 
                RowBox[{"savePNG", "[", 
                 RowBox[{
                  RowBox[{"FileNameJoin", "[", 
                   RowBox[{"{", 
                    RowBox[{"evoDir", ",", 
                    RowBox[{"key", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"evoPlots", "[", 
                    RowBox[{
                    RowBox[{"key", 
                    RowBox[{"]", "]"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"key", ",", 
                    RowBox[{"Keys", "[", "evoPlots", "]"}]}], "}"}]}], "]"}], 
                   ";", "\n", 
                   RowBox[{"Print", "[", 
                    RowBox[{"\"\<Saved: \>\"", ",", "evoDir"}], "]"}], 
                   ";"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]], "Input",
 CellLabel->"",ExpressionUUID->"40319096-e8b5-dc4c-a0d0-b2e26caa5fd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.6 Export initial states, eigenpairs, and numerical data", "Subsection",ExpressionUUID->"7d4572fe-1fe1-7442-b522-f2b9f1c12887"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"evoDir", ",", "\"\<initial_state.wxf\>\""}], "}"}], "]"}], ",",
     "\n", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Mode\>\"", "->", "stateMode"}], ",", 
      RowBox[{"\"\<FullFactor\>\"", "->", "fullFactor"}], ",", 
      RowBox[{"\"\<RhoAB0\>\"", "->", "rhoEdge0"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"evoDir", ",", "\"\<sector_eigenpairs.wxf\>\""}], "}"}], "]"}], 
    ",", "evoED", ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"evoDir", ",", "\"\<edge_dynamics.wxf\>\""}], "}"}], "]"}], ",",
     "\n", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Model\>\"", "->", "evoUsed"}], ",", 
      RowBox[{"\"\<TimeSettings\>\"", "->", "evoTimeUsed"}], ",", 
      RowBox[{"\"\<Checks\>\"", "->", "evoChecks"}], ",", 
      RowBox[{"\"\<Data\>\"", "->", "evoData"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"evoDir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
    RowBox[{"ToString", "[", "\n", " ", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Model\>\"", "->", "evoUsed"}], ",", 
        RowBox[{"\"\<TimeSettings\>\"", "->", "evoTimeUsed"}], ",", 
        RowBox[{"\"\<TimeGrid\>\"", "->", "times"}], ",", 
        RowBox[{"\"\<StateMode\>\"", "->", "stateMode"}], ",", "\n", " ", 
        RowBox[{"\"\<EDTolerance\>\"", "->", "edTolerance"}], ",", 
        RowBox[{"\"\<ValidationTolerance\>\"", "->", "validationTolerance"}], 
        ",", 
        RowBox[{"\"\<Parallel\>\"", "->", "parallel"}], ",", "\n", " ", 
        RowBox[{"\"\<EDSeconds\>\"", "->", "evoEDSeconds"}], ",", 
        RowBox[{"\"\<EvolutionSeconds\>\"", "->", "evolutionSeconds"}], ",", 
        RowBox[{"\"\<Checks\>\"", "->", "evoChecks"}], ",", "\n", " ", 
        RowBox[{"\"\<Notes\>\"", 
         "->", "\"\<Raw energy eigenvectors; entropy in nats; Pauli \
magnetization. Ground-state ties follow sector order. Reduced entropy is \
bipartite entanglement only for a pure full state.\>\""}]}], "|>"}], ",", 
      "InputForm"}], "]"}], ",", "\"\<Text\>\""}], "]"}], ";"}]}], "Input",
 CellLabel->"",ExpressionUUID->"c621ba9a-4a06-c34e-bac2-a28fed2ead21"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.7 Optional export of fixed-Delta eigenstate plots", "Subsection",ExpressionUUID->"f231223f-8817-cc43-8e30-17be9d94bed5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ValueQ", "[", "evoEigenstates", "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"evoEigenstates", "[", "\"\<Parameters\>\"", "]"}], "===", 
      "evoUsed"}], " ", "&&", " ", 
     RowBox[{"ValueQ", "[", "fixedEnergyPlots", "]"}]}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"savePNG", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"evoDir", ",", 
            RowBox[{"\"\<fixed_energy_group_\>\"", "<>", 
             RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"fixedEnergyPlots", 
          RowBox[{"[", "["}], "k", 
          RowBox[{"]", "]"}]}]}], "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "fixedEnergyPlots", "]"}]}], "}"}]}], "]"}], ";",
      "\n", " ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"savePNG", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"evoDir", ",", 
            RowBox[{"\"\<fixed_half_group_\>\"", "<>", 
             RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"fixedHalfPlots", 
          RowBox[{"[", "["}], "k", 
          RowBox[{"]", "]"}]}]}], "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "fixedHalfPlots", "]"}]}], "}"}]}], "]"}], ";",
      "\n", " ", 
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"savePNG", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"evoDir", ",", 
            RowBox[{"\"\<fixed_edges_group_\>\"", "<>", 
             RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
           "}"}], "]"}], ",", 
         RowBox[{"fixedEdgePlots", 
          RowBox[{"[", "["}], "k", 
          RowBox[{"]", "]"}]}]}], "]"}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "fixedEdgePlots", "]"}]}], "}"}]}], "]"}]}]}],
    "\n", "]"}], ";"}]], "Input",
 CellLabel->"",ExpressionUUID->"0d0fd3ef-9d47-b947-bba3-0f51c3d38342"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["8. Access and modify results", "Section",ExpressionUUID->"cb0d541c-d7a0-eb46-a43a-9f9eed5a7bd2"],

Cell["\<\
For another initial state at the same Hamiltonian, edit section 6 and rerun \
6.5\[Dash]7. For another Hamiltonian, edit 5.1 and rerun 5.3 onward. The \
sweep can be skipped entirely. Exact degenerate eigenstate entropies remain \
basis dependent. S(rhoAB) measures edges\[Dash]middle entanglement only when \
the full state is pure.\
\>", "Text",ExpressionUUID->"4b79bcf6-0f2d-e943-b8c8-4e2ab5b4adfb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Evaluate", " ", "any", " ", "of", " ", "these", " ", "expressions", " ", 
    RowBox[{"individually", "."}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"eigenket", "[", 
    RowBox[{"evoED", ",", "3", ",", "1"}], "]"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoED", "[", "\"\<Sectors\>\"", "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoAB\>\"", "]"}], " ", "//",
     " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoA\>\"", "]"}], " ", "//", 
    " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoB\>\"", "]"}], " ", "//", 
    " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"reducedState", "[", 
    RowBox[{
     RowBox[{"evolve", "[", 
      RowBox[{"1.", ",", "engine"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}], " ", 
   "*)"}]}]], "Input",
 CellLabel->"",ExpressionUUID->"51fad6fe-3d4a-824a-9e20-223dae020de1"]
}, Open  ]]
}, Open  ]]
},
