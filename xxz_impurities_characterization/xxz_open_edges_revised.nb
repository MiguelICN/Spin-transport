   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"first", "=", 
      RowBox[{"0", " ", "starts", " ", "with", " ", "up"}]}], ";", " ", 
     RowBox[{"first", "=", 
      RowBox[{"1", " ", "starts", " ", "with", " ", 
       RowBox[{"down", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"neel", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"first_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"Table", "[", 
