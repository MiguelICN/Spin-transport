Cell["9.8 PNG export and data", "Subsection",ExpressionUUID->"bece1e4e-7bae-dc48-b477-bd6c51b75810"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynDir", "=", 
   RowBox[{"newFolder", "[", 
    RowBox[{"dynOutputRoot", ",", 
     RowBox[{"dynRunLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<J\>\"", "]"}], "]"}], "<>", 
      " ", "\"\<_h\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<h\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_bL\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<bLeft\>\"", "]"}], "]"}], "<>", 
      " ", "\"\<_bR\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<bRight\>\"", "]"}], "]"}], "<>", 
      "\n", " ", "\"\<_Delta\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"First", "[", "dynDeltaUsed", "]"}], "]"}], "<>", "\"\<to\>\"",
       "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"Last", "[", "dynDeltaUsed", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"savePNG", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"dynDir", ",", 
          RowBox[{"key", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
       RowBox[{"dynPlots", "[", "key", "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"key", ",", 
       RowBox[{"Keys", "[", "dynPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
  RowBox[{"(*", 
