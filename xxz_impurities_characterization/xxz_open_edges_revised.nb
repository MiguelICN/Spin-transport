Cell[CellGroupData[{

Cell["6.4 Full initial state", "Subsection",ExpressionUUID->"80806ccd-2311-924b-9cb2-98cd96bdd69c"],

Cell["\<\
Used only in Full mode. Enter a full-chain vector/density matrix in site \
order {1,\[Ellipsis],L}, or select an eigenvector using evoSectors. A single \
eigenvector gives stationary reduced observables.\
\>", "Text",ExpressionUUID->"8a1602ba-ca10-9c4f-9f96-5f21d87117cc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullState", " ", "=", " ", 
   RowBox[{"groundKet", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"eigenket", "[", 
      RowBox[{"evoED", ",", "3", ",", "1"}], "]"}]}], ",", " ", 
    RowBox[{"neel", "[", 
     RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "]"}], ",", "\n", "   ", 
    RowBox[{"helix", "[", 
     RowBox[{
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], ",", 
      RowBox[{"Pi", "/", "3"}]}], "]"}], ",", " ", 
    RowBox[{
     RowBox[{"or", " ", "your", " ", "full"}], "-", 
     RowBox[{"chain", " ", 
      RowBox[{"state", "."}]}]}]}], " ", "*)"}]}]}], "Input",
 CellLabel->
