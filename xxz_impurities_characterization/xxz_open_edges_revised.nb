     "\n", " ", "\"\<S_{AB|E}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Edges versus middle eigenstate entanglement}\>\""}], 
    "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[153]:=",ExpressionUUID->"40ec5d19-32c9-8d4d-92ff-9d0845372104"]
