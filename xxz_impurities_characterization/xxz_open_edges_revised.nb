Cell["6.6 Prepare the evolution coefficients", "Subsection",ExpressionUUID->"27ffc2fc-1524-6a47-9c0d-6adebf50b4ff"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"engine", " ", "=", " ", 
   RowBox[{"makeEngine", "[", 
    RowBox[{"evoED", ",", "fullFactor"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Occupied sectors: \>\"", ",", 
    RowBox[{"Length", "[", 
     RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}], "]"}], ",", "\n", 
    " ", "\"\<; initial factor columns: \>\"", ",", 
    RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "]"}], ";"}]}], "Input",
