  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ptB", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
