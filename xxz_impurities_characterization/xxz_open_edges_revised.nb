Cell[CellGroupData[{

Cell["Output paths", "Subsection",ExpressionUUID->"51f90f54-fc56-614b-886e-8ee32dba9636"],

Cell[BoxData[
 RowBox[{
  RowBox[{"baseFolder", "[", "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "d", "}"}], ",", "\n", " ", 
    RowBox[{"d", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"StringLength", "[", "$InputFileName", "]"}], ">", "0"}]}], ",",
        "\n", "  ", 
       RowBox[{"DirectoryName", "[", 
        RowBox[{"ExpandFileName", "[", 
         RowBox[{
          RowBox[{"$InputFileName", 
           RowBox[{"]", "]"}]}], ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"NotebookDirectory", "[", "]"}], ",", 
             RowBox[{"Directory", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"]", "]"}], 
                RowBox[{"]", "]"}]}], ";", "\n", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"StringQ", "[", "d", "]"}], ",", "d", ",", 
                 RowBox[{
                  RowBox[{"Directory", "[", 
                   RowBox[{"]", "]"}], "]"}], ";", "\n", 
                  RowBox[{
                   RowBox[{"safeToken", "[", "x_", "]"}], " ", ":=", " ", 
                   RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", "s", "}"}], ",", "\n", " ", 
                    RowBox[{
                    RowBox[{"s", "=", 
                    RowBox[{"StringReplace", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{
                    "RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
                    "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
                    RowBox[{"s", "=", 
                    RowBox[{"StringReplace", "[", 
                    RowBox[{"s", ",", 
                    RowBox[{
                    RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}],
                     "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
                    RowBox[{"StringReplace", "[", 
                    RowBox[{"s", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}], ",", 
                    RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
                    RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
                    RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}], 
                    RowBox[{"]", "]"}]}], ";", "\n", 
                    RowBox[{"(*", " ", 
                    RowBox[{
                    RowBox[{
                    "Numbered", " ", "reruns", " ", "prevent", " ", 
                    "overwriting"}], ";", " ", 
                    RowBox[{
                    "no", " ", "timestamps", " ", "or", " ", "random", " ", 
                    RowBox[{"strings", "."}]}]}], " ", "*)"}], "\n", 
                    RowBox[{
                    RowBox[{"newFolder", "[", 
                    RowBox[{"root_", ",", "tag_"}], "]"}], " ", ":=", " ", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"d", ",", 
                    RowBox[{"k", "=", "1"}]}], "}"}], ",", "\n", " ", 
                    RowBox[{
                    RowBox[{"d", "=", 
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{"{", 
                    RowBox[{"root", ",", "tag"}], "}"}], "]"}]}], ";", "\n", 
                    " ", 
                    RowBox[{"While", "[", 
                    RowBox[{
                    RowBox[{"DirectoryQ", "[", "d", "]"}], ",", 
                    RowBox[{
                    RowBox[{"k", "++"}], ";", 
                    RowBox[{"d", "=", 
                    RowBox[{"FileNameJoin", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{"root", ",", 
                    RowBox[{"tag", "<>", "\"\<_run\>\"", "<>", 
                    RowBox[{"ToString", "[", "k", "]"}]}]}], "}"}], 
                    RowBox[{"]", "]"}]}], ";", "\n", " ", 
                    RowBox[{"CreateDirectory", "[", 
                    RowBox[{"d", ",", 
                    RowBox[{"CreateIntermediateDirectories", "->", "True"}]}],
                     "]"}], ";", "d"}], "\n", "]"}]}], 
                    ";"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
]}]}]}]], "Input",
 CellLabel->"",ExpressionUUID->"056a276e-a0cc-dc47-b60d-9467baccfc72"]
}, Open  ]]
}, Open  ]],

