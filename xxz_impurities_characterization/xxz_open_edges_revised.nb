 CellLabel->"",ExpressionUUID->"f21b4966-2ccd-f54e-9e8f-06bf583ae565"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.4 Optional fixed-Delta eigenstate plots", "Subsection",ExpressionUUID->"5355bc94-b080-204c-bdc2-adf0816d3f96"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoEigenstates", " ", "=", " ", 
   RowBox[{"addEntropies", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoEnergies", " ", "=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"evoEigenstates", "[", "\"\<Sectors\>\"", "]"}], 
     ",", "\"\<Eigenvalues\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{"evoGroups", " ", "=", " ", 
  RowBox[{"Gather", "[", 
   RowBox[{"Range", "[", 
    RowBox[{"Length", "[", 
     RowBox[{
      RowBox[{"evoEnergies", 
       RowBox[{"]", "]"}]}], ",", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", 
          RowBox[{"[", "["}], "#1", 
          RowBox[{"]", "]"}]}], "]"}], "==", 
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", 
          RowBox[{"[", "["}], "#2", 
          RowBox[{"]", "]"}]}], "]"}]}], " ", "&&", "\n", " ", 
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"evoEnergies", 
           RowBox[{"[", "["}], "#1", 
           RowBox[{"]", "]"}]}], "-", 
          RowBox[{"evoEnergies", 
           RowBox[{"[", "["}], "#2", 
           RowBox[{"]", "]"}]}]}], "]"}], "<", 
        RowBox[{"matchingTolerance", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"evoEnergies", 
               RowBox[{"]", "]"}]}], "&"}], "]"}], 
            ";"}]}]}]}]}]}]}]}]}]}]}]}], "Input",
 CellLabel->"",ExpressionUUID->"abcd9df5-0ed8-6643-b799-27d17167a0b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedEnergyPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<Eigenvalues\>\"", 
     ",", "\"\<E_n\>\"", ",", "\"\<\\\\text{Sector energies}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedHalfPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<HalfEntropy\>\"", ",", "\n",
      " ", "\"\<S_{\\\\mathrm{half}}\\\\;(\\\\mathrm{nats})\>\"", 
