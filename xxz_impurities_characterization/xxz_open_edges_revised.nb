      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<EntropyA\>\"", ",", "\"\<\\\\text{Entropy of edge A}\>\"",
          ",", "\"\<S(\\\\rho_A)\\\\quad(\\\\mathrm{nats})\>\""}], "}"}], ",",
        "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<EntropyB\>\"", ",", "\"\<\\\\text{Entropy of edge B}\>\"",
