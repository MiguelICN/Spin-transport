Cell[CellGroupData[{

Cell["Diagonalization special cases and eigenstate entropies", "Subsection",ExpressionUUID->"d4a517e5-28b8-3743-9ed9-980188782b8f"],

Cell["\<\
At \[CapitalDelta]=1, uniform effective fields permit S labels; at \
\[CapitalDelta]=\[Minus]1 they permit staggered S labels. At m=0, F or RF may \
also be used. Exact degenerate eigenstate entropies depend on the chosen raw \
eigensystem basis. No near-degenerate energy vectors are canonicalized.\
\>", "Text",ExpressionUUID->"e33e2a7d-82e5-5241-80eb-2a7e0310ec32"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"One", " ", "ground"}], "-", 
      RowBox[{"state", " ", "vector"}]}], ";", " ", 
     RowBox[{"ties", " ", "follow", " ", "sector", " ", "order"}]}], ",", " ", 
    RowBox[{"then", " ", "energy", " ", 
     RowBox[{"order", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"groundKet", "[", "ed_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"pairs", ",", "c"}], "}"}], ",", "\n", " ", 
       RowBox[{
