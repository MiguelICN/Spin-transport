  "In[531]:=",ExpressionUUID->"0c20035f-2835-a245-9931-61ed783e55ed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dynEdgeState", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], ";"}], 
  "                ", 
  RowBox[{"(*", " ", 
   RowBox[{"Basis", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"00", ",", "01", ",", "10", ",", "11"}], "}"}], "."}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dynMiddleState", "=", 
