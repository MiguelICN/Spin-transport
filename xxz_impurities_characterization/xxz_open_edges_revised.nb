          RowBox[{
           RowBox[{"\"\<tMax\>\"", 
            RowBox[{"]", "]"}]}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
          ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
           "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{"realQ", "[", 
            RowBox[{
             RowBox[{"cfg", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<dt\>\"", 
                 RowBox[{"]", "]"}]}], " ", "&&", " ", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
               ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
             RowBox[{"t", "=", 
              RowBox[{"N", "[", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
                RowBox[{"Range", "[", 
                 RowBox[{"0", ",", 
                  RowBox[{"Floor", "[", 
                   RowBox[{
                    RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{"\"\<dt\>\"", 
                    RowBox[{"]", "]"}], 
                    RowBox[{"]", "]"}]}], ";", "\n", "  ", 
                    RowBox[{"If", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"Last", "[", "t", "]"}], "-", 
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{"\"\<tMax\>\"", 
                    RowBox[{"]", "]"}]}], "<", 
                    RowBox[{
                    RowBox[{"10", "^", 
                    RowBox[{"-", "12"}]}], " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{"\"\<tMax\>\"", 
                    RowBox[{"]", "]"}]}], ",", "\n", "   ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"t", 
                    RowBox[{"[", "["}]}], "-", 
                    RowBox[{"1", 
                    RowBox[{"]", "]"}]}]}], "=", 
                    RowBox[{"N", "[", 
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{"\"\<tMax\>\"", 
                    RowBox[{"]", "]"}]}], ",", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"t", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<tMax\>\"", 
                    RowBox[{"]", "]"}], 
                    RowBox[{"]", "]"}]}], ";", "t"}], ",", "\n", 
                    " ", "\"\<Log\>\"", ",", 
                    RowBox[{"check", "[", 
                    RowBox[{
                    RowBox[{"0", "<", 
                    RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
                    RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", 
                    " ", 
                    RowBox[{"IntegerQ", "[", 
                    RowBox[{
                    RowBox[{"cfg", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<LogPoints\>\"", 
                    RowBox[{"]", "]"}]}], " ", "&&", "\n", "   ", 
                    RowBox[{
                    RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", 
                    "2"}]}], ",", "\"\<Invalid logarithmic grid.\>\""}], 
                    "]"}], ";", "\n", "  ", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"{", "0.", "}"}], ",", 
                    RowBox[{"Exp", "[", 
                    RowBox[{"Subdivide", "[", 
                    RowBox[{"Log", "[", 
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"cfg", "[", 
                    RowBox[{"\"\<tMinPositive\>\"", 
                    RowBox[{"]", "]"}]}], "]"}], ",", 
                    RowBox[{"Log", "[", 
                    RowBox[{
                    RowBox[{"N", "[", 
                    RowBox[{
                    RowBox[{"cfg", "[", 
                    RowBox[{"\"\<tMax\>\"", 
                    RowBox[{"]", "]"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", 
                    RowBox[{"1", 
                    RowBox[{"]", "]"}]}]}]}], "]"}], ",", "\n", " ", "_", ",", 
                    RowBox[{
                    RowBox[{"check", "[", 
                    RowBox[{"False", ",", 
                    RowBox[{"\"\<Grid must be Linear or Log.\>\"", 
                    RowBox[{"]", "]"}]}]}], "\n", "]"}], 
                    ";"}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}]}\
