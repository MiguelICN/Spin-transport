Cell["2. Plotting, MaTeX labels, and file output", "Section",ExpressionUUID->"37bd31a4-736f-ed41-b1bc-01393986c2a6"],

Cell[CellGroupData[{

Cell["Labels and ticks", "Subsection",ExpressionUUID->"54ab936a-d0d9-9c48-86ac-4d44a428700a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "tex", ",", "texNumber", ",", "ticks", ",", "logTicks", ",", "sectorLabel",
     ",", "caption", ",", "curveStyles", ",", "pointMarkers", ",", "\n", " ", 
    "framePlot", ",", "plotPanel", ",", "sweepPanels", ",", "fixedPanels", ",",
     "series", ",", "matrixSeries", ",", "densityPanels", ",", "\n", " ", 
    "safeToken", ",", "newFolder", ",", "baseFolder", ",", "savePNG"}], "]"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"texReady", "=", "Automatic"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"MaTeX", " ", "labels"}], ";", " ", 
    RowBox[{
    "a", " ", "visible", " ", "native", " ", "fallback", " ", "is", " ", 
     "used", " ", "if", " ", "MaTeX", " ", "is", " ", 
     RowBox[{"unavailable", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"tex", "[", 
   RowBox[{"s_String", ",", 
    RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "g", "}"}], ",", "\n", " ", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"texReady", "===", "Automatic"}], ",", "\n", "  ", 
      RowBox[{"texReady", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"Check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], ",", 
          RowBox[{
           RowBox[{"False", 
            RowBox[{"]", "]"}]}], ";", "\n", "  ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"TrueQ", "[", "texReady", "]"}]}], ",", 
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<MaTeX unavailable: check the local \
installation.\>\"", 
                RowBox[{"]", "]"}]}], "]"}], ";", "\n", " ", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"TrueQ", "[", "texReady", "]"}], ",", 
                RowBox[{"g", "=", 
                 RowBox[{"Quiet", "[", 
                  RowBox[{"Check", "[", 
                   RowBox[{
                    RowBox[{"MaTeX`MaTeX", "[", 
                    RowBox[{"s", ",", 
                    RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"$Failed", 
                    RowBox[{"]", "]"}]}], ";", "\n", "  ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"MatchQ", "[", 
                    RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
                    RowBox[{"Return", "[", 
                    RowBox[{
                    RowBox[{"g", 
                    RowBox[{"]", "]"}]}], ";", "\n", "  ", 
                    RowBox[{"texReady", "=", "False"}], ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    RowBox[{"\"\<MaTeX failed: check TeX/Ghostscript.\>\"", 
                    RowBox[{"]", "]"}]}], ";", "\n", " ", 
                    RowBox[{"Style", "[", 
                    RowBox[{"s", ",", "Black", ",", 
                    RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
                    RowBox[{"FontSize", "->", "size"}]}], "]"}]}], "\n", 
