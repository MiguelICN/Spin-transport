Cell[CellGroupData[{

Cell["4.7 Export sweep plots and data", "Subsection",ExpressionUUID->"6d06e6fd-2da0-d34a-b967-4cdca13eac12"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepDir", " ", "=", " ", 
   RowBox[{"newFolder", "[", 
    RowBox[{"outputRoot", ",", 
     RowBox[{"sweepLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"sweepUsed", "[", "\"\<J\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<spectrum_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"spectrumPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "spectrumPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<half_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"halfPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "halfPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<edge_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"edgeEntropyPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "edgeEntropyPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"sweepDir", ",", "\"\<eigenstate_sweep.wxf\>\""}], "}"}], "]"}],
     ",", "\n", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Model\>\"", "->", "sweepUsed"}], ",", 
      RowBox[{"\"\<DeltaGrid\>\"", "->", "deltaUsed"}], ",", 
      RowBox[{"\"\<Groups\>\"", "->", "sweepGroups"}], ",", 
      RowBox[{"\"\<Data\>\"", "->", "sweepData"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Saved: \>\"", ",", "sweepDir"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"e001fcb9-1f86-754a-8fd0-920323d4084e"],

