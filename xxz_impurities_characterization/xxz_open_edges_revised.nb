       RowBox[{"{", 
        RowBox[{"\"\<Negativity\>\"", ",", "\"\<\\\\text{Edge negativity}\>\"",
          ",", "\"\<\\\\mathcal N(\\\\rho_{AB})\>\""}], "}"}], ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<PurityA\>\"", ",", "\"\<\\\\text{Purity of edge A}\>\"", 
