Cell[CellGroupData[{

Cell["Diagonalization special cases and eigenstate entropies", "Subsection",ExpressionUUID->"b69fa3d9-9bb2-284c-b7bd-bdd92f7489d2"],

Cell["\<\
At \[CapitalDelta]=1, uniform effective fields permit S labels; at \
\[CapitalDelta]=\[Minus]1 they permit staggered S labels. At m=0, F or RF may \
also be used. Exact degenerate eigenstate entropies depend on the chosen raw \
eigensystem basis. No near-degenerate energy vectors are canonicalized.\
\>", "Text",ExpressionUUID->"0d2ac2f0-b2de-fc4a-b7f4-817b632eefeb"],

