Cell[CellGroupData[{

Cell["5.4 Optional fixed-Delta eigenstate plots", "Subsection",ExpressionUUID->"f9525ef5-b713-a24f-ae4f-6b1b0ca38acf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoEigenstates", " ", "=", " ", 
   RowBox[{"addEntropies", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoEnergies", " ", "=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"evoEigenstates", "[", "\"\<Sectors\>\"", "]"}], 
     ",", "\"\<Eigenvalues\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "evoEnergies", " ", "]"}], "]"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#1", " ", "]"}], "]"}], "]"}], "==", 
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#2", " ", "]"}], "]"}], "]"}]}], " ", "&&", "\n", " ", 
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#1", " ", "]"}], "]"}], "-", 
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#2", " ", "]"}], "]"}]}], "]"}], "<", 
        RowBox[{"matchingTolerance", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "evoEnergies", " ", "]"}]}], "]"}]}]}]}], 
      "&"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->
  "In[150]:=",ExpressionUUID->"c6d89d44-18b1-7a41-9a29-0453d5933f5a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedEnergyPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<Eigenvalues\>\"", 
     ",", "\"\<E_n\>\"", ",", "\"\<\\\\text{Sector energies}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedHalfPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
