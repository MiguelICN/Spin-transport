                    RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", "\n", 
                    " ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"n", "<", "2"}], ",", 
                    RowBox[{"Return", "[", 
