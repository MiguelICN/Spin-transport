Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Tensor", " ", "product", " ", "of", " ", "normalized", " ", "local", " ", 
    RowBox[{"spinors", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"productKet", "[", "locals_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "v", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", 
           " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"locals", ",", "\n", "  ", 
             RowBox[{
