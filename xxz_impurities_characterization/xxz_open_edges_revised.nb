              RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"styles", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ColorData", "[", "97", "]"}], "[", "k", "]"}], ",", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"g", "=", 
           RowBox[{"framePlot", "[", 
            RowBox[{"data", ",", "\"\<t\\\\quad(\\\\hbar=1)\>\"", ",", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "styles", ",", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "5", "]"}], "]"}], ",", "True", ",", "log"}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"spec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<>", 
            RowBox[{"If", "[", 
             RowBox[{"log", ",", "\"\<_logtime\>\"", ",", "\"\<\>\""}], 
             "]"}]}], "->", 
           RowBox[{"plotPanel", "[", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "\n", "   ", 
             RowBox[{"caption", "[", 
              RowBox[{"p", ",", 
               RowBox[{"\"\<\\\\Delta=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}]}], ",", 
               "note"}], "]"}], ",", "g"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"spec", ",", "specs"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0008425337998943`*^9, 4.000842551086939*^9}},
