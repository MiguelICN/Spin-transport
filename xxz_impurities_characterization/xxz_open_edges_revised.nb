Cell["5. Evolution: independent parameters and diagonalization", "Section",ExpressionUUID->"1c348b2e-d7b3-4e4c-ab83-92a836286a93"],

Cell[CellGroupData[{

Cell["5.1 Choose the Hamiltonian for this evolution", "Subsection",ExpressionUUID->"3974e2f8-b73e-5c41-b8f3-a288ab11b57f"],

Cell["\<\
Set all evolution parameters here, including Delta. Running the sweep is \
unnecessary.\
\>", "Text",ExpressionUUID->"4d516279-85a6-0349-90cc-3f75fce6982c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoModel", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", " ", "->", " ", "6"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", " ", "->", " ", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<Delta\>\"", " ", "->", " ", 
      RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
