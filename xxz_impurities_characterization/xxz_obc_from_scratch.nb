Cell["Plot all levels", "Subsection",ExpressionUUID->"33383a9a-4dea-3b43-b36f-05d0f69ea9bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"magnetizations", " ", "=", " ", 
    RowBox[{"Keys", "[", "sectorSpectrum", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorColors", " ", "=", " ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{"magnetizations", ",", "\n", "  ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Hue", "[", 
         RowBox[{
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"k", " ", "-", " ", "1"}], ")"}], "/", 
             RowBox[{"N", "[", "GoldenRatio", "]"}]}], ",", " ", "1"}], "]"}],
           ",", " ", "0.75", ",", " ", "0.8"}], "]"}], ",", "\n", "    ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{"Length", "[", "magnetizations", "]"}]}], "}"}]}], "]"}]}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorStyles", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"sectorColors", "[", "m", "]"}], ",", " ", 
        RowBox[{"AbsoluteThickness", "[", "1.5", "]"}], ",", "\n", "    ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"m", " ", "<", " ", "0"}], ",", " ", "Dashed", ",", " ", 
          RowBox[{"Dashing", "[", 
           RowBox[{"{", "}"}], "]"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"m", ",", " ", "magnetizations"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"levelCurves", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"deltaList", ",", " ", "#"}], "}"}], "]"}], " ", "&"}], 
        " ", "/@", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{"sectorSpectrum", "[", "m", "]"}], "]"}]}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{"m", ",", " ", "magnetizations"}], "}"}]}], "]"}], ",", " ", 
     "1"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"levelStyles", " ", "=", " ", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"sectorStyles", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ",", "\n", "  ", 
         RowBox[{"Length", "[", 
          RowBox[{"spectrumSectors", "[", 
           RowBox[{"magnetizations", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}]}], "]"}], ",", "\n", 
       "  ", 
       RowBox[{"{", 
        RowBox[{"k", ",", " ", 
         RowBox[{"Length", "[", "magnetizations", "]"}]}], "}"}]}], "]"}], ",",
      " ", "1"}], "]"}]}], ";"}]}], "Code",
 CellLabel->"In[32]:=",ExpressionUUID->"6bc6ab97-9564-fe4f-a3d9-54c3182958f8"],

