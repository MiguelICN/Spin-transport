Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Fixed", " ", "small", " ", "test", " ", "cases"}], ";", " ", 
    RowBox[{
     RowBox[{"independent", " ", "of", " ", "the", " ", "parameters", " ", 
      RowBox[{"above", ".", "\n", "   ", "The"}], " ", "three"}], "-", 
     RowBox[{"spin", " ", "reference", " ", "uses", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"|", 
