Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sectorStyleMap", " ", "=", " ", 
    RowBox[{"AssociationThread", "[", 
     RowBox[{"magnetizations", ",", " ", "sectorStyles"}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{"Column", "[", "\n", " ", 
  RowBox[{
   RowBox[{"Table", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sectors", " ", "=", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"m", " ", "==", " ", "0"}], ",", " ", 
           RowBox[{"{", "0", "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"m", ",", " ", 
             RowBox[{"-", "m"}]}], "}"}]}], "]"}]}], "}"}], ",", "\n", "   ", 
       RowBox[{"ListLinePlot", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"Flatten", "[", "\n", "     ", 
          RowBox[{
           RowBox[{"Table", "[", "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{"deltaList", ",", " ", "#"}], "}"}], "]"}], " ", 
                "&"}], ")"}], " ", "/@", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"sectorSpectrum", "[", "s", "]"}], "]"}]}], ",", "\n", 
             "      ", 
             RowBox[{"{", 
              RowBox[{"s", ",", " ", "sectors"}], "}"}]}], "]"}], ",", " ", 
           "1"}], "]"}], ",", "\n", "    ", 
         RowBox[{"PlotStyle", " ", "->", " ", 
          RowBox[{"Flatten", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"Table", "[", "\n", "       ", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{
                RowBox[{"sectorStyleMap", "[", "s", "]"}], ",", "\n", 
                "        ", 
                RowBox[{"Length", "[", 
                 RowBox[{"First", "[", 
                  RowBox[{"sectorSpectrum", "[", "s", "]"}], "]"}], "]"}]}], 
               "]"}], ",", "\n", "       ", 
