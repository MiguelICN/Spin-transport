     RowBox[{"up", " ", "=", " ", 
      RowBox[{"UnitVector", "[", 
       RowBox[{"32", ",", " ", "1"}], "]"}]}], ";", "\n", "  ", 
     RowBox[{"oneDown", " ", "=", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{
        RowBox[{"XXZHamiltonian", "[", 
         RowBox[{"1.3", ",", " ", "0.7", ",", " ", "3"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "3", ",", " ", "2"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"5", ",", " ", "3", ",", " ", "2"}], "}"}]}], "]"}], "]"}],
        "]"}]}], ";", "\n", "\n", "  ", 
     RowBox[{"TestReport", "[", 
      RowBox[{"{", "\n", "    ", 
       RowBox[{
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Head", "[", "hTest", "]"}], ",", " ", 
            RowBox[{"Dimensions", "[", "hTest", "]"}]}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"SparseArray", ",", " ", 
            RowBox[{"{", 
             RowBox[{"32", ",", " ", "32"}], "}"}]}], "}"}], ",", "\n", 
          "      ", 
          RowBox[{
          "TestID", " ", "->", " ", "\"\<Sparse matrix and dimension\>\""}]}],
          "]"}], ",", "\n", "    ", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"hTest", " ", "-", " ", 
              RowBox[{"ConjugateTranspose", "[", "hTest", "]"}]}], ",", 
             " ", "\"\<Frobenius\>\""}], "]"}], " ", "<", " ", "tolerance"}], 
          ",", "\n", "      ", "True", ",", " ", 
          RowBox[{"TestID", " ", "->", " ", "\"\<Hermiticity\>\""}]}], "]"}], 
        ",", "\n", "    ", 
        RowBox[{"VerificationTest", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"oneDown", " ", "-", " ", 
              RowBox[{"0.65", " ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}], ",", 
                 " ", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", " ", 
                   RowBox[{"-", "0.7"}], ",", " ", "1"}], "}"}], ",", " ", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", " ", "1", ",", " ", "0"}], "}"}]}], 
                "}"}]}]}], ",", "\n", "      ", "\"\<Frobenius\>\""}], "]"}], 
           " ", "<", " ", "tolerance"}], ",", " ", "True", ",", " ", 
          RowBox[{
          "TestID", " ", "->", 
           " ", "\"\<Open boundaries and bond normalization\>\""}]}], "]"}], ",",
         "\n", "    ", 
        RowBox[{"VerificationTest", "[", 
