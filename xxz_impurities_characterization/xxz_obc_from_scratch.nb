  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"H", 
     RowBox[{"(", "delta", ")"}]}], " ", "=", " ", 
    RowBox[{"Hxy", " ", "+", " ", 
     RowBox[{"delta", " ", 
      RowBox[{"Hz", ".", " ", "Build"}], " ", "these", " ", "matrices", " ", 
      RowBox[{"once", ".", "\n", "   ", "Each"}], " ", "row", " ", "of", " ", 
      RowBox[{"sectorSpectrum", "[", "m", "]"}], " ", "contains", " ", "the", 
      " ", "sorted", " ", "energies", " ", "at", " ", "one", " ", 
      RowBox[{"delta", ".", "\n", "   ", "Only"}], " ", "eigenvalues", " ", 
      "are", " ", "needed", " ", "for", " ", "this", " ", 
      RowBox[{"plot", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Hxy", " ", "=", " ", 
     RowBox[{"XXZHamiltonian", "[", 
      RowBox[{"J", ",", " ", "0", ",", " ", "L"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Hz", " ", "=", " ", 
     RowBox[{
      RowBox[{"XXZHamiltonian", "[", 
       RowBox[{"J", ",", " ", "1", ",", " ", "L"}], "]"}], " ", "-", " ", 
      "Hxy"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"spectrumSectors", " ", "=", " ", 
     RowBox[{"MagnetizationSectors", "[", "L", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"sectorSpectrum", " ", "=", " ", 
     RowBox[{"Association", "[", 
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", " ", "indices"}], "}"}], ",", "\n", "  ", 
          RowBox[{"m", " ", "->", " ", 
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a", " ", "=", " ", 
                RowBox[{"Normal", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"Hxy", "[", 
                   RowBox[{"[", 
                    RowBox[{"indices", ",", " ", "indices"}], "]"}], "]"}], 
                  "]"}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"b", " ", "=", " ", 
                RowBox[{"Normal", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"Hz", "[", 
                   RowBox[{"[", 
                    RowBox[{"indices", ",", " ", "indices"}], "]"}], "]"}], 
                  "]"}], "]"}]}]}], "}"}], ",", "\n", "    ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Sort", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"a", " ", "+", " ", 
                  RowBox[{"d", " ", "b"}]}], "]"}], "]"}], ",", " ", 
               RowBox[{"{", 
                RowBox[{"d", ",", " ", "deltaList"}], "}"}]}], "]"}]}], "\n", 
            "  ", "]"}]}]}], "]"}], ",", " ", "spectrumSectors"}], "]"}], 
      "]"}]}], ";"}]}]}]], "Code",
 CellLabel->"In[28]:=",ExpressionUUID->"ac0be14f-59e2-254e-9abd-3c7b51ee9409"]
