 RowBox[{
  RowBox[{"L", " ", "=", " ", "6"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", " ", "=", " ", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"pitch", " ", "=", " ", "0.7"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"anisotropy", " ", "=", " ", 
    RowBox[{"Cos", "[", "pitch", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"c", " ", "=", " ", 
   RowBox[{"J", " ", 
    RowBox[{
     RowBox[{"Sin", "[", "pitch", "]"}], "/", "2"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", " ", "=", " ", 
   RowBox[{
    RowBox[{"-", "c"}], " ", 
    RowBox[{"Cot", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"L", " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"pitch", "/", "2"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"endpointField", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"b", ",", " ", 
      RowBox[{"-", "c"}], ",", " ", "0"}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"h0", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"N", "[", 
      RowBox[{"XXZHamiltonian", "[", 
       RowBox[{"J", ",", " ", "anisotropy", ",", " ", "L"}], "]"}], "]"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hExact", " ", "=", " ", 
    RowBox[{"Normal", "[", 
     RowBox[{"N", "[", "\n", "    ", 
      RowBox[{"BoundaryXXZHamiltonian", "[", "\n", "     ", 
       RowBox[{
       "J", ",", " ", "anisotropy", ",", " ", "L", ",", " ", "endpointField", 
        ",", " ", "endpointField"}], "]"}], "]"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"hEdge", " ", "=", " ", 
    RowBox[{"hExact", " ", "-", " ", "h0"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"helixPlus", " ", "=", " ", 
   RowBox[{"N", "[", 
    RowBox[{"SpinHelixState", "[", 
     RowBox[{"L", ",", " ", "pitch", ",", " ", 
      RowBox[{"Pi", "/", "2"}], ",", " ", "0"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helixMinus", " ", "=", "\n", "  ", 
    RowBox[{"N", "[", 
     RowBox[{"SpinHelixState", "[", 
      RowBox[{"L", ",", " ", 
       RowBox[{"-", "pitch"}], ",", " ", 
       RowBox[{"Pi", "/", "2"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"L", " ", "-", " ", "1"}], ")"}], " ", "pitch"}]}], "]"}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helixEnergy", " ", "=", " ", 
    RowBox[{
     RowBox[{"J", " ", 
      RowBox[{"(", 
       RowBox[{"L", " ", "-", " ", "1"}], ")"}], " ", 
      RowBox[{"anisotropy", "/", "4"}]}], " ", "+", " ", "b"}]}], ";"}], "\n",
   "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Projector", " ", "onto", " ", "the", " ", "span", " ", "of", " ", "both", 
    " ", "helices"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"a", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"helixPlus", ",", " ", "helixMinus"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"aDag", " ", "=", " ", 
   RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"pHelix", " ", "=", " ", 
    RowBox[{"a", " ", ".", " ", 
     RowBox[{"Inverse", "[", 
      RowBox[{"aDag", " ", ".", " ", "a"}], "]"}], " ", ".", " ", "aDag"}]}], 
   ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Eigensystem", " ", "at", " ", "the", " ", "exact", " ", "point"}], ",", 
