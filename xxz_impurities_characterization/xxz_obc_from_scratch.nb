Cell[CellGroupData[{

Cell["2 - Magnetization sectors and eigenvectors", "Section",ExpressionUUID->"98f2f319-f132-4d40-90a4-02c7a63d0467"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Sz", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Sum", "[", "Z_j", "]"}], "/", "2."}], " ", "A", " ", "basis",
        " ", "state", " ", "with", " ", "r", " ", "down", " ", "spins", " ", 
       "has", " ", "Sz"}], " ", "=", " ", 
      RowBox[{
       RowBox[{"L", "/", "2"}], " ", "-", " ", 
       RowBox[{
        RowBox[{"r", ".", "\n", "   ", "Each"}], " ", "sector", " ", 
        "contains", " ", 
        RowBox[{"Binomial", "[", 
         RowBox[{"L", ",", " ", "r"}], "]"}], " ", "computational", " ", 
        "basis", " ", 
        RowBox[{"states", ".", "\n", "   ", "Basis"}], " ", "indices", " ", 
        "are", " ", "one"}], "-", "based"}]}]}], ",", " ", 
    RowBox[{"as", " ", "in", " ", 
     RowBox[{"Mathematica", "."}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "TotalMagnetization", ",", " ", "MagnetizationSectors", ",", " ", 
      "MagnetizationEigensystem"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"TotalMagnetization", "[", "n_Integer", "]"}], " ", "/;", " ", 
      RowBox[{"n", " ", ">=", " ", "1"}]}], " ", ":=", " ", 
     RowBox[{"SparseArray", "[", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], " ", "->", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"n", "/", "2"}], " ", "-", " ", 
           RowBox[{"DigitCount", "[", 
            RowBox[{"b", ",", " ", "2", ",", " ", "1"}], "]"}]}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"b", ",", " ", "0", ",", " ", 
            RowBox[{
             RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}]}], "}"}]}], 
         "]"}]}], ",", "\n", "  ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "n"}], ",", " ", 
         RowBox[{"2", "^", "n"}]}], "}"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"MagnetizationSectors", "[", "n_Integer", "]"}], " ", "/;", " ", 
      RowBox[{"n", " ", ">=", " ", "1"}]}], " ", ":=", "\n", "  ", 
     RowBox[{"GroupBy", "[", 
      RowBox[{
       RowBox[{"Range", "[", 
        RowBox[{"2", "^", "n"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "/", "2"}], " ", "-", " ", 
         RowBox[{"DigitCount", "[", 
          RowBox[{
           RowBox[{"#", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "1"}], 
          "]"}]}], " ", "&"}]}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"MagnetizationEigensystem", "[", 
      RowBox[{"h_", ",", " ", "groups_Association"}], "]"}], " ", ":=", " ", 
     RowBox[{"SortBy", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"m", ",", " ", "indices"}], "}"}], ",", " ", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"e", ",", " ", "v"}], "}"}], ",", "\n", "    ", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"e", ",", " ", "v"}], "}"}], " ", "=", " ", 
                 RowBox[{"Eigensystem", "[", 
                  RowBox[{"Normal", "[", 
                   RowBox[{"N", "[", 
                    RowBox[{"h", "[", 
                    RowBox[{"[", 
                    RowBox[{"indices", ",", " ", "indices"}], "]"}], "]"}], 
                    "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<Energy\>\"", " ", "->", " ", "#1"}], ",", 
                    " ", 
                    RowBox[{"\"\<Magnetization\>\"", " ", "->", " ", "m"}], ",",
                     "\n", "      ", 
                    RowBox[{"\"\<Vector\>\"", " ", "->", " ", 
                    RowBox[{"SparseArray", "[", 
                    RowBox[{
                    RowBox[{"Thread", "[", 
                    RowBox[{"indices", " ", "->", " ", "#2"}], "]"}], ",", 
                    " ", 
                    RowBox[{"{", 
                    RowBox[{"Length", "[", "h", "]"}], "}"}]}], "]"}]}]}], 
                    "|>"}], " ", "&"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"e", ",", " ", "v"}], "}"}]}], "]"}]}]}], "\n", 
              "  ", "]"}]}], "]"}], ",", " ", "groups"}], "]"}], ",", " ", 
         "1"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"#", "[", "\"\<Energy\>\"", "]"}], " ", "&"}]}], "]"}]}], 
    ";"}]}]}]], "Code",
 CellLabel->"In[9]:=",ExpressionUUID->"ab5e1bee-47a2-0748-8e18-cf66cbd290e0"],

