Cell[CellGroupData[{

Cell["Phantom states", "Section",ExpressionUUID->"0402f2c5-1844-f247-b804-8444c9ce63a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "SpinHelixState", "]"}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SpinHelixState", "[", 
    RowBox[{"n_Integer", ",", " ", "q_", ",", " ", 
     RowBox[{"theta_", ":", " ", 
      RowBox[{"Pi", "/", "2"}]}], ",", " ", 
     RowBox[{"phi_", ":", " ", "0"}]}], "]"}], " ", ":=", "\n", " ", 
