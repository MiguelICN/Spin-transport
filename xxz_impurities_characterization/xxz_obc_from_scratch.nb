Cell[CellGroupData[{

Cell["Helix states + boundary fields", "Section",ExpressionUUID->"2512b26b-c39d-f844-b136-a5c3f49a8ca7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "XXZ", " ", "with", " ", "endpoint", " ", "magnetic", " ", "fields"}], " ",
    "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "BoundaryField", ",", " ", "BoundaryXXZHamiltonian", ",", "\n", "  ", 
      "HelixXXZHamiltonian"}], "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BoundaryField", "[", "v_List", "]"}], " ", ":=", "\n", " ", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"v", "[", 
           RowBox[{"[", "k", "]"}], "]"}], " ", 
          RowBox[{"PauliMatrix", "[", "k", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "3"}], "}"}]}], "]"}], "/", "2"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"BoundaryXXZHamiltonian", "[", 
      RowBox[{
      "j_", ",", " ", "anisotropy_", ",", " ", "n_Integer", ",", "\n", "   ", 
       "hLeft_List", ",", " ", "hRight_List"}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{
      RowBox[{"XXZHamiltonian", "[", 
       RowBox[{"j", ",", " ", "anisotropy", ",", " ", "n"}], "]"}], " ", "+", 
      "\n", "  ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"BoundaryField", "[", "hLeft", "]"}], ",", "\n", "   ", 
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], ",", " ", 
          "SparseArray"}], "]"}]}], "]"}], " ", "+", "\n", "  ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{"n", " ", "-", " ", "1"}], ")"}]}], ",", " ", 
          "SparseArray"}], "]"}], ",", "\n", "   ", 
        RowBox[{"BoundaryField", "[", "hRight", "]"}]}], "]"}]}]}], ";"}], 
   "\n", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"HelixXXZHamiltonian", "[", 
      RowBox[{"j_", ",", " ", "pitch_", ",", " ", "n_Integer", ",", " ", 
       RowBox[{"phase_", ":", " ", "0"}], ",", "\n", "   ", 
       RowBox[{"bL_", ":", " ", "0"}], ",", " ", 
       RowBox[{"bR_", ":", " ", "0"}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", " ", "=", " ", 
          RowBox[{"phase", " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"n", " ", "-", " ", "1"}], ")"}], " ", "pitch"}]}]}], ",",
          " ", 
         RowBox[{"c", " ", "=", " ", 
          RowBox[{"j", " ", 
           RowBox[{
            RowBox[{"Sin", "[", "pitch", "]"}], "/", "2"}]}]}]}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{"BoundaryXXZHamiltonian", "[", 
        RowBox[{"j", ",", " ", 
         RowBox[{"Cos", "[", "pitch", "]"}], ",", " ", "n", ",", "\n", "   ", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "c"}], " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "phase", "]"}]}], ",", " ", 
             RowBox[{"Cos", "[", "phase", "]"}], ",", " ", "0"}], "}"}]}], 
          " ", "+", "\n", "    ", 
          RowBox[{"bL", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "phase", "]"}], ",", " ", 
             RowBox[{"Sin", "[", "phase", "]"}], ",", " ", "0"}], "}"}]}]}], ",",
          "\n", "   ", 
         RowBox[{
          RowBox[{"c", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"Sin", "[", "a", "]"}]}], ",", " ", 
             RowBox[{"Cos", "[", "a", "]"}], ",", " ", "0"}], "}"}]}], " ", "+",
           "\n", "    ", 
          RowBox[{"bR", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Cos", "[", "a", "]"}], ",", " ", 
             RowBox[{"Sin", "[", "a", "]"}], ",", " ", "0"}], "}"}]}]}]}], 
        "]"}]}], "\n", "  ", "]"}]}], ";"}]}]}]], "Code",
 CellLabel->"In[45]:=",ExpressionUUID->"8cb87e57-323b-1b4a-9cbd-2fe5462daaae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Example", " ", "and", " ", "full", " ", "diagonalization"}], " ", 
   "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"L", " ", "=", " ", "6"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"J", " ", "=", " ", "1."}], ";"}], "\n", 
   RowBox[{
    RowBox[{"helixPitch", " ", "=", " ", 
     RowBox[{"Pi", "/", "3"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"helixPhase", " ", "=", " ", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bLeft", " ", "=", " ", "0.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"bRight", " ", "=", " ", "0"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Hboundary", " ", "=", " ", 
     RowBox[{"HelixXXZHamiltonian", "[", "\n", "   ", 
      RowBox[{
      "J", ",", " ", "helixPitch", ",", " ", "L", ",", " ", "helixPhase", ",",
        " ", "bLeft", ",", " ", "bRight"}], "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"helixKet", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"SpinHelixState", "[", "\n", "    ", 
       RowBox[{"L", ",", " ", "helixPitch", ",", " ", 
        RowBox[{"Pi", "/", "2"}], ",", " ", "helixPhase"}], "]"}], "]"}]}], 
    ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"helixEnergy", " ", "=", " ", 
     RowBox[{
      RowBox[{"J", " ", 
       RowBox[{"(", 
        RowBox[{"L", " ", "-", " ", "1"}], ")"}], " ", 
       RowBox[{
        RowBox[{"Cos", "[", "helixPitch", "]"}], "/", "4"}]}], " ", "+", "\n",
       "   ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"bLeft", " ", "+", " ", "bRight"}], ")"}], "/", "2"}]}]}], 
    ";"}]}]}]], "Code",
 CellLabel->"In[49]:=",ExpressionUUID->"ed1ee929-612b-7e46-80ac-3e989b9c5ef8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"boundaryEnergies", ",", " ", "boundaryVectors"}], "}"}], " ", "=",
    "\n", " ", 
   RowBox[{"Eigensystem", "[", 
    RowBox[{"Normal", "[", 
     RowBox[{"N", "[", "Hboundary", "]"}], "]"}], "]"}]}], ";"}]], "Code",
 CellLabel->"In[58]:=",ExpressionUUID->"797f0147-f40f-914c-af1b-5d22fa094c39"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Dataset", "[", 
  RowBox[{"<|", "\n", "  ", 
   RowBox[{
    RowBox[{"\"\<Hermiticity residual\>\"", " ", "->", "\n", "   ", 
     RowBox[{"Chop", "[", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"Hboundary", " ", "-", " ", 
         RowBox[{"ConjugateTranspose", "[", "Hboundary", "]"}]}], ",", "\n", 
        "     ", "\"\<Frobenius\>\""}], "]"}], "]"}]}], ",", "\n", "  ", 
    RowBox[{"\"\<Helix eigenstate residual\>\"", " ", "->", "\n", "   ", 
     RowBox[{"Chop", "[", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{"Hboundary", " ", ".", " ", "helixKet"}], " ", "-", " ", 
        RowBox[{"helixEnergy", " ", "helixKet"}]}], "]"}], "]"}]}], ",", "\n",
     "  ", 
    RowBox[{"\"\<Magnetization commutator norm\>\"", " ", "->", "\n", "   ", 
     RowBox[{"Norm", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Hboundary", " ", ".", " ", 
         RowBox[{"TotalMagnetization", "[", "L", "]"}]}], " ", "-", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"TotalMagnetization", "[", "L", "]"}], " ", ".", " ", 
         "Hboundary"}]}], ",", " ", "\"\<Frobenius\>\""}], "]"}]}]}], "\n", 
   "  ", "|>"}], "]"}]], "Code",
 CellLabel->"In[59]:=",ExpressionUUID->"71e8693f-6b7a-1e40-8d2d-cc479de55b80"],

