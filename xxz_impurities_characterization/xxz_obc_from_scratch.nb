      "conversion", " ", "is", " ", "confined", " ", "to", " ", "these", " ", 
      "small", " ", 
      RowBox[{"tests", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "hTest", ",", " ", "uTest", ",", " ", "up", ",", " ", "oneDown", ",", 
      " ", 
