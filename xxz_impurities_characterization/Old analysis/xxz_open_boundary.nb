Cell[CellGroupData[{

Cell[" 1. Model, conventions, and free parameters ", "Section",ExpressionUUID->"d053a964-f005-cf45-add7-97cfba1a5c99"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "XXZSpin", ",", " ", "XXZHamiltonian", ",", " ", "XXZCharges", ",", " ", 
    "XXZSplitCharge", ",", " ", "XXZSectorED", ",", " ", "XXZEdgeDensity", ",",
     " ", "XXZRun", ",", " ", "XXZValidate", ",", " ", "XXZZeroQ"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "XXZHamiltonian", "]"}], " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\"\<UniformField\>\"", " ", "->", " ", "0"}], ",", " ", 
     RowBox[{"\"\<LeftField\>\"", " ", "->", " ", "0"}], ",", 
     RowBox[{"\"\<RightField\>\"", " ", "->", " ", "0"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"XXZHamiltonian", "::", "params"}], " ", "=", 
   " ", "\"\<Use integer L>=3 and finite real J, Delta, h, bLeft, \
bRight.\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"XXZSpin", "[", 
    RowBox[{"l_Integer", ",", " ", "a_Integer", ",", " ", "j_Integer"}], 
    "]"}], " ", ":=", "\n", "  ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"SparseArray", "[", 
         RowBox[{"IdentityMatrix", "[", "2", "]"}], "]"}], ",", " ", "l"}], 
       "]"}], ",", "\n", "    ", 
      RowBox[{"j", " ", "->", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "a", "]"}], "/", "2"}], "]"}]}]}], 
     "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"c0b5445a-8e1a-1d44-bac9-f587da4d6aa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XXZHamiltonian", "[", 
    RowBox[{"l_Integer", ",", " ", 
     RowBox[{"j_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"delta_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"OptionValue", "[", "\"\<UniformField\>\"", "]"}]}], ",", " ", 
       RowBox[{"bl", " ", "=", " ", 
        RowBox[{"OptionValue", "[", "\"\<LeftField\>\"", "]"}]}], ",", "\n", 
       "   ", 
       RowBox[{"br", " ", "=", " ", 
        RowBox[{"OptionValue", "[", "\"\<RightField\>\"", "]"}]}], ",", " ", 
       "sx", ",", " ", "sy", ",", " ", "sz"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"l", " ", "<", " ", "3"}], " ", "||", " ", 
         RowBox[{"!", 
          RowBox[{"And", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"Element", "[", 
                RowBox[{"#", ",", " ", "Reals"}], "]"}], "]"}], " ", "&"}], 
             " ", "/@", " ", 
             RowBox[{"{", 
              RowBox[{
              "j", ",", " ", "delta", ",", " ", "h", ",", " ", "bl", ",", " ",
                "br"}], "}"}]}], ")"}]}]}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"Message", "[", 
          RowBox[{"XXZHamiltonian", "::", "params"}], "]"}], ";", " ", 
         RowBox[{"Return", "[", "$Failed", "]"}]}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"sx", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"XXZSpin", "[", 
          RowBox[{"l", ",", " ", "1", ",", " ", "k"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "l"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"sy", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"XXZSpin", "[", 
          RowBox[{"l", ",", " ", "2", ",", " ", "k"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "l"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"sz", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"XXZSpin", "[", 
          RowBox[{"l", ",", " ", "3", ",", " ", "k"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "l"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"j", " ", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"sx", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ".", 
             RowBox[{"sx", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}]}], " ", "+", " ", 
            RowBox[{
             RowBox[{"sy", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ".", 
             RowBox[{"sy", "[", 
              RowBox[{"[", 
               RowBox[{"k", "+", "1"}], "]"}], "]"}]}], " ", "+", "\n", 
            "      ", 
            RowBox[{"delta", " ", 
             RowBox[{
              RowBox[{"sz", "[", 
               RowBox[{"[", "k", "]"}], "]"}], ".", 
              RowBox[{"sz", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1"}], "]"}], "]"}]}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", 
             RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}]}], " ", "+", " ", 
        RowBox[{"h", " ", 
         RowBox[{"Total", "[", "sz", "]"}]}], " ", "+", " ", 
        RowBox[{"bl", " ", 
         RowBox[{"First", "[", "sz", "]"}]}], " ", "+", " ", 
        RowBox[{"br", " ", 
         RowBox[{"Last", "[", "sz", "]"}]}]}], "]"}]}]}], "\n", " ", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{4.0005189384613075`*^9, 4.000518986186657*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"d646f921-04af-c646-89a6-682fec80e640"]
}, Closed]],

Cell[CellGroupData[{

Cell[" 2. Symmetry operators and sector construction ", "Section",ExpressionUUID->"9c1d8775-71b1-f844-9051-cf6af950197a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XXZZeroQ", "[", 
    RowBox[{"a_", ",", " ", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Max", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Normal", "[", 
        RowBox[{"N", "[", "a", "]"}], "]"}], "]"}], "]"}], "]"}], " ", "<", 
    " ", "tol"}]}], ";"}]], "Input",
 CellLabel->"In[6]:=",ExpressionUUID->"59a9a400-c31c-3748-a030-20f8367eeb80"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"XXZCharges", "[", 
    RowBox[{"l_Integer", ",", " ", "delta_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"2", "^", "l"}]}], ",", " ", "r", ",", " ", "f", ",", " ", 
       "sx", ",", " ", "sy", ",", " ", "sz", ",", " ", "s2", ",", "stagger", ",",
        " ", "result"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"r", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"FromDigits", "[", 
                RowBox[{
                 RowBox[{"Reverse", "[", 
                  RowBox[{"IntegerDigits", "[", 
                   RowBox[{"k", ",", "2", ",", "l"}], "]"}], "]"}], ",", 
                 "2"}], "]"}]}], ",", " ", 
              RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", "\n", 
           "      ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"d", "-", "k"}], ",", 
              RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", 
             RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<R\>\"", "->", "r"}], ",", " ", 
         RowBox[{"\"\<F\>\"", "->", "f"}], ",", " ", 
         RowBox[{"\"\<RF\>\"", "->", 
          RowBox[{"r", ".", "f"}]}]}], "|>"}]}], ";", "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"delta", " ", "==", " ", "1"}], "]"}], " ", "||", " ", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"delta", " ", "==", " ", 
           RowBox[{"-", "1"}]}], "]"}]}], ",", "\n", "    ", 
        RowBox[{
         RowBox[{"stagger", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"delta", " ", "==", " ", 
              RowBox[{"-", "1"}]}], "]"}], ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"-", "1"}], ")"}], "^", 
               RowBox[{"(", 
                RowBox[{"k", "-", "1"}], ")"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], ",", " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "l"}], "]"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"sx", " ", "=", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"stagger", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "*", 
              RowBox[{"XXZSpin", "[", 
               RowBox[{"l", ",", "1", ",", "k"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"sy", " ", "=", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"stagger", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "*", 
              RowBox[{"XXZSpin", "[", 
               RowBox[{"l", ",", "2", ",", "k"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"sz", " ", "=", " ", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"XXZSpin", "[", 
              RowBox[{"l", ",", "3", ",", "k"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
         "    ", 
         RowBox[{"s2", " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"sx", ".", "sx"}], " ", "+", " ", 
            RowBox[{"sy", ".", "sy"}], " ", "+", " ", 
            RowBox[{"sz", ".", "sz"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"result", ",", " ", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"delta", " ", "==", " ", "1"}], "]"}], 
              ",", "\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "]"}], " ", "->",
             " ", "s2"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", "result"}]}], 
    "\n", " ", "]"}]}], ";"}]], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"76576924-0ce9-ea45-b1e6-8dc78f99237b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "A", " ", "sector", " ", "basis", " ", "is", " ", "stored", " ", "as", " ",
      "columns", " ", "in", " ", "its", " ", "magnetization", " ", 
     RowBox[{"subspace", ".", "\n", "   ", "Diagonalize"}], " ", "each", " ", 
     "commuting", " ", "charge", " ", "within", " ", "the", " ", "already"}], 
    "-", 
    RowBox[{"resolved", " ", 
     RowBox[{"subspaces", ".", "\n", "   ", "Orthonormalize"}], " ", "within",
      " ", "equal"}], "-", 
    RowBox[{"charge", " ", "groups", " ", "before", " ", "further", " ", 
     RowBox[{"splitting", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"XXZSplitCharge", "[", 
     RowBox[{"sector_", ",", " ", "q_", ",", " ", "name_", ",", " ", "tol_"}],
      "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"sector", "[", "\"\<Basis\>\"", "]"}]}], ",", "\n", "    ", 
        "vals", ",", " ", "vecs", ",", " ", "groups", ",", " ", "sub", ",", 
        " ", "label"}], "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"vals", ",", "vecs"}], "}"}], " ", "=", " ", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", "q", ".", 
           "b"}], "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"groups", " ", "=", " ", 
        RowBox[{"Gather", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "vals", "]"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"vals", "[", 
               RowBox[{"[", "#1", "]"}], "]"}], "-", 
              RowBox[{"vals", "[", 
               RowBox[{"[", "#2", "]"}], "]"}]}], "]"}], " ", "<", " ", 
            "tol"}], " ", "&"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"Table", "[", "\n", "    ", 
        RowBox[{
         RowBox[{
          RowBox[{"sub", " ", "=", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Orthogonalize", "[", 
             RowBox[{"vecs", "[", 
              RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}]}], ";", "\n", 
          "    ", 
          RowBox[{"label", " ", "=", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "name"}], "]"}], ",", "\n", "      ", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "+", 
                    RowBox[{"4", " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"vals", "[", 
                    RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}]}]}], "]"}]}],
                  ")"}], "/", "2"}], ",", 
               RowBox[{"1", "/", "2"}]}], "]"}], ",", "\n", "      ", 
             RowBox[{"Round", "[", 
              RowBox[{"Re", "[", 
               RowBox[{"Mean", "[", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
            "]"}]}], ";", "\n", "    ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Basis\>\"", "->", 
             RowBox[{"b", ".", "sub"}]}], ",", " ", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"sector", "[", "\"\<Labels\>\"", "]"}], ",", "\n", 
               "        ", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"name", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{"name", "==", "\"\<StaggeredS2\>\""}], 
                    ",", "\"\<StaggeredS\>\"", ",", "name"}], "]"}]}], "]"}], 
                "->", "label"}]}], "]"}]}]}], "|>"}]}], ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{"g", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", " ", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[8]:=",ExpressionUUID->"8068cac3-b160-b54d-864d-d99964bb069b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Options", "[", "XXZSectorED", "]"}], " ", "=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"Options", "[", "XXZHamiltonian", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"\"\<Tolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "9"}]}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"XXZSectorED", "::", "check"}], " ", "=", 
   " ", "\"\<A sector residual exceeded tolerance: `1`. No result returned.\>\
\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"XXZSectorED", "[", 
    RowBox[{"l_Integer", ",", " ", 
     RowBox[{"j_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"delta_", "?", "NumericQ"}], ",", " ", 
     RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], " ", ":=", "\n", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", " ", "charges", ",", " ", 
       RowBox[{"tol", "=", 
        RowBox[{"OptionValue", "[", "\"\<Tolerance\>\"", "]"}]}], ",", " ", 
       RowBox[{"d", "=", 
        RowBox[{"2", "^", "l"}]}], ",", " ", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}], ",", " ", "ids", ",", " ", "hm", ",", "\n", 
       "    ", "m", ",", " ", "candidates", ",", " ", "sectors", ",", " ", 
       "q", ",", " ", "es", ",", " ", "vals", ",", " ", "rows", ",", " ", 
       "ord", ",", " ", "b", ",", " ", "fullRows", ",", " ", "residual", ",", 
       "\n", "    ", "leakage", ",", " ", "active", ",", " ", "pars", ",", 
       " ", "scale", ",", " ", "eigTol", ",", " ", "fields", ",", " ", 
       "eligible"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"pars", " ", "=", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
         RowBox[{"\"\<J\>\"", "->", "j"}], ",", 
         RowBox[{"\"\<Delta\>\"", "->", "delta"}], ",", "\n", "    ", 
         RowBox[{"\"\<UniformField\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<UniformField\>\"", "]"}]}], ",", 
         "\n", "    ", 
         RowBox[{"\"\<LeftField\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<LeftField\>\"", "]"}]}], ",", 
         RowBox[{"\"\<RightField\>\"", "->", 
          RowBox[{"OptionValue", "[", "\"\<RightField\>\"", "]"}]}]}], 
        "|>"}]}], ";", "\n", "  ", 
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"XXZHamiltonian", "[", 
        RowBox[{"l", ",", "j", ",", "delta", ",", 
         RowBox[{"\"\<UniformField\>\"", "->", 
          RowBox[{"pars", "[", "\"\<UniformField\>\"", "]"}]}], ",", "\n", 
         "    ", 
         RowBox[{"\"\<LeftField\>\"", "->", 
          RowBox[{"pars", "[", "\"\<LeftField\>\"", "]"}]}], ",", 
         RowBox[{"\"\<RightField\>\"", "->", 
          RowBox[{"pars", "[", "\"\<RightField\>\"", "]"}]}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"h", "===", "$Failed"}], ",", 
        RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", "\n", "  ", 
      RowBox[{"scale", " ", "=", " ", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", " ", 
         RowBox[{"Norm", "[", 
          RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", " ", 
      RowBox[{"eigTol", " ", "=", " ", 
       RowBox[{"100", " ", "tol", " ", "scale"}]}], ";", "\n", "  ", 
      RowBox[{"charges", " ", "=", " ", 
       RowBox[{"XXZCharges", "[", 
        RowBox[{"l", ",", "delta"}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Enforce", " ", "parameter", " ", "conditions", " ", "before", " ", 
        "numerical", " ", 
        RowBox[{"verification", ":", " ", 
         RowBox[{
         "a", " ", "tiny", "\n", "     ", "nonzero", " ", "field", " ", "is", 
          " ", "not", " ", "silently", " ", "interpreted", " ", "as", " ", 
          "an", " ", "exact", " ", 
