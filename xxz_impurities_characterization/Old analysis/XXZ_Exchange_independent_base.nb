Cell[" Time grids ", "Subsubsection",ExpressionUUID->"b62cdd94-7e3f-e74b-a8b9-6a9fcc2e7a4c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Linear", " ", "or", " ", "logarithmic", " ", "sampling"}], ",",
       " ", 
      RowBox[{
       RowBox[{"including", " ", "t"}], "=", 
       RowBox[{"0.", " ", "Linear", " ", "dt", " ", "is", " ", 
        RowBox[{"nominal", ":", " ", 
         RowBox[{"the", " ", "last", " ", "step", " ", "may", " ", "be", " ", 
          RowBox[{"shorter", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "t", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"realQ", "[", 
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
           ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
            "\n", "  ", 
           RowBox[{
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"realQ", "[", 
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
              ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
            RowBox[{"t", "=", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"Floor", "[", 
                  RowBox[{
                   RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                   RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], 
                "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Last", "[", "t", "]"}], "-", 
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
               RowBox[{
                RowBox[{"10", "^", 
                 RowBox[{"-", "12"}]}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",",
               "\n", "   ", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "=", 
               RowBox[{"N", "[", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"t", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
             "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
           RowBox[{
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"0", "<", 
                RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
               RowBox[{"IntegerQ", "[", 
                RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
                "\n", "   ", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}],
               ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
            "  ", 
            RowBox[{"t", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", "0.", "}"}], ",", 
               RowBox[{"Exp", "[", 
                RowBox[{"Subdivide", "[", 
                 RowBox[{
                  RowBox[{"Log", "[", 
                   RowBox[{"N", "[", 
                    RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                   "]"}], ",", 
                  RowBox[{"Log", "[", 
                   RowBox[{"N", "[", 
                    RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", 
                   "1"}]}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], 
           ",", "\n", " ", "_", ",", 
           RowBox[{"check", "[", 
            RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
            "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[23]:=",ExpressionUUID->"6dabd9e3-f0e5-1e48-8b2e-6f5adb9db299"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Plot and export helpers ", "Subsubsection",ExpressionUUID->"ebfd5f86-ba47-a042-b737-b62b20404ca3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Numeric", " ", "labels", " ", "use", " ", "decimals", " ", "rather", " ",
       "than", " ", 
      RowBox[{"fractions", "."}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"texNumber", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", ",", "p"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"x", "==", "0"}], "]"}], ",", 
           RowBox[{"Return", "[", "\"\<0\>\"", "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"x", "==", 
              RowBox[{"Round", "[", "x", " ", "]"}]}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "<", 
             RowBox[{"10", "^", "6"}]}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"ToString", "[", 
             RowBox[{"Round", "[", "x", " ", "]"}], "]"}], "]"}]}], "]"}], ";",
          "\n", " ", 
         RowBox[{"s", "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"p", "=", 
          RowBox[{"StringSplit", "[", 
           RowBox[{"s", ",", "\"\<*^\>\""}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "p", "]"}], "==", "2"}], ",", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<\\\\times 10^{\>\"", "<>", 
            RowBox[{"p", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "<>", "\"\<}\>\""}], ",", 
           RowBox[{"First", "[", "p", " ", "]"}]}], "]"}]}]}], "\n", "]"}]}], 
     ";", "\n", 
     RowBox[{
      RowBox[{"ticks", "[", 
       RowBox[{
        RowBox[{"lo_", "?", "NumericQ"}], ",", 
        RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", "lo"}], ",", 
          RowBox[{"b", "=", "hi"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"a", "==", "b"}], ",", 
           RowBox[{
            RowBox[{"a", "-=", "1"}], ";", 
            RowBox[{"b", "+=", "1"}]}]}], "]"}], ";", "\n", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"tex", "[", 
               RowBox[{
                RowBox[{"texNumber", "[", "#", "]"}], ",", "14"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
           " ", 
           RowBox[{"FindDivisions", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b"}], "}"}], ",", "5"}], "]"}]}], ")"}]}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"logTicks", "[", 
       RowBox[{
        RowBox[{"lo_", "?", "NumericQ"}], ",", 
        RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"#", " ", 
             RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
           RowBox[{"tex", "[", 
            RowBox[{
             RowBox[{"\"\<10^{\>\"", "<>", 
              RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<}\>\""}], ",", 
             "14"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
        "\n", "  ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"lo", "/", 
            RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"hi", "/", 
            RowBox[{"Log", "[", "10", "]"}]}], "]"}]}], "]"}]}], ")"}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"sectorLabel", "[", "a_", "]"}], " ", ":=", " ", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", "\n", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Switch", "[", 
             RowBox[{
             "#1", ",", "\"\<R\>\"", ",", "\"\<r\>\"", ",", "\"\<F\>\"", 
              ",", "\"\<f\>\"", ",", "\"\<RF\>\"", ",", "\"\<rf\>\"", 
              ",", "\"\<StaggeredS\>\"", ",", "\"\<S_{\\\\rm stag}\>\"", ",", 
              "_", ",", "#1"}], "]"}], "<>", "\n", "  ", "\"\<=\>\"", "<>", 
            RowBox[{"texNumber", "[", "#2", "]"}]}], "&"}], ",", "a"}], "]"}],
         ",", "\"\<,\\\\quad \>\""}], "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "A", " ", "common", " ", "dimension", " ", "for", " ", "equivalent", " ",
         "sectors"}], ";", " ", 
       RowBox[{"otherwise", " ", "use", " ", "legend", " ", 
        RowBox[{"order", "."}]}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"dimLabel", "[", "dims_List", "]"}], " ", ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"SameQ", "@@", "dims"}], ",", "\n", " ", 
        RowBox[{"\"\<d_{\\\\mathrm{sector}}=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"First", "[", "dims", "]"}], "]"}]}], ",", "\n", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<d_{\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<}=\>\"", "<>", 
              RowBox[{"ToString", "[", "#1", "]"}]}], "&"}], ",", "dims"}], 
           "]"}], ",", "\"\<,\\\\quad \>\""}], "]"}]}], "]"}]}], ";"}], "\n", 
