             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"Missing", "[", 
                RowBox[{"\"\<NearSingularMap\>\"", ",", "sv"}], "]"}], ",", 
               "15"}], "]"}]}]}]}], "]"}], ";", "\n", " ", 
         RowBox[{"mixed", "=", 
          RowBox[{"applyTransfer", "[", 
