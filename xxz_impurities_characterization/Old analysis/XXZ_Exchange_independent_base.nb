               RowBox[{"x", "<=", "cut"}]}]}], "]"}]}], ",", 
           RowBox[{"\"\<GapResolution\>\"", "->", "cut"}], ",", "\n", "  ", 
           RowBox[{"\"\<Ratios\>\"", "->", "ratios"}], ",", 
           RowBox[{"\"\<MeanR\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
