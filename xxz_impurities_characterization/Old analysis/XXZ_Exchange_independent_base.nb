Cell["\<\
 Examples for direct use: applyTransfer[mapRecords[[k]][\"Transfer\"],rhoAB] \
predicts any product-preparation edge input; mapRecords[[k]][\"ChoiState\"] \
is the normalized input-output Choi state. No chapter-2 evaluation is used. \
\>", "Text",ExpressionUUID->"357316bf-2360-1745-9ba3-eb3ec6c635c6"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 4. Quantum-state texture of the edge spins ", "Title",ExpressionUUID->"55fa5f3c-57bd-1347-820b-0fcd2f44dced"],

Cell[CellGroupData[{

Cell[" 4.1 Definitions shared only by the QST sections ", "Subsection",ExpressionUUID->"6d681cc2-e305-a24c-863f-d6d79ef04e29"],

Cell["\<\
 Sections A and B reuse initialization definitions, never evaluated results \
of chapters 1\[Dash]3 or of each other. Only the two edges are placed in \
f1=|++><++|; an all-plus bulk is excluded. The basis is {00,01,10,11}, with \
bit 0=up. All quantities are basis dependent. Sigma(rho)=sum of every matrix \
entry=D <f1|rho|f1>; TF=1-Sigma/D; R=-log(Sigma/D). D=4 for the pair and D=2 \
for a single edge. SigmaAB/4 is the probability of ++ (Hadamards followed by \
00). Nonmultiplicativity is SigmaAB-SigmaA SigmaB; l1 coherence sums absolute \
off-diagonal entries. References: the supplied QST specification, [P] de Leon \
et al., Role of quantum state texture in quantum chaos (draft), and [V] \
Vieira et al., arXiv:2609.05248. No claim about chaos follows from texture \
alone. \
\>", "Text",ExpressionUUID->"0b68b895-318e-2443-9469-c88304cf8652"],

Cell[CellGroupData[{

Cell[" Texture, evolution, averages and validation ", "Subsubsection",ExpressionUUID->"f7b7d7eb-cb7f-2a48-803a-4e3859205aa5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "edgeF1Ket", ",", "edgeF1", ",", "grandSum", ",", "textureF", ",", 
       "rugosity", ",", "l1Coherence", ",", "textureRecords", ",", "\n", " ", 
       "responseOperator", ",", "texturizingRecord", ",", "qstBulkFactor", ",",
        "qstRunChunks", ",", "qstStateChunk", ",", "qstMapChunk", ",", "\n", 
       " ", "qstStateRecords", ",", "qstMapRecords", ",", "qstAverageState", ",",
        "qstAverageChannel", ",", "qstWindowMean", ",", "\n", " ", 
       "qstReferenceTrace", ",", "qstReferenceEmbed", ",", 
       "qstSmallReference", ",", "qstStateChecks", ",", "qstMapChecks", ",", 
       "\n", " ", "qstRandomResponseCheck", ",", "qstCompare", ",", 
       "qstSaveComparison", ",", "qstEdgeConservationError", ",", "qstTex", ",",
        "qstTicks", ",", "qstCaption", ",", "qstPanel", ",", "\n", " ", 
       "texturePanels", ",", "texturizingPanels", ",", "qstExport"}], "]"}], ";",
      "\n", 
     RowBox[{"edgeF1Ket", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], ";", 
     RowBox[{"edgeF1", "=", 
      RowBox[{"ketRho", "[", "edgeF1Ket", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"grandSum", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"Re", "[", 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "r", "]"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"textureF", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"grandSum", "[", "r", "]"}], "/", 
        RowBox[{"Length", "[", "r", "]"}]}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"rugosity", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"grandSum", "[", "r", "]"}], "/", 
           RowBox[{"Length", "[", "r", "]"}]}]}], "}"}], ",", "\n", " ", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"p", "==", "0"}], "]"}], ",", "Infinity", ",", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"p", ">", "0"}], "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"Log", "[", "p", "]"}]}], ",", "True", ",", 
          RowBox[{"Missing", "[", 
           RowBox[{"\"\<NegativeGrandSum\>\"", ",", "p"}], "]"}]}], "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"l1Coherence", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Abs", "[", "r", "]"}], "]"}], "]"}], "-", 
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Diagonal", "[", "r", "]"}], "]"}], "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"textureRecords", "[", "records_List", "]"}], " ", ":=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"rec", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r", "=", 
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", 
              RowBox[{"a", "=", 
               RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
              RowBox[{"b", "=", 
               RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}]}], "}"}], ",", 
            "\n", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"rec", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<SigmaAB\>\"", "->", 
                 RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<SigmaA\>\"", "->", 
                 RowBox[{"grandSum", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<SigmaB\>\"", "->", 
                 RowBox[{"grandSum", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<TextureFAB\>\"", "->", 
                 RowBox[{"textureF", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<TextureFA\>\"", "->", 
                 RowBox[{"textureF", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<TextureFB\>\"", "->", 
                 RowBox[{"textureF", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<RugosityAB\>\"", "->", 
                 RowBox[{"rugosity", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<RugosityA\>\"", "->", 
                 RowBox[{"rugosity", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<RugosityB\>\"", "->", 
                 RowBox[{"rugosity", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<Nonmultiplicativity\>\"", "->", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"grandSum", "[", "r", "]"}], "-", 
                   RowBox[{
                    RowBox[{"grandSum", "[", "a", "]"}], " ", 
                    RowBox[{"grandSum", "[", "b", "]"}]}]}], ")"}]}], ",", 
                "\n", " ", 
                RowBox[{"\"\<L1Coherence\>\"", "->", 
                 RowBox[{"l1Coherence", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<L1Normalized\>\"", "->", 
                 RowBox[{
                  RowBox[{"l1Coherence", "[", "r", "]"}], "/", "3"}]}], ",", 
                "\n", " ", 
                RowBox[{"\"\<LinearEntropy\>\"", "->", 
                 RowBox[{"1", "-", 
                  RowBox[{"rec", "[", "\"\<Purity\>\"", "]"}]}]}], ",", 
                RowBox[{"\"\<NormalizedEntropy\>\"", "->", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<EntropyAB\>\"", "]"}], "/", 
                  RowBox[{"Log", "[", "4", "]"}]}]}], ",", "\n", " ", 
                RowBox[{"\"\<F1Probability\>\"", "->", 
                 RowBox[{"Re", "[", 
                  RowBox[{
                   RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", 
                   " ", "r", " ", ".", " ", "edgeF1Ket"}], "]"}]}]}], 
               "|>"}]}], "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"responseOperator", "[", 
       RowBox[{"s_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Total", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[89]:=",ExpressionUUID->"05d379b8-2cd2-ae4b-8b52-1a0a17d71c68"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstBulkFactor", "[", 
       RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{
            RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "f", ",",
           "theta", ",", "phi", ",", "prob"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], 
             "==", "\"\<PolarHelix\>\""}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{"theta", "=", 
              RowBox[{"spec", "[", "\"\<ThetaList\>\"", "]"}]}], ";", 
             RowBox[{"phi", "=", 
              RowBox[{"Lookup", "[", 
               RowBox[{"spec", ",", "\"\<PhiList\>\"", ",", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", "n"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "theta", "]"}], "==", "n"}], " ", "&&",
                 " ", 
                RowBox[{
                 RowBox[{"Length", "[", "phi", "]"}], "==", "n"}], " ", "&&", 
                " ", 
                RowBox[{"AllTrue", "[", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"theta", ",", "phi"}], "]"}], ",", "realQ"}], 
                 "]"}]}], ",", "\n", 
               "   ", "\"\<PolarHelix requires real ThetaList and PhiList \
with L-2 entries.\>\""}], "]"}], ";", "\n", "  ", 
             RowBox[{"stateFactor", "[", 
              RowBox[{
               RowBox[{"productKet", "[", 
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"I", " ", "#2"}], "]"}], " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}]}]}], "}"}], "&"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"theta", ",", "phi"}], "}"}]}], "]"}], "]"}], ",", 
               RowBox[{"2", "^", "n"}], ",", "tol"}], "]"}]}], ",", "\n", 
            "  ", 
            RowBox[{"bulkFactor", "[", 
             RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"prob", "=", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{"2", "^", "n"}], "]"}]}], ",", 
               RowBox[{"2", "^", "n"}]}], "]"}], " ", ".", " ", "f"}], "]"}], 
           "^", "2"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"1", "-", "prob"}], "]"}], ">", "tol"}], 
           ",", "\"\<QST: an all-plus bulk is excluded; f1 is reserved for \
the two edges.\>\""}], "]"}], ";", "f"}]}], "\n", "]"}]}], ";"}], "\n", ")"}],
    ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[90]:=",ExpressionUUID->"5b06568b-5db8-8b41-86e4-1b97300227b2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstRunChunks", "[", 
       RowBox[{"fn_", ",", "times_List", ",", "eng_", ",", "cfg_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bytes", ",", "size", ",", "chunks", ",", "results", ",", 
          RowBox[{"kernels", "=", "1"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{"And", "@@", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], 
              "]"}]}]}], ",", "\"\<QST times must increase.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], "]"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ">", "0"}], " ", 
            "&&", " ", 
            RowBox[{"realQ", "[", 
             RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], "]"}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], ">", "0"}], " ", "&&",
             "\n", "  ", 
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ">", "0"}]}], 
           ",", "\"\<Invalid QST parallel/batch settings.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
           "  ", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
              RowBox[{"Quiet", "[", 
               RowBox[{"LaunchKernels", "[", 
                RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], "]"}]}], 
             "]"}], ";", "\n", "  ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}], 
              ",", "\"\<No parallel kernels available. Set Enabled->False for \
serial batches.\>\""}], "]"}], ";", "\n", "  ", 
            RowBox[{"kernels", "=", 
             RowBox[{"Length", "[", 
              RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
            RowBox[{"DistributeDefinitions", "[", 
             RowBox[{"qstStateChunk", ",", "qstMapChunk"}], "]"}]}]}], "]"}], 
         ";", "\n", " ", 
         RowBox[{"bytes", "=", 
          RowBox[{"16", " ", 
           RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}], " ", 
           RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}]}], ";", "\n", " ", 
         RowBox[{"size", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ",", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], " ", 
              RowBox[{
               RowBox[{"2", "^", "20"}], "/", 
               RowBox[{"(", 
                RowBox[{"4", " ", "kernels", " ", "bytes"}], ")"}]}]}], 
             "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"size", ">=", "1"}], ",", 
           
           RowBox[{"\"\<QST batch memory budget is too small. Minimum \
MemoryMB for one factor per worker: \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"4", " ", "kernels", " ", 
               RowBox[{"bytes", "/", 
                RowBox[{"2", "^", "20"}]}]}], "]"}], "]"}], 
            "<>", "\"\<. This excludes eigensystems and retained \
records.\>\""}]}], "]"}], ";", "\n", " ", 
         RowBox[{"chunks", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{"times", ",", 
            RowBox[{"UpTo", "[", "size", "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"results", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
            "  ", 
            RowBox[{"ParallelMap", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"ts", ",", 
                RowBox[{"CheckAbort", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
               "]"}], ",", "chunks", ",", 
              RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",",
             "\n", "  ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"ts", ",", 
                RowBox[{"CheckAbort", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
               "]"}], ",", "chunks"}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ListQ", "[", "results", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "results", "]"}], "==", 
             RowBox[{"Length", "[", "chunks", "]"}]}], " ", "&&", "\n", "  ", 
            RowBox[{"And", "@@", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"ListQ", "[", "#1", "]"}], " ", "&&", " ", 
                  RowBox[{
                   RowBox[{"Length", "[", "#1", "]"}], "==", 
                   RowBox[{"Length", "[", "#2", "]"}]}], " ", "&&", " ", 
                  RowBox[{"AllTrue", "[", 
                   RowBox[{"#1", ",", "AssociationQ"}], "]"}]}], ")"}], "&"}],
                ",", 
               RowBox[{"{", 
                RowBox[{"results", ",", "chunks"}], "}"}]}], "]"}]}]}], ",", 
           "\n", "  ", "\"\<A QST batch failed or aborted; no partial \
trajectory is returned.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"results", ",", "1"}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstStateChunk", "[", 
       RowBox[{"times_", ",", "eng_", ",", "fac_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{"evolveBatch", "[", 
            RowBox[{"times", ",", "eng"}], "]"}]}], ",", "rho0", ",", 
          "purity0"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"rho0", "=", 
          RowBox[{"reducedState", "[", 
           RowBox[{"fac", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"purity0", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ",
                "fac"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"stateRecord", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", 
             "eng", ",", "fac", ",", "rho0", ",", "purity0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstStateRecords", "[", 
       RowBox[{"eng_", ",", "fac_", ",", "times_", ",", "cfg_"}], "]"}], " ", 
      ":=", " ", 
      RowBox[{"textureRecords", "[", "\n", " ", 
       RowBox[{"qstRunChunks", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"ts", ",", 
