             RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], "]"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], ">", "0"}], " ",
             "&&", " ", 
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], "]"}], 
            " ", "&&", " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], ">", 
