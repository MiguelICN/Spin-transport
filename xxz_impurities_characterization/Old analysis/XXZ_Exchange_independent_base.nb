       RowBox[{"p_", ",", 
        RowBox[{"extra_", ":", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"tex", "[", 
           RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
