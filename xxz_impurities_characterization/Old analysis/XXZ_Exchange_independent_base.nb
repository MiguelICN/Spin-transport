Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapDirectory", "=", 
     RowBox[{"exportBundle", "[", 
      RowBox[{
      "mapOutputRoot", ",", "mapRunLabel", ",", "mapPlotsUsed", ",", "\n", 
       " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
