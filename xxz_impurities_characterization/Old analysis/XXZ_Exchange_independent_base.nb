       "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"First", "[", 
       RowBox[{"Values", "[", "statDeltaPlots", "]"}], "]"}], "]"}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Code",ExpressionUUID->"e4894246-b2c8-4f43-\
aeee-23497569a074"]
}, Closed]],

Cell[CellGroupData[{

Cell[" 1.9 Export this scan ", "Subsection",ExpressionUUID->"8394b964-9a81-324a-86c9-b35dfbbad47d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"statDeltaDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{
       "statDeltaOutputRoot", ",", "statDeltaRunLabel", ",", "statDeltaPlots",
         ",", "\n", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"statDeltaRun", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Seconds\>\"", "->", "statDeltaSeconds"}], ",", 
            RowBox[{"\"\<PlotSettings\>\"", "->", "statDeltaPlotSettings"}]}],
            "|>"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", "statDeltaDirectory", "]"}], ";"}], "\n", ")"}], 
   ";"}], "\n"}]], "Code",ExpressionUUID->"a04edd54-5b39-d842-94bd-\
0a542bd57341"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.10 Optional DOS inspection before choosing a gap-ratio rank window \
\>", "Subsection",ExpressionUUID->"fb905528-1e6b-6d4b-be38-47ef9f3388de"],

Cell["\<\
 This postprocessing section uses one completed static scan of your choice. \
It never merges distinct symmetry sectors. Inspect normalized DOS and \
empirical CDF first, then edit diagRankWindow and rerun the diagnostic cells. \
The orange lines show the actual rank-window energy boundaries; a rank \
fraction is not an energy fraction. This section does not affect either \
dynamics chapter. \
\>", "Text",ExpressionUUID->"f0972a66-1621-9a42-96a9-221110b6bb5d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagRun", "=", "statGRun"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Or", " ", 
       RowBox[{"statDeltaRun", "."}]}], " ", "*)"}], "\n", " ", 
     RowBox[{"diagSector", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<m\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<F\>\"", "->", "1"}]}], "|>"}]}], ";", "\n", " ", 
     RowBox[{"diagRankWindow", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], ";", 
     RowBox[{"diagBins", "=", "30"}], ";", "\n", " ", 
     RowBox[{"diagGapResolution", "=", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ";", 
     RowBox[{"diagBlockLength", "=", "10"}], ";", "\n", " ", 
     RowBox[{"diagMinimumDimension", "=", "500"}], ";", 
     RowBox[{"diagMinimumRatios", "=", "100"}], ";", "\n", " ", 
     RowBox[{"diagLogHorizontalAxis", "=", "False"}], ";", "\n", " ", 
     RowBox[{"diagSampleIndices", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}], "/", 
           "2"}], "]"}], ",", 
         RowBox[{"Length", "[", 
          RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "}"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"diagOutputRoot", "=", 
      RowBox[{"resultRoot", "[", "]"}]}], ";", 
     RowBox[{"diagRunLabel", "=", "\"\<Exchange_spectral_diagnostics\>\""}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Code",ExpressionUUID->"4c39336a-\
d3d1-ac4d-a0ca-6fc3b3b342f8"],

Cell[BoxData[""], "Input",ExpressionUUID->"6fa25268-d617-de47-9936-5d094999c5b8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagDOS", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "=", 
             RowBox[{
              RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"selectedStaticSector", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "diagSector"}], 
              "]"}]}]}], "}"}], ",", "\n", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<PointIndex\>\"", "->", "k"}], ",", 
            RowBox[{"\"\<Model\>\"", "->", 
             RowBox[{"p", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
            RowBox[{"\"\<DOS\>\"", "->", 
             RowBox[{"sectorDOS", "[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
               "diagRankWindow", ",", "diagBins"}], "]"}]}]}], "|>"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "diagSampleIndices"}], "}"}]}], "]"}]}], ";", "\n",
      " ", 
     RowBox[{"diagDOSPlots", "=", 
      RowBox[{"Association", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\"\<point_\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"row", "[", "\"\<PointIndex\>\"", "]"}], "]"}], 
                 "<>", "\"\<_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], "&"}], 
             ",", "\n", " ", 
             RowBox[{"dosPanels", "[", 
              RowBox[{
               RowBox[{"row", "[", "\"\<DOS\>\"", "]"}], ",", 
               RowBox[{"row", "[", "\"\<Model\>\"", "]"}], ",", 
               RowBox[{"row", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"row", ",", "diagDOS"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"First", "[", 
       RowBox[{"Values", "[", "diagDOSPlots", "]"}], "]"}], "]"}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Code",ExpressionUUID->"eee2c613-961c-7c4d-\
acd6-912404c9f5a2"],

Cell["\<\
 The L=8 static defaults are small demonstrations: their default ZZ/exchange \
windows contain only 4/11 ratios. The gap mean is withheld below \
diagMinimumDimension=500 or diagMinimumRatios=100. DOS remains available. For \
quantitative work select a sufficiently large resolved sector and recompute \
its spectrum; inspect the actual dimension and error estimate. Reducing these \
thresholds deliberately is a demonstration, not evidence of a crossover. \
\>", "Text",ExpressionUUID->"c9fdbe7a-54a6-4644-8389-15f6fcde6152"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.11 Optional gap-ratio calculation and export after DOS inspection \
\>", "Subsection",ExpressionUUID->"2b5f8f6c-087d-4d4e-a9f3-bef966e41f19"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"check", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"diagDOS", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<DOS\>\"", "]"}], "[", "\"\<RankWindow\>\"",
             "]"}], "===", "diagRankWindow"}], "&"}]}], "]"}], ",", "\n", 
       " ", "\"\<RankWindow changed: rerun the DOS data/plot cell to refresh \
the displayed boundaries first.\>\""}], "]"}], ";", "\n", 
     RowBox[{"diagGapRows", "=", 
      RowBox[{"gapScan", "[", 
       RowBox[{
       "diagRun", ",", "diagSector", ",", "diagRankWindow", ",", 
        "diagGapResolution", ",", "diagBlockLength", ",", 
        "diagMinimumDimension", ",", "diagMinimumRatios"}], "]"}]}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KeyTake", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Parameter\>\"", ",", "\"\<SectorDimension\>\"", 
             ",", "\"\<WindowRanks\>\"", ",", "\"\<Status\>\"", 
             ",", "\"\<MeanR\>\"", ",", "\"\<BlockSEM\>\""}], "}"}]}], "]"}], 
         "&"}], " ", "/@", " ", "diagGapRows"}], "]"}], "]"}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Code",ExpressionUUID->"9a0516ad-4b53-3d43-96a9-\
c05b17772f37"],

Cell["\<\
 No levels are removed or unfolded. Any unresolved gap pair makes that mean \
Missing. IID and contiguous-block standard errors are descriptive estimates, \
not calibrated independent-sample confidence intervals. Delta=0 has extra \
integrable charges and degeneracies; Delta=+/-1/2 is a special \
bulk-degeneracy control. A mean alone is not a chaos diagnosis. \
\>", "Text",ExpressionUUID->"0eaf9ee8-2dd2-a946-892a-5987840c1091"],

Cell[BoxData[""], "Input",ExpressionUUID->"f16d6085-f86a-e14e-9b8c-58f43c597db1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagGapPlot", "=", 
      RowBox[{"gapPanel", "[", 
       RowBox[{"diagGapRows", ",", "diagRun", ",", "diagLogHorizontalAxis"}], 
       "]"}]}], ";", "\n", " ", "diagGapPlot"}], "\n", ")"}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"1cc89790-8417-e943-922b-d7863e4f1316"],

Cell[BoxData[""], "Input",ExpressionUUID->"2b43c3bd-ef4e-714f-bfe4-7f7100c959c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{"diagOutputRoot", ",", "diagRunLabel", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"diagDOSPlots", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<MeanGapRatio\>\"", "->", "diagGapPlot"}], "|>"}]}], 
         "]"}], ",", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Axis\>\"", "->", 
           RowBox[{"diagRun", "[", "\"\<Axis\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Grid\>\"", "->", 
           RowBox[{"diagRun", "[", "\"\<Grid\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Sector\>\"", "->", "diagSector"}], ",", 
          RowBox[{"\"\<RankWindow\>\"", "->", "diagRankWindow"}], ",", "\n", 
          " ", 
          RowBox[{"\"\<DOS\>\"", "->", "diagDOS"}], ",", 
          RowBox[{"\"\<GapRows\>\"", "->", "diagGapRows"}], ",", 
          RowBox[{"\"\<GapResolution\>\"", "->", "diagGapResolution"}], ",", 
          RowBox[{"\"\<BlockLength\>\"", "->", "diagBlockLength"}], ",", 
          RowBox[{"\"\<MinimumDimension\>\"", "->", "diagMinimumDimension"}], 
          ",", 
          RowBox[{"\"\<MinimumRatios\>\"", "->", "diagMinimumRatios"}]}], 
         "|>"}]}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", "diagDirectory", "]"}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"825f476c-4253-f847-95ff-7c37c27cac3a"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 2. Dynamics of the reduced edge density matrix ", "Title",ExpressionUUID->"e05fc0ce-de1c-074f-a8c1-46dbd2ad707d"],

Cell[CellGroupData[{

Cell[" 2.1 Definitions: state preparations and observables ", "Subsection",ExpressionUUID->"56af9516-e489-244e-bb9c-0ba0ed9c05c9"],

Cell[CellGroupData[{

Cell[" State preparation and complete state-observable records ", \
"Subsubsection",ExpressionUUID->"7b3ffc48-dfb7-cd43-868a-6677ad3692d3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Edge", " ", "observables", " ", "from", " ", "the", " ", "4", " ", "x",
        " ", "environment"}], "-", 
      RowBox[{"rank", " ", "coefficient", " ", 
       RowBox[{"matrix", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"observables", "[", 
       RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", 
          "z", ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"a", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
         RowBox[{"a1", "=", 
          RowBox[{"traceB", "[", "r", "]"}]}], ";", 
         RowBox[{"b1", "=", 
          RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
          RowBox[{"entropy", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "z"}], "}"}], "=", 
          RowBox[{"PauliMatrix", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
         RowBox[{"ma", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
         RowBox[{"mb", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
         RowBox[{"e", "=", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Sort", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
           RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
           RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
           RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
           RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
           RowBox[{"\"\<Purity\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
           RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
           RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
           RowBox[{"\"\<MutualInfo\>\"", "->", 
            RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
           RowBox[{"\"\<Concurrence\>\"", "->", 
            RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
           RowBox[{"\"\<Negativity\>\"", "->", 
            RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<InitialOverlap\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
           RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
           RowBox[{"\"\<ConnectedZZ\>\"", "->", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
              "]"}], "-", 
             RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
           RowBox[{"\"\<ConnectedXX\>\"", "->", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
              "]"}], "-", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"Tr", "[", 
                RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
              RowBox[{"Re", "[", 
               RowBox[{"Tr", "[", 
                RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
           "\n", "  ", 
           RowBox[{"\"\<TraceError\>\"", "->", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
           RowBox[{"\"\<HermiticityError\>\"", "->", 
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"r", "-", 
               RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<MinEigenvalue\>\"", "->", 
            RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
