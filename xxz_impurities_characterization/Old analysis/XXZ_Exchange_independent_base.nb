              RowBox[{"{", 
               RowBox[{
                RowBox[{"tex", "[", 
                 RowBox[{"xlabel", ",", "20"}], "]"}], ",", "None"}], "}"}]}],
              "}"}]}], ",", "\n", "   ", 
           RowBox[{"FrameTicks", "->", 
            RowBox[{"{", 
