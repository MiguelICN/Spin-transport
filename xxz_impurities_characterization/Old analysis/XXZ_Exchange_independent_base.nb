               RowBox[{
                RowBox[{"Min", "[", "#", "]"}], "/", 
                RowBox[{"Max", "[", "#", "]"}]}]}], "]"}], "&"}], ",", 
            "pairs"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"unresolved", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"ratios", ",", "_Missing"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"status", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], "<", "3"}], 
            ",", "\"\<TooFewLevels\>\"", ",", 
            RowBox[{"unresolved", ">", "0"}], ",", "\"\<UnresolvedGaps\>\"", ",",
             "True", ",", "\"\<OK\>\""}], "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<SectorDimension\>\"", "->", "d"}], ",", 
           RowBox[{"\"\<WindowRanks\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
           RowBox[{"\"\<WindowLevels\>\"", "->", 
            RowBox[{"Length", "[", "w", "]"}]}], ",", "\n", "  ", 
