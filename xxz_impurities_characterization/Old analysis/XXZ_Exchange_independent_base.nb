Cell[CellGroupData[{

Cell[" 1.6 Fixed g: editable Delta scan ", "Subsection",ExpressionUUID->"ec9c8d09-b879-ee42-80f1-f38926481b75"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"statDeltaModel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
       RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Delta\>\"", "->", 
        RowBox[{"9", "/", "20"}]}], ",", 
       RowBox[{"\"\<g\>\"", "->", 
        RowBox[{"1", "/", "10"}]}]}], "|>"}]}], ";", "\n", 
    RowBox[{"statDeltaGrid", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "2", ",", "30"}], "]"}], "]"}]}], ";", "\n", 
    RowBox[{"statDeltaEDTolerance", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}], ";", "\n", 
    RowBox[{"statDeltaPlotSettings", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<PlotChop\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
       RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"SectorKeys", "->", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ",
         "limits", " ", 
        RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
      RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
       RowBox[{"computed", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{"statDeltaOutputRoot", "=", 
     RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
    RowBox[{"statDeltaRunLabel", "=", "\"\<Exchange_static_Delta\>\""}], 
    ";"}], "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{
  4.001121755502556*^9},ExpressionUUID->"effe7325-2827-9943-b387-\
7d0ac9c14b8c"],

Cell["\<\
 All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches. \
\>", "Text",ExpressionUUID->"93aa0d7e-bb89-aa49-b01a-0ffb205cb7c2"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.7 Compute complete eigenpairs and the three eigenstate observables \
\>", "Subsection",ExpressionUUID->"4278c02c-f138-7245-b621-3cbf59edb69c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"statDeltaSeconds", ",", "statDeltaRun"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"staticScan", "[", 
        RowBox[{
        "statDeltaModel", ",", "\"\<Delta\>\"", ",", "statDeltaGrid", ",", 
         "statDeltaEDTolerance"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Seconds: \>\"", ",", "statDeltaSeconds", 
       ",", "\"\<; parameter points: \>\"", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"statDeltaRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "]"}], 
     ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"sectorTable", "[", 
        RowBox[{"First", "[", 
         RowBox[{"statDeltaRun", "[", "\"\<Points\>\"", "]"}], "]"}], "]"}], 
       "]"}], "]"}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Code",ExpressionUUID\
->"a10c51f7-a061-e349-8dae-954bd2637c98"],

Cell["\<\
 For a full ket use eigenket[statGRun[\"Points\"][[point]],sector,level], or \
replace statGRun by statDeltaRun. Eigenvalues are never chopped. Both \
bipartitions and IPR use the same retained eigenvectors. \
\>", "Text",ExpressionUUID->"ff2fd5a9-2d1e-6f4a-b8d8-501318ba1815"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.8 Plot spectrum, both entropies and IPR in separate sector panels \
\>", "Subsection",ExpressionUUID->"1e11c2df-9905-db4f-84c7-5c98ffbaa48d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
