Cell[CellGroupData[{

Cell[" 1.2 Fixed Delta: editable g scan ", "Subsection",ExpressionUUID->"882f3b4b-5340-6d4f-980f-1f5e2ab2cbdb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"statGModel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
       RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
       RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"statGGrid", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.01", ",", "0.5", ",", "500"}], "]"}], "]"}]}], ";", "\n", 
    RowBox[{"statGEDTolerance", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}], ";", "\n", 
    RowBox[{"statGPlotSettings", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<PlotChop\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
       RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"SectorKeys", "->", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ",
         "limits", " ", 
        RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
      RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
       RowBox[{"computed", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{"statGOutputRoot", "=", 
     RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
    RowBox[{"statGRunLabel", "=", "\"\<Exchange_static_g\>\""}], ";"}], "\n", 
   ")"}], ";"}]], "Code",
 CellChangeTimes->{{4.001121707373972*^9, 4.0011217345194283`*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"7a0cc474-7d46-5148-9204-02c0e181e4c8"],

Cell["\<\
 All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches. \
\>", "Text",ExpressionUUID->"dcb460e6-4e94-db4a-bc34-b6a65a935285"]
}, Open  ]],

