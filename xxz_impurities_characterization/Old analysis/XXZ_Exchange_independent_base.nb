         ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{"MatrixQ", " ", "/@", " ", 
              RowBox[{"Lookup", "[", 
