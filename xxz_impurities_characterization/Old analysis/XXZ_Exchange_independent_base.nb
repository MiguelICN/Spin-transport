         RowBox[{"blp", "=", 
          RowBox[{"Prepend", "[", 
           RowBox[{
            RowBox[{"Accumulate", "[", 
             RowBox[{"Clip", "[", 
              RowBox[{
               RowBox[{"Differences", "[", "dist", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], ",", 
            "0."}], "]"}]}], ";", "\n", " ", 
         RowBox[{"recs", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"dt", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"k", "==", "1"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
                RowBox[{
                 RowBox[{"times", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "-", 
                 RowBox[{"times", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", 
             RowBox[{"margin", "=", 
              RowBox[{"Missing", "[", "\"\<NotZZ\>\"", "]"}]}], ";", "\n", 
             "  ", 
             RowBox[{"rhp", "=", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"k", "==", "1"}], ",", 
                RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
                   RowBox[{
                   "cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",", 
                  RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
                  RowBox[{"Max", "[", 
