            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"selection", "=!=", "All"}], " ", "&&", " ", 
               RowBox[{"!", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{"selection", ",", 
                  RowBox[{
                   RowBox[{"run", "[", "\"\<SectorKeys\>\"", "]"}], "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
            RowBox[{"dims", "=", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"Lookup", "[", 
