                    RowBox[{"-", "rates"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], "/",
                  "2"}]}], "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<UnitalityError\>\"", "->", 
