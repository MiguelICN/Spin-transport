                  RowBox[{"First", "[", "fields", " ", "]"}]}], "]"}], "&"}], 
               " ", "/@", " ", "fields"}], ")"}]}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"st", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}],
                ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", "l"}], "]"}], ",", 
               RowBox[{"Table", "[", 
