               RowBox[{"recs", ",", "\"\<TPError\>\""}], "]"}], "]"}], "<", 
             RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ", 
            "&&", " ", 
            RowBox[{
             RowBox[{"Min", "[", 
