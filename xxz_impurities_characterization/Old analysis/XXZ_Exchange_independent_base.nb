             RowBox[{"Re", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", "16"}], "]"}], " ", ".", " ", "s", " ", ".",
                " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", "16"}], "]"}]}], "]"}], "/", "4"}], ",", 
            RowBox[{
             RowBox[{"grandSum", "[", "c", "]"}], "/", "4"}]}], "}"}]}], ";", 
         "\n", " ", 
