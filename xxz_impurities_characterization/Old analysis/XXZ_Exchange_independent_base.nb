              RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ",", "\n", 
           "  ", 
           RowBox[{"\"\<IIDSEM\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"status", "==", "\"\<OK\>\""}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "ratios", "]"}], ">=", "2"}]}], ",", 
              RowBox[{
