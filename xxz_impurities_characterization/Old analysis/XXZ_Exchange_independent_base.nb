                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Transfer\>\"", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<Transfer\>\"", "]"}]}], "]"}], "]"}], "]"}], "/",
                     "4"}], "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
             "\n", "  ", 
             RowBox[{"Join", "[", 
