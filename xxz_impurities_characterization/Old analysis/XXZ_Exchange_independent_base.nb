                RowBox[{"\"\<m\>\"", "->", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "-", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"bl", "[", "\"\<Sector\>\"", "]"}], "-", "1"}], 
                   ")"}]}]}], "|>"}]}], ",", 
              RowBox[{"\"\<Dimension\>\"", "->", 
               RowBox[{"Length", "[", 
                RowBox[{"bl", "[", "\"\<E\>\"", "]"}], "]"}]}], ",", "\n", 
              " ", 
              RowBox[{"\"\<ActiveColumns\>\"", "->", 
               RowBox[{"Length", "[", 
                RowBox[{"bl", "[", "\"\<Columns\>\"", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Weight\>\"", "->", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
