                   RowBox[{"bl", "[", "\"\<C\>\"", "]"}], 
                   ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "/", 
                "4"}]}]}], "|>"}], ",", 
            RowBox[{"{", 
             RowBox[{"bl", ",", 
              RowBox[{"e", "[", "\"\<Blocks\>\"", "]"}]}], "}"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"weights", ",", "\"\<Weight\>\""}], "]"}], "]"}], "-",
               "1"}], "]"}], "<", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
           ",", "\"\<Channel sector weights do not sum to one.\>\""}], "]"}], 
         ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"e", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
             RowBox[{"\"\<TotalL\>\"", "->", 
              RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
             RowBox[{"\"\<BulkFactor\>\"", "->", "bf"}], ",", 
             RowBox[{"\"\<SectorWeights\>\"", "->", "weights"}], ",", "\n", 
             " ", 
             RowBox[{"\"\<DiscardedWeight\>\"", "->", "0."}], ",", 
             RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
             RowBox[{"\"\<FactorRank\>\"", "->", "r"}]}], "|>"}]}], "]"}]}]}],
        "\n", "]"}]}], ";", "\n", 
