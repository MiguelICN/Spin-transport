                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
              "curves", ",", 
              RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"points", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{"curves", ",", "1"}], "]"}]}], ";", 
         RowBox[{"xr", "=", 
          RowBox[{"MinMax", "[", 
           RowBox[{"points", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"yr", "=", 
