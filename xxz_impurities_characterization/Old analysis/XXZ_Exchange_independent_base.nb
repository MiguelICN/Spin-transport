            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"legends", "===", 
               RowBox[{"{", "}"}]}], ",", "None", ",", "\n", "    ", 
              RowBox[{"Placed", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"joined", ",", 
                  RowBox[{"LineLegend", "[", 
                   RowBox[{"styles", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"tex", "[", 
                    RowBox[{"#", ",", "15"}], "]"}], "&"}], " ", "/@", " ", 
                    "legends"}], ",", 
                    RowBox[{"LegendLayout", "->", "\"\<Column\>\""}]}], "]"}],
                   ",", "\n", "     ", 
                  RowBox[{"PointLegend", "[", 
                   RowBox[{"styles", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"tex", "[", 
                    RowBox[{"#", ",", "15"}], "]"}], "&"}], " ", "/@", " ", 
                    "legends"}], ",", "\n", "      ", 
                    RowBox[{"LegendMarkers", "->", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"ListQ", "[", "markers", "]"}], ",", 
                    RowBox[{"First", " ", "/@", " ", "markers"}], ",", 
                    "Automatic"}], "]"}]}], ",", 
                    RowBox[{"LegendMarkerSize", "->", "12"}], ",", "\n", 
                    "      ", 
                    RowBox[{"LegendLayout", "->", "\"\<Column\>\""}]}], 
                   "]"}]}], "]"}], ",", "Right"}], " ", "]"}]}], "]"}]}], ",",
            "\n", "   ", 
