Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "d", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"StringLength", "[", "$InputFileName", "]"}], ">", 
              "0"}]}], ",", "\n", "  ", 
            RowBox[{"DirectoryName", "[", 
             RowBox[{"ExpandFileName", "[", "$InputFileName", " ", "]"}], 
             "]"}], ",", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{"NotebookDirectory", "[", "]"}], ",", 
               RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"StringQ", "[", "d", "]"}], ",", "d", ",", 
           RowBox[{"Directory", "[", "]"}]}], "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"safeToken", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "s", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"s", "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"s", "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{"s", ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"s", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}], ",", 
             RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
             RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
             RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Numbered", " ", "reruns", " ", "prevent", " ", "overwriting"}], ";", 
       " ", 
       RowBox[{"no", " ", "timestamps", " ", "or", " ", "random", " ", 
        RowBox[{"strings", "."}]}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"newFolder", "[", 
       RowBox[{"root_", ",", "tag_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"d", ",", 
          RowBox[{"k", "=", "1"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"root", ",", "tag"}], "}"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"While", "[", 
          RowBox[{
           RowBox[{"DirectoryQ", "[", "d", "]"}], ",", 
           RowBox[{
            RowBox[{"k", "++"}], ";", 
            RowBox[{"d", "=", 
             RowBox[{"FileNameJoin", "[", 
              RowBox[{"{", 
               RowBox[{"root", ",", 
                RowBox[{"tag", "<>", "\"\<_run\>\"", "<>", 
                 RowBox[{"ToString", "[", "k", "]"}]}]}], "}"}], "]"}]}]}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"CreateDirectory", "[", 
          RowBox[{"d", ",", 
           RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";",
          "d"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[27]:=",ExpressionUUID->"c5a0a4bc-99a9-e942-81e4-d7a1048ba32b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"observableLabels", "=", 
      RowBox[{"<|", "\n", 
       RowBox[{
        RowBox[{"\"\<EntropyA\>\"", 
         "->", "\"\<S(\\\\rho_A)\\\\;(\\\\mathrm{nats})\>\""}], ",", "\n", 
        RowBox[{"\"\<EntropyB\>\"", 
         "->", "\"\<S(\\\\rho_B)\\\\;(\\\\mathrm{nats})\>\""}], ",", "\n", 
        RowBox[{"\"\<EntropyAB\>\"", 
         "->", "\"\<S(\\\\rho_{AB})\\\\;(\\\\mathrm{nats})\>\""}], ",", "\n", 
        RowBox[{"\"\<MutualInfo\>\"", 
         "->", "\"\<I(A:B)\\\\;(\\\\mathrm{nats})\>\""}], ",", "\n", 
        RowBox[{"\"\<Concurrence\>\"", "->", "\"\<C(\\\\rho_{AB})\>\""}], ",",
         "\n", 
        RowBox[{"\"\<Negativity\>\"", 
         "->", "\"\<\\\\mathcal N(\\\\rho_{AB})\>\""}], ",", "\n", 
        RowBox[{"\"\<Purity\>\"", 
         "->", "\"\<\\\\operatorname{Tr}\\\\rho_{AB}^2\>\""}], ",", "\n", 
        RowBox[{"\"\<PurityA\>\"", 
         "->", "\"\<\\\\operatorname{Tr}\\\\rho_A^2\>\""}], ",", "\n", 
        RowBox[{"\"\<PurityB\>\"", 
         "->", "\"\<\\\\operatorname{Tr}\\\\rho_B^2\>\""}], ",", "\n", 
        RowBox[{"\"\<FullOverlap\>\"", 
         "->", "\"\<\\\\operatorname{Tr}[\\\\rho(0)\\\\rho(t)]/\\\\\
operatorname{Tr}\\\\rho(0)^2\>\""}], ",", "\n", 
        RowBox[{"\"\<InitialOverlap\>\"", 
         "->", "\"\<\\\\operatorname{Tr}[\\\\rho_{AB}(0)\\\\rho_{AB}(t)]\>\""}\
], ",", "\n", 
        RowBox[{"\"\<MagnetizationA\>\"", 
         "->", "\"\<\\\\langle\\\\sigma_1^z\\\\rangle\>\""}], ",", "\n", 
        RowBox[{"\"\<MagnetizationB\>\"", 
         "->", "\"\<\\\\langle\\\\sigma_L^z\\\\rangle\>\""}], ",", "\n", 
        RowBox[{"\"\<CurrentLeft\>\"", 
         "->", "\"\<j_{1\\\\to2}=-\\\\langle i[H,S_1^z]\\\\rangle\>\""}], ",",
         "\n", 
        RowBox[{"\"\<CurrentRight\>\"", 
         "->", "\"\<j_{L-1\\\\to L}=\\\\langle i[H,S_L^z]\\\\rangle\>\""}], ",",
         "\n", 
        RowBox[{"\"\<TraceError\>\"", 
         "->", "\"\<|\\\\operatorname{Tr}\\\\rho_{AB}-1|\>\""}], ",", "\n", 
        RowBox[{"\"\<HermiticityError\>\"", 
         "->", "\"\<\\\\|\\\\rho_{AB}-\\\\rho_{AB}^{\\\\dagger}\\\\|_F\>\""}],
         ",", "\n", 
        RowBox[{"\"\<MinEigenvalue\>\"", 
         "->", "\"\<\\\\lambda_{\\\\min}(\\\\rho_{AB})\>\""}], ",", "\n", 
        RowBox[{"\"\<MinChoiEigenvalue\>\"", 
         "->", "\"\<\\\\lambda_{\\\\min}(C_t)\>\""}], ",", "\n", 
        RowBox[{"\"\<TPError\>\"", 
         "->", "\"\<\\\\|\\\\operatorname{Tr}_{\\\\rm \
out}C_t-I_4\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<ChoiTraceError\>\"", 
         "->", "\"\<|\\\\operatorname{Tr}C_t-4|\>\""}], ",", "\n", 
        RowBox[{"\"\<KrausRank\>\"", 
         "->", "\"\<\\\\operatorname{rank}_{\\\\epsilon}(C_t)\>\""}], ",", 
        "\n", 
        RowBox[{"\"\<MapEntropy\>\"", 
         "->", "\"\<S(C_t/4)\\\\;(\\\\mathrm{nats})\>\""}], ",", "\n", 
        RowBox[{"\"\<ChoiPTMinimum\>\"", 
         "->", "\"\<\\\\lambda_{\\\\min}[(C_t/4)^{T_{\\\\rm out}}]\>\""}], ",",
         "\n", 
        RowBox[{"\"\<ChoiNegativity\>\"", 
         "->", "\"\<\\\\mathcal N(C_t/4)\>\""}], ",", "\n", 
        RowBox[{"\"\<MinSingularValue\>\"", 
         "->", "\"\<\\\\sigma_{\\\\min}(S_t)\>\""}], ",", "\n", 
        RowBox[{"\"\<MinimumRate\>\"", 
         "->", "\"\<\\\\min_k\\\\gamma_k(t)\>\""}], ",", "\n", 
        RowBox[{"\"\<RHPInstantaneous\>\"", 
         "->", "\"\<\\\\frac12\\\\sum_k\\\\max(0,-\\\\gamma_k)\>\""}], ",", 
        "\n", 
        RowBox[{"\"\<RHPFiniteStep\>\"", 
         "->", "\"\<\\\\|C[\\\\Phi_{t,t-\\\\delta t}]\\\\|_1/4-1\>\""}], ",", 
        "\n", 
        RowBox[{"\"\<RHPFiniteStepRate\>\"", 
         "->", "\"\<(\\\\|C[\\\\Phi_{t,t-\\\\delta t}]\\\\|_1/4-1)/\\\\delta \
t\>\""}], ",", "\n", 
        RowBox[{"\"\<UnitalityError\>\"", 
         "->", "\"\<\\\\|\\\\Phi_t(I_4/4)-I_4/4\\\\|_{\\\\max}\>\""}], ",", 
        "\n", 
        RowBox[{"\"\<MixedInputEntropy\>\"", 
         "->", "\"\<S[\\\\Phi_t(I_4/4)]\>\""}], ",", "\n", 
        RowBox[{"\"\<U1CovarianceError\>\"", 
         "->", "\"\<\\\\epsilon_{U(1)}(S_t)\>\""}], ",", "\n", 
        RowBox[{"\"\<ReflectionCovarianceError\>\"", 
         "->", "\"\<\\\\|[S_t,\\\\mathcal R]\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<FlipCovarianceError\>\"", 
         "->", "\"\<\\\\|[S_t,\\\\mathcal F]\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<RFCovarianceError\>\"", 
         "->", "\"\<\\\\|[S_t,\\\\mathcal R\\\\mathcal \
F]\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<TimeReversalError\>\"", 
         "->", "\"\<\\\\|S_{-t}-S_t^*\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<DoubleQuantumReal\>\"", 
         "->", "\"\<\\\\operatorname{Re}\\\\lambda_{00,11}\>\""}], ",", "\n", 
        RowBox[{"\"\<DoubleQuantumImag\>\"", 
         "->", "\"\<\\\\operatorname{Im}\\\\lambda_{00,11}\>\""}], ",", "\n", 
        RowBox[{"\"\<DoubleQuantumAbs\>\"", 
         "->", "\"\<|\\\\lambda_{00,11}|\>\""}], ",", "\n", 
        RowBox[{"\"\<BLPDistance\>\"", 
         "->", "\"\<\\\\frac12\\\\|\\\\Phi_t(\\\\rho_1-\\\\rho_2)\\\\|_1\>\""}\
], ",", "\n", 
        RowBox[{"\"\<BLPAccumulated\>\"", 
         "->", "\"\<\\\\sum_{\\\\delta D>0}\\\\delta D\>\""}], ",", "\n", 
        RowBox[{"\"\<SignalAtoB\>\"", 
         "->", "\"\<\\\\|M_{A\\\\to B}(t)\\\\|_2\>\""}], ",", "\n", 
        RowBox[{"\"\<RetentionA\>\"", 
         "->", "\"\<\\\\|M_{A\\\\to A}(t)\\\\|_2\>\""}], ",", "\n", 
        RowBox[{"\"\<Nonmultiplicativity\>\"", 
         "->", "\"\<\\\\Sigma_{AB}-\\\\Sigma_A\\\\Sigma_B\>\""}], ",", "\n", 
        RowBox[{"\"\<L1Normalized\>\"", 
         "->", "\"\<C_{\\\\ell_1}(\\\\rho_{AB})/3\>\""}], ",", "\n", 
        RowBox[{"\"\<LinearEntropy\>\"", 
         "->", "\"\<1-\\\\operatorname{Tr}\\\\rho_{AB}^2\>\""}], ",", "\n", 
        RowBox[{"\"\<NormalizedEntropy\>\"", 
         "->", "\"\<S(\\\\rho_{AB})/\\\\ln4\>\""}], ",", "\n", 
        RowBox[{"\"\<OmegaTF\>\"", 
         "->", "\"\<\\\\Omega_{T_F}[\\\\Phi_t]\>\""}], ",", "\n", 
        RowBox[{"\"\<OmegaR\>\"", "->", "\"\<\\\\Omega_R[\\\\Phi_t]\>\""}], ",",
         "\n", 
        RowBox[{"\"\<ResponseMinimum\>\"", 
         "->", "\"\<\\\\lambda_{\\\\min}(\\\\mathcal R_t)\>\""}], ",", "\n", 
        RowBox[{"\"\<ResponseMaximum\>\"", 
         "->", "\"\<\\\\lambda_{\\\\max}(\\\\mathcal R_t)\>\""}], ",", "\n", 
        RowBox[{"\"\<FreeMaxDistance\>\"", 
         "->", "\"\<\\\\|\\\\Phi_t(f_1)-f_1\\\\|_{\\\\max}\>\""}], ",", "\n", 
        RowBox[{"\"\<FreeTraceDistance\>\"", 
         "->", "\"\<\\\\|\\\\Phi_t(f_1)-f_1\\\\|_1\>\""}], ",", "\n", 
