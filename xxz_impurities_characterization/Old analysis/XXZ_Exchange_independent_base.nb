                "}"}], "&"}], ",", "data", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "points", ",", "xr", ",",
           "yr", ",", "xt", ",", "yt"}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"If", "[", 
