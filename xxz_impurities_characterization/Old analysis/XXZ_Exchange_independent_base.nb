         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"dt", "=", 
          RowBox[{"Differences", "[", "ts", "]"}]}], ";", 
         RowBox[{"regimeCaption", "[", 
          RowBox[{"p", ",", 
           RowBox[{"\"\<t\\\\in[\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"First", "[", "ts", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"Last", "[", "ts", "]"}], "]"}], "<>", "\"\<]; N_t=\>\"",
             "<>", 
