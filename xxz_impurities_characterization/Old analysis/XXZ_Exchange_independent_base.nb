Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"texturizingRecord", "[", 
       RowBox[{"t_", ",", "s_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"transferToChoi", "[", "s", "]"}]}], ",", "out", ",", "r", 
