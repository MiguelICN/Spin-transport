              RowBox[{"{", 
               RowBox[{"yt", ",", "None"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"xt", ",", "None"}], "}"}]}], "}"}]}], ",", "\n", 
           "   ", 
           RowBox[{"PlotLabel", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"topLabel", "==", "\"\<\>\""}], ",", "None", ",", 
              RowBox[{"tex", "[", 
               RowBox[{"topLabel", ",", "15"}], "]"}]}], "]"}]}], ",", "\n", 
           "   ", 
           RowBox[{"FrameStyle", "->", 
            RowBox[{"Directive", "[", 
             RowBox[{"Black", ",", 
              RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
           "\n", "   ", 
