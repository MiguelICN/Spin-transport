         RowBox[{"\"\<BulkFactor\>\"", "->", "mapBulkFactor"}], ",", "\n", 
         " ", 
         RowBox[{"\"\<Settings\>\"", "->", "mapSettingsUsed"}], ",", 
         RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
         RowBox[{"\"\<Times\>\"", "->", "mapTimes"}], ",", "\n", " ", 
         RowBox[{"\"\<Probes\>\"", "->", "mapProbesUsed"}], ",", 
         RowBox[{"\"\<Summary\>\"", "->", "mapSummary"}], ",", 
         RowBox[{"\"\<Performance\>\"", "->", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"mapChannelRun", ",", 
            RowBox[{"{", "\"\<Records\>\"", "}"}]}], "]"}]}], ",", 
         RowBox[{"\"\<TimeReversalCheck\>\"", "->", "mapTimeReversal"}], ",", 
         RowBox[{"\"\<Engine\>\"", "->", "mapEngine"}], ",", 
         RowBox[{"\"\<Records\>\"", "->", "mapRecords"}], ",", 
         RowBox[{"\"\<InfiniteTimeAverage\>\"", "->", "mapAverage"}], ",", 
         "\n", " ", 
         RowBox[{"\"\<SetupSeconds\>\"", "->", "mapSetupSeconds"}], ",", 
         RowBox[{"\"\<EvolutionSeconds\>\"", "->", "mapSeconds"}]}], "|>"}]}],
       "]"}]}], ";", "\n", 
    RowBox[{"Print", "[", "mapDirectory", "]"}], ";"}], "\n", ")"}], 
  ";"}]], "Code",
 CellChangeTimes->{4.0011232665949097`*^9},
