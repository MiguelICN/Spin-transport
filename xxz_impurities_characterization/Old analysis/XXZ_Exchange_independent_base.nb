      RowBox[{"coherence", "-", 
       RowBox[{
       "sensitive", " ", "alternatives", " ", "include", " ", "the", " ", 
        "two", " ", "orthogonal", " ", "Bell", " ", 
        RowBox[{"states", "."}]}]}]}]}], " ", "*)"}], "\n", ")"}], 
  ";"}]], "Code",
