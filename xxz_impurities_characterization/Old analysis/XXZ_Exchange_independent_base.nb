               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"times", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"times", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"vals", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}]}]}], 
          "]"}]}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[50]:=",ExpressionUUID->"da7133d1-fa0c-114f-97b7-effdafafd6e7"],

Cell["\<\
 For a fixed normalized bulk state rhoM, Phi_t(X)=Tr_M[U_t (X tensor rhoM) \
U_t dagger]. C_t=sum_ij |i><j| tensor Phi_t(|i><j|); Tr C_t=4 and C_t/4 is \
the Choi state. C_t depends only on the model, bulk state and time. There is \
no initial-edge-state input to chBuild. Full correlated preparations belong \
to chapter 2; one cannot assign them a universal CPTP map for arbitrary edge \
inputs. \
\>", "Text",ExpressionUUID->"1c23d01f-a5d7-1e49-9178-34dabaa20f35"],

Cell["\<\
 Exchange fast implementation: build each occupied total-magnetization block \
directly from the bulk factor, retaining only its active edge-input/bulk \
columns. Reflection parity and spin-flip partner reuse reduce ED. \
Real-arithmetic batched products are scattered directly into the Choi factor \
W, and C=W W dagger. A definite-bulk-magnetization input occupies three \
total-magnetization blocks. No full D-by-4r initial array is constructed. \
\>", "Text",ExpressionUUID->"bfff90e3-57c9-3c4b-bf0f-c1f277b217db"],

Cell["\<\
 Map observables include CP/TP diagnostics, Choi spectrum/entropy/rank, \
reference-output negativity, exact time-local generator and canonical rates \
where invertible, finite-step and instantaneous RHP witnesses, selected-pair \
BLP backflow, covariance violations, unitality, double-quantum coherence, \
signalling and retention. Probe edge states below affect only BLP/signalling \
diagnostics, not the Choi matrix. A PPT Choi state does not prove \
entanglement breaking in 4x4. \
\>", "Text",ExpressionUUID->"cf04bbbc-1959-354d-89fb-cf9e48c0fbe3"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Fast channel definitions: conditional/column-pruned batches \
\>", "Subsubsection",ExpressionUUID->"2255dfb3-0651-5d44-b7f1-e84c7a9604a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapSectors", "[", "n_Integer", "]"}], " ", ":=", " ", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"PositionIndex", "[", 
         RowBox[{"DigitCount", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{
              RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}]}], "]"}], ",", 
           " ", "2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapReflectPerm", "[", 
       RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{"ix", ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "ix", "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"IntegerReverse", "[", 
          RowBox[{
           RowBox[{"ix", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "n"}],
           "]"}], " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapParityQ", "[", 
       RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d", " ", "=", " ", 
           RowBox[{"Length", "[", "ix", "]"}]}], ",", " ", "jr", ",", " ", 
          "fix", ",", " ", "pr", ",", " ", "nf", ",", " ", "qe", ",", " ", 
          "qo"}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"jr", " ", "=", " ", 
          RowBox[{"chMapReflectPerm", "[", 
           RowBox[{"ix", ",", " ", "n"}], "]"}]}], ";", " ", 
         RowBox[{"fix", " ", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"jr", " ", "-", " ", 
              RowBox[{"Range", "[", "d", "]"}]}], ",", " ", "0"}], "]"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"pr", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", "d", "]"}], ",", " ", "jr"}], "}"}], 
             "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", 
         " ", 
         RowBox[{"nf", " ", "=", " ", 
          RowBox[{"Length", "[", "fix", "]"}]}], ";", "\n", "  ", 
         RowBox[{"qe", " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{"fix", ",", " ", 
                   RowBox[{"Range", "[", "nf", "]"}]}], "}"}], "]"}], " ", "->",
                 " ", "1."}], "]"}], ",", "\n", "      ", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                   RowBox[{"nf", " ", "+", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], 
                 "]"}], " ", "->", " ", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
              "      ", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                   RowBox[{"nf", " ", "+", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], 
                 "]"}], " ", "->", " ", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"d", ",", " ", 
              RowBox[{"nf", " ", "+", " ", 
               RowBox[{"Length", "[", "pr", "]"}]}]}], "}"}]}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"qo", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"pr", " ", "===", " ", 
             RowBox[{"{", "}"}]}], ",", " ", "Nothing", ",", " ", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}],
                   " ", "->", " ", 
                  RowBox[{"1", "/", 
                   RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
                "      ", 
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}],
                   " ", "->", " ", 
                  RowBox[{
                   RowBox[{"-", "1"}], "/", 
                   RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", 
                RowBox[{"Length", "[", "pr", "]"}]}], "}"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"qe", ",", " ", "qo"}], "}"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{"chEDTolerance", "=", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapSectorEigen", "[", 
       RowBox[{"h_", ",", "ix_List", ",", "n_Integer", ",", "parity_"}], 
       "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"hb", "=", 
           RowBox[{"N", "[", 
            RowBox[{"h", "[", 
             RowBox[{"[", 
              RowBox[{"ix", ",", "ix"}], "]"}], "]"}], "]"}]}], ",", "es", ",",
           "out", ",", "perm", ",", "scale"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{"hb", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", 
         " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{"Im", "[", "hb", "]"}], "]"}], "<=", 
             RowBox[{"chEDTolerance", " ", "scale"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{"hb", "-", 
               RowBox[{"ConjugateTranspose", "[", "hb", "]"}]}], "]"}], "<=", 
             RowBox[{"chEDTolerance", " ", "scale"}]}]}], 
           ",", "\"\<Channel ED requires a real symmetric Hamiltonian.\>\""}],
           "]"}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", "parity", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "ix", "]"}], ">", "1"}]}], ",", "\n", 
           "  ", 
           RowBox[{
            RowBox[{"perm", "=", 
             RowBox[{"chMapReflectPerm", "[", 
              RowBox[{"ix", ",", "n"}], "]"}]}], ";", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{"hb", "-", 
                 RowBox[{"hb", "[", 
                  RowBox[{"[", 
                   RowBox[{"perm", ",", "perm"}], "]"}], "]"}]}], "]"}], "<=", 
               RowBox[{"chEDTolerance", " ", "scale"}]}], 
              ",", "\"\<Channel reflection block is not invariant.\>\""}], 
             "]"}], ";", "\n", "  ", 
            RowBox[{"es", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", "=", 
                   RowBox[{"Eigensystem", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"Transpose", "[", "q", "]"}], " ", ".", " ", "hb",
                     " ", ".", " ", "q"}], "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"Normal", "[", 
                    RowBox[{"q", " ", ".", " ", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}],
                 "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"q", ",", 
                 RowBox[{"chMapParityQ", "[", 
                  RowBox[{"ix", ",", "n"}], "]"}]}], "}"}]}], "]"}]}], ";", 
            "\n", "  ", 
            RowBox[{"out", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<E\>\"", "->", 
                RowBox[{"Join", "@@", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
               RowBox[{"\"\<V\>\"", "->", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"Sequence", "@@", 
                   RowBox[{"es", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "2"}], 
                 "]"}]}]}], "|>"}]}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"es", "=", 
             RowBox[{"Eigensystem", "[", 
              RowBox[{"Normal", "[", "hb", "]"}], "]"}]}], ";", 
            RowBox[{"out", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<E\>\"", "->", 
                RowBox[{"es", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<V\>\"", "->", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "|>"}]}]}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"hb", " ", ".", " ", 
               RowBox[{"out", "[", "\"\<V\>\"", "]"}]}], "-", 
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{"out", "[", "\"\<E\>\"", "]"}], " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"out", "[", "\"\<V\>\"", "]"}], "]"}]}], "]"}]}], 
             "]"}], "<=", 
            RowBox[{"100", " ", "chEDTolerance", " ", "scale"}]}], 
           ",", "\"\<Channel eigenpair residual failed.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"out", "[", "\"\<V\>\"", "]"}], "^", "2"}], "]"}], "-",
               "1"}], "]"}], "<=", 
            RowBox[{"100", " ", "chEDTolerance"}]}], 
           ",", "\"\<Channel eigenvector normalization failed.\>\""}], "]"}], 
         ";", "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[51]:=",ExpressionUUID->"0da2b6d8-8122-ca4e-bcc7-56f3c583b820"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapPhaseBlock", "[", 
       RowBox[{"e_List", ",", " ", 
        RowBox[{"c_", "?", "MatrixQ"}], ",", " ", "tc_List", ",", " ", 
        RowBox[{"dot_", " ", ":", " ", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ph", " ", "=", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", " ", "e", ",", " ", "tc"}], "]"}]}], 
           "]"}]}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "dot", "]"}], ",", " ", 
           RowBox[{"ph", " ", "=", " ", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "e", " ", "ph"}]}]}], "]"}], ";", "\n", 
         "  ", 
         RowBox[{"ArrayReshape", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ph", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "tau"}], "]"}], "]"}], " ", "c"}], 
               ",", " ", 
               RowBox[{"{", 
                RowBox[{"tau", ",", " ", 
                 RowBox[{"Length", "[", "tc", "]"}]}], "}"}]}], "]"}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "e", "]"}], ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "tc", "]"}], " ", 
              RowBox[{"Last", "[", 
               RowBox[{"Dimensions", "[", "c", "]"}], "]"}]}]}], "}"}]}], 
          "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapRealDot", "[", 
       RowBox[{
        RowBox[{"v_", "?", "MatrixQ"}], ",", " ", 
        RowBox[{"b_", "?", "MatrixQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"v", " ", ".", " ", 
        RowBox[{"Re", "[", "b", "]"}]}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"v", " ", ".", " ", 
         RowBox[{"Im", "[", "b", "]"}]}]}]}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[52]:=",ExpressionUUID->"5932ca49-011c-2a40-85d2-966d0443ab60"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapGibbsFactor", "[", 
       RowBox[{"delta_", ",", " ", "p_Association", ",", " ", 
        RowBox[{"beta_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", "h", ",", " ", 
          "sec", ",", " ", "es", ",", " ", "e0", ",", " ", "w", ",", " ", 
          "fac", ",", " ", 
          RowBox[{"col", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"chChainHamiltonian", "[", 
           RowBox[{"delta", ",", " ", "p"}], "]"}]}], ";", " ", 
         RowBox[{"sec", " ", "=", " ", 
          RowBox[{"chMapSectors", "[", "n", "]"}]}], ";", "\n", "  ", 
         RowBox[{"es", " ", "=", " ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Eigensystem", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"h", "[", 
               RowBox[{"[", 
                RowBox[{"ix", ",", " ", "ix"}], "]"}], "]"}], "]"}], "]"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"ix", ",", " ", "sec"}], "}"}]}], "]"}]}], ";", " ", 
         RowBox[{"e0", " ", "=", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"beta", ">=", "0"}], ",", "Min", ",", "Max"}], "]"}], "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"es", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";",
          "\n", "  ", 
         RowBox[{"fac", " ", "=", " ", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "^", "n"}], ",", " ", 
              RowBox[{"2", "^", "n"}]}], "}"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"w", " ", "=", " ", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "beta"}], " ", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"es", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ",
                   "e0"}], ")"}]}], "]"}], "]"}]}], ";", " ", 
            RowBox[{
             RowBox[{"fac", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"sec", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
                RowBox[{"col", " ", "+", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "w", "]"}], "]"}]}]}], "]"}], "]"}], 
             " ", "=", " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"w", " ", 
               RowBox[{"es", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], ";", 
            " ", 
            RowBox[{"col", " ", "+=", " ", 
             RowBox[{"Length", "[", "w", "]"}]}]}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", " ", 
             RowBox[{"Length", "[", "sec", "]"}]}], "}"}]}], "]"}], ";", "\n",
          "  ", 
         RowBox[{"fac", "/", 
          RowBox[{"Norm", "[", 
           RowBox[{"fac", ",", " ", "\"\<Frobenius\>\""}], "]"}]}]}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapTypicalFactor", "[", 
       RowBox[{"delta_", ",", " ", "p_Association", ",", " ", 
        RowBox[{"beta_", "?", "NumericQ"}], ",", " ", "nr_Integer", ",", " ", 
        RowBox[{"seed_Integer", " ", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", "h", ",", " ", 
          "sec", ",", " ", "e0", ",", " ", "cols"}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"chChainHamiltonian", "[", 
           RowBox[{"delta", ",", " ", "p"}], "]"}]}], ";", " ", 
         RowBox[{"sec", " ", "=", " ", 
          RowBox[{"chMapSectors", "[", "n", "]"}]}], ";", " ", 
         RowBox[{"e0", " ", "=", " ", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"beta", ">=", "0"}], ",", 
             RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", 
           RowBox[{"Norm", "[", 
