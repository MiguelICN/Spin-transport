           "ids", ",", "m", ",", "names", ",", "spaces", ",", 
          RowBox[{"out", "=", 
           RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"bits", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{
               RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         RowBox[{"q", "=", 
          RowBox[{"KeyTake", "[", 
           RowBox[{
            RowBox[{"charges", "[", "p", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"m", "=", 
             RowBox[{
              RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
            RowBox[{"ids", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"2", "^", "l"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Total", "[", 
                  RowBox[{"bits", "[", 
                   RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], 
                "&"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"names", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"m", "==", "0"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}], ",", 
               RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"spaces", "=", 
             RowBox[{"{", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Basis\>\"", "->", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<Labels\>\"", "->", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<m\>\"", "->", "m"}], "|>"}]}]}], "|>"}], 
              "}"}]}], ";", "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"spaces", "=", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"splitCharge", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                     "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
                  "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"{", 
               RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
            RowBox[{"out", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"out", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"<|", 
                    RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}],
                  "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"nDown", ",", "0", ",", "l"}], "}"}]}], "]"}], ";", 
         "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[16]:=",ExpressionUUID->"743a34af-fdcb-fc43-be5c-7dcecc144818"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Reuse", " ", "splitCharge"}], ",", " ", 
      RowBox[{
       RowBox[{"including", " ", "its", " ", "spin"}], "-", 
       RowBox[{"Casimir", " ", "label", " ", 
        RowBox[{"conversion", "."}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"edgeSplit", "[", 
       RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=",
       " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"alias", ",", "label", ",", "out"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"alias", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{"name", ",", 
            RowBox[{"\"\<BulkS2\>\"", "|", "\"\<EdgeS2\>\""}], 
            ",", "\"\<S2\>\"", ",", "\"\<StaggeredBulkS2\>\"", 
            ",", "\"\<StaggeredS2\>\"", ",", "_", ",", "name"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"label", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{
           "name", ",", "\"\<BulkS2\>\"", ",", "\"\<SBulk\>\"", 
            ",", "\"\<EdgeS2\>\"", ",", "\"\<SEdge\>\"", ",", "\n", 
            "  ", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredSBulk\>\"", ",",
             "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"out", "=", 
          RowBox[{"splitCharge", "[", 
           RowBox[{"s", ",", "q", ",", "alias", ",", "tol"}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"alias", "=!=", "name"}], ",", 
           RowBox[{"out", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"t", ",", 
                RowBox[{"Join", "[", 
                 RowBox[{"t", ",", 
                  RowBox[{"<|", 
                   RowBox[{"\"\<Labels\>\"", "->", 
                    RowBox[{"Append", "[", "\n", "   ", 
                    RowBox[{
                    RowBox[{"KeyDrop", "[", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "}"}]}], "]"}], ",", 
                    "\n", "   ", 
                    RowBox[{"label", "->", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "]"}]}]}], "]"}]}], 
                   "|>"}]}], "]"}]}], "]"}], ",", "out"}], "]"}]}]}], "]"}], ";",
          "\n", " ", "out"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "A", " ", "charge", " ", "is", " ", "split", " ", "only", " ", "when", " ",
        "it", " ", "preserves", " ", "the", " ", "CURRENT", " ", 
       RowBox[{"subspace", "."}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"edgeRefine", "[", 
       RowBox[{"spaces_", ",", "q_", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"out", "=", "spaces"}], ",", "next", ",", "b", ",", "a"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"next", "=", 
             RowBox[{"{", "}"}]}], ";", "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"b", "=", 
                RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
               RowBox[{"a", "=", 
                RowBox[{"herm", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                  " ", 
                  RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], 
                 "]"}]}], ";", "\n", "   ", 
               RowBox[{"next", "=", 
                RowBox[{"Join", "[", 
                 RowBox[{"next", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "<", 
                    RowBox[{"tol", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], ",", "\n", "     ", 
                    RowBox[{"edgeSplit", "[", 
                    RowBox[{"s", ",", 
                    RowBox[{"q", "[", "name", "]"}], ",", "name", ",", 
                    "tol"}], "]"}], ",", 
                    RowBox[{"{", "s", "}"}]}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "out"}], "}"}]}], "]"}], ";", 
            RowBox[{"out", "=", "next"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"Keys", "[", "q", "]"}]}], "}"}]}], "]"}], ";", 
         "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[17]:=",ExpressionUUID->"ab468518-1d05-ab46-b310-1dddfdd28ebd"]
