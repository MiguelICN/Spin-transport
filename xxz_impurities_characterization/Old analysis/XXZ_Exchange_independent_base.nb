Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"bulkFactor", "[", 
       RowBox[{"p_Association", ",", "spec_Association", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{
            RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
          RowBox[{"d", "=", 
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], ",",
           "v", ",", "h", ",", "e", ",", "w", ",", "beta", ",", "mat", ",", 
          "emin", ",", "r"}], "}"}], ",", "\n", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], ",", "\n", 
          " ", "\"\<Neel\>\"", ",", 
          RowBox[{"stateFactor", "[", 
           RowBox[{
            RowBox[{"neel", "[", 
             RowBox[{"n", ",", 
              RowBox[{"Lookup", "[", 
               RowBox[{"spec", ",", "\"\<First\>\"", ",", "0"}], "]"}]}], 
             "]"}], ",", "d", ",", "tol"}], "]"}], ",", "\n", 
          " ", "\"\<Polarized\>\"", ",", 
          RowBox[{"stateFactor", "[", 
           RowBox[{
            RowBox[{"productKet", "[", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"UnitVector", "[", 
                RowBox[{"2", ",", 
                 RowBox[{"1", "+", 
                  RowBox[{"spec", "[", "\"\<Bit\>\"", "]"}]}]}], "]"}], ",", 
               "n"}], "]"}], "]"}], ",", "d", ",", "tol"}], "]"}], ",", "\n", 
          " ", "\"\<Helix\>\"", ",", 
          RowBox[{"stateFactor", "[", 
           RowBox[{
            RowBox[{"helix", "[", 
             RowBox[{"n", ",", 
              RowBox[{"spec", "[", "\"\<q\>\"", "]"}], ",", 
              RowBox[{"spec", "[", "\"\<theta\>\"", "]"}], ",", 
              RowBox[{"spec", "[", "\"\<phi\>\"", "]"}]}], "]"}], ",", "d", ",",
             "tol"}], "]"}], ",", "\n", " ", "\"\<InfiniteT\>\"", ",", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"IdentityMatrix", "[", "d", "]"}], "/", 
            RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}], ",", "\n", 
          " ", "\"\<Gibbs\>\"", ",", 
          RowBox[{
           RowBox[{"beta", "=", 
            RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{"realQ", "[", "beta", "]"}], 
             ",", "\"\<Beta must be finite and real.\>\""}], "]"}], ";", "\n",
            "  ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"e", ",", "v"}], "}"}], "=", 
            RowBox[{"Eigensystem", "[", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}], "]"}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"w", "=", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "beta"}], 
              RowBox[{"(", 
               RowBox[{"e", "-", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"beta", ">=", "0"}], ",", 
                  RowBox[{"Min", "[", "e", "]"}], ",", 
                  RowBox[{"Max", "[", "e", "]"}]}], "]"}]}], ")"}]}], "]"}]}],
            ";", 
           RowBox[{"w", "/=", 
            RowBox[{"Total", "[", "w", "]"}]}], ";", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"Sqrt", "[", "w", "]"}], " ", "v"}], "]"}]}], ",", "\n", 
          " ", "\"\<Typical\>\"", ",", 
          RowBox[{
           RowBox[{"beta", "=", 
            RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
           RowBox[{"r", "=", 
            RowBox[{"spec", "[", "\"\<Samples\>\"", "]"}]}], ";", "\n", "  ", 
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"realQ", "[", "beta", "]"}], " ", "&&", " ", 
              RowBox[{"IntegerQ", "[", "r", "]"}], " ", "&&", " ", 
              RowBox[{"r", ">=", "1"}]}], 
             ",", "\"\<Invalid typicality Beta/Samples.\>\""}], "]"}], ";", 
           "\n", "  ", 
           RowBox[{"h", "=", 
            RowBox[{"N", "[", 
             RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}]}], ";", 
           RowBox[{"emin", "=", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"beta", ">=", "0"}], ",", 
               RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", 
             RowBox[{"Norm", "[", 
              RowBox[{"h", ",", "Infinity"}], "]"}]}]}], ";", "\n", "  ", 
           RowBox[{"mat", "=", 
            RowBox[{"BlockRandom", "[", 
             RowBox[{
              RowBox[{"SeedRandom", "[", 
               RowBox[{"spec", "[", "\"\<Seed\>\"", "]"}], "]"}], ";", "\n", 
              "   ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"MatrixExp", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"-", "beta"}], 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"h", "-", 
                    RowBox[{"emin", " ", 
                    RowBox[{"id", "[", "d", "]"}]}]}], ")"}], "/", "2"}]}], ",",
                    "\n", "    ", 
                   RowBox[{
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                    "]"}], "+", 
                    RowBox[{"I", " ", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                    "]"}]}]}]}], "]"}], ",", 
                 RowBox[{"{", "r", "}"}]}], "]"}], "]"}]}], "]"}]}], ";", 
           "\n", "  ", 
           RowBox[{"mat", "/", 
            RowBox[{"Norm", "[", 
             RowBox[{"mat", ",", "\"\<Frobenius\>\""}], "]"}]}]}], ",", "\n", 
          " ", "\"\<User\>\"", ",", 
          RowBox[{"stateFactor", "[", 
           RowBox[{
            RowBox[{"spec", "[", "\"\<State\>\"", "]"}], ",", "d", ",", 
            "tol"}], "]"}], ",", "\n", " ", "_", ",", 
          RowBox[{"check", "[", 
           RowBox[{
           "False", 
            ",", "\"\<Bulk Type must be Neel, Polarized, Helix, InfiniteT, \
Gibbs, Typical or User.\>\""}], "]"}]}], "]"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"initialFactor", "[", 
       RowBox[{"p_", ",", "spec_", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"spec", "[", "\"\<Mode\>\"", "]"}], ",", "\n", 
        " ", "\"\<Product\>\"", ",", 
        RowBox[{"joinStates", "[", 
         RowBox[{
          RowBox[{"stateFactor", "[", 
           RowBox[{
            RowBox[{"spec", "[", "\"\<EdgeState\>\"", "]"}], ",", "4", ",", 
            "tol"}], "]"}], ",", 
          RowBox[{"bulkFactor", "[", 
           RowBox[{"p", ",", 
            RowBox[{"spec", "[", "\"\<Bulk\>\"", "]"}], ",", "tol"}], "]"}], ",", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "\n", 
        " ", "\"\<Full\>\"", ",", 
        RowBox[{"stateFactor", "[", 
         RowBox[{
          RowBox[{"spec", "[", "\"\<FullState\>\"", "]"}], ",", 
          RowBox[{"2", "^", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "tol"}], "]"}], ",", 
        "\n", " ", "_", ",", 
        RowBox[{"check", "[", 
         RowBox[{
         "False", ",", "\"\<Initial Mode must be Product or Full.\>\""}], 
         "]"}]}], "]"}]}], ";", "\n", "\n", 
     RowBox[{
      RowBox[{"stateInputDiagnostics", "[", 
       RowBox[{"p_", ",", "fac_", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "gram", ",", "ha", ",", "energy", ",", "kinetic", ",", "mean", ",", 
          "var", ",", "comm", ",", "qr", ",", "rr", ",", "ra", ",", "rb", ",",
           "r"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"gram", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
           "fac"}]}], ";", 
         RowBox[{"ha", "=", 
          RowBox[{
           RowBox[{"regimeHamiltonian", "[", "p", "]"}], " ", ".", " ", 
           "fac"}]}], ";", "\n", " ", 
         RowBox[{"energy", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
           "ha"}]}], ";", 
         RowBox[{"kinetic", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "ha", "]"}], " ", ".", " ", 
           "ha"}]}], ";", "\n", " ", 
         RowBox[{"mean", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", "energy", "]"}], "]"}]}], ";", 
         RowBox[{"var", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"0.", ",", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", "kinetic", "]"}], "]"}], "-", 
             RowBox[{"mean", "^", "2"}]}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"qr", ",", "rr"}], "}"}], "=", 
          RowBox[{"QRDecomposition", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"fac", ",", "ha", ",", "2"}], "]"}], "]"}]}], ";", 
         RowBox[{"ra", "=", 
          RowBox[{"rr", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"1", ";;", "r"}]}], "]"}], "]"}]}], ";", 
         RowBox[{"rb", "=", 
          RowBox[{"rr", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{
              RowBox[{"r", "+", "1"}], ";;", 
              RowBox[{"2", " ", "r"}]}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"comm", "=", 
          RowBox[{"Norm", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"rb", " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "ra", "]"}]}], "-", 
             RowBox[{"ra", " ", ".", " ", 
              RowBox[{"ConjugateTranspose", "[", "rb", "]"}]}]}], 
            ",", "\"\<Frobenius\>\""}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"comm", "<", "tol"}], ",", 
           RowBox[{
           "Print", 
            "[", "\"\<The chosen initial density matrix is stationary within \
the diagnostic tolerance; constant observables are expected.\>\"", "]"}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Purity\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"gram", " ", ".", " ", "gram"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<MeanEnergy\>\"", "->", "mean"}], ",", 
           RowBox[{"\"\<EnergyVariance\>\"", "->", "var"}], ",", "\n", "  ", 
           RowBox[{"\"\<CommutatorNorm\>\"", "->", "comm"}], ",", 
           RowBox[{"\"\<StationaryWithinTolerance\>\"", "->", 
            RowBox[{"TrueQ", "[", 
             RowBox[{"comm", "<", "tol"}], "]"}]}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[40]:=",ExpressionUUID->"900e77c3-9b5f-594a-ac5c-7b23442ccec6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"spinCurrentOp", "[", "jxy_", "]"}], " ", ":=", " ", 
      RowBox[{"jxy", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
            RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], "-", "\n", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
            RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], ")"}], "/", 
        "4"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"stateRecord", "[", 
       RowBox[{
       "t_", ",", "a_", ",", "eng_", ",", "fac0_", ",", "rho0_", ",", 
        "purity0_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], ",", "rec", ",", "pauli",
           ",", "axes", ",", "ra", ",", "rb", ",", "rr", ",", "ma", ",", "mb",
           ",", "c", ",", "extra", ",", "cur"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"rec", "=", 
          RowBox[{"observables", "[", 
           RowBox[{"t", ",", 
            RowBox[{"partitionFactor", "[", 
             RowBox[{"a", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}], ",", 
            "rho0"}], "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ra", ",", "rb", ",", "rr"}], "}"}], "=", 
          RowBox[{"Lookup", "[", 
           RowBox[{"rec", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<RhoA\>\"", ",", "\"\<RhoB\>\"", 
              ",", "\"\<RhoAB\>\""}], "}"}]}], "]"}]}], ";", 
         RowBox[{"pauli", "=", 
          RowBox[{"PauliMatrix", " ", "/@", " ", 
           RowBox[{"Range", "[", "3", "]"}]}]}], ";", 
         RowBox[{"axes", "=", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}],
          ";", "\n", " ", 
         RowBox[{"ma", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"#", " ", ".", " ", "ra"}], "]"}], "]"}], "&"}], " ", "/@",
            " ", "pauli"}]}], ";", 
         RowBox[{"mb", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"#", " ", ".", " ", "rb"}], "]"}], "]"}], "&"}], " ", "/@",
            " ", "pauli"}]}], ";", "\n", " ", 
         RowBox[{"c", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{
                 RowBox[{"pauli", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"pauli", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", ".", " ", 
               "rr"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"cur", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"reducedState", "[", 
                RowBox[{"a", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "2"}], "}"}], ",", "l"}], "]"}], " ", ".",
                " ", 
               RowBox[{"spinCurrentOp", "[", 
                RowBox[{
                 RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], 
                 "[", "\"\<g\>\"", "]"}], "]"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"reducedState", "[", 
                RowBox[{"a", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"l", "-", "1"}], ",", "l"}], "}"}], ",", "l"}], 
                "]"}], " ", ".", " ", 
               RowBox[{"spinCurrentOp", "[", 
                RowBox[{
                 RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], 
                 "[", "\"\<g\>\"", "]"}], "]"}]}], "]"}], "]"}]}], "}"}]}], ";",
          "\n", " ", 
         RowBox[{"extra", "=", 
          RowBox[{"Association", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\"\<PurityA\>\"", "->", 
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"ra", " ", ".", " ", "ra"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<PurityB\>\"", "->", 
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"rb", " ", ".", " ", "rb"}], "]"}], "]"}]}], ",", 
               "\n", "   ", 
               RowBox[{"\"\<FullOverlap\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".",
                     " ", "a"}], ",", "\"\<Frobenius\>\""}], "]"}], "^", 
                  "2"}], "/", "purity0"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<CurrentLeft\>\"", "->", 
                RowBox[{"cur", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<CurrentRight\>\"", "->", 
                RowBox[{"cur", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<LocalA\>\"", "<>", 
                 RowBox[{"axes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                RowBox[{"ma", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<LocalB\>\"", "<>", 
                 RowBox[{"axes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                RowBox[{"mb", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "  ", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<Correlation\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", "\n", "   ", 
                   RowBox[{
                    RowBox[{"\"\<Connected\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"ma", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"mb", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "3"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "2"}], 
              "]"}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"rec", ",", "extra"}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"stateTrajectory", "[", 
       RowBox[{"eng_", ",", "fac0_", ",", "times_List", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rho0", ",", "purity0", ",", "recs"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">=", "1"}]}], 
           ",", "\"\<Supply real times.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"rho0", "=", 
          RowBox[{"reducedState", "[", 
           RowBox[{"fac0", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
         RowBox[{"purity0", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", 
               " ", "fac0"}], ")"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", 
               " ", "fac0"}], ")"}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"recs", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"stateRecord", "[", 
             RowBox[{"t", ",", 
              RowBox[{"evolve", "[", 
               RowBox[{"t", ",", "eng"}], "]"}], ",", "eng", ",", "fac0", ",",
               "rho0", ",", "purity0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"recs", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
              "tol"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"recs", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], ">=", 
             RowBox[{"-", "tol"}]}]}], 
           ",", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", 
         "\n", " ", "recs"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[41]:=",ExpressionUUID->"c2f86b6f-e759-cb4c-9f98-623d0ee7e598"],

Cell["\<\
 This chapter uses only initialization definitions. It does not use a static \
scan, its parameters, or its eigenvectors. The initial state may be an \
edge/bulk product or any valid full-chain vector/density matrix, including a \
correlated state. Sector projections are computed before ED. The complex \
amplitudes between occupied sectors are retained in the full evolving factor; \
sector projection is not a dephasing operation. \
\>", "Text",ExpressionUUID->"96abb404-0de2-7447-a72a-7ae77c7aeec0"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 2.2 Independent model and time parameters ", "Subsection",ExpressionUUID->"9fe21eab-6c9d-9847-88d7-9d4d0b8b8031"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"dynModel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
       RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
       RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"dynTime", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
       RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
       RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
       RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
       RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"dynSettings", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<EDTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<ValidationTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], ",", 
       RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"dynLogHorizontalAxis", "=", "False"}], ";", "\n", 
    RowBox[{"dynOutputRoot", "=", 
     RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
    RowBox[{"dynRunLabel", "=", "\"\<Exchange_state_dynamics\>\""}], ";"}], 
   "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{{4.0011219995008583`*^9, 4.001122011011013*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"8f4aa6a2-3852-654b-9be3-edfecd672a3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[" 2.3 One active initial-state assignment ", "Subsection",ExpressionUUID->"c5ddfafe-0b38-af4b-91dc-41e5ab36db02"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"dynInitial", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", "\n", " ", 
       RowBox[{"\"\<EdgeState\>\"", "->", 
        RowBox[{"Normalize", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
       "\n", " ", 
       RowBox[{"\"\<Bulk\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
          RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";"}],
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "Replace", " ", "the", " ", "assignment", " ", "above", " ", "for", " ",
         "a", " ", "bulk", " ", 
        RowBox[{"helix", ":", "\n", " ", "dynInitial"}]}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", 
         RowBox[{"\"\<EdgeState\>\"", "->", 
          RowBox[{"Normalize", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<Bulk\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
            RowBox[{"\"\<q\>\"", "->", 
             RowBox[{"Pi", "/", "3"}]}], ",", 
            RowBox[{"\"\<theta\>\"", "->", 
             RowBox[{"Pi", "/", "2"}]}], ",", 
            RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";", 
      "\n", " ", 
      RowBox[{
      "Full", " ", "helix", " ", "on", " ", "physical", " ", "sites", " ", 
       "1"}]}], ",", "...", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"L", ":", "\n", " ", "dynInitial"}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
         RowBox[{"\"\<FullState\>\"", "->", 
          RowBox[{"helix", "[", 
           RowBox[{
            RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ",", 
            RowBox[{"Pi", "/", "3"}], ",", 
            RowBox[{"Pi", "/", "2"}], ",", "0"}], "]"}]}]}], "|>"}]}], ";", 
      "\n", " ", 
      RowBox[{
       RowBox[{"General", " ", "full", " ", 
        RowBox[{"vector", "/", "density"}], " ", 
        RowBox[{"matrix", ":", "\n", " ", "dynInitial"}]}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
         RowBox[{"\"\<FullState\>\"", "->", "yourFullState"}]}], "|>"}]}], ";",
       "\n", " ", 
      RowBox[{
      "A", " ", "mixed", " ", "edge", " ", "state", " ", "is", " ", "also", " ",
        "allowed", " ", "in", " ", "Product", " ", 
       RowBox[{"mode", "."}]}]}]}], "\n", "*)"}], "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{4.0011220181194077`*^9},
 CellLabel->"In[43]:=",ExpressionUUID->"a7cb5ed7-4b43-4440-949b-9c1ad218ef5d"],

Cell["\<\
 The helix is a freely chosen initial product state. No matched boundary \
field or rigid-rotation protocol is added. Bulk alternatives are Polarized \
(Bit), InfiniteT, Gibbs (Beta), Typical (Beta, Samples, Seed), and User \
(State). Gibbs/Typical use only the field-free L-2-site bulk Hamiltonian. \
\>", "Text",ExpressionUUID->"4ef7d3d4-c038-eb4d-a3ae-5daed2c1c264"]
}, Open  ]],

