              RowBox[{"{", 
               RowBox[{"140", ",", "40"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"100", ",", "50"}], "}"}]}], "}"}]}], ",", 
           RowBox[{"PlotRangePadding", "->", 
            RowBox[{"Scaled", "[", ".04", "]"}]}], ",", "\n", "   ", 
