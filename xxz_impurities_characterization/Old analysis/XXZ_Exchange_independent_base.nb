           RowBox[{"log", ",", 
            RowBox[{"logTicks", "@@", "xr"}], ",", 
            RowBox[{"ticks", "@@", "xr"}]}], "]"}]}], ";", 
         RowBox[{"yt", "=", 
          RowBox[{"ticks", "@@", "yr"}]}], ";", "\n", "  ", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{"curves", ",", 
           RowBox[{"Joined", "->", "joined"}], ",", 
           RowBox[{"InterpolationOrder", "->", "1"}], ",", "\n", "   ", 
