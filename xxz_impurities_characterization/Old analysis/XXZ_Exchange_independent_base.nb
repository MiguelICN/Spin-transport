             RowBox[{"window", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}], " ", "&&", "\n", 
            "  ", 
            RowBox[{"realQ", "[", "tol", "]"}], " ", "&&", " ", 
            RowBox[{"tol", ">", "0"}]}], 
           ",", "\"\<Invalid energy list, rank window, or gap \
tolerance.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "e", "]"}]}], ";", 
         RowBox[{"lo", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"window", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", 
             "1"}]}], "]"}]}], ";", 
         RowBox[{"hi", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"d", ",", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"window", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"w", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"d", ">", "0"}], " ", "&&", " ", 
             RowBox[{"hi", ">=", "lo"}]}], ",", 
            RowBox[{"e", "[", 
             RowBox[{"[", 
              RowBox[{"lo", ";;", "hi"}], "]"}], "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", 
         RowBox[{"gaps", "=", 
          RowBox[{"Differences", "[", "w", "]"}]}], ";", "\n", " ", 
         RowBox[{"cut", "=", 
          RowBox[{"tol", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], ";", 
         RowBox[{"pairs", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"ratios", "=", 
