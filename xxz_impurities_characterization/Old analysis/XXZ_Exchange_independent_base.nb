             RowBox[{"\"\<\\\\mathrm{Exchange}:\\\\quad L=\>\"", "<>", 
              RowBox[{"texNumber", "[", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
              "<>", "\"\<;\\\\quad J=\>\"", "<>", 
              RowBox[{"texNumber", "[", 
               RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}], "<>", "\n", 
              " ", "\"\<;\\\\quad g=\>\"", "<>", 
              RowBox[{"texNumber", "[", 
               RowBox[{"p", "[", "\"\<g\>\"", "]"}], "]"}], 
              "<>", "\"\<;\\\\quad \\\\Delta=\>\"", "<>", 
              RowBox[{"texNumber", "[", 
               RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}]}], ",", "\n", 
             " ", "\"\<M=\\\\{2,\\\\ldots,L-1\\\\},\\\\quad AB=\\\\{1,L\\\\},\
\\\\quad S^a=\\\\sigma^a/2,\\\\quad \\\\hbar=1\>\"", ",", "extra"}], "}"}], 
           ",", "\"\<\>\""}], "]"}]}], ",", 
        RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"trajectoryCaption", "[", 
