              RowBox[{"\"\<Symmetries\>\"", "->", 
               RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}]}], "]"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"weights", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"<|", 
