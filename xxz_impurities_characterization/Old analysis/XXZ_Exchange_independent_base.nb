             RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}], ",", 
            "prepared"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "times", "]"}], ">", 
            RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Join", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"chSeries", "[", 
                 RowBox[{"eng", ",", "#", ",", "cfg", ",", "pr"}], "]"}], 
                "&"}], " ", "/@", " ", 
               RowBox[{"Partition", "[", 
                RowBox[{"times", ",", 
                 RowBox[{"UpTo", "[", 
                  RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
                "]"}]}], ")"}]}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"raw", "=", 
          RowBox[{"chExChoiSeries", "[", 
           RowBox[{"eng", ",", "times", ",", 
            RowBox[{"\"\<MaxEntries\>\"", "->", 
             RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Derivative\>\"", "->", "True"}]}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"chi", ",", "cd"}], "}"}], "=", "raw"}], ";", "\n", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Choi\>\"", "->", 
               RowBox[{"4", " ", "#1"}]}], ",", 
              RowBox[{"\"\<ChoiState\>\"", "->", "#1"}], ",", 
              RowBox[{"\"\<Transfer\>\"", "->", 
               RowBox[{"chChoiToSuper", "[", "#1", "]"}]}], ",", 
              RowBox[{"\"\<TransferDerivative\>\"", "->", 
