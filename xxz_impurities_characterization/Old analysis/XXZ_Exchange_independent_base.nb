      RowBox[{"gapScan", "[", 
       RowBox[{
       "run_", ",", "labels_", ",", "window_", ",", "tol_", ",", 
        "blockLength_", ",", 
        RowBox[{"minimumDimension_", ":", "500"}], ",", 
        RowBox[{"minimumRatios_", ":", "100"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Table", "[", "\n", " ", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pt", "=", 
             RowBox[{
              RowBox[{"run", "[", "\"\<Points\>\"", "]"}], "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"selectedStaticSector", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"run", "[", "\"\<Points\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "labels"}], "]"}]}]}], 
           "}"}], ",", "\n", "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Parameter\>\"", "->", 
               RowBox[{
                RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Model\>\"", "->", 
               RowBox[{"pt", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], ",", 
            "\n", "   ", 
            RowBox[{"gapDiagnostic", "[", 
             RowBox[{
              RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", "window", ",",
               "tol", ",", "blockLength", ",", "minimumDimension", ",", 
              "minimumRatios"}], "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}]}], "}"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"gapPanel", "[", 
       RowBox[{"rows_", ",", "run_", ",", 
        RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"valid", ",", "points", ",", "g"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"valid", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"rows", ",", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], "]"}], "&"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"valid", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{"tex", "[", 
               
               RowBox[{"\"\<\\\\text{No eligible mean: inspect dimensions, \
sample counts and unresolved gaps.}\>\"", ",", "18"}], "]"}], "}"}], "]"}], 
            "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "log"}], " ", "||", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"valid", ",", "\"\<Parameter\>\""}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], 
           ",", "\"\<A logarithmic horizontal axis requires positive samples.\
\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"points", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{"log", ",", 
                 RowBox[{"Log", "[", 
                  RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"NumericQ", "[", 
                  RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}], "]"}], ",", 
                 RowBox[{"Around", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], ",", 
                   RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}]}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}]}], "]"}]}], "}"}], 
             "&"}], " ", "/@", " ", "valid"}], ")"}]}], ";", "\n", " ", 
         RowBox[{"g", "=", 
          RowBox[{"ListPlot", "[", 
           RowBox[{"points", ",", 
            RowBox[{"Joined", "->", "False"}], ",", 
            RowBox[{"PlotStyle", "->", "Blue"}], ",", 
            RowBox[{"PlotMarkers", "->", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "3"}], "}"}]}], ",", 
            RowBox[{"IntervalMarkers", "->", "\"\<Bars\>\""}], ",", "\n", 
            "  ", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"Axes", "->", "False"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", "\n", "  ", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tex", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"run", "[", "\"\<Axis\>\"", "]"}], 
                    "==", "\"\<g\>\""}], ",", "\"\<g\>\"", 
                   ",", "\"\<\\\\Delta\>\""}], "]"}], ",", "19"}], "]"}], ",", 
               RowBox[{"tex", "[", 
                
                RowBox[{"\"\<\\\\langle\\\\widetilde r\\\\rangle\>\"", ",", 
                 "19"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
            RowBox[{"FrameTicks", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ticks", ",", "None"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{"log", ",", "logTicks", ",", "ticks"}], "]"}], ",", 
                 "None"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "1100"}], ",", 
            RowBox[{"Background", "->", "White"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"\"\<\\\\text{Selected-sector adjacent-gap ratios}\>\"", ",", 
           RowBox[{"regimeCaption", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "rows", "]"}], "[", "\"\<Model\>\"", 
              "]"}], ",", 
             RowBox[{"sectorTex", "[", 
              RowBox[{
               RowBox[{"First", "[", "rows", "]"}], "[", "\"\<Labels\>\"", 
               "]"}], "]"}]}], "]"}], ",", "g"}], "]"}]}]}], "\n", "]"}]}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
