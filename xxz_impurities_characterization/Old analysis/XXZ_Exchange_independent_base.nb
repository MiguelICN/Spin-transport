Cell["\<\
 3.3 Probe settings for witnesses; these do not define the map \
\>", "Subsection",ExpressionUUID->"d7dbc239-236b-784c-bed5-ffe8366cf99e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapProbes", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Rho1\>\"", "->", 
        RowBox[{"ketRho", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}], "]"}]}], ",", 
       RowBox[{"\"\<Rho2\>\"", "->", 
