Cell[CellGroupData[{

Cell["\<\
 3.4 Build the map engine from the bulk factor and inspect its support \
\>", "Subsection",ExpressionUUID->"ba4e71c4-c925-4e41-aafd-3085951569a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapModelUsed", "=", 
     RowBox[{"regimeModel", "[", "mapModel", "]"}]}], ";", 
