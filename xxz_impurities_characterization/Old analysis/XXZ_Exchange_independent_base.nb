Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"staticPoint", "[", 
       RowBox[{"p_Association", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ed", "=", 
           RowBox[{"addEntropies", "[", 
            RowBox[{"regimeED", "[", 
             RowBox[{"p", ",", "tol"}], "]"}], "]"}]}], ",", "out"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"out", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"s", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"s", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<IPR\>\"", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                    " ", "/@", " ", 
                    RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
                 "|>"}]}], "]"}]}], "]"}], ",", 
            RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n",
          " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"2.", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", 
                    RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ")"}]}], "-", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
                RowBox[{"1", "+", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{
                    RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "]"}], " ", 
                  RowBox[{"Log", "[", "2", "]"}]}], "+", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
                RowBox[{
                 RowBox[{"Log", "[", "4", "]"}], "+", 
                 RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], 
           ",", "\"\<Eigenstate bounds failed.\>\""}], "]"}], ";", "\n", " ", 
         "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"KeyDrop", "[", 
            RowBox[{"ed", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Hamiltonian\>\"", ",", "\"\<Sectors\>\""}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{"\"\<Sectors\>\"", "->", "out"}], "|>"}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"staticScan", "[", 
       RowBox[{"base_Association", ",", "axis_String", ",", "grid_List", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"models", ",", "points"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<g\>\"", ",", "\"\<Delta\>\""}], "}"}], ",", 
              "axis"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "grid", "]"}], ">=", "1"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"grid", ",", "realQ"}], "]"}], " ", "&&", "\n", "  ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "grid", "]"}], "==", "1"}], " ", "||", 
              " ", 
              RowBox[{"And", "@@", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"Differences", "[", 
                  RowBox[{"N", "[", "grid", "]"}], "]"}], ">", "0"}], 
                "]"}]}]}], ")"}]}], 
           ",", "\"\<Use an increasing real scan grid for g or Delta.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"models", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"regimeModel", "[", 
             RowBox[{"Join", "[", 
              RowBox[{"base", ",", 
               RowBox[{"<|", 
                RowBox[{"axis", "->", "#"}], "|>"}]}], "]"}], "]"}], "&"}], 
           " ", "/@", " ", "grid"}]}], ";", "\n", " ", 
         RowBox[{"points", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"staticPoint", "[", 
              RowBox[{"#", ",", "tol"}], "]"}], "&"}], ",", "models"}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Axis\>\"", "->", "axis"}], ",", 
           RowBox[{"\"\<Grid\>\"", "->", "grid"}], ",", 
           RowBox[{"\"\<BaseModel\>\"", "->", "base"}], ",", 
           RowBox[{"\"\<EDTolerance\>\"", "->", "tol"}], ",", 
           RowBox[{"\"\<Points\>\"", "->", "points"}], ",", "\n", "  ", 
           RowBox[{"\"\<SectorKeys\>\"", "->", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"sectorKey", "[", 
                    RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], 
                  " ", "/@", " ", 
                  RowBox[{"#", "[", "\"\<Sectors\>\"", "]"}]}], ")"}], "&"}], 
               " ", "/@", " ", "points"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n",
        "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
