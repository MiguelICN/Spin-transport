Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chAverage", "[", 
       RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "chi", ",", "f", ",", "scale", ",", "absolute", ",", "all", ",", 
          "clusters", ",", "widths", ",", "g", ",", "ids", ",", "masks", ",", 
          "e1", ",", "e2", ",", "labels", ",", 
          RowBox[{"matched", "=", "0"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
            RowBox[{"relativeTol", ">", "0"}]}], 
           ",", "\"\<Positive averaging tolerance required.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"16", " ", 
             RowBox[{"2", "^", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], " ", 
             RowBox[{"eng", "[", "\"\<RankC\>\"", "]"}]}], "<=", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Settings\>\"", "]"}], 
             "[", "\"\<MaxEntries\>\"", "]"}]}], 
           ",", "\"\<One exchange average Choi factor exceeds \
MaxEntries.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"all", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], "[", 
                   RowBox[{"[", "n", "]"}], "]"}], ",", "k", ",", "n"}], 
                 "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"n", ",", 
                  RowBox[{"Length", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], 
                   "]"}]}], "}"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "]"}]}], 
               "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"maxAbs", "[", 
             RowBox[{"all", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"absolute", "=", 
          RowBox[{"relativeTol", " ", "scale"}]}], ";", 
         RowBox[{"clusters", "=", 
          RowBox[{"chClusters", "[", 
           RowBox[{"all", ",", "absolute"}], "]"}]}], ";", 
         RowBox[{"widths", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
           "clusters"}]}], ";", "\n", " ", 
         RowBox[{"chi", "=", 
          RowBox[{"chExTimeAverage", "[", 
           RowBox[{"eng", ",", "absolute"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Choi\>\"", "->", 
            RowBox[{"4", " ", "chi"}]}], ",", 
           RowBox[{"\"\<ChoiState\>\"", "->", "chi"}], ",", 
           RowBox[{"\"\<Transfer\>\"", "->", 
            RowBox[{"chChoiToSuper", "[", "chi", "]"}]}], ",", 
           RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",",
            "\n", " ", 
           RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", "absolute"}], ",", 
           RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
           RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
           RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
            RowBox[{"Max", "[", "widths", "]"}]}], ",", "\n", " ", 
           RowBox[{"\"\<SingletonClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
             "]"}]}], ",", 
           RowBox[{"\"\<DegenerateClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
              RowBox[{"_", "?", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", 
           "\n", " ", 
           RowBox[{"\"\<TPError\>\"", "->", 
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"4", " ", 
               RowBox[{"chChoiTraceOut", "[", "chi", "]"}]}], "-", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
           RowBox[{"\"\<MapEntropy\>\"", "->", 
            RowBox[{"entropy", "[", "chi", "]"}]}], ",", "\n", " ", 
           RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
            RowBox[{"Min", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"herm", "[", 
                RowBox[{"choiPartialTransposeOut", "[", "chi", "]"}], "]"}], 
               "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[64]:=",ExpressionUUID->"f3a90ad4-7126-8046-a2a1-f2a9c75a06ff"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chSinglePlot", "[", 
       RowBox[{
       "records_", ",", "key_", ",", "label_", ",", "title_", ",", "p_", ",", 
        "log_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rows", ",", "g"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"rows", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                 RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", 
              " ", "records"}], ")"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&&", " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "log"}], " ", "||", " ", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], ")"}]}], 
             "&"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"rows", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tex", "[", 
                RowBox[{"title", ",", "20"}], "]"}], ",", 
               RowBox[{"tex", "[", 
                
                RowBox[{"\"\<\\\\text{No valid samples under the selected \
tolerances.}\>\"", ",", "14"}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"g", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
              RowBox[{"{", "rows", "}"}], ",", "\"\<t\>\"", ",", "label", ",", 
              RowBox[{"{", "Blue", "}"}], ",", 
              RowBox[{"{", "label", "}"}], ",", "False", ",", "log", ",", 
              RowBox[{"{", 
               RowBox[{"{", 
                RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], "}"}]}],
              "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"title", ",", 
           RowBox[{"trajectoryCaption", "[", 
            RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], "\n",
        "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chPlots", "[", 
       RowBox[{"records_", ",", "p_", ",", 
        RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"out", "=", 
          RowBox[{"mapPlots", "[", 
           RowBox[{"records", ",", "p", ",", "log"}], "]"}]}], "}"}], ",", 
        "\n", " ", 
        RowBox[{
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<TimeReversalError\>\"", "->", 
            RowBox[{"chSinglePlot", "[", 
             RowBox[{
             "records", ",", "\"\<TimeReversalError\>\"", ",", "\n", 
              "  ", "\"\<\\\\|S_{-t}^{[\\\\rho_E]}-(S_t^{[\\\\rho_E^*]})^*\\\\\
|_{\\\\max}\>\"", ",", "\"\<\\\\text{Conjugate-bulk time-reversal check}\>\"",
               ",", "p", ",", "log"}], "]"}]}]}], "]"}], ";", "\n", " ", "\n",
          " ", "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[65]:=",ExpressionUUID->"fd5d244d-11d2-8449-ab53-2c94c5d47f3e"],

Cell["\<\
 Revision-2 channel engine adapted to the existing conventions: L is TOTAL \
length; the bulk has L-2 spins; S=sigma/2 and the exchange flip amplitude is \
g/2. Stored Choi still has trace 4, ChoiState trace 1. No fields are \
introduced. Guide field-retuning examples and its SU(2) suggestion do not \
apply to these XY-only end bonds. The legacy map helpers remain available to \
the unchanged QST chapter; chapter 3 uses only the new ch-prefixed engine. \
\>", "Text",ExpressionUUID->"2325e784-73d4-754d-a536-62578834733d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 3.2 Independent map parameters and bulk state ", "Subsection",ExpressionUUID->"13b84cb7-b46e-9a4d-b2db-994a028f6d51"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapModel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
       RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
       RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"mapBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
       RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Alternative", ":", " ", "mapBulk"}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
         RowBox[{"\"\<q\>\"", "->", 
          RowBox[{"Pi", "/", "3"}]}], ",", 
         RowBox[{"\"\<theta\>\"", "->", 
          RowBox[{"Pi", "/", "2"}]}], ",", 
         RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";"}], " ", "*)"}], 
    "\n", 
    RowBox[{"mapTime", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
       RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
       RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
       RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
       RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"mapSettings", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<EDTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<ValidationTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
       RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<RankTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
       RowBox[{"\"\<AverageEnergyTolerance\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<SignalThreshold\>\"", "->", "0.01"}], ",", "\n", " ", 
       RowBox[{"\"\<Symmetries\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<ZZMethod\>\"", "->", "Automatic"}], ",", 
       RowBox[{"\"\<BatchTimes\>\"", "->", "64"}], ",", "\n", " ", 
       RowBox[{"\"\<MaxColumns\>\"", "->", "4096"}], ",", 
       RowBox[{"\"\<MaxEntries\>\"", "->", 
        RowBox[{"2", "^", "22"}]}], ",", 
       RowBox[{"\"\<MaxOverlapEntries\>\"", "->", 
        RowBox[{"2", "^", "24"}]}], ",", "\n", " ", 
       RowBox[{"\"\<TimeReversalCheck\>\"", "->", "\"\<Endpoints\>\""}]}], 
      "|>"}]}], ";", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"Exact", " ", "zero"}], "-", 
       RowBox[{"column", " ", "pruning", " ", 
        RowBox[{"only", ".", " ", 
         RowBox[{"ZZMethod", ":", " ", "Automatic"}]}]}]}], ",", 
      " ", "\"\<Direct\>\"", ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"\"\<Overlap\>\"", ".", "\n", " ", "MaxEntries"}], " ", 
         "limits", " ", "ONE", " ", "exchange", " ", "Choi"}], "-", 
        RowBox[{"factor", " ", "array"}]}], ";", " ", 
       RowBox[{
        RowBox[{"derivatives", "/", "temporaries"}], " ", "add", " ", 
        RowBox[{"memory", ".", "\n", " ", 
         RowBox[{"TimeReversalCheck", ":", " ", "\"\<None\>\""}]}]}]}], ",", 
      " ", 
      RowBox[{"\"\<Endpoints\>\"", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"first", "/", "middle"}], "/", "last"}], ")"}]}], ",", " ", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"or", " ", 
           RowBox[{"\"\<All\>\"", ".", "\n", " ", "Optional"}], " ", 
           "sector"}], "-", 
          RowBox[{"defined", " ", "thermal", " ", "estimator", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"different", " ", "finite"}], "-", 
             RowBox[{"sample", " ", "ensemble"}]}], ")"}]}]}], ":", "\n", " ",
          "mapBulk"}], "=", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<SectorTypical\>\""}], ",", 
          RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
          RowBox[{"\"\<SamplesPerSector\>\"", "->", "2"}], ",", 
          RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"Existing", " ", "Type"}], "->", 
        RowBox[{
         RowBox[{"\"\<Typical\>\"", " ", "keeps", " ", "its", " ", "original",
           " ", "global", " ", "random"}], "-", 
         RowBox[{"vector", " ", 
          RowBox[{"definition", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{"mapComputeInfiniteTimeAverage", "=", "True"}], ";", "\n", 
    RowBox[{"mapLogHorizontalAxis", "=", "False"}], ";", "\n", 
    RowBox[{"mapOutputRoot", "=", 
     RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
    RowBox[{"mapRunLabel", "=", "\"\<Exchange_map_dynamics\>\""}], ";"}], 
   "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{
  4.001122119453491*^9, {4.001123182296028*^9, 4.0011232070985584`*^9}},
 CellLabel->"In[67]:=",ExpressionUUID->"08829554-efac-e244-a813-7e7bfcb74fef"]
}, Open  ]],

