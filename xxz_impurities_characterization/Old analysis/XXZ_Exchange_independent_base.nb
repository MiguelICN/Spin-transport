         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"tex", "[", 
              RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
            RowBox[{"{", "\n", " ", 
             RowBox[{
              RowBox[{"\"\<\\\\mathrm{Exchange}:\\\\quad L=\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
               "<>", "\"\<;\\\\quad J=\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}]}], ",", "\n", " ", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{
