Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chBuild", "[", 
       RowBox[{"p_", ",", "bf_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"cp", "=", 
           RowBox[{"chParameters", "[", 
            RowBox[{"p", ",", "cfg"}], "]"}]}], ",", "e", ",", "weights", ",",
           "bl", ",", "ids", ",", "r", ",", "zero"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MatrixQ", "[", 
             RowBox[{"bf", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "bf", "]"}], "==", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], 
            " ", "&&", " ", 
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Norm", "[", 
                 RowBox[{"bf", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], 
               "-", "1"}], "]"}], "<", 
             RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}], 
           ",", "\"\<Invalid bulk factor.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{"Dimensions", "[", "bf", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
             RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}], "]"}], 
           ",", "\"\<Symmetries must be Automatic or None.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"cfg", "[", "\"\<ProjectionCutoff\>\"", "]"}], "==", 
            "0"}], ",", "\"\<Chapter 3 prunes exactly zero columns only: set \
ProjectionCutoff->0.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ">", "0"}], " ",
