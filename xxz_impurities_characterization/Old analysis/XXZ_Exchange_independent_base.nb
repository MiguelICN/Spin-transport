Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chRecord", "[", 
       RowBox[{"t_", ",", "v_", ",", "cfg_", ",", "probes_"}], "]"}], " ", ":=",
       " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"v", "[", "\"\<Choi\>\"", "]"}]}], ",", 
          RowBox[{"s", "=", 
           RowBox[{"v", "[", "\"\<Transfer\>\"", "]"}]}], ",", 
          RowBox[{"sd", "=", 
           RowBox[{"v", "[", "\"\<TransferDerivative\>\"", "]"}]}], ",", "e", 
          ",", "pt", ",", "sv", ",", "gen", ",", "rates", ",", "mixed", ",", 
          "lambda", ",", "f", ",", "fd", ",", "z", ",", "entropyC"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"e", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", "c", "]"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"pt", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", 
              RowBox[{"choiPartialTransposeOut", "[", 
               RowBox[{"c", "/", "4"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"sv", "=", 
          RowBox[{"transferMinSV", "[", "s", "]"}]}], ";", 
         RowBox[{"entropyC", "=", 
          RowBox[{"entropy", "[", 
           RowBox[{"c", "/", "4"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"sv", ">=", 
