    RowBox[{"qstBInfiniteTime", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "qstBComputeInfiniteTime", "]"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"qstAverageChannel", "[", 
          RowBox[{"qstBEngine", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
        "qstBClusterTolerances"}], ",", 
       RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], ";", 
    "\n", 
    RowBox[{"qstBWindowR", "=", 
     RowBox[{"qstWindowMean", "[", 
      RowBox[{"qstBRecords", ",", "\"\<OmegaR\>\""}], "]"}]}], ";", "\n", 
    RowBox[{"{", 
     RowBox[{"qstBInfiniteTime", ",", "qstBWindowR"}], "}"}]}], "\n", ")"}], 
  ";"}]], "Code",
 CellChangeTimes->{4.0011233876645527`*^9},
 CellLabel->
  "In[118]:=",ExpressionUUID->"405d48e4-fb5c-2d41-acea-c73bca483d90"],

Cell["\<\
 Energy clusters include all evolved sectors together (ZZ: all four edge \
configurations), preserving coherences within each degenerate cluster. \
Compare the results at all cluster tolerances. The sampled-window rugosity \
uses trapezoidal integration in physical time, including on a logarithmic \
grid. A sampled zero makes this estimate \
Missing[SingularSamplesRequireQuadrature], because an isolated logarithmic \
singularity need not have an infinite integral. It is never replaced by the \
rugosity of an averaged state. \
\>", "Text",ExpressionUUID->"0121489d-ac3c-e148-b3a7-a68d9cb84330"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 4.B.6 Plots from the settings attached to the computed records \
\>", "Subsection",ExpressionUUID->"668e55f0-125f-4b4a-9534-aaa28bb388d7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"qstBPlots", "=", 
     RowBox[{"texturizingPanels", "[", 
      RowBox[{"qstBRecords", ",", "qstBUsed", ",", "False"}], "]"}]}], ";", 
    "\n", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "qstBExportLogPlots", "]"}], ",", 
      RowBox[{"qstBPlots", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"qstBPlots", ",", "\n", " ", 
         RowBox[{"Association", "[", 
          RowBox[{"KeyValueMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], 
             "&"}], ",", 
            RowBox[{"texturizingPanels", "[", 
             RowBox[{"qstBRecords", ",", "qstBUsed", ",", "True"}], "]"}]}], 
           "]"}], "]"}]}], "]"}]}]}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"qstBPlots", "[", "\"\<ThreeRoutes\>\"", "]"}], "]"}], ";"}], 
   "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{4.0011233918878098`*^9},
 CellLabel->
  "In[119]:=",ExpressionUUID->"d8a12ee0-c9c0-8f49-99b2-fb9d60da3c9a"],

