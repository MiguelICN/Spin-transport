               "<>", "\"\<=\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"p", "[", "fixed", "]"}], "]"}], 
               "<>", "\"\<;\\\\quad \>\"", "<>", "\n", " ", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"axis", "==", "\"\<Delta\>\""}], 
                 ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}], 
               "<>", "\"\<\\\\in[\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"First", "[", 
                 RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
               "<>", "\"\<,\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"Last", "[", 
                 RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
               "<>", "\"\<]; N=\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"Length", "[", 
