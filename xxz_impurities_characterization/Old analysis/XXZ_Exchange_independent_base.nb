Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chTimeReversal", "[", 
       RowBox[{"eng_", ",", "times_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "ix", ",", "ts", ",", "neg", ",", "pos", ",", "conj", ",", "errs"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"ix", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<TimeReversalCheck\>\"", "]"}], 
            ",", "\"\<None\>\"", ",", 
            RowBox[{"{", "}"}], ",", "\"\<Endpoints\>\"", ",", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "times", "]"}], "/", "2"}], "]"}], ",", 
               RowBox[{"Length", "[", "times", "]"}]}], "}"}], "]"}], 
            ",", "\"\<All\>\"", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "times", "]"}], "]"}], ",", "_", ",", 
            RowBox[{"check", "[", 
             RowBox[{
             "False", 
              ",", "\"\<TimeReversalCheck must be None, Endpoints or All \
(strings).\>\""}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ix", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Indices\>\"", "->", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"\"\<Times\>\"", "->", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"\"\<Errors\>\"", "->", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"\"\<Maximum\>\"", "->", 
               RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}]}], 
             "|>"}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"ts", "=", 
          RowBox[{"times", "[", 
           RowBox[{"[", "ix", "]"}], "]"}]}], ";", 
         RowBox[{"conj", "=", 
          RowBox[{"chConjugateEngine", "[", "eng", "]"}]}], ";", "\n", " ", 
         RowBox[{"neg", "=", 
          RowBox[{"chSeries", "[", 
           RowBox[{"eng", ",", 
            RowBox[{"-", "ts"}], ",", "cfg"}], "]"}]}], ";", 
         RowBox[{"pos", "=", 
          RowBox[{"chSeries", "[", 
           RowBox[{"conj", ",", "ts", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"errs", "=", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"#1", "[", "\"\<Transfer\>\"", "]"}], "-", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"#2", "[", "\"\<Transfer\>\"", "]"}], "]"}]}], "]"}], 
             "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"neg", ",", "pos"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", "errs", "]"}], "<", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
           ",", "\"\<Conjugate-bulk time-reversal check failed.\>\""}], "]"}],
          ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Indices\>\"", "->", "ix"}], ",", 
           RowBox[{"\"\<Times\>\"", "->", "ts"}], ",", 
           RowBox[{"\"\<Errors\>\"", "->", "errs"}], ",", 
           RowBox[{"\"\<Maximum\>\"", "->", 
            RowBox[{"Max", "[", "errs", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
