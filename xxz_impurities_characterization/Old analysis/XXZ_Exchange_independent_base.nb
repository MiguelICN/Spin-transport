Cell["\<\
 Only new QST symbols are cleared. Stored quantities are never clipped: an \
exactly zero grand sum gives Infinity; a negative grand sum gives \
Missing[NegativeGrandSum,...] and is reported. The new batch wrapper calls \
evolveBatch, stateRecord and mapChoiFromFactor unchanged. It supports serial \
batches or existing/new parallel kernels without resetting them. MemoryMB \
bounds estimated transient factor storage, not the total ED/record memory. A \
failed or aborted batch stops the parent evaluation; partial results are not \
returned. QST uses the revised shared numerical definitions; model and bulk \
inputs remain independent of chapters 1\[Dash]3. \
\>", "Text",ExpressionUUID->"fae1a65c-9d37-9c49-baee-b1c17668cfae"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 4.A.1 Open dynamics of the textureless edge state \[LongDash] editable \
inputs \
\>", "Subsection",ExpressionUUID->"ab1a5802-ac2e-334b-ad57-5396c0806602"],

Cell["\<\
 rho(0)=f1_AB tensor rhoE. There is no editable edge state. The exact \
full-system unitary is reduced to the two edges at every time. Every standard \
chapter-2 state observable is retained alongside the texture quantities. ZZ \
uses the four conditional bulk Hamiltonians; exchange uses occupied \
full-chain symmetry sectors. \
\>", "Text",ExpressionUUID->"d6340abe-47f5-024b-9eca-5b84336b1cb2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
  RowBox[{"qstABulk", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
     RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", 
  RowBox[{"qstABulkNote", "=", "\"\<Neel bulk, first bit 0\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternatives", ":", " ", 
      RowBox[{
      "replace", " ", "the", " ", "one", " ", "assignment", " ", "above", " ",
        "and", " ", "its", " ", 
       RowBox[{"note", ".", "\n", " ", "qstABulk"}]}]}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Polarized\>\""}], ",", 
       RowBox[{"\"\<Bit\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "planar", " ", "*)"}], "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "4"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "conical", " ", "*)"}], "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<PolarHelix\>\""}], ",", 
       RowBox[{"\"\<ThetaList\>\"", "->", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "6"}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"Pi", "/", "6"}]}], ",", 
           RowBox[{
            RowBox[{"qstAModel", "[", "\"\<L\>\"", "]"}], "-", "3"}]}], "]"}],
          "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<PhiList\>\"", "->", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{
