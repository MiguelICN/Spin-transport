Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstReferenceTrace", "[", 
       RowBox[{"r_", ",", "l_"}], "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Table", "[", "\n", " ", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"a", " ", 
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
                RowBox[{"2", " ", "m"}], "+", "b", "+", "1"}], ",", 
               RowBox[{
                RowBox[{"aa", " ", 
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
                RowBox[{"2", " ", "m"}], "+", "bb", "+", "1"}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "0", ",", 
              RowBox[{
               RowBox[{"2", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "-", "2"}], ")"}]}], "-", "1"}]}], "}"}]}], 
           "]"}], ",", "\n", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstReferenceEmbed", "[", 
       RowBox[{"x_", ",", "rm_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", " ", "a"}], "+", "b", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"2", " ", "aa"}], "+", "bb", "+", "1"}]}], "]"}], "]"}], 
         "\n", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"a", "+", "1"}]}], "]"}], ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"aa", "+", "1"}]}], "]"}]}], "]"}], ",", "rm", ",", 
           "\n", " ", 
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"b", "+", "1"}]}], "]"}], ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"bb", "+", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstSmallReference", "[", 
       RowBox[{"p_", ",", "bf_", ",", "records_", ",", "mode_", ",", 
        RowBox[{"maxL_", ":", "6"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "rm", ",", 
          RowBox[{"errs", "=", 
           RowBox[{"{", "}"}]}], ",", "u", ",", "ref"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"l", ">", "maxL"}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Missing", "[", 
             RowBox[{"\"\<SkippedAboveL\>\"", ",", "maxL"}], "]"}], "]"}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"h", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"rm", "=", 
          RowBox[{"bf", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "bf", "]"}]}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "=", 
             RowBox[{"MatrixExp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], " ", "h"}], "]"}]}],
             ";", "\n", "  ", 
            RowBox[{"ref", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"mode", "==", "\"\<State\>\""}], ",", 
               RowBox[{"qstReferenceTrace", "[", 
                RowBox[{
                 RowBox[{"u", " ", ".", " ", 
                  RowBox[{"qstReferenceEmbed", "[", 
                   RowBox[{"edgeF1", ",", "rm"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "l"}],
                 "]"}], ",", "\n", "   ", 
               RowBox[{"ArrayFlatten", "[", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"qstReferenceTrace", "[", 
                   RowBox[{
                    RowBox[{"u", " ", ".", " ", 
                    RowBox[{"qstReferenceEmbed", "[", 
                    RowBox[{
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "i"}], "]"}], ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "j"}], "]"}]}], "]"}], ",", "rm"}], 
                    "]"}], " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", 
                    "l"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "4"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "4"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
            ";", "\n", "  ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"errs", ",", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"ref", "-", 
                RowBox[{"rec", "[", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"mode", "==", "\"\<State\>\""}], 
                   ",", "\"\<RhoAB\>\"", ",", "\"\<Choi\>\""}], "]"}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"rec", ",", 
             RowBox[{"records", "[", 
              RowBox[{"[", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"Ceiling", "[", 
                   RowBox[{
                    RowBox[{"Length", "[", "records", "]"}], "/", "2"}], 
                   "]"}], ",", 
                  RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], 
               "]"}], "]"}]}], "}"}]}], "]"}], ";", 
         RowBox[{"Max", "[", "errs", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[94]:=",ExpressionUUID->"4c678b47-66f3-9847-8711-22897a029375"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstStateChecks", "[", 
       RowBox[{
       "eng_", ",", "fac_", ",", "bf_", ",", "records_", ",", "tol_"}], "]"}],
       " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "zero", ",", "r0", ",", "checks", ",", "endpoint", ",", "full"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"zero", "=", 
          RowBox[{"First", "[", 
           RowBox[{"textureRecords", "[", 
            RowBox[{"stateTrajectory", "[", 
             RowBox[{"eng", ",", "fac", ",", 
              RowBox[{"{", "0.", "}"}], ",", "tol"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"r0", "=", 
          RowBox[{"zero", "[", "\"\<RhoAB\>\"", "]"}]}], ";", "\n", " ", 
         RowBox[{"endpoint", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}], "-", 
               RowBox[{"reducedState", "[", 
                RowBox[{
                 RowBox[{"evolve", "[", 
                  RowBox[{
                   RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], ",", "eng"}], 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
                 RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rec", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"First", "[", "records", "]"}], ",", 
                 RowBox[{"Last", "[", "records", "]"}]}], "}"}]}], "}"}]}], 
            "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"full", "=", 
          RowBox[{"qstSmallReference", "[", 
           RowBox[{
            RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], ",", "bf", ",", 
            "records", ",", "\"\<State\>\""}], "]"}]}], ";", "\n", " ", 
         RowBox[{"checks", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<InitialF1Error\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"r0", "-", "edgeF1"}], "]"}]}], ",", 
            RowBox[{"\"\<InitialTextureError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"zero", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
                RowBox[{"zero", "[", "\"\<TextureFAB\>\"", "]"}], ",", 
                RowBox[{"zero", "[", "\"\<RugosityAB\>\"", "]"}]}], "}"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<PauliIdentityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}], "-", 
                    RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}], "-", 
                    RowBox[{"#", "[", "\"\<CorrelationXX\>\"", "]"}]}], ",", 
                    "\n", "  ", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "/", "4"}], "-", 
                    RowBox[{"#", "[", "\"\<F1Probability\>\"", "]"}]}]}], 
                   "}"}], "]"}], "&"}], ",", "records"}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<BoundsViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "2"}], ",", 
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "2"}]}], 
                    "}"}], "&"}], ",", "records"}], "]"}], "]"}], "]"}]}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<TraceError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}],
             ",", 
            RowBox[{"\"\<HermiticityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<PositivityViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], 
                 "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<BatchEndpointError\>\"", "->", "endpoint"}], ",", 
            "\n", " ", 
            RowBox[{"\"\<FullChainReferenceError\>\"", "->", "full"}], ",", 
            RowBox[{"\"\<SectorReconstructionError\>\"", "->", 
             RowBox[{"eng", "[", "\"\<ReconstructionError\>\"", "]"}]}]}], 
           "|>"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Values", "[", "checks", "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"MissingQ", "[", "#", "]"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"realQ", "[", "#", "]"}], " ", "&&", " ", 
                 RowBox[{"#", "<", "tol"}]}], ")"}]}], "&"}]}], "]"}], 
           ",", "\"\<QST state validation failed.\>\""}], "]"}], ";", 
         "checks"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstMapChecks", "[", 
       RowBox[{"eng_", ",", "bf_", ",", "records_", ",", "settings_"}], "]"}],
       " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tol", "=", 
           RowBox[{"settings", "[", "\"\<ValidationTolerance\>\"", "]"}]}], ",",
           "zero", ",", "checks"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"zero", "=", 
          RowBox[{"texturizingRecord", "[", 
           RowBox[{"0.", ",", 
            RowBox[{
             RowBox[{"mapAt", "[", 
              RowBox[{"0.", ",", "eng"}], "]"}], "[", "\"\<Transfer\>\"", 
             "]"}], ",", "settings"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"checks", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<InitialTransferError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
               RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}]}], ",", 
            "\n", " ", 
            RowBox[{"\"\<InitialOmegaError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"zero", "[", "\"\<OmegaTF\>\"", "]"}], ",", 
                RowBox[{"zero", "[", "\"\<OmegaR\>\"", "]"}]}], "}"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<InitialResponseError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"zero", "[", "\"\<ResponseOperator\>\"", "]"}], "-", 
               RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ThreeRouteError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<RouteError\>\""}], "]"}], "]"}]}],
             ",", 
            RowBox[{"\"\<ResponseHermiticityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ResponseHermiticityError\>\""}], 
               "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ResponsePositivityViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<ResponseMinimum\>\""}], "]"}], 
                 "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<ResponseF1Error\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ResponseF1Error\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<CPViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<MinChoiEigenvalue\>\""}], 
                  "]"}], "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<TPError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<TPError\>\""}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<BatchEndpointError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"maxAbs", "[", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<Transfer\>\"", "]"}], "-", 
                  RowBox[{
                   RowBox[{"mapAt", "[", 
                    RowBox[{
                    RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], ",", "eng"}], 
                    "]"}], "[", "\"\<Transfer\>\"", "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"rec", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"First", "[", "records", "]"}], ",", 
                    RowBox[{"Last", "[", "records", "]"}]}], "}"}]}], "}"}]}],
                "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<FullChainReferenceError\>\"", "->", 
             RowBox[{"qstSmallReference", "[", 
              RowBox[{
               RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], ",", "bf", ",",
                "records", ",", "\"\<Map\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<SectorReconstructionError\>\"", "->", 
             RowBox[{"eng", "[", "\"\<ReconstructionError\>\"", "]"}]}]}], 
           "|>"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Values", "[", "checks", "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"MissingQ", "[", "#", "]"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"realQ", "[", "#", "]"}], " ", "&&", " ", 
                 RowBox[{"#", "<", "tol"}]}], ")"}]}], "&"}]}], "]"}], 
           ",", "\"\<QST channel validation failed.\>\""}], "]"}], ";", 
         "checks"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstRandomResponseCheck", "[", 
       RowBox[{"records_", ",", "count_", ",", "seed_", ",", "tol_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"states", ",", "selected", ",", "err"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", "count", "]"}], " ", "&&", " ", 
            RowBox[{"count", ">", "0"}], " ", "&&", " ", 
            RowBox[{"IntegerQ", "[", "seed", "]"}]}], 
           ",", "\"\<Random test count must be positive; seed must be an \
integer.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"states", "=", 
          RowBox[{"BlockRandom", "[", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a", "=", 
                  RowBox[{
                   RowBox[{"RandomReal", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "+", 
                   RowBox[{"I", " ", 
                    RowBox[{"RandomReal", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]}], "}"}], ",",
                 "\n", "  ", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"r", "=", 
                    RowBox[{"a", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], "}"}], 
                  ",", 
                  RowBox[{"r", "/", 
                   RowBox[{"Tr", "[", "r", "]"}]}]}], "]"}]}], "]"}], ",", 
              RowBox[{"{", "count", "}"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"selected", "=", 
          RowBox[{"records", "[", 
           RowBox[{"[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "records", "]"}], "/", "2"}], "]"}], ",", 
               RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], "]"}],
            "]"}]}], ";", "\n", " ", 
         RowBox[{"err", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Tr", "[", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<ResponseOperator\>\"", "]"}], " ", 
                  ".", " ", "r"}], "]"}], "-", 
                RowBox[{"grandSum", "[", 
                 RowBox[{"applyTransfer", "[", 
                  RowBox[{
                   RowBox[{"rec", "[", "\"\<Transfer\>\"", "]"}], ",", "r"}], 
                  "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"rec", ",", "selected"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "states"}], "}"}]}], "]"}], "]"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"err", "<", "tol"}], 
           ",", "\"\<Random-input response-operator validation failed.\>\""}],
           "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Count\>\"", "->", "count"}], ",", 
           RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
           RowBox[{"\"\<Times\>\"", "->", 
            RowBox[{"Lookup", "[", 
             RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}]}], ",", 
           RowBox[{"\"\<MaxError\>\"", "->", "err"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstCompare", "[", 
       RowBox[{"a_", ",", "b_", ",", "ar_", ",", "br_", ",", "tol_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"err", ",", "matrixError"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"SameQ", "[", 
            RowBox[{
             RowBox[{"KeyTake", "[", 
              RowBox[{"a", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
                 ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
                 ",", "\"\<Settings\>\""}], "}"}]}], "]"}], ",", "\n", "  ", 
             RowBox[{"KeyTake", "[", 
              RowBox[{"b", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
                 ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
                 ",", "\"\<Settings\>\""}], "}"}]}], "]"}]}], "]"}], ",", 
           "\n", "  ", "\"\<A/B comparison refused: computed model, bulk, \
grid or numerical settings differ.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "ar", "]"}], "==", 
             RowBox[{"Length", "[", "br", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "ar", "]"}], "==", 
             RowBox[{"Length", "[", 
              RowBox[{"a", "[", "\"\<Times\>\"", "]"}], "]"}]}], " ", "&&", 
            "\n", "  ", 
            RowBox[{"SameQ", "[", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"ar", ",", "\"\<Time\>\""}], "]"}], ",", 
              RowBox[{"Lookup", "[", 
               RowBox[{"br", ",", "\"\<Time\>\""}], "]"}], ",", 
              RowBox[{"a", "[", "\"\<Times\>\"", "]"}]}], "]"}]}], 
           ",", "\"\<A/B comparison refused: record times do not match the \
used snapshots.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"err", "=", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"ar", ",", "\"\<SigmaAB\>\""}], "]"}], "-", 
            RowBox[{"Lookup", "[", 
             RowBox[{"br", ",", "\"\<SigmaOutput\>\""}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"matrixError", "=", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"ar", ",", "\"\<RhoAB\>\""}], "]"}], "-", 
            RowBox[{"Lookup", "[", 
             RowBox[{"br", ",", "\"\<OutputF1\>\""}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"err", ",", "matrixError"}], "]"}], "<", "tol"}], 
           ",", "\"\<Independent A/B edge matrices or grand sums \
disagree.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<MaxSigmaError\>\"", "->", "err"}], ",", 
           RowBox[{"\"\<MaxMatrixError\>\"", "->", "matrixError"}], ",", 
           RowBox[{"\"\<Tolerance\>\"", "->", "tol"}], ",", 
           RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstEdgeConservationError", "[", "p_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"h", "=", 
           RowBox[{"N", "[", 
            RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}]}], ",", "z"}],
          "}"}], ",", "\n", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"z", "=", 
             RowBox[{"siteOp", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "j", 
               ",", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"h", " ", ".", " ", "z"}], "-", 
              RowBox[{"z", " ", ".", " ", "h"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "}"}]}], "}"}]}], 
          "]"}], "]"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[95]:=",ExpressionUUID->"26b24517-9bcf-a844-8ba5-314f5463503a"]
}, Closed]],

Cell[CellGroupData[{

Cell[" QST plotting and export definitions ", "Subsubsection",ExpressionUUID->"8279cb77-f55c-0948-9ce9-1b21c810dded"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstTex", "[", 
       RowBox[{"s_String", ",", 
        RowBox[{"size_", ":", "14"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"tex", "[", 
       RowBox[{"s", ",", "size"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstTicks", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lo_", ",", "hi_"}], "}"}], ",", 
        RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "v", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"v", "=", 
          RowBox[{"If", "[", 
           RowBox[{"log", ",", "\n", "  ", 
            RowBox[{
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{"0", "<", "lo", "<=", "hi"}], 
               ",", "\"\<Log ticks require a positive range.\>\""}], "]"}], ";",
              "\n", "  ", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"10.", "^", 
                RowBox[{"Range", "[", 
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{"Log10", "[", "lo", "]"}], "]"}], ",", 
                  RowBox[{"Ceiling", "[", 
                   RowBox[{"Log10", "[", "hi", "]"}], "]"}]}], "]"}]}], ",", 
               RowBox[{
                RowBox[{"lo", "<=", "#", "<=", "hi"}], "&"}]}], "]"}]}], ",", 
            "\n", "  ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"lo", "==", "hi"}], ",", 
              RowBox[{"{", "lo", "}"}], ",", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"lo", ",", "hi", ",", "4"}], "]"}]}], "]"}]}], "]"}]}],
          ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"log", " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "v", "]"}], "<", "2"}]}], ",", 
           RowBox[{"v", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"lo", "==", "hi"}], ",", 
              RowBox[{"{", "lo", "}"}], ",", 
              RowBox[{"Exp", "[", 
               RowBox[{"Subdivide", "[", 
                RowBox[{
                 RowBox[{"Log", "[", "lo", "]"}], ",", 
                 RowBox[{"Log", "[", "hi", "]"}], ",", "4"}], "]"}], "]"}]}], 
             "]"}]}]}], "]"}], ";", "\n", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{"log", ",", 
                RowBox[{"Log", "[", "#", "]"}], ",", "#"}], "]"}], ",", 
              RowBox[{"qstTex", "[", 
               RowBox[{
                RowBox[{"texNumber", "[", "#", "]"}], ",", "11"}], "]"}]}], 
             "}"}], "&"}], " ", "/@", " ", "v"}], ")"}]}]}], "\n", "]"}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"qstCaption", "[", "snap_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p", "=", 
           RowBox[{"snap", "[", "\"\<Model\>\"", "]"}]}], ",", 
          RowBox[{"t", "=", 
           RowBox[{"snap", "[", "\"\<Times\>\"", "]"}]}], ",", "dt"}], "}"}], 
        ",", "\n", " ", 
        RowBox[{
         RowBox[{"dt", "=", 
          RowBox[{"Differences", "[", "t", "]"}]}], ";", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", "\n", " ", 
            RowBox[{
             RowBox[{"qstTex", "[", 
              RowBox[{
               RowBox[{"\"\<\\\\mathrm{Exchange}: L=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
                "<>", "\"\<; J=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}], 
                "<>", "\"\<; \\\\Delta=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], 
                "<>", "\"\<; g=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<g\>\"", "]"}], "]"}]}], ",", "12"}], 
              "]"}], ",", "\n", " ", 
             RowBox[{"Style", "[", 
              RowBox[{
               RowBox[{"\"\<Bulk: \>\"", "<>", 
                RowBox[{"snap", "[", "\"\<BulkNote\>\"", "]"}]}], ",", "12"}],
               "]"}], ",", "\n", " ", 
             RowBox[{"qstTex", "[", 
              RowBox[{
               RowBox[{"\"\<t\\\\in[\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"First", "[", "t", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"Last", "[", "t", "]"}], "]"}], 
                "<>", "\"\<]; N_t=\>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{"Length", "[", "t", "]"}], "]"}], "<>", "\n", 
                " ", "\"\<; \\\\delta t\\\\in[\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"Min", "[", "dt", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"Max", "[", "dt", "]"}], "]"}], "<>", "\"\<]\>\""}], 
               ",", "12"}], "]"}]}], "}"}], ",", 
           RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "\n", "]"}]}], 
     ";", "\n", 
     RowBox[{
      RowBox[{"qstPanel", "[", 
       RowBox[{"records_", ",", "keys_", ",", "ylabel_", ",", "snap_", ",", 
        RowBox[{"log_", ":", "False"}], ",", 
        RowBox[{"labels_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "selected", ",", "curves", ",", "finite", ",", "rail", ",", "bad", ",",
           "allcurves", ",", "styles", ",", "markers", ",", "legend", ",", 
          "yr", ",", "xr", ",", "g", ",", 
          RowBox[{"notes", "=", 
           RowBox[{"{", "}"}]}], ",", "excluded", ",", "badIds"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"selected", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"records", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"!", "log"}], " ", "||", " ", 
              RowBox[{
               RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ">", "0"}]}], "&"}]}],
            "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], 
           ",", "\"\<No positive times available for log-time plot.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"curves", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                 RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", 
              " ", "selected"}], ")"}], ",", 
            RowBox[{"{", 
             RowBox[{"key", ",", "keys"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"finite", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"realQ", "[", 
                RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}]}], "]"}], "&"}],
            " ", "/@", " ", "curves"}]}], ";", "\n", " ", 
         RowBox[{"rail", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Flatten", "[", 
              RowBox[{"finite", ",", "1"}], "]"}], "===", 
             RowBox[{"{", "}"}]}], ",", "1.", ",", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{"finite", ",", "1"}], "]"}]}], "]"}]}], "]"}], "+", 
             RowBox[{".15", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Max", "[", 
                 RowBox[{"Abs", "[", 
                  RowBox[{"Last", " ", "/@", " ", 
                   RowBox[{"Flatten", "[", 
                    RowBox[{"finite", ",", "1"}], "]"}]}], "]"}], "]"}]}], 
               "]"}]}]}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"bad", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{"realQ", "[", 
                 RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}], "&"}]}], 
             "]"}], "&"}], " ", "/@", " ", "curves"}]}], ";", "\n", " ", 
         RowBox[{"badIds", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "keys", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"bad", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "=!=", 
              RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"allcurves", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"finite", ",", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"First", "[", "#", "]"}], ",", "rail"}], "}"}], 
                  "&"}], " ", "/@", " ", "#"}], ")"}], "&"}], ",", 
              RowBox[{"bad", "[", 
               RowBox[{"[", "badIds", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{"log", ",", 
           RowBox[{"allcurves", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Log", "[", 
                  RowBox[{"First", "[", "#", "]"}], "]"}], ",", 
                 RowBox[{"Last", "[", "#", "]"}]}], "}"}], "&"}], ",", 
              "allcurves", ",", 
              RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", " ", 
         RowBox[{"styles", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "keys", "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
             "badIds"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"markers", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Switch", "[", 
                 RowBox[{
                  RowBox[{"Mod", "[", 
                   RowBox[{
                    RowBox[{"k", "-", "1"}], ",", "3"}], "]"}], ",", "0", 
                  ",", "\"\<\[FilledCircle]\>\"", ",", "1", 
                  ",", "\"\<\[EmptyCircle]\>\"", ",", "2", 
                  ",", "\"\<\[Times]\>\""}], "]"}], ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}], ",", 
            "\n", "  ", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[EmptyUpTriangle]\>\"", ",", "7"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"Length", "[", "badIds", "]"}], "}"}]}], "]"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"legend", "=", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"qstTex", "[", 
               RowBox[{"#", ",", "11"}], "]"}], "&"}], " ", "/@", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"labels", "===", "Automatic"}], ",", 
               RowBox[{"observableLabel", " ", "/@", " ", "keys"}], ",", 
               "labels"}], "]"}]}], ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"qstTex", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"observableLabel", "[", 
                  RowBox[{"keys", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}], 
                 "<>", "\"\<\\\\;(\\\\mathrm{singular/invalid})\>\""}], ",", 
                "10"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "badIds"}], "}"}]}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"yr", "=", 
          RowBox[{"MinMax", "[", 
           RowBox[{"Last", " ", "/@", " ", 
            RowBox[{"Flatten", "[", 
             RowBox[{"allcurves", ",", "1"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "yr", "]"}], "==", 
            RowBox[{"Last", "[", "yr", "]"}]}], ",", 
           RowBox[{"yr", "+=", " ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", ".05"}], ",", ".05"}], "}"}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Abs", "[", 
                RowBox[{"First", "[", "yr", "]"}], "]"}]}], "]"}]}]}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"xr", "=", 
          RowBox[{"MinMax", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"g", "=", 
          RowBox[{"ListPlot", "[", 
           RowBox[{"allcurves", ",", 
            RowBox[{"Joined", "->", "False"}], ",", 
            RowBox[{"PlotStyle", "->", "styles"}], ",", 
            RowBox[{"PlotMarkers", "->", "markers"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"Axes", "->", "False"}], ",", "\n", "  ", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"qstTex", "[", "\"\<t\>\"", "]"}], ",", 
               RowBox[{"qstTex", "[", "ylabel", "]"}]}], "}"}]}], ",", 
            RowBox[{"FrameTicks", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"qstTicks", "[", "yr", "]"}], ",", "None"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"qstTicks", "[", 
                  RowBox[{"xr", ",", "log"}], "]"}], ",", "None"}], "}"}]}], 
              "}"}]}], ",", "\n", "  ", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"ImageSize", "->", "1100"}], ",", 
            RowBox[{"AspectRatio", "->", ".52"}], ",", 
            RowBox[{"ImagePadding", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"140", ",", "40"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"100", ",", "50"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"FrameStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Black", ",", 
               RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"Placed", "[", 
              RowBox[{
               RowBox[{"PointLegend", "[", 
                RowBox[{"styles", ",", "legend", ",", 
                 RowBox[{"LegendMarkers", "->", "markers"}]}], "]"}], ",", 
               "Below"}], "]"}]}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"bad", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "=!=", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"notes", ",", 
               RowBox[{
                RowBox[{"keys", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], 
                "<>", "\"\< rail marks (actual values retained): \>\"", "<>", 
                RowBox[{"ToString", "[", 
                 RowBox[{
                  RowBox[{"bad", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", "InputForm"}], 
                 "]"}]}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
