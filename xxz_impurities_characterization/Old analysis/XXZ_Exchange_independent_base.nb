limit or reduce the bulk factor rank.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Method\>\"", "->", "\"\<PrunedRealBatches\>\""}], ",", 
           RowBox[{"\"\<EntriesPerChoiFactor\>\"", "->", "entries"}], ",", 
           "\n", " ", 
           RowBox[{"\"\<ActiveColumnCounts\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"#", "[", "\"\<Columns\>\"", "]"}], "]"}], "&"}], " ",
               "/@", " ", 
              RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}]}], ")"}]}]}], 
          "|>"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chSeries", "[", 
       RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", 
        RowBox[{"prepared_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "pr", ",", "raw", ",", "chi", ",", "cd", ",", "fs", ",", "fds", ",", 
          "width"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">", "0"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}]}], 
           ",", "\"\<Channel times must be finite and real.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"pr", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"prepared", "===", "Automatic"}], ",", 
