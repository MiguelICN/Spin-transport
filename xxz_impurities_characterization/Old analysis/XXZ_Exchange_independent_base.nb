Cell[CellGroupData[{

Cell[" 3. Dynamics of the edge dynamical map ", "Title",ExpressionUUID->"b1d014d4-d217-7547-bdb9-e56ed8f42d9d"],

Cell[CellGroupData[{

Cell["\<\
 3.1 Definitions: complete map from a fixed bulk preparation \
\>", "Subsection",ExpressionUUID->"2b8ff5c9-28ae-9b4f-8004-9844d09941ef"],

Cell[CellGroupData[{

Cell[" Channel construction, diagnostics and long-time average ", \
"Subsubsection",ExpressionUUID->"324e3562-b1eb-4d44-8d4f-adbf8eb64a82"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"edgeMapFactor", "[", 
       RowBox[{"f_", ",", "l_"}], "]"}], " ", ":=", " ", 
      RowBox[{"joinStates", "[", 
       RowBox[{
        RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", "f", ",", "l"}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"choiFactor", "[", 
       RowBox[{"a_", ",", "l_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "a", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "/", "4"}]}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"IntegerQ", "[", "r", "]"}], 
           ",", "\"\<The general Choi factor requires 4r columns.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"ArrayReshape", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"ArrayReshape", "[", 
              RowBox[{
               RowBox[{"partitionFactor", "[", 
                RowBox[{"a", ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"4", ",", 
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{"l", "-", "2"}], ")"}]}], ",", "4", ",", "r"}], 
                "}"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"16", ",", 
             RowBox[{
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"l", "-", "2"}], ")"}]}], " ", "r"}]}], "}"}]}], 
          "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"choiToTransfer", "[", "c_", "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"c", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"3", ",", "1", ",", "4", ",", "2"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"transferToChoi", "[", "s_", "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"s", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "4", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"applyTransfer", "[", 
       RowBox[{"s_", ",", "x_"}], "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"s", " ", ".", " ", 
         RowBox[{"Flatten", "[", "x", "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"choiTraceOut", "[", "c_", "]"}], " ", ":=", " ", 
      RowBox[{"TensorContract", "[", 
       RowBox[{
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"c", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"choiPartialTransposeOut", "[", "c_", "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"c", ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
