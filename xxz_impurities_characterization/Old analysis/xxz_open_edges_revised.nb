Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Full", " ", "independent", " ", "ED", " ", "of", " ", "every", " ", 
    "surviving", " ", "symmetry", " ", 
    RowBox[{"sector", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sectorED", "[", 
      RowBox[{"p_Association", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l", "=", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "q", ",", 
         "active", ",", 
         RowBox[{"out", "=", 
          RowBox[{"{", "}"}]}], ",", "ids", ",", "hm", ",", "m", ",", "names",
          ",", "spaces"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"h", "=", 
         RowBox[{"xxzH", "[", "p", "]"}]}], ";", 
        RowBox[{"q", "=", 
         RowBox[{"charges", "[", "p", "]"}]}], ";", "\n", " ", 
        RowBox[{"active", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "q", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"h", " ", ".", " ", 
                RowBox[{"q", "[", "#", "]"}]}], "-", 
               RowBox[{
                RowBox[{"q", "[", "#", "]"}], " ", ".", " ", "h"}]}], "]"}], "<", 
             RowBox[{"tol", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Norm", "[", 
                 RowBox[{"h", ",", "Infinity"}], " ", "]"}]}], "]"}]}]}], 
            "&"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{
             RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
           RowBox[{"ids", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"2", "^", "l"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"IntegerDigits", "[", 
                  RowBox[{
                   RowBox[{"#", "-", "1"}], ",", "2", ",", "l"}], " ", "]"}], 
                 "]"}], "==", "nDown"}], "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"hm", "=", 
            RowBox[{"N", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"h", "[", 
               RowBox[{"[", 
                RowBox[{"ids", ",", "ids"}], " ", "]"}], "]"}], "]"}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"names", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"active", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"\"\<F\>\"", ",", "\"\<RF\>\""}], "}"}], ",", 
                   "#"}], "]"}]}], " ", "||", " ", 
                RowBox[{"m", "==", "0"}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"names", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{"names", ",", 
              RowBox[{
               RowBox[{"Switch", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"\"\<S2\>\"", "|", "\"\<StaggeredS2\>\""}], ",", "0",
                  ",", "\"\<R\>\"", ",", "1", ",", "_", ",", "2"}], "]"}], 
               "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"spaces", "=", 
            RowBox[{"{", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Basis\>\"", "->", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"Length", "[", "ids", " ", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Labels\>\"", "->", 
                RowBox[{"<|", 
                 RowBox[{"\"\<m\>\"", "->", "m"}], "|>"}]}]}], "|>"}], 
             "}"}]}], ";", "\n", "  ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"spaces", "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"splitCharge", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], " ", "]"}], "]"}], "]"}], 
                    "]"}], ",", "name", ",", "tol"}], "]"}], "&"}], " ", "/@",
                  " ", "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"{", 
              RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"out", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"out", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"diagonalizeBlock", "[", 
                 RowBox[{"#", ",", "hm", ",", "ids", ",", "tol"}], "]"}], 
                "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nDown", ",", "0", ",", "l"}], "}"}]}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
           RowBox[{"2", "^", "l"}]}], 
          ",", "\"\<Incomplete sector dimensions.\>\""}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
          RowBox[{"\"\<Hamiltonian\>\"", "->", "h"}], ",", 
          RowBox[{"\"\<ActiveCharges\>\"", "->", "active"}], ",", 
          RowBox[{"\"\<Sectors\>\"", "->", "out"}], ",", "\n", "  ", 
          RowBox[{"\"\<DimensionSum\>\"", "->", 
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}]}]}], 
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Full", " ", "vector", " ", "from", " ", "the", " ", "chosen", " ", 
      "sector", " ", "and", " ", "its", " ", "energy"}], "-", 
     RowBox[{"order", " ", 
      RowBox[{"index", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"eigenket", "[", 
      RowBox[{"ed_", ",", "sector_Integer", ",", "level_Integer"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "[", 
          RowBox[{"[", "sector", " ", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], "->", 
            RowBox[{
             RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}], "[", 
             RowBox[{"[", "level", " ", "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", "^", 
            RowBox[{
             RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"",
              "]"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sectorTable", "[", "ed_", "]"}], " ", ":=", " ", 
     RowBox[{"MapIndexed", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Sector\>\"", "->", 
           RowBox[{"First", "[", "#2", "]"}]}], ",", 
          RowBox[{"\"\<Labels\>\"", "->", 
           RowBox[{"#1", "[", "\"\<Labels\>\"", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<Dimension\>\"", "->", 
           RowBox[{"#1", "[", "\"\<Dimension\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Emin\>\"", "->", 
           RowBox[{"First", "[", 
            RowBox[{"#1", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<Emax\>\"", "->", 
           RowBox[{"Last", "[", 
            RowBox[{"#1", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"\"\<MinPositiveGap\>\"", "->", 
           RowBox[{"#1", "[", "\"\<MinPositiveGap\>\"", "]"}]}], ",", "\n", 
          " ", 
          RowBox[{"\"\<Residual\>\"", "->", 
           RowBox[{"#1", "[", "\"\<Residual\>\"", "]"}]}]}], "|>"}], "&"}], ",", 
       RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
