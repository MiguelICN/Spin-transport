Cell["5.2 Choose the evolution time grid", "Subsection",ExpressionUUID->"20f08cd0-c72d-7d43-9fbf-e8707049b719"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evoTime", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", " ", "->", " ", "\"\<Linear\>\""}], ",", "\n", 
     " ", 
     RowBox[{"\"\<tMax\>\"", " ", "->", " ", "400."}], ",", "\n", " ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", "\n", " ", 
     RowBox[{"\"\<tMinPositive\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<LogPoints\>\"", " ", "->", " ", "501"}]}], "\n", "|>"}]}], 
  ";"}]], "Input",
