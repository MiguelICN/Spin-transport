Cell[CellGroupData[{

Cell["4.3 Identify matching sectors", "Subsection",ExpressionUUID->"5544faec-afad-d24f-a927-00181fb3720c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepKeys", " ", "=", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"First", "[", "sweepData", " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"sweepData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", "#", " ", "]"}], "]"}], "==", 
         RowBox[{"Sort", "[", "sweepKeys", "]"}]}], " ", "&&", "\n", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"#", "[", "\"\<Energies\>\"", "]"}], "]"}], "&"}], " ", "/@",
            " ", 
           RowBox[{"Values", "[", "#", " ", "]"}]}], "]"}], "==", 
         RowBox[{"2", "^", 
          RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}], 
    ",", "\"\<Incomplete sweep.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{"sweepKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "sweepData", ",", "matchingTolerance"}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sectors: \>\"", ",", 
    RowBox[{"Length", "[", "sweepKeys", "]"}], ",", "\"\<; groups: \>\"", ",", 
    RowBox[{"Length", "[", "sweepGroups", " ", "]"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"991cb582-a791-ff47-8366-9b13c56771bf"],

