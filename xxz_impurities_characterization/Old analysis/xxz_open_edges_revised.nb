Cell[CellGroupData[{

Cell["\<\
11.9 Export the four plot families and scalar eigenstate data\
\>", "Subsection",ExpressionUUID->"c70b4183-489d-e643-a9b6-db83c4dd1513"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exDir", "=", 
   RowBox[{"newFolder", "[", 
    RowBox[{"exOutputRoot", ",", 
     RowBox[{"exRunLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"exUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"exUsed", "[", "\"\<J\>\"", "]"}], "]"}], 
      "<>", "\"\<_Delta\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"exUsed", "[", "\"\<Delta\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeSave", "[", 
   RowBox[{
   "exDir", ",", "exUsed", ",", "\"\<Exchange\>\"", ",", "exGUsed", ",", 
    "exGroups", ",", "exResults", ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<spectrum\>\"", ",", "exSpectrumPlots"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<half_entropy\>\"", ",", "exHalfPlots"}], "}"}], ",", "\n",
       "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<edge_bulk_entropy\>\"", ",", "exEdgePlots"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<ipr\>\"", ",", "exIPRPlots"}], "}"}]}], "}"}], ",", 
    "exSettingsUsed"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"bd41a067-92f1-4943-805d-61865c19898d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Saved: \"\>", 
