Cell[CellGroupData[{

Cell["5. Evolution: independent parameters and diagonalization", "Section",ExpressionUUID->"996b0fb5-6ff3-b348-bb3d-de3566a86d73"],

Cell[CellGroupData[{

Cell["5.1 Choose the Hamiltonian for this evolution", "Subsection",ExpressionUUID->"36317f0b-456c-fc49-8af9-d40e47db3d19"],

Cell["\<\
Set all evolution parameters here, including Delta. Running the sweep is \
unnecessary.\
\>", "Text",ExpressionUUID->"d67e12ca-dec0-774d-af7c-cb99357d2968"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoModel", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", " ", "->", " ", "8"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", " ", "->", " ", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<Delta\>\"", " ", "->", " ", "0.5"}], ",", "\n", " ", 
     RowBox[{"\"\<h\>\"", " ", "->", " ", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bLeft\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<bRight\>\"", " ", "->", " ", "0"}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"evoLabel", " ", "=", " ", "\"\<evolution01_fieldLeft_0.01\>\""}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.000594992365324*^9, 4.0005949924584446`*^9}, {
  4.000841373218483*^9, 4.000841373508053*^9}, {4.000843139655016*^9, 
