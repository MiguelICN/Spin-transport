         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Dimension\>\"", "->", 
          RowBox[{"Length", "[", "e", "]"}]}], ",", 
         RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", "\n", "  ", 
