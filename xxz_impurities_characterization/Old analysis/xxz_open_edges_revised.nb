              RowBox[{"#", ",", "setup", ",", "tol"}], "]"}], "&"}], " ", "/@",
             " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"DistributeDefinitions", "[", "edgePoint", "]"}], ";", "\n", 
        " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"ss", "=", "setup"}], ",", 
            RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"edgePoint", "[", 
              RowBox[{"#", ",", "ss", ",", "tt"}], "]"}], "&"}], ",", "grid", 
            ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeSweepCheck", "[", 
      RowBox[{"results_", ",", "grid_", ",", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "keys"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"results", ",", "\"\<g\>\""}], "]"}], "===", "grid"}], 
          ",", "\"\<g-sweep order was not preserved.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"data", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"results", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        RowBox[{"keys", "=", 
         RowBox[{"Keys", "[", 
          RowBox[{"First", "[", "data", "]"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"results", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<DimensionSum\>\"", "]"}], "==", 
               RowBox[{"2", "^", 
                RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], "&"}]}], "]"}], " ",
            "&&", "\n", "  ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"data", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", 
                 RowBox[{"Keys", "[", "#", "]"}], "]"}], "===", 
                RowBox[{"Sort", "[", "keys", "]"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{
                   RowBox[{"Values", "[", "#", "]"}], 
                   ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
                RowBox[{"2", "^", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}]}],
           ",", "\n", 
          "  ", "\"\<The g sweep has incomplete or inconsistent parent \
sectors.\>\""}], "]"}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"SameQ", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "key", "]"}], "[", "\"\<Dimension\>\"", 
                 "]"}], "&"}], " ", "/@", " ", "data"}], ")"}]}], ",", "\n", 
            "   ", "\"\<A parent-sector dimension changed along g.\>\""}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "keys"}], "}"}]}], "]"}], ";", "keys"}]}], 
      "\n", "]"}]}], ";"}]}]}]], "Input",
