Cell["7. Evolution, observables, and exports", "Section",ExpressionUUID->"ba714934-a5de-6a4f-9e29-31e794c7e9c7"],

Cell[CellGroupData[{

Cell["7.1 Generate the time grid", "Subsection",ExpressionUUID->"05d2d328-5d08-944c-a8a2-cbb52d8046c5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoTimeUsed", " ", "=", " ", "evoTime"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"times", " ", "=", " ", 
   RowBox[{"timeGrid", "[", "evoTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Time points: \>\"", ",", 
    RowBox[{"Length", "[", "times", "]"}], ",", "\"\<; last time: \>\"", ",", 
    RowBox[{"Last", "[", "times", " ", "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
