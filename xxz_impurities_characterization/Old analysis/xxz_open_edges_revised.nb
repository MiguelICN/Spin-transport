Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Raw", " ", "eigenpairs", " ", "in", " ", "one", " ", "resolved", " ", 
     "sector"}], ";", " ", 
    RowBox[{"preserve", " ", "arbitrarily", " ", "small", " ", 
     RowBox[{"gaps", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"diagonalizeBlock", "[", 
     RowBox[{"s_", ",", "hm_", ",", "ids_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "h", ",", "e", ",", 
        "v", ",", "order", ",", "rows", ",", "gaps", ",", "res", ",", "orth", 
        ",", "leak", ",", "scale"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"herm", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", "hm", 
          " ", ".", " ", "b"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", "h", " ", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Re", "[", "e", " ", "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Developer`ToPackedArray", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"e", "[", 
           RowBox[{"[", "order", " ", "]"}], "]"}], "]"}], "]"}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"fixSign", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"b", " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "order", " ", "]"}], "]"}], "]"}]}], "]"}]}]}], ";",
        "\n", " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "rows", "]"}]}], ";", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{"hm", ",", "Infinity"}], " ", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"res", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"hm", " ", ".", " ", "#2"}], "-", 
              RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"e", ",", "rows"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"orth", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"rows", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "rows", "]"}]}], "-", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "rows", " ", "]"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"leak", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"hm", " ", ".", " ", "b"}], "-", 
          RowBox[{"b", " ", ".", " ", "h"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"res", "<", 
           RowBox[{"100", " ", "tol", " ", "scale"}]}], " ", "&&", " ", 
          RowBox[{"orth", "<", 
           RowBox[{"100", " ", "tol"}]}], " ", "&&", " ", 
