Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Full", "-", 
     RowBox[{"spectrum", " ", "comparison", " ", "is", " ", "opt"}], "-", 
     "in"}], ";", " ", 
    RowBox[{
    "do", " ", "not", " ", "repeat", " ", "full", " ", "ED", " ", "in", " ", 
     RowBox[{"production", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeCheckedED", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"fullCheck_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ed", ",", "e", ",", "error"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          ",", 
          RowBox[{"zzResolvedED", "[", 
           RowBox[{"g", ",", "setup", ",", "tol"}], "]"}], ",", 
          RowBox[{"edgeED", "[", 
           RowBox[{"g", ",", "setup", ",", "tol"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
             ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}], 
            "[", "\"\<L\>\"", "]"}]}]}], ",", "\n", 
         "  ", "\"\<The resolved ED did not include every eigenstate.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"error", "=", 
        RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", "fullCheck", "]"}], ",", 
         RowBox[{
          RowBox[{"e", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], "]"}], "]"}],
               "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"error", "=", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"e", "-", 
             RowBox[{"Sort", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{
                 RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
                 ",", "\"\<Eigenvalues\>\""}], "]"}], "]"}], "]"}]}], "]"}]}],
           ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"error", "<", 
             RowBox[{"100", " ", "tol", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], 
            ",", "\"\<Resolved and full spectra disagree.\>\""}], "]"}]}]}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"ed", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Audit\>\"", "->", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<DimensionSum\>\"", "->", 
               RowBox[{"ed", "[", "\"\<DimensionSum\>\"", "]"}]}], ",", "\n", 
              "   ", 
              RowBox[{"\"\<MaxResidual\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{
                  RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
                  ",", "\"\<Residual\>\""}], "]"}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"\"\<FullSpectrumError\>\"", "->", "error"}], ",", 
              RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}], ",", "\n",
            "  ", 
           RowBox[{"\"\<EndpointReport\>\"", "->", 
            RowBox[{"edgeEndpointReport", "[", "ed", "]"}]}]}], "|>"}]}], 
        "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",
