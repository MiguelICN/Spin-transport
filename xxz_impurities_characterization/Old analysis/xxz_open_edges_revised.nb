Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Refresh", " ", "plotting", " ", "settings", " ", "without", " ", 
    "changing", " ", "the", " ", "computed", " ", 
    RowBox[{"Hamiltonians", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"exSettingsUsed", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"exSettingsUsed", ",", 
       RowBox[{"KeyTake", "[", 
        RowBox[{"exSettings", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<PlotChop\>\"", ",", "\"\<MarkerSize\>\""}], "}"}]}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exSpectrumPlots", "=", 
     RowBox[{"edgePanels", "[", 
      RowBox[{
      "exData", ",", "exGUsed", ",", "exGroups", ",", "exUsed", 
       ",", "\"\<Exchange\>\"", ",", "\"\<Energies\>\"", ",", "\"\<E_n(g)\>\"",
        ",", "\n", 
       " ", "\"\<\\\\text{Exchange edge coupling: sector spectra}\>\"", ",", 
       RowBox[{"exSettingsUsed", "[", "\"\<PlotChop\>\"", "]"}], ",", 
       RowBox[{"Lookup", "[", 
        RowBox[{"exSettingsUsed", ",", "\"\<MarkerSize\>\"", ",", "3"}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"exSpectrumPlots", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",
 CellLabel->
