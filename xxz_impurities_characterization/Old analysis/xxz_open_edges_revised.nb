Cell[CellGroupData[{

Cell["7.5 Export plots", "Subsection",ExpressionUUID->"c09829ab-7fa5-2447-9a68-8ca629dcb1af"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoDir", " ", "=", " ", 
   RowBox[{"newFolder", "[", 
    RowBox[{"outputRoot", ",", 
     RowBox[{"evoLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"evoUsed", "[", "\"\<J\>\"", "]"}], "]"}], 
      "<>", "\"\<_Delta\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"evoUsed", "[", "\"\<Delta\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"evoDir", ",", 
         RowBox[{"key", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
      RowBox[{"evoPlots", "[", "key", " ", "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"key", ",", 
      RowBox[{"Keys", "[", "evoPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Saved: \>\"", ",", "evoDir"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"770dd267-7efb-3840-9b6c-cff6298d1050"],

