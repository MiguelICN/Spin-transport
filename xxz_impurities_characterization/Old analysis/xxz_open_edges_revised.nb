Cell["Reduced density matrix", "Subsection",ExpressionUUID->"dbda727a-b458-d140-b63f-8439e2a57e17"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Coefficient", " ", "matrix", " ", "for", " ", "a", " ", "chosen", " ", 
     "set", " ", "of", " ", "sites"}], ";", " ", 
    RowBox[{"rho", "=", 
     RowBox[{"A", ".", "A\[Dagger]", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"partitionFactor", "[", 
      RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "rest"}], "}"}], ",", "\n", 
       " ", 
       RowBox[{
        RowBox[{"rest", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "l", "]"}], ",", "sites"}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"ArrayReshape", "[", 
             RowBox[{"fac", ",", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"2", ",", "l"}], "]"}], ",", 
                RowBox[{"{", "r", "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
            RowBox[{"Ordering", "[", 
             RowBox[{"Join", "[", 
              RowBox[{"sites", ",", "rest", ",", 
               RowBox[{"{", 
                RowBox[{"l", "+", "1"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"Length", "[", "sites", "]"}]}], ",", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"Length", "[", "rest", "]"}]}], " ", "r"}]}], "}"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reducedState", "[", 
      RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "=", 
         RowBox[{"partitionFactor", "[", 
          RowBox[{"fac", ",", "sites", ",", "l"}], "]"}]}], "}"}], ",", "\n", 
       " ", 
       RowBox[{"a", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reducedKet", "[", 
      RowBox[{"v_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"reducedState", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", "v", "}"}], "]"}], ",", "sites", ",", "l"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeRho", "[", 
      RowBox[{"v_", ",", "l_Integer"}], "]"}], " ", ":=", " ", 
     RowBox[{"reducedKet", "[", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"bcbd7b17-216a-7445-b64f-2209c064ba3b"],

