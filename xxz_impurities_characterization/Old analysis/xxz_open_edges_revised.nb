               "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              "<>", "\"\<}\\\\rangle\>\""}]}], "}"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
