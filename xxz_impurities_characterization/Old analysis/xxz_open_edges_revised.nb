              RowBox[{"Normal", "[", 
               RowBox[{"KeySort", "[", 
                RowBox[{"#", "[", "\"\<ParentLabels\>\"", "]"}], "]"}], "]"}],
               ",", "InputForm"}], "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"data", "=", 
         RowBox[{"Association", "[", 
          RowBox[{"Table", "[", "\n", "  ", 
           RowBox[{
            RowBox[{
             RowBox[{"labels", "=", 
              RowBox[{"KeySort", "[", 
               RowBox[{
                RowBox[{"First", "[", "group", "]"}], 
                "[", "\"\<ParentLabels\>\"", "]"}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"rows", "=", 
              RowBox[{"SortBy", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<HalfEntropy\>\"", "]"}], ",", "\n",
                     "     ", 
                    RowBox[{"s", "[", "\"\<EdgesEntropy\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<IPR\>\"", "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"s", ",", "group"}], "}"}]}], "]"}], ",", "1"}], 
                 "]"}], ",", "First"}], "]"}]}], ";", "\n", "  ", 
             RowBox[{
              RowBox[{"ToString", "[", 
