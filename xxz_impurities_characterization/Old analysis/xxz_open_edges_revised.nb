Cell[CellGroupData[{

Cell["Output paths", "Subsection",ExpressionUUID->"5597f202-66a0-0046-8237-541918d22e22"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"baseFolder", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "d", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"StringLength", "[", "$InputFileName", "]"}], ">", "0"}]}],
          ",", "\n", "  ", 
         RowBox[{"DirectoryName", "[", 
          RowBox[{"ExpandFileName", "[", "$InputFileName", " ", "]"}], "]"}], 
         ",", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], ",", 
            RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", "d", "]"}], ",", "d", ",", 
        RowBox[{"Directory", "[", "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safeToken", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "s", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
           "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"s", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
           "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}], ",", 
           RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
           RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
           RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Numbered", " ", "reruns", " ", "prevent", " ", "overwriting"}], ";",
     " ", 
    RowBox[{"no", " ", "timestamps", " ", "or", " ", "random", " ", 
     RowBox[{"strings", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"newFolder", "[", 
    RowBox[{"root_", ",", "tag_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"k", "=", "1"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", "tag"}], "}"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"DirectoryQ", "[", "d", "]"}], ",", 
        RowBox[{
         RowBox[{"k", "++"}], ";", 
         RowBox[{"d", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"root", ",", 
             RowBox[{"tag", "<>", "\"\<_run\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}]}], "}"}], "]"}]}]}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"d", ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";",
       "d"}]}], "\n", "]"}]}], ";"}]}], "Input",
 CellLabel->"In[69]:=",ExpressionUUID->"f51d7ae0-c0cd-a145-9458-8c34edd76402"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["3. Common numerical and plot settings", "Section",ExpressionUUID->"10a80e17-0486-3e4c-9a25-0a35750da5f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edTolerance", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"validationTolerance", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"matchingTolerance", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"parallel", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Enabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<Kernels\>\"", "->", "12"}], ",", 
     RowBox[{"\"\<MemoryBudgetGB\>\"", "->", "15."}], ",", 
     RowBox[{"\"\<BatchTimes\>\"", "->", "128"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"plotChop", " ", "=", " ", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exportLogTime", " ", "=", " ", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"outputRoot", " ", "=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_open_edges_results\>\""}], "}"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[72]:=",ExpressionUUID->"dbe5021a-200e-054c-b857-627775b39f98"]
}, Closed]],

Cell[CellGroupData[{

Cell["4. Delta sweep: independent inputs and execution", "Section",ExpressionUUID->"6ca8b133-5a07-914a-ad6f-b6f4a1c1c3d3"],

Cell[CellGroupData[{

Cell["4.1 Choose sweep parameters", "Subsection",ExpressionUUID->"7109be2f-5672-414b-9611-d8bab2dd280c"],

Cell["\<\
These parameters apply only to the sweep. Evolution parameters are entered \
separately in section 5.\
\>", "Text",ExpressionUUID->"bf080fe6-cf8b-2249-b206-c12ab95e73a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepModel", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deltaGrid", " ", "=", " ", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "5"}], ",", "5", ",", "0.05"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sweepLabel", " ", "=", " ", "\"\<sweep01_fieldLeft_0.1\>\""}], 
    ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sweepLabel", " ", "=", " ", "\"\<sweep01\>\""}], ";"}]}], "Input",
 CellChangeTimes->{
  4.0008412696255016`*^9, {4.0008465181887207`*^9, 4.00084651850766*^9}, {
   4.0008466704142303`*^9, 4.0008467352586823`*^9}, {4.000858090655447*^9, 
   4.000858107948763*^9}, {4.0008760125672455`*^9, 4.0008760137508736`*^9}},
 CellLabel->"In[79]:=",ExpressionUUID->"20af5d2c-eeba-5e4e-a57d-e4f05abdcd86"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Diagonalize and calculate eigenstate entropies", "Subsection",ExpressionUUID->"d1356276-f1d5-1b41-9ef2-5d56cdb167eb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepUsed", " ", "=", " ", "sweepModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaUsed", " ", "=", " ", "deltaGrid"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "deltaUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"deltaUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "deltaUsed", " ", "]"}], "]"}], ">", "0"}], 
       "]"}]}]}], ",", "\"\<Delta grid must be strictly increasing.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sweepSeconds", ",", "sweepData"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"sweepParallel", "[", 
     RowBox[{
     "deltaUsed", ",", "sweepUsed", ",", "edTolerance", ",", "parallel"}], 
     " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sweep seconds: \>\"", ",", "sweepSeconds"}], "]"}], 
  ";"}]}], "Input",
 CellLabel->
  "In[112]:=",ExpressionUUID->"d16af57e-8469-364a-b468-8476595e4fdf"],

