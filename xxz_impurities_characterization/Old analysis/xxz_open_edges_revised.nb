     RowBox[{"mapping", "."}]}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"deltaBar", "[", "range_List", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"v", ",", "marks"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"v", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"First", "[", "range", "]"}], ",", 
           RowBox[{"Last", "[", "range", "]"}], ",", "256"}], "]"}], "]"}]}], 
       ";", "\n", " ", 
       RowBox[{"marks", "=", 
        RowBox[{"Sort", "[", 
