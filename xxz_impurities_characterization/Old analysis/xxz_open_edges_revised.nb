               RowBox[{"VectorQ", "[", 
                RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
            "]"}]}], ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"v", "=", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
