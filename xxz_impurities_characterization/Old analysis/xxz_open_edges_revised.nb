Cell["7.4 Build and inspect the plots", "Subsection",ExpressionUUID->"d2abbb97-180c-3546-ad7a-2dfb2da8f028"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoPlots", " ", "=", " ", 
   RowBox[{"densityPanels", "[", 
    RowBox[{"evoData", ",", "evoUsed", ",", "evoTimeUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "exportLogTime", "]"}], ",", 
    RowBox[{"evoPlots", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"evoPlots", ",", 
       RowBox[{"densityPanels", "[", 
        RowBox[{"evoData", ",", "evoUsed", ",", "evoTimeUsed", ",", "True"}], 
        " ", "]"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{"evoPlots", "[", "\"\<03_entropies_mutual_information\>\"", 
