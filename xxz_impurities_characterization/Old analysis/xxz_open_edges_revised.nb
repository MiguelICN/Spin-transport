Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Original", " ", "ED", " ", "is", " ", "reused", " ", "at", " ", "g"}], "=", 
     RowBox[{"0.", " ", "At", " ", "other", " ", "g"}]}], ",", " ", 
    RowBox[{"add", " ", "compatible", " ", "bulk", " ", 
     RowBox[{"charges", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzResolvedED", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "h", ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}], ",", "ids", ",", "other", ",", "hm", ",", "q", 
        ",", "extra", ",", "spaces"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          " ", "&&", " ", 
          RowBox[{"realQ", "[", "g", "]"}]}], 
         ",", "\"\<Expected a ZZ setup and real g.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"g", "==", "0"}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"edgeED", "[", 
