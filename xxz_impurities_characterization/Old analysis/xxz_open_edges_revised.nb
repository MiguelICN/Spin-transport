  RowBox[{
   RowBox[{
    RowBox[{"dynPlotSpecs", "=", 
     RowBox[{"{", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<EntropyA\>\"", ",", "\"\<\\\\text{Entropy of edge A}\>\"",
          ",", "\"\<S(\\\\rho_A)\\\\quad(\\\\mathrm{nats})\>\""}], "}"}], ",",
        "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<EntropyB\>\"", ",", "\"\<\\\\text{Entropy of edge B}\>\"",
          ",", "\"\<S(\\\\rho_B)\\\\quad(\\\\mathrm{nats})\>\""}], "}"}], ",",
        "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<EntropyAB\>\"", 
         ",", "\"\<\\\\text{Entropy of both edges}\>\"", 
         ",", "\"\<S(\\\\rho_{AB})\\\\quad(\\\\mathrm{nats})\>\""}], "}"}], ",",
        "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<MutualInfo\>\"", 
         ",", "\"\<\\\\text{Edge mutual information}\>\"", 
         ",", "\"\<I(A:B)\\\\quad(\\\\mathrm{nats})\>\""}], "}"}], ",", "\n", 
       " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Concurrence\>\"", 
         ",", "\"\<\\\\text{Edge concurrence}\>\"", 
         ",", "\"\<C(\\\\rho_{AB})\>\""}], "}"}], ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Negativity\>\"", ",", "\"\<\\\\text{Edge negativity}\>\"",
          ",", "\"\<\\\\mathcal N(\\\\rho_{AB})\>\""}], "}"}], ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<PurityA\>\"", ",", "\"\<\\\\text{Purity of edge A}\>\"", 
         ",", "\"\<\\\\operatorname{Tr}[\\\\rho_A^2]\>\""}], "}"}], ",", "\n",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<PurityB\>\"", ",", "\"\<\\\\text{Purity of edge B}\>\"", 
         ",", "\"\<\\\\operatorname{Tr}[\\\\rho_B^2]\>\""}], "}"}], ",", "\n",
        " ", 
       RowBox[{"{", 
        RowBox[{"\"\<Purity\>\"", 
         ",", "\"\<\\\\text{Purity of both edges}\>\"", 
         ",", "\"\<\\\\operatorname{Tr}[\\\\rho_{AB}^2]\>\""}], "}"}], ",", 
       "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<FullOverlap\>\"", 
         ",", "\"\<\\\\text{Full-state survival probability}\>\"", 
         ",", "\"\<|\\\\langle\\\\psi(0)|\\\\psi(t)\\\\rangle|^2\>\""}], 
        "}"}], ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<InitialOverlap\>\"", 
         ",", "\"\<\\\\text{Initial reduced-edge overlap}\>\"", ",", "\n", 
         "  ", "\"\<\\\\operatorname{Tr}[\\\\rho_{AB}(0)\\\\rho_{AB}(t)]\>\""}\
], "}"}]}], "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynAxes", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], ";", 
    RowBox[{"dynTexAxes", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<x\>\"", ",", "\"\<y\>\"", ",", "\"\<z\>\""}], "}"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"dynPlotSpecs", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"dynPlotSpecs", ",", "\n", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "  ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Local\>\"", "<>", "edge", "<>", 
              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], ",", 
             
             RowBox[{"\"\<\\\\text{Local expectation: edge \>\"", "<>", 
              "edge", "<>", "\"\<, \>\"", "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<}\>\""}], ",", "\n",
              "   ", 
             RowBox[{"\"\<\\\\langle\\\\sigma_\>\"", "<>", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"edge", "==", "\"\<A\>\""}], ",", "\"\<1\>\"", 
