Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "each", " ", "ZZ", " ", "block"}], ",", " ", 
    RowBox[{
    "reuse", " ", "charges", " ", "for", " ", "its", " ", "ACTUAL", " ", 
     "effective", " ", "boundary", " ", 
     RowBox[{"fields", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBulkCharges", "[", 
     RowBox[{"g_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pb", ",", "q", ",", "names", ",", "alias"}], "}"}], ",", "\n",
       " ", 
      RowBox[{
       RowBox[{"pb", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<L\>\"", "->", 
             RowBox[{
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
            RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", "   ", 
            RowBox[{"\"\<bLeft\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sA\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<bRight\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sB\>\"", "]"}]}]}]}], "|>"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"charges", "[", "pb", "]"}]}], ";", "\n", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "These", " ", "bulk", " ", "parities", " ", "already", " ", "have", " ",
           "the", " ", "full"}], "-", 
         RowBox[{"chain", " ", "parent", " ", 
          RowBox[{"label", "."}]}]}], " ", "*)"}], "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<R\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<RF\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"names", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "q", "]"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "#"}], "]"}], ",", "0", ",", "1"}], "]"}], "&"}]}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"alias", "=", 
            RowBox[{"Switch", "[", 
             RowBox[{
             "name", ",", "\"\<R\>\"", ",", "\"\<RBulk\>\"", ",", "\"\<F\>\"",
               ",", "\"\<FBulk\>\"", ",", "\"\<RF\>\"", ",", "\"\<RFBulk\>\"",
               ",", "\n", "    ", "\"\<S2\>\"", ",", "\"\<BulkS2\>\"", 
              ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredBulkS2\>\""}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"alias", "->", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"id", "[", "2", "]"}], ",", 
              RowBox[{"q", "[", "name", "]"}], ",", 
              RowBox[{"id", "[", "2", "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
