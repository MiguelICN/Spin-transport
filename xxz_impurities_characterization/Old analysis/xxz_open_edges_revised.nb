Cell[CellGroupData[{

Cell[" Spectral overlap; no full - state evolution is repeated . ", \
"Subsection",
 CellChangeTimes->{
  4.0005961638941193`*^9},ExpressionUUID->"fdb879be-61e3-f146-a74f-\
09ad283a082b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fullOverlapBatch", "[", 
    RowBox[{"ts_List", ",", "eng_", ",", "purity0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"Length", "[", "ts", "]"}]}], "]"}]}], ",", 
       RowBox[{"rank", "=", 
        RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}], ",", "amp", ",", 
       "ph"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"amp", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"Length", "[", "ts", "]"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ph", "=", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"Outer", "[", 
                RowBox[{"Times", ",", 
                 RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
                 RowBox[{"N", "[", "ts", "]"}]}], "]"}]}], "]"}]}], ";", "\n",
             "   ", 
            RowBox[{"amp", "+=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Conjugate", "[", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "i"}], "]"}], "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "j"}], "]"}], "]"}]}], ")"}], " ", ".", 
              " ", "ph"}]}]}], ",", "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], ";",
          "\n", "  ", 
         RowBox[{"out", "+=", 
          RowBox[{
           RowBox[{"Abs", "[", "amp", "]"}], "^", "2"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "rank"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "rank"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{
        RowBox[{"Re", "[", "out", "]"}], "/", "purity0"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[513]:=",ExpressionUUID->"d2872683-b6a8-8648-bab3-94ac008b6579"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Add local Pauli expectations, pair correlations and full overlap . \
\>", "Subsection",
 CellChangeTimes->{
  4.0005961921392994`*^9},ExpressionUUID->"a76dd808-abf8-f74d-a1ec-\
d3879ff54d59"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"extraRecords", "[", 
    RowBox[{"records_List", ",", "eng_", ",", "purity0_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"overlap", ",", 
       RowBox[{"pauli", "=", 
        RowBox[{"PauliMatrix", " ", "/@", " ", 
         RowBox[{"Range", "[", "3", "]"}]}]}], ",", 
       RowBox[{"axes", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}],
       "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"overlap", "=", 
       RowBox[{"fullOverlapBatch", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], ",", "eng", ",", 
         "purity0"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rec", ",", "ov"}], "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ra", "=", 
               RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
              RowBox[{"rb", "=", 
               RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}], ",", "\n", "   ", 
              RowBox[{"r", "=", 
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", "a", ",", 
              "b", ",", "c", ",", "extra"}], "}"}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"#", " ", ".", " ", "ra"}], "]"}], "]"}], "&"}], 
               " ", "/@", " ", "pauli"}]}], ";", 
             RowBox[{"b", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"#", " ", ".", " ", "rb"}], "]"}], "]"}], "&"}], 
               " ", "/@", " ", "pauli"}]}], ";", "\n", "  ", 
             RowBox[{"c", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{
                   RowBox[{"KroneckerProduct", "[", 
                    RowBox[{
                    RowBox[{"pauli", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"pauli", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", ".", " ", 
                   "r"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "3"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"extra", "=", 
              RowBox[{"Association", "[", 
               RowBox[{"Join", "[", "\n", "   ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\"\<PurityA\>\"", "->", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"ra", " ", ".", " ", "ra"}], "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<PurityB\>\"", "->", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"rb", " ", ".", " ", "rb"}], "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<FullOverlap\>\"", "->", "ov"}]}], "}"}], ",", 
                 "\n", "   ", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<LocalA\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                    RowBox[{"a", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "   ", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<LocalB\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "   ", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", "\n", "    ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<Correlation\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", "\n", 
                    "    ", 
                    RowBox[{
                    RowBox[{"\"\<Connected\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"a", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], "}"}], ",",
                     "\n", "    ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "2"}], 
                  "]"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"KeyDrop", "[", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"rec", ",", "extra"}], "]"}], ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<RhoAB\>\"", ",", "\"\<RhoA\>\"", 
                 ",", "\"\<RhoB\>\"", ",", "\"\<EigenvaluesAB\>\""}], "}"}]}],
               "]"}]}]}], "\n", " ", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"records", ",", "overlap"}], "}"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[514]:=",ExpressionUUID->"db09ad5f-0038-0341-bcf2-d79483562a6a"]
}, Closed]],

