        "\n", " ", 
       RowBox[{"h", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<Bulk\>\"", 
           "]"}], "+", 
          RowBox[{"g", " ", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<ZZ\>\"", 
            "]"}]}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{"parent", "[", "\"\<Indices\>\"", "]"}]}], ";", 
          RowBox[{"other", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "ids"}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"hm", "=", 
           RowBox[{"N", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{"h", "[", 
              RowBox[{"[", 
               RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Basis\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Basis\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], 
            "}"}]}], ";", "\n", "  ", 
          RowBox[{"q", "=", 
           RowBox[{"zzBulkCharges", "[", 
            RowBox[{"g", ",", "p", ",", 
             RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"q", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"q", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"q", "[", "#", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "<", 
               RowBox[{"tol", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
