Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Full", " ", 
     RowBox[{"mode", ":", " ", 
      RowBox[{
      "enter", " ", "one", " ", "fixed", " ", "vector", " ", "or", " ", 
       "density", " ", "matrix", " ", "in", " ", "site", " ", "order", " ", 
       "1"}]}]}], ",", "...", ",", 
    RowBox[{"L", "."}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dynFullState", "=", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Example", ":", " ", "dynFullState"}], "=", 
      RowBox[{"eigenket", "[", 
       RowBox[{"evoED", ",", "sector", ",", "level"}], "]"}]}], ";", " ", 
     RowBox[{"evaluate", " ", "once", " ", "before", " ", "the", " ", 
      RowBox[{"sweep", "."}]}]}], " ", "*)"}]}]}]], "Input",
 CellChangeTimes->{{4.000596347881584*^9, 4.000596353463911*^9}},
 CellLabel->
  "In[534]:=",ExpressionUUID->"7d5939dc-4ece-3f4b-8d64-237a711e4044"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.5 Prepare the fixed state and times", "Subsection",ExpressionUUID->"940666c7-87ee-1644-8d69-2861095ed534"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegerQ", "[", 
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ">=", "3"}]}], 
    ",", "\"\<L must be an integer >=3.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"dynModel", ",", "\"\<Delta\>\""}], "]"}]}], 
    ",", "\"\<Put Delta values only in dynDelta.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ListQ", "[", "dynDelta", "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "dynDelta", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"dynDelta", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{"N", "[", "dynDelta", "]"}], ",", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"#1", "==", "#2"}], "]"}], "&"}]}], "]"}], "]"}], "==", 
      RowBox[{"Length", "[", "dynDelta", "]"}]}]}], ",", "\n", 
    " ", "\"\<Use at least two distinct real Delta values.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "dynStateMode"}], "]"}], ",", "\"\<Invalid dynStateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynModelUsed", "=", "dynModel"}], ";", 
  RowBox[{"dynDeltaUsed", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"N", "[", "dynDelta", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimeUsed", "=", "dynTime"}], ";", 
  RowBox[{"dynParallelUsed", "=", "dynParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynEDToleranceUsed", "=", "dynEDTolerance"}], ";", 
  RowBox[{"dynValidationToleranceUsed", "=", "dynValidationTolerance"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimes", "=", 
   RowBox[{"timeGrid", "[", "dynTimeUsed", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000596363921404*^9, 4.000596366068432*^9}},
 CellLabel->
  "In[535]:=",ExpressionUUID->"d75682a2-4c8d-e24b-9ed0-940fd9738aeb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"dynStateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"dynEdgeFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynEdgeState", ",", "4", ",", "dynValidationToleranceUsed"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"dynMiddleFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynMiddleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], 
          ")"}]}], ",", "dynValidationToleranceUsed"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"dynFactor", "=", 
      RowBox[{"joinStates", "[", 
       RowBox[{"dynEdgeFactor", ",", "dynMiddleFactor", ",", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", 
    "\n", " ", 
    RowBox[{"dynFactor", "=", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"dynFullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "dynValidationToleranceUsed"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynRhoEdge0", "=", 
   RowBox[{"reducedState", "[", 
    RowBox[{"dynFactor", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynGram", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "dynFactor", "]"}], " ", ".", " ", 
    "dynFactor"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPurity0", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{"dynGram", " ", ".", " ", "dynGram"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPureInput", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"dynPurity0", "-", "1."}], "]"}], "<=", 
    "dynValidationToleranceUsed"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynSpecsUsed", "=", "dynPlotSpecs"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", "dynPureInput"}], ",", "\n", " ", 
    RowBox[{"dynSpecsUsed", "=", 
     RowBox[{"Replace", "[", 
      RowBox[{"dynSpecsUsed", ",", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", ",", "_", ",", "_"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", 
          ",", "\"\<\\\\text{Normalized full-state overlap}\>\"", ",", "\n", 
          "   ", "\"\<\\\\operatorname{Tr}[\\\\rho(0)\\\\rho(t)]/\\\\\
operatorname{Tr}[\\\\rho(0)^2]\>\""}], "}"}]}], ",", "1"}], "]"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Fixed initial purity: \>\"", ",", "dynPurity0", 
    ",", "\"\<; Delta points: \>\"", ",", 
    RowBox[{"Length", "[", "dynDeltaUsed", "]"}], ",", "\n", 
    " ", "\"\<; time points: \>\"", ",", 
    RowBox[{"Length", "[", "dynTimes", "]"}]}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[543]:=",ExpressionUUID->"74f67f6d-e02d-aa4f-bf52-4781600393cd"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Fixed initial purity: \"\>", "\[InvisibleSpace]", "1.`", 
   "\[InvisibleSpace]", "\<\"; Delta points: \"\>", "\[InvisibleSpace]", "11",
    "\[InvisibleSpace]", "\<\"; time points: \"\>", "\[InvisibleSpace]", 
