              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], 
              "<>", "\"\<}\\\\rangle\>\""}]}], "}"}], ",", "\n", "  ", 
           RowBox[{"{", 
