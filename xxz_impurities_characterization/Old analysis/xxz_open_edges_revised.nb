Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Explicit", " ", "ticks", " ", "include", " ", "zero"}], ";", " ", 
    RowBox[{
    "curves", " ", "and", " ", "colorbar", " ", "share", " ", "the", " ", 
