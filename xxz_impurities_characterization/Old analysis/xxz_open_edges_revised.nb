            RowBox[{"{", 
             RowBox[{"part", ",", "parts"}], "}"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"labelError", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{"labelError", ",", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], ",", 
                  "\n", "     ", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], " ", ".", " ", 
                    "b"}], "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "[", "name", 
                    "]"}], " ", "b"}]}], "]"}]}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"{", 
                RowBox[{"name", ",", 
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"Keys", "[", "q", "]"}], ",", 
                   RowBox[{"Keys", "[", 
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                  "]"}]}], "}"}]}], "]"}]}], ",", 
