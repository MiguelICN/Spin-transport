Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Preserve", " ", "every", " ", "parent", " ", "label"}], ",", " ", 
    RowBox[{
     RowBox[{
     "scalar", " ", "observable", " ", "and", " ", "g", " ", "sample", " ", 
      "from", " ", "chapters", " ", "10"}], "-", "11."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeCheckedPoint", "[", 
     RowBox[{"g_", ",", "setup_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ed", ",", "l", ",", "blocks", ",", "groups", ",", "data", ",", 
        "labels", ",", "rows"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"addEntropies", "[", 
         RowBox[{"edgeCheckedED", "[", 
          RowBox[{"g", ",", "setup", ",", "tol"}], "]"}], "]"}]}], ";", 
       RowBox[{"l", "=", 
        RowBox[{
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"blocks", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"s", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"s", ",", 
              RowBox[{"<|", 
               RowBox[{"\"\<IPR\>\"", "->", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                  " ", "/@", " ", 
                  RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
               "|>"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"blocks", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"2.", "^", 
                RowBox[{"(", 
                 RowBox[{"-", "l"}], ")"}]}], "-", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
              RowBox[{"1", "+", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
              RowBox[{
               RowBox[{
                RowBox[{"Floor", "[", 
                 RowBox[{"l", "/", "2"}], "]"}], " ", 
                RowBox[{"Log", "[", "2", "]"}]}], "+", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
              RowBox[{
               RowBox[{"Log", "[", "4", "]"}], "+", 
               RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], ",", "\n", 
         "  ", "\"\<Eigenstate entropy or IPR bounds failed.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], ",", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"blocks", ",", "\"\<EdgesEntropy\>\""}], "]"}], "]"}], "<", 
            RowBox[{"100", " ", "tol"}]}], ",", "\n", 
           "  ", "\"\<A ZZ eigenvector lost its fixed-edge product structure.\
\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{"blocks", ",", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"Normal", "[", 
              RowBox[{"KeySort", "[", 
               RowBox[{"#", "[", "\"\<ParentLabels\>\"", "]"}], "]"}], "]"}], 
             ",", "InputForm"}], "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"data", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"labels", "=", 
             RowBox[{"KeySort", "[", 
              RowBox[{
               RowBox[{"First", "[", "group", "]"}], 
               "[", "\"\<ParentLabels\>\"", "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"rows", "=", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<HalfEntropy\>\"", "]"}], ",", "\n",
                     "    ", 
                    RowBox[{"s", "[", "\"\<EdgesEntropy\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<IPR\>\"", "]"}]}], "}"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"s", ",", "group"}], "}"}]}], "]"}], ",", "1"}], 
                "]"}], ",", "First"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{
               RowBox[{"Normal", "[", "labels", "]"}], ",", "InputForm"}], 
              "]"}], "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Labels\>\"", "->", "labels"}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"Length", "[", "rows", "]"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<Energies\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<HalfEntropy\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<EdgesEntropy\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<IPR\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "4"}], "]"}], "]"}]}]}], "|>"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<g\>\"", "->", "g"}], ",", 
         RowBox[{"\"\<Data\>\"", "->", "data"}], ",", 
         RowBox[{"\"\<SectorTable\>\"", "->", 
          RowBox[{"sectorTable", "[", "ed", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<DimensionSum\>\"", "->", 
          RowBox[{"ed", "[", "\"\<DimensionSum\>\"", "]"}]}], ",", 
         RowBox[{"\"\<EndpointRefinement\>\"", "->", 
          RowBox[{"ed", "[", "\"\<EndpointRefinement\>\"", "]"}]}], ",", "\n",
          "  ", 
         RowBox[{"\"\<Audit\>\"", "->", 
          RowBox[{"ed", "[", "\"\<Audit\>\"", "]"}]}], ",", 
         RowBox[{"\"\<EndpointReport\>\"", "->", 
          RowBox[{"ed", "[", "\"\<EndpointReport\>\"", "]"}]}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}]}]], "Input",
