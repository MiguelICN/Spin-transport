Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Independently", " ", "verify", " ", "all", " ", "four", " ", "operator", " ",
     "blocks", " ", "against", " ", "their", " ", "effective", " ", 
    RowBox[{"fields", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBlockCheck", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "n", ",", "bits", ",", "h", ",", "x", ",", "y", ",", "z", ",", "bulk",
         ",", "ids", ",", "target", ",", "rows", ",", "err"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          " ", "&&", " ", 
          RowBox[{"realQ", "[", "g", "]"}]}], 
         ",", "\"\<Expected a ZZ setup and real g.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"l", "-", "2"}]}], ";", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"h", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<Bulk\>\"", 
          "]"}], "+", 
         RowBox[{"g", " ", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<ZZ\>\"", 
           "]"}]}]}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"bulk", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", "\n", 
             "   ", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
              RowBox[{"bondOp", "[", 
               RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ids", "=", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"2", "^", "l"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "a"}], " ", "&&",
                   " ", 
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "b"}]}], 
                 "&"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"target", "=", 
              RowBox[{"bulk", "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "a"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "1", ",", "n"}], "]"}]}], "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "b"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "n", ",", "n"}], "]"}]}]}]}], ";", "\n", 
             "   ", 
             RowBox[{"err", "=", 
              RowBox[{"maxAbs", "[", 
               RowBox[{
                RowBox[{"h", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "-", "target"}], 
               "]"}]}], ";", "\n", "   ", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{"err", "<", 
                RowBox[{"100", " ", "tol", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"1.", ",", 
                   RowBox[{"Norm", "[", 
                    RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], 
               ",", "\"\<Fixed-edge ZZ block reduction failed.\>\""}], "]"}], 
             ";", "\n", "   ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<sA\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "a"}]}], ",", 
               RowBox[{"\"\<sB\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "b"}]}], ",", 
               RowBox[{"\"\<EffectiveLeftField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "a"}], ")"}]}]}], ",", "\n", 
               "    ", 
               RowBox[{"\"\<EffectiveRightField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "b"}], ")"}]}]}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"Length", "[", "ids", "]"}]}], ",", 
               RowBox[{"\"\<OperatorError\>\"", "->", "err"}]}], "|>"}]}], ",",
             "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"b", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\n", " ", "rows"}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[114]:=",ExpressionUUID->"061be9f3-b0ff-a24d-a791-0ad45fe21651"]
}, Closed]],

