Cell[CellGroupData[{

Cell["Entanglement computations", "Subsection",ExpressionUUID->"732853cd-fdd1-df46-bf3d-48e0a58384fa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Von", " ", "Neumann", " ", "entropy"}], ",", " ", 
    RowBox[{"natural", " ", 
     RowBox[{"logarithms", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"entropy", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"N", "[", 
              RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], "}"}], ",", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"e", "===", 
          RowBox[{"{", "}"}]}], ",", "0.", ",", 
         RowBox[{"-", 
          RowBox[{"Total", "[", 
           RowBox[{"e", " ", 
            RowBox[{"Log", "[", "e", " ", "]"}]}], "]"}]}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Pure", "-", 
      RowBox[{"state", " ", "entropy", " ", "for", " ", "sites", " ", "1"}]}],
      ",", "...", ",", 
     RowBox[{"floor", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"L", "/", "2"}], ")"}], "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"halfEntropy", "[", 
      RowBox[{"v_", ",", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "p", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"SingularValueList", "[", 
             RowBox[{"ArrayReshape", "[", 
              RowBox[{"v", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"2", "^", 
                  RowBox[{"Floor", "[", 
                   RowBox[{"l", "/", "2"}], "]"}]}], ",", 
                 RowBox[{"2", "^", 
                  RowBox[{"Ceiling", "[", 
                   RowBox[{"l", "/", "2"}], "]"}]}]}], "}"}]}], "]"}], "]"}], 
            "^", "2"}], ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"p", "===", 
           RowBox[{"{", "}"}]}], ",", "0.", ",", 
          RowBox[{"-", 
           RowBox[{"Total", "[", 
            RowBox[{"p", " ", 
             RowBox[{"Log", "[", "p", " ", "]"}]}], "]"}]}]}], "]"}]}]}], 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Pure", "-", 
     RowBox[{
     "state", " ", "entanglement", " ", "of", " ", "both", " ", "edges", " ", 
      "together", " ", "versus", " ", "the", " ", 
      RowBox[{"middle", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
