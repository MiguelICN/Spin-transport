                   RowBox[{
                    RowBox[{"q", "[", "#", "]"}], ",", "Infinity"}], "]"}]}], 
                 "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"extra", "=", 
           RowBox[{"Association", "[", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "->", 
                RowBox[{"N", "[", 
                 RowBox[{"Normal", "[", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}],
                "&"}], ",", "q"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"extra", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"extra", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"hm", " ", ".", " ", 
                  RowBox[{"extra", "[", "#", "]"}]}], "-", 
                 RowBox[{
                  RowBox[{"extra", "[", "#", "]"}], " ", ".", " ", "hm"}]}], 
                "]"}], "<", "\n", "    ", 
               RowBox[{"tol", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Norm", "[", 
                   RowBox[{"hm", ",", "Infinity"}], "]"}]}], "]"}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{"extra", "[", "#", "]"}], ",", "Infinity"}], 
                   "]"}]}], "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"edgeRefine", "[", 
            RowBox[{"spaces", ",", "extra", ",", "tol"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"out", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"diagonalizeBlock", "[", 
                  RowBox[{"#", ",", "hm", ",", "ids", ",", "tol"}], "]"}], ",",
                  "\n", "    ", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<ParentLabels\>\"", "->", 
                   RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}], "|>"}]}],
                 "]"}], "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"parent", ",", 
           RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}]}], "}"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], 
         ",", "\"\<Incomplete refined ZZ ED.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Parameters\>\"", "->", 
          RowBox[{"Join", "[", 
           RowBox[{"p", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<g\>\"", "->", "g"}], ",", 
              RowBox[{"\"\<EdgeType\>\"", "->", "\"\<ZZ\>\""}]}], "|>"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<Hamiltonian\>\"", "->", "h"}], ",", "\n", "  ", 
         RowBox[{"\"\<Sectors\>\"", "->", "out"}], ",", 
         RowBox[{"\"\<DimensionSum\>\"", "->", 
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<EndpointRefinement\>\"", "->", 
          RowBox[{"{", "}"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",
