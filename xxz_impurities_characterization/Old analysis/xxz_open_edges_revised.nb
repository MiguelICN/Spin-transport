             RowBox[{"100", " ", "tol"}]}], ",", "\n", 
            "  ", "\"\<A ZZ eigenvector lost its fixed-edge product \
structure.\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"groups", "=", 
         RowBox[{"GatherBy", "[", 
          RowBox[{"blocks", ",", 
