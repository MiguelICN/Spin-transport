             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
          "\n", "  ", 
          RowBox[{"\"\<TraceError\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
          RowBox[{"\"\<HermiticityError\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"r", "-", 
              RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
             ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<MinEigenvalue\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"timeChunk", "[", 
      RowBox[{"times_", ",", "engine_", ",", "rho0_", ",", "tol_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "records"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"evolveBatch", "[", 
          RowBox[{"times", ",", "engine"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"observables", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", " ", "]"}], "]"}], ",", 
             RowBox[{"partitionFactor", "[", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "All", ",", "k"}], " ", "]"}], "]"}], ",",
                "\n", "  ", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
               RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
             "rho0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
             "tol"}], " ", "&&", "\n", "  ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
             "]"}], "<", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}],
             ">=", 
            RowBox[{"-", "tol"}]}]}], ",", "\n", 
          "  ", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", 
        "records"}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"ad505886-a7b4-0a48-8a8e-e6566e366e44"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Linear", " ", "or", " ", "logarithmic", " ", "sampling"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"including", " ", "t"}], "=", "0."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"{", "0.", "}"}], ",", 
            RowBox[{"Exp", "[", 
             RowBox[{"Subdivide", "[", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"N", "[", 
                 RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                "]"}], ",", 
               RowBox[{"Log", "[", 
                RowBox[{"N", "[", 
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}], 
              "]"}], "]"}]}], "]"}]}], ",", "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"0d5fa8fd-abfc-3347-ad1a-0e35da7412e7"]
}, Closed]],

Cell[CellGroupData[{

Cell["Time splitting and parallelization", "Subsection",ExpressionUUID->"ffd11fb8-28e2-5e45-b80f-d97eb3d2de8d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Reuse", " ", "existing", " ", "kernels"}], ";", " ", 
    RowBox[{"no", " ", "kernels", " ", "are", " ", 
     RowBox[{"closed", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"startKernels", "[", "cfg_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", 
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"LaunchKernels", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "-", "n"}], " ", 
            "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Available parallel kernels: \>\"", ",", "n"}], "]"}], ";",
         "n"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Independent", " ", "Delta", " ", "points"}], ";", " ", 
     RowBox[{
     "full", " ", "eigenvectors", " ", "are", " ", "computed", " ", "at", " ",
       "each", " ", 
      RowBox[{"point", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sweepParallel", "[", 
      RowBox[{"grid_", ",", "p_", ",", "tol_", ",", "cfg_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "p", ",", "tol"}], "]"}], "&"}], " ", "/@", 
            " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"DistributeDefinitions", "[", "sweepPoint", "]"}], ";", "\n", 
        " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pp", "=", "p"}], ",", 
            RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "pp", ",", "tt"}], "]"}], "&"}], ",", "grid", 
            ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[47]:=",ExpressionUUID->"538377af-a921-e04a-90af-dd648234165e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Batches", " ", "limit", " ", "memory"}], ";", " ", 
    RowBox[{"each", " ", "worker", " ", "gets", " ", "one", " ", "engine", " ", 
     RowBox[{"copy", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"evolveChunks", "[", 
     RowBox[{
     "times_", ",", "engine_", ",", "rho0_", ",", "tol_", ",", "cfg_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "batch", ",", "room", ",", "chunks", ",", "packets", ",", 
        "records", ",", "reference", ",", "error"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
       RowBox[{"room", "=", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<MemoryBudgetGB\>\"", "]"}], " ", 
         RowBox[{"1024.", "^", "3"}]}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"4.", " ", "n", " ", 
            RowBox[{"ByteCount", "[", "engine", "]"}]}], ">", "room"}]}], ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<Engine copies exceed the memory budget; using serial \
batches.\>\"", "]"}], ";", 
          RowBox[{"n", "=", "0"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"batch", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"room", "/", "\n", "  ", 
              RowBox[{"(", 
               RowBox[{"4.", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1", ",", "n"}], "]"}], " ", "16", " ", 
                RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], " ", 
                RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], ")"}]}], 
             "]"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"chunks", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"times", ",", 
          RowBox[{"UpTo", "[", "batch", " ", "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Time batches: \>\"", ",", 
         RowBox[{"Length", "[", "chunks", "]"}], 
         ",", "\"\<; maximum points per batch: \>\"", ",", "batch"}], "]"}], ";",
        "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", ">=", "2"}], ",", "\n", "  ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Clear", " ", "both", " ", "worker", " ", "values", " ", "and", " ",
            "their", " ", "recorded", " ", "definitions", " ", "before", " ", 
           RowBox[{"reuse", "."}]}], " ", "*)"}], "\n", "  ", 
         RowBox[{
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"sharedEngine", "=", "engine"}], ";", 
          RowBox[{"sharedRho0", "=", "rho0"}], ";", 
          RowBox[{"sharedTolerance", "=", "tol"}], ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "timeChunk", ",", "sharedEngine", ",", "sharedRho0", ",", 
            "sharedTolerance"}], "]"}], ";", "\n", "  ", 
          RowBox[{"packets", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"timeChunk", "[", 
               RowBox[{
               "#", ",", "sharedEngine", ",", "sharedRho0", ",", 
                "sharedTolerance"}], "]"}], "&"}], ",", "\n", "   ", "chunks",
              ",", 
             RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"packets", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"timeChunk", "[", 
             RowBox[{"#", ",", "engine", ",", "rho0", ",", "tol"}], "]"}], 
            "&"}], " ", "/@", " ", "chunks"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"packets", ",", "ListQ"}], "]"}], 
         ",", "\"\<A time batch failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"records", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"packets", ",", "1"}], "]"}]}], ";", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], "===", "times"}], 
         ",", "\"\<Time ordering failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"reference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"observables", "[", 
           RowBox[{"t", ",", 
            RowBox[{"partitionFactor", "[", 
             RowBox[{
              RowBox[{"evolve", "[", 
               RowBox[{"t", ",", "engine"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
            "rho0"}], "]"}], ",", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "times", "]"}], ",", 
              RowBox[{"Last", "[", "times", "]"}]}], "}"}]}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"error", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "[", "\"\<RhoAB\>\"", "]"}], "-", 
               RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "&"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "[", "records", "]"}], ",", 
               RowBox[{"Last", "[", "records", "]"}]}], "}"}], ",", 
             "reference"}], "}"}]}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"error", "<", "tol"}], 
         ",", "\"\<Batched/single-time endpoint comparison failed.\>\""}], 
        "]"}], ";", "records"}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"20c60010-8250-c149-ba24-09a8a88b1d6d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["2. Plotting, MaTeX labels, and file output", "Section",ExpressionUUID->"92cf1bb6-4697-c94e-9699-1c85dc6c609d"],

Cell[CellGroupData[{

Cell["Labels and ticks", "Subsection",ExpressionUUID->"af518f9a-2806-8146-863b-7e24884322d8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "tex", ",", "texNumber", ",", "ticks", ",", "logTicks", ",", "sectorLabel",
     ",", "dimLabel", ",", "caption", ",", "curveStyles", ",", "pointMarkers",
     ",", "\n", " ", "framePlot", ",", "plotPanel", ",", "sweepPanels", ",", 
    "fixedPanels", ",", "series", ",", "matrixSeries", ",", "densityPanels", ",",
     "\n", " ", "safeToken", ",", "newFolder", ",", "baseFolder", ",", 
    "savePNG"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"texReady", "=", "Automatic"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"MaTeX", " ", "labels"}], ";", " ", 
    RowBox[{
    "a", " ", "visible", " ", "native", " ", "fallback", " ", "is", " ", 
     "used", " ", "if", " ", "MaTeX", " ", "is", " ", 
     RowBox[{"unavailable", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tex", "[", 
    RowBox[{"s_String", ",", 
     RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "g", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"texReady", "===", "Automatic"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"texReady", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], ",",
              "False"}], " ", "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", "texReady", "]"}]}], ",", 
           RowBox[{
           "Print", 
            "[", "\"\<MaTeX unavailable: check the local installation.\>\"", 
            "]"}]}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", "texReady", "]"}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"s", ",", 
               RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", "$Failed"}], 
            " ", "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
           RowBox[{"Return", "[", "g", " ", "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"texReady", "=", "False"}], ";", 
         RowBox[{
         "Print", "[", "\"\<MaTeX failed: check TeX/Ghostscript.\>\"", 
          "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"s", ",", "Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "size"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"3cbe99b2-f2c9-1e4d-9c4c-f2375b28f229"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Numeric", " ", "labels", " ", "use", " ", "decimals", " ", "rather", " ", 
    "than", " ", 
    RowBox[{"fractions", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"texNumber", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "p"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
