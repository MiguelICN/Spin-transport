Cell[CellGroupData[{

Cell["4.7 Export sweep plots and data", "Subsection",ExpressionUUID->"6d06e6fd-2da0-d34a-b967-4cdca13eac12"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepDir", " ", "=", " ", 
   RowBox[{"newFolder", "[", 
    RowBox[{"outputRoot", ",", 
     RowBox[{"sweepLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"sweepUsed", "[", "\"\<J\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<spectrum_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
