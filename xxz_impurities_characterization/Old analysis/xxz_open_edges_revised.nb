        "}"}], "]"}], ",", 
      RowBox[{"halfPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "halfPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
