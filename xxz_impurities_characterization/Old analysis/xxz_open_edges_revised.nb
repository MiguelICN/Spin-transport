Cell[CellGroupData[{

Cell["7.3 Numerical checks", "Subsection",ExpressionUUID->"ab96f545-1863-8348-bf91-e35071030e95"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoChecks", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<InitialFactorError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"evolve", "[", 
          RowBox[{"0.", ",", "engine"}], "]"}], "-", "fullFactor"}], 
        ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<InitialEdgeError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "evoData", "]"}], "[", "\"\<RhoAB\>\"", "]"}],
          "-", "rhoEdge0"}], ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", 
     " ", 
     RowBox[{"\"\<MaxTraceError\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}], ",", 
     "\n", " ", 
     RowBox[{"\"\<MaxHermiticityError\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<HermiticityError\>\""}], "]"}], "]"}]}], 
     ",", "\n", " ", 
     RowBox[{"\"\<MinEigenvalue\>\"", " ", "->", " ", 
      RowBox[{"Min", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}]}]}], 
    "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Values", "[", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"evoChecks", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], 
       "]"}], "<", "validationTolerance"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"evoChecks", "[", "\"\<MinEigenvalue\>\"", "]"}], ">=", 
      RowBox[{"-", "validationTolerance"}]}]}], 
    ",", "\"\<Evolution validation failed.\>\""}], "]"}], 
  ";"}], "\n", "evoChecks"}], "Input",
 CellLabel->
  "In[173]:=",ExpressionUUID->"8bb3eb41-3333-514a-8c71-db1a2afc994c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"InitialFactorError\"\>", "\[Rule]", 
    "6.121976536852752`*^-16"}], ",", 
   RowBox[{"\<\"InitialEdgeError\"\>", "\[Rule]", "5.467214348906571`*^-16"}],
    ",", 
   RowBox[{"\<\"MaxTraceError\"\>", "\[Rule]", "8.881784197001252`*^-16"}], ",", 
   RowBox[{"\<\"MaxHermiticityError\"\>", "\[Rule]", "0.`"}], ",", 
   RowBox[{"\<\"MinEigenvalue\"\>", "\[Rule]", 
    RowBox[{"-", "2.7755575615628914`*^-16"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellChangeTimes->{4.0005934994489098`*^9, 4.000595021575905*^9, 
  4.0005992878840847`*^9, 4.0008378264825935`*^9, 4.0008396232982616`*^9, 
  4.000840011230875*^9, 4.0008401970121307`*^9, 4.0008409043075123`*^9, 
  4.0008416667200584`*^9, 4.0008428718825397`*^9, 4.0008429803396873`*^9, 
  4.0008432316637783`*^9, 4.000846843626007*^9},
 CellLabel->
  "Out[175]=",ExpressionUUID->"84d4e7e3-328b-da44-befe-eebcb50ba097"]
}, Open  ]]
}, Open  ]],

