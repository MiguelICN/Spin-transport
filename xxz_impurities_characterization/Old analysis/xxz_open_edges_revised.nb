Cell[CellGroupData[{

Cell["6.5 Assemble and inspect the initial state", "Subsection",ExpressionUUID->"d06029d7-a1e5-f14e-a324-d49ed540419b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "stateMode"}], "]"}], ",", "\"\<Invalid stateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"stateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"edgeFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"edgeState", ",", "4", ",", "validationTolerance"}], "]"}]}], ";",
      "\n", " ", 
     RowBox[{"middleFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"middleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}], ",",
         "validationTolerance"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"fullFactor", " ", "=", " ", 
      RowBox[{"joinStates", "[", 
       RowBox[{"edgeFactor", ",", "middleFactor", ",", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", "\n", 
    " ", 
    RowBox[{"fullFactor", " ", "=", " ", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"fullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "validationTolerance"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rhoEdge0", " ", "=", " ", 
   RowBox[{"reducedState", "[", 
    RowBox[{"fullFactor", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "rhoEdge0", "]"}]}], "Input",
 CellLabel->
  "In[159]:=",ExpressionUUID->"cfaf3c66-c48c-694e-a23b-28b28fd438b5"],

