       "\n", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "  ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Correlation\>\"", "<>", 
              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", 
              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", "   ", 
