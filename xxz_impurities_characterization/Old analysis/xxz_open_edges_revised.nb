              "|>"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"blocks", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Min", "[", 
                RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
               RowBox[{
                RowBox[{"2.", "^", 
                 RowBox[{"(", 
                  RowBox[{"-", "l"}], ")"}]}], "-", 
                RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
               RowBox[{"1", "+", 
                RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
              RowBox[{
               RowBox[{"Min", "[", 
                RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
               RowBox[{
                RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Max", "[", 
                RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
               RowBox[{
                RowBox[{
                 RowBox[{"Floor", "[", 
                  RowBox[{"l", "/", "2"}], "]"}], " ", 
                 RowBox[{"Log", "[", "2", "]"}]}], "+", 
                RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
              RowBox[{
               RowBox[{"Min", "[", 
                RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
