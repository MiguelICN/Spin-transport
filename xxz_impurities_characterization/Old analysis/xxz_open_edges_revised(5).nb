Cell[CellGroupData[{

Cell["\<\
12.4.2 Plot the DOS and cumulative DOS of the selected sector\
\>", "Subsection",ExpressionUUID->"00a80124-2a29-cb47-8841-5d87dbfb9139"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ratioRunCheck", "[", "]"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"12.4", "b"}], " ", "\[LongDash]", " ", 
    RowBox[{
    "Extract", " ", "the", " ", "chosen", " ", "sector", " ", "and", " ", 
     "plot", " ", "its", " ", "DOS"}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Energies", " ", "from", " ", "different", " ", "g", " ", "values", " ", 
    "are", " ", "never", " ", 
    RowBox[{"pooled", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exDOSData", " ", "=", " ", 
    RowBox[{"Table", "[", "\n", "   ", 
     RowBox[{
      RowBox[{"Module", "[", "\n", "    ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "point", ",", " ", "sectors", ",", " ", "e", ",", " ", "d", ",", " ",
           "lo", ",", " ", "hi", ",", " ", "span", ",", "\n", "     ", 
          "edges", ",", " ", "counts", ",", " ", "heights", ",", " ", "cdf"}],
          "}"}], ",", "\n", "\n", "    ", 
        RowBox[{
         RowBox[{"point", " ", "=", " ", 
          RowBox[{"First", "[", 
           RowBox[{"MinimalBy", "[", 
            RowBox[{"exRatioSpectra", ",", " ", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<g\>\"", "]"}], " ", "-", " ", "g"}], 
               "]"}], " ", "&"}]}], "]"}], "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"point", "[", "\"\<g\>\"", "]"}], " ", "-", " ", "g"}], 
             "]"}], " ", "<=", " ", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "10"}]}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", " ", 
               RowBox[{"Abs", "[", "g", "]"}]}], "]"}]}]}], ",", "\n", 
           "     ", "\"\<A requested DOS g value is absent from \
exRatioSpectra.\>\""}], "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"sectors", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Values", "[", 
             RowBox[{"point", "[", "\"\<Data\>\"", "]"}], "]"}], ",", "\n", 
            "      ", 
            RowBox[{"Function", "[", 
             RowBox[{"s", ",", " ", 
              RowBox[{"And", " ", "@@", " ", 
               RowBox[{"KeyValueMap", "[", "\n", "         ", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", " ", "#1",
                     ",", " ", 
                    RowBox[{"Missing", "[", "\"\<Label\>\"", "]"}]}], "]"}], 
                   " ", "==", " ", "#2"}], " ", "&"}], ",", "\n", "         ",
                  "exDOSSectorUsed"}], "]"}]}]}], "]"}]}], "]"}]}], ";", "\n",
          "\n", "    ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "sectors", "]"}], " ", "==", " ", "1"}], ",",
            "\n", "     ", "\"\<DOS selection must identify exactly one \
sector. Check its labels.\>\""}], "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"e", " ", "=", " ", 
          RowBox[{"Sort", "[", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"First", "[", "sectors", "]"}], "[", "\"\<Energies\>\"", 
             "]"}], "]"}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"d", " ", "=", " ", 
          RowBox[{"Length", "[", "e", "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"d", " ", ">", " ", "0"}], " ", "&&", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"e", ",", " ", "realQ"}], "]"}]}], ",", 
           " ", "\"\<Invalid sector energies.\>\""}], "]"}], ";", "\n", "\n", 
         "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Identical", " ", "rank", " ", "convention", " ", "to", " ", 
           RowBox[{"exGapRatios", "."}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"lo", " ", "=", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"exDOSWindowUsed", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], " ", "+", 
             " ", "1"}]}], "]"}]}], ";", "\n", "    ", 
         RowBox[{"hi", " ", "=", " ", 
          RowBox[{"Min", "[", 
           RowBox[{"d", ",", " ", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"exDOSWindowUsed", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
          "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Bins", " ", "cover", " ", "every", " ", "energy"}], ",", 
           " ", 
           RowBox[{"including", " ", "both", " ", "spectral", " ", 
            RowBox[{"endpoints", "."}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"span", " ", "=", " ", 
          RowBox[{"Max", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", "e", "]"}], " ", "-", " ", 
             RowBox[{"First", "[", "e", "]"}]}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "6"}]}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", " ", 
               RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], "\n", "      ",
            "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"edges", " ", "=", " ", 
          RowBox[{"Subdivide", "[", "\n", "      ", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", "e", "]"}], " ", "-", " ", 
             RowBox[{".02", " ", "span"}]}], ",", "\n", "      ", 
            RowBox[{
             RowBox[{"Last", "[", "e", "]"}], " ", "+", " ", 
             RowBox[{".02", " ", "span"}]}], ",", "\n", "      ", 
            "exDOSBins"}], "\n", "      ", "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"edges", ",", " ", "counts"}], "}"}], " ", "=", " ", 
          RowBox[{"HistogramList", "[", 
           RowBox[{"e", ",", " ", 
            RowBox[{"{", "edges", "}"}], ",", " ", "\"\<Count\>\""}], "]"}]}],
          ";", "\n", "\n", "    ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Total", "[", "counts", "]"}], " ", "==", " ", "d"}], ",",
            "\n", "     ", "\"\<DOS bins failed to include every \
level.\>\""}], "]"}], ";", "\n", "\n", "    ", 
         RowBox[{"heights", " ", "=", "\n", "     ", 
          RowBox[{
           RowBox[{"counts", "/", 
            RowBox[{"Differences", "[", "edges", "]"}]}], "/", 
           RowBox[{"If", "[", 
            RowBox[{"exDOSNormalize", ",", " ", "d", ",", " ", "1"}], 
            "]"}]}]}], ";", "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{"Exact", " ", "empirical", " ", "cumulative", " ", "DOS"}],
            ";", " ", 
           RowBox[{"repeated", " ", "energies", " ", "are", " ", 
            RowBox[{"retained", "."}]}]}], " ", "*)"}], "\n", "    ", 
         RowBox[{"cdf", " ", "=", " ", 
          RowBox[{"Join", "[", "\n", "      ", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "[", "edges", "]"}], ",", " ", "0."}], "}"}], 
             "}"}], ",", "\n", "      ", 
            RowBox[{"Flatten", "[", "\n", "       ", 
             RowBox[{
              RowBox[{"Table", "[", "\n", "        ", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"e", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"k", " ", "-", " ", "1."}], ")"}], "/", "d"}]}], 
                   "}"}], ",", " ", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"e", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
                    RowBox[{"k", "/", "d"}]}], "}"}]}], "}"}], ",", "\n", 
                "        ", 
                RowBox[{"{", 
                 RowBox[{"k", ",", " ", "d"}], "}"}]}], "\n", "        ", 
               "]"}], ",", " ", "1"}], "]"}], ",", "\n", "      ", 
            RowBox[{"{", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Last", "[", "edges", "]"}], ",", " ", "1."}], "}"}], 
             "}"}]}], "\n", "      ", "]"}]}], ";", "\n", "\n", "    ", 
         RowBox[{"<|", "\n", "     ", 
          RowBox[{
           RowBox[{"\"\<g\>\"", " ", "->", " ", 
            RowBox[{"point", "[", "\"\<g\>\"", "]"}]}], ",", "\n", "     ", 
           RowBox[{"\"\<Labels\>\"", " ", "->", " ", 
            RowBox[{
             RowBox[{"First", "[", "sectors", "]"}], "[", "\"\<Labels\>\"", 
             "]"}]}], ",", "\n", "     ", 
           RowBox[{"\"\<Dimension\>\"", " ", "->", " ", "d"}], ",", "\n", 
           "     ", 
           RowBox[{"\"\<Energies\>\"", " ", "->", " ", "e"}], ",", "\n", 
           "     ", 
           RowBox[{"\"\<BinEdges\>\"", " ", "->", " ", "edges"}], ",", "\n", 
           "     ", 
           RowBox[{"\"\<BinCounts\>\"", " ", "->", " ", "counts"}], ",", "\n",
            "     ", 
           RowBox[{"\"\<DOSHeights\>\"", " ", "->", " ", "heights"}], ",", 
           "\n", "     ", 
           RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "exDOSNormalize"}], ",",
            "\n", "     ", 
           RowBox[{"\"\<CDFPoints\>\"", " ", "->", " ", "cdf"}], ",", "\n", 
           "     ", 
           RowBox[{"\"\<RankWindow\>\"", " ", "->", " ", "exDOSWindowUsed"}], 
           ",", "\n", "     ", 
           RowBox[{"\"\<WindowRanks\>\"", " ", "->", " ", 
            RowBox[{"{", 
             RowBox[{"lo", ",", " ", "hi"}], "}"}]}], ",", "\n", "     ", 
           RowBox[{"\"\<WindowLevels\>\"", " ", "->", " ", 
            RowBox[{"hi", " ", "-", " ", "lo", " ", "+", " ", "1"}]}], ",", 
           "\n", "     ", 
           RowBox[{"\"\<WindowEnergies\>\"", " ", "->", " ", 
            RowBox[{"e", "[", 
             RowBox[{"[", 
              RowBox[{"{", 
               RowBox[{"lo", ",", " ", "hi"}], "}"}], "]"}], "]"}]}]}], "\n", 
          "     ", "|>"}]}]}], "\n", "    ", "]"}], ",", "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "exDOSGValues"}], "}"}]}], "\n", "   ", "]"}]}],
    ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"Dataset", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"KeyTake", "[", 
        RowBox[{"#", ",", " ", 
         RowBox[{"{", "\n", "      ", 
          
          RowBox[{"\"\<g\>\"", ",", " ", "\"\<Labels\>\"", ",", 
           " ", "\"\<Dimension\>\"", ",", "\n", 
           "      ", "\"\<WindowRanks\>\"", ",", " ", "\"\<WindowLevels\>\"", 
           ",", " ", "\"\<WindowEnergies\>\""}], "\n", "      ", "}"}]}], 
        "]"}], " ", "&"}], " ", "/@", " ", "exDOSData"}], "\n", "  ", "]"}], 
    "]"}], ";"}], "\n", "\n"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "exDOSFigure", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exDOSFigure", "[", 
    RowBox[{"r_", ",", " ", 
     RowBox[{"cumulative_", ":", " ", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", "  ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"edges", " ", "=", " ", 
        RowBox[{"r", "[", "\"\<BinEdges\>\"", "]"}]}], ",", " ", 
       RowBox[{"h", " ", "=", " ", 
        RowBox[{"r", "[", "\"\<DOSHeights\>\"", "]"}]}], ",", "\n", "   ", 
       "yMax", ",", " ", "primitives", ",", " ", "eLeft", ",", " ", "eRight", 
       ",", " ", "cap", ",", " ", "graph", ",", " ", "ylabel"}], "}"}], ",", 
     "\n", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"eLeft", ",", " ", "eRight"}], "}"}], " ", "=", " ", 
       RowBox[{"r", "[", "\"\<WindowEnergies\>\"", "]"}]}], ";", "\n", "  ", 
      RowBox[{"yMax", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{"cumulative", ",", " ", "1.", ",", " ", 
         RowBox[{"1.1", " ", 
          RowBox[{"Max", "[", "h", "]"}]}]}], "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"primitives", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{"cumulative", ",", "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"Blue", ",", " ", 
             RowBox[{"AbsoluteThickness", "[", "1.7", "]"}]}], "]"}], ",", 
           "\n", "     ", 
           RowBox[{"Line", "[", 
            RowBox[{"r", "[", "\"\<CDFPoints\>\"", "]"}], "]"}]}], "}"}], ",",
          "\n", "    ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{"Blue", ",", " ", 
             RowBox[{"Opacity", "[", ".55", "]"}]}], "]"}], ",", "\n", 
           "     ", 
           RowBox[{"MapThread", "[", "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"Rectangle", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"#1", ",", " ", "0"}], "}"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"#2", ",", " ", "#3"}], "}"}]}], "]"}], " ", "&"}], ",",
              "\n", "      ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Most", "[", "edges", "]"}], ",", " ", 
               RowBox[{"Rest", "[", "edges", "]"}], ",", " ", "h"}], "}"}]}], 
            "\n", "      ", "]"}]}], "}"}]}], "\n", "    ", "]"}]}], ";", 
      "\n", "\n", "  ", 
      RowBox[{"ylabel", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
        "cumulative", ",", "\n", "    ", "\"\<N(E)/D\>\"", ",", "\n", "    ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"r", "[", "\"\<Normalized\>\"", "]"}], ",", 
           " ", "\"\<\\\\rho(E)/D\>\"", ",", " ", "\"\<\\\\rho(E)\>\""}], 
          "]"}]}], "\n", "    ", "]"}]}], ";", "\n", "\n", "  ", 
      RowBox[{"cap", " ", "=", " ", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", "\n", "      ", 
          RowBox[{
           RowBox[{"tex", "[", "\n", "       ", 
            RowBox[{
             RowBox[{"\"\<L=\>\"", " ", "<>", " ", 
              RowBox[{"texNumber", "[", 
               RowBox[{"exDOSModelUsed", "[", "\"\<L\>\"", "]"}], "]"}], " ", 
              "<>", "\n", "        ", "\"\<,\\\\quad J=\>\"", " ", "<>", " ", 
              RowBox[{"texNumber", "[", 
               RowBox[{"exDOSModelUsed", "[", "\"\<J\>\"", "]"}], "]"}], " ", 
              "<>", "\n", "        ", "\"\<,\\\\quad \\\\Delta=\>\"", " ", "<>",
               "\n", "        ", 
              RowBox[{"texNumber", "[", 
               RowBox[{"exDOSModelUsed", "[", "\"\<Delta\>\"", "]"}], "]"}], 
              " ", "<>", "\n", "        ", "\"\<,\\\\quad g=\>\"", " ", "<>", 
              " ", 
              RowBox[{"texNumber", "[", 
               RowBox[{"r", "[", "\"\<g\>\"", "]"}], "]"}]}], ",", " ", 
             "13"}], "]"}], ",", "\n", "\n", "      ", 
           RowBox[{"tex", "[", "\n", "       ", 
            RowBox[{
             RowBox[{
              RowBox[{"sectorLabel", "[", 
               RowBox[{"r", "[", "\"\<Labels\>\"", "]"}], "]"}], " ", "<>", 
              "\n", "        ", "\"\<;\\\\quad D=\>\"", " ", "<>", " ", 
              RowBox[{"ToString", "[", 
               RowBox[{"r", "[", "\"\<Dimension\>\"", "]"}], "]"}]}], ",", 
