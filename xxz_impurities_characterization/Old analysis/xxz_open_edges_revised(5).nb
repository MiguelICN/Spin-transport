    RowBox[{"zzResults", ",", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<g\>\"", "]"}], "==", "0"}], "]"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"zzZeroPoints", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<The supplied g grid contains no decoupled \
endpoint.\>\"", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<g=0 candidate charges: \>\"", ",", 
       RowBox[{
        RowBox[{
