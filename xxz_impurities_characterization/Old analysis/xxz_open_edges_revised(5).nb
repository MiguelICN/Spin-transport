Cell[CellGroupData[{

Cell["Initial states construction", "Subsection",ExpressionUUID->"042752aa-1978-d140-b1e3-30602df799cc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Tensor", " ", "product", " ", "of", " ", "normalized", " ", "local", " ", 
    RowBox[{"spinors", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"productKet", "[", "locals_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "v", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", 
           " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"locals", ",", "\n", "  ", 
             RowBox[{
              RowBox[{
               RowBox[{"VectorQ", "[", 
                RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
            "]"}]}], ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"v", "=", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"N", "[", 
                RowBox[{"#2", "/", 
                 RowBox[{"Norm", "[", "#2", " ", "]"}]}], "]"}]}], "]"}], 
             "]"}], "&"}], ",", 
           RowBox[{"{", "1.", "}"}], ",", "locals"}], "]"}]}], ";", " ", 
        RowBox[{"v", "/", 
         RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"first", "=", 
      RowBox[{"0", " ", "starts", " ", "with", " ", "up"}]}], ";", " ", 
     RowBox[{"first", "=", 
      RowBox[{"1", " ", "starts", " ", "with", " ", 
       RowBox[{"down", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"neel", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"first_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"UnitVector", "[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"k", "-", "1", "+", "first"}], ",", "2"}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "phi", " ", "is", " ", "the", " ", "azimuth", " ", "of", " ", "the", " ", 
     "first", " ", "spin", " ", "in", " ", "this", " ", 
     RowBox[{"vector", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"helix", "[", 
      RowBox[{"n_Integer", ",", "q_", ",", 
       RowBox[{"theta_", ":", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"phi_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"productKet", "[", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"theta", "/", "2"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", 
             RowBox[{"(", 
              RowBox[{"phi", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}], "q"}]}], ")"}]}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}]}]}]], "Input",\
ExpressionUUID->"58f34d97-323b-cc46-9261-6b59d695dc1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Accept", " ", "a", " ", "vector", " ", "or", " ", "a", " ", "positive"}],
     ",", " ", 
    RowBox[{"trace", "-", 
     RowBox[{"one", " ", "density", " ", 
      RowBox[{"matrix", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"stateFactor", "[", 
      RowBox[{"input_", ",", "dim_", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", "input", " ", "]"}], "]"}]}], ",", "e", ",",
          "v", ",", "keep"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{"x", ",", "NumericQ"}], "]"}], ",", 
          RowBox[{
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "x", "]"}], "==", "dim"}], " ", "&&", 
              " ", 
              RowBox[{
               RowBox[{"Norm", "[", "x", "]"}], ">", "0"}]}], 
             ",", "\"\<Invalid state vector.\>\""}], "]"}], ";", "\n", "  ", 
           RowBox[{"Return", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"x", "/", 
               RowBox[{"Norm", "[", "x", "]"}]}], "}"}], "]"}], "]"}]}]}], 
         "]"}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixQ", "[", 
            RowBox[{"x", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Dimensions", "[", "x", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"dim", ",", "dim"}], "}"}]}]}], 
          ",", "\"\<Invalid density-matrix dimensions.\>\""}], "]"}], ";", 
        "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"x", "-", 
               RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "<=", "tol"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "x", "]"}], "-", "1"}], "]"}], "<=", 
            "tol"}]}], ",", "\n", 
          "  ", "\"\<Density matrix must be Hermitian with trace one.\>\""}], 
         "]"}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"herm", "[", "x", " ", "]"}], "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", "e", " ", "]"}], "]"}], ">=", 
           RowBox[{"-", "tol"}]}], 
          ",", "\"\<Density matrix is not positive.\>\""}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"e", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Re", "[", "e", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"e", "/=", 
         RowBox[{"Total", "[", "e", "]"}]}], ";", 
        RowBox[{"keep", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", "dim", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "#", " ", "]"}], "]"}], ">", "0"}], "&"}]}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "keep", " ", "]"}], "]"}], "]"}], " ", 
          RowBox[{"v", "[", 
           RowBox[{"[", "keep", " ", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Reorder", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"edge", " ", "1"}], ",", 
        RowBox[{"edge", " ", "L"}], ",", "middle"}], ")"}], " ", "to", " ", 
      "physical", " ", "sites", " ", "1"}], ",", "...", ",", 
     RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"joinStates", "[", 
      RowBox[{"ef_", ",", "mf_", ",", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"ef", ",", "mf"}], "]"}]}], "}"}], ",", "\n", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{"a", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2", ",", 
               RowBox[{"2", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "-", "2"}], ")"}]}], ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "a", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
           "  ", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "l"}], ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "a", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "]"}]}],
     ";"}]}]}]], "Input",ExpressionUUID->"afc18a15-975d-fa41-8e85-\
71de89dca1a9"]
