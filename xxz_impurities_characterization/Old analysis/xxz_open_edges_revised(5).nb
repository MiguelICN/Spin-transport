    RowBox[{
     RowBox[{"Last", "[", "zzGUsed", "]"}], ",", "zzSetup", ",", 
     RowBox[{"zzSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Dataset", "[", "zzBlockAudit", "]"}]}], "Input",ExpressionUUID->\
