     " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
        RowBox[{"If", "[", 
