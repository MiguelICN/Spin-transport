Cell[CellGroupData[{

Cell["9.5 Prepare the fixed state and times", "Subsection",ExpressionUUID->"a87a5788-1916-c34d-b7ef-ac7c77779e8d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegerQ", "[", 
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ">=", "3"}]}], 
    ",", "\"\<L must be an integer >=3.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"dynModel", ",", "\"\<Delta\>\""}], "]"}]}], 
    ",", "\"\<Put Delta values only in dynDelta.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ListQ", "[", "dynDelta", "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "dynDelta", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"dynDelta", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{"N", "[", "dynDelta", "]"}], ",", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"#1", "==", "#2"}], "]"}], "&"}]}], "]"}], "]"}], "==", 
      RowBox[{"Length", "[", "dynDelta", "]"}]}]}], ",", "\n", 
    " ", "\"\<Use at least two distinct real Delta values.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "dynStateMode"}], "]"}], ",", "\"\<Invalid dynStateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynModelUsed", "=", "dynModel"}], ";", 
  RowBox[{"dynDeltaUsed", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"N", "[", "dynDelta", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimeUsed", "=", "dynTime"}], ";", 
  RowBox[{"dynParallelUsed", "=", "dynParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynEDToleranceUsed", "=", "dynEDTolerance"}], ";", 
  RowBox[{"dynValidationToleranceUsed", "=", "dynValidationTolerance"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimes", "=", 
   RowBox[{"timeGrid", "[", "dynTimeUsed", "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"95884088-58ea-cf4a-83c4-d8a27557dc5c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"dynStateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"dynEdgeFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynEdgeState", ",", "4", ",", "dynValidationToleranceUsed"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"dynMiddleFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynMiddleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], 
          ")"}]}], ",", "dynValidationToleranceUsed"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"dynFactor", "=", 
      RowBox[{"joinStates", "[", 
       RowBox[{"dynEdgeFactor", ",", "dynMiddleFactor", ",", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", 
    "\n", " ", 
    RowBox[{"dynFactor", "=", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"dynFullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "dynValidationToleranceUsed"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynRhoEdge0", "=", 
   RowBox[{"reducedState", "[", 
    RowBox[{"dynFactor", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynGram", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "dynFactor", "]"}], " ", ".", " ", 
    "dynFactor"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPurity0", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{"dynGram", " ", ".", " ", "dynGram"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPureInput", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"dynPurity0", "-", "1."}], "]"}], "<=", 
    "dynValidationToleranceUsed"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynSpecsUsed", "=", "dynPlotSpecs"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", "dynPureInput"}], ",", "\n", " ", 
    RowBox[{"dynSpecsUsed", "=", 
     RowBox[{"Replace", "[", 
      RowBox[{"dynSpecsUsed", ",", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", ",", "_", ",", "_"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", 
          ",", "\"\<\\\\text{Normalized full-state overlap}\>\"", ",", "\n", 
          "   ", "\"\<\\\\operatorname{Tr}[\\\\rho(0)\\\\rho(t)]/\\\\\
operatorname{Tr}[\\\\rho(0)^2]\>\""}], "}"}]}], ",", "1"}], "]"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Fixed initial purity: \>\"", ",", "dynPurity0", 
    ",", "\"\<; Delta points: \>\"", ",", 
    RowBox[{"Length", "[", "dynDeltaUsed", "]"}], ",", "\n", 
    " ", "\"\<; time points: \>\"", ",", 
    RowBox[{"Length", "[", "dynTimes", "]"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"524cfff9-0996-f744-9f6a-f480075de075"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.6 Independent sector ED and evolution at every Delta", "Subsection",ExpressionUUID->"78424757-0ebc-244b-8011-33e955161179"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Delta", " ", "values", " ", "are", " ", "processed", " ", "in", " ", 
     "order"}], ";", " ", 
    RowBox[{
    "time", " ", "batches", " ", "use", " ", "the", " ", "existing", " ", 
     "parallel", " ", 
     RowBox[{"kernels", ".", "\n", "Every"}], " ", "symmetry", " ", "sector", 
     " ", "is", " ", "diagonalized", " ", "independently"}]}], ",", " ", 
   RowBox[{
    RowBox[{"including", " ", "special", " ", "Delta"}], "=", 
    RowBox[{
     RowBox[{"+", 
      RowBox[{"/", 
       RowBox[{"-", "1."}]}]}], "\n", "The", " ", "full", " ", "initial", " ",
      "factor", " ", "is", " ", "reused", " ", "at", " ", "every", " ", 
     RowBox[{"Delta", "."}]}]}]}], "*)"}]], "Input",ExpressionUUID->"17d01ba3-\
4a18-bc40-9503-89d34c41051a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dynResults", ",", "dynPlots", ",", "dynLogPlots"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dynSweepSeconds", ",", "dynResults"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "=", 
        RowBox[{"dynDeltaUsed", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Delta = \>\"", ",", "delta", ",", "\"\< (\>\"", ",", "k",
          ",", "\"\</\>\"", ",", 
         RowBox[{"Length", "[", "dynDeltaUsed", "]"}], ",", "\"\<)\>\""}], 
        "]"}], ";", "\n", "  ", 
       RowBox[{"dynCurrentModel", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"dynModelUsed", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Delta\>\"", "->", "delta"}], "|>"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dynEDSeconds", ",", "dynCurrentED"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{"sectorED", "[", 
          RowBox[{"dynCurrentModel", ",", "dynEDToleranceUsed"}], "]"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynCurrentEngine", "=", 
        RowBox[{"makeEngine", "[", 
         RowBox[{"dynCurrentED", ",", "dynFactor"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dynEvolutionSeconds", ",", "dynRecords"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", "\n", "   ", 
         RowBox[{"evolveChunks", "[", 
          RowBox[{
          "dynTimes", ",", "dynCurrentEngine", ",", "dynRhoEdge0", ",", 
           "dynValidationToleranceUsed", ",", "dynParallelUsed"}], "]"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynRecords", "=", 
        RowBox[{"extraRecords", "[", 
         RowBox[{"dynRecords", ",", "dynCurrentEngine", ",", "dynPurity0"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynValues", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", "\n", "   ", 
          RowBox[{
           RowBox[{"key", "->", 
            RowBox[{"Developer`ToPackedArray", "[", 
             RowBox[{"N", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"dynRecords", ",", "key"}], "]"}], "]"}], "]"}]}], ",",
            "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"key", ",", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{"First", "[", "dynRecords", "]"}], "]"}], 
               ",", "\"\<Time\>\""}], "]"}]}], "}"}]}], "]"}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ED seconds: \>\"", ",", "dynEDSeconds", 
         ",", "\"\<; evolution seconds: \>\"", ",", "dynEvolutionSeconds"}], 
        "]"}], ";", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Delta\>\"", "->", "delta"}], ",", 
         RowBox[{"\"\<EDSeconds\>\"", "->", "dynEDSeconds"}], ",", 
         RowBox[{"\"\<EvolutionSeconds\>\"", "->", "dynEvolutionSeconds"}], ",",
          "\n", "   ", 
         RowBox[{"\"\<Sectors\>\"", "->", 
          RowBox[{"sectorTable", "[", "dynCurrentED", "]"}]}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "dynValues"}]}], "|>"}]}], ",", "\n",
       "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "dynDeltaUsed", "]"}]}], "}"}]}], "]"}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "dynCurrentED", ",", "dynCurrentEngine", ",", "dynRecords", ",", 
    "dynValues"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Delta sweep seconds: \>\"", ",", "dynSweepSeconds"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"0e50c829-d533-494b-a761-fe5f71e416a4"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.7 Individual plots", "Subsection",ExpressionUUID->"3cde79c3-c50a-ff4c-8729-cce0d626bbd2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "dynResults", "]"}], "==", 
      RowBox[{"Length", "[", "dynDeltaUsed", "]"}]}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"Lookup", "[", 
