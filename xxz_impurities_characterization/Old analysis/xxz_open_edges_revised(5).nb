             RowBox[{
              RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], ",", "\"\<L\>\"",
               ",", 
              RowBox[{"Missing", "[", "]"}]}], "]"}], "]"}]}], ",", "\n", 
          "  ", "\"\<makeEngine requires an integer L in ED \
Parameters.\>\""}], "]"}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", 
             RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], "]"}], "==", 
