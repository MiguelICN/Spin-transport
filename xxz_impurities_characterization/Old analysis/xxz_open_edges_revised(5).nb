   "fullOverlapBatch", ",", "extraRecords", ",", "deltaColor", ",", 
    "deltaBar", ",", "deltaPanel"}], "]"}], ";"}]}], "Input",ExpressionUUID->\
"4f704494-4603-7b46-a107-d484f3247208"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"Entropies", " ", "use", " ", "natural", " ", 
    RowBox[{"logarithms", ".", " ", "For"}], " ", "a", " ", "pure", " ", 
    "full", " ", "state"}], ",", " ", "S_A", ",", " ", 
   RowBox[{
   "S_B", " ", "and", " ", "S_AB", " ", "measure", "\n", "A", " ", "versus", " ",
     "the", " ", "rest"}], ",", " ", 
   RowBox[{"B", " ", "versus", " ", "the", " ", "rest"}], ",", " ", 
   RowBox[{
    RowBox[{"and", " ", "both", " ", "edges", " ", "versus", " ", "the", " ", 
     RowBox[{"middle", ".", "\n", "Local"}], " ", "expectations", " ", "and", 
     " ", "correlations", " ", "use", " ", "Pauli", " ", 
     RowBox[{"matrices", ":", " ", "sigma"}]}], "=", 
    RowBox[{
     RowBox[{"2", " ", 
      RowBox[{"S", ".", "\n", "Full"}], " ", "survival", " ", "is"}], " ", "|", 
     RowBox[{"<", 
      RowBox[{"psi", 
       RowBox[{"(", "0", ")"}]}]}], "|", 
     RowBox[{
      RowBox[{"psi", 
       RowBox[{"(", "t", ")"}]}], ">"}], "|", 
     RowBox[{
      RowBox[{
       RowBox[{"^", "2."}], " ", "Mixed", " ", "inputs", " ", "use", " ", 
       "the", " ", "normalized", "\n", "full"}], "-", 
      RowBox[{"state", " ", "overlap", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"rho", 
          RowBox[{"(", "0", ")"}], "rho", 
          RowBox[{"(", "t", ")"}]}], "]"}], "/", 
        RowBox[{"Tr", "[", 
         RowBox[{"rho", 
          RowBox[{
           RowBox[{"(", "0", ")"}], "^", "2"}]}], "]"}]}], " ", 
       RowBox[{"instead", "."}]}]}]}]}]}], "*)"}]], "Input",ExpressionUUID->\
"dc8f1eef-cb90-c14b-9e44-c6ea527c2785"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Spectral overlap; no full - state evolution is repeated . ", \
"Subsection",ExpressionUUID->"631c1edb-abb5-6041-85b0-8faa7a26acc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fullOverlapBatch", "[", 
    RowBox[{"ts_List", ",", "eng_", ",", "purity0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.", ",", 
          RowBox[{"Length", "[", "ts", "]"}]}], "]"}]}], ",", 
       RowBox[{"rank", "=", 
        RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}], ",", "amp", ",", 
       "ph"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"amp", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"Length", "[", "ts", "]"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ph", "=", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"Outer", "[", 
                RowBox[{"Times", ",", 
                 RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
                 RowBox[{"N", "[", "ts", "]"}]}], "]"}]}], "]"}]}], ";", "\n",
             "   ", 
            RowBox[{"amp", "+=", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Conjugate", "[", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "i"}], "]"}], "]"}], "]"}], " ", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "j"}], "]"}], "]"}]}], ")"}], " ", ".", 
              " ", "ph"}]}]}], ",", "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], ";",
          "\n", "  ", 
         RowBox[{"out", "+=", 
          RowBox[{
           RowBox[{"Abs", "[", "amp", "]"}], "^", "2"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "rank"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "rank"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{
        RowBox[{"Re", "[", "out", "]"}], "/", "purity0"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"5055aee6-2fb9-b046-8ccd-\
493af973037b"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Add local Pauli expectations, pair correlations and full overlap . \
\>", "Subsection",ExpressionUUID->"768a3dc5-3dc0-164a-a988-628964369eda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"extraRecords", "[", 
    RowBox[{"records_List", ",", "eng_", ",", "purity0_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"overlap", ",", 
       RowBox[{"pauli", "=", 
        RowBox[{"PauliMatrix", " ", "/@", " ", 
         RowBox[{"Range", "[", "3", "]"}]}]}], ",", 
       RowBox[{"axes", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}]}],
       "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"overlap", "=", 
       RowBox[{"fullOverlapBatch", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], ",", "eng", ",", 
         "purity0"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rec", ",", "ov"}], "}"}], ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ra", "=", 
               RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
              RowBox[{"rb", "=", 
               RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}], ",", "\n", "   ", 
              RowBox[{"r", "=", 
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", "a", ",", 
              "b", ",", "c", ",", "extra"}], "}"}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{"a", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"#", " ", ".", " ", "ra"}], "]"}], "]"}], "&"}], 
               " ", "/@", " ", "pauli"}]}], ";", 
             RowBox[{"b", "=", 
              RowBox[{
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"#", " ", ".", " ", "rb"}], "]"}], "]"}], "&"}], 
               " ", "/@", " ", "pauli"}]}], ";", "\n", "  ", 
             RowBox[{"c", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{
                   RowBox[{"KroneckerProduct", "[", 
                    RowBox[{
                    RowBox[{"pauli", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                    RowBox[{"pauli", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", ".", " ", 
                   "r"}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "3"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"extra", "=", 
              RowBox[{"Association", "[", 
               RowBox[{"Join", "[", "\n", "   ", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"\"\<PurityA\>\"", "->", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"ra", " ", ".", " ", "ra"}], "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<PurityB\>\"", "->", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Tr", "[", 
                    RowBox[{"rb", " ", ".", " ", "rb"}], "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<FullOverlap\>\"", "->", "ov"}]}], "}"}], ",", 
                 "\n", "   ", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<LocalA\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                    RowBox[{"a", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "   ", 
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<LocalB\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "   ", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{
                   RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"{", "\n", "    ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<Correlation\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", "\n", 
                    "    ", 
                    RowBox[{
                    RowBox[{"\"\<Connected\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"a", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], "}"}], ",",
                     "\n", "    ", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "3"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "2"}], 
                  "]"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"KeyDrop", "[", 
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"rec", ",", "extra"}], "]"}], ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<RhoAB\>\"", ",", "\"\<RhoA\>\"", 
                 ",", "\"\<RhoB\>\"", ",", "\"\<EigenvaluesAB\>\""}], "}"}]}],
               "]"}]}]}], "\n", " ", "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"records", ",", "overlap"}], "}"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"698d0479-6629-6340-933c-\
