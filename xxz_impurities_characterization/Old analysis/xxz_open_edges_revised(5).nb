         "\n", "  ", 
         RowBox[{"\"\<Settings\>\"", "->", "exRatioSettingsUsed"}], ",", 
         RowBox[{"\"\<PlotSettings\>\"", "->", 
          RowBox[{"KeyTake", "[", 
