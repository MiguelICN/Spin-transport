Cell[CellGroupData[{

Cell["Output paths", "Subsection",ExpressionUUID->"89232177-c767-ca45-98c1-d07676ca46d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"baseFolder", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "d", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"StringQ", "[", "$InputFileName", "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"StringLength", "[", "$InputFileName", "]"}], ">", "0"}]}],
          ",", "\n", "  ", 
         RowBox[{"DirectoryName", "[", 
          RowBox[{"ExpandFileName", "[", "$InputFileName", " ", "]"}], "]"}], 
         ",", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"NotebookDirectory", "[", "]"}], ",", 
            RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", "d", "]"}], ",", "d", ",", 
        RowBox[{"Directory", "[", "]"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"safeToken", "[", "x_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "s", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
           "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"s", "=", 
        RowBox[{"StringReplace", "[", 
         RowBox[{"s", ",", 
          RowBox[{
           RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
           "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<*^\>\"", "->", "\"\<e\>\""}], ",", 
           RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}], ",", 
           RowBox[{"\"\<-\>\"", "->", "\"\<m\>\""}], ",", 
           RowBox[{"\"\<+\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Numbered", " ", "reruns", " ", "prevent", " ", "overwriting"}], ";",
     " ", 
    RowBox[{"no", " ", "timestamps", " ", "or", " ", "random", " ", 
     RowBox[{"strings", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"newFolder", "[", 
    RowBox[{"root_", ",", "tag_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"k", "=", "1"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"d", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", "tag"}], "}"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"DirectoryQ", "[", "d", "]"}], ",", 
        RowBox[{
         RowBox[{"k", "++"}], ";", 
         RowBox[{"d", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"root", ",", 
             RowBox[{"tag", "<>", "\"\<_run\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}]}], "}"}], "]"}]}]}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"CreateDirectory", "[", 
       RowBox[{"d", ",", 
        RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], ";",
       "d"}]}], "\n", "]"}]}], ";"}]}], "Input",ExpressionUUID->"58c60711-\
2634-3249-b3e7-43f574716c09"]
}, Closed]]
}, Closed]],

