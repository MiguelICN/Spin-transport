       RowBox[{"{", 
        RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",Express\
ionUUID->"35bc67ee-79f8-cf46-a2c4-9ef165c0335d"]
