    RowBox[{"exRatioSetup", ",", 
     RowBox[{"{", "\"\<Parts\>\"", "}"}]}], "]"}], "}"}], "]"}]}], "Input",Exp\
ressionUUID->"7e5f4dd8-a5d3-ba44-80d5-ef58d424757c"]
