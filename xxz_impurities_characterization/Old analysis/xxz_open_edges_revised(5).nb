sionUUID->"4ada2108-4885-964e-94d1-429ad3114847"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dynLogPlots", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "dynExportLogTime", "]"}], ",", "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", "\n", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"spec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<_logtime\>\""}], "->", 
           RowBox[{"deltaPanel", "[", 
            RowBox[{
