                    RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "<", 
                    RowBox[{"tol", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], ",", "\n", "     ", 
                   RowBox[{"edgeSplit", "[", 
                    RowBox[{"s", ",", 
