                    "tol"}], "]"}], ",", 
                   RowBox[{"{", "s", "}"}]}], "]"}]}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "out"}], "}"}]}], "]"}], ";", 
           RowBox[{"out", "=", "next"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", 
            RowBox[{"Keys", "[", "q", "]"}]}], "}"}]}], "]"}], ";", "out"}]}],
       "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"d6396812-1ca8-9941-\
