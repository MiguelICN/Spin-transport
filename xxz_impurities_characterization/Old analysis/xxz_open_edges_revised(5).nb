          RowBox[{"\"\<Sectors\>\"", "->", "blocks"}]}], "|>"}]}]}], "\n", 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Single", "-", 
      RowBox[{"time", " ", "evolution"}]}], ",", " ", 
     RowBox[{"useful", " ", "for", " ", "checks", " ", "and", " ", "direct", " ", 
      RowBox[{"access", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
