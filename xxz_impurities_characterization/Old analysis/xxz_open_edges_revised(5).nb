      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}], ",", "\"\<SpecialBulkDegeneracyControl\>\"", ",",
      "True", ",", "\"\<GeneralAnisotropy\>\""}], "]"}]}], ";"}]], "Input",Exp\
ressionUUID->"2c947a94-53c1-7843-9271-151088265833"],

