Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"edgeSetup", "[", 
     RowBox[{"p_", ",", "kind_", ",", "spaceFunction_", ",", "tol_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
