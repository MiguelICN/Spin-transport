Cell[CellGroupData[{

Cell["2. Plotting, MaTeX labels, and file output", "Section",ExpressionUUID->"c6c4968d-b0d0-6245-85e4-080859c5b0a8"],

Cell[CellGroupData[{

Cell["Labels and ticks", "Subsection",ExpressionUUID->"4d4bf190-cfe6-e54d-8439-22addfd12026"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "tex", ",", "texNumber", ",", "ticks", ",", "logTicks", ",", "sectorLabel",
     ",", "dimLabel", ",", "caption", ",", "curveStyles", ",", "pointMarkers",
     ",", "\n", " ", "framePlot", ",", "plotPanel", ",", "sweepPanels", ",", 
    "fixedPanels", ",", "series", ",", "matrixSeries", ",", "densityPanels", ",",
     "\n", " ", "safeToken", ",", "newFolder", ",", "baseFolder", ",", 
    "savePNG"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"texReady", "=", "Automatic"}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"MaTeX", " ", "labels"}], ";", " ", 
    RowBox[{
    "a", " ", "visible", " ", "native", " ", "fallback", " ", "is", " ", 
     "used", " ", "if", " ", "MaTeX", " ", "is", " ", 
     RowBox[{"unavailable", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tex", "[", 
    RowBox[{"s_String", ",", 
     RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "g", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"texReady", "===", "Automatic"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"texReady", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], ",",
              "False"}], " ", "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"TrueQ", "[", "texReady", "]"}]}], ",", 
           RowBox[{
           "Print", 
            "[", "\"\<MaTeX unavailable: check the local installation.\>\"", 
            "]"}]}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", "texReady", "]"}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"s", ",", 
               RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", "$Failed"}], 
            " ", "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
           RowBox[{"Return", "[", "g", " ", "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"texReady", "=", "False"}], ";", 
         RowBox[{
         "Print", "[", "\"\<MaTeX failed: check TeX/Ghostscript.\>\"", 
          "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"s", ",", "Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "size"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"1542f839-f403-c848-93c8-6195602e7183"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Numeric", " ", "labels", " ", "use", " ", "decimals", " ", "rather", " ", 
    "than", " ", 
    RowBox[{"fractions", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"texNumber", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "p"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"x", "==", "0"}], "]"}], ",", 
          RowBox[{"Return", "[", "\"\<0\>\"", "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"x", "==", 
             RowBox[{"Round", "[", "x", " ", "]"}]}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "<", 
            RowBox[{"10", "^", "6"}]}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"ToString", "[", 
            RowBox[{"Round", "[", "x", " ", "]"}], "]"}], "]"}]}], "]"}], ";",
         "\n", " ", 
        RowBox[{"s", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
           RowBox[{
            RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
            "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"p", "=", 
         RowBox[{"StringSplit", "[", 
          RowBox[{"s", ",", "\"\<*^\>\""}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"p", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
            "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "p", "]"}], "==", "2"}], ",", 
          RowBox[{
           RowBox[{"p", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<\\\\times 10^{\>\"", "<>", 
           RowBox[{"p", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<>", "\"\<}\>\""}], ",", 
          RowBox[{"First", "[", "p", " ", "]"}]}], "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ticks", "[", 
      RowBox[{
       RowBox[{"lo_", "?", "NumericQ"}], ",", 
       RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", "lo"}], ",", 
         RowBox[{"b", "=", "hi"}]}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"a", "==", "b"}], ",", 
          RowBox[{
           RowBox[{"a", "-=", "1"}], ";", 
           RowBox[{"b", "+=", "1"}]}]}], "]"}], ";", "\n", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"tex", "[", 
              RowBox[{
               RowBox[{"texNumber", "[", "#", "]"}], ",", "14"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
          " ", 
          RowBox[{"FindDivisions", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"a", ",", "b"}], "}"}], ",", "5"}], "]"}]}], ")"}]}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"logTicks", "[", 
      RowBox[{
       RowBox[{"lo_", "?", "NumericQ"}], ",", 
       RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"#", " ", 
            RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
          RowBox[{"tex", "[", 
           RowBox[{
            RowBox[{"\"\<10^{\>\"", "<>", 
             RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<}\>\""}], ",", 
            "14"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", "\n",
        "  ", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"Floor", "[", 
          RowBox[{"lo", "/", 
           RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{"hi", "/", 
           RowBox[{"Log", "[", "10", "]"}]}], "]"}]}], "]"}]}], ")"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sectorLabel", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"StringRiffle", "[", 
      RowBox[{
       RowBox[{"KeyValueMap", "[", "\n", " ", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Switch", "[", 
            RowBox[{
            "#1", ",", "\"\<R\>\"", ",", "\"\<r\>\"", ",", "\"\<F\>\"", 
             ",", "\"\<f\>\"", ",", "\"\<RF\>\"", ",", "\"\<rf\>\"", 
             ",", "\"\<StaggeredS\>\"", ",", "\"\<S_{\\\\rm stag}\>\"", ",", 
             "_", ",", "#1"}], "]"}], "<>", "\n", "  ", "\"\<=\>\"", "<>", 
           RowBox[{"texNumber", "[", "#2", "]"}]}], "&"}], ",", "a"}], "]"}], 
       ",", "\"\<,\\\\quad \>\""}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "A", " ", "common", " ", "dimension", " ", "for", " ", "equivalent", " ",
       "sectors"}], ";", " ", 
     RowBox[{"otherwise", " ", "use", " ", "legend", " ", 
      RowBox[{"order", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dimLabel", "[", "dims_List", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"SameQ", "@@", "dims"}], ",", "\n", " ", 
       RowBox[{"\"\<d_{\\\\mathrm{sector}}=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"First", "[", "dims", "]"}], "]"}]}], ",", "\n", " ", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"\"\<d_{\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<}=\>\"", "<>", 
             RowBox[{"ToString", "[", "#1", "]"}]}], "&"}], ",", "dims"}], 
          "]"}], ",", "\"\<,\\\\quad \>\""}], "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",ExpressionUUID->"e3916cdd-a696-2a4e-8693-\
967cac77bd24"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Every", " ", "caption", " ", "uses", " ", "the", " ", "parameters", " ", 
    "of", " ", "the", " ", "computed", " ", 
    RowBox[{"result", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"caption", "[", 
      RowBox[{"p_", ",", "deltaText_", ",", 
