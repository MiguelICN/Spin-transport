      RowBox[{"Casimir", " ", "label", " ", 
       RowBox[{"conversion", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeSplit", "[", 
      RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"alias", ",", "label", ",", "out"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"alias", "=", 
         RowBox[{"Switch", "[", 
          RowBox[{"name", ",", 
           RowBox[{"\"\<BulkS2\>\"", "|", "\"\<EdgeS2\>\""}], 
           ",", "\"\<S2\>\"", ",", "\"\<StaggeredBulkS2\>\"", 
           ",", "\"\<StaggeredS2\>\"", ",", "_", ",", "name"}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"label", "=", 
         RowBox[{"Switch", "[", 
          RowBox[{
          "name", ",", "\"\<BulkS2\>\"", ",", "\"\<SBulk\>\"", 
           ",", "\"\<EdgeS2\>\"", ",", "\"\<SEdge\>\"", ",", "\n", 
           "  ", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredSBulk\>\"", ",",
            "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"out", "=", 
         RowBox[{"splitCharge", "[", 
          RowBox[{"s", ",", "q", ",", "alias", ",", "tol"}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"alias", "=!=", "name"}], ",", 
          RowBox[{"out", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"t", ",", 
               RowBox[{"Join", "[", 
                RowBox[{"t", ",", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<Labels\>\"", "->", 
                   RowBox[{"Append", "[", "\n", "   ", 
                    RowBox[{
                    RowBox[{"KeyDrop", "[", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "}"}]}], "]"}], ",", 
                    "\n", "   ", 
                    RowBox[{"label", "->", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "]"}]}]}], "]"}]}], 
                  "|>"}]}], "]"}]}], "]"}], ",", "out"}], "]"}]}]}], "]"}], ";",
         "\n", " ", "out"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "A", " ", "charge", " ", "is", " ", "split", " ", "only", " ", "when", " ",
      "it", " ", "preserves", " ", "the", " ", "CURRENT", " ", 
     RowBox[{"subspace", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeRefine", "[", 
      RowBox[{"spaces_", ",", "q_", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"out", "=", "spaces"}], ",", "next", ",", "b", ",", "a"}], 
        "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"next", "=", 
            RowBox[{"{", "}"}]}], ";", "\n", "  ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"b", "=", 
               RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
              RowBox[{"a", "=", 
               RowBox[{"herm", "[", 
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
                 RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], 
                "]"}]}], ";", "\n", "   ", 
              RowBox[{"next", "=", 
               RowBox[{"Join", "[", 
                RowBox[{"next", ",", 
                 RowBox[{"If", "[", 
