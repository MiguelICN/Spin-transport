Cell[CellGroupData[{

Cell["12.4.1 DOS settings; inspect before computing means", "Subsection",ExpressionUUID->"591d78a4-99ad-fa4b-b982-9933c7e8e543"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
