Cell[CellGroupData[{

Cell["Basis adaptation respecting symmetries", "Subsection",ExpressionUUID->"09cd670a-7434-2e46-a727-13c79a598f5b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Charges", " ", "allowed", " ", "by", " ", "the", " ", "effective", " ", 
    "longitudinal", " ", 
    RowBox[{"fields", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"charges", "[", "p_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"2", "^", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], ",", "r", ",", "f", ",", 
        "fields", ",", 
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "st", ",", "sx", ",", "sy", ",", "sz"}],
        "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"fields", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<h\>\"", "]"}], ",", "l"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bRight\>\"", "]"}]}], ";", "\n", " ", 
       RowBox[{"r", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "+", 
                RowBox[{"FromDigits", "[", 
                 RowBox[{
                  RowBox[{"Reverse", "[", 
                   RowBox[{"IntegerDigits", "[", 
                    RowBox[{"k", ",", "2", ",", "l"}], " ", "]"}], "]"}], ",",
                   "2"}], "]"}]}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", "\n", "  ", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"f", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"d", "-", "k"}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "@@", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"#1", "==", "#2"}], "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"fields", ",", 
              RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<R\>\"", "->", "r"}]}], " ", "]"}]}], "]"}], ";", "\n",
        " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"#", "==", "0"}], "]"}], "&"}], " ", "/@", " ", 
            "fields"}], ")"}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<F\>\"", "->", "f"}]}], " ", "]"}]}], "]"}], ";", "\n",
        " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#1", " ", "==", " ", 
                RowBox[{"-", "#2"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"fields", ",", 
               RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], 
          " ", "&&", "\n", "  ", 
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"out", ",", "\"\<R\>\""}], "]"}], " ", "&&", " ", 
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"out", ",", "\"\<F\>\""}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<RF\>\"", "->", 
            RowBox[{"r", " ", ".", " ", "f"}]}]}], "]"}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}], 
            " ", "||", " ", 
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", "==", " ", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}], " ", "&&", " ", 
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#", "==", 
                RowBox[{"First", "[", "fields", " ", "]"}]}], "]"}], "&"}], 
             " ", "/@", " ", "fields"}], ")"}]}]}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{"st", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1", ",", "l"}], "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"sx", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"st", "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}], " ", 
               RowBox[{"siteOp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", 
                 "k", ",", "l"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"sy", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"st", "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}], " ", 
               RowBox[{"siteOp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}], ",", 
                 "k", ",", "l"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"sz", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
