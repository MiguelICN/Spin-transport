         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<EntropyA\>\"", ",", "\"\<EntropyB\>\"", 
           ",", "\"\<EntropyAB\>\"", ",", "\"\<MutualInfo\>\""}], "}"}]}], ",",
         "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"\"\<S(\\\\rho_A)\>\"", ",", "\"\<S(\\\\rho_B)\>\"", 
          ",", "\"\<S(\\\\rho_{AB})\>\"", ",", "\"\<I(A:B)\>\""}], "}"}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<04_edge_entanglement\>\"", 
        ",", "\"\<\\\\text{Entanglement between the edge spins}\>\"", 
        ",", "\"\<C,\\\\mathcal N\>\"", ",", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Concurrence\>\"", ",", "\"\<Negativity\>\""}], "}"}]}],
         ",", 
        RowBox[{"{", 
         RowBox[{"\"\<C(\\\\rho_{AB})\>\"", 
          ",", "\"\<\\\\mathcal N(\\\\rho_{AB})\>\""}], "}"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<05_purity_initial_overlap\>\"", 
        ",", "\"\<\\\\text{Purity and reduced-state overlap}\>\"", 
        ",", "\"\<\\\\text{Purity / overlap}\>\"", ",", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<Purity\>\"", ",", "\"\<InitialOverlap\>\""}], "}"}]}], 
        ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\operatorname{Tr}\\\\rho_{AB}(t)^2\>\"", 
          ",", "\"\<\\\\operatorname{Tr}[\\\\rho_{AB}(0)\\\\rho_{AB}(t)]\>\""}\
], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<06_magnetizations\>\"", 
        ",", "\"\<\\\\text{Local edge magnetizations}\>\"", 
        ",", "\"\<\\\\langle\\\\sigma^z\\\\rangle=2\\\\langle S^z\\\\rangle\>\
\"", ",", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<MagnetizationA\>\"", ",", "\"\<MagnetizationB\>\""}], 
          "}"}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"\"\<\\\\langle\\\\sigma_1^z\\\\rangle\>\"", 
          ",", "\"\<\\\\langle\\\\sigma_L^z\\\\rangle\>\""}], "}"}]}], "]"}], 
      ";", "\n", " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<07_connected_correlations\>\"", 
        ",", "\"\<\\\\text{Connected edge correlations}\>\"", 
        ",", "\"\<\\\\langle\\\\sigma_1^k\\\\sigma_L^k\\\\rangle-\\\\langle\\\
\\sigma_1^k\\\\rangle\\\\langle\\\\sigma_L^k\\\\rangle\>\"", ",", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<ConnectedZZ\>\"", ",", "\"\<ConnectedXX\>\""}], 
          "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<k=z\>\"", ",", "\"\<k=x\>\""}], "}"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<08_density_validation\>\"", 
        ",", "\"\<\\\\text{Reduced-state numerical checks}\>\"", 
        ",", "\"\<\\\\text{Error / minimum eigenvalue}\>\"", ",", "\n", "  ", 
        RowBox[{
         RowBox[{
          RowBox[{"series", "[", 
           RowBox[{"records", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"{", 
          
          RowBox[{"\"\<TraceError\>\"", ",", "\"\<HermiticityError\>\"", 
           ",", "\"\<MinEigenvalue\>\""}], "}"}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"\"\<|\\\\operatorname{Tr}\\\\rho_{AB}-1|\>\"", 
          ",", "\"\<\\\\|\\\\rho_{AB}-\\\\rho_{AB}^\\\\dagger\\\\|_F\>\"", 
          ",", "\"\<\\\\lambda_{\\\\min}\>\""}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"add", "[", 
       RowBox[{"\"\<09_density_eigenvalues\>\"", 
        ",", "\"\<\\\\text{Edge-state eigenvalues}\>\"", 
        ",", "\"\<\\\\lambda_k(\\\\rho_{AB})\>\"", ",", "\n", "  ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
               RowBox[{
                RowBox[{"#", "[", "\"\<EigenvaluesAB\>\"", "]"}], "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}]}], "}"}], "&"}], " ", "/@",
             " ", "records"}], ")"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"\"\<\\\\lambda_\>\"", "<>", 
           RowBox[{"ToString", "[", "k", "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"labels", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"part", "==", "\"\<Abs\>\""}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<|\\\\rho_{A;01}|\>\"", 
              ",", "\"\<|\\\\rho_{B;01}|\>\""}], "}"}], ",", "\n", "  ", 
            RowBox[{"{", 
             RowBox[{
              
              RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
               "<>", "\"\<}\\\\rho_{A;01}\>\""}], ",", 
              
              RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
               "<>", "\"\<}\\\\rho_{B;01}\>\""}]}], "}"}]}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"add", "[", 
          RowBox[{
           RowBox[{"\"\<10_local_coherences_\>\"", "<>", "part"}], ",", 
           
           RowBox[{"\"\<\\\\text{Single-edge coherences: \>\"", "<>", "part", 
            "<>", "\"\<}\>\""}], ",", "\"\<\\\\rho_{Q;01}(t)\>\"", ",", "\n", 
           "   ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"matrixSeries", "[", 
              RowBox[{"records", ",", "key", ",", "1", ",", "2", ",", 
               RowBox[{"Switch", "[", 
                RowBox[{
                "part", ",", "\"\<Re\>\"", ",", "Re", ",", "\"\<Im\>\"", ",", 
                 "Im", ",", "\"\<Abs\>\"", ",", "Abs"}], " ", "]"}]}], "]"}], 
             ",", "\n", "    ", 
             RowBox[{"{", 
              RowBox[{"key", ",", 
               RowBox[{"{", 
                RowBox[{"\"\<RhoA\>\"", ",", "\"\<RhoB\>\""}], "}"}]}], 
              "}"}]}], "]"}], ",", "labels"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"part", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
           "}"}]}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"note", "=", 
       RowBox[{"\"\<t\\\\in[0,\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"time", "[", "\"\<tMax\>\"", "]"}], "]"}], 
        "<>", "\"\<];\\\\quad N_t=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "[", "records", " ", "]"}], "]"}], "<>", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"time", "[", "\"\<Grid\>\"", "]"}], 
           "==", "\"\<Linear\>\""}], ",", 
          RowBox[{"\"\<;\\\\quad \\\\delta t_{\\\\rm nominal}=\>\"", "<>", 
           RowBox[{"texNumber", "[", 
            RowBox[{"time", "[", "\"\<dt\>\"", "]"}], "]"}]}], ",", "\n", 
          "   ", "\"\<;\\\\quad \\\\text{logarithmic sampling}\>\""}], 
         "]"}]}]}], ";", "\n", " ", 
      RowBox[{"Association", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"data", "=", 
           RowBox[{"If", "[", 
            RowBox[{"log", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"#", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&"}]}], 
                "]"}], "&"}], " ", "/@", " ", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "4", "]"}], "]"}]}], ",", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"styles", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ColorData", "[", "97", "]"}], "[", "k", "]"}], ",", 
               RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"g", "=", 
           RowBox[{"framePlot", "[", 
            RowBox[{"data", ",", "\"\<t\\\\quad(\\\\hbar=1)\>\"", ",", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "3", "]"}], "]"}], ",", "styles", ",", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "5", "]"}], "]"}], ",", "True", ",", "log"}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{
            RowBox[{"spec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<>", 
            RowBox[{"If", "[", 
             RowBox[{"log", ",", "\"\<_logtime\>\"", ",", "\"\<\>\""}], 
             "]"}]}], "->", 
           RowBox[{"plotPanel", "[", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}], ",", "\n", "   ", 
             RowBox[{"caption", "[", 
              RowBox[{"p", ",", 
               RowBox[{"\"\<\\\\Delta=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}]}], ",", 
               "note"}], "]"}], ",", "g"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"spec", ",", "specs"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"eb7295e2-a606-534b-85a6-\
231726d28927"]
