                 ",", "l"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}],
                ",", "\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "]"}], "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"sx", " ", ".", " ", "sx"}], "+", 
               RowBox[{"sy", " ", ".", " ", "sy"}], "+", 
               RowBox[{"sz", " ", ".", " ", "sz"}]}], ")"}]}]}], "]"}]}]}], 
        "]"}], ";", "\n", " ", "out"}]}], "\n", "]"}]}], ";"}]}]], "Input",Exp\
