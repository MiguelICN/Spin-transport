Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Check", " ", "basis", " ", "completeness"}], ",", " ", 
    RowBox[{
    "invariance", " ", "of", " ", "BOTH", " ", "Hamiltonian", " ", "parts"}], 
    ",", " ", 
    RowBox[{"and", " ", 
     RowBox[{"labels", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeSetupAudit", "[", 
     RowBox[{"setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "groups", ",", "ids", ",", "other", ",", "b", ",", "all", ",", "hm", ",",
         "a", ",", "q", ",", "bits", ",", 
        RowBox[{"dim", "=", "0"}], ",", "\n", "  ", 
        RowBox[{"basisError", "=", "0."}], ",", 
        RowBox[{"blockLeak", "=", "0."}], ",", 
        RowBox[{"spaceLeak", "=", "0."}], ",", 
        RowBox[{"labelError", "=", "0."}], ",", "parts", ",", "scale"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"parts", "=", 
        RowBox[{"Values", "[", 
         RowBox[{"KeyTake", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Bulk\>\"", ",", 
             RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}]}], "}"}]}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Indices\>\"", "]"}], "&"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"all", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", "\"\<Indices\>\"", "]"}], 
           "&"}], " ", "/@", " ", "groups"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", "all", "]"}], "===", 
          RowBox[{"Range", "[", 
           RowBox[{"2", "^", "l"}], "]"}]}], 
         ",", "\"\<Sector index blocks are not a disjoint complete partition.\
\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"charges", "[", "p", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<RF\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
           RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"{", "\n", "  ", 
          RowBox[{
           RowBox[{"\"\<m\>\"", "->", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Band", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"l", "/", "2"}], "-", 
                 RowBox[{"(", 
                  RowBox[{"Total", " ", "/@", " ", "bits"}], ")"}]}], ")"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", "^", "l"}], ",", 
                RowBox[{"2", "^", "l"}]}], "}"}]}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<sA\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "1", ",",
               "l"}], "]"}]}], ",", 
           RowBox[{"\"\<sB\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "l", ",",
               "l"}], "]"}]}]}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<mBulk\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<m\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sA\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sB\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{
            RowBox[{"First", "[", "group", "]"}], "[", "\"\<Indices\>\"", 
            "]"}]}], ";", 
          RowBox[{"other", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", "l"}], "]"}], ",", "ids"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"b", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Join", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"#", "[", "\"\<Basis\>\"", "]"}], "]"}], "&"}], " ", 
               "/@", " ", "group"}], ")"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "b", "]"}], "==", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "[", "ids", "]"}], ",", 
               RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], 
            ",", "\"\<A block has an incomplete symmetry basis.\>\""}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"basisError", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"basisError", ",", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
                "b"}], "-", 
               RowBox[{"id", "[", 
                RowBox[{"Length", "[", "ids", "]"}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"dim", "+=", 
           RowBox[{
            RowBox[{"Dimensions", "[", "b", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"scale", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Norm", "[", 
                 RowBox[{"part", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
             "\n", "   ", 
             RowBox[{"blockLeak", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"blockLeak", ",", 
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{"part", "[", 
                   RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "/", 
                 "scale"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"hm", "=", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"part", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
              "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "=", 
                 RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
                RowBox[{"a", "=", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                  " ", "hm", " ", ".", " ", "b"}]}], ";", "\n", "    ", 
                RowBox[{"spaceLeak", "=", 
                 RowBox[{"Max", "[", 
                  RowBox[{"spaceLeak", ",", 
                   RowBox[{
                    RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{"hm", " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "/", 
                    "scale"}]}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"part", ",", "parts"}], "}"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"labelError", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{"labelError", ",", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], ",", 
                  "\n", "     ", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], " ", ".", " ", 
                    "b"}], "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "[", "name", 
                    "]"}], " ", "b"}]}], "]"}]}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"{", 
                RowBox[{"name", ",", 
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"Keys", "[", "q", "]"}], ",", 
                   RowBox[{"Keys", "[", 
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                  "]"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dim", "==", 
           RowBox[{"2", "^", "l"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
            "basisError", ",", "blockLeak", ",", "spaceLeak", ",", 
             "labelError"}], "]"}], "<", 
           RowBox[{"100", " ", "tol"}]}]}], ",", "\n", 
         "  ", "\"\<Edge-sector completeness, invariance, or charge-label \
audit failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<DimensionSum\>\"", "->", "dim"}], ",", 
         RowBox[{"\"\<ExpectedDimension\>\"", "->", 
          RowBox[{"2", "^", "l"}]}], ",", 
         RowBox[{"\"\<BasisError\>\"", "->", "basisError"}], ",", "\n", "  ", 
         RowBox[{"\"\<IndexBlockLeakage\>\"", "->", "blockLeak"}], ",", 
         RowBox[{"\"\<SectorLeakage\>\"", "->", "spaceLeak"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<ChargeLabelError\>\"", "->", "labelError"}], ",", 
         RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",ExpressionUUID->"c9b0681b-e2f8-1a4d-b7a4-\
7271b8399a59"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Also", " ", "protect", " ", "direct", " ", "calls", " ", "if", " ", "a", " ",
     "cached", " ", "setup", " ", "has", " ", "been", " ", 
    RowBox[{"modified", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeIndexCheck", "[", 
     RowBox[{"h_", ",", "setup_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"groups", ",", "map", ",", "rules", ",", "off", ",", "scale"}],
        "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"groups", "=", 
        RowBox[{"DeleteDuplicates", "[", 
         RowBox[{"Lookup", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}], 
           ",", "\"\<Indices\>\""}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"map", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"2", "^", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}], 
            "[", "\"\<L\>\"", "]"}]}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"map", "[", 
               RowBox[{"[", 
                RowBox[{"groups", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", "==", "0"}], "&"}]}], "]"}], 
            ",", "\"\<Computational index blocks overlap.\>\""}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{
           RowBox[{"map", "[", 
            RowBox[{"[", 
             RowBox[{"groups", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "=", "k"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "groups", "]"}]}], "}"}]}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"FreeQ", "[", 
          RowBox[{"map", ",", "0"}], "]"}], 
         ",", "\"\<Computational index blocks are incomplete.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"rules", "=", 
        RowBox[{"Most", "[", 
         RowBox[{"ArrayRules", "[", 
          RowBox[{"SparseArray", "[", "h", "]"}], "]"}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"off", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"rules", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"map", "[", 
             RowBox[{"[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "!=", 
            RowBox[{"map", "[", 
             RowBox[{"[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], 
           "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"off", "===", 
           RowBox[{"{", "}"}]}], " ", "||", " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Last", " ", "/@", " ", "off"}], "]"}], "]"}], "<=", 
           RowBox[{"tol", " ", "scale"}]}]}], ",", "\n", 
         "  ", "\"\<H mixes the fixed computational index blocks (including \
fixed edge Sz in ZZ). This ED would discard terms.\>\""}], "]"}], ";", "\n", 
       " ", "True"}]}], "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->\
"9b6e1aa5-0e66-7249-b656-51237aaa9420"],

