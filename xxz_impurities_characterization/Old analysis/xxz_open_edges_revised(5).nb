           RowBox[{"ed", "[", "\"\<EndpointRefinement\>\"", "]"}]}]}], 
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Kernels", " ", "are", " ", "reused"}], ";", " ", 
