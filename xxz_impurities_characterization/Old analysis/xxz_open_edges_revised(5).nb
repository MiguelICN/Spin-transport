            RowBox[{"2", "^", 
             RowBox[{
              RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"",
               "]"}]}]}], " ", "&&", "\n", "   ", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
