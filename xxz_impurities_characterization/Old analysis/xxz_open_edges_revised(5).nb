Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sgStatistics", "[", 
     RowBox[{"energies_List", ",", "cfg_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "["}]}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"e", "=", 
      RowBox[{"Sort", "[", "energies", "]"}]}], ",", "d", ",", "lo", ",", 
     "hi", ",", "w", ",", "gaps", ",", "pairs", ",", "cut", ",", "ratios", ",",
      "status", ",", "valid", ",", "n", ",", "blocks", ",", "bs", ","}]}], 
   "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"  ", 
     RowBox[{
      RowBox[{"iid", "=", 
       RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], ",", 
      RowBox[{"bse", "=", 
       RowBox[{"Missing", "[", "\"\<TooFewBlocks\>\"", "]"}]}], ",", 
      RowBox[{"nb", "=", "0"}], ",", 
      RowBox[{"used", "=", "0"}]}], "}"}], ","}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"d", "=", 
     RowBox[{"Length", "[", "e", "]"}]}], ";", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lo", ",", "hi"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", "1"}]}], 
        "]"}], ","}]}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"   ", 
     RowBox[{"Min", "[", 
      RowBox[{"d", ",", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}], "}"}], 
    ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"w", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"hi", ">=", "lo"}], ",", 
       RowBox[{"e", "[", 
        RowBox[{"[", 
         RowBox[{"lo", ";;", "hi"}], "]"}], "]"}], ",", 
       RowBox[{"{", "}"}]}], "]"}]}], ";", 
    RowBox[{"gaps", "=", 
     RowBox[{"Differences", "[", "w", "]"}]}], ";", 
    RowBox[{"pairs", "=", 
     RowBox[{"Partition", "[", 
      RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"cut", "=", 
     RowBox[{
      RowBox[{"cfg", "[", "\"\<GapResolution\>\"", "]"}], " ", 
      RowBox[{"Max", "[", 
       RowBox[{"1", ",", 
        RowBox[{"sgMax", "[", "e", "]"}]}], "]"}]}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"ratios", "=", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", "#", "]"}], "<=", "cut"}], ",", 
          RowBox[{"Missing", "[", "\"\<UnresolvedGapPair\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"Min", "[", "#", "]"}], "/", 
           RowBox[{"Max", "[", "#", "]"}]}]}], "]"}], "&"}], " ", "/@", " ", 
       "pairs"}], ")"}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Length", "[", "ratios", "]"}]}], ";", 
    RowBox[{"status", "=", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", "w", "]"}], "<", "3"}], 
       ",", "\"\<TooFewLevels\>\"", ","}]}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"   ", 
     RowBox[{
      RowBox[{
       RowBox[{"Count", "[", 
        RowBox[{"ratios", ",", "_Missing"}], "]"}], ">", "0"}], 
      ",", "\"\<UnresolvedGaps\>\"", ",", "True", ",", "\"\<OK\>\""}], "]"}], 
    ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"status", "==", "\"\<OK\>\""}], " ", "&&", " ", 
       RowBox[{"n", ">=", "2"}]}], ",", 
      RowBox[{"iid", "=", 
       RowBox[{
        RowBox[{"StandardDeviation", "[", "ratios", "]"}], "/", 
        RowBox[{"Sqrt", "[", "n", "]"}]}]}]}], "]"}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"bs", "=", 
     RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}]}], ";"}], "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
     RowBox[{
      RowBox[{"blocks", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"ratios", ",", "bs"}], "]"}]}], ";", 
      RowBox[{"nb", "=", 
       RowBox[{"Length", "[", "blocks", "]"}]}], ";", 
      RowBox[{"used", "=", 
       RowBox[{"nb", " ", "bs"}]}], ";"}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"   ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"nb", ">=", "4"}], ",", 
       RowBox[{"bse", "=", 
        RowBox[{
         RowBox[{"StandardDeviation", "[", 
          RowBox[{"Mean", " ", "/@", " ", "blocks"}], "]"}], "/", 
         RowBox[{"Sqrt", "[", "nb", "]"}]}]}]}], "]"}], "]"}], ";"}], "*)"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<SectorDimension\>\"", "->", "d"}], ",", 
     RowBox[{"\"\<WindowRanks\>\"", "->", 
      RowBox[{"{", 
       RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
     RowBox[{"\"\<WindowLevels\>\"", "->", 
      RowBox[{"Length", "[", "w", "]"}]}], ","}]}], "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<GapPairs\>\"", "->", "n"}], ",", 
    RowBox[{"\"\<UnresolvedGaps\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{"gaps", ",", 
       RowBox[{"x_", "/;", 
        RowBox[{"x", "<=", "cut"}]}]}], "]"}]}], ","}], "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<UnresolvedGapPairs\>\"", "->", 
     RowBox[{"Count", "[", 
      RowBox[{"ratios", ",", "_Missing"}], "]"}]}], ",", 
    RowBox[{"\"\<GapResolution\>\"", "->", "cut"}], ","}], "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<Ratios\>\"", "->", "ratios"}], ",", 
    RowBox[{"\"\<MeanR\>\"", "->", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
       RowBox[{"Mean", "[", "ratios", "]"}], ",", 
       RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ","}], "*)"}], 
  "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<IIDSEM\>\"", "->", "iid"}], ",", 
    RowBox[{"\"\<BlockSEM\>\"", "->", "bse"}], ",", 
    RowBox[{"\"\<BlockLength\>\"", "->", "bs"}], ",", 
    RowBox[{"\"\<Blocks\>\"", "->", "nb"}], ","}], "*)"}], "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<BlockRatiosUsed\>\"", "->", "used"}], ",", 
    RowBox[{"\"\<BlockTailRatios\>\"", "->", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
       RowBox[{"n", "-", "used"}], ",", 
       RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ","}], "*)"}], 
  "\n", 
  RowBox[{"(*", "  ", 
   RowBox[{
    RowBox[{"\"\<FractionRBelow005\>\"", "->", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Count", "[", 
          RowBox[{"ratios", ",", 
           RowBox[{"x_", "/;", 
            RowBox[{"x", "<", 
             RowBox[{"1", "/", "20"}]}]}]}], "]"}], "/", "n"}], "]"}], ",", 
       RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ","}], "*)"}], 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"  ", 
    RowBox[{
     RowBox[{"\"\<MeanSpacing\>\"", "->", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "gaps", "]"}], ">", "0"}], ",", 
        RowBox[{"Mean", "[", "gaps", "]"}], ",", 
        RowBox[{"Missing", "[", "\"\<NoGaps\>\"", "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Status\>\"", "->", "status"}]}], "|>"}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{"]", ";"}], "*)"}]}]], "Code",ExpressionUUID->"4f73e3d7-3c38-7248-\
95b5-69468bea3424"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgPoint", "[", 
    RowBox[{"g_", ",", "setup_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "e", ",", "scale", ",", "im", ",", "traceErr", ",", 
       "momentErr", ",", "stats", ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}]}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
              "[", "\"\<BulkXY\>\"", "]"}], "+", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], " ", 
              RowBox[{
               RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
               "[", "\"\<BulkZZ\>\"", "]"}]}]}], ")"}]}], "+", "\n", "   ", 
          RowBox[{"g", " ", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
            "[", "\"\<EdgeXY\>\"", "]"}]}]}], ",", "wp"}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"e", "=", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"Normal", "[", "h", "]"}], "]"}]}], ";", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{"sgMax", "[", "h", "]"}], ",", 
         RowBox[{"sgMax", "[", "e", "]"}]}], "]"}]}], ";", 
      RowBox[{"im", "=", 
       RowBox[{"sgMax", "[", 
        RowBox[{"Im", "[", "e", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"e", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "e", "]"}], "==", 
          RowBox[{"setup", "[", "\"\<Dimension\>\"", "]"}]}], " ", "&&", " ", 
         RowBox[{"im", "<", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}], " ", 
           "scale"}]}]}], ",", "\n", 
        "  ", "\"\<Target-sector eigenvalue count or reality check \
failed.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"e", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"traceErr", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Total", "[", "e", "]"}], "-", 
          RowBox[{"Tr", "[", "h", "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "e", "]"}], " ", "scale"}]}], "]"}]}]}], ";",
       "\n", " ", 
      RowBox[{"momentErr", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"e", "^", "2"}], "]"}], "-", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"h", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], "^", 
            "2"}], "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"h", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], "^", 
            "2"}], "]"}]}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"traceErr", ",", "momentErr"}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Spectral trace/moment check failed.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"stats", "=", 
       RowBox[{"sgStatistics", "[", 
        RowBox[{"e", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"g", "==", "0"}], "]"}], ",", 
        RowBox[{"stats", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"stats", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Status\>\"", "->", "\"\<DecoupledEndpoint\>\""}], ",",
              "\n", "   ", 
             RowBox[{"\"\<MeanR\>\"", "->", 
              RowBox[{
              "Missing", "[", "\"\<EndpointHasAdditionalSymmetries\>\"", 
               "]"}]}], ",", 
             RowBox[{"\"\<IIDSEM\>\"", "->", 
              RowBox[{"Missing", "[", "\"\<Endpoint\>\"", "]"}]}], ",", 
             RowBox[{"\"\<BlockSEM\>\"", "->", 
              RowBox[{"Missing", "[", "\"\<Endpoint\>\"", "]"}]}]}], "|>"}]}],
           "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<L\>\"", "->", 
           RowBox[{"setup", "[", "\"\<L\>\"", "]"}]}], ",", 
          RowBox[{"\"\<J\>\"", "->", 
           RowBox[{"cfg", "[", "\"\<J\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Delta\>\"", "->", 
           RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}]}], ",", 
          RowBox[{"\"\<g\>\"", "->", "g"}], ",", "\n", "   ", 
          RowBox[{"\"\<gOverAbsJ\>\"", "->", 
           RowBox[{"g", "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], "]"}]}]}], ",", 
          RowBox[{"\"\<Labels\>\"", "->", 
           RowBox[{"setup", "[", "\"\<Labels\>\"", "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<Regime\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], "==", "0"}], "]"}],
              ",", "\"\<FreeFermionControl\>\"", ",", "\"\<Interacting\>\""}],
             "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<AnisotropyClass\>\"", "->", 
           RowBox[{"sgAnisotropyInfo", "[", 
            RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], "]"}]}], ",", "\n", 
          "   ", 
          RowBox[{"\"\<RelativeTraceError\>\"", "->", "traceErr"}], ",", 
          RowBox[{"\"\<RelativeSecondMomentError\>\"", "->", "momentErr"}]}], 
         "|>"}], ",", "stats", ",", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"cfg", "[", "\"\<StoreEnergies\>\"", "]"}], "]"}], ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Energies\>\"", "->", "e"}], "|>"}], ",", 
          RowBox[{"<|", "|>"}]}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"71cbbe79-6793-9b44-b9b5-853509065378"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgValidate", "[", "cfg_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ls", "=", 
        RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ",", 
       "labs"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", "cfg", "]"}], "]"}], "===", 
         RowBox[{"Sort", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Sector\>\"", ",", "\"\<LValues\>\"", ",", "\"\<J\>\"",
             ",", "\"\<Delta\>\"", ",", "\"\<Grid\>\"", ",", "\"\<gMin\>\"", 
            ",", "\"\<gMax\>\"", ",", "\"\<gPoints\>\"", ",", "\n", 
            "   ", "\"\<MinimumDimension\>\"", ",", "\"\<RankWindow\>\"", 
            ",", "\"\<GapResolution\>\"", ",", "\"\<ValidationTolerance\>\"", 
            ",", "\"\<WorkingPrecision\>\"", ",", "\"\<BlockLength\>\"", 
            ",", "\"\<StoreEnergies\>\""}], "}"}], "]"}]}], ",", "\n", 
        "  ", "\"\<Configuration keys are incomplete or unknown. This chapter \
implements equal XY edges and zero fields only.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "ls", "]"}], " ", "&&", " ", 
         RowBox[{"ls", "=!=", 
          RowBox[{"{", "}"}]}], " ", "&&", " ", 
         RowBox[{"DuplicateFreeQ", "[", "ls", "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"ls", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{"#", ">=", "4"}]}], "&"}]}], "]"}]}], ",", "\n", 
        "  ", "\"\<LValues must be a nonempty list of distinct integers \
>=4.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{"ls", ",", "2"}], "]"}], "]"}], "]"}], "==", "1"}], 
        ",", "\"\<Use separate size scans for even and odd L.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<gMin\>\"", 
               ",", "\"\<gMax\>\""}], "}"}]}], "]"}], ",", "sgRealQ"}], "]"}],
          " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], "!=", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}]}]}], ",", "\n", 
        "  ", "\"\<J, Delta and g endpoints must be real, J nonzero, and \
gMin<gMax.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}], ",", 
           RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], ">=", "2"}]}], ",", 
        "\n", "  ", "\"\<Choose Linear/Log and at least two gPoints.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Log\>\""}], ",", 
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ">", "0"}], 
          ",", "\"\<A logarithmic g scan requires gMin>0; zero is a separate \
endpoint.\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"wp", "===", "MachinePrecision"}], " ", "||", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IntegerQ", "[", "wp", "]"}], " ", "&&", " ", 
           RowBox[{"wp", ">=", "20"}]}], ")"}]}], 
        ",", "\"\<WorkingPrecision must be MachinePrecision or an integer \
>=20.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"wp", "=!=", "MachinePrecision"}], ",", 
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"cfg", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<gMin\>\"",
                 ",", "\"\<gMax\>\""}], "}"}]}], "]"}], ",", 
            RowBox[{"_", "?", "MachineNumberQ"}]}], "]"}], ",", "\n", 
          "   ", "\"\<For high precision use exact or genuinely \
high-precision parameters, not machine decimals.\>\""}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", "sgRealQ"}], 
          "]"}], " ", "&&", "\n", "   ", 
         RowBox[{"0", "<=", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}]}], 
        ",", "\"\<Invalid fractional rank window.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<GapResolution\>\"", 
               ",", "\"\<ValidationTolerance\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"sgRealQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{"#", ">", "0"}]}], "&"}]}], "]"}], " ", "&&", "\n", 
         "   ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}], ">=", "2"}], " ", 
         "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}], "]"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}], ">=", 
          "1"}]}], ",", "\n", 
        "   ", "\"\<Invalid tolerances, block length, or minimum dimension.\>\
\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"True", ",", "False"}], "}"}], ",", 
          RowBox[{"cfg", "[", "\"\<StoreEnergies\>\"", "]"}]}], "]"}], 
        ",", "\"\<StoreEnergies must be True or False.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"labs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sgLabels", "[", 
          RowBox[{"#", ",", 
           RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}], "&"}], " ", "/@",
         " ", "ls"}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"SameQ", "@@", "labs"}], 
        ",", "\"\<Automatic selected different labels across L; choose a \
fixed sector or separate size families.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sgDimension", "[", 
            RowBox[{"l", ",", 
             RowBox[{"labs", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ">=", 
           RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}]}], ",", "\n",
           "   ", 
          RowBox[{"\"\<Selected sector is below MinimumDimension at L=\>\"", "<>", 
           RowBox[{"ToString", "[", "l", "]"}], 
           "<>", "\"\<. Increase L or explicitly lower the minimum.\>\""}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ls"}], "}"}]}], "]"}], ";", "\n", " ", "cfg"}]}], 
    "\n", "]"}]}], ";"}]], "Input",ExpressionUUID->"76d3e71d-60ab-1f42-97b9-\
16936751195a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgGrid", "[", "cfg_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}]}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"sgValidate", "[", "cfg", "]"}], ";", "\n", " ", 
      RowBox[{"t", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Linear\>\""}],
          ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", 
             RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "-", "1"}]}], 
            "]"}], ",", "wp"}], "]"}], ",", "\n", "   ", 
         RowBox[{"Exp", "[", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "wp"}], "]"}], 
             "]"}], ",", 
            RowBox[{"Log", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "wp"}], "]"}], 
             "]"}], ",", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "-", "1"}]}], 
           "]"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"t", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"t", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "wp"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Differences", "[", "t", "]"}], ">", "0"}], "]"}]}], 
        ",", "\"\<Grid is not distinct at this working precision.\>\""}], 
       "]"}], ";", "t"}]}], "\n", "]"}]}], ";"}]], "Input",ExpressionUUID->\
"dd53f0df-140a-4e45-9def-4740886f1cce"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Sizes", " ", "run", " ", "sequentially"}], ";", " ", 
    RowBox[{
    "only", " ", "one", " ", "selected", " ", "block", " ", "and", " ", "its",
      " ", "temporary", " ", "dense", " ", "eigensolver", " ", "are", " ", 
     RowBox[{"resident", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sgScan", "[", 
     RowBox[{"cfg_Association", ",", "grid_List"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"setup", ",", 
        RowBox[{"rows", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"audits", "=", 
         RowBox[{"{", "}"}]}], ",", "elapsed", ",", "part", ",", "labels"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"sgValidate", "[", "cfg", "]"}], ";", 
       RowBox[{"sgCheck", "[", 
        RowBox[{
         RowBox[{"grid", "===", 
          RowBox[{"sgGrid", "[", "cfg", "]"}]}], 
         ",", "\"\<Grid and settings disagree; rebuild the grid.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"elapsed", "=", 
        RowBox[{"First", "[", 
         RowBox[{"AbsoluteTiming", "[", 
          RowBox[{
           RowBox[{"Do", "[", "\n", "   ", 
            RowBox[{
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Building L=\>\"", ",", "l", 
                ",", "\"\<; sector \>\"", ",", 
                RowBox[{"sgLabels", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}], 
                ",", "\"\<; D=\>\"", ",", 
                RowBox[{"sgDimension", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"sgLabels", "[", 
                   RowBox[{"l", ",", 
                    RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}]}], 
                 "]"}]}], "]"}], ";", "\n", "   ", 
              RowBox[{"setup", "=", 
               RowBox[{"sgSetup", "[", 
                RowBox[{"l", ",", 
                 RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}], ",", 
                 RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}], ",", 
                 RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
                "]"}]}], ";", "\n", "   ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"audits", ",", 
                RowBox[{"KeyDrop", "[", 
                 RowBox[{"setup", ",", 
                  RowBox[{"{", "\"\<Parts\>\"", "}"}]}], "]"}]}], "]"}], ";", 
              "\n", "   ", 
              RowBox[{"part", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"sgPoint", "[", 
                  RowBox[{"g", ",", "setup", ",", "cfg"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"g", ",", "grid"}], "}"}]}], "]"}]}], ";", 
              RowBox[{"rows", "=", 
               RowBox[{"Join", "[", 
                RowBox[{"rows", ",", "part"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", 
               RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], "}"}]}], "]"}],
            ";", "Null"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
         RowBox[{"\"\<gGrid\>\"", "->", "grid"}], ",", 
         RowBox[{"\"\<Setups\>\"", "->", "audits"}], ",", 
         RowBox[{"\"\<Seconds\>\"", "->", "elapsed"}], ",", 
         RowBox[{"\"\<Results\>\"", "->", "rows"}], ",", "\n", "  ", 
         RowBox[{"\"\<Notes\>\"", 
          "->", "\"\<Equal XY end bonds; zero fields; full eigenvalue list of \
one selected sector only. Error bars are descriptive estimates, not \
calibrated confidence intervals.\>\""}]}], "|>"}]}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",ExpressionUUID->"c3754c6d-1448-d944-a63b-805ea38e3816"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sgPlot", "[", 
    RowBox[{"run_Association", ",", "style_Association"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cfg", "=", 
        RowBox[{"run", "[", "\"\<Settings\>\"", "]"}]}], ",", 
       RowBox[{"rows", "=", 
        RowBox[{"run", "[", "\"\<Results\>\"", "]"}]}], ",", "valid", ",", 
       "data", ",", "labels", ",", "colors", ",", 
       RowBox[{"err", "=", 
        RowBox[{"style", "[", "\"\<ErrorBar\>\"", "]"}]}], ",", "\n", "  ", 
       "cap", ",", "xlab", ",", "ylab", ",", 
       RowBox[{"latex", "=", "False"}], ",", "gplot", ",", "labs", ",", 
       "excluded"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", "\"\<IIDSEM\>\"", ",", "\"\<BlockSEM\>\""}], 
           "}"}], ",", "err"}], "]"}], 
        ",", "\"\<ErrorBar must be None, IIDSEM or BlockSEM.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sgRealQ", "[", 
          RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], "]"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<MarkerSize must be positive.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"style", "[", "\"\<UseMaTeX\>\"", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ",", "Null"}], 
           "]"}], "]"}], ";", "\n", "  ", 
         RowBox[{"latex", "=", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"DownValues", "[", "MaTeX`MaTeX", "]"}], "]"}], ">", 
           "0"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"xlab", "=", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<g / |J|\>\"", ",", "15"}], "]"}]}], ";", 
      RowBox[{"ylab", "=", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Mean adjacent-gap ratio\>\"", ",", "15"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{"latex", ",", 
        RowBox[{
         RowBox[{"xlab", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"\"\<g/|J|\>\"", ",", 
               RowBox[{"Magnification", "->", "1.2"}]}], "]"}], ",", "xlab"}],
             "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"ylab", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"\"\<\\\\langle\\\\tilde r\\\\rangle\>\"", ",", 
               RowBox[{"Magnification", "->", "1.2"}]}], "]"}], ",", "ylab"}],
             "]"}], "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"valid", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"rows", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<L\>\"", "]"}], "==", "l"}], " ", "&&", 
               " ", 
               RowBox[{"NumericQ", "[", 
                RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], "]"}]}], "&"}]}], 
            "]"}]}], ";", "\n", "   ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", "\"\<gOverAbsJ\>\"", "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"err", "=!=", "None"}], " ", "&&", " ", 
                  RowBox[{"NumericQ", "[", 
                   RowBox[{"#", "[", "err", "]"}], "]"}]}], ",", 
                 RowBox[{"Around", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], ",", 
                   RowBox[{"#", "[", "err", "]"}]}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}]}], "]"}]}], "}"}], 
             "&"}], " ", "/@", " ", "valid"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", 
           RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], "}"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"labels", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<L=\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\"\<; D=\>\"",
            "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", "\"\<Dimension\>\"", "]"}], "]"}]}], "&"}], " ",
          "/@", " ", 
         RowBox[{"run", "[", "\"\<Setups\>\"", "]"}]}], ")"}]}], ";", "\n", 
      " ", 
      RowBox[{"colors", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "k", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"labs", "=", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"run", "[", "\"\<Setups\>\"", "]"}], "]"}], 
        "[", "\"\<Labels\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"excluded", "=", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"rows", ",", "\"\<MeanR\>\""}], "]"}], ",", "_Missing"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"cap", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Equal XY edge bonds; J=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<; Delta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], ",", "InputForm"}], 
             "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<Sector \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"labs", ",", "InputForm"}], "]"}], 
            "<>", "\"\<; rank window \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", 
              "InputForm"}], "]"}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], 
            "<>", "\"\< grid; g in [\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<, \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<]; points=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "]"}]}], ",", "\n",
            "  ", "\"\<Poisson: 0.386294; GOE: approximately 0.5307\>\"", ",",
            "\n", "  ", 
           RowBox[{"\"\<Error bars: \>\"", "<>", 
            RowBox[{"ToString", "[", "err", "]"}], 
            "<>", "\"\< (diagnostic); omitted means: \>\"", "<>", 
            RowBox[{"ToString", "[", "excluded", "]"}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"sgAnisotropyInfo", "[", 
             RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], "]"}], "<>", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"sgAnisotropyInfo", "[", 
                RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], "]"}], 
               "==", "\"\<SpecialBulkDegeneracyControl\>\""}], ",", "\n", 
              "   ", "\"\<: compare away from +/-1/2 before interpreting \
weak-g statistics.\>\"", ",", "\"\<\>\""}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"gplot", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"Joined", "->", "False"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"#", ",", 
               RowBox[{"AbsolutePointSize", "[", 
                RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], "]"}]}], 
              "]"}], "&"}], " ", "/@", " ", "colors"}], ")"}]}], ",", "\n", 
         "  ", 
         RowBox[{"IntervalMarkers", "->", "\"\<Bars\>\""}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"xlab", ",", "ylab"}], "}"}]}], ",", "\n", "  ", 
         RowBox[{"ScalingFunctions", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Log\>\""}],
             ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Log\>\"", ",", "None"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"None", ",", "None"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"style", "[", "\"\<ImageSize\>\"", "]"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"PointLegend", "[", 
             RowBox[{"colors", ",", "labels"}], "]"}], ",", "Right"}], 
           "]"}]}], ",", 
         RowBox[{"PlotLabel", "->", "cap"}]}], "]"}]}], ";", "\n", " ", 
      "gplot"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sgBaseFolder", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}]}], "Input",Expr\
essionUUID->"912fcf94-1de3-ba48-9f05-3410114e7eb3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgExport", "[", 
    RowBox[{
    "run_Association", ",", "plot_", ",", "style_Association", ",", 
     "root_String", ",", "label_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dir", ",", 
       RowBox[{"k", "=", "1"}], ",", "stem", ",", "files"}], "}"}], ",", "\n",
      " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DirectoryQ", "[", "root", "]"}], " ", "||", " ", 
         RowBox[{"StringQ", "[", 
          RowBox[{"CreateDirectory", "[", 
           RowBox[{"root", ",", 
            RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], 
          "]"}]}], ",", "\"\<Cannot create output root.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"stem", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"label", ",", 
         RowBox[{
          RowBox[{"Except", "[", 
           RowBox[{
           "LetterCharacter", "|", "DigitCharacter", "|", "\"\<_\>\"", 
            "|", "\"\<-\>\""}], "]"}], "->", "\"\<_\>\""}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"dir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", "stem"}], "}"}], "]"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"FileExistsQ", "[", "dir", "]"}], ",", 
        RowBox[{
         RowBox[{"k", "++"}], ";", 
         RowBox[{"dir", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"root", ",", 
             RowBox[{"stem", "<>", "\"\<_\>\"", "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}]}], "}"}], "]"}]}]}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"CreateDirectory", "[", "dir", "]"}], ";", "\n", " ", 
      RowBox[{"files", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<gap_ratios.wxf\>\""}], "}"}], "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{"run", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<PlotSettings\>\"", "->", "style"}], "|>"}]}], 
            "]"}], ",", "\"\<WXF\>\""}], "]"}], ",", "\n", "  ", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<gap_ratios.png\>\""}], "}"}], "]"}], ",",
            "plot", ",", "\"\<PNG\>\"", ",", 
           RowBox[{"ImageResolution", "->", "150"}]}], "]"}], ",", "\n", "  ", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"run", "[", "\"\<Settings\>\"", "]"}], ",", 
              "InputForm"}], "]"}], 
            "<>", "\"\<\\nError bars are descriptive; no first-crossing \
estimator is fitted.\>\""}], ",", "\"\<Text\>\""}], "]"}]}], "}"}]}], ";", 
      "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"files", ",", "StringQ"}], "]"}], 
        ",", "\"\<One or more exports failed.\>\""}], "]"}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Saved: \>\"", ",", "dir"}], "]"}], ";", "dir"}]}], "\n", 
    "]"}]}], ";"}]], "Input",ExpressionUUID->"249adab3-53ef-7444-8d42-\
be19b7bd4911"]
}, Closed]],

Cell[CellGroupData[{

Cell["13.3. Independent linear g grid: editable parameters", "Subsection",ExpressionUUID->"413e80b1-9df9-f24d-96a2-abc0efffbbdc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sgLinConfig", "=", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Sector\>\"", "->", "Automatic"}], ",", "  ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Or", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<m\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<F\>\"", "->", "1"}]}], "|>"}]}], ",", " ", 
       RowBox[{"or", " ", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<m\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<R\>\"", "->", 
            RowBox[{"-", "1"}]}]}], "|>"}], "."}]}]}], " ", "*)"}], "\n", " ", 
     RowBox[{"\"\<LValues\>\"", "->", 
      RowBox[{"{", "14", "}"}]}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", 
      RowBox[{"9", "/", "20"}]}], ",", "\n", " ", 
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<gMin\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<gMax\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<gPoints\>\"", "->", "100"}], ",", "\n", " ", 
     RowBox[{"\"\<MinimumDimension\>\"", "->", "400"}], ",", 
     RowBox[{"\"\<RankWindow\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], ",", "\n", " ", 
     RowBox[{"\"\<GapResolution\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<WorkingPrecision\>\"", "->", "MachinePrecision"}], ",", 
     RowBox[{"\"\<BlockLength\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<StoreEnergies\>\"", "->", "True"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinStyle", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
     RowBox[{"\"\<ErrorBar\>\"", "->", "\"\<BlockSEM\>\""}], ",", 
     RowBox[{"\"\<ImageSize\>\"", "->", "1100"}], ",", 
     RowBox[{"\"\<UseMaTeX\>\"", "->", "True"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinOutputRoot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"sgBaseFolder", "[", "]"}], 
      ",", "\"\<xxz_selected_sector_results\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinRunLabel", "=", "\"\<Linear_g\>\""}], ";"}]}], "Input",Express\
ionUUID->"e77dcaa9-e10b-bb42-9c37-cb0914e6b2b9"],

Cell[CellGroupData[{

Cell["13.3.1 Generate the grid and inspect exact sector sizes", \
"Subsubsection",ExpressionUUID->"f0b29a9b-69fb-3441-9b8a-0c97aec02798"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sgLinUsed", "=", 
   RowBox[{"sgValidate", "[", "sgLinConfig", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"sgAnisotropyInfo", "[", 
      RowBox[{"sgLinUsed", "[", "\"\<Delta\>\"", "]"}], "]"}], 
     "==", "\"\<SpecialBulkDegeneracyControl\>\""}], ",", "\n", " ", 
    RowBox[{"Print", "[", 
     RowBox[{"Style", "[", 
      RowBox[{"\"\<Delta=+/-1/2: special bulk degeneracy control; compare \
0.45 or 0.6.\>\"", ",", "DarkOrange"}], "]"}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinGrid", "=", 
   RowBox[{"sgGrid", "[", "sgLinUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinDimensions", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lab", "=", 
         RowBox[{"sgLabels", "[", 
          RowBox[{"l", ",", 
           RowBox[{"sgLinUsed", "[", "\"\<Sector\>\"", "]"}]}], "]"}]}], 
        "}"}], ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", "lab"}], ",", 
         RowBox[{"\"\<Dimension\>\"", "->", 
          RowBox[{"sgDimension", "[", 
           RowBox[{"l", ",", "lab"}], "]"}]}]}], "|>"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", 
       RowBox[{"sgLinUsed", "[", "\"\<LValues\>\"", "]"}]}], "}"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{"Dataset", "[", "sgLinDimensions", "]"}]}], "Input",ExpressionUUID->\
"44d17be9-1b53-d347-a661-cc42bdbd4f4d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
13.3.2 Construct the selected block and compute its full spectrum at every g\
\>", "Subsubsection",ExpressionUUID->"194ae394-c26d-1246-bcdb-c917e49cc6b7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sgCheck", "[", 
   RowBox[{
    RowBox[{"sgLinConfig", "===", "sgLinUsed"}], 
    ",", "\"\<Parameters changed: regenerate the grid first.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"sgLinRun", "=", 
   RowBox[{"sgScan", "[", 
    RowBox[{"sgLinUsed", ",", "sgLinGrid"}], "]"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"KeyDrop", "[", 
     RowBox[{"#", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Ratios\>\"", ",", "\"\<Energies\>\""}], "}"}]}], "]"}], 
    "&"}], " ", "/@", " ", 
   RowBox[{"sgLinRun", "[", "\"\<Results\>\"", "]"}]}], "]"}]}], "Input",Expre\
ssionUUID->"b37df2a5-c821-f74d-8bb8-5340db0f0201"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.3.3 Plot the retained means and diagnostic error bars", \
"Subsubsection",ExpressionUUID->"83e97fe4-39cb-5343-a832-0c70d78827a7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sgLinPlot", "=", 
   RowBox[{"sgPlot", "[", 
    RowBox[{"sgLinRun", ",", "sgLinStyle"}], "]"}]}], 
  ";"}], "\n", "sgLinPlot"}], "Input",ExpressionUUID->"5b6c7440-05f6-ca4c-\
bd06-f270efe8622c"]
}, Closed]],

Cell[CellGroupData[{

Cell["13.3.4 Export this run", "Subsubsection",ExpressionUUID->"3ef1397c-8816-ae4d-bc10-c3ff8b6bb25d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sgLinDirectory", "=", 
   RowBox[{"sgExport", "[", 
    RowBox[{
    "sgLinRun", ",", "sgLinPlot", ",", "sgLinStyle", ",", "\n", " ", 
     "sgLinOutputRoot", ",", "sgLinRunLabel"}], "]"}]}], ";"}]], "Input",Expre\
ssionUUID->"61f781ad-bfab-d948-b14f-e4efbcd915ee"],

Cell["\<\
Style-only changes require only the plot/export cells. Changing L, sector, J, \
Delta, g grid, precision, rank window or numerical tolerances requires \
regenerating the grid and recomputing this run. Exports contain settings \
actually used, actual labels and dimensions, all g values, raw ratios, \
optional full selected-sector spectra, diagnostics and the plot. New numbered \
folders preserve earlier runs. A supplied g=0 is retained as a diagnostic \
endpoint with no mean.\
\>", "Text",ExpressionUUID->"087df37f-bfaf-6c40-ad3f-bb6f8347c974"]
}, Open  ]]
}, Open  ]],

