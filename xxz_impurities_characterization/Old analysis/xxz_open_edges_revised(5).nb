Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Keep", " ", "sector", " ", "vectors", " ", "and", " ", "coefficients"}], 
    ";", " ", 
    RowBox[{"skip", " ", "only", " ", "exactly", " ", "zero", " ", 
     RowBox[{"projections", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"makeEngine", "[", 
      RowBox[{"ed_", ",", "fac_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"blocks", "=", 
          RowBox[{"{", "}"}]}], ",", "c"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AssociationQ", "[", "ed", "]"}], " ", "&&", " ", 
           RowBox[{"ContainsAll", "[", 
            RowBox[{
             RowBox[{"Keys", "[", "ed", "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Hamiltonian\>\"", ",", "\"\<Parameters\>\"", 
               ",", "\"\<Sectors\>\""}], "}"}]}], "]"}]}], ",", "\n", 
          "  ", "\"\<makeEngine requires an ED association with Hamiltonian, \
Parameters and Sectors. Recompute or load a complete ED result.\>\""}], "]"}],
         ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AssociationQ", "[", 
            RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "]"}], " ", "&&", 
           " ", 
