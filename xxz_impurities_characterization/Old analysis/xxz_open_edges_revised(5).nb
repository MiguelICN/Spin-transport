Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Raw", " ", "eigenpairs", " ", "in", " ", "one", " ", "resolved", " ", 
     "sector"}], ";", " ", 
    RowBox[{"preserve", " ", "arbitrarily", " ", "small", " ", 
     RowBox[{"gaps", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"diagonalizeBlock", "[", 
     RowBox[{"s_", ",", "hm_", ",", "ids_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "h", ",", "e", ",", 
        "v", ",", "order", ",", "rows", ",", "gaps", ",", "res", ",", "orth", 
        ",", "leak", ",", "scale"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"herm", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", "hm", 
          " ", ".", " ", "b"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", "h", " ", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Re", "[", "e", " ", "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Developer`ToPackedArray", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"e", "[", 
           RowBox[{"[", "order", " ", "]"}], "]"}], "]"}], "]"}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"fixSign", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"b", " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "order", " ", "]"}], "]"}], "]"}]}], "]"}]}]}], ";",
        "\n", " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "rows", "]"}]}], ";", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{"hm", ",", "Infinity"}], " ", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"res", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"hm", " ", ".", " ", "#2"}], "-", 
              RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"e", ",", "rows"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"orth", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"rows", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "rows", "]"}]}], "-", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "rows", " ", "]"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"leak", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"hm", " ", ".", " ", "b"}], "-", 
          RowBox[{"b", " ", ".", " ", "h"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"res", "<", 
           RowBox[{"100", " ", "tol", " ", "scale"}]}], " ", "&&", " ", 
          RowBox[{"orth", "<", 
           RowBox[{"100", " ", "tol"}]}], " ", "&&", " ", 
          RowBox[{"leak", "<", 
           RowBox[{"100", " ", "tol", " ", "scale"}]}]}], 
         ",", "\"\<Sector validation failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"gaps", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Differences", "[", "e", "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Dimension\>\"", "->", 
          RowBox[{"Length", "[", "e", "]"}]}], ",", 
         RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", "\n", "  ", 
         RowBox[{"\"\<Eigenvalues\>\"", "->", "e"}], ",", 
         RowBox[{"\"\<Vectors\>\"", "->", "rows"}], ",", 
         RowBox[{"\"\<Residual\>\"", "->", "res"}], ",", 
         RowBox[{"\"\<OrthogonalityError\>\"", "->", "orth"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<MinPositiveGap\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"gaps", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<NoGap\>\"", "]"}], ",", 
            RowBox[{"Min", "[", "gaps", " ", "]"}]}], "]"}]}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->"c5ec955c-b5a3-0a4b-\
bf55-9abe454a05e2"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Full", " ", "independent", " ", "ED", " ", "of", " ", "every", " ", 
    "surviving", " ", "symmetry", " ", 
    RowBox[{"sector", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"sectorED", "[", 
      RowBox[{"p_Association", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l", "=", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "q", ",", 
         "active", ",", 
         RowBox[{"out", "=", 
          RowBox[{"{", "}"}]}], ",", "ids", ",", "hm", ",", "m", ",", "names",
          ",", "spaces"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"h", "=", 
         RowBox[{"xxzH", "[", "p", "]"}]}], ";", 
        RowBox[{"realSectorCheck", "[", 
         RowBox[{"h", ",", "l", ",", "tol"}], "]"}], ";", 
        RowBox[{"q", "=", 
         RowBox[{"charges", "[", "p", "]"}]}], ";", "\n", " ", 
        RowBox[{"active", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "q", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"h", " ", ".", " ", 
                RowBox[{"q", "[", "#", "]"}]}], "-", 
               RowBox[{
                RowBox[{"q", "[", "#", "]"}], " ", ".", " ", "h"}]}], "]"}], "<", 
             RowBox[{"tol", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Norm", "[", 
                 RowBox[{"h", ",", "Infinity"}], " ", "]"}]}], "]"}]}]}], 
            "&"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{
             RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
           RowBox[{"ids", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"2", "^", "l"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"IntegerDigits", "[", 
                  RowBox[{
                   RowBox[{"#", "-", "1"}], ",", "2", ",", "l"}], " ", "]"}], 
                 "]"}], "==", "nDown"}], "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"hm", "=", 
            RowBox[{"N", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"h", "[", 
               RowBox[{"[", 
                RowBox[{"ids", ",", "ids"}], " ", "]"}], "]"}], "]"}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"names", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"active", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"\"\<F\>\"", ",", "\"\<RF\>\""}], "}"}], ",", 
                   "#"}], "]"}]}], " ", "||", " ", 
                RowBox[{"m", "==", "0"}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"names", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{"names", ",", 
              RowBox[{
               RowBox[{"Switch", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"\"\<S2\>\"", "|", "\"\<StaggeredS2\>\""}], ",", "0",
                  ",", "\"\<R\>\"", ",", "1", ",", "_", ",", "2"}], "]"}], 
               "&"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"spaces", "=", 
            RowBox[{"{", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Basis\>\"", "->", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"Length", "[", "ids", " ", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Labels\>\"", "->", 
                RowBox[{"<|", 
                 RowBox[{"\"\<m\>\"", "->", "m"}], "|>"}]}]}], "|>"}], 
             "}"}]}], ";", "\n", "  ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"spaces", "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"splitCharge", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], " ", "]"}], "]"}], "]"}], 
                    "]"}], ",", "name", ",", "tol"}], "]"}], "&"}], " ", "/@",
                  " ", "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"{", 
              RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", "\n", "  ", 
           RowBox[{"out", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"out", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"diagonalizeBlock", "[", 
                 RowBox[{"#", ",", "hm", ",", "ids", ",", "tol"}], "]"}], 
                "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nDown", ",", "0", ",", "l"}], "}"}]}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
           RowBox[{"2", "^", "l"}]}], 
          ",", "\"\<Incomplete sector dimensions.\>\""}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"<|", 
