Cell[CellGroupData[{

Cell["7.3 Numerical checks", "Subsection",ExpressionUUID->"a7a3c7e7-f2b5-1b48-8c39-f51ec9c3c8df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoChecks", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<InitialFactorError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"evolve", "[", 
          RowBox[{"0.", ",", "engine"}], "]"}], "-", "fullFactor"}], 
        ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<InitialEdgeError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "evoData", "]"}], "[", "\"\<RhoAB\>\"", "]"}],
          "-", "rhoEdge0"}], ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", 
     " ", 
     RowBox[{"\"\<MaxTraceError\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}], ",", 
     "\n", " ", 
     RowBox[{"\"\<MaxHermiticityError\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<HermiticityError\>\""}], "]"}], "]"}]}], 
     ",", "\n", " ", 
     RowBox[{"\"\<MinEigenvalue\>\"", " ", "->", " ", 
      RowBox[{"Min", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}]}]}], 
    "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Values", "[", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"evoChecks", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], 
       "]"}], "<", "validationTolerance"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"evoChecks", "[", "\"\<MinEigenvalue\>\"", "]"}], ">=", 
      RowBox[{"-", "validationTolerance"}]}]}], 
    ",", "\"\<Evolution validation failed.\>\""}], "]"}], 
  ";"}], "\n", "evoChecks"}], "Input",ExpressionUUID->"2db7777d-a829-324c-\
90b5-ee4d61497e90"]
}, Open  ]],

