Cell[CellGroupData[{

Cell["Framed plots and export layout", "Subsection",ExpressionUUID->"317fe6cd-7f80-364d-9407-4dffc4386e53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Build", " ", "tick", " ", "lists", " ", "before", " ", "export"}], ";", 
    " ", 
    RowBox[{"logarithmic", " ", "plots", " ", "use", " ", "log", 
     RowBox[{"(", "t", ")"}], " ", 
     RowBox[{"coordinates", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"framePlot", "[", 
      RowBox[{
      "data_", ",", "xlabel_", ",", "ylabel_", ",", "styles_", ",", 
       "legends_", ",", 
       RowBox[{"joined_", ":", "True"}], ",", 
       RowBox[{"log_", ":", "False"}], ",", 
       RowBox[{"markers_", ":", "Automatic"}], ",", 
       RowBox[{"topLabel_", ":", "\"\<\>\""}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"curves", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "plotChop"}], "]"}]}], 
              "}"}], "&"}], ",", "data", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "points", ",", "xr", ",",
          "yr", ",", "xt", ",", "yt"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"log", ",", 
          RowBox[{"curves", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
             "curves", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"points", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"curves", ",", "1"}], "]"}]}], ";", 
        RowBox[{"xr", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{"points", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"yr", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{"points", "[", 
