Cell["4.1 Choose sweep parameters", "Subsection",ExpressionUUID->"f64808dd-1788-9e4f-8188-7fcc3c72e121"],

Cell["\<\
These parameters apply only to the sweep. Evolution parameters are entered \
separately in section 5.\
\>", "Text",ExpressionUUID->"6c0f13ce-30e0-2240-b36d-37aefd5e7405"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepModel", " ", "=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"deltaGrid", " ", "=", " ", 
    RowBox[{"Range", "[", 
     RowBox[{
      RowBox[{"-", "5"}], ",", "5", ",", "0.05"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"sweepLabel", " ", "=", " ", "\"\<sweep01_fieldLeft_0.1\>\""}], 
    ";"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"sweepLabel", " ", "=", " ", "\"\<sweep01\>\""}], ";"}]}], "Input",E\
xpressionUUID->"ebedfae1-87b9-614a-bef4-0bf54c394b77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.2 Diagonalize and calculate eigenstate entropies", "Subsection",ExpressionUUID->"f99e4999-6d13-2740-ba2f-a3f7dd0446a6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepUsed", " ", "=", " ", "sweepModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaUsed", " ", "=", " ", "deltaGrid"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "deltaUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"deltaUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "deltaUsed", " ", "]"}], "]"}], ">", "0"}], 
       "]"}]}]}], ",", "\"\<Delta grid must be strictly increasing.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sweepSeconds", ",", "sweepData"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"sweepParallel", "[", 
     RowBox[{
     "deltaUsed", ",", "sweepUsed", ",", "edTolerance", ",", "parallel"}], 
     " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sweep seconds: \>\"", ",", "sweepSeconds"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"48857511-a9ed-d84b-88a5-aa165d043c57"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.3 Identify matching sectors", "Subsection",ExpressionUUID->"e236b9dd-dec9-474a-9e51-e52ab71debda"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepKeys", " ", "=", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"First", "[", "sweepData", " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"sweepData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", "#", " ", "]"}], "]"}], "==", 
         RowBox[{"Sort", "[", "sweepKeys", "]"}]}], " ", "&&", "\n", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"#", "[", "\"\<Energies\>\"", "]"}], "]"}], "&"}], " ", "/@",
            " ", 
           RowBox[{"Values", "[", "#", " ", "]"}]}], "]"}], "==", 
         RowBox[{"2", "^", 
          RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}], 
    ",", "\"\<Incomplete sweep.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{"sweepKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "sweepData", ",", "matchingTolerance"}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sectors: \>\"", ",", 
    RowBox[{"Length", "[", "sweepKeys", "]"}], ",", "\"\<; groups: \>\"", ",", 
    RowBox[{"Length", "[", "sweepGroups", " ", "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"38ecb205-e27c-e548-8a3f-a1554b147fdf"]
}, Open  ]],

