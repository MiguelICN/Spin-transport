              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<\\\\text{Edge correlation: }\>\"", "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<\\\\langle\\\\sigma_1^{\>\"", "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<}\\\\sigma_L^{\>\"",
               "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              "<>", "\"\<}\\\\rangle\>\""}]}], "}"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
       "\n", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", "\n", "  ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<Connected\>\"", "<>", 
              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", 
              RowBox[{"dynAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<\\\\text{Connected edge correlation: }\>\"", "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], ",", "\n", "   ", 
             RowBox[{"\"\<\\\\langle\\\\sigma_1^{\>\"", "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<}\\\\sigma_L^{\>\"",
               "<>", 
              RowBox[{"dynTexAxes", "[", 
               RowBox[{"[", "j", "]"}], "]"}], 
              "<>", "\"\<}\\\\rangle_c\>\""}]}], "}"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"i", ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
      "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"5210a9f1-f911-324d-\
b9be-f25ed2f796ef"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.3 Choose fixed parameters and the Delta sweep", "Subsection",ExpressionUUID->"2374d64b-2f07-c941-8640-61e287fa2e98"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynModel", "=", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dynDelta", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "5"}], ",", "5"}], "]"}], "/", "10"}], "]"}]}], ";"}], 
  "             ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Edit", " ", "this", " ", "list", " ", "to", " ", "change", " ", "the", " ", 
    RowBox[{"sweep", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dynRunLabel", "=", "\"\<delta_dynamics\>\""}], ";"}]}], "Input",Exp\
ressionUUID->"b811d355-23e6-7a44-a4ec-069be67d5ad6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynTime", "=", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", "\n", " ", 
     RowBox[{"\"\<tMax\>\"", "->", "50."}], ",", "\n", " ", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", "\n", " ", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<LogPoints\>\"", "->", "501"}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynParallel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Enabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<Kernels\>\"", "->", "12"}], ",", "\n", " ", 
     RowBox[{"\"\<MemoryBudgetGB\>\"", "->", "15."}], ",", 
     RowBox[{"\"\<BatchTimes\>\"", "->", "128"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynValidationTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}]}], "Input",ExpressionUUID->"3ff43c5d-56d5-\
9a48-bc9f-8d0c9e9aac9c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plotChop", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynExportLogTime", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynOutputRoot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_open_edges_delta_dynamics\>\""}], "}"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"286dc28b-ca2a-5342-9bb6-a14a66f57e77"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.4 Choose the fixed initial state", "Subsection",ExpressionUUID->"e6560327-a622-1345-97d5-de161bee16d8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dynStateMode", "=", "\"\<Factorized\>\""}], ";"}], 
  "             ", 
  RowBox[{"(*", " ", 
   RowBox[{"Factorized", " ", "or", " ", 
    RowBox[{"Full", "."}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"e74c6dd3-c579-d44a-a4ce-ca6c330d37ff"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dynEdgeState", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], ";"}], 
  "                ", 
  RowBox[{"(*", " ", 
   RowBox[{"Basis", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"00", ",", "01", ",", "10", ",", "11"}], "}"}], "."}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dynMiddleState", "=", 
   RowBox[{"productKet", "[", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Alternatives", ":", " ", 
    RowBox[{
     RowBox[{"neel", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
      "]"}], " ", "or", " ", 
     RowBox[{
      RowBox[{"helix", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "q"}], 
       "]"}], "."}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->"ea1cfeae-\
27ef-0c4e-9670-08e6f914b9d9"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Full", " ", 
     RowBox[{"mode", ":", " ", 
