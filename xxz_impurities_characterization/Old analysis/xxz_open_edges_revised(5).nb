Cell[CellGroupData[{

Cell["\<\
11.4 Compute all eigenpairs, both entropies, and IPR at every g\
\>", "Subsection",ExpressionUUID->"f383193e-0169-0244-be82-369f9cf1ada0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exUsed", "=", 
   RowBox[{"edgeModel", "[", "exModel", "]"}]}], ";", 
  RowBox[{"exGUsed", "=", "exGGrid"}], ";", 
  RowBox[{"exSettingsUsed", "=", "exSettings"}], ";", 
  RowBox[{"exParallelUsed", "=", "exParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "exGUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"exGUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "exGUsed", "]"}], "]"}], ">", "0"}], "]"}]}]}], 
    ",", "\"\<Exchange g grid must be real and strictly increasing.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exSetup", "=", 
   RowBox[{"exEdgeSetup", "[", 
    RowBox[{"exUsed", ",", 
     RowBox[{"exSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exSetupAudit", "=", 
   RowBox[{"exSetup", "[", "\"\<SetupAudit\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"exSeconds", ",", "exResults"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"edgeCheckedSweep", "[", 
     RowBox[{"exGUsed", ",", "exSetup", ",", 
      RowBox[{"exSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
      "exParallelUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exData", "=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"exResults", ",", "\"\<Data\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exKeys", "=", 
   RowBox[{"edgeSweepCheck", "[", 
    RowBox[{"exResults", ",", "exGUsed", ",", "exUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exGroups", "=", 
   RowBox[{"Gather", "[", 
    RowBox[{"exKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "exData", ",", 
        RowBox[{"exSettingsUsed", "[", "\"\<MatchingTolerance\>\"", "]"}]}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Exchange sweep seconds: \>\"", ",", "exSeconds", 
    ",", "\"\<; parent sectors: \>\"", ",", 
    RowBox[{"Length", "[", "exKeys", "]"}], ",", "\n", 
    " ", "\"\<; plotted groups: \>\"", ",", 
    RowBox[{"Length", "[", "exGroups", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"First", "[", "exResults", "]"}], "[", "\"\<SectorTable\>\"", 
   "]"}], "]"}]}], "Input",ExpressionUUID->"0a26508a-8b52-bc47-92db-\
0efde52172d9"]
}, Closed]],

