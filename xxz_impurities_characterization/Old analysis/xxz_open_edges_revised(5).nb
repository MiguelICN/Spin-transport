         "[", "\"\<EndpointReport\>\"", "]"}], 
        "[", "\"\<CandidateEndpointCharges\>\"", "]"}]}], "]"}], ";", "\n", 
     " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "zzZeroPoints", "]"}], 
         "[", "\"\<EndpointReport\>\"", "]"}], 
        "[", "\"\<SectorRefinements\>\"", "]"}], "]"}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"57692ed7-af29-274d-a7d2-552c4ce0a966"],

Cell["\<\
Every row in EndpointReport[\"SectorRefinements\"] is an actual independently \
diagonalized child sector; its AdditionalLabels records only the charges \
compatible with that parent. EndpointRefinement in the old data format is a \
candidate list, not a claim that every charge was applied in every sector. \
Data recombines child eigenpairs into fixed parent labels only for the \
g-sweep plots. Do not compute level spacings across these recombined endpoint \
children.
For an audited full eigensystem at one g use \
zzOneED=edgeCheckedED[g,zzSetup,zzSettingsUsed[\"EDTolerance\"]]. The \
unchanged eigenket and sectorTable functions accept this result. Set the \
fourth argument to True for a small-chain full-spectrum check. The operator \
block reduction check verifies the identity H_ab; the reference \
transfer-matrix construction establishes integrability.\
\>", "Text",ExpressionUUID->"24759110-3afc-8c41-9053-f8dae3c2784d"]
}, Closed]],

