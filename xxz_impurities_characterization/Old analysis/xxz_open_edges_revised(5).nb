    RowBox[{"using", " ", "the", " ", "original", " ", 
     RowBox[{"routine", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"edgeED", "[", 
      RowBox[{"g_", ",", "setup_", ",", 
       RowBox[{"tol_", ":", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "h", ",", 
         RowBox[{"q", "=", 
          RowBox[{"<|", "|>"}]}], ",", 
         RowBox[{"out", "=", 
          RowBox[{"{", "}"}]}], ",", "ids", ",", "hm", ",", "spaces", ",", 
         "extra", ",", "parts"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"realQ", "[", "g", "]"}], 
          ",", "\"\<g must be a finite real coupling.\>\""}], "]"}], ";", 
