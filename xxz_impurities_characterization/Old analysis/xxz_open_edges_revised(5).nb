Cell[CellGroupData[{

Cell["8. Access and modify results", "Section",ExpressionUUID->"1e5d198d-61ee-c845-bdc0-279512ed4a39"],

Cell["\<\
For another initial state at the same Hamiltonian, edit section 6 and rerun \
6.5\[Dash]7. For another Hamiltonian, edit 5.1 and rerun 5.3 onward. The \
sweep can be skipped entirely. Exact degenerate eigenstate entropies remain \
basis dependent. S(rhoAB) measures edges\[Dash]middle entanglement only when \
the full state is pure.\
\>", "Text",ExpressionUUID->"8cc1161c-4797-2145-9418-c6b95fc98dc9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Evaluate", " ", "any", " ", "of", " ", "these", " ", "expressions", " ", 
    RowBox[{"individually", "."}]}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"eigenket", "[", 
    RowBox[{"evoED", ",", "3", ",", "1"}], "]"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoED", "[", "\"\<Sectors\>\"", "]"}], "[", 
     RowBox[{"[", "3", "]"}], "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], " ", 
   "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoAB\>\"", "]"}], " ", "//",
     " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoA\>\"", "]"}], " ", "//", 
    " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"evoData", "[", 
      RowBox[{"[", "10", "]"}], "]"}], "[", "\"\<RhoB\>\"", "]"}], " ", "//", 
    " ", "MatrixForm"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"reducedState", "[", 
    RowBox[{
     RowBox[{"evolve", "[", 
      RowBox[{"1.", ",", "engine"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}], " ", 
   "*)"}]}]], "Input",ExpressionUUID->"aad25f73-e6ea-9046-8605-acc5dfc5526e"]
}, Closed]],

Cell[CellGroupData[{

Cell["9. Delta sweep of edge dynamics", "Section",ExpressionUUID->"7ac240f1-a9dc-6d43-a7b7-06ef2ef4e356"],

Cell[CellGroupData[{

Cell["9.1 Physics definitions", "Subsection",ExpressionUUID->"8713ad5f-f828-d94c-83bc-9112b8597b4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DownValues", "[", "sectorED", "]"}], "]"}], "==", "0"}], " ", 
     "||", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DownValues", "[", "evolveChunks", "]"}], "]"}], "==", "0"}], 
     " ", "||", "\n", " ", 
