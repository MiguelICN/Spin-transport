      "enter", " ", "one", " ", "fixed", " ", "vector", " ", "or", " ", 
       "density", " ", "matrix", " ", "in", " ", "site", " ", "order", " ", 
       "1"}]}]}], ",", "...", ",", 
    RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dynFullState", "=", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
