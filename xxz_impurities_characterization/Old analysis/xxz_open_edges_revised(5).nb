               RowBox[{"edgeRefine", "[", 
                RowBox[{"spaces", ",", "extra", ",", "tol"}], "]"}]}]}]}], 
            "]"}], ";", "\n", "  ", 
           RowBox[{"out", "=", 
            RowBox[{"Join", "[", 
             RowBox[{"out", ",", 
              RowBox[{
