        RowBox[{"parts", "=", 
         RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}]}], ";", 
        RowBox[{"h", "=", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"parts", "[", "\"\<Bulk\>\"", "]"}], "+", 
