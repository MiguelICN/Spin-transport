             RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], " ", 
             "]"}], "]"}], "+=", 
           RowBox[{
            RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "I"}], " ", 
                RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}], " ", 
              RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}],
         ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Batch", " ", "matrix", " ", "products", " ", "over", " ", "time"}], ";",
      " ", 
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], " ", "is", " ", 
      "the", " ", "kth", " ", 
      RowBox[{"factor", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"evolveBatch", "[", 
      RowBox[{"times_List", ",", "engine_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "ph"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"0.", "+", 
            RowBox[{"0.", "I"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
             RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}], ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ph", "=", 
            RowBox[{"Exp", "[", 
             RowBox[{
              RowBox[{"-", "I"}], " ", 
              RowBox[{"Outer", "[", 
               RowBox[{"Times", ",", 
                RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
                RowBox[{"N", "[", "times", " ", "]"}]}], "]"}]}], "]"}]}], ";",
            "\n", "  ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"a", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "c", ",", 
                 "All"}], " ", "]"}], "]"}], "+=", 
              RowBox[{
               RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
               RowBox[{"(", 
                RowBox[{"ph", " ", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "c"}], " ", "]"}], "]"}]}], ")"}]}]}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"c", ",", 
               RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
            "]"}]}], ",", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}],
         ";", "a"}]}], "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->\
"11518a17-5647-d640-9479-e6a9fb6278dc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Edge", " ", "observables", " ", "from", " ", "the", " ", "4", " ", "x", " ",
      "environment"}], "-", 
    RowBox[{"rank", " ", "coefficient", " ", 
     RowBox[{"matrix", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"observables", "[", 
      RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", "z",
          ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"a", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
        RowBox[{"a1", "=", 
         RowBox[{"traceB", "[", "r", "]"}]}], ";", 
        RowBox[{"b1", "=", 
         RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
         RowBox[{"entropy", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "z"}], "}"}], "=", 
         RowBox[{"PauliMatrix", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
        RowBox[{"ma", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
        RowBox[{"mb", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
        RowBox[{"e", "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
          RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
          RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
          RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
          RowBox[{"\"\<Purity\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
          RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
          RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
          RowBox[{"\"\<MutualInfo\>\"", "->", 
           RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
          RowBox[{"\"\<Concurrence\>\"", "->", 
           RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
          RowBox[{"\"\<Negativity\>\"", "->", 
           RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<InitialOverlap\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
          RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
          RowBox[{"\"\<ConnectedZZ\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
             "]"}], "-", 
            RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
          RowBox[{"\"\<ConnectedXX\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
             "]"}], "-", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
          "\n", "  ", 
          RowBox[{"\"\<TraceError\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
          RowBox[{"\"\<HermiticityError\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"r", "-", 
              RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
             ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<MinEigenvalue\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"timeChunk", "[", 
      RowBox[{"times_", ",", "engine_", ",", "rho0_", ",", "tol_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "records"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"evolveBatch", "[", 
          RowBox[{"times", ",", "engine"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"observables", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", " ", "]"}], "]"}], ",", 
             RowBox[{"partitionFactor", "[", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "All", ",", "k"}], " ", "]"}], "]"}], ",",
                "\n", "  ", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
               RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
             "rho0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
             "tol"}], " ", "&&", "\n", "  ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
             "]"}], "<", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}],
             ">=", 
            RowBox[{"-", "tol"}]}]}], ",", "\n", 
          "  ", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", 
        "records"}]}], "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->\
"aef28a26-4c7b-9d4a-aae4-866f45d4c4ec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Linear", " ", "or", " ", "logarithmic", " ", "sampling"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"including", " ", "t"}], "=", 
     RowBox[{"0.", " ", "Linear", " ", "dt", " ", "is", " ", 
      RowBox[{"nominal", ":", " ", 
       RowBox[{"the", " ", "last", " ", "step", " ", "may", " ", "be", " ", 
        RowBox[{"shorter", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"t", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "0.", "}"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"Subdivide", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}],
                "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "=", 
           RowBox[{"N", "[", 
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], ",",
          "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->\
"e3480e79-a477-414d-8484-83a908ea1c62"]
}, Closed]],

Cell[CellGroupData[{

Cell["Time splitting and parallelization", "Subsection",ExpressionUUID->"a66b0f6a-ab75-1746-b3df-2a8d28a7f63f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Reuse", " ", "existing", " ", "kernels"}], ";", " ", 
    RowBox[{"no", " ", "kernels", " ", "are", " ", 
     RowBox[{"closed", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"startKernels", "[", "cfg_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", 
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"LaunchKernels", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "-", "n"}], " ", 
            "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Available parallel kernels: \>\"", ",", "n"}], "]"}], ";",
         "n"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Independent", " ", "Delta", " ", "points"}], ";", " ", 
     RowBox[{
     "full", " ", "eigenvectors", " ", "are", " ", "computed", " ", "at", " ",
       "each", " ", 
      RowBox[{"point", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sweepParallel", "[", 
      RowBox[{"grid_", ",", "p_", ",", "tol_", ",", "cfg_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "p", ",", "tol"}], "]"}], "&"}], " ", "/@", 
            " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"DistributeDefinitions", "[", "sweepPoint", "]"}], ";", "\n", 
        " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pp", "=", "p"}], ",", 
            RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "pp", ",", "tt"}], "]"}], "&"}], ",", "grid", 
            ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->\
"8525e95c-7995-c34d-acb7-1568a67fb10e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Batches", " ", "limit", " ", "memory"}], ";", " ", 
    RowBox[{"each", " ", "worker", " ", "gets", " ", "one", " ", "engine", " ", 
     RowBox[{"copy", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"evolveChunks", "[", 
     RowBox[{
     "times_", ",", "engine_", ",", "rho0_", ",", "tol_", ",", "cfg_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "batch", ",", "room", ",", "chunks", ",", "packets", ",", 
        "records", ",", "reference", ",", "error"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
       RowBox[{"room", "=", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<MemoryBudgetGB\>\"", "]"}], " ", 
         RowBox[{"1024.", "^", "3"}]}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"4.", " ", "n", " ", 
            RowBox[{"ByteCount", "[", "engine", "]"}]}], ">", "room"}]}], ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<Engine copies exceed the memory budget; using serial \
batches.\>\"", "]"}], ";", 
          RowBox[{"n", "=", "0"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"batch", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"room", "/", "\n", "  ", 
              RowBox[{"(", 
               RowBox[{"4.", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1", ",", "n"}], "]"}], " ", "16", " ", 
                RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], " ", 
                RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], ")"}]}], 
             "]"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"chunks", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"times", ",", 
          RowBox[{"UpTo", "[", "batch", " ", "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Time batches: \>\"", ",", 
         RowBox[{"Length", "[", "chunks", "]"}], 
         ",", "\"\<; maximum points per batch: \>\"", ",", "batch"}], "]"}], ";",
        "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", ">=", "2"}], ",", "\n", "  ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Clear", " ", "both", " ", "worker", " ", "values", " ", "and", " ",
            "their", " ", "recorded", " ", "definitions", " ", "before", " ", 
           RowBox[{"reuse", "."}]}], " ", "*)"}], "\n", "  ", 
         RowBox[{
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"sharedEngine", "=", "engine"}], ";", 
          RowBox[{"sharedRho0", "=", "rho0"}], ";", 
          RowBox[{"sharedTolerance", "=", "tol"}], ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "timeChunk", ",", "sharedEngine", ",", "sharedRho0", ",", 
            "sharedTolerance"}], "]"}], ";", "\n", "  ", 
          RowBox[{"packets", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"timeChunk", "[", 
               RowBox[{
               "#", ",", "sharedEngine", ",", "sharedRho0", ",", 
                "sharedTolerance"}], "]"}], "&"}], ",", "\n", "   ", "chunks",
              ",", 
             RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"packets", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"timeChunk", "[", 
             RowBox[{"#", ",", "engine", ",", "rho0", ",", "tol"}], "]"}], 
            "&"}], " ", "/@", " ", "chunks"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"packets", ",", "ListQ"}], "]"}], 
         ",", "\"\<A time batch failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"records", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"packets", ",", "1"}], "]"}]}], ";", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], "===", "times"}], 
         ",", "\"\<Time ordering failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"reference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"observables", "[", 
           RowBox[{"t", ",", 
            RowBox[{"partitionFactor", "[", 
             RowBox[{
              RowBox[{"evolve", "[", 
               RowBox[{"t", ",", "engine"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
            "rho0"}], "]"}], ",", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "times", "]"}], ",", 
              RowBox[{"Last", "[", "times", "]"}]}], "}"}]}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"error", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "[", "\"\<RhoAB\>\"", "]"}], "-", 
               RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "&"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "[", "records", "]"}], ",", 
               RowBox[{"Last", "[", "records", "]"}]}], "}"}], ",", 
             "reference"}], "}"}]}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"error", "<", "tol"}], 
         ",", "\"\<Batched/single-time endpoint comparison failed.\>\""}], 
        "]"}], ";", "records"}]}], "\n", "]"}]}], ";"}]}]], "Input",Expression\
UUID->"43434551-23aa-fd46-9a41-dc852c5f5cfe"]
}, Closed]]
