Cell[CellGroupData[{

Cell["4.5 Half-chain eigenstate entropy", "Subsection",ExpressionUUID->"1b850502-84db-a84e-825e-813357046a2d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"halfPlots", " ", "=", " ", 
   RowBox[{"sweepPanels", "[", 
    RowBox[{
    "sweepData", ",", "deltaUsed", ",", "sweepGroups", ",", "sweepUsed", ",", 
     "\n", " ", "\"\<HalfEntropy\>\"", 
     ",", "\"\<S_{\\\\mathrm{half}}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Half-chain eigenstate entanglement}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"halfPlots", "[", 
  RowBox[{"[", "1", "]"}], "]"}]}], "Input",ExpressionUUID->"e5cb7b29-066d-\
3c48-9d33-ecf97ab5b3f1"]
}, Closed]],

Cell[CellGroupData[{

Cell["4.6 Edges-versus-middle eigenstate entropy", "Subsection",ExpressionUUID->"07a6b225-20c1-3f4d-96e8-6f6aad62f8fd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgeEntropyPlots", " ", "=", " ", 
   RowBox[{"sweepPanels", "[", 
    RowBox[{
    "sweepData", ",", "deltaUsed", ",", "sweepGroups", ",", "sweepUsed", ",", 
     "\n", " ", "\"\<EdgesEntropy\>\"", 
     ",", "\"\<S_{AB|E}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Edges versus middle eigenstate entanglement}\>\""}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{"edgeEntropyPlots", "[", 
  RowBox[{"[", "1", "]"}], "]"}]}], "Input",ExpressionUUID->"19687002-9883-\
3347-8ada-0b51598d74f3"]
}, Closed]],

Cell[CellGroupData[{

Cell["4.7 Export sweep plots and data", "Subsection",ExpressionUUID->"597cf7a8-4438-164d-b69d-f5a7ab1e02b6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepDir", " ", "=", " ", 
   RowBox[{"newFolder", "[", 
    RowBox[{"outputRoot", ",", 
     RowBox[{"sweepLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"sweepUsed", "[", "\"\<J\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<spectrum_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"spectrumPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "spectrumPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<half_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"halfPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "halfPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<edge_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"edgeEntropyPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "edgeEntropyPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"sweepDir", ",", "\"\<eigenstate_sweep.wxf\>\""}], "}"}], "]"}],
     ",", "\n", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Model\>\"", "->", "sweepUsed"}], ",", 
      RowBox[{"\"\<DeltaGrid\>\"", "->", "deltaUsed"}], ",", 
      RowBox[{"\"\<Groups\>\"", "->", "sweepGroups"}], ",", 
      RowBox[{"\"\<Data\>\"", "->", "sweepData"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Saved: \>\"", ",", "sweepDir"}], "]"}], ";"}]}], "Input",Expre\
ssionUUID->"478e17d4-2c11-4d43-a848-1530c473be8d"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["5. Evolution: independent parameters and diagonalization", "Section",ExpressionUUID->"23d9f3e9-0d08-fc4e-b24b-24b37bb0a637"],

Cell[CellGroupData[{

Cell["5.1 Choose the Hamiltonian for this evolution", "Subsection",ExpressionUUID->"8a8b9a4e-699f-0f4d-b07b-bfeb240abbca"],

Cell["\<\
Set all evolution parameters here, including Delta. Running the sweep is \
unnecessary.\
\>", "Text",ExpressionUUID->"fb330457-f23d-964f-9388-61514cf5fbf3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoModel", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", " ", "->", " ", "8"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", " ", "->", " ", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<Delta\>\"", " ", "->", " ", "0.5"}], ",", "\n", " ", 
     RowBox[{"\"\<h\>\"", " ", "->", " ", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bLeft\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<bRight\>\"", " ", "->", " ", "0"}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"evoLabel", " ", "=", " ", "\"\<evolution01_fieldLeft_0.01\>\""}], 
  ";"}]}], "Input",ExpressionUUID->"d31a9e41-8bb4-5646-81a6-cd0c8f8540be"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Choose the evolution time grid", "Subsection",ExpressionUUID->"a0302e7c-be9a-7b4e-90ce-56440b6088c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evoTime", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", " ", "->", " ", "\"\<Linear\>\""}], ",", "\n", 
     " ", 
     RowBox[{"\"\<tMax\>\"", " ", "->", " ", "400."}], ",", "\n", " ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", "\n", " ", 
     RowBox[{"\"\<tMinPositive\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<LogPoints\>\"", " ", "->", " ", "501"}]}], "\n", "|>"}]}], 
  ";"}]], "Input",ExpressionUUID->"2ebef89b-9aa9-de4e-8e61-42bd126f564f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Diagonalize this Hamiltonian", "Subsection",ExpressionUUID->"a833a5bd-1386-514d-bd4e-f548d83d0fcc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoUsed", " ", "=", " ", "evoModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evoEDSeconds", ",", "evoED"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"sectorED", "[", 
     RowBox[{"evoUsed", ",", "edTolerance"}], " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoSectors", " ", "=", " ", 
   RowBox[{"sectorTable", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ED seconds: \>\"", ",", "evoEDSeconds", 
    ",", "\"\<; tolerance: \>\"", ",", "edTolerance"}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "evoSectors", "]"}]}], "Input",ExpressionUUID->\
"b37d0715-2ee3-af43-aae6-db35ec774c4e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.4 Optional fixed-Delta eigenstate plots", "Subsection",ExpressionUUID->"a4be1b98-92f9-5a4d-b8f3-847f7c2ac831"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoEigenstates", " ", "=", " ", 
   RowBox[{"addEntropies", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoEnergies", " ", "=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"evoEigenstates", "[", "\"\<Sectors\>\"", "]"}], 
     ",", "\"\<Eigenvalues\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "evoEnergies", " ", "]"}], "]"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#1", " ", "]"}], "]"}], "]"}], "==", 
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#2", " ", "]"}], "]"}], "]"}]}], " ", "&&", "\n", " ", 
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#1", " ", "]"}], "]"}], "-", 
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#2", " ", "]"}], "]"}]}], "]"}], "<", 
        RowBox[{"matchingTolerance", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "evoEnergies", " ", "]"}]}], "]"}]}]}]}], 
      "&"}]}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"ac00e54a-0dee-984a-\
82da-dcad730e87d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedEnergyPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<Eigenvalues\>\"", 
     ",", "\"\<E_n\>\"", ",", "\"\<\\\\text{Sector energies}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedHalfPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<HalfEntropy\>\"", ",", "\n",
      " ", "\"\<S_{\\\\mathrm{half}}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Half-chain eigenstate entanglement}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedEdgePlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<EdgesEntropy\>\"", ",", 
     "\n", " ", "\"\<S_{AB|E}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Edges versus middle eigenstate entanglement}\>\""}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"6b21d087-b84a-9646-b61a-\
bc7f8d4bd054"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["6. Initial states for this evolution", "Section",ExpressionUUID->"2de1b958-530a-514e-a193-184b65a2d9ab"],

Cell[CellGroupData[{

Cell["6.1 Choose factorized or full-chain mode", "Subsection",ExpressionUUID->"730ebcd8-e52e-0945-9444-5dbe915ca460"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stateMode", " ", "=", " ", "\"\<Factorized\>\""}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Choose", " ", "\"\<Factorized\>\"", " ", "or", " ", "\"\<Full\>\"", " ", 
    "here", " ", 
    RowBox[{"only", "."}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"a4d8ddef-7fa4-1844-bd5f-616dfa2d09f5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 State of the two edge spins", "Subsection",ExpressionUUID->"2bb3ceae-23df-834c-85d3-83bf11781857"],

Cell["\<\
Used only in Factorized mode. Basis {00,01,10,11}; vector or 4 x 4 density \
matrix. One active assignment.\
\>", "Text",ExpressionUUID->"0266bcba-cd15-9a45-acdc-472e4c936434"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgeState", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4."}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"9928333a-1260-6d44-9f48-1fe544d642d2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3 State of the middle spins", "Subsection",ExpressionUUID->"7206c5f9-b169-9c4f-8c46-5b17bd3208ba"],

Cell["\<\
Physical order {2,...,L-1}. neel[n,0] starts with up on physical site 2. A \
middle helix starts its phase at site 2.\
\>", "Text",ExpressionUUID->"9da59734-bf51-fa4c-8f64-b70b65c2d2b0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"middleState", " ", "=", " ", 
   RowBox[{"neel", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"productKet", "[", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{
        RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"helix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], "."}]}], " ", "*)"}]}]}], "Input",Ex\
pressionUUID->"ece0fb16-8fd6-2a49-8f80-2f8f420337dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4 Full initial state", "Subsection",ExpressionUUID->"6032721a-cd1f-5b4e-9c9f-1f052bbb038d"],

Cell["\<\
Used only in Full mode. This default is a non-eigenstate initial condition. \
To study a stationary state deliberately, replace it with groundKet[evoED] or \
eigenket[evoED,sector,level].\
\>", "Text",ExpressionUUID->"dd931be7-8bbd-9644-9f0f-5ac7843f8023"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullState", " ", "=", " ", 
   RowBox[{"helix", "[", 
    RowBox[{
     RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], ",", 
     RowBox[{"Pi", "/", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"neel", "[", 
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "]"}]}], ",", " ", 
    RowBox[{"groundKet", "[", "evoED", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"eigenket", "[", 
      RowBox[{"evoED", ",", "3", ",", "1"}], "]"}], "."}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"ba70a6c2-0d6c-d340-8583-e2c9883c366b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.5 Assemble and inspect the initial state", "Subsection",ExpressionUUID->"c1d7e5c5-73b6-284a-a1d0-ed1ee0f50666"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "stateMode"}], "]"}], ",", "\"\<Invalid stateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"stateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"edgeFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"edgeState", ",", "4", ",", "validationTolerance"}], "]"}]}], ";",
      "\n", " ", 
     RowBox[{"middleFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"middleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}], ",",
         "validationTolerance"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"fullFactor", " ", "=", " ", 
      RowBox[{"joinStates", "[", 
       RowBox[{"edgeFactor", ",", "middleFactor", ",", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", "\n", 
    " ", 
    RowBox[{"fullFactor", " ", "=", " ", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"fullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "validationTolerance"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoEdge0", " ", "=", " ", 
    RowBox[{"reducedState", "[", 
     RowBox[{"fullFactor", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
      RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Check", " ", "the", " ", "assembled", " ", "state"}], ",", " ", 
    RowBox[{"in", " ", "either", " ", "mode"}], ",", " ", 
    RowBox[{"including", " ", "pure", " ", "factorized", " ", 
     RowBox[{"inputs", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Dimensions", "[", "fullFactor", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "==", "1"}], ",", "\n", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", "=", 
         RowBox[{"fullFactor", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"h", "=", 
         RowBox[{"evoED", "[", "\"\<Hamiltonian\>\"", "]"}]}]}], "}"}], ",", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"initialEnergyResidual", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"h", " ", ".", " ", "v"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "h", " ", ".",
              " ", "v"}], ")"}], " ", "v"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"initialEnergyResidual", "<=", 
          RowBox[{"validationTolerance", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Norm", "[", 
              RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], ",", "\n", 
         "   ", 
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Initial state is an energy eigenstate within \
tolerance: reduced observables will be stationary.\>\"", ",", "DarkOrange"}], 
           "]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "rhoEdge0", "]"}]}], "Input",ExpressionUUID->\
"b8c8d58c-9993-a142-9006-20bcc2245d23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.6 Prepare the evolution coefficients", "Subsection",ExpressionUUID->"aa43786c-f8fb-934a-85ea-e57a9942a524"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"engine", " ", "=", " ", 
   RowBox[{"makeEngine", "[", 
    RowBox[{"evoED", ",", "fullFactor"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Occupied sectors: \>\"", ",", 
    RowBox[{"Length", "[", 
     RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}], "]"}], ",", "\n", 
    " ", "\"\<; initial factor columns: \>\"", ",", 
    RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"33b01c73-7095-964b-9509-589ae834de43"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["7. Evolution, observables, and exports", "Section",ExpressionUUID->"857a6f73-28cf-9946-bc6b-c7e53c9e47fb"],

Cell[CellGroupData[{

Cell["7.1 Generate the time grid", "Subsection",ExpressionUUID->"39acdbd8-cd25-4146-b1de-99235a9e06d0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoTimeUsed", " ", "=", " ", "evoTime"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"times", " ", "=", " ", 
   RowBox[{"timeGrid", "[", "evoTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
