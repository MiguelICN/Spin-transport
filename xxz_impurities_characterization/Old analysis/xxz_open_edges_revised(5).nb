           RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
           "]"}], ",", 
          RowBox[{"10", "^", 
           RowBox[{"-", "10"}]}]}], "]"}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
