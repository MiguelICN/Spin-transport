Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Negativity", " ", "between", " ", "spin", " ", "1", " ", "and", " ", 
    "spin", " ", 
    RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ptB", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"r", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"negativity", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"herm", "[", 
            RowBox[{"ptB", "[", "r", " ", "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Concurrence", " ", "from", " ", "an", " ", "exact", " ", "reduced"}], "-", 
      RowBox[{"state", " ", "factor"}]}], ";", " ", 
     RowBox[{"stable", " ", "at", " ", "rank", " ", 
      RowBox[{"deficiency", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"concurrence", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r", ",", "f", ",", "s"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", ",", "r"}], "}"}], "=", 
         RowBox[{"QRDecomposition", "[", 
          RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}], "]"}]}], ";", 
        " ", 
        RowBox[{"f", "=", 
         RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], ";", "\n", " ", 
        RowBox[{"s", "=", 
         RowBox[{"PadRight", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"SingularValueList", "[", "\n", "  ", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", "f", "]"}], " ", ".", " ", 
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
                  RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
                " ", "f"}], ",", 
               RowBox[{"Tolerance", "->", "0"}]}], "]"}], "]"}], "]"}], ",", 
           "4"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"0.", ",", 
          RowBox[{
           RowBox[{"First", "[", "s", "]"}], "-", 
           RowBox[{"Total", "[", 
            RowBox[{"Rest", "[", "s", " ", "]"}], "]"}]}]}], "]"}]}]}], "\n", 
      "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"601ddfe4-af07-f44d-91e6-\
