            "]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Filled", " ", "and", " ", "larger", " ", "open", " ", "markers", " ", 
     "keep", " ", "overlapping", " ", "sectors", " ", 
     RowBox[{"visible", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"pointMarkers", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"Table", "[", 
