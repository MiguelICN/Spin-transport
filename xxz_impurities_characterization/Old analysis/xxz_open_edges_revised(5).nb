              ",", "\n", "    ", 
             RowBox[{"MatrixQ", "[", 
              RowBox[{
               RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], ",", 
               "NumericQ"}], "]"}]}], "]"}]}], 
          ",", "\"\<ED Hamiltonian has invalid dimensions or entries.\>\""}], 
         "]"}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Dimensions", "[", "fac", "]"}], "]"}], "==", "2"}], " ",
            "&&", " ", 
           RowBox[{
