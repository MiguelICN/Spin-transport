   RowBox[{
    RowBox[{"12.4", "a"}], " ", "\[LongDash]", " ", 
    RowBox[{"Editable", " ", "DOS", " ", "settings"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"check", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "exRatioSpectra", "]"}], " ", "&&", " ", 
      RowBox[{"ValueQ", "[", "exRatioModelUsed", "]"}], " ", "&&", " ", 
      RowBox[{"ValueQ", "[", "exRatioGUsed", "]"}]}], ",", "\n", 
     "  ", "\"\<Run the independent spectrum cell 12.4a first.\>\""}], "]"}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Choose", " ", "existing", " ", "g", " ", 
    RowBox[{"samples", ".", " ", "You"}], " ", "can", " ", "replace", " ", 
    "this", " ", "with", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.1", ",", "0.5", ",", "1."}], "}"}], "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"exDOSGValues", " ", "=", " ", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"First", "[", "exRatioGUsed", "]"}], ",", "\n", "   ", 
      RowBox[{"exRatioGUsed", "[", 
       RowBox[{"[", 
        RowBox[{"Ceiling", "[", 
         RowBox[{
          RowBox[{"Length", "[", "exRatioGUsed", "]"}], "/", "2"}], "]"}], 
        "]"}], "]"}], ",", "\n", "   ", 
      RowBox[{"Last", "[", "exRatioGUsed", "]"}]}], "\n", "   ", "}"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSBins", " ", "=", " ", "30"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exDOSNormalize", " ", "=", " ", "True"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"True", ":", " ", 
     RowBox[{"integral", " ", "1"}]}], ";", " ", 
    RowBox[{"False", ":", " ", 
     RowBox[{"integral", " ", 
      RowBox[{"D", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"exDOSOutputRoot", "=", "exRatioOutputRoot"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSRunLabel", " ", "=", " ", "\"\<Exchange_DOS\>\""}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSWindowUsed", " ", "=", " ", 
   RowBox[{"exRatioSettings", "[", "\"\<RankWindow\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSSectorUsed", " ", "=", " ", "exRatioSector"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSModelUsed", " ", "=", " ", "exRatioModelUsed"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exDOSSettingsUsed", " ", "=", " ", 
   RowBox[{"<|", "\n", "   ", 
    RowBox[{
     RowBox[{"\"\<Bins\>\"", " ", "->", " ", "exDOSBins"}], ",", "\n", "   ", 
     RowBox[{"\"\<Normalized\>\"", " ", "->", " ", "exDOSNormalize"}], ",", 
     "\n", "   ", 
     RowBox[{"\"\<RankWindow\>\"", " ", "->", " ", "exDOSWindowUsed"}]}], 
    "\n", "   ", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegerQ", "[", "exDOSBins", "]"}], " ", "&&", " ", 
     RowBox[{"exDOSBins", " ", ">=", " ", "2"}], " ", "&&", "\n", "   ", 
     RowBox[{"MemberQ", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"True", ",", " ", "False"}], "}"}], ",", " ", 
       "exDOSNormalize"}], "]"}]}], ",", "\n", 
    "  ", "\"\<Invalid DOS settings.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
