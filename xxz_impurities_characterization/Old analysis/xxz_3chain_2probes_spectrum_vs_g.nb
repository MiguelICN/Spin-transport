     RowBox[{"\"\<g\>\"", ",", "\"\<E\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<XXZ edge coupling: g = 0 to 1\>\""}], ",", 
   RowBox[{"ImageSize", "->", "600"}]}], "]"}]], "Input",
 CellLabel->
  "In[160]:=",ExpressionUUID->"fb3abf85-2c9b-4e49-a630-cd12e130ee78"],

