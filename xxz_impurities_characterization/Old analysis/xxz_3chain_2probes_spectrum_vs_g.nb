Notebook[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Five", "-", 
     RowBox[{"spin", " ", 
      RowBox[{"order", ":", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"A", ",", "1", ",", "2", ",", "3", ",", "B"}], "}"}], ".", 
        "  ", "S"}]}]}]}], " ", "=", " ", 
    RowBox[{"sigma", "/", "2."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Nspin", " ", "=", " ", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dim", " ", "=", " ", 
     RowBox[{"2", "^", "Nspin"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"J", " ", "=", " ", "1."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"delta", " ", "=", " ", "0.5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omegaA", " ", "=", " ", "0.6"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"omegaB", " ", "=", " ", "0.9"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gList", " ", "=", " ", 
     RowBox[{"Range", "[", 
      RowBox[{"0.", ",", " ", "0.5", ",", " ", "0.001"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{4.0003559266808205`*^9, 4.0003559388298664`*^9}, {
  4.000356219971264*^9, 4.000356220020771*^9}, {4.000356541417139*^9, 
  4.0003565418647804`*^9}, {4.000517885447277*^9, 4.0005178859677753`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"2a88870f-b1ec-b044-9682-808140398a8c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"id", " ", "=", " ", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sx0", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sy0", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sz0", " ", "=", " ", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"op", "[", 
    RowBox[{"a_", ",", " ", "j_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", " ", "@@", " ", 
    RowBox[{"ReplacePart", "[", 
     RowBox[{
      RowBox[{"ConstantArray", "[", 
       RowBox[{"id", ",", " ", "Nspin"}], "]"}], ",", " ", 
      RowBox[{"j", " ", "->", " ", "a"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sx", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"op", "[", 
    RowBox[{"sx0", ",", " ", "j"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sy", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"op", "[", 
    RowBox[{"sy0", ",", " ", "j"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sz", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{"op", "[", 
    RowBox[{"sz0", ",", " ", "j"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sp", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"sx", "[", "j", "]"}], " ", "+", " ", 
    RowBox[{"I", " ", 
     RowBox[{"sy", "[", "j", "]"}]}]}]}], ";", " ", 
  RowBox[{
   RowBox[{"sm", "[", "j_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"sx", "[", "j", "]"}], " ", "-", " ", 
    RowBox[{"I", " ", 
     RowBox[{"sy", "[", "j", "]"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.0003559502221622`*^9, 4.000355955590412*^9}, {
  4.000355992008257*^9, 4.0003559951846695`*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"1ba01a4d-9ea4-1f47-b502-48a9de1cb38d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Hchain", " ", "=", " ", 
   RowBox[{"J", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"sx", "[", "2", "]"}], ".", 
       RowBox[{"sx", "[", "3", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"sy", "[", "2", "]"}], ".", 
       RowBox[{"sy", "[", "3", "]"}]}], " ", "+", " ", 
      RowBox[{"delta", " ", 
       RowBox[{
        RowBox[{"sz", "[", "2", "]"}], ".", 
        RowBox[{"sz", "[", "3", "]"}]}]}], "+", 
      RowBox[{
       RowBox[{"sx", "[", "3", "]"}], ".", 
       RowBox[{"sx", "[", "4", "]"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"sy", "[", "3", "]"}], ".", 
       RowBox[{"sy", "[", "4", "]"}]}], " ", "+", " ", 
      RowBox[{"delta", " ", 
       RowBox[{
        RowBox[{"sz", "[", "3", "]"}], ".", 
        RowBox[{"sz", "[", "4", "]"}]}]}]}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0003561160274353`*^9, 4.0003561197131577`*^9}, {
