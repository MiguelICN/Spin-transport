Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"J", "=", "1."}], ";"}], "\n", 
 RowBox[{
  RowBox[{"delta", "=", "10."}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gList", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0.", ",", "1.", ",", "0.001"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"id", "=", 
   RowBox[{"IdentityMatrix", "[", "2", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sx0", "=", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sy0", "=", 
   RowBox[{
    RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sz0", "=", 
    RowBox[{
     RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"op", "[", 
     RowBox[{"a_", ",", "j_"}], "]"}], ":=", 
    RowBox[{"KroneckerProduct", "@@", 
     RowBox[{"ReplacePart", "[", 
      RowBox[{
       RowBox[{"ConstantArray", "[", 
        RowBox[{"id", ",", "L"}], "]"}], ",", 
       RowBox[{"j", "->", "a"}]}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sx", "[", "j_", "]"}], ":=", 
   RowBox[{"op", "[", 
    RowBox[{"sx0", ",", "j"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sy", "[", "j_", "]"}], ":=", 
   RowBox[{"op", "[", 
    RowBox[{"sy0", ",", "j"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sz", "[", "j_", "]"}], ":=", 
    RowBox[{"op", "[", 
     RowBox[{"sz0", ",", "j"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bond", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"J", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"sx", "[", "i", "]"}], ".", 
       RowBox[{"sx", "[", "j", "]"}]}], "+", 
      RowBox[{
       RowBox[{"sy", "[", "i", "]"}], ".", 
       RowBox[{"sy", "[", "j", "]"}]}], "+", 
      RowBox[{"delta", " ", 
       RowBox[{
        RowBox[{"sz", "[", "i", "]"}], ".", 
        RowBox[{"sz", "[", "j", "]"}]}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Hbulk", "=", 
   RowBox[{
    RowBox[{"bond", "[", 
     RowBox[{"2", ",", "3"}], "]"}], "+", 
    RowBox[{"bond", "[", 
     RowBox[{"3", ",", "4"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Vedge", "=", 
   RowBox[{
    RowBox[{"bond", "[", 
     RowBox[{"1", ",", "2"}], "]"}], "+", 
    RowBox[{"bond", "[", 
     RowBox[{"4", ",", "5"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{4.000357576257622*^9, 4.0003576377212563`*^9}},
 CellLabel->
  "In[197]:=",ExpressionUUID->"5fa800dc-6efc-7e4e-8742-b3244caa0082"],

Cell[BoxData[
 RowBox[{
  RowBox[{"energies", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sort", "[", 
      RowBox[{"Chop", "[", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"N", "[", 
         RowBox[{"Hbulk", "+", 
          RowBox[{"g", " ", "Vedge"}]}], "]"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"g", ",", "gList"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[213]:=",ExpressionUUID->"9e3d54b0-fb13-ba46-86df-9e87cda44fb7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"gList", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"energies", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "n"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "gList", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", 
         RowBox[{"2", "^", "L"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
