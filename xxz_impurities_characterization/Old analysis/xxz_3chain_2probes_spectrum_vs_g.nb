Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"2.", " ", "ZZ", " ", "coupling"}], ",", " ", 
    RowBox[{"with", " ", "probe", " ", "Zeeman", " ", "splitting"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"ezzZ", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sort", "[", 
