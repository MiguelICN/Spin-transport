Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"1.", " ", "ZZ", " ", "coupling"}], ",", " ", 
    RowBox[{"no", " ", "Zeeman", " ", "splitting"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ezz0", " ", "=", " ", 
