Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"4.", " ", "Exchange", " ", "coupling"}], ",", " ", 
    RowBox[{"with", " ", "probe", " ", "Zeeman", " ", "splitting"}]}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{"eexZ", " ", "=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sort", "[", 
       RowBox[{"Chop", "[", 
        RowBox[{"Eigenvalues", "[", 
         RowBox[{"N", "[", 
          RowBox[{"Hchain", " ", "+", " ", "HZ", " ", "+", " ", 
           RowBox[{"g", " ", "Vex"}]}], "]"}], "]"}], "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"g", ",", " ", "gList"}], "}"}]}], "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[102]:=",ExpressionUUID->"d085088e-8bbc-794c-a71e-80020e74ce87"],

