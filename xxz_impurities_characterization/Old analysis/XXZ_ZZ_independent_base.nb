Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"occupiedEngine", "[", 
       RowBox[{"p_Association", ",", "fac_", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"projectionCut_", ":", "0"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"setup", "=", 
           RowBox[{"regimeSetup", "[", 
            RowBox[{"p", ",", "tol"}], "]"}]}], ",", "weight", ",", "norm2", ",", 
          RowBox[{"weights", "=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"blocks", "=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"discarded", "=", "0."}], ",", "s", ",", "ids", ",", "b", ",",
           "cf", ",", "ed", ",", "c", ",", "eng", ",", "err"}], "}"}], ",", 
        "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MatrixQ", "[", 
             RowBox[{"fac", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "fac", "]"}], "==", 
             RowBox[{"2", "^", 
              RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}], ">=", "1"}]}], 
           ",", "\"\<Initial factor has invalid dimensions.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"realQ", "[", "projectionCut", "]"}], " ", "&&", " ", 
            RowBox[{"projectionCut", ">=", "0"}]}], 
           ",", "\"\<Projection cutoff must be nonnegative.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"norm2", "=", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"fac", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}]}], ";", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"norm2", ">", "0"}], 
           ",", "\"\<The factor has zero norm.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ids", "=", 
             RowBox[{"s", "[", "\"\<Indices\>\"", "]"}]}], ";", 
            RowBox[{"b", "=", 
             RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
            RowBox[{"cf", "=", 
             RowBox[{
              RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
              RowBox[{"fac", "[", 
               RowBox[{"[", 
                RowBox[{"ids", ",", "All"}], "]"}], "]"}]}]}], ";", "\n", 
            "  ", 
            RowBox[{"weight", "=", 
             RowBox[{
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{"cf", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "/",
               "norm2"}]}], ";", "\n", "  ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"weights", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Labels\>\"", "->", 
                 RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
                RowBox[{"\"\<Dimension\>\"", "->", 
                 RowBox[{
                  RowBox[{"Dimensions", "[", "b", "]"}], "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<Weight\>\"", "->", "weight"}], ",", "\n", "   ", 
                RowBox[{"\"\<Diagonalized\>\"", "->", 
                 RowBox[{"TrueQ", "[", 
                  RowBox[{"weight", ">", "projectionCut"}], "]"}]}]}], 
               "|>"}]}], "]"}], ";", "\n", "  ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"weight", ">", "projectionCut"}], ",", "\n", "   ", 
              RowBox[{
               RowBox[{"ed", "=", 
                RowBox[{"diagonalizeBlock", "[", 
                 RowBox[{"s", ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"setup", "[", "\"\<Hamiltonian\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                   "ids", ",", "tol"}], "]"}]}], ";", "\n", "   ", 
               RowBox[{"c", "=", 
                RowBox[{
                 RowBox[{"Conjugate", "[", 
                  RowBox[{"ed", "[", "\"\<Vectors\>\"", "]"}], "]"}], " ", ".",
                  " ", 
                 RowBox[{"fac", "[", 
                  RowBox[{"[", 
                   RowBox[{"ids", ",", "All"}], "]"}], "]"}]}]}], ";", "\n", 
               "   ", 
               RowBox[{"AppendTo", "[", 
                RowBox[{"blocks", ",", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<Labels\>\"", "->", 
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
                   RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", 
                   RowBox[{"\"\<E\>\"", "->", 
                    RowBox[{"ed", "[", "\"\<Eigenvalues\>\"", "]"}]}], ",", 
                   "\n", "    ", 
                   RowBox[{"\"\<V\>\"", "->", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"ed", "[", "\"\<Vectors\>\"", "]"}], "]"}]}], ",", 
                   RowBox[{"\"\<C\>\"", "->", "c"}], ",", 
                   RowBox[{"\"\<Weight\>\"", "->", "weight"}], ",", 
                   RowBox[{"\"\<Residual\>\"", "->", 
                    RowBox[{"ed", "[", "\"\<Residual\>\"", "]"}]}]}], 
                  "|>"}]}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"discarded", "+=", "weight"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}]}], "}"}]}], "]"}], 
         ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"weights", ",", "\"\<Weight\>\""}], "]"}], "]"}], "-",
               "1"}], "]"}], "<", 
            RowBox[{"100", " ", "tol"}]}], 
           ",", "\"\<Sector projection weights do not sum to one.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "blocks", "]"}], ">", "0"}], " ", "&&", 
            " ", 
            RowBox[{"discarded", "<=", 
             RowBox[{"tol", "^", "2"}]}]}], 
           ",", "\"\<Discarded sector weight exceeds EDTolerance^2; reduce \
ProjectionCutoff.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"eng", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Parameters\>\"", "->", 
             RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
            RowBox[{"\"\<L\>\"", "->", 
             RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Dimension\>\"", "->", 
             RowBox[{"Length", "[", "fac", "]"}]}], ",", "\n", "  ", 
            RowBox[{"\"\<Columns\>\"", "->", 
             RowBox[{
              RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Sectors\>\"", "->", "blocks"}], ",", 
            RowBox[{"\"\<SectorWeights\>\"", "->", "weights"}], ",", "\n", 
            "  ", 
            RowBox[{"\"\<DiscardedWeight\>\"", "->", "discarded"}], ",", 
            RowBox[{"\"\<InputNormSquared\>\"", "->", "norm2"}], ",", 
            RowBox[{"\"\<SetupAudit\>\"", "->", 
             RowBox[{"setup", "[", "\"\<Audit\>\"", "]"}]}]}], "|>"}]}], ";", 
         "\n", " ", 
         RowBox[{"err", "=", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"evolve", "[", 
               RowBox[{"0", ",", "eng"}], "]"}], "-", "fac"}], 
             ",", "\"\<Frobenius\>\""}], "]"}], "/", 
           RowBox[{"Sqrt", "[", "norm2", "]"}]}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"err", "<", 
            RowBox[{"100", " ", "tol"}]}], 
           ",", "\"\<Initial-factor reconstruction failed.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"Append", "[", 
          RowBox[{"eng", ",", 
           RowBox[{"\"\<ReconstructionError\>\"", "->", "err"}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"evolveDot", "[", 
       RowBox[{"t_", ",", "engine_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
              RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
           "]"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], 
              "]"}], "]"}], "+=", 
            RowBox[{
             RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", 
                 RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", 
                 RowBox[{"Exp", "[", 
                  RowBox[{
                   RowBox[{"-", "I"}], " ", 
                   RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}]}], 
                ")"}], " ", 
               RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], 
          "]"}], ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[26]:=",ExpressionUUID->"4eb463d2-cdf4-db49-9459-b30059a87c27"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Time grids ", "Subsubsection",ExpressionUUID->"cc3bc3b2-8b88-7949-abc8-99192049ea93"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Linear", " ", "or", " ", "logarithmic", " ", "sampling"}], ",",
       " ", 
      RowBox[{
       RowBox[{"including", " ", "t"}], "=", 
       RowBox[{"0.", " ", "Linear", " ", "dt", " ", "is", " ", 
        RowBox[{"nominal", ":", " ", 
         RowBox[{"the", " ", "last", " ", "step", " ", "may", " ", "be", " ", 
          RowBox[{"shorter", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "t", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"realQ", "[", 
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
           ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Switch", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
            "\n", "  ", 
           RowBox[{
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"realQ", "[", 
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
              ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
            RowBox[{"t", "=", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", 
                 RowBox[{"Floor", "[", 
                  RowBox[{
                   RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                   RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], 
                "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Last", "[", "t", "]"}], "-", 
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
               RowBox[{
                RowBox[{"10", "^", 
                 RowBox[{"-", "12"}]}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",",
               "\n", "   ", 
              RowBox[{
               RowBox[{"t", "[", 
                RowBox[{"[", 
                 RowBox[{"-", "1"}], "]"}], "]"}], "=", 
               RowBox[{"N", "[", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"t", ",", 
                RowBox[{"N", "[", 
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
             "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
           RowBox[{
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"0", "<", 
                RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
               RowBox[{"IntegerQ", "[", 
                RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
                "\n", "   ", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}],
               ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
            "  ", 
            RowBox[{"t", "=", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"{", "0.", "}"}], ",", 
               RowBox[{"Exp", "[", 
