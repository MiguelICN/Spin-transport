Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chRecord", "[", 
       RowBox[{"t_", ",", "v_", ",", "cfg_", ",", "probes_"}], "]"}], " ", ":=",
       " ", 
      RowBox[{"Module", "[", 
