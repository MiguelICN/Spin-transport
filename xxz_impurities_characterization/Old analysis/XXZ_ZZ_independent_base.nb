           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "bits", ",", "q", ",",
           "ids", ",", "m", ",", "a", ",", "b", ",", "names", ",", "spaces", ",", 
          RowBox[{"out", "=", 
           RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"bits", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"IntegerDigits", "[", 
             RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{
               RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
         RowBox[{"q", "=", 
          RowBox[{"KeyTake", "[", 
           RowBox[{
            RowBox[{"charges", "[", "p", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"q", ",", 
           RowBox[{"\"\<RF\>\"", "->", 
            RowBox[{
             RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
             RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ids", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"2", "^", "l"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{"bits", "[", 
                    RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], 
                 " ", "&&", "\n", "    ", 
                 RowBox[{
                  RowBox[{"bits", "[", 
                   RowBox[{"[", 
                    RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "bitA"}], 
                 " ", "&&", " ", 
                 RowBox[{
                  RowBox[{"bits", "[", 
                   RowBox[{"[", 
                    RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "bitB"}]}], 
                "&"}]}], "]"}]}], ";", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"ids", "===", 
               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
            RowBox[{"m", "=", 
             RowBox[{
              RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
            RowBox[{"a", "=", 
             RowBox[{
              RowBox[{"1", "/", "2"}], "-", "bitA"}]}], ";", 
            RowBox[{"b", "=", 
             RowBox[{
              RowBox[{"1", "/", "2"}], "-", "bitB"}]}], ";", "\n", "  ", 
            RowBox[{"names", "=", 
             RowBox[{"Which", "[", 
              RowBox[{
               RowBox[{"a", "==", "b"}], ",", 
               RowBox[{"{", "\"\<R\>\"", "}"}], ",", 
               RowBox[{"m", "==", "0"}], ",", 
               RowBox[{"{", "\"\<RF\>\"", "}"}], ",", "True", ",", 
               RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"spaces", "=", 
             RowBox[{"{", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Basis\>\"", "->", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", "\n", 
                "    ", 
                RowBox[{"\"\<Labels\>\"", "->", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
                   RowBox[{"\"\<sA\>\"", "->", "a"}], ",", 
                   RowBox[{"\"\<sB\>\"", "->", "b"}], ",", 
                   RowBox[{"\"\<mBulk\>\"", "->", 
                    RowBox[{"m", "-", "a", "-", "b"}]}]}], "|>"}]}]}], "|>"}],
               "}"}]}], ";", "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{"spaces", "=", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"splitCharge", "[", 
                    RowBox[{"#", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                     "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
                  "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"{", 
               RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
            RowBox[{"out", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"out", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"Join", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"<|", 
                    RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}],
                  "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", "\n", 
           "  ", 
           RowBox[{"{", 
            RowBox[{"nDown", ",", "0", ",", "l"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"bitA", ",", "0", ",", "1"}], "}"}], ",", 
           RowBox[{"{", 
