Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstAverageState", "[", 
       RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "scale", ",", "clusters", ",", "r", ",", "widths", ",", "lev", ",", 
          "cross", ",", "f", ",", "x"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
            RowBox[{"relativeTol", ">", "0"}]}], 
           ",", "\"\<Cluster tolerance must be positive.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"maxAbs", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{
               RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], 
               ",", "\"\<E\>\""}], "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"clusters", "=", 
          RowBox[{"energyClusters", "[", 
           RowBox[{"eng", ",", 
            RowBox[{"relativeTol", " ", "scale"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"lev", "[", "item_", "]"}], " ", ":=", " ", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s", "=", 
               RowBox[{
                RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"item", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
              RowBox[{"v", "=", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"0.", "+", 
                  RowBox[{"0.", "I"}]}], ",", 
                 RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}]}], "]"}]}]}], 
             "}"}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"v", "[", 
               RowBox[{"[", 
