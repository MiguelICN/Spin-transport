Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"regimeParentSpaces", "[", 
       RowBox[{"l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"regimeParentSpaces", "[", 
        RowBox[{"l", ",", "tol"}], "]"}], " ", "=", "\n", " ", 
       RowBox[{"zzEdgeSpaces", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
           RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<Delta\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
           RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}], ",", "tol"}], 
        "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"regimeSetup", "[", 
       RowBox[{"p_Association", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"pp", "=", 
           RowBox[{"regimeModel", "[", "p", "]"}]}], ",", "geo", ",", "parts",
           ",", "h", ",", "parents", ",", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", "}"}]}], ",", "ids", ",", "other", ",", "hm", ",", 
          "qq", ",", "extra", ",", "children", ",", "groups", ",", "all", ",",
           "b", ",", 
          RowBox[{"basisError", "=", "0."}], ",", 
          RowBox[{"leak", "=", "0."}], ",", "scale"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"geo", "=", 
          RowBox[{"geometryParameters", "[", "pp", "]"}]}], ";", 
         RowBox[{"parts", "=", 
          RowBox[{"regimeParts", "[", "pp", "]"}]}], ";", "\n", " ", 
         RowBox[{"h", "=", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"parts", "[", "\"\<Bulk\>\"", "]"}], "+", 
            RowBox[{
             RowBox[{"pp", "[", "\"\<g\>\"", "]"}], " ", 
             RowBox[{"parts", "[", "\"\<Interaction\>\"", "]"}]}]}], "]"}]}], 
         ";", "\n", " ", 
         RowBox[{"realSectorCheck", "[", 
          RowBox[{"h", ",", 
           RowBox[{"pp", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"parents", "=", 
          RowBox[{"regimeParentSpaces", "[", 
           RowBox[{
            RowBox[{"pp", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ids", "=", 
             RowBox[{"parent", "[", "\"\<Indices\>\"", "]"}]}], ";", "\n", 
            "  ", 
            RowBox[{"children", "=", 
             RowBox[{"{", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Basis\>\"", "->", 
                 RowBox[{"parent", "[", "\"\<Basis\>\"", "]"}]}], ",", 
                RowBox[{"\"\<Labels\>\"", "->", 
                 RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], 
              "}"}]}], ";", "\n", "  ", 
            RowBox[{"other", "=", 
             RowBox[{"Complement", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"2", "^", 
                 RowBox[{"pp", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "ids"}],
               "]"}]}], ";", 
            RowBox[{"hm", "=", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{"h", "[", 
                RowBox[{"[", 
                 RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
             "\n", "  ", 
            RowBox[{"qq", "=", 
             RowBox[{"zzBulkCharges", "[", 
              RowBox[{
               RowBox[{"pp", "[", "\"\<g\>\"", "]"}], ",", "geo", ",", 
               RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], ";",
             "\n", "  ", 
            RowBox[{"qq", "=", 
             RowBox[{"KeySelect", "[", 
              RowBox[{"qq", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"qq", "[", "#", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "<", 
                 RowBox[{"tol", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"qq", "[", "#", "]"}], ",", "Infinity"}], "]"}]}],
                    "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"extra", "=", 
             RowBox[{"Association", "[", 
              RowBox[{"KeyValueMap", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#1", "->", 
                  RowBox[{"N", "[", 
                   RowBox[{"Normal", "[", 
                    RowBox[{"#2", "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}],
                  "&"}], ",", "qq"}], "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"extra", "=", 
             RowBox[{"KeySelect", "[", 
              RowBox[{"extra", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"hm", " ", ".", " ", 
                    RowBox[{"extra", "[", "#", "]"}]}], "-", 
                   RowBox[{
                    RowBox[{"extra", "[", "#", "]"}], " ", ".", " ", "hm"}]}],
                   "]"}], "<", 
                 RowBox[{"tol", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{"hm", ",", "Infinity"}], "]"}]}], "]"}], " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"extra", "[", "#", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"children", "=", 
             RowBox[{"edgeRefine", "[", 
              RowBox[{"children", ",", "extra", ",", "tol"}], "]"}]}], ";", 
            "\n", "  ", 
            RowBox[{"spaces", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"spaces", ",", 
