        ",", "\n", " ", 
        RowBox[{
         RowBox[{"dt", "=", 
          RowBox[{"Differences", "[", "t", "]"}]}], ";", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", "\n", " ", 
            RowBox[{
             RowBox[{"qstTex", "[", 
              RowBox[{
               RowBox[{"\"\<\\\\mathrm{ZZ}: L=\>\"", "<>", 
                RowBox[{"texNumber", "[", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
                "<>", "\"\<; J=\>\"", "<>", 
