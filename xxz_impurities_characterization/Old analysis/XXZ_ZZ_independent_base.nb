                    "&"}], " ", "/@", " ", "pairs"}], ")"}]}], "}"}]}], "]"}],
                     "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";", 
              "\n", "   ", 
              RowBox[{"AssociateTo", "[", 
