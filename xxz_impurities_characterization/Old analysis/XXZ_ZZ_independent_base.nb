Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"spinCurrentOp", "[", "jxy_", "]"}], " ", ":=", " ", 
      RowBox[{"jxy", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
            RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], "-", "\n", " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
            RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], ")"}], "/", 
        "4"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"stateRecord", "[", 
       RowBox[{
       "t_", ",", "a_", ",", "eng_", ",", "fac0_", ",", "rho0_", ",", 
        "purity0_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], ",", "rec", ",", "pauli",
           ",", "axes", ",", "ra", ",", "rb", ",", "rr", ",", "ma", ",", "mb",
           ",", "c", ",", "extra", ",", "cur"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"rec", "=", 
          RowBox[{"observables", "[", 
           RowBox[{"t", ",", 
            RowBox[{"partitionFactor", "[", 
             RowBox[{"a", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}], ",", 
            "rho0"}], "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"ra", ",", "rb", ",", "rr"}], "}"}], "=", 
          RowBox[{"Lookup", "[", 
           RowBox[{"rec", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<RhoA\>\"", ",", "\"\<RhoB\>\"", 
              ",", "\"\<RhoAB\>\""}], "}"}]}], "]"}]}], ";", 
         RowBox[{"pauli", "=", 
          RowBox[{"PauliMatrix", " ", "/@", " ", 
           RowBox[{"Range", "[", "3", "]"}]}]}], ";", 
         RowBox[{"axes", "=", 
          RowBox[{"{", 
           RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}],
          ";", "\n", " ", 
         RowBox[{"ma", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"#", " ", ".", " ", "ra"}], "]"}], "]"}], "&"}], " ", "/@",
            " ", "pauli"}]}], ";", 
         RowBox[{"mb", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"#", " ", ".", " ", "rb"}], "]"}], "]"}], "&"}], " ", "/@",
            " ", "pauli"}]}], ";", "\n", " ", 
         RowBox[{"c", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{
                 RowBox[{"pauli", "[", 
                  RowBox[{"[", "i", "]"}], "]"}], ",", 
                 RowBox[{"pauli", "[", 
                  RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", ".", " ", 
               "rr"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"cur", "=", 
          RowBox[{"{", 
           RowBox[{"0.", ",", "0."}], "}"}]}], ";", "\n", " ", 
         RowBox[{"extra", "=", 
          RowBox[{"Association", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"\"\<PurityA\>\"", "->", 
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"ra", " ", ".", " ", "ra"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<PurityB\>\"", "->", 
                RowBox[{"Re", "[", 
                 RowBox[{"Tr", "[", 
                  RowBox[{"rb", " ", ".", " ", "rb"}], "]"}], "]"}]}], ",", 
               "\n", "   ", 
               RowBox[{"\"\<FullOverlap\>\"", "->", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".",
                     " ", "a"}], ",", "\"\<Frobenius\>\""}], "]"}], "^", 
                  "2"}], "/", "purity0"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<CurrentLeft\>\"", "->", 
                RowBox[{"cur", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<CurrentRight\>\"", "->", 
                RowBox[{"cur", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<LocalA\>\"", "<>", 
                 RowBox[{"axes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                RowBox[{"ma", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"\"\<LocalB\>\"", "<>", 
                 RowBox[{"axes", "[", 
                  RowBox[{"[", "i", "]"}], "]"}]}], "->", 
                RowBox[{"mb", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "  ", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"\"\<Correlation\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", "\n", "   ", 
                   RowBox[{
                    RowBox[{"\"\<Connected\>\"", "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "<>", 
                    RowBox[{"axes", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                    RowBox[{
                    RowBox[{"ma", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"mb", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "3"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "2"}], 
              "]"}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"rec", ",", "extra"}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"stateTrajectory", "[", 
       RowBox[{"eng_", ",", "fac0_", ",", "times_List", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rho0", ",", "purity0", ",", "recs"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">=", "1"}]}], 
           ",", "\"\<Supply real times.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"rho0", "=", 
          RowBox[{"reducedState", "[", 
           RowBox[{"fac0", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
         RowBox[{"purity0", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", 
               " ", "fac0"}], ")"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", 
               " ", "fac0"}], ")"}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"recs", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"stateRecord", "[", 
             RowBox[{"t", ",", 
              RowBox[{"evolve", "[", 
               RowBox[{"t", ",", "eng"}], "]"}], ",", "eng", ",", "fac0", ",",
               "rho0", ",", "purity0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"recs", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
              "tol"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"recs", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], ">=", 
             RowBox[{"-", "tol"}]}]}], 
           ",", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", 
         "\n", " ", "recs"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[70]:=",ExpressionUUID->"94fc2a46-59ce-6946-a437-1606d1219cb3"],

Cell["\<\
 This chapter uses only initialization definitions. It does not use a static \
scan, its parameters, or its eigenvectors. The initial state may be an \
edge/bulk product or any valid full-chain vector/density matrix, including a \
correlated state. Sector projections are computed before ED. The complex \
amplitudes between occupied sectors are retained in the full evolving factor; \
sector projection is not a dephasing operation. \
\>", "Text",ExpressionUUID->"4acbc658-ce33-0645-a9e8-d21106178aa5"],

Cell["\<\
 The ZZ propagator is block diagonal in the two fixed edge spins. Only \
occupied conditional-bulk subspaces are diagonalized. Edge populations and z \
magnetizations stay fixed, boundary spin currents vanish, and coherences \
evolve through overlaps of different conditional-bulk trajectories. A \
correlated full initial state is handled by its full factor in these same \
blocks. \
\>", "Text",ExpressionUUID->"ad99bc11-ac1c-a442-b45e-cdb3f75660b0"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell[" 2.2 Independent model and time parameters ", "Subsection",ExpressionUUID->"1325f8b7-4a3d-8f49-9d80-743a9408ebda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"dynModel", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
        RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
        RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"dynTime", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
        RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
        RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
        RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
        RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"dynSettings", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<EDTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<ValidationTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", 
        RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}]}], "|>"}]}], ";", 
     "\n", 
     RowBox[{"dynLogHorizontalAxis", "=", "False"}], ";", "\n", 
     RowBox[{"dynOutputRoot", "=", 
      RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
     RowBox[{"dynRunLabel", "=", "\"\<ZZ_state_dynamics\>\""}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Code",
 CellChangeTimes->{{4.001118272398899*^9, 4.001118284233904*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"d6fb6003-b8bb-c54c-930f-c69168082123"]
}, Open  ]],

Cell[CellGroupData[{

Cell[" 2.3 One active initial-state assignment ", "Subsection",ExpressionUUID->"ce4b26c2-d6ca-504e-b8f1-758bc8494b3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"dynInitial", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", "\n", " ", 
       RowBox[{"\"\<EdgeState\>\"", "->", 
        RowBox[{"Normalize", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
       "\n", " ", 
       RowBox[{"\"\<Bulk\>\"", "->", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
          RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";"}],
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "Replace", " ", "the", " ", "assignment", " ", "above", " ", "for", " ",
         "a", " ", "bulk", " ", 
        RowBox[{"helix", ":", "\n", " ", "dynInitial"}]}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", 
         RowBox[{"\"\<EdgeState\>\"", "->", 
          RowBox[{"Normalize", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<Bulk\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
            RowBox[{"\"\<q\>\"", "->", 
             RowBox[{"Pi", "/", "3"}]}], ",", 
            RowBox[{"\"\<theta\>\"", "->", 
             RowBox[{"Pi", "/", "2"}]}], ",", 
            RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";", 
      "\n", " ", 
      RowBox[{
      "Full", " ", "helix", " ", "on", " ", "physical", " ", "sites", " ", 
       "1"}]}], ",", "...", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"L", ":", "\n", " ", "dynInitial"}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
         RowBox[{"\"\<FullState\>\"", "->", 
          RowBox[{"helix", "[", 
           RowBox[{
            RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ",", 
            RowBox[{"Pi", "/", "3"}], ",", 
            RowBox[{"Pi", "/", "2"}], ",", "0"}], "]"}]}]}], "|>"}]}], ";", 
      "\n", " ", 
      RowBox[{
       RowBox[{"General", " ", "full", " ", 
        RowBox[{"vector", "/", "density"}], " ", 
        RowBox[{"matrix", ":", "\n", " ", "dynInitial"}]}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
         RowBox[{"\"\<FullState\>\"", "->", "yourFullState"}]}], "|>"}]}], ";",
       "\n", " ", 
      RowBox[{
      "A", " ", "mixed", " ", "edge", " ", "state", " ", "is", " ", "also", " ",
        "allowed", " ", "in", " ", "Product", " ", 
       RowBox[{"mode", "."}]}]}]}], "\n", "*)"}], "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{
  4.0011189428944836`*^9},ExpressionUUID->"e1775635-7a6b-da48-b314-\
812acda97d9e"],

Cell["\<\
 The helix is a freely chosen initial product state. No matched boundary \
field or rigid-rotation protocol is added. Bulk alternatives are Polarized \
(Bit), InfiniteT, Gibbs (Beta), Typical (Beta, Samples, Seed), and User \
(State). Gibbs/Typical use only the field-free L-2-site bulk Hamiltonian. \
\>", "Text",ExpressionUUID->"f2ee8db0-83b9-e741-88df-b3abd505d2a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
 2.4 Assemble the factor, inspect sector weights, and diagonalize occupied \
sectors \
\>", "Subsection",ExpressionUUID->"23bc632d-ee9e-d14c-915c-4900b6f1affc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"dynModelUsed", "=", 
      RowBox[{"regimeModel", "[", "dynModel", "]"}]}], ";", 
     RowBox[{"dynInitialUsed", "=", "dynInitial"}], ";", 
     RowBox[{"dynSettingsUsed", "=", "dynSettings"}], ";", 
     RowBox[{"dynTimeUsed", "=", "dynTime"}], ";", "\n", 
     RowBox[{"dynFactor", "=", 
      RowBox[{"initialFactor", "[", 
       RowBox[{"dynModelUsed", ",", "dynInitialUsed", ",", 
        RowBox[{
        "dynSettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{"dynInitialDiagnostics", "=", 
      RowBox[{"stateInputDiagnostics", "[", 
       RowBox[{"dynModelUsed", ",", "dynFactor", ",", 
        RowBox[{"dynSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{"dynTimes", "=", 
      RowBox[{"timeGrid", "[", "dynTimeUsed", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dynSetupSeconds", ",", "dynEngine"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"occupiedEngine", "[", 
        RowBox[{"dynModelUsed", ",", "dynFactor", ",", "\n", " ", 
         RowBox[{"dynSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
         RowBox[{"dynSettingsUsed", "[", "\"\<ProjectionCutoff\>\"", "]"}]}], 
        "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Initial-factor reconstruction error: \>\"", ",", 
       RowBox[{"dynEngine", "[", "\"\<ReconstructionError\>\"", "]"}], ",", 
       "\n", " ", "\"\<; discarded weight: \>\"", ",", 
       RowBox[{"dynEngine", "[", "\"\<DiscardedWeight\>\"", "]"}]}], "]"}], ";",
      "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"dynEngine", "[", "\"\<SectorWeights\>\"", "]"}], "]"}], "]"}],
      ";"}], "\n", ")"}], ";"}], "\n"}]], "Code",
 CellLabel->"In[76]:=",ExpressionUUID->"9bf9bfac-fb32-c24a-a717-f13e291284d3"],

