          RowBox[{"newFolder", "[", 
           RowBox[{"root", ",", "tag"}], "]"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"savePNG", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dir", ",", 
                 RowBox[{"#1", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
              "#2"}], "]"}], "&"}], ",", "plots"}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"StringQ", "[", 
            RowBox[{"Export", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dir", ",", "\"\<results.wxf\>\""}], "}"}], "]"}], ",",
               "data", ",", "\"\<WXF\>\""}], "]"}], "]"}], 
           ",", "\"\<Numerical data export failed.\>\""}], "]"}], ";", 
         "dir"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
