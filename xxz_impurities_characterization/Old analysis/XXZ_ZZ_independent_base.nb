                   RowBox[{"{", 
                    
                    RowBox[{"\"\<TextureFAB\>\"", ",", "\"\<L1Normalized\>\"",
                     ",", "\"\<LinearEntropy\>\"", 
                    ",", "\"\<NormalizedEntropy\>\""}], "}"}], 
                   ",", "\"\<\\\\mathrm{comparison}\>\""}], "}"}]}], "}"}]}], 
              "}"}]}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
