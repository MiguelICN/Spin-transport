Cell["\<\
 Revision-2 channel engine adapted to the existing conventions: L is TOTAL \
length; the bulk has L-2 spins; S=sigma/2 and the exchange flip amplitude is \
g/2. Stored Choi still has trace 4, ChoiState trace 1. No fields are \
introduced. Guide field-retuning examples and its SU(2) suggestion do not \
apply to these XY-only end bonds. The legacy map helpers remain available to \
the unchanged QST chapter; chapter 3 uses only the new ch-prefixed engine. \
\>", "Text",ExpressionUUID->"334de4cb-ca0a-e34a-ac8c-618752958d58"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 3.2 Independent map parameters and bulk state ", "Subsection",ExpressionUUID->"12a021b0-d0dd-834a-a015-4974f0a5ea8e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"mapModel", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
        RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
        RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"mapBulk", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
        RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Alternative", ":", " ", "mapBulk"}], "=", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
          RowBox[{"\"\<q\>\"", "->", 
           RowBox[{"Pi", "/", "3"}]}], ",", 
          RowBox[{"\"\<theta\>\"", "->", 
           RowBox[{"Pi", "/", "2"}]}], ",", 
          RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";"}], " ", "*)"}], 
     "\n", 
     RowBox[{"mapTime", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
        RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
        RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
        RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
        RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"mapSettings", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<EDTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<ValidationTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
        RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<RankTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
        RowBox[{"\"\<AverageEnergyTolerance\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<SignalThreshold\>\"", "->", "0.01"}], ",", "\n", " ", 
        RowBox[{"\"\<Symmetries\>\"", "->", "Automatic"}], ",", 
        RowBox[{"\"\<ZZMethod\>\"", "->", "Automatic"}], ",", 
        RowBox[{"\"\<BatchTimes\>\"", "->", "64"}], ",", "\n", " ", 
        RowBox[{"\"\<MaxColumns\>\"", "->", "4096"}], ",", 
        RowBox[{"\"\<MaxEntries\>\"", "->", 
         RowBox[{"2", "^", "22"}]}], ",", 
        RowBox[{"\"\<MaxOverlapEntries\>\"", "->", 
         RowBox[{"2", "^", "24"}]}], ",", "\n", " ", 
        RowBox[{"\"\<TimeReversalCheck\>\"", "->", "\"\<Endpoints\>\""}]}], 
       "|>"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Exact", " ", "zero"}], "-", 
        RowBox[{"column", " ", "pruning", " ", 
         RowBox[{"only", ".", " ", 
          RowBox[{"ZZMethod", ":", " ", "Automatic"}]}]}]}], ",", 
       " ", "\"\<Direct\>\"", ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\"\<Overlap\>\"", ".", "\n", " ", "MaxEntries"}], " ", 
          "limits", " ", "ONE", " ", "exchange", " ", "Choi"}], "-", 
         RowBox[{"factor", " ", "array"}]}], ";", " ", 
        RowBox[{
         RowBox[{"derivatives", "/", "temporaries"}], " ", "add", " ", 
         RowBox[{"memory", ".", "\n", " ", 
          RowBox[{"TimeReversalCheck", ":", " ", "\"\<None\>\""}]}]}]}], ",", 
       " ", 
       RowBox[{"\"\<Endpoints\>\"", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"first", "/", "middle"}], "/", "last"}], ")"}]}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"or", " ", 
            RowBox[{"\"\<All\>\"", ".", "\n", " ", "Optional"}], " ", 
            "sector"}], "-", 
           RowBox[{"defined", " ", "thermal", " ", "estimator", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"different", " ", "finite"}], "-", 
              RowBox[{"sample", " ", "ensemble"}]}], ")"}]}]}], ":", "\n", 
          " ", "mapBulk"}], "=", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Type\>\"", "->", "\"\<SectorTypical\>\""}], ",", 
           RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
           RowBox[{"\"\<SamplesPerSector\>\"", "->", "2"}], ",", 
           RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"Existing", " ", "Type"}], "->", 
         RowBox[{
          
          RowBox[{"\"\<Typical\>\"", " ", "keeps", " ", "its", " ", 
           "original", " ", "global", " ", "random"}], "-", 
          RowBox[{"vector", " ", 
           RowBox[{"definition", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
     RowBox[{"mapComputeInfiniteTimeAverage", "=", "True"}], ";", "\n", 
     RowBox[{"mapLogHorizontalAxis", "=", "False"}], ";", "\n", 
     RowBox[{"mapOutputRoot", "=", 
      RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
     RowBox[{"mapRunLabel", "=", "\"\<ZZ_map_dynamics\>\""}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Code",
