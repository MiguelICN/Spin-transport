                 RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                 RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", 
              " ", "records"}], ")"}], ",", 
            RowBox[{
             RowBox[{
