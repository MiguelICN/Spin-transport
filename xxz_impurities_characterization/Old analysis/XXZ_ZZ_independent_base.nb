Cell[" 4.A.7 Export this run ", "Subsection",ExpressionUUID->"109ac7df-9562-d943-8385-398b70f17a45"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"qstAData", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Used\>\"", "->", "qstAUsed"}], ",", 
       RowBox[{"\"\<Engine\>\"", "->", "qstAEngine"}], ",", 
       RowBox[{"\"\<Records\>\"", "->", "qstARecords"}], ",", 
       RowBox[{"\"\<Checks\>\"", "->", "qstAChecks"}], ",", "\n", " ", 
       RowBox[{"\"\<SectorWeights\>\"", "->", 
        RowBox[{"qstAEngine", "[", "\"\<SectorWeights\>\"", "]"}]}], ",", 
       RowBox[{"\"\<EvolvedBlockLabels\>\"", "->", 
        RowBox[{"Lookup", "[", 
         RowBox[{
          RowBox[{"qstAEngine", "[", "\"\<Sectors\>\"", "]"}], 
          ",", "\"\<Labels\>\""}], "]"}]}], ",", "\n", " ", 
       RowBox[{"\"\<SetupSeconds\>\"", "->", "qstASetupSeconds"}], ",", 
       RowBox[{"\"\<EvolutionSeconds\>\"", "->", "qstASeconds"}], ",", "\n", 
       " ", 
       RowBox[{"\"\<WindowMeanR\>\"", "->", "qstAWindowR"}], ",", 
       RowBox[{"\"\<InfiniteTime\>\"", "->", "qstAInfiniteTime"}], ",", 
       RowBox[{"\"\<ConsistencyCheck\>\"", "->", "qstAConsistency"}], ",", 
       "\n", " ", 
       RowBox[{"\"\<InitialFactor\>\"", "->", "qstAFactor"}], ",", 
       RowBox[{"\"\<InitialRhoAB\>\"", "->", "qstAInitialRhoAB"}], ",", 
       RowBox[{"\"\<GlobalPurity\>\"", "->", "qstAGlobalPurity"}], ",", "\n", 
       " ", 
       RowBox[{"\"\<ShortTimeUsed\>\"", "->", "qstAShortUsed"}], ",", 
       RowBox[{"\"\<ShortTimeRecords\>\"", "->", "qstAShortRecords"}], ",", 
       RowBox[{"\"\<ShortTimeChecks\>\"", "->", "qstAShortChecks"}]}], 
      "|>"}]}], ";", "\n", 
    RowBox[{"qstADirectory", "=", 
     RowBox[{"qstExport", "[", 
      RowBox[{
      "qstAOutputRoot", ",", "qstARunLabel", ",", "qstAPlots", ",", 
       "qstAData"}], "]"}]}], ";", "\n", 
    RowBox[{"Print", "[", "qstADirectory", "]"}], ";"}], "\n", ")"}], 
  ";"}]], "Code",
