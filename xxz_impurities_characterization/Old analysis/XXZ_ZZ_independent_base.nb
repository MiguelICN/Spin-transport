Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstReferenceTrace", "[", 
       RowBox[{"r_", ",", "l_"}], "]"}], " ", ":=", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Table", "[", "\n", " ", 
         RowBox[{
          RowBox[{"Sum", "[", 
           RowBox[{
            RowBox[{"r", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{
                RowBox[{"a", " ", 
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
                RowBox[{"2", " ", "m"}], "+", "b", "+", "1"}], ",", 
               RowBox[{
                RowBox[{"aa", " ", 
                 RowBox[{"2", "^", 
                  RowBox[{"(", 
                   RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
                RowBox[{"2", " ", "m"}], "+", "bb", "+", "1"}]}], "]"}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", "0", ",", 
              RowBox[{
               RowBox[{"2", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "-", "2"}], ")"}]}], "-", "1"}]}], "}"}]}], 
           "]"}], ",", "\n", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstReferenceEmbed", "[", 
       RowBox[{"x_", ",", "rm_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"2", " ", "a"}], "+", "b", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"2", " ", "aa"}], "+", "bb", "+", "1"}]}], "]"}], "]"}], 
         "\n", " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"a", "+", "1"}]}], "]"}], ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"aa", "+", "1"}]}], "]"}]}], "]"}], ",", "rm", ",", 
           "\n", " ", 
           RowBox[{"Outer", "[", 
            RowBox[{"Times", ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"b", "+", "1"}]}], "]"}], ",", 
             RowBox[{"UnitVector", "[", 
              RowBox[{"2", ",", 
               RowBox[{"bb", "+", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstSmallReference", "[", 
       RowBox[{"p_", ",", "bf_", ",", "records_", ",", "mode_", ",", 
        RowBox[{"maxL_", ":", "6"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "rm", ",", 
          RowBox[{"errs", "=", 
           RowBox[{"{", "}"}]}], ",", "u", ",", "ref"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"l", ">", "maxL"}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Missing", "[", 
             RowBox[{"\"\<SkippedAboveL\>\"", ",", "maxL"}], "]"}], "]"}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"h", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"rm", "=", 
          RowBox[{"bf", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "bf", "]"}]}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"u", "=", 
             RowBox[{"MatrixExp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], " ", "h"}], "]"}]}],
             ";", "\n", "  ", 
            RowBox[{"ref", "=", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"mode", "==", "\"\<State\>\""}], ",", 
               RowBox[{"qstReferenceTrace", "[", 
                RowBox[{
                 RowBox[{"u", " ", ".", " ", 
                  RowBox[{"qstReferenceEmbed", "[", 
                   RowBox[{"edgeF1", ",", "rm"}], "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "l"}],
                 "]"}], ",", "\n", "   ", 
               RowBox[{"ArrayFlatten", "[", 
                RowBox[{"Table", "[", 
                 RowBox[{
                  RowBox[{"qstReferenceTrace", "[", 
                   RowBox[{
                    RowBox[{"u", " ", ".", " ", 
                    RowBox[{"qstReferenceEmbed", "[", 
                    RowBox[{
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "i"}], "]"}], ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "j"}], "]"}]}], "]"}], ",", "rm"}], 
                    "]"}], " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", 
                    "l"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"i", ",", "4"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"j", ",", "4"}], "}"}]}], "]"}], "]"}]}], "]"}]}], 
            ";", "\n", "  ", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"errs", ",", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"ref", "-", 
                RowBox[{"rec", "[", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"mode", "==", "\"\<State\>\""}], 
                   ",", "\"\<RhoAB\>\"", ",", "\"\<Choi\>\""}], "]"}], 
                 "]"}]}], "]"}]}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"rec", ",", 
             RowBox[{"records", "[", 
              RowBox[{"[", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"Ceiling", "[", 
                   RowBox[{
                    RowBox[{"Length", "[", "records", "]"}], "/", "2"}], 
                   "]"}], ",", 
                  RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], 
               "]"}], "]"}]}], "}"}]}], "]"}], ";", 
         RowBox[{"Max", "[", "errs", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
