Cell[CellGroupData[{

Cell["\<\
 4.B.5 Optional infinite-time values and sampled-window rugosity \
\>", "Subsection",ExpressionUUID->"1509ef0e-7dbb-3643-9e1a-8ad0a4375c65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"qstBInfiniteTime", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "qstBComputeInfiniteTime", "]"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"qstAverageChannel", "[", 
          RowBox[{"qstBEngine", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
        "qstBClusterTolerances"}], ",", 
       RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], ";", 
    "\n", 
    RowBox[{"qstBWindowR", "=", 
     RowBox[{"qstWindowMean", "[", 
      RowBox[{"qstBRecords", ",", "\"\<OmegaR\>\""}], "]"}]}], ";", "\n", 
    RowBox[{"{", 
     RowBox[{"qstBInfiniteTime", ",", "qstBWindowR"}], "}"}]}], "\n", ")"}], 
  ";"}]], "Code",
 CellChangeTimes->{4.0011212614623165`*^9},
 CellLabel->
  "In[223]:=",ExpressionUUID->"1d7f70a9-f4dc-0744-8719-d28b92491142"],

Cell["\<\
 Energy clusters include all evolved sectors together (ZZ: all four edge \
configurations), preserving coherences within each degenerate cluster. \
Compare the results at all cluster tolerances. The sampled-window rugosity \
uses trapezoidal integration in physical time, including on a logarithmic \
grid. A sampled zero makes this estimate \
Missing[SingularSamplesRequireQuadrature], because an isolated logarithmic \
singularity need not have an infinite integral. It is never replaced by the \
rugosity of an averaged state. \
\>", "Text",ExpressionUUID->"9eb2b95c-eefc-f245-b393-548af5fdaa65"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 4.B.6 Plots from the settings attached to the computed records \
\>", "Subsection",ExpressionUUID->"2e4bcb4c-dced-7b44-b12b-d4b0e10574b0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GlobalchopRecordsInPlace", "[", "XXZZZ`qstBRecords", "]"}]], "Input",
 CellChangeTimes->{{4.0011199732887096`*^9, 4.0011199989434185`*^9}},
 CellLabel->
  "In[224]:=",ExpressionUUID->"a4ed2616-015e-9043-aae5-499b9cb68a51"],

Cell[BoxData["True"], "Output",
 CellChangeTimes->{4.00112126810968*^9},
 CellLabel->
  "Out[224]=",ExpressionUUID->"9a096280-da42-9146-b003-aef5ffaebfb8"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"qstBPlots", "=", 
     RowBox[{"texturizingPanels", "[", 
      RowBox[{"qstBRecords", ",", "qstBUsed", ",", "False"}], "]"}]}], ";", 
    "\n", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", "qstBExportLogPlots", "]"}], ",", 
      RowBox[{"qstBPlots", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"qstBPlots", ",", "\n", " ", 
         RowBox[{"Association", "[", 
          RowBox[{"KeyValueMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], 
             "&"}], ",", 
            RowBox[{"texturizingPanels", "[", 
             RowBox[{"qstBRecords", ",", "qstBUsed", ",", "True"}], "]"}]}], 
           "]"}], "]"}]}], "]"}]}]}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"qstBPlots", "[", "\"\<ThreeRoutes\>\"", "]"}], "]"}], ";"}], 
   "\n", ")"}], ";"}]], "Code",
 CellChangeTimes->{4.0011212705105896`*^9},
 CellLabel->
  "In[225]:=",ExpressionUUID->"212e58da-68f9-424d-b8ac-8ec1bebd78fe"],

