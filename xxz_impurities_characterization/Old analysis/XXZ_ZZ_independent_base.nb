              RowBox[{"fac", ",", 
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"ConstantArray", "[", 
                  RowBox[{"2", ",", "l"}], "]"}], ",", 
                 RowBox[{"{", "r", "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
             RowBox[{"Ordering", "[", 
