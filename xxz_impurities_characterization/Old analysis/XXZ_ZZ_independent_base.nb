Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstRunChunks", "[", 
       RowBox[{"fn_", ",", "times_List", ",", "eng_", ",", "cfg_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"bytes", ",", "size", ",", "chunks", ",", "results", ",", 
          RowBox[{"kernels", "=", "1"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{"And", "@@", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], 
              "]"}]}]}], ",", "\"\<QST times must increase.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], "]"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ">", "0"}], " ", 
            "&&", " ", 
            RowBox[{"realQ", "[", 
             RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], "]"}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], ">", "0"}], " ", "&&",
             "\n", "  ", 
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ">", "0"}]}], 
           ",", "\"\<Invalid QST parallel/batch settings.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
           "  ", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
              RowBox[{"Quiet", "[", 
               RowBox[{"LaunchKernels", "[", 
                RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], "]"}]}], 
             "]"}], ";", "\n", "  ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}], 
              ",", "\"\<No parallel kernels available. Set Enabled->False for \
serial batches.\>\""}], "]"}], ";", "\n", "  ", 
            RowBox[{"kernels", "=", 
             RowBox[{"Length", "[", 
              RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
            RowBox[{"DistributeDefinitions", "[", 
             RowBox[{"qstStateChunk", ",", "qstMapChunk"}], "]"}]}]}], "]"}], 
         ";", "\n", " ", 
         RowBox[{"bytes", "=", 
          RowBox[{"16", " ", 
           RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}], " ", 
           RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}]}], ";", "\n", " ", 
         RowBox[{"size", "=", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ",", 
            RowBox[{"Floor", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], " ", 
              RowBox[{
               RowBox[{"2", "^", "20"}], "/", 
               RowBox[{"(", 
                RowBox[{"4", " ", "kernels", " ", "bytes"}], ")"}]}]}], 
             "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"size", ">=", "1"}], ",", 
           
           RowBox[{"\"\<QST batch memory budget is too small. Minimum \
MemoryMB for one factor per worker: \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"Ceiling", "[", 
              RowBox[{"4", " ", "kernels", " ", 
               RowBox[{"bytes", "/", 
                RowBox[{"2", "^", "20"}]}]}], "]"}], "]"}], 
            "<>", "\"\<. This excludes eigensystems and retained \
records.\>\""}]}], "]"}], ";", "\n", " ", 
         RowBox[{"chunks", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{"times", ",", 
            RowBox[{"UpTo", "[", "size", "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"results", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
            "  ", 
            RowBox[{"ParallelMap", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"ts", ",", 
                RowBox[{"CheckAbort", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
               "]"}], ",", "chunks", ",", 
              RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",",
             "\n", "  ", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"ts", ",", 
                RowBox[{"CheckAbort", "[", 
                 RowBox[{
                  RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
               "]"}], ",", "chunks"}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ListQ", "[", "results", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "results", "]"}], "==", 
             RowBox[{"Length", "[", "chunks", "]"}]}], " ", "&&", "\n", "  ", 
            RowBox[{"And", "@@", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"ListQ", "[", "#1", "]"}], " ", "&&", " ", 
                  RowBox[{
                   RowBox[{"Length", "[", "#1", "]"}], "==", 
                   RowBox[{"Length", "[", "#2", "]"}]}], " ", "&&", " ", 
                  RowBox[{"AllTrue", "[", 
                   RowBox[{"#1", ",", "AssociationQ"}], "]"}]}], ")"}], "&"}],
                ",", 
               RowBox[{"{", 
                RowBox[{"results", ",", "chunks"}], "}"}]}], "]"}]}]}], ",", 
           "\n", "  ", "\"\<A QST batch failed or aborted; no partial \
trajectory is returned.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"results", ",", "1"}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstStateChunk", "[", 
       RowBox[{"times_", ",", "eng_", ",", "fac_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{"evolveBatch", "[", 
            RowBox[{"times", ",", "eng"}], "]"}]}], ",", "rho0", ",", 
          "purity0"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"rho0", "=", 
          RowBox[{"reducedState", "[", 
           RowBox[{"fac", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"purity0", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"MatrixPower", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ",
                "fac"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"stateRecord", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", 
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", 
             "eng", ",", "fac", ",", "rho0", ",", "purity0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstStateRecords", "[", 
       RowBox[{"eng_", ",", "fac_", ",", "times_", ",", "cfg_"}], "]"}], " ", 
      ":=", " ", 
      RowBox[{"textureRecords", "[", "\n", " ", 
       RowBox[{"qstRunChunks", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"ts", ",", 
           RowBox[{"qstStateChunk", "[", 
            RowBox[{"ts", ",", "eng", ",", "fac"}], "]"}]}], "]"}], ",", 
         "times", ",", "eng", ",", "cfg"}], "]"}], "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
