Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Reject", " ", "Hamiltonians", " ", "that", " ", "the", " ", "real"}], ",",
       " ", 
      RowBox[{"magnetization", "-", 
       RowBox[{"block", " ", "solver", " ", "cannot", " ", 
        RowBox[{"represent", "."}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"u1Check", "[", 
       RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "nd", ",", "off", ",",
           "scale", ",", "leak"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "a", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"2", "^", "l"}], ",", 
              RowBox[{"2", "^", "l"}]}], "}"}]}], 
           ",", "\"\<Hamiltonian dimensions do not match L.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"nd", "=", 
          RowBox[{"Total", " ", "/@", " ", 
           RowBox[{"IntegerDigits", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{
                RowBox[{"2", "^", "l"}], "-", "1"}]}], "]"}], ",", "2", ",", 
             "l"}], "]"}]}]}], ";", "\n", " ", 
         RowBox[{"off", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Most", "[", 
             RowBox[{"ArrayRules", "[", "a", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"nd", "[", 
               RowBox[{"[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "!=", 
              RowBox[{"nd", "[", 
               RowBox[{"[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", 
                  RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], 
             "&"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"leak", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"off", "===", 
             RowBox[{"{", "}"}]}], ",", "0.", ",", 
            RowBox[{"Max", "[", 
             RowBox[{"Abs", "[", 
              RowBox[{"Last", " ", "/@", " ", "off"}], "]"}], "]"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"leak", "<=", 
            RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
           "  ", "\"\<H mixes total-Sz sectors. This solver would drop matrix \
elements. Use a solver for the surviving symmetries or full ED.\>\""}], "]"}],
          ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<MaxOffBlockElement\>\"", "->", "leak"}], ",", 
           RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
           RowBox[{"\"\<RelativeLeakage\>\"", "->", 
            RowBox[{"leak", "/", "scale"}]}], ",", 
           RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"realSectorCheck", "[", 
       RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", 
           RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "u", ",", "scale"}],
          "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"u", "=", 
          RowBox[{"u1Check", "[", 
           RowBox[{"a", ",", "l", ",", "tol"}], "]"}]}], ";", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"a", "-", 
              RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], "]"}], "<=", 
            RowBox[{"tol", " ", "scale"}]}], 
           ",", "\"\<H must be Hermitian before block diagonalization.\>\""}],
           "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"Im", "[", "a", "]"}], "]"}], "<=", 
            RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
           "  ", "\"\<The legacy fixSign solver requires a real Hamiltonian. \
Complex Hermitian models need phase-preserving eigenvectors.\>\""}], "]"}], ";",
          "\n", " ", "u"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[4]:=",ExpressionUUID->"8a31250c-f042-9e48-b1ba-5d9fbf68a99a"]
}, Closed]],

