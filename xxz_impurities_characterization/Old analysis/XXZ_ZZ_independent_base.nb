Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"staticPoint", "[", 
       RowBox[{"p_Association", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ed", "=", 
           RowBox[{"addEntropies", "[", 
            RowBox[{"regimeED", "[", 
             RowBox[{"p", ",", "tol"}], "]"}], "]"}]}], ",", "out"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"out", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"s", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"s", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<IPR\>\"", "->", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                    " ", "/@", " ", 
                    RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
                 "|>"}]}], "]"}]}], "]"}], ",", 
            RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n",
          " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"2.", "^", 
                  RowBox[{"(", 
                   RowBox[{"-", 
                    RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ")"}]}], "-", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
                RowBox[{"1", "+", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Floor", "[", 
                   RowBox[{
                    RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "]"}], " ", 
                  RowBox[{"Log", "[", "2", "]"}]}], "+", 
                 RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
               RowBox[{
                RowBox[{"Min", "[", 
                 RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
                RowBox[{
                 RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
                RowBox[{
                 RowBox[{"Log", "[", "4", "]"}], "+", 
                 RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], 
           ",", "\"\<Eigenstate bounds failed.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"out", ",", "\"\<EdgesEntropy\>\""}], "]"}], "]"}], "<", 
            RowBox[{"100", " ", "tol"}]}], 
           ",", "\"\<ZZ fixed-edge eigenstate lost its product \
structure.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"KeyDrop", "[", 
            RowBox[{"ed", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Hamiltonian\>\"", ",", "\"\<Sectors\>\""}], 
              "}"}]}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{"\"\<Sectors\>\"", "->", "out"}], "|>"}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"staticScan", "[", 
       RowBox[{"base_Association", ",", "axis_String", ",", "grid_List", ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"models", ",", "points"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"MemberQ", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<g\>\"", ",", "\"\<Delta\>\""}], "}"}], ",", 
              "axis"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "grid", "]"}], ">=", "1"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"grid", ",", "realQ"}], "]"}], " ", "&&", "\n", "  ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "grid", "]"}], "==", "1"}], " ", "||", 
              " ", 
              RowBox[{"And", "@@", 
               RowBox[{"Thread", "[", 
                RowBox[{
                 RowBox[{"Differences", "[", 
                  RowBox[{"N", "[", "grid", "]"}], "]"}], ">", "0"}], 
                "]"}]}]}], ")"}]}], 
           ",", "\"\<Use an increasing real scan grid for g or Delta.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"models", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"regimeModel", "[", 
             RowBox[{"Join", "[", 
              RowBox[{"base", ",", 
               RowBox[{"<|", 
                RowBox[{"axis", "->", "#"}], "|>"}]}], "]"}], "]"}], "&"}], 
           " ", "/@", " ", "grid"}]}], ";", "\n", " ", 
         RowBox[{"points", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"staticPoint", "[", 
              RowBox[{"#", ",", "tol"}], "]"}], "&"}], ",", "models"}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Axis\>\"", "->", "axis"}], ",", 
           RowBox[{"\"\<Grid\>\"", "->", "grid"}], ",", 
           RowBox[{"\"\<BaseModel\>\"", "->", "base"}], ",", 
           RowBox[{"\"\<EDTolerance\>\"", "->", "tol"}], ",", 
           RowBox[{"\"\<Points\>\"", "->", "points"}], ",", "\n", "  ", 
           RowBox[{"\"\<SectorKeys\>\"", "->", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"sectorKey", "[", 
                    RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], 
                  " ", "/@", " ", 
                  RowBox[{"#", "[", "\"\<Sectors\>\"", "]"}]}], ")"}], "&"}], 
               " ", "/@", " ", "points"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n",
        "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[24]:=",ExpressionUUID->"53564473-4336-e043-aa50-577130a50c2d"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Occupied-sector engine and exact phase evolution ", "Subsubsection",ExpressionUUID->"7df34afa-6bb3-ef47-a37e-1d7c55e148f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Single", "-", 
       RowBox[{"time", " ", "evolution"}]}], ",", " ", 
      RowBox[{
      "useful", " ", "for", " ", "checks", " ", "and", " ", "direct", " ", 
       RowBox[{"access", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"evolve", "[", 
       RowBox[{"t_", ",", "engine_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "a", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
              RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], " ", 
              "]"}], "]"}], "+=", 
            RowBox[{
             RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Exp", "[", 
                RowBox[{
                 RowBox[{"-", "I"}], " ", 
                 RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}], " ", 
               RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], 
          "]"}], ";", "a"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "Batch", " ", "matrix", " ", "products", " ", "over", " ", "time"}], ";",
        " ", 
       RowBox[{
        RowBox[{"a", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], " ", "is", " ",
         "the", " ", "kth", " ", 
        RowBox[{"factor", "."}]}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"evolveBatch", "[", 
       RowBox[{"times_List", ",", "engine_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "ph"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
              RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}], ",", 
              RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ph", "=", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"Outer", "[", 
                RowBox[{"Times", ",", 
                 RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
                 RowBox[{"N", "[", "times", " ", "]"}]}], "]"}]}], "]"}]}], ";",
             "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "c", ",", 
                  "All"}], " ", "]"}], "]"}], "+=", 
               RowBox[{
                RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
                RowBox[{"(", 
                 RowBox[{"ph", " ", 
                  RowBox[{
                   RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", "c"}], " ", "]"}], "]"}]}], ")"}]}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{"c", ",", 
                RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
             "]"}]}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], 
          "]"}], ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
