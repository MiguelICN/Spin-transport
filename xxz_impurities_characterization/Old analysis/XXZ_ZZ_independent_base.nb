Cell[" Field-free model, full sectors and static scans ", "Subsubsection",ExpressionUUID->"1c944c06-4d40-604b-9321-14e5672d75bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"regimeModel", "[", "p_Association", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"l", "=", 
          RowBox[{"Lookup", "[", 
           RowBox[{"p", ",", "\"\<L\>\"", ",", 
            RowBox[{"Missing", "[", "]"}]}], "]"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", "l", "]"}], " ", "&&", " ", 
            RowBox[{"l", ">=", "4"}]}], 
           ",", "\"\<Use integer total length L>=4.\>\""}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ContainsAll", "[", 
             RowBox[{
              RowBox[{"Keys", "[", "p", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<g\>\""}], 
               "}"}]}], "]"}], " ", "&&", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"p", ",", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", 
                  ",", "\"\<g\>\""}], "}"}]}], "]"}], ",", "realQ"}], "]"}]}],
            ",", "\n", "  ", "\"\<Specify finite real J, Delta and g.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"p", "[", "\"\<J\>\"", "]"}], "!=", "0"}], " ", "&&", 
            " ", 
            RowBox[{
             RowBox[{"p", "[", "\"\<g\>\"", "]"}], "!=", "0"}]}], 
           ",", "\"\<J and g must be nonzero; g=0 is outside these notebooks.\
\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Complement", "[", 
             RowBox[{
              RowBox[{"Keys", "[", "p", "]"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
                ",", "\"\<g\>\""}], "}"}]}], "]"}], "===", 
            RowBox[{"{", "}"}]}], ",", "\n", 
           "  ", "\"\<Model parameters are only L, J, Delta and g. No \
magnetic-field parameter is accepted.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
             ",", "\"\<g\>\""}], "}"}]}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"geometryParameters", "[", "p_", "]"}], " ", ":=", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"KeyTake", "[", 
         RowBox[{"p", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\""}], 
           "}"}]}], "]"}], ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], "]"}]}], ";", 
     "\n", 
     RowBox[{
      RowBox[{"regimeParts", "[", "p_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"l", "=", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "x", ",", "y", ",", 
          "z", ",", "xy", ",", "zz", ",", "b"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"b", "=", 
          RowBox[{
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"bondOp", "[", 
                RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
               RowBox[{"bondOp", "[", 
                RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}], "+", 
               RowBox[{
                RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
                RowBox[{"bondOp", "[", 
                 RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "2", ",", 
                RowBox[{"l", "-", "2"}]}], "}"}]}], "]"}], "]"}]}]}], ";", 
         "\n", " ", 
         RowBox[{"xy", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"bondOp", "[", 
               RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
              RowBox[{"bondOp", "[", 
               RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
         ";", "\n", " ", 
         RowBox[{"zz", "=", 
          RowBox[{"Total", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], 
         ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Bulk\>\"", "->", 
            RowBox[{"SparseArray", "[", "b", "]"}]}], ",", 
           RowBox[{"\"\<Interaction\>\"", "->", 
            RowBox[{"SparseArray", "[", "zz", "]"}]}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"regimeHamiltonian", "[", "p_Association", "]"}], " ", ":=", 
      " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"q", "=", 
           RowBox[{"regimeModel", "[", "p", "]"}]}], ",", "b"}], "}"}], ",", 
        "\n", " ", 
        RowBox[{
         RowBox[{"b", "=", 
          RowBox[{"regimeParts", "[", "q", "]"}]}], ";", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"b", "[", "\"\<Bulk\>\"", "]"}], "+", 
           RowBox[{
            RowBox[{"q", "[", "\"\<g\>\"", "]"}], " ", 
            RowBox[{"b", "[", "\"\<Interaction\>\"", "]"}]}]}], "]"}]}]}], 
       "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"bulkHamiltonian", "[", "p_Association", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{
            RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "x", ",",
           "y", ",", "z"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"bondOp", "[", 
                RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
               RowBox[{"bondOp", "[", 
                RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", 
               RowBox[{
                RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
                RowBox[{"bondOp", "[", 
                 RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}]}],
        "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"parameterNote", "[", "p_", "]"}], " ", ":=", " ", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "0"}], "]"}], ",", 
        "\n", " ", "\"\<Delta=0: free-fermion Hamiltonian (conditional \
free-fermion bulk for ZZ). Additional mode occupations are conserved; \
spin/spatial sectors need not have nondegenerate energies.\>\"", ",", "\n", 
        " ", 
        RowBox[{"TrueQ", "[", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], "==", 
          RowBox[{"1", "/", "2"}]}], "]"}], ",", "\n", 
        " ", "\"\<Delta=+/-1/2: special bulk cross-magnetization degeneracies \
can affect weak-g level statistics.\>\"", ",", "True", 
        ",", "\"\<Generic anisotropy within the stated spin/spatial symmetry \
classification.\>\""}], "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
