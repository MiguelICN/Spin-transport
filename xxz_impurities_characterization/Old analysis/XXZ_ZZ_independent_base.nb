Cell["\<\
 The derivative of the unitary factor is analytic, using -i E exp(-i E t). \
Near-singular transfer matrices produce Missing values for the generator and \
divisibility diagnostics; no pseudoinverse is substituted. Covariance is \
tested for the chosen bulk preparation, which may break symmetries of H. Rate \
normalization uses G_(mu,nu)=sigma_mu tensor sigma_nu / 2. \
\>", "Text",ExpressionUUID->"7a423542-b6b7-dd44-abc7-a3143016f1f5"],

Cell["\<\
 The fast spectral average uses same-bulk-sector overlap contractions for ZZ. \
Exchange uses vectorized singleton contributions and coherent Choi factors \
for globally degenerate clusters. Large mixed factors and highly degenerate \
clusters still have substantial memory costs. Chunk limits bound individual \
working arrays, not total peak memory. \
\>", "Text",ExpressionUUID->"32c9a47a-165c-3148-8800-d691ffbea23a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
 3.5a Conjugate-bulk time-reversal check; reuse the eigensystem \
\>", "Subsection",ExpressionUUID->"4602ed4c-4e28-9b43-b450-03a991f23d29"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapTimeReversal", "=", 
     RowBox[{"chTimeReversal", "[", 
      RowBox[{"mapEngine", ",", "mapTimes", ",", "mapSettingsUsed"}], "]"}]}],
     ";", "\n", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"mapRecords", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"mapRecords", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
            RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ",", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{"\"\<TimeReversalError\>\"", "->", 
           RowBox[{
            RowBox[{"mapTimeReversal", "[", "\"\<Errors\>\"", "]"}], "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "|>"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "]"}]}], 
       "}"}]}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", "mapTimeReversal", "]"}], ";"}], "\n", ")"}], 
  ";"}]], "Code",
 CellChangeTimes->{4.0011201299028645`*^9},
 CellLabel->
  "In[131]:=",ExpressionUUID->"5e7114b3-48a0-4e49-979f-187099521f18"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Indices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2001", ",", "4001"}], "}"}]}], ",", 
   RowBox[{"\<\"Times\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "200.`", ",", "400.`"}], "}"}]}], ",", 
   RowBox[{"\<\"Errors\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], ",", 
   RowBox[{"\<\"Maximum\"\>", "\[Rule]", "0.`"}]}], 
