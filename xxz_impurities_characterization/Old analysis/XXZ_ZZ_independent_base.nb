Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Numeric", " ", "labels", " ", "use", " ", "decimals", " ", "rather", " ",
       "than", " ", 
      RowBox[{"fractions", "."}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"texNumber", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"s", ",", "p"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"x", "==", "0"}], "]"}], ",", 
           RowBox[{"Return", "[", "\"\<0\>\"", "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"x", "==", 
              RowBox[{"Round", "[", "x", " ", "]"}]}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Abs", "[", "x", "]"}], "<", 
             RowBox[{"10", "^", "6"}]}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"ToString", "[", 
             RowBox[{"Round", "[", "x", " ", "]"}], "]"}], "]"}]}], "]"}], ";",
          "\n", " ", 
         RowBox[{"s", "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"p", "=", 
          RowBox[{"StringSplit", "[", 
           RowBox[{"s", ",", "\"\<*^\>\""}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"p", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "=", 
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "p", "]"}], "==", "2"}], ",", 
           RowBox[{
            RowBox[{"p", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<\\\\times 10^{\>\"", "<>", 
            RowBox[{"p", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "<>", "\"\<}\>\""}], ",", 
           RowBox[{"First", "[", "p", " ", "]"}]}], "]"}]}]}], "\n", "]"}]}], 
     ";", "\n", 
     RowBox[{
      RowBox[{"ticks", "[", 
       RowBox[{
        RowBox[{"lo_", "?", "NumericQ"}], ",", 
        RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "=", "lo"}], ",", 
          RowBox[{"b", "=", "hi"}]}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"a", "==", "b"}], ",", 
           RowBox[{
            RowBox[{"a", "-=", "1"}], ";", 
            RowBox[{"b", "+=", "1"}]}]}], "]"}], ";", "\n", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{"#", ",", 
              RowBox[{"tex", "[", 
               RowBox[{
                RowBox[{"texNumber", "[", "#", "]"}], ",", "14"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
           " ", 
           RowBox[{"FindDivisions", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", ",", "b"}], "}"}], ",", "5"}], "]"}]}], ")"}]}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"logTicks", "[", 
       RowBox[{
        RowBox[{"lo_", "?", "NumericQ"}], ",", 
        RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", "\n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"N", "[", 
            RowBox[{"#", " ", 
             RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
           RowBox[{"tex", "[", 
            RowBox[{
             RowBox[{"\"\<10^{\>\"", "<>", 
              RowBox[{"ToString", "[", "#", "]"}], "<>", "\"\<}\>\""}], ",", 
             "14"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
        "\n", "  ", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"lo", "/", 
            RowBox[{"Log", "[", "10", "]"}]}], "]"}], ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"hi", "/", 
            RowBox[{"Log", "[", "10", "]"}]}], "]"}]}], "]"}]}], ")"}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"sectorLabel", "[", "a_", "]"}], " ", ":=", " ", 
      RowBox[{"StringRiffle", "[", 
       RowBox[{
        RowBox[{"KeyValueMap", "[", "\n", " ", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Switch", "[", 
             RowBox[{
             "#1", ",", "\"\<R\>\"", ",", "\"\<r\>\"", ",", "\"\<F\>\"", 
              ",", "\"\<f\>\"", ",", "\"\<RF\>\"", ",", "\"\<rf\>\"", 
              ",", "\"\<StaggeredS\>\"", ",", "\"\<S_{\\\\rm stag}\>\"", ",", 
              "_", ",", "#1"}], "]"}], "<>", "\n", "  ", "\"\<=\>\"", "<>", 
            RowBox[{"texNumber", "[", "#2", "]"}]}], "&"}], ",", "a"}], "]"}],
         ",", "\"\<,\\\\quad \>\""}], "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{
       "A", " ", "common", " ", "dimension", " ", "for", " ", "equivalent", " ",
         "sectors"}], ";", " ", 
       RowBox[{"otherwise", " ", "use", " ", "legend", " ", 
        RowBox[{"order", "."}]}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"dimLabel", "[", "dims_List", "]"}], " ", ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"SameQ", "@@", "dims"}], ",", "\n", " ", 
        RowBox[{"\"\<d_{\\\\mathrm{sector}}=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"First", "[", "dims", "]"}], "]"}]}], ",", "\n", " ", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"MapIndexed", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<d_{\>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{"First", "[", "#2", "]"}], "]"}], "<>", "\"\<}=\>\"", "<>", 
              RowBox[{"ToString", "[", "#1", "]"}]}], "&"}], ",", "dims"}], 
           "]"}], ",", "\"\<,\\\\quad \>\""}], "]"}]}], "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
