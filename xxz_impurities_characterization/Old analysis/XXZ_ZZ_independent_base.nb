Cell[" 1.5 Export this scan ", "Subsection",ExpressionUUID->"7d202c51-e719-934a-9673-a6155f932d44"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"statGDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{
       "statGOutputRoot", ",", "statGRunLabel", ",", "statGPlots", ",", "\n", 
        " ", 
        RowBox[{"Join", "[", 
