Cell["\<\
 Examples for direct use: applyTransfer[mapRecords[[k]][\"Transfer\"],rhoAB] \
predicts any product-preparation edge input; mapRecords[[k]][\"ChoiState\"] \
is the normalized input-output Choi state. No chapter-2 evaluation is used. \
\>", "Text",ExpressionUUID->"c2cbb15b-87ec-dc46-9d09-13beb32b25a9"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 4. Quantum-state texture of the edge spins ", "Title",ExpressionUUID->"83cb8a6d-2810-1f43-8251-f7e5a4d8f55b"],

Cell[CellGroupData[{

Cell[" 4.1 Definitions shared only by the QST sections ", "Subsection",ExpressionUUID->"f6d3724e-8e74-844d-8979-84a21a3f3e1e"],

Cell["\<\
 Sections A and B reuse initialization definitions, never evaluated results \
of chapters 1\[Dash]3 or of each other. Only the two edges are placed in \
f1=|++><++|; an all-plus bulk is excluded. The basis is {00,01,10,11}, with \
bit 0=up. All quantities are basis dependent. Sigma(rho)=sum of every matrix \
entry=D <f1|rho|f1>; TF=1-Sigma/D; R=-log(Sigma/D). D=4 for the pair and D=2 \
for a single edge. SigmaAB/4 is the probability of ++ (Hadamards followed by \
00). Nonmultiplicativity is SigmaAB-SigmaA SigmaB; l1 coherence sums absolute \
off-diagonal entries. References: the supplied QST specification, [P] de Leon \
et al., Role of quantum state texture in quantum chaos (draft), and [V] \
Vieira et al., arXiv:2609.05248. No claim about chaos follows from texture \
alone. \
\>", "Text",ExpressionUUID->"0c58781f-7d9f-7043-ad7d-5c62b24452c2"],

Cell[CellGroupData[{

Cell[" Texture, evolution, averages and validation ", "Subsubsection",ExpressionUUID->"c069460b-4b2f-d24d-aac5-fb5584591e33"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "edgeF1Ket", ",", "edgeF1", ",", "grandSum", ",", "textureF", ",", 
       "rugosity", ",", "l1Coherence", ",", "textureRecords", ",", "\n", " ", 
       "responseOperator", ",", "texturizingRecord", ",", "qstBulkFactor", ",",
        "qstRunChunks", ",", "qstStateChunk", ",", "qstMapChunk", ",", "\n", 
       " ", "qstStateRecords", ",", "qstMapRecords", ",", "qstAverageState", ",",
        "qstAverageChannel", ",", "qstWindowMean", ",", "\n", " ", 
       "qstReferenceTrace", ",", "qstReferenceEmbed", ",", 
       "qstSmallReference", ",", "qstStateChecks", ",", "qstMapChecks", ",", 
       "\n", " ", "qstRandomResponseCheck", ",", "qstCompare", ",", 
       "qstSaveComparison", ",", "qstEdgeConservationError", ",", "qstTex", ",",
        "qstTicks", ",", "qstCaption", ",", "qstPanel", ",", "\n", " ", 
       "texturePanels", ",", "texturizingPanels", ",", "qstExport"}], "]"}], ";",
      "\n", 
     RowBox[{"edgeF1Ket", "=", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], ";", 
     RowBox[{"edgeF1", "=", 
      RowBox[{"ketRho", "[", "edgeF1Ket", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"grandSum", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"Re", "[", 
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", "r", "]"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"textureF", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"1", "-", 
       RowBox[{
        RowBox[{"grandSum", "[", "r", "]"}], "/", 
        RowBox[{"Length", "[", "r", "]"}]}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"rugosity", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"grandSum", "[", "r", "]"}], "/", 
           RowBox[{"Length", "[", "r", "]"}]}]}], "}"}], ",", "\n", " ", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"p", "==", "0"}], "]"}], ",", "Infinity", ",", 
          RowBox[{"TrueQ", "[", 
           RowBox[{"p", ">", "0"}], "]"}], ",", 
          RowBox[{"-", 
           RowBox[{"Log", "[", "p", "]"}]}], ",", "True", ",", 
          RowBox[{"Missing", "[", 
           RowBox[{"\"\<NegativeGrandSum\>\"", ",", "p"}], "]"}]}], "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"l1Coherence", "[", 
       RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"Total", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Abs", "[", "r", "]"}], "]"}], "]"}], "-", 
       RowBox[{"Total", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{"Diagonal", "[", "r", "]"}], "]"}], "]"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"textureRecords", "[", "records_List", "]"}], " ", ":=", " ", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{"Function", "[", 
         RowBox[{"rec", ",", 
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"r", "=", 
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", 
              RowBox[{"a", "=", 
               RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
              RowBox[{"b", "=", 
               RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}]}], "}"}], ",", 
            "\n", " ", 
            RowBox[{"Join", "[", 
             RowBox[{"rec", ",", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<SigmaAB\>\"", "->", 
                 RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<SigmaA\>\"", "->", 
                 RowBox[{"grandSum", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<SigmaB\>\"", "->", 
                 RowBox[{"grandSum", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<TextureFAB\>\"", "->", 
                 RowBox[{"textureF", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<TextureFA\>\"", "->", 
                 RowBox[{"textureF", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<TextureFB\>\"", "->", 
                 RowBox[{"textureF", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<RugosityAB\>\"", "->", 
                 RowBox[{"rugosity", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<RugosityA\>\"", "->", 
                 RowBox[{"rugosity", "[", "a", "]"}]}], ",", 
                RowBox[{"\"\<RugosityB\>\"", "->", 
                 RowBox[{"rugosity", "[", "b", "]"}]}], ",", "\n", " ", 
                RowBox[{"\"\<Nonmultiplicativity\>\"", "->", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"grandSum", "[", "r", "]"}], "-", 
                   RowBox[{
                    RowBox[{"grandSum", "[", "a", "]"}], " ", 
                    RowBox[{"grandSum", "[", "b", "]"}]}]}], ")"}]}], ",", 
                "\n", " ", 
                RowBox[{"\"\<L1Coherence\>\"", "->", 
                 RowBox[{"l1Coherence", "[", "r", "]"}]}], ",", 
                RowBox[{"\"\<L1Normalized\>\"", "->", 
                 RowBox[{
                  RowBox[{"l1Coherence", "[", "r", "]"}], "/", "3"}]}], ",", 
                "\n", " ", 
                RowBox[{"\"\<LinearEntropy\>\"", "->", 
                 RowBox[{"1", "-", 
                  RowBox[{"rec", "[", "\"\<Purity\>\"", "]"}]}]}], ",", 
                RowBox[{"\"\<NormalizedEntropy\>\"", "->", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<EntropyAB\>\"", "]"}], "/", 
                  RowBox[{"Log", "[", "4", "]"}]}]}], ",", "\n", " ", 
                RowBox[{"\"\<F1Probability\>\"", "->", 
                 RowBox[{"Re", "[", 
                  RowBox[{
                   RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", 
                   " ", "r", " ", ".", " ", "edgeF1Ket"}], "]"}]}]}], 
               "|>"}]}], "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"responseOperator", "[", 
       RowBox[{"s_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
      RowBox[{"Transpose", "[", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Total", "[", "s", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[164]:=",ExpressionUUID->"ebb61fdb-c3eb-124a-91ba-c3571ce59d49"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstBulkFactor", "[", 
       RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{
            RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "f", ",",
           "theta", ",", "phi", ",", "prob"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], 
             "==", "\"\<PolarHelix\>\""}], ",", "\n", "  ", 
            RowBox[{
             RowBox[{"theta", "=", 
              RowBox[{"spec", "[", "\"\<ThetaList\>\"", "]"}]}], ";", 
             RowBox[{"phi", "=", 
              RowBox[{"Lookup", "[", 
               RowBox[{"spec", ",", "\"\<PhiList\>\"", ",", 
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"0", ",", "n"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "theta", "]"}], "==", "n"}], " ", "&&",
                 " ", 
                RowBox[{
                 RowBox[{"Length", "[", "phi", "]"}], "==", "n"}], " ", "&&", 
                " ", 
                RowBox[{"AllTrue", "[", 
                 RowBox[{
                  RowBox[{"Join", "[", 
                   RowBox[{"theta", ",", "phi"}], "]"}], ",", "realQ"}], 
                 "]"}]}], ",", "\n", 
               "   ", "\"\<PolarHelix requires real ThetaList and PhiList \
with L-2 entries.\>\""}], "]"}], ";", "\n", "  ", 
             RowBox[{"stateFactor", "[", 
              RowBox[{
               RowBox[{"productKet", "[", 
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Cos", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"I", " ", "#2"}], "]"}], " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}]}]}], "}"}], "&"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"theta", ",", "phi"}], "}"}]}], "]"}], "]"}], ",", 
               RowBox[{"2", "^", "n"}], ",", "tol"}], "]"}]}], ",", "\n", 
            "  ", 
            RowBox[{"bulkFactor", "[", 
             RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"prob", "=", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", 
                 RowBox[{"2", "^", "n"}], "]"}]}], ",", 
               RowBox[{"2", "^", "n"}]}], "]"}], " ", ".", " ", "f"}], "]"}], 
           "^", "2"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"1", "-", "prob"}], "]"}], ">", "tol"}], 
           ",", "\"\<QST: an all-plus bulk is excluded; f1 is reserved for \
the two edges.\>\""}], "]"}], ";", "f"}]}], "\n", "]"}]}], ";"}], "\n", ")"}],
    ";"}], "\n"}]], "Input",
