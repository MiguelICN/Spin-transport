Cell["\<\
 1.3 Compute complete eigenpairs and the three eigenstate observables \
\>", "Subsection",ExpressionUUID->"3fae0914-619e-3c48-8a6d-b4dcbab1889e"],

Cell[BoxData[""], "Input",
 CellLabel->"In[61]:=",ExpressionUUID->"2c6125ff-f5a2-8c4d-8f80-822c4d7de860"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"statGSeconds", ",", "statGRun"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"staticScan", "[", 
        RowBox[{
