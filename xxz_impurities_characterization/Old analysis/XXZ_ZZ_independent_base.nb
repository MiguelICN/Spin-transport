Cell[CellGroupData[{

Cell[" 1.2 Fixed Delta: editable g scan ", "Subsection",ExpressionUUID->"bc5b2413-ed34-884b-b0b5-aaf20c649d68"],

Cell[BoxData[""], "Input",ExpressionUUID->"c9a811c2-4d85-2d41-8216-5dfb10493d4f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"statGModel", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
       RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
       RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"statGGrid", "=", 
     RowBox[{"N", "[", 
      RowBox[{"Subdivide", "[", 
       RowBox[{"0.01", ",", "0.2", ",", "200"}], "]"}], "]"}]}], ";", "\n", 
    RowBox[{"statGEDTolerance", "=", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}]}], ";", "\n", 
    RowBox[{"statGPlotSettings", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<PlotChop\>\"", "->", 
        RowBox[{"10", "^", 
         RowBox[{"-", "10"}]}]}], ",", 
       RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
       RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"SectorKeys", "->", 
