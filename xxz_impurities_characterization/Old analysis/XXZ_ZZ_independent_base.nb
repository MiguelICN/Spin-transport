                   "]"}], ",", 
                  RowBox[{"Log", "[", 
                   RowBox[{"N", "[", 
                    RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", 
                   "1"}]}], "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], 
           ",", "\n", " ", "_", ",", 
           RowBox[{"check", "[", 
