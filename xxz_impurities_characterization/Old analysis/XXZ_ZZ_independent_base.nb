Cell[CellGroupData[{

Cell[" 1.6 Fixed g: editable Delta scan ", "Subsection",ExpressionUUID->"1729cb14-8790-874b-a421-e49d90bb38ec"],

Cell[BoxData[""], "Input",ExpressionUUID->"bdc1a4d1-77b5-4649-89b8-5c9d95eb7971"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"statDeltaModel", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
        RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
        RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"statDeltaGrid", "=", 
      RowBox[{"N", "[", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{"-", "3"}], ",", "3", ",", "60"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"statDeltaEDTolerance", "=", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ";", "\n", 
     RowBox[{"statDeltaPlotSettings", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<PlotChop\>\"", "->", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
        RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"SectorKeys", "->", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ",
          "limits", " ", 
         RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
       RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
        RowBox[{"computed", "."}]}]}], " ", "*)"}], "\n", 
     RowBox[{"statDeltaOutputRoot", "=", 
      RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
     RowBox[{"statDeltaRunLabel", "=", "\"\<ZZ_static_Delta\>\""}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Code",
 CellChangeTimes->{{4.001106841823862*^9, 4.0011068526551723`*^9}},
 CellLabel->"In[45]:=",ExpressionUUID->"25f1a097-dede-dc44-9f92-72bcb89d0e25"],

Cell["\<\
 All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches. \
\>", "Text",ExpressionUUID->"9d5975b5-2e85-6c4f-ad18-69f8d3bf912c"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.7 Compute complete eigenpairs and the three eigenstate observables \
\>", "Subsection",ExpressionUUID->"404b3e05-ccc6-f847-9f00-ca25c3970acc"],

Cell[BoxData[""], "Input",ExpressionUUID->"4ff10a99-6ac7-4443-a373-2eb87fbe6603"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"statDeltaSeconds", ",", "statDeltaRun"}], "}"}], "=", 
      RowBox[{"AbsoluteTiming", "[", 
       RowBox[{"staticScan", "[", 
        RowBox[{
        "statDeltaModel", ",", "\"\<Delta\>\"", ",", "statDeltaGrid", ",", 
         "statDeltaEDTolerance"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Seconds: \>\"", ",", "statDeltaSeconds", 
       ",", "\"\<; parameter points: \>\"", ",", 
       RowBox[{"Length", "[", 
        RowBox[{"statDeltaRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "]"}], 
     ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"sectorTable", "[", 
        RowBox[{"First", "[", 
         RowBox[{"statDeltaRun", "[", "\"\<Points\>\"", "]"}], "]"}], "]"}], 
       "]"}], "]"}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Code",
 CellLabel->"In[46]:=",ExpressionUUID->"3872c7cf-c283-4d44-b55b-6d71d2422ddc"],

