       RowBox[{"pairs", ".", "\n", " ", "RhoB"}], " ", "is", " ", "used", " ",
        "only", " ", "for", " ", "the", " ", "A"}], "-", "to", "-", 
      RowBox[{"B", " ", "signalling", " ", "and", " ", "A"}], "-", 
      RowBox[{"retention", " ", 
       RowBox[{"probes", ".", "\n", " ", "For"}], " ", "ZZ"}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"the", " ", "chosen", " ", "computational"}], "-", 
       RowBox[{
       "basis", " ", "BLP", " ", "pair", " ", "stays", " ", 
