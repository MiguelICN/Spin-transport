               RowBox[{"{", "}"}]}], ",", 
              RowBox[{"\"\<Maximum\>\"", "->", 
               RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}]}], 
             "|>"}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"ts", "=", 
          RowBox[{"times", "[", 
           RowBox[{"[", "ix", "]"}], "]"}]}], ";", 
