              RowBox[{"First", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
           "clusters"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
           RowBox[{"\"\<ChoiState\>\"", "->", 
            RowBox[{"c", "/", "4"}]}], ",", 
           RowBox[{"\"\<Transfer\>\"", "->", 
            RowBox[{"choiToTransfer", "[", "c", "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",", 
           RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
            RowBox[{"relativeTol", " ", "scale"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
           RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
           RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
            RowBox[{"Max", "[", "widths", "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<SingletonClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
             "]"}]}], ",", 
           RowBox[{"\"\<DegenerateClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
              RowBox[{"_", "?", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", 
           "\n", "  ", 
           RowBox[{"\"\<TPError\>\"", "->", 
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
              RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
           RowBox[{"\"\<MapEntropy\>\"", "->", 
            RowBox[{"entropy", "[", 
             RowBox[{"c", "/", "4"}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
            RowBox[{"Min", "[", 
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"herm", "[", 
                RowBox[{"choiPartialTransposeOut", "[", 
                 RowBox[{"c", "/", "4"}], "]"}], "]"}], "]"}], "]"}], 
             "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";", "\n", "\n", 
     RowBox[{
      RowBox[{"onsetTime", "[", 
       RowBox[{"times_List", ",", "vals_List", ",", "threshold_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pos", ",", "k"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], "==", 
             RowBox[{"Length", "[", "vals", "]"}]}], " ", "&&", " ", 
            RowBox[{"realQ", "[", "threshold", "]"}], " ", "&&", " ", 
            RowBox[{"threshold", ">", "0"}]}], 
           ",", "\"\<Invalid onset threshold/data.\>\""}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"pos", "=", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"vals", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{
              RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
              RowBox[{"x", ">", "threshold"}]}]}], ",", 
            RowBox[{"Missing", "[", "\"\<BelowThreshold\>\"", "]"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MissingQ", "[", "pos", "]"}], ",", 
           RowBox[{"Return", "[", "pos", "]"}]}], "]"}], ";", 
         RowBox[{"k", "=", 
          RowBox[{"First", "[", "pos", "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"k", "==", "1"}], ",", 
           RowBox[{"First", "[", "times", "]"}], ",", 
           RowBox[{
            RowBox[{"times", "[", 
             RowBox[{"[", 
              RowBox[{"k", "-", "1"}], "]"}], "]"}], "+", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"threshold", "-", 
               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"times", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"times", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"vals", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "-", 
                RowBox[{"vals", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}]}]}], 
          "]"}]}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[109]:=",ExpressionUUID->"4405b8f1-8043-fb4f-adaa-0394004a4ab0"],

Cell["\<\
 For a fixed normalized bulk state rhoM, Phi_t(X)=Tr_M[U_t (X tensor rhoM) \
U_t dagger]. C_t=sum_ij |i><j| tensor Phi_t(|i><j|); Tr C_t=4 and C_t/4 is \
the Choi state. C_t depends only on the model, bulk state and time. There is \
no initial-edge-state input to chBuild. Full correlated preparations belong \
to chapter 2; one cannot assign them a universal CPTP map for arbitrary edge \
inputs. \
\>", "Text",ExpressionUUID->"fd46fa92-9ef8-a349-818d-ed226676fa45"],

Cell["\<\
 ZZ fast implementation: diagonalize only occupied conditional BULK \
magnetization blocks. At zero fields reuse spin-flip partner eigenvectors; \
equal end couplings allow reflection-parity ED. Evolve pruned columns in \
real-arithmetic time batches for pure/low-rank states, or cache six overlap \
matrices for a rank-independent mixed-bulk time loop. Automatic selects by \
estimated cost and cache limit. Only the bulk-sector-diagonal part of rhoM \
affects this channel; no sector dephasing is applied to the exchange \
preparation. \
\>", "Text",ExpressionUUID->"54e0f0bd-7159-6947-a2cb-dc15468c789c"],

Cell["\<\
 Map observables include CP/TP diagnostics, Choi spectrum/entropy/rank, \
reference-output negativity, exact time-local generator and canonical rates \
where invertible, finite-step and instantaneous RHP witnesses, selected-pair \
BLP backflow, covariance violations, unitality, double-quantum coherence, \
signalling and retention. Probe edge states below affect only BLP/signalling \
diagnostics, not the Choi matrix. A PPT Choi state does not prove \
entanglement breaking in 4x4. \
\>", "Text",ExpressionUUID->"3f190346-564c-6a40-8f59-87bb901b1f2e"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 Fast channel definitions: conditional/column-pruned batches \
\>", "Subsubsection",ExpressionUUID->"769f7841-eb48-9640-8f03-5e7c5309fc6a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapSectors", "[", "n_Integer", "]"}], " ", ":=", " ", 
      RowBox[{"Values", "[", 
       RowBox[{"KeySort", "[", 
        RowBox[{"PositionIndex", "[", 
         RowBox[{"DigitCount", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{
              RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}]}], "]"}], ",", 
           " ", "2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapReflectPerm", "[", 
       RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"AssociationThread", "[", 
         RowBox[{"ix", ",", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "ix", "]"}], "]"}]}], "]"}], ",", " ", 
        RowBox[{
         RowBox[{"IntegerReverse", "[", 
          RowBox[{
           RowBox[{"ix", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "n"}],
           "]"}], " ", "+", " ", "1"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapParityQ", "[", 
       RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"d", " ", "=", " ", 
           RowBox[{"Length", "[", "ix", "]"}]}], ",", " ", "jr", ",", " ", 
          "fix", ",", " ", "pr", ",", " ", "nf", ",", " ", "qe", ",", " ", 
          "qo"}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"jr", " ", "=", " ", 
          RowBox[{"chMapReflectPerm", "[", 
           RowBox[{"ix", ",", " ", "n"}], "]"}]}], ";", " ", 
         RowBox[{"fix", " ", "=", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"Position", "[", 
            RowBox[{
             RowBox[{"jr", " ", "-", " ", 
              RowBox[{"Range", "[", "d", "]"}]}], ",", " ", "0"}], "]"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"pr", " ", "=", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Range", "[", "d", "]"}], ",", " ", "jr"}], "}"}], 
             "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", 
         " ", 
         RowBox[{"nf", " ", "=", " ", 
          RowBox[{"Length", "[", "fix", "]"}]}], ";", "\n", "  ", 
         RowBox[{"qe", " ", "=", " ", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{"fix", ",", " ", 
                   RowBox[{"Range", "[", "nf", "]"}]}], "}"}], "]"}], " ", "->",
                 " ", "1."}], "]"}], ",", "\n", "      ", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                   RowBox[{"nf", " ", "+", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], 
                 "]"}], " ", "->", " ", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
              "      ", 
              RowBox[{"Thread", "[", 
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                   RowBox[{"nf", " ", "+", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], 
                 "]"}], " ", "->", " ", 
                RowBox[{"1", "/", 
                 RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
            " ", 
            RowBox[{"{", 
             RowBox[{"d", ",", " ", 
              RowBox[{"nf", " ", "+", " ", 
               RowBox[{"Length", "[", "pr", "]"}]}]}], "}"}]}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"qo", " ", "=", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"pr", " ", "===", " ", 
             RowBox[{"{", "}"}]}], ",", " ", "Nothing", ",", " ", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}],
                   " ", "->", " ", 
                  RowBox[{"1", "/", 
                   RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
                "      ", 
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Transpose", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"pr", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                    RowBox[{"Range", "[", 
                    RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}],
                   " ", "->", " ", 
                  RowBox[{
                   RowBox[{"-", "1"}], "/", 
                   RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
              " ", 
              RowBox[{"{", 
               RowBox[{"d", ",", " ", 
                RowBox[{"Length", "[", "pr", "]"}]}], "}"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"qe", ",", " ", "qo"}], "}"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{"chEDTolerance", "=", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapSectorEigen", "[", 
       RowBox[{"h_", ",", "ix_List", ",", "n_Integer", ",", "parity_"}], 
       "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"hb", "=", 
           RowBox[{"N", "[", 
            RowBox[{"h", "[", 
             RowBox[{"[", 
              RowBox[{"ix", ",", "ix"}], "]"}], "]"}], "]"}]}], ",", "es", ",",
           "out", ",", "perm", ",", "scale"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{"hb", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", 
         " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{"Im", "[", "hb", "]"}], "]"}], "<=", 
             RowBox[{"chEDTolerance", " ", "scale"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{"hb", "-", 
               RowBox[{"ConjugateTranspose", "[", "hb", "]"}]}], "]"}], "<=", 
             RowBox[{"chEDTolerance", " ", "scale"}]}]}], 
           ",", "\"\<Channel ED requires a real symmetric Hamiltonian.\>\""}],
           "]"}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", "parity", "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "ix", "]"}], ">", "1"}]}], ",", "\n", 
           "  ", 
           RowBox[{
            RowBox[{"perm", "=", 
             RowBox[{"chMapReflectPerm", "[", 
              RowBox[{"ix", ",", "n"}], "]"}]}], ";", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{"hb", "-", 
                 RowBox[{"hb", "[", 
                  RowBox[{"[", 
                   RowBox[{"perm", ",", "perm"}], "]"}], "]"}]}], "]"}], "<=", 
               RowBox[{"chEDTolerance", " ", "scale"}]}], 
              ",", "\"\<Channel reflection block is not invariant.\>\""}], 
             "]"}], ";", "\n", "  ", 
            RowBox[{"es", "=", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"With", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"x", "=", 
                   RowBox[{"Eigensystem", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"Transpose", "[", "q", "]"}], " ", ".", " ", "hb",
                     " ", ".", " ", "q"}], "]"}], "]"}]}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"x", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                   RowBox[{"Normal", "[", 
                    RowBox[{"q", " ", ".", " ", 
                    RowBox[{"Transpose", "[", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}],
                 "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"q", ",", 
                 RowBox[{"chMapParityQ", "[", 
                  RowBox[{"ix", ",", "n"}], "]"}]}], "}"}]}], "]"}]}], ";", 
            "\n", "  ", 
            RowBox[{"out", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<E\>\"", "->", 
                RowBox[{"Join", "@@", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
               RowBox[{"\"\<V\>\"", "->", 
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"Sequence", "@@", 
                   RowBox[{"es", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "2"}], 
                 "]"}]}]}], "|>"}]}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"es", "=", 
             RowBox[{"Eigensystem", "[", 
              RowBox[{"Normal", "[", "hb", "]"}], "]"}]}], ";", 
            RowBox[{"out", "=", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<E\>\"", "->", 
                RowBox[{"es", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<V\>\"", "->", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "|>"}]}]}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"hb", " ", ".", " ", 
               RowBox[{"out", "[", "\"\<V\>\"", "]"}]}], "-", 
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{"out", "[", "\"\<E\>\"", "]"}], " ", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"out", "[", "\"\<V\>\"", "]"}], "]"}]}], "]"}]}], 
             "]"}], "<=", 
            RowBox[{"100", " ", "chEDTolerance", " ", "scale"}]}], 
           ",", "\"\<Channel eigenpair residual failed.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{
                RowBox[{"out", "[", "\"\<V\>\"", "]"}], "^", "2"}], "]"}], "-",
               "1"}], "]"}], "<=", 
            RowBox[{"100", " ", "chEDTolerance"}]}], 
           ",", "\"\<Channel eigenvector normalization failed.\>\""}], "]"}], 
         ";", "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[110]:=",ExpressionUUID->"b21d001e-9c4f-474d-bdb6-877e66677822"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapPhaseBlock", "[", 
       RowBox[{"e_List", ",", " ", 
        RowBox[{"c_", "?", "MatrixQ"}], ",", " ", "tc_List", ",", " ", 
        RowBox[{"dot_", " ", ":", " ", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"ph", " ", "=", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", " ", "e", ",", " ", "tc"}], "]"}]}], 
           "]"}]}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"TrueQ", "[", "dot", "]"}], ",", " ", 
           RowBox[{"ph", " ", "=", " ", 
            RowBox[{
             RowBox[{"-", "I"}], " ", "e", " ", "ph"}]}]}], "]"}], ";", "\n", 
         "  ", 
         RowBox[{"ArrayReshape", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ph", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "tau"}], "]"}], "]"}], " ", "c"}], 
               ",", " ", 
               RowBox[{"{", 
                RowBox[{"tau", ",", " ", 
                 RowBox[{"Length", "[", "tc", "]"}]}], "}"}]}], "]"}], ",", 
             " ", 
             RowBox[{"{", 
              RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ",",
            " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Length", "[", "e", "]"}], ",", " ", 
             RowBox[{
              RowBox[{"Length", "[", "tc", "]"}], " ", 
              RowBox[{"Last", "[", 
               RowBox[{"Dimensions", "[", "c", "]"}], "]"}]}]}], "}"}]}], 
          "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chMapRealDot", "[", 
       RowBox[{
        RowBox[{"v_", "?", "MatrixQ"}], ",", " ", 
        RowBox[{"b_", "?", "MatrixQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"v", " ", ".", " ", 
        RowBox[{"Re", "[", "b", "]"}]}], " ", "+", " ", 
       RowBox[{"I", " ", 
        RowBox[{"v", " ", ".", " ", 
         RowBox[{"Im", "[", "b", "]"}]}]}]}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[111]:=",ExpressionUUID->"e704c46c-f55e-e44a-9010-d6357095af66"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chMapGibbsFactor", "[", 
       RowBox[{"delta_", ",", " ", "p_Association", ",", " ", 
        RowBox[{"beta_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", " ", "=", " ", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", "h", ",", " ", 
          "sec", ",", " ", "es", ",", " ", "e0", ",", " ", "w", ",", " ", 
          "fac", ",", " ", 
          RowBox[{"col", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"h", " ", "=", " ", 
