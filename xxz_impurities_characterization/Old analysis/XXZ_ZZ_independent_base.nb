            "\n", "  ", 
            RowBox[{"AssociateTo", "[", 
             RowBox[{"out", ",", 
              RowBox[{
               RowBox[{"\"\<LocalCoherences_\>\"", "<>", "part"}], "->", 
               RowBox[{"plotPanel", "[", 
                RowBox[{"\"\<\\\\text{Single-edge coherences}\>\"", ",", 
                 RowBox[{"trajectoryCaption", "[", 
                  RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}],
              "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"part", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
              "}"}]}], "}"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"curves", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<EigenvaluesAB\>\"", "]"}], "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], "}"}], "&"}], " ", "/@",
                 " ", "records"}], ")"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"!", "log"}], " ", "||", " ", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
             "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"g", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
             "curves", ",", "\"\<t\>\"", 
              ",", "\"\<\\\\lambda_k(\\\\rho_{AB})\>\"", ",", 
              RowBox[{"curveStyles", "[", "4", "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"\"\<\\\\lambda_\>\"", "<>", 
                 RowBox[{"ToString", "[", "k", "]"}], 
                 "<>", "\"\<(\\\\rho_{AB})\>\""}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "4"}], "}"}]}], "]"}], ",", "False", ",", 
              "log", ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
                RowBox[{"{", "4", "}"}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
