              RowBox[{
               RowBox[{
                RowBox[{"s", "[", "\"\<V\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", 
                  RowBox[{"item", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "+", 
               RowBox[{"0.", "I"}]}]}], ";", "\n", "  ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"partitionFactor", "[", 
                RowBox[{
                 RowBox[{"Transpose", "[", 
                  RowBox[{"{", "v", "}"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
                 RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
               RowBox[{
                RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"item", "[", 
                  RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"cross", "[", 
           RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"b", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
             RowBox[{"ConjugateTranspose", "[", 
              RowBox[{"b", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]}], ";", "\n", 
         " ", 
         RowBox[{"r", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"0.", "+", 
             RowBox[{"0.", "I"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"f", "=", 
             RowBox[{"lev", " ", "/@", " ", "cluster"}]}], ";", 
            RowBox[{"r", "+=", 
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"cross", "[", 
                 RowBox[{"#", ",", "#"}], "]"}], "&"}], " ", "/@", " ", "f"}],
               "]"}]}], ";", "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"x", "=", 
                RowBox[{"cross", "[", 
                 RowBox[{
                  RowBox[{"f", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], ",", 
                  RowBox[{"f", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
               RowBox[{"r", "+=", 
                RowBox[{"x", "+", 
                 RowBox[{"ConjugateTranspose", "[", "x", "]"}]}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", 
                RowBox[{"Length", "[", "f", "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", 
                RowBox[{"i", "+", "1"}], ",", 
                RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"cluster", ",", "clusters"}], "}"}]}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"widths", "=", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Last", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
           "clusters"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
           RowBox[{"\"\<SigmaAB\>\"", "->", 
            RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
           RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",",
            "\n", " ", 
           RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
            RowBox[{"relativeTol", " ", "scale"}]}], ",", 
           RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
           RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", "\n", " ", 
           RowBox[{"\"\<SingletonClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
             "]"}]}], ",", 
           RowBox[{"\"\<DegenerateClusters\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{
              RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
              RowBox[{"_", "?", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", 
           "\n", " ", 
           RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
            RowBox[{"Max", "[", "widths", "]"}]}], ",", 
           RowBox[{"\"\<TraceError\>\"", "->", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "r", "]"}], "-", "1"}], "]"}]}]}], 
          "|>"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstAverageChannel", "[", 
       RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"av", "=", 
           RowBox[{"timeAveragedMap", "[", 
            RowBox[{"eng", ",", "relativeTol"}], "]"}]}], ",", "r"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"responseOperator", "[", 
           RowBox[{"av", "[", "\"\<Transfer\>\"", "]"}], "]"}]}], ";", 
         RowBox[{"Join", "[", 
          RowBox[{"av", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<OmegaTF\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"grandSum", "[", 
                 RowBox[{"av", "[", "\"\<Choi\>\"", "]"}], "]"}], "/", 
                "16"}]}]}], ",", "\n", " ", 
             RowBox[{"\"\<ResponseOperator\>\"", "->", "r"}], ",", 
             RowBox[{"\"\<ResponseEigenvalues\>\"", "->", 
              RowBox[{"Sort", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Eigenvalues", "[", 
                 RowBox[{"herm", "[", "r", "]"}], "]"}], "]"}], "]"}]}]}], 
            "|>"}]}], "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstWindowMean", "[", 
       RowBox[{"records_", ",", "key_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"t", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"records", ",", "\"\<Time\>\""}], "]"}]}], ",", 
          RowBox[{"y", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"records", ",", "key"}], "]"}]}], ",", "bad", ",", "inf", 
          ",", "value"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"bad", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"y", ",", "_Missing"}], "]"}]}], ";", 
         RowBox[{"inf", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"y", ",", "Infinity"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"value", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"bad", ">", "0"}], ",", 
            RowBox[{"Missing", "[", "\"\<InvalidSamples\>\"", "]"}], ",", 
            RowBox[{"inf", ">", "0"}], ",", 
            RowBox[{
            "Missing", "[", "\"\<SingularSamplesRequireQuadrature\>\"", "]"}],
             ",", "\n", "  ", "True", ",", 
            RowBox[{
             RowBox[{"Total", "[", 
              RowBox[{
               RowBox[{"Differences", "[", "t", "]"}], " ", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"Most", "[", "y", "]"}], "+", 
                  RowBox[{"Rest", "[", "y", "]"}]}], ")"}], "/", "2"}]}], 
              "]"}], "/", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"First", "[", "t", "]"}]}], ")"}]}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Observable\>\"", "->", "key"}], ",", 
           RowBox[{"\"\<Window\>\"", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "t", "]"}], ",", 
              RowBox[{"Last", "[", "t", "]"}]}], "}"}]}], ",", 
           
           RowBox[{"\"\<Method\>\"", 
            "->", "\"\<Trapezoidal in physical time\>\""}], ",", "\n", " ", 
           RowBox[{"\"\<Value\>\"", "->", "value"}], ",", 
           RowBox[{"\"\<InfiniteSamples\>\"", "->", "inf"}], ",", 
           RowBox[{"\"\<InvalidSamples\>\"", "->", "bad"}], ",", "\n", " ", 
           
           RowBox[{"\"\<Note\>\"", 
            "->", "\"\<A logarithmic singularity at a sampled zero need not \
make the time integral infinite; no value is inferred there.\>\""}]}], 
          "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
