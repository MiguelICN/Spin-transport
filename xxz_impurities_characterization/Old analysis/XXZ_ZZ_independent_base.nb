             "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"neg", ",", "pos"}], "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", "errs", "]"}], "<", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
           ",", "\"\<Conjugate-bulk time-reversal check failed.\>\""}], "]"}],
          ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Indices\>\"", "->", "ix"}], ",", 
