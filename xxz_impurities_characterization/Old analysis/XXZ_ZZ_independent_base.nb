                     "2"}], "]"}], "<>", "\"\<}\>\""}], ",", 
                   RowBox[{"{", 
                    RowBox[{"pair", ",", "pairs"}], "}"}]}], "]"}]}], 
                "]"}]}]}], "]"}]}], ",", 
           RowBox[{"{", 
