                RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\""}], "}"}]}], "}"}]}], 
            "]"}]}], "]"}], ";", "out"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
