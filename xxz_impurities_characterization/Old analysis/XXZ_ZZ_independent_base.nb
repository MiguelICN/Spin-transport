                    "|>"}]}], "]"}], "&"}], " ", "/@", " ", "children"}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"parent", ",", "parents"}], "}"}]}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"groups", "=", 
          RowBox[{"GatherBy", "[", 
