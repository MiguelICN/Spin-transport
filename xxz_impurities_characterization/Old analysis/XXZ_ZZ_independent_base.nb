Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstAParallel", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Enabled\>\"", "->", "False"}], ",", 
