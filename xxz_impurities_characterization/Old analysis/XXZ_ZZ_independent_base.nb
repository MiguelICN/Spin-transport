                   "4"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "4"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", 
                  RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], 
              "]"}]}], "]"}], "]"}]}], ";", "\n", " ", 
