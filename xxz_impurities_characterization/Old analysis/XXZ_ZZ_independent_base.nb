       RowBox[{"Join", "[", 
        RowBox[{"qstAPlots", ",", "\n", " ", 
         RowBox[{"Association", "[", 
          RowBox[{"KeyValueMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], 
             "&"}], ",", 
            RowBox[{"texturePanels", "[", 
             RowBox[{
             "qstARecords", ",", "qstAShortRecords", ",", "qstAUsed", ",", 
              "qstAShortUsed", ",", "True"}], "]"}]}], "]"}], "]"}]}], 
        "]"}]}]}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
