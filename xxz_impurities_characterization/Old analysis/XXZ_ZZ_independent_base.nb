Cell[CellGroupData[{

Cell[" 2.7 Export this independent trajectory ", "Subsection",ExpressionUUID->"56af72c5-5351-ff4e-8100-37e9e45f351e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"dynDirectory", "=", 
     RowBox[{"exportBundle", "[", 
      RowBox[{
      "dynOutputRoot", ",", "dynRunLabel", ",", "dynPlots", ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Model\>\"", "->", "dynModelUsed"}], ",", 
         RowBox[{"\"\<InitialSpecification\>\"", "->", "dynInitialUsed"}], ",", 
         RowBox[{"\"\<InitialFactor\>\"", "->", "dynFactor"}], ",", "\n", " ", 
         RowBox[{"\"\<Settings\>\"", "->", "dynSettingsUsed"}], ",", 
         RowBox[{"\"\<InitialDiagnostics\>\"", "->", 
          "dynInitialDiagnostics"}], ",", 
         RowBox[{"\"\<TimeSettings\>\"", "->", "dynTimeUsed"}], ",", 
         RowBox[{"\"\<Times\>\"", "->", "dynTimes"}], ",", "\n", " ", 
         RowBox[{"\"\<Engine\>\"", "->", "dynEngine"}], ",", 
         RowBox[{"\"\<SetupSeconds\>\"", "->", "dynSetupSeconds"}], ",", 
         RowBox[{"\"\<EvolutionSeconds\>\"", "->", "dynSeconds"}], ",", 
         RowBox[{"\"\<Records\>\"", "->", "dynRecords"}]}], "|>"}]}], "]"}]}],
     ";", "\n", 
    RowBox[{"Print", "[", "dynDirectory", "]"}], ";"}], "\n", ")"}], 
  ";"}]], "Code",
