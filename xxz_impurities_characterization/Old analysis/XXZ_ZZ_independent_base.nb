Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"chPrepare", "[", 
       RowBox[{"eng_", ",", "times_List", ",", "cfg_"}], "]"}], " ", ":=", 
      " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "method", ",", "cost", ",", "entries", ",", "overlaps", ",", 
          "rankmax"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"method", "=", 
          RowBox[{"cfg", "[", "\"\<ZZMethod\>\"", "]"}]}], ";", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"MemberQ", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "Automatic", ",", "\"\<Direct\>\"", ",", "\"\<Overlap\>\""}], 
              "}"}], ",", "method"}], "]"}], 
           ",", "\"\<ZZMethod must be Automatic, Direct or Overlap.\>\""}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"cost", "=", 
          RowBox[{"chZzCost", "[", 
           RowBox[{"eng", ",", 
            RowBox[{"Length", "[", "times", "]"}]}], "]"}]}], ";", 
         RowBox[{"entries", "=", 
          RowBox[{"6", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], 
                  "[", "\"\<E\>\"", "]"}], "]"}], "^", "2"}], ")"}], "&"}], 
             " ", "/@", " ", 
             RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "]"}]}]}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"method", "===", "Automatic"}], ",", 
           RowBox[{"method", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"cost", "[", "\"\<Overlap\>\"", "]"}], "<", 
                RowBox[{"cost", "[", "\"\<Direct\>\"", "]"}]}], " ", "&&", 
               " ", 
               RowBox[{"entries", "<=", 
                RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}]}]}], 
              ",", "\"\<Overlap\>\"", ",", "\"\<Direct\>\""}], "]"}]}]}], 
          "]"}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"method", "==", "\"\<Overlap\>\""}], ",", 
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{"entries", "<=", 
              RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}]}], 
             ",", "\"\<ZZ overlap cache exceeds MaxOverlapEntries; raise the \
limit or choose Direct.\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"rankmax", "=", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Last", "[", 
              RowBox[{"Dimensions", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], 
                "[", "\"\<C\>\"", "]"}], "]"}], "]"}], "&"}], " ", "/@", " ", 
            RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"method", "!=", "\"\<Direct\>\""}], " ", "||", " ", 
            RowBox[{"rankmax", "<=", 
             RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}]}]}], 
           ",", "\"\<One ZZ time slice exceeds MaxColumns; raise the limit.\>\
\""}], "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Method\>\"", "->", "method"}], ",", 
           RowBox[{"\"\<EstimatedFlops\>\"", "->", "cost"}], ",", 
           RowBox[{"\"\<OverlapEntries\>\"", "->", "entries"}], ",", 
           RowBox[{"\"\<Overlaps\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"method", "==", "\"\<Overlap\>\""}], ",", 
              RowBox[{"chZzOverlaps", "[", "eng", "]"}], ",", 
              RowBox[{"Missing", "[", "\"\<NotRequired\>\"", "]"}]}], 
             "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"chSeries", "[", 
       RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", 
        RowBox[{"prepared_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "pr", ",", "raw", ",", "chi", ",", "cd", ",", "fs", ",", "fds", ",", 
          "width"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "times", "]"}], ">", "0"}], " ", "&&", 
            " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"times", ",", "realQ"}], "]"}]}], 
           ",", "\"\<Channel times must be finite and real.\>\""}], "]"}], ";",
          "\n", " ", 
         RowBox[{"pr", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"prepared", "===", "Automatic"}], ",", 
            RowBox[{"chPrepare", "[", 
             RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}], ",", 
            "prepared"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "times", "]"}], ">", 
            RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Join", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"chSeries", "[", 
                 RowBox[{"eng", ",", "#", ",", "cfg", ",", "pr"}], "]"}], 
                "&"}], " ", "/@", " ", 
               RowBox[{"Partition", "[", 
                RowBox[{"times", ",", 
                 RowBox[{"UpTo", "[", 
                  RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
                "]"}]}], ")"}]}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"raw", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"pr", "[", "\"\<Method\>\"", "]"}], 
             "==", "\"\<Direct\>\""}], ",", 
            RowBox[{"chZzFactorsDirect", "[", 
             RowBox[{"eng", ",", "times", ",", 
              RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}], ",", "True"}], 
             "]"}], ",", "\n", " ", 
            RowBox[{"chZzFactorsOverlap", "[", 
             RowBox[{"eng", ",", 
              RowBox[{"pr", "[", "\"\<Overlaps\>\"", "]"}], ",", "times", ",",
               "True"}], "]"}]}], "]"}]}], ";", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"fs", ",", "fds"}], "}"}], "=", "raw"}], ";", "\n", " ", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"f", ",", "fd"}], "}"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<DephasingFactors\>\"", "->", "f"}], ",", 
               RowBox[{"\"\<DephasingDerivative\>\"", "->", "fd"}], ",", "\n",
                " ", 
               RowBox[{"\"\<Choi\>\"", "->", 
                RowBox[{"4", " ", 
                 RowBox[{"chZzChoi", "[", "f", "]"}]}]}], ",", 
               RowBox[{"\"\<ChoiState\>\"", "->", 
                RowBox[{"chZzChoi", "[", "f", "]"}]}], ",", 
               RowBox[{"\"\<Transfer\>\"", "->", 
                RowBox[{"chZzSuper", "[", "f", "]"}]}], ",", 
               RowBox[{"\"\<TransferDerivative\>\"", "->", 
                RowBox[{"chZzSuper", "[", "fd", "]"}]}]}], "|>"}]}], "]"}], ",", 
