Notebook[{

Cell[CellGroupData[{
Cell[" XXZ bulk with ZZ edge coupling ", "Title",ExpressionUUID->"10e2b221-691d-c54e-8567-877b2d42dc8a"],

Cell["\<\
 L total spins: edges A=1 and B=L, bulk M={2,...,L-1}. No magnetic fields are \
added. This notebook is self-contained. Evaluate its initialization cells \
once; the two static scans, state dynamics and channel dynamics then run \
independently. All model parameters are editable within their own run. g must \
be nonzero; Delta may be zero. These .m files use separate named contexts. \
Evaluate the Begin cell first: it saves the caller search path and restricts \
symbol lookup to System` while this file context is active. Evaluate the \
final cell to restore the path. Evaluate all required definition cells before \
a chosen run; run cells are executable. Get evaluates every run. \
\>", "Text",ExpressionUUID->"42412852-0d11-094c-973c-d36129b99775"],

Cell[BoxData[
 StyleBox[
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"Begin", "[", "\"\<XXZZZ`\>\"", "]"}], ";", " ", 
     RowBox[{"XXZZZ`savedContextPath", "=", "$ContextPath"}], ";", " ", 
     RowBox[{"$ContextPath", "=", 
      RowBox[{"{", "\"\<System`\>\"", "}"}]}], ";"}], "\n", ")"}], ";"}], 
  "Input"]], "Input",
 InitializationCell->True,
 CellChangeTimes->{4.001106729095789*^9},
 CellLabel->"In[1]:=",ExpressionUUID->"93cd5120-6583-cd49-b073-90cf83231d6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[" 1. Statics: complete sector eigenpairs, entropies and IPR ", "Title",ExpressionUUID->"65fd3fd8-1f40-9147-ae32-748b50b07c36"],

Cell[CellGroupData[{

Cell[" 1.1 Definitions shared by all four chapters ", "Subsection",ExpressionUUID->"e4199f92-99cc-f546-8f35-ba6be9e55a8e"],

Cell["\<\
 Initialization cells contain definitions only. They do not start a scan, \
diagonalize a model, choose an initial state, plot, or export. Their \
benchmark conventions are S=sigma/2, hbar=1, bit 0=up, natural-log entropy, \
edge basis {00,01,10,11}. Both end bonds replace the usual XXZ end bonds. \
\>", "Text",ExpressionUUID->"0eea4cfd-1d5b-6f41-872f-d62419b77be2"],

Cell["\<\
 H = J Sum[j=2,...,L-2](Sjx S(j+1)x + Sjy S(j+1)y + Delta Sjz S(j+1)z) + g \
(S1z S2z + S(L-1)z SLz). J and g have energy units. In the exchange case the \
spin-flip matrix element is g/2. \
\>", "Text",ExpressionUUID->"3cc843af-80b9-3b4b-8ed0-540a3431f6c9"],

Cell["\<\
 ZZ resolves sA, sB and mBulk first. Reflection R is compatible when sA=sB; \
RF is compatible when sA=-sB and mBulk=0. Other partners remain separate. \
Actual conditional-bulk charges are checked and added when compatible, \
including the two-site bulk Casimir at Delta=+/-1 with equal conditional \
fields. Each eigenvector in this basis has zero edges-versus-bulk entropy. At \
Delta=0 the Hamiltonian is free fermionic (conditional bulk for ZZ); the \
benchmark spin/spatial classification stays valid, with additional conserved \
mode occupations and possible degeneracies. It is not a classification of \
every integrability charge. No degenerate energy vectors are silently mixed \
or pooled across the listed sectors. \
\>", "Text",ExpressionUUID->"37f74e42-bf09-6f43-9e74-26a682c9b306"],

Cell[CellGroupData[{

Cell[" Utilities, spin operators and Hamiltonian guards ", "Subsubsection",ExpressionUUID->"a6e642bc-fe99-f543-903e-25c61c4d9dab"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
     "Stop", " ", "the", " ", "current", " ", "cell", " ", "if", " ", "an", " ",
       "input", " ", "or", " ", "validation", " ", 
      RowBox[{"fails", "."}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{"test_", ",", "message_"}], "]"}], " ", ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"TrueQ", "[", "test", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           RowBox[{"message", ",", "Red"}], " ", "]"}], "]"}], ";", 
         RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"realQ", "[", "x_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
       RowBox[{"NumberQ", "[", 
        RowBox[{"N", "[", "x", " ", "]"}], "]"}], " ", "&&", " ", 
       RowBox[{"TrueQ", "[", 
        RowBox[{
         RowBox[{"Im", "[", 
          RowBox[{"N", "[", "x", " ", "]"}], "]"}], "==", "0"}], "]"}]}]}], ";",
      "\n", 
     RowBox[{
      RowBox[{"id", "[", "n_", "]"}], " ", ":=", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Band", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", "1"}], ",", 
        RowBox[{"{", 
         RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"maxAbs", "[", "a_", "]"}], " ", ":=", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "a", "]"}], "===", "SparseArray"}], ",", "\n", 
        " ", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Abs", "[", 
            RowBox[{"a", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"Max", "[", 
         RowBox[{"0", ",", 
          RowBox[{"Sequence", "@@", 
           RowBox[{"Abs", "[", 
            RowBox[{"Flatten", "[", "a", " ", "]"}], "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"herm", "[", "a_", "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", 
         RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ")"}], "/", "2"}]}],
      ";", "\n", 
     RowBox[{
      RowBox[{"ketRho", "[", "v_", "]"}], " ", ":=", " ", 
      RowBox[{"Outer", "[", 
       RowBox[{"Times", ",", "v", ",", 
        RowBox[{"Conjugate", "[", "v", " ", "]"}]}], "]"}]}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[2]:=",ExpressionUUID->"6e66be5f-74d6-724a-8d00-0b7cac7abecd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Embed", " ", "a", " ", "one"}], "-", 
      RowBox[{"spin", " ", "or", " ", "nearest"}], "-", 
      RowBox[{"neighbour", " ", 
