               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", 
               RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}], "]"}], ",", 
            "cfg"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstMapRecords", "[", 
       RowBox[{"eng_", ",", "times_", ",", "settings_", ",", "parallel_"}], 
       "]"}], " ", ":=", " ", 
      RowBox[{"(", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"realQ", "[", 
            RowBox[{"settings", "[", "\"\<KrausTolerance\>\"", "]"}], "]"}], 
           " ", "&&", " ", 
           RowBox[{
            RowBox[{"settings", "[", "\"\<KrausTolerance\>\"", "]"}], ">", 
            "0"}]}], ",", "\"\<KrausTolerance must be positive.\>\""}], "]"}],
         ";", "\n", " ", 
        RowBox[{"qstRunChunks", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"ts", ",", 
            RowBox[{"qstMapChunk", "[", 
             RowBox[{"ts", ",", "eng", ",", "settings"}], "]"}]}], "]"}], ",",
           "times", ",", "eng", ",", "parallel"}], "]"}]}], ")"}]}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Input",
