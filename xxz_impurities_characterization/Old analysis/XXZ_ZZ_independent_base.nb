Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "GlobalchopRecordsInPlace", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetAttributes", "[", 
   RowBox[{"GlobalchopRecordsInPlace", ",", "HoldFirst"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"GlobalchopRecordsInPlace", "[", 
    RowBox[{"s_Symbol", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "12"}]}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ov", "=", 
        RowBox[{"OwnValues", "[", "s", "]"}]}], ",", "held"}], "}"}], ",", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ov", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<NotComputed\>\"", "]"}], "]"}]}], "]"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"held", "=", 
       RowBox[{"Extract", "[", 
        RowBox[{"ov", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], ",", "HoldComplete"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"!", 
         RowBox[{"MatchQ", "[", 
          RowBox[{"held", ",", 
           RowBox[{"HoldComplete", "[", 
            RowBox[{"{", "___Association", "}"}], "]"}]}], "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", "\"\<InvalidRecords\>\"", "]"}], "]"}]}], 
       "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"s", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"rec", ",", 
           RowBox[{"Association", "[", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"key", ",", "value"}], "}"}], ",", 
                RowBox[{"key", "->", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"key", "===", "\"\<Time\>\""}], ",", "value", ",", 
                   RowBox[{"Chop", "[", 
                    RowBox[{"value", ",", "tol"}], "]"}]}], "]"}]}]}], "]"}], 
              ",", "rec"}], "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"ReleaseHold", "[", "held", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "True"}]}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  4.001121355858055*^9},ExpressionUUID->"f6bc1bbe-e863-0a4a-b643-\
61aca27d893a"]
}, Closed]],

Cell[CellGroupData[{

Cell[" Optional selected-sector DOS and gap diagnostics ", "Subsubsection",ExpressionUUID->"2b10fb68-ef09-8748-90c2-9c13653cc985"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Raw", " ", "levels", " ", 
       RowBox[{"only", ":", " ", 
        RowBox[{"no", " ", "Chop"}]}]}], ",", " ", "unfolding", ",", " ", 
      RowBox[{"or", " ", "removal", " ", "of", " ", "degenerate", " ", 
       RowBox[{"levels", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"exGapRatios", "[", 
       RowBox[{"energies_List", ",", 
        RowBox[{"window_", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"e", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"N", "[", "energies", "]"}], "]"}]}], ",", "d", ",", "lo",
           ",", "hi", ",", "w", ",", "gaps", ",", "cut", ",", "pairs", ",", 
          "ratios", ",", "unresolved", ",", "status"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{"e", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "window", "]"}], "==", "2"}], " ", "&&", 
            " ", 
            RowBox[{"0", "<=", 
             RowBox[{"window", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{"window", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}], " ", "&&", "\n", 
            "  ", 
            RowBox[{"realQ", "[", "tol", "]"}], " ", "&&", " ", 
            RowBox[{"tol", ">", "0"}]}], 
           ",", "\"\<Invalid energy list, rank window, or gap \
tolerance.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "e", "]"}]}], ";", 
         RowBox[{"lo", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"window", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", 
             "1"}]}], "]"}]}], ";", 
         RowBox[{"hi", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"d", ",", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"window", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"w", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"d", ">", "0"}], " ", "&&", " ", 
             RowBox[{"hi", ">=", "lo"}]}], ",", 
            RowBox[{"e", "[", 
             RowBox[{"[", 
              RowBox[{"lo", ";;", "hi"}], "]"}], "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", 
         RowBox[{"gaps", "=", 
          RowBox[{"Differences", "[", "w", "]"}]}], ";", "\n", " ", 
         RowBox[{"cut", "=", 
          RowBox[{"tol", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], ";", 
         RowBox[{"pairs", "=", 
          RowBox[{"Partition", "[", 
           RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"ratios", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Min", "[", "#", "]"}], "<=", "cut"}], ",", 
               RowBox[{"Missing", "[", "\"\<UnresolvedGapPair\>\"", "]"}], ",", 
               RowBox[{
                RowBox[{"Min", "[", "#", "]"}], "/", 
                RowBox[{"Max", "[", "#", "]"}]}]}], "]"}], "&"}], ",", 
            "pairs"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"unresolved", "=", 
          RowBox[{"Count", "[", 
           RowBox[{"ratios", ",", "_Missing"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"status", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "w", "]"}], "<", "3"}], 
            ",", "\"\<TooFewLevels\>\"", ",", 
            RowBox[{"unresolved", ">", "0"}], ",", "\"\<UnresolvedGaps\>\"", ",",
             "True", ",", "\"\<OK\>\""}], "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<SectorDimension\>\"", "->", "d"}], ",", 
           RowBox[{"\"\<WindowRanks\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
           RowBox[{"\"\<WindowLevels\>\"", "->", 
            RowBox[{"Length", "[", "w", "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<GapPairs\>\"", "->", 
            RowBox[{"Length", "[", "pairs", "]"}]}], ",", 
           RowBox[{"\"\<UnresolvedGapPairs\>\"", "->", "unresolved"}], ",", 
           "\n", "  ", 
           RowBox[{"\"\<UnresolvedGaps\>\"", "->", 
            RowBox[{"Count", "[", 
             RowBox[{"gaps", ",", 
              RowBox[{"x_", "/;", 
               RowBox[{"x", "<=", "cut"}]}]}], "]"}]}], ",", 
           RowBox[{"\"\<GapResolution\>\"", "->", "cut"}], ",", "\n", "  ", 
           RowBox[{"\"\<Ratios\>\"", "->", "ratios"}], ",", 
           RowBox[{"\"\<MeanR\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
              RowBox[{"Mean", "[", "ratios", "]"}], ",", 
              RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ",", "\n", 
           "  ", 
           RowBox[{"\"\<IIDSEM\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"status", "==", "\"\<OK\>\""}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "ratios", "]"}], ">=", "2"}]}], ",", 
              RowBox[{
               RowBox[{"StandardDeviation", "[", "ratios", "]"}], "/", 
               RowBox[{"Sqrt", "[", 
                RowBox[{"Length", "[", "ratios", "]"}], "]"}]}], ",", 
              RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], "]"}]}],
            ",", "\n", "  ", 
           RowBox[{"\"\<MeanSpacing\>\"", "->", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "gaps", "]"}], ">", "0"}], ",", 
              RowBox[{"Mean", "[", "gaps", "]"}], ",", 
              RowBox[{"Missing", "[", "\"\<NoGaps\>\"", "]"}]}], "]"}]}], ",", 
           RowBox[{"\"\<Status\>\"", "->", "status"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[37]:=",ExpressionUUID->"6e36167b-981f-6d44-9983-b1f59ee808b7"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"selectedStaticSector", "[", 
       RowBox[{"point_", ",", "labels_Association"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", "ss", "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"ss", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"point", "[", "\"\<Sectors\>\"", "]"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"s", ",", 
              RowBox[{"And", "@@", 
               RowBox[{"KeyValueMap", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "#1", ",", 
                    RowBox[{"Missing", "[", "]"}]}], "]"}], "==", "#2"}], 
                  "&"}], ",", "labels"}], "]"}]}]}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "ss", "]"}], "==", "1"}], 
           ",", "\"\<Sector selector must identify exactly one resolved \
sector at each point; include every required refinement label.\>\""}], "]"}], 
         ";", "\n", " ", 
         RowBox[{"First", "[", "ss", "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"sectorDOS", "[", 
       RowBox[{"e0_List", ",", 
        RowBox[{"window_", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
        RowBox[{"bins_", ":", "30"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"e", "=", 
           RowBox[{"Sort", "[", "e0", "]"}]}], ",", "d", ",", "lo", ",", "hi",
           ",", "pad", ",", "edges", ",", "counts", ",", "heights", ",", 
          "cdf"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "e", "]"}], ">=", "1"}], " ", "&&", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{"e", ",", "realQ"}], "]"}], " ", "&&", " ", 
            RowBox[{"IntegerQ", "[", "bins", "]"}], " ", "&&", " ", 
            RowBox[{"bins", ">=", "1"}], " ", "&&", "\n", "  ", 
            RowBox[{
             RowBox[{"Length", "[", "window", "]"}], "==", "2"}], " ", "&&", 
            " ", 
            RowBox[{"0", "<=", 
             RowBox[{"window", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<", 
             RowBox[{"window", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}]}], 
           ",", "\"\<Invalid DOS settings.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"d", "=", 
          RowBox[{"Length", "[", "e", "]"}]}], ";", 
         RowBox[{"lo", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{"window", "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", 
             "1"}]}], "]"}]}], ";", 
         RowBox[{"hi", "=", 
          RowBox[{"Min", "[", 
           RowBox[{"d", ",", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"window", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"pad", "=", 
          RowBox[{
           RowBox[{"10", "^", 
            RowBox[{"-", "8"}]}], " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"First", "[", "e", "]"}], "]"}], ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"Last", "[", "e", "]"}], "]"}], ",", 
             RowBox[{
              RowBox[{"Last", "[", "e", "]"}], "-", 
              RowBox[{"First", "[", "e", "]"}]}]}], "]"}]}]}], ";", "\n", " ", 
         RowBox[{"edges", "=", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"First", "[", "e", "]"}], "-", "pad"}], ",", 
            RowBox[{
             RowBox[{"Last", "[", "e", "]"}], "+", "pad"}], ",", "bins"}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"counts", "=", 
          RowBox[{"Last", "[", 
           RowBox[{"HistogramList", "[", 
            RowBox[{"e", ",", 
             RowBox[{"{", "edges", "}"}], ",", "\"\<Count\>\""}], "]"}], 
           "]"}]}], ";", 
         RowBox[{"heights", "=", 
          RowBox[{"counts", "/", 
           RowBox[{"(", 
            RowBox[{"d", " ", 
             RowBox[{"Differences", "[", "edges", "]"}]}], ")"}]}]}], ";", 
         "\n", " ", 
         RowBox[{"cdf", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"e", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}], "/", "d"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"e", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"k", "/", "d"}]}], "}"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Energies\>\"", "->", "e"}], ",", 
           RowBox[{"\"\<Dimension\>\"", "->", "d"}], ",", 
           RowBox[{"\"\<BinEdges\>\"", "->", "edges"}], ",", 
           RowBox[{"\"\<BinCounts\>\"", "->", "counts"}], ",", 
           RowBox[{"\"\<Density\>\"", "->", "heights"}], ",", "\n", "  ", 
           RowBox[{"\"\<CDF\>\"", "->", "cdf"}], ",", 
           RowBox[{"\"\<RankWindow\>\"", "->", "window"}], ",", 
           RowBox[{"\"\<WindowRanks\>\"", "->", 
            RowBox[{"{", 
             RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
           RowBox[{"\"\<WindowEnergies\>\"", "->", 
            RowBox[{"e", "[", 
             RowBox[{"[", 
              RowBox[{"{", 
               RowBox[{"lo", ",", "hi"}], "}"}], "]"}], "]"}]}], ",", "\n", 
           "  ", 
           RowBox[{"\"\<DensityIntegral\>\"", "->", 
            RowBox[{"Total", "[", 
             RowBox[{"heights", " ", 
              RowBox[{"Differences", "[", "edges", "]"}]}], "]"}]}]}], 
          "|>"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"dosPanels", "[", 
       RowBox[{"dos_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"edges", "=", 
           RowBox[{"dos", "[", "\"\<BinEdges\>\"", "]"}]}], ",", 
          RowBox[{"rho", "=", 
           RowBox[{"dos", "[", "\"\<Density\>\"", "]"}]}], ",", "hist", ",", 
          "cdf", ",", "g1", ",", "g2"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"hist", "=", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"edges", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], ",", 
                  RowBox[{"rho", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"edges", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
                  RowBox[{"rho", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"Length", "[", "rho", "]"}]}], "}"}]}], "]"}], ",", 
            "1"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"g1", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
              RowBox[{"{", "hist", "}"}], ",", "\"\<E\>\"", 
              ",", "\"\<\\\\rho(E)\>\"", ",", 
              RowBox[{"{", "Blue", "}"}], ",", 
              RowBox[{"{", "}"}], ",", "True", ",", "False", ",", "Automatic",
               ",", 
              RowBox[{
               RowBox[{"sectorTex", "[", "labels", "]"}], 
               "<>", "\"\<;\\\\quad d_{\\\\rm sector}=\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"dos", "[", "\"\<Dimension\>\"", "]"}], "]"}]}]}], 
             "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"g2", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"dos", "[", "\"\<CDF\>\"", "]"}], "}"}], 
              ",", "\"\<E\>\"", ",", "\"\<F(E)\>\"", ",", 
              RowBox[{"{", "Blue", "}"}], ",", 
              RowBox[{"{", "}"}], ",", "True", ",", "False", ",", "Automatic",
               ",", 
              RowBox[{
               RowBox[{"sectorTex", "[", "labels", "]"}], 
               "<>", "\"\<;\\\\quad d_{\\\\rm sector}=\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"dos", "[", "\"\<Dimension\>\"", "]"}], "]"}]}]}], 
             "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"g1", "=", 
          RowBox[{"Show", "[", 
           RowBox[{"g1", ",", 
            RowBox[{"GridLines", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dos", "[", "\"\<WindowEnergies\>\"", "]"}], ",", 
               "None"}], "}"}]}], ",", 
            RowBox[{"GridLinesStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Orange", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"g2", "=", 
          RowBox[{"Show", "[", 
           RowBox[{"g2", ",", 
            RowBox[{"GridLines", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"dos", "[", "\"\<WindowEnergies\>\"", "]"}], ",", 
               RowBox[{"N", "[", 
                RowBox[{"dos", "[", "\"\<RankWindow\>\"", "]"}], "]"}]}], 
              "}"}]}], ",", 
            RowBox[{"GridLinesStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{"Orange", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<DOS\>\"", "->", 
            RowBox[{"plotPanel", "[", 
             
             RowBox[{"\"\<\\\\text{Normalized sector density of states}\>\"", 
              ",", 
              RowBox[{"regimeCaption", "[", "p", "]"}], ",", "g1"}], "]"}]}], 
           ",", "\n", "  ", 
           RowBox[{"\"\<CDF\>\"", "->", 
            RowBox[{"plotPanel", "[", 
             RowBox[{"\"\<\\\\text{Empirical cumulative density}\>\"", ",", 
              RowBox[{"regimeCaption", "[", "p", "]"}], ",", "g2"}], 
             "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"gapDiagnostic", "[", 
       RowBox[{"e_List", ",", 
        RowBox[{"window_", ":", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"1", "/", "4"}], ",", 
           RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
        RowBox[{"tol_", ":", 
         RowBox[{"10", "^", 
          RowBox[{"-", "10"}]}]}], ",", 
        RowBox[{"blockLength_", ":", "10"}], ",", 
        RowBox[{"minimumDimension_", ":", "500"}], ",", 
        RowBox[{"minimumRatios_", ":", "100"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "r", ",", "vals", ",", "resolved", ",", "blocks", ",", "sem"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", "blockLength", "]"}], " ", "&&", " ", 
            RowBox[{"blockLength", ">=", "2"}]}], 
           ",", "\"\<BlockLength must be at least two.\>\""}], "]"}], ";", 
         "\n", " ", 
         RowBox[{"r", "=", 
          RowBox[{"exGapRatios", "[", 
           RowBox[{"e", ",", "window", ",", "tol"}], "]"}]}], ";", 
         RowBox[{"vals", "=", 
          RowBox[{"r", "[", "\"\<Ratios\>\"", "]"}]}], ";", 
         RowBox[{"resolved", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"vals", ",", "NumericQ"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"r", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"r", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<ResolvedRatioCount\>\"", "->", 
               RowBox[{"Length", "[", "resolved", "]"}]}], ",", 
              RowBox[{"\"\<RatioEntryCount\>\"", "->", 
               RowBox[{"Length", "[", "vals", "]"}]}]}], "|>"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "e", "]"}], "<", "minimumDimension"}], 
            " ", "||", " ", 
            RowBox[{
             RowBox[{"Length", "[", "resolved", "]"}], "<", 
             "minimumRatios"}]}], ",", "\n", "  ", 
           RowBox[{"Return", "[", 
            RowBox[{"Join", "[", 
             RowBox[{"r", ",", 
              RowBox[{"<|", 
               RowBox[{
                
                RowBox[{"\"\<Status\>\"", 
                 "->", "\"\<InsufficientStatistics\>\""}], ",", 
                RowBox[{"\"\<MeanR\>\"", "->", 
                 RowBox[{
                 "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",",
                 "\n", "   ", 
                RowBox[{"\"\<BlockSEM\>\"", "->", 
                 RowBox[{
                 "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",", 
                RowBox[{"\"\<BlockLength\>\"", "->", "blockLength"}], ",", 
                RowBox[{"\"\<CompleteBlocks\>\"", "->", "0"}], ",", 
                RowBox[{"\"\<FractionRBelow005\>\"", "->", 
                 RowBox[{
                 "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",",
                 "\n", "   ", 
                
                RowBox[{"\"\<MinimumDimension\>\"", "->", 
                 "minimumDimension"}], ",", 
                RowBox[{"\"\<MinimumRatios\>\"", "->", "minimumRatios"}]}], 
               "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"blocks", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "==", "\"\<OK\>\""}], 
            ",", 
            RowBox[{"Mean", " ", "/@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"vals", ",", "blockLength"}], "]"}]}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"sem", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "blocks", "]"}], ">=", "2"}], ",", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", "blocks", "]"}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Length", "[", "blocks", "]"}], "]"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<TooFewBlocks\>\"", "]"}]}], "]"}]}], 
         ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"r", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<BlockLength\>\"", "->", "blockLength"}], ",", 
             RowBox[{"\"\<CompleteBlocks\>\"", "->", 
              RowBox[{"Length", "[", "blocks", "]"}]}], ",", 
             RowBox[{"\"\<BlockSEM\>\"", "->", "sem"}], ",", "\n", "  ", 
             RowBox[{"\"\<FractionRBelow005\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"r", "[", "\"\<Status\>\"", "]"}], 
                 "==", "\"\<OK\>\""}], ",", 
                RowBox[{
                 RowBox[{"Count", "[", 
                  RowBox[{"vals", ",", 
                   RowBox[{"x_", "/;", 
                    RowBox[{"x", "<", ".05"}]}]}], "]"}], "/", 
                 RowBox[{"Length", "[", "vals", "]"}]}], ",", 
                RowBox[{"Missing", "[", 
                 RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "]"}]}], 
               "]"}]}]}], "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"gapScan", "[", 
       RowBox[{
       "run_", ",", "labels_", ",", "window_", ",", "tol_", ",", 
        "blockLength_", ",", 
        RowBox[{"minimumDimension_", ":", "500"}], ",", 
        RowBox[{"minimumRatios_", ":", "100"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Table", "[", "\n", " ", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pt", "=", 
             RowBox[{
              RowBox[{"run", "[", "\"\<Points\>\"", "]"}], "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"selectedStaticSector", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"run", "[", "\"\<Points\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "labels"}], "]"}]}]}], 
           "}"}], ",", "\n", "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Parameter\>\"", "->", 
               RowBox[{
                RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Model\>\"", "->", 
               RowBox[{"pt", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], ",", 
            "\n", "   ", 
            RowBox[{"gapDiagnostic", "[", 
             RowBox[{
              RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", "window", ",",
               "tol", ",", "blockLength", ",", "minimumDimension", ",", 
              "minimumRatios"}], "]"}]}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}]}], "}"}]}], 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"gapPanel", "[", 
       RowBox[{"rows_", ",", "run_", ",", 
        RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"valid", ",", "points", ",", "g"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"valid", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"rows", ",", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], "]"}], "&"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"valid", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Return", "[", 
            RowBox[{"Column", "[", 
             RowBox[{"{", 
              RowBox[{"tex", "[", 
               
               RowBox[{"\"\<\\\\text{No eligible mean: inspect dimensions, \
sample counts and unresolved gaps.}\>\"", ",", "18"}], "]"}], "}"}], "]"}], 
            "]"}]}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "log"}], " ", "||", " ", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"valid", ",", "\"\<Parameter\>\""}], "]"}], ",", 
              RowBox[{
               RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], 
           ",", "\"\<A logarithmic horizontal axis requires positive samples.\
\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"points", "=", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"If", "[", 
                RowBox[{"log", ",", 
                 RowBox[{"Log", "[", 
                  RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"NumericQ", "[", 
                  RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}], "]"}], ",", 
                 RowBox[{"Around", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], ",", 
                   RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}]}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}]}], "]"}]}], "}"}], 
             "&"}], " ", "/@", " ", "valid"}], ")"}]}], ";", "\n", " ", 
         RowBox[{"g", "=", 
          RowBox[{"ListPlot", "[", 
           RowBox[{"points", ",", 
            RowBox[{"Joined", "->", "False"}], ",", 
            RowBox[{"PlotStyle", "->", "Blue"}], ",", 
            RowBox[{"PlotMarkers", "->", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", "3"}], "}"}]}], ",", 
            RowBox[{"IntervalMarkers", "->", "\"\<Bars\>\""}], ",", "\n", 
            "  ", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"Axes", "->", "False"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", "\n", "  ", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tex", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"run", "[", "\"\<Axis\>\"", "]"}], 
                    "==", "\"\<g\>\""}], ",", "\"\<g\>\"", 
                   ",", "\"\<\\\\Delta\>\""}], "]"}], ",", "19"}], "]"}], ",", 
               RowBox[{"tex", "[", 
                
                RowBox[{"\"\<\\\\langle\\\\widetilde r\\\\rangle\>\"", ",", 
                 "19"}], "]"}]}], "}"}]}], ",", "\n", "  ", 
            RowBox[{"FrameTicks", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ticks", ",", "None"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{"log", ",", "logTicks", ",", "ticks"}], "]"}], ",", 
                 "None"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "1100"}], ",", 
            RowBox[{"Background", "->", "White"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"\"\<\\\\text{Selected-sector adjacent-gap ratios}\>\"", ",", 
           RowBox[{"regimeCaption", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "rows", "]"}], "[", "\"\<Model\>\"", 
              "]"}], ",", 
             RowBox[{"sectorTex", "[", 
              RowBox[{
               RowBox[{"First", "[", "rows", "]"}], "[", "\"\<Labels\>\"", 
               "]"}], "]"}]}], "]"}], ",", "g"}], "]"}]}]}], "\n", "]"}]}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
