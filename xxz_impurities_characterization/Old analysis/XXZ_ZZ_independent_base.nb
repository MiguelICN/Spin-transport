Cell[CellGroupData[{

Cell[" 1.9 Export this scan ", "Subsection",ExpressionUUID->"0d0ea530-7879-df4c-bed6-d57b5728f7c5"],

Cell[BoxData[""], "Input",ExpressionUUID->"6c338989-57a4-a547-8c82-9ea411997298"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"statDeltaDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{
       "statDeltaOutputRoot", ",", "statDeltaRunLabel", ",", "statDeltaPlots",
         ",", "\n", " ", 
        RowBox[{"Join", "[", 
         RowBox[{"statDeltaRun", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Seconds\>\"", "->", "statDeltaSeconds"}], ",", 
            RowBox[{"\"\<PlotSettings\>\"", "->", "statDeltaPlotSettings"}]}],
            "|>"}]}], "]"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", "statDeltaDirectory", "]"}], ";"}], "\n", ")"}], 
   ";"}], "\n"}]], "Code",
 CellLabel->"In[48]:=",ExpressionUUID->"adce5a66-d6ce-e245-89c4-981294754828"],

Cell[BoxData["\<\"C:\\\\Users\\\\Miguel\\\\Documents\\\\GitHub\\\\Spin-\
transport\\\\xxz_impurities_characterization\\\\xxz_edge_regimes_results\\\\\
ZZ_static_Delta_run2\"\>"], "Print",
 CellChangeTimes->{4.001107058422077*^9},
 CellLabel->
  "During evaluation of \
In[48]:=",ExpressionUUID->"c037166f-7fc3-3e49-bce0-15d8adc2518b"]
}, Open  ]],

Cell["\<\
 ZZ integrability: every fixed-edge block is an open XXZ bulk with diagonal \
boundary fields g sA and g sB, hence integrable for every g and Delta. These \
gap ratios are an integrable control, not a Poisson-to-GOE crossover probe. \
Finite-size effects, additional conserved charges and degeneracies can \
prevent a Poisson-like histogram; integrability alone does not guarantee a \
particular finite-size mean. \
\>", "Text",ExpressionUUID->"a5386147-751b-8b45-8645-34c557d40f7d"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
 1.10 Optional DOS inspection before choosing a gap-ratio rank window \
\>", "Subsection",ExpressionUUID->"0ee9f85a-fe21-5b4c-8e58-9e9d1a7584fa"],

Cell["\<\
 This postprocessing section uses one completed static scan of your choice. \
It never merges distinct symmetry sectors. Inspect normalized DOS and \
empirical CDF first, then edit diagRankWindow and rerun the diagnostic cells. \
The orange lines show the actual rank-window energy boundaries; a rank \
fraction is not an energy fraction. This section does not affect either \
dynamics chapter. \
\>", "Text",ExpressionUUID->"e28b0617-9f14-114a-a139-487d16e15327"],

Cell[BoxData[""], "Input",ExpressionUUID->"6299f034-21f4-454c-86c3-f2ad7d278293"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagRun", "=", "statGRun"}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Or", " ", 
       RowBox[{"statDeltaRun", "."}]}], " ", "*)"}], "\n", " ", 
     RowBox[{"diagSector", "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<m\>\"", "->", "1"}], ",", 
        RowBox[{"\"\<sA\>\"", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"\"\<sB\>\"", "->", 
         RowBox[{"1", "/", "2"}]}], ",", 
        RowBox[{"\"\<mBulk\>\"", "->", "0"}], ",", 
        RowBox[{"\"\<R\>\"", "->", "1"}]}], "|>"}]}], ";", "\n", " ", 
     RowBox[{"diagRankWindow", "=", 
      RowBox[{"{", 
       RowBox[{"0.30", ",", "0.70"}], "}"}]}], ";", 
     RowBox[{"diagBins", "=", "30"}], ";", "\n", " ", 
     RowBox[{"diagGapResolution", "=", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ";", 
     RowBox[{"diagBlockLength", "=", "10"}], ";", "\n", " ", 
     RowBox[{"diagMinimumDimension", "=", "500"}], ";", 
     RowBox[{"diagMinimumRatios", "=", "100"}], ";", "\n", " ", 
     RowBox[{"diagLogHorizontalAxis", "=", "False"}], ";", "\n", " ", 
     RowBox[{"diagSampleIndices", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}], "/", 
           "2"}], "]"}], ",", 
         RowBox[{"Length", "[", 
          RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "}"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"diagOutputRoot", "=", 
      RowBox[{"resultRoot", "[", "]"}]}], ";", 
     RowBox[{"diagRunLabel", "=", "\"\<ZZ_spectral_diagnostics\>\""}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Code",
 CellChangeTimes->{{4.001118178163576*^9, 4.001118185586916*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"3a9302db-f370-8342-9d10-af46d83a1ebb"],

Cell[BoxData[""], "Input",ExpressionUUID->"06829d0c-0466-0a4d-9248-e234f3d114dc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagDOS", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"p", "=", 
             RowBox[{
              RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
              RowBox[{"[", "k", "]"}], "]"}]}], ",", 
            RowBox[{"s", "=", 
             RowBox[{"selectedStaticSector", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "diagSector"}], 
              "]"}]}]}], "}"}], ",", "\n", " ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<PointIndex\>\"", "->", "k"}], ",", 
            RowBox[{"\"\<Model\>\"", "->", 
             RowBox[{"p", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
            RowBox[{"\"\<DOS\>\"", "->", 
             RowBox[{"sectorDOS", "[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
               "diagRankWindow", ",", "diagBins"}], "]"}]}]}], "|>"}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "diagSampleIndices"}], "}"}]}], "]"}]}], ";", "\n",
      " ", 
     RowBox[{"diagDOSPlots", "=", 
      RowBox[{"Association", "[", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"KeyValueMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"\"\<point_\>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{"row", "[", "\"\<PointIndex\>\"", "]"}], "]"}], 
                 "<>", "\"\<_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], "&"}], 
             ",", "\n", " ", 
             RowBox[{"dosPanels", "[", 
              RowBox[{
               RowBox[{"row", "[", "\"\<DOS\>\"", "]"}], ",", 
               RowBox[{"row", "[", "\"\<Model\>\"", "]"}], ",", 
               RowBox[{"row", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"row", ",", "diagDOS"}], "}"}]}], "]"}], ",", "1"}], 
        "]"}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"First", "[", 
       RowBox[{"Values", "[", "diagDOSPlots", "]"}], "]"}], "]"}], ";"}], 
    "\n", ")"}], ";"}], "\n"}]], "Code",
 CellLabel->"In[67]:=",ExpressionUUID->"a77103d9-e8ac-e84a-9e4c-1ea16ecd9f6c"],

