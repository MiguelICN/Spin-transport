Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Von", " ", "Neumann", " ", "entropy"}], ",", " ", 
      RowBox[{"natural", " ", 
       RowBox[{"logarithms", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"entropy", "[", "r_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", 
               RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], "}"}], ",", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"e", "===", 
           RowBox[{"{", "}"}]}], ",", "0.", ",", 
          RowBox[{"-", 
           RowBox[{"Total", "[", 
            RowBox[{"e", " ", 
             RowBox[{"Log", "[", "e", " ", "]"}]}], "]"}]}]}], "]"}]}], 
       "]"}]}], ";", "\n", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"Pure", "-", 
        RowBox[{
        "state", " ", "entropy", " ", "for", " ", "sites", " ", "1"}]}], ",", 
       "...", ",", 
