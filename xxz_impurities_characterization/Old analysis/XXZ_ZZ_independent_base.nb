Cell[BoxData[
 RowBox[{
  RowBox[{"(", "\n", 
   RowBox[{
    RowBox[{"mapAverage", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", "mapComputeInfiniteTimeAverage", "]"}], ",", 
       "\n", " ", 
       RowBox[{"chAverage", "[", 
        RowBox[{"mapEngine", ",", 
         RowBox[{
         "mapSettingsUsed", "[", "\"\<AverageEnergyTolerance\>\"", "]"}]}], 
        "]"}], ",", 
       RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], ";", 
    "\n", 
    RowBox[{"If", "[", 
