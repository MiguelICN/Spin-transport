           RowBox[{"v", "[", "\"\<Transfer\>\"", "]"}]}], ",", 
          RowBox[{"sd", "=", 
           RowBox[{"v", "[", "\"\<TransferDerivative\>\"", "]"}]}], ",", "e", 
          ",", "pt", ",", "sv", ",", "gen", ",", "rates", ",", "mixed", ",", 
          "lambda", ",", "f", ",", "fd", ",", "z", ",", "entropyC"}], "}"}], ",",
         "\n", " ", 
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"v", "[", "\"\<DephasingFactors\>\"", "]"}]}], ";", 
         RowBox[{"fd", "=", 
          RowBox[{"v", "[", "\"\<DephasingDerivative\>\"", "]"}]}], ";", "\n",
          " ", 
         RowBox[{"e", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Eigenvalues", "[", 
               RowBox[{"herm", "[", "f", "]"}], "]"}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.", ",", "12"}], "]"}]}], "]"}], "]"}]}], ";", "\n", 
         " ", 
         RowBox[{"pt", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"Diagonal", "[", "f", "]"}], "]"}], "/", "4"}], ",", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"f", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}]}], "/", 
                   "4"}], ",", 
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{"f", "[", 
