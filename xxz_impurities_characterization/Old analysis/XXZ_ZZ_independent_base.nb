Cell["\<\
 The L=8 static defaults are small demonstrations: their default ZZ/exchange \
windows contain only 4/11 ratios. The gap mean is withheld below \
diagMinimumDimension=500 or diagMinimumRatios=100. DOS remains available. For \
quantitative work select a sufficiently large resolved sector and recompute \
its spectrum; inspect the actual dimension and error estimate. Reducing these \
thresholds deliberately is a demonstration, not evidence of a crossover. \
\>", "Text",ExpressionUUID->"e32a7fa2-bef3-774a-b91f-c186630362d1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
 1.11 Optional gap-ratio calculation and export after DOS inspection \
\>", "Subsection",ExpressionUUID->"a63d5e23-f35d-2849-84f2-348cba2f7dce"],

Cell[BoxData[""], "Input",ExpressionUUID->"04c91779-51f2-6745-be31-8d55fbe4edac"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"check", "[", 
      RowBox[{
       RowBox[{"AllTrue", "[", 
        RowBox[{"diagDOS", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", "\"\<DOS\>\"", "]"}], "[", "\"\<RankWindow\>\"",
             "]"}], "===", "diagRankWindow"}], "&"}]}], "]"}], ",", "\n", 
       " ", "\"\<RankWindow changed: rerun the DOS data/plot cell to refresh \
the displayed boundaries first.\>\""}], "]"}], ";", "\n", 
     RowBox[{"diagGapRows", "=", 
      RowBox[{"gapScan", "[", 
       RowBox[{
       "diagRun", ",", "diagSector", ",", "diagRankWindow", ",", 
        "diagGapResolution", ",", "diagBlockLength", ",", 
        "diagMinimumDimension", ",", "diagMinimumRatios"}], "]"}]}], ";", 
     "\n", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"KeyTake", "[", 
          RowBox[{"#", ",", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<Parameter\>\"", ",", "\"\<SectorDimension\>\"", 
             ",", "\"\<WindowRanks\>\"", ",", "\"\<Status\>\"", 
             ",", "\"\<MeanR\>\"", ",", "\"\<BlockSEM\>\""}], "}"}]}], "]"}], 
         "&"}], " ", "/@", " ", "diagGapRows"}], "]"}], "]"}], ";"}], "\n", 
    ")"}], ";"}], "\n"}]], "Code",ExpressionUUID->"a3256680-5046-2a44-ac6a-\
3f11da6f7d25"],

Cell["\<\
 No levels are removed or unfolded. Any unresolved gap pair makes that mean \
Missing. IID and contiguous-block standard errors are descriptive estimates, \
not calibrated independent-sample confidence intervals. Delta=0 has extra \
integrable charges and degeneracies; Delta=+/-1/2 is a special \
bulk-degeneracy control. A mean alone is not a chaos diagnosis. \
\>", "Text",ExpressionUUID->"ae542203-b28b-e241-aa6a-f1dc534ffe07"],

Cell[BoxData[""], "Input",ExpressionUUID->"f9a2d16a-1140-5347-9d8d-8677701037c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagGapPlot", "=", 
      RowBox[{"gapPanel", "[", 
       RowBox[{"diagGapRows", ",", "diagRun", ",", "diagLogHorizontalAxis"}], 
       "]"}]}], ";", "\n", " ", "diagGapPlot"}], "\n", ")"}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"8fdb3f03-76d0-a748-94e7-e8ac72ee7c41"],

Cell[BoxData[""], "Input",ExpressionUUID->"0b836c4d-7d9a-ae4e-80d9-00c6c98e9fd5"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"diagDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{"diagOutputRoot", ",", "diagRunLabel", ",", 
        RowBox[{"Join", "[", 
         RowBox[{"diagDOSPlots", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<MeanGapRatio\>\"", "->", "diagGapPlot"}], "|>"}]}], 
         "]"}], ",", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Axis\>\"", "->", 
           RowBox[{"diagRun", "[", "\"\<Axis\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Grid\>\"", "->", 
           RowBox[{"diagRun", "[", "\"\<Grid\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Sector\>\"", "->", "diagSector"}], ",", 
          RowBox[{"\"\<RankWindow\>\"", "->", "diagRankWindow"}], ",", "\n", 
          " ", 
          RowBox[{"\"\<DOS\>\"", "->", "diagDOS"}], ",", 
          RowBox[{"\"\<GapRows\>\"", "->", "diagGapRows"}], ",", 
          RowBox[{"\"\<GapResolution\>\"", "->", "diagGapResolution"}], ",", 
          RowBox[{"\"\<BlockLength\>\"", "->", "diagBlockLength"}], ",", 
          RowBox[{"\"\<MinimumDimension\>\"", "->", "diagMinimumDimension"}], 
          ",", 
          RowBox[{"\"\<MinimumRatios\>\"", "->", "diagMinimumRatios"}]}], 
         "|>"}]}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", "diagDirectory", "]"}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"4f5e418a-47eb-674f-a82e-a18d483e26d5"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell[" 2. Dynamics of the reduced edge density matrix ", "Title",ExpressionUUID->"279f06e9-9123-fc4a-a115-b8b1e6c93ebd"],

Cell[CellGroupData[{

Cell[" 2.1 Definitions: state preparations and observables ", "Subsection",ExpressionUUID->"48248b61-3cae-e648-9460-8c56ec47da1c"],

Cell[CellGroupData[{

Cell[" State preparation and complete state-observable records ", \
"Subsubsection",ExpressionUUID->"f228285b-c0f3-734d-bc88-42a907ad62a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "Edge", " ", "observables", " ", "from", " ", "the", " ", "4", " ", "x",
        " ", "environment"}], "-", 
      RowBox[{"rank", " ", "coefficient", " ", 
       RowBox[{"matrix", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"observables", "[", 
       RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", 
          "z", ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{"a", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
         RowBox[{"a1", "=", 
          RowBox[{"traceB", "[", "r", "]"}]}], ";", 
         RowBox[{"b1", "=", 
          RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
          RowBox[{"entropy", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "z"}], "}"}], "=", 
          RowBox[{"PauliMatrix", " ", "/@", " ", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
         RowBox[{"ma", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
         RowBox[{"mb", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
         RowBox[{"e", "=", 
          RowBox[{"Reverse", "[", 
           RowBox[{"Sort", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
           RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
           RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
           RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
           RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
           RowBox[{"\"\<Purity\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
           RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
           RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
           RowBox[{"\"\<MutualInfo\>\"", "->", 
            RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
           RowBox[{"\"\<Concurrence\>\"", "->", 
            RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
           RowBox[{"\"\<Negativity\>\"", "->", 
            RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<InitialOverlap\>\"", "->", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
           RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
           RowBox[{"\"\<ConnectedZZ\>\"", "->", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
              "]"}], "-", 
             RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
           RowBox[{"\"\<ConnectedXX\>\"", "->", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
              "]"}], "-", 
             RowBox[{
              RowBox[{"Re", "[", 
               RowBox[{"Tr", "[", 
                RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
              RowBox[{"Re", "[", 
               RowBox[{"Tr", "[", 
                RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
           "\n", "  ", 
           RowBox[{"\"\<TraceError\>\"", "->", 
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
           RowBox[{"\"\<HermiticityError\>\"", "->", 
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"r", "-", 
               RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<MinEigenvalue\>\"", "->", 
            RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
     ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
