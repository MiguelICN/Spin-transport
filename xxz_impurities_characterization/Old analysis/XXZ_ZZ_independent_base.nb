Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"texturizingRecord", "[", 
       RowBox[{"t_", ",", "s_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "=", 
           RowBox[{"transferToChoi", "[", "s", "]"}]}], ",", "out", ",", "r", 
          ",", "e", ",", "v", ",", "order", ",", "sig", ",", "p", ",", "ce", ",",
           "mixed"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"out", "=", 
          RowBox[{"applyTransfer", "[", 
           RowBox[{"s", ",", "edgeF1"}], "]"}]}], ";", 
         RowBox[{"r", "=", 
          RowBox[{"responseOperator", "[", "s", "]"}]}], ";", "\n", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"e", ",", "v"}], "}"}], "=", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"herm", "[", "r", "]"}], "]"}]}], ";", 
         RowBox[{"order", "=", 
          RowBox[{"Ordering", "[", 
           RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", 
         RowBox[{"e", "=", 
          RowBox[{"Re", "[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"v", "=", 
          RowBox[{"v", "[", 
           RowBox[{"[", "order", "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"sig", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"grandSum", "[", "out", "]"}], ",", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", "16"}], "]"}], " ", ".", " ", "s", " ", ".",
                " ", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{"1", ",", "16"}], "]"}]}], "]"}], "/", "4"}], ",", 
            RowBox[{
             RowBox[{"grandSum", "[", "c", "]"}], "/", "4"}]}], "}"}]}], ";", 
         "\n", " ", 
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"sig", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}], ";", 
         RowBox[{"ce", "=", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", "c", "]"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"mixed", "=", 
          RowBox[{"applyTransfer", "[", 
           RowBox[{"s", ",", 
            RowBox[{
             RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], "]"}]}],
          ";", "\n", " ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
             RowBox[{"\"\<Transfer\>\"", "->", "s"}], ",", 
             RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
             RowBox[{"\"\<ChoiState\>\"", "->", 
              RowBox[{"c", "/", "4"}]}], ",", 
             RowBox[{"\"\<OutputF1\>\"", "->", "out"}], ",", "\n", " ", 
             RowBox[{"\"\<SigmaRoutes\>\"", "->", "sig"}], ",", 
             RowBox[{"\"\<SigmaOutput\>\"", "->", 
              RowBox[{"First", "[", "sig", "]"}]}], ",", 
             RowBox[{"\"\<OmegaTF\>\"", "->", 
              RowBox[{"1", "-", "p"}]}], ",", "\n", " ", 
             RowBox[{"\"\<OmegaRoute1\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"sig", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}]}], ",", 
             RowBox[{"\"\<OmegaRoute2\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"sig", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "/", "4"}]}]}], ",", 
             RowBox[{"\"\<OmegaRoute3\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"sig", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], "/", "4"}]}]}], ",", "\n", 
             " ", 
             RowBox[{"\"\<OmegaR\>\"", "->", 
              RowBox[{"rugosity", "[", "out", "]"}]}], ",", 
             RowBox[{"\"\<ResponseOperator\>\"", "->", "r"}], ",", 
             RowBox[{"\"\<ResponseEigenvalues\>\"", "->", "e"}], ",", 
             RowBox[{"\"\<ResponseEigenvectors\>\"", "->", "v"}], ",", "\n", 
             " ", 
             RowBox[{"\"\<ResponseMinimum\>\"", "->", 
              RowBox[{"First", "[", "e", "]"}]}], ",", 
             RowBox[{"\"\<ResponseMaximum\>\"", "->", 
              RowBox[{"Last", "[", "e", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<MinimumVectorF1Overlap\>\"", "->", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
                 RowBox[{"First", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",",
              "\n", " ", 
             RowBox[{"\"\<MaximumVectorF1Overlap\>\"", "->", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{
                 RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
                 RowBox[{"Last", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",", 
             "\n", " ", 
             RowBox[{"\"\<ResponseTraceMinus4\>\"", "->", 
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"Tr", "[", "r", "]"}], "-", "4"}], "]"}]}], ",", 
             RowBox[{"\"\<ResponseHermiticityError\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"r", "-", 
                RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], "]"}]}], ",",
              "\n", " ", 
             RowBox[{"\"\<ResponseF1Error\>\"", "->", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Tr", "[", 
                 RowBox[{"r", " ", ".", " ", "edgeF1"}], "]"}], "-", 
                RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", 
             RowBox[{"\"\<RouteError\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"sig", "-", 
                RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<FreeMaxDistance\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"out", "-", "edgeF1"}], "]"}]}], ",", 
             RowBox[{"\"\<FreeTraceDistance\>\"", "->", 
              RowBox[{"traceNormHermitian", "[", 
               RowBox[{"out", "-", "edgeF1"}], "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<PreservingMaxDistance\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"r", "-", 
                RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", 
             RowBox[{"\"\<PreservingTraceDistance\>\"", "->", 
              RowBox[{"traceNormHermitian", "[", 
               RowBox[{"r", "-", 
                RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<ChoiEigenvalues\>\"", "->", "ce"}], ",", 
             RowBox[{"\"\<MinChoiEigenvalue\>\"", "->", 
              RowBox[{"First", "[", "ce", "]"}]}], ",", 
             RowBox[{"\"\<TPError\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{
                RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
                RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
             "\n", " ", 
             RowBox[{"\"\<KrausRank\>\"", "->", 
              RowBox[{"Count", "[", 
               RowBox[{"ce", ",", 
                RowBox[{"x_", "/;", 
                 RowBox[{"x", ">", 
                  RowBox[{
                   RowBox[{"cfg", "[", "\"\<KrausTolerance\>\"", "]"}], " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Last", "[", "ce", "]"}]}], "]"}]}]}]}]}], 
               "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<MapEntropy\>\"", "->", 
              RowBox[{"entropy", "[", 
               RowBox[{"c", "/", "4"}], "]"}]}], ",", 
             RowBox[{"\"\<UnitalityError\>\"", "->", 
              RowBox[{"maxAbs", "[", 
               RowBox[{"mixed", "-", 
                RowBox[{
                 RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], 
               "]"}]}], ",", 
             RowBox[{"\"\<MixedInputEntropy\>\"", "->", 
              RowBox[{"entropy", "[", "mixed", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<U1CovarianceError\>\"", "->", 
              RowBox[{"u1CovarianceViolation", "[", "s", "]"}]}], ",", 
             RowBox[{"\"\<ReflectionCovarianceError\>\"", "->", 
              RowBox[{"covarianceViolation", "[", 
               RowBox[{"s", ",", 
                RowBox[{"swapEdge", "[", "]"}]}], "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<FlipCovarianceError\>\"", "->", 
              RowBox[{"covarianceViolation", "[", 
               RowBox[{"s", ",", 
                RowBox[{"flipEdge", "[", "]"}]}], "]"}]}], ",", 
             RowBox[{"\"\<RFCovarianceError\>\"", "->", 
              RowBox[{"covarianceViolation", "[", 
               RowBox[{"s", ",", 
                RowBox[{
                 RowBox[{"swapEdge", "[", "]"}], " ", ".", " ", 
                 RowBox[{"flipEdge", "[", "]"}]}]}], "]"}]}]}], "|>"}], ",", 
           "\n", " ", 
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"gamma", "=", 
               RowBox[{"ArrayReshape", "[", 
                RowBox[{
                 RowBox[{"Diagonal", "[", "s", "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "}"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Gamma\>\"", "->", "gamma"}], ",", "\n", " ", 
               RowBox[{"\"\<ZZResponseGammaError\>\"", "->", 
                RowBox[{"maxAbs", "[", 
                 RowBox[{"r", "-", 
                  RowBox[{"Transpose", "[", "gamma", "]"}]}], "]"}]}], ",", 
               RowBox[{"\"\<ZZOutputGammaError\>\"", "->", 
                RowBox[{"maxAbs", "[", 
                 RowBox[{"out", "-", 
                  RowBox[{"gamma", "/", "4"}]}], "]"}]}], ",", "\n", " ", 
               RowBox[{"\"\<ZZOmegaGammaError\>\"", "->", 
                RowBox[{"Abs", "[", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"1", "-", "p"}], ")"}], "-", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"3", "/", "4"}], "-", 
                    RowBox[{
                    RowBox[{"Total", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{"gamma", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"i", ",", "4"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", 
                    RowBox[{"i", "+", "1"}], ",", "4"}], "}"}]}], "]"}], 
                    "]"}], "]"}], "/", "8"}]}], ")"}]}], "]"}]}]}], "|>"}]}], 
            "]"}]}], "]"}]}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstMapChunk", "[", 
       RowBox[{"times_", ",", "eng_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "=", 
          RowBox[{"evolveBatch", "[", 
