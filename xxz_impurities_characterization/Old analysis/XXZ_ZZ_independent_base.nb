             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "times", "]"}], "/", "2"}], "]"}], ",", 
               RowBox[{"Length", "[", "times", "]"}]}], "}"}], "]"}], 
            ",", "\"\<All\>\"", ",", 
            RowBox[{"Range", "[", 
             RowBox[{"Length", "[", "times", "]"}], "]"}], ",", "_", ",", 
            RowBox[{"check", "[", 
