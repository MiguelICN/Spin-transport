              RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Audit\>\"", "->", 
            RowBox[{"setup", "[", "\"\<Audit\>\"", "]"}]}], ",", 
           RowBox[{"\"\<ParameterNote\>\"", "->", 
            RowBox[{"setup", "[", "\"\<ParameterNote\>\"", "]"}]}]}], 
          "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
