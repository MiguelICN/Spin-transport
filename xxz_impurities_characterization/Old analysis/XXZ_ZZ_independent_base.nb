Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Reuse", " ", "splitCharge"}], ",", " ", 
      RowBox[{
       RowBox[{"including", " ", "its", " ", "spin"}], "-", 
       RowBox[{"Casimir", " ", "label", " ", 
        RowBox[{"conversion", "."}]}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"edgeSplit", "[", 
       RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=",
       " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"alias", ",", "label", ",", "out"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"alias", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{"name", ",", 
            RowBox[{"\"\<BulkS2\>\"", "|", "\"\<EdgeS2\>\""}], 
            ",", "\"\<S2\>\"", ",", "\"\<StaggeredBulkS2\>\"", 
            ",", "\"\<StaggeredS2\>\"", ",", "_", ",", "name"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"label", "=", 
          RowBox[{"Switch", "[", 
           RowBox[{
           "name", ",", "\"\<BulkS2\>\"", ",", "\"\<SBulk\>\"", 
            ",", "\"\<EdgeS2\>\"", ",", "\"\<SEdge\>\"", ",", "\n", 
            "  ", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredSBulk\>\"", ",",
             "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"out", "=", 
          RowBox[{"splitCharge", "[", 
           RowBox[{"s", ",", "q", ",", "alias", ",", "tol"}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"alias", "=!=", "name"}], ",", 
           RowBox[{"out", "=", 
            RowBox[{"Map", "[", 
             RowBox[{
              RowBox[{"Function", "[", 
               RowBox[{"t", ",", 
                RowBox[{"Join", "[", 
                 RowBox[{"t", ",", 
                  RowBox[{"<|", 
                   RowBox[{"\"\<Labels\>\"", "->", 
                    RowBox[{"Append", "[", "\n", "   ", 
                    RowBox[{
                    RowBox[{"KeyDrop", "[", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "}"}]}], "]"}], ",", 
                    "\n", "   ", 
                    RowBox[{"label", "->", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "]"}]}]}], "]"}]}], 
                   "|>"}]}], "]"}]}], "]"}], ",", "out"}], "]"}]}]}], "]"}], ";",
          "\n", " ", "out"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{"(*", " ", 
      RowBox[{
      "A", " ", "charge", " ", "is", " ", "split", " ", "only", " ", "when", " ",
        "it", " ", "preserves", " ", "the", " ", "CURRENT", " ", 
       RowBox[{"subspace", "."}]}], " ", "*)"}], "\n", 
     RowBox[{
      RowBox[{"edgeRefine", "[", 
       RowBox[{"spaces_", ",", "q_", ",", "tol_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"out", "=", "spaces"}], ",", "next", ",", "b", ",", "a"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"next", "=", 
             RowBox[{"{", "}"}]}], ";", "\n", "  ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"b", "=", 
                RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
               RowBox[{"a", "=", 
                RowBox[{"herm", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                  " ", 
                  RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], 
                 "]"}]}], ";", "\n", "   ", 
               RowBox[{"next", "=", 
                RowBox[{"Join", "[", 
                 RowBox[{"next", ",", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "<", 
                    RowBox[{"tol", " ", 
                    RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], ",", "\n", "     ", 
                    RowBox[{"edgeSplit", "[", 
                    RowBox[{"s", ",", 
                    RowBox[{"q", "[", "name", "]"}], ",", "name", ",", 
                    "tol"}], "]"}], ",", 
                    RowBox[{"{", "s", "}"}]}], "]"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "out"}], "}"}]}], "]"}], ";", 
            RowBox[{"out", "=", "next"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"name", ",", 
             RowBox[{"Keys", "[", "q", "]"}]}], "}"}]}], "]"}], ";", 
         "out"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[20]:=",ExpressionUUID->"9eb4d6dd-b9d0-114c-b04e-0e1c73cece0e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"In", " ", "each", " ", "ZZ", " ", "block"}], ",", " ", 
      RowBox[{
      "reuse", " ", "charges", " ", "for", " ", "its", " ", "ACTUAL", " ", 
       "effective", " ", "boundary", " ", 
       RowBox[{"fields", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"zzBulkCharges", "[", 
       RowBox[{"g_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"pb", ",", "q", ",", "names", ",", "alias"}], "}"}], ",", 
        "\n", " ", 
        RowBox[{
         RowBox[{"pb", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"p", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<L\>\"", "->", 
               RowBox[{
                RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
              RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", "   ", 
              RowBox[{"\"\<bLeft\>\"", "->", 
               RowBox[{"g", " ", 
                RowBox[{"labels", "[", "\"\<sA\>\"", "]"}]}]}], ",", 
              RowBox[{"\"\<bRight\>\"", "->", 
               RowBox[{"g", " ", 
                RowBox[{"labels", "[", "\"\<sB\>\"", "]"}]}]}]}], "|>"}]}], 
           "]"}]}], ";", "\n", " ", 
         RowBox[{"q", "=", 
          RowBox[{"charges", "[", "pb", "]"}]}], ";", "\n", " ", 
         RowBox[{"(*", " ", 
          RowBox[{
           RowBox[{
           "These", " ", "bulk", " ", "parities", " ", "already", " ", "have",
             " ", "the", " ", "full"}], "-", 
           RowBox[{"chain", " ", "parent", " ", 
            RowBox[{"label", "."}]}]}], " ", "*)"}], "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"labels", ",", "\"\<R\>\""}], "]"}], ",", 
           RowBox[{"q", "=", 
            RowBox[{"KeyDrop", "[", 
             RowBox[{"q", ",", 
              RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
         " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"KeyExistsQ", "[", 
            RowBox[{"labels", ",", "\"\<RF\>\""}], "]"}], ",", 
           RowBox[{"q", "=", 
            RowBox[{"KeyDrop", "[", 
             RowBox[{"q", ",", 
              RowBox[{"{", "\"\<RF\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n",
          " ", 
         RowBox[{"names", "=", 
          RowBox[{"SortBy", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "q", "]"}], ",", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"MemberQ", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                  "#"}], "]"}], ",", "0", ",", "1"}], "]"}], "&"}]}], "]"}]}],
          ";", "\n", " ", 
         RowBox[{"Association", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"alias", "=", 
              RowBox[{"Switch", "[", 
               RowBox[{
               "name", ",", "\"\<R\>\"", ",", "\"\<RBulk\>\"", 
                ",", "\"\<F\>\"", ",", "\"\<FBulk\>\"", ",", "\"\<RF\>\"", 
                ",", "\"\<RFBulk\>\"", ",", "\n", "    ", "\"\<S2\>\"", 
                ",", "\"\<BulkS2\>\"", ",", "\"\<StaggeredS2\>\"", 
                ",", "\"\<StaggeredBulkS2\>\""}], "]"}]}], ";", "\n", "  ", 
             RowBox[{"alias", "->", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"id", "[", "2", "]"}], ",", 
