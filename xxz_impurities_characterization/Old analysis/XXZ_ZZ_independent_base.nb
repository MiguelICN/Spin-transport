        RowBox[{"{", 
         RowBox[{
          RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ",
         "limits", " ", 
        RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
      RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
       RowBox[{"computed", "."}]}]}], " ", "*)"}], "\n", 
    RowBox[{"statGOutputRoot", "=", 
     RowBox[{"resultRoot", "[", "]"}]}], ";", "\n", 
    RowBox[{"statGRunLabel", "=", "\"\<ZZ_static_g\>\""}], ";"}], "\n", ")"}],
   ";"}]], "Code",
 CellChangeTimes->{{4.001106791183449*^9, 4.00110680140934*^9}, {
