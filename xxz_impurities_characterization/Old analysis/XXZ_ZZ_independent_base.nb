Cell[CellGroupData[{

Cell[" 3.8 Export this independent map run ", "Subsection",ExpressionUUID->"6e4fa5f7-9e42-8f46-898c-89bb536b0967"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[135]:=",ExpressionUUID->"9d3a4b89-f0f7-014c-923c-914e63447b3b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{"mapDirectory", "=", 
      RowBox[{"exportBundle", "[", 
       RowBox[{
       "mapOutputRoot", ",", "mapRunLabel", ",", "mapPlotsUsed", ",", "\n", 
        " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
          RowBox[{"\"\<BulkSpecification\>\"", "->", "mapBulkUsed"}], ",", 
          RowBox[{"\"\<BulkFactor\>\"", "->", "mapBulkFactor"}], ",", "\n", 
          " ", 
          RowBox[{"\"\<Settings\>\"", "->", "mapSettingsUsed"}], ",", 
          RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
          RowBox[{"\"\<Times\>\"", "->", "mapTimes"}], ",", "\n", " ", 
          RowBox[{"\"\<Probes\>\"", "->", "mapProbesUsed"}], ",", 
          RowBox[{"\"\<Summary\>\"", "->", "mapSummary"}], ",", 
          RowBox[{"\"\<Performance\>\"", "->", 
           RowBox[{"KeyDrop", "[", 
            RowBox[{"mapChannelRun", ",", 
             RowBox[{"{", "\"\<Records\>\"", "}"}]}], "]"}]}], ",", 
          RowBox[{"\"\<TimeReversalCheck\>\"", "->", "mapTimeReversal"}], ",", 
          RowBox[{"\"\<Engine\>\"", "->", "mapEngine"}], ",", 
          RowBox[{"\"\<Records\>\"", "->", "mapRecords"}], ",", 
          RowBox[{"\"\<InfiniteTimeAverage\>\"", "->", "mapAverage"}], ",", 
          "\n", " ", 
          RowBox[{"\"\<SetupSeconds\>\"", "->", "mapSetupSeconds"}], ",", 
          RowBox[{"\"\<EvolutionSeconds\>\"", "->", "mapSeconds"}]}], 
         "|>"}]}], "]"}]}], ";", "\n", 
     RowBox[{"Print", "[", "mapDirectory", "]"}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Code",
 CellLabel->
  "In[136]:=",ExpressionUUID->"0258d303-63df-9e41-a0f1-c3cb4ae81c63"],

