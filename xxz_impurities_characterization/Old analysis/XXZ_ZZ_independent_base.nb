  "In[169]:=",ExpressionUUID->"662cd747-6f04-ac4c-8ffe-44e40d2f29dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"(", "\n", 
    RowBox[{
     RowBox[{
      RowBox[{"qstStateChecks", "[", 
       RowBox[{
       "eng_", ",", "fac_", ",", "bf_", ",", "records_", ",", "tol_"}], "]"}],
       " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "zero", ",", "r0", ",", "checks", ",", "endpoint", ",", "full"}], 
         "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"zero", "=", 
          RowBox[{"First", "[", 
           RowBox[{"textureRecords", "[", 
            RowBox[{"stateTrajectory", "[", 
             RowBox[{"eng", ",", "fac", ",", 
              RowBox[{"{", "0.", "}"}], ",", "tol"}], "]"}], "]"}], "]"}]}], ";", 
         RowBox[{"r0", "=", 
          RowBox[{"zero", "[", "\"\<RhoAB\>\"", "]"}]}], ";", "\n", " ", 
         RowBox[{"endpoint", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}], "-", 
               RowBox[{"reducedState", "[", 
                RowBox[{
                 RowBox[{"evolve", "[", 
                  RowBox[{
                   RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], ",", "eng"}], 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"1", ",", 
                   RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
                 RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"rec", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"First", "[", "records", "]"}], ",", 
                 RowBox[{"Last", "[", "records", "]"}]}], "}"}]}], "}"}]}], 
            "]"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"full", "=", 
          RowBox[{"qstSmallReference", "[", 
           RowBox[{
            RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], ",", "bf", ",", 
            "records", ",", "\"\<State\>\""}], "]"}]}], ";", "\n", " ", 
         RowBox[{"checks", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<InitialF1Error\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"r0", "-", "edgeF1"}], "]"}]}], ",", 
            RowBox[{"\"\<InitialTextureError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"zero", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
                RowBox[{"zero", "[", "\"\<TextureFAB\>\"", "]"}], ",", 
                RowBox[{"zero", "[", "\"\<RugosityAB\>\"", "]"}]}], "}"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<PauliIdentityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}], "-", 
                    RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}], "-", 
                    RowBox[{"#", "[", "\"\<CorrelationXX\>\"", "]"}]}], ",", 
                    "\n", "  ", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "1", "-", 
                    RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "/", "4"}], "-", 
                    RowBox[{"#", "[", "\"\<F1Probability\>\"", "]"}]}]}], 
                   "}"}], "]"}], "&"}], ",", "records"}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<BoundsViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"Max", "[", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"Map", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "2"}], ",", 
                    RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "2"}]}], 
                    "}"}], "&"}], ",", "records"}], "]"}], "]"}], "]"}]}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<TraceError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}],
             ",", 
            RowBox[{"\"\<HermiticityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<PositivityViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], 
                 "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<BatchEndpointError\>\"", "->", "endpoint"}], ",", 
            "\n", " ", 
            RowBox[{"\"\<FullChainReferenceError\>\"", "->", "full"}], ",", 
            RowBox[{"\"\<ZZPopulationError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"Diagonal", "[", 
                    RowBox[{"#", "[", "\"\<RhoAB\>\"", "]"}], "]"}], "-", 
                   RowBox[{"Diagonal", "[", "r0", "]"}]}], "]"}], "&"}], ",", 
                "records"}], "]"}], "]"}]}], ",", " ", 
            RowBox[{"\"\<ZZEdgeConservationError\>\"", "->", 
             RowBox[{"qstEdgeConservationError", "[", 
              RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], "]"}]}], ",", 
            " ", 
            RowBox[{"\"\<SectorReconstructionError\>\"", "->", 
             RowBox[{"eng", "[", "\"\<ReconstructionError\>\"", "]"}]}]}], 
           "|>"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Values", "[", "checks", "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"MissingQ", "[", "#", "]"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"realQ", "[", "#", "]"}], " ", "&&", " ", 
                 RowBox[{"#", "<", "tol"}]}], ")"}]}], "&"}]}], "]"}], 
           ",", "\"\<QST state validation failed.\>\""}], "]"}], ";", 
         "checks"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstMapChecks", "[", 
       RowBox[{"eng_", ",", "bf_", ",", "records_", ",", "settings_"}], "]"}],
       " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"tol", "=", 
           RowBox[{"settings", "[", "\"\<ValidationTolerance\>\"", "]"}]}], ",",
           "zero", ",", "checks"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"zero", "=", 
          RowBox[{"texturizingRecord", "[", 
           RowBox[{"0.", ",", 
            RowBox[{
             RowBox[{"mapAt", "[", 
              RowBox[{"0.", ",", "eng"}], "]"}], "[", "\"\<Transfer\>\"", 
             "]"}], ",", "settings"}], "]"}]}], ";", "\n", " ", 
         RowBox[{"checks", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<InitialTransferError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
               RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}]}], ",", 
            "\n", " ", 
            RowBox[{"\"\<InitialOmegaError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"zero", "[", "\"\<OmegaTF\>\"", "]"}], ",", 
                RowBox[{"zero", "[", "\"\<OmegaR\>\"", "]"}]}], "}"}], 
              "]"}]}], ",", 
            RowBox[{"\"\<InitialResponseError\>\"", "->", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"zero", "[", "\"\<ResponseOperator\>\"", "]"}], "-", 
               RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ThreeRouteError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<RouteError\>\""}], "]"}], "]"}]}],
             ",", 
            RowBox[{"\"\<ResponseHermiticityError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ResponseHermiticityError\>\""}], 
               "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ResponsePositivityViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<ResponseMinimum\>\""}], "]"}], 
                 "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<ResponseF1Error\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ResponseF1Error\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<CPViolation\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"0.", ",", 
               RowBox[{"-", 
                RowBox[{"Min", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{"records", ",", "\"\<MinChoiEigenvalue\>\""}], 
                  "]"}], "]"}]}]}], "]"}]}], ",", 
            RowBox[{"\"\<TPError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<TPError\>\""}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<BatchEndpointError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"maxAbs", "[", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<Transfer\>\"", "]"}], "-", 
                  RowBox[{
                   RowBox[{"mapAt", "[", 
                    RowBox[{
                    RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], ",", "eng"}], 
                    "]"}], "[", "\"\<Transfer\>\"", "]"}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"rec", ",", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"First", "[", "records", "]"}], ",", 
                    RowBox[{"Last", "[", "records", "]"}]}], "}"}]}], "}"}]}],
                "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<FullChainReferenceError\>\"", "->", 
             RowBox[{"qstSmallReference", "[", 
              RowBox[{
               RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], ",", "bf", ",",
                "records", ",", "\"\<Map\>\""}], "]"}]}], ",", 
            RowBox[{"\"\<ZZTransferOffDiagonal\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<Transfer\>\"", "]"}], "-", 
                   RowBox[{"DiagonalMatrix", "[", 
                    RowBox[{"Diagonal", "[", 
                    RowBox[{"#", "[", "\"\<Transfer\>\"", "]"}], "]"}], 
                    "]"}]}], "]"}], "&"}], ",", "records"}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<ZZGammaDiagonalError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"Diagonal", "[", 
                    RowBox[{"#", "[", "\"\<Gamma\>\"", "]"}], "]"}], "-", 
                   "1"}], "]"}], "&"}], ",", "records"}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"\"\<ZZResponseGammaError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ZZResponseGammaError\>\""}], 
               "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ZZOutputGammaError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ZZOutputGammaError\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<ZZOmegaGammaError\>\"", "->", 
             RowBox[{"Max", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"records", ",", "\"\<ZZOmegaGammaError\>\""}], "]"}], 
              "]"}]}], ",", "\n", " ", 
            RowBox[{"\"\<SectorReconstructionError\>\"", "->", 
             RowBox[{"eng", "[", "\"\<ReconstructionError\>\"", "]"}]}]}], 
           "|>"}]}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{
             RowBox[{"Values", "[", "checks", "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"MissingQ", "[", "#", "]"}], " ", "||", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"realQ", "[", "#", "]"}], " ", "&&", " ", 
                 RowBox[{"#", "<", "tol"}]}], ")"}]}], "&"}]}], "]"}], 
           ",", "\"\<QST channel validation failed.\>\""}], "]"}], ";", 
         "checks"}]}], "\n", "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstRandomResponseCheck", "[", 
       RowBox[{"records_", ",", "count_", ",", "seed_", ",", "tol_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"states", ",", "selected", ",", "err"}], "}"}], ",", "\n", 
        " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"IntegerQ", "[", "count", "]"}], " ", "&&", " ", 
            RowBox[{"count", ">", "0"}], " ", "&&", " ", 
            RowBox[{"IntegerQ", "[", "seed", "]"}]}], 
           ",", "\"\<Random test count must be positive; seed must be an \
integer.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"states", "=", 
          RowBox[{"BlockRandom", "[", 
           RowBox[{
            RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"With", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"a", "=", 
                  RowBox[{
                   RowBox[{"RandomReal", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "+", 
                   RowBox[{"I", " ", 
                    RowBox[{"RandomReal", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]}], "}"}], ",",
                 "\n", "  ", 
                RowBox[{"With", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"r", "=", 
                    RowBox[{"a", " ", ".", " ", 
                    RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], "}"}], 
                  ",", 
                  RowBox[{"r", "/", 
                   RowBox[{"Tr", "[", "r", "]"}]}]}], "]"}]}], "]"}], ",", 
              RowBox[{"{", "count", "}"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
         RowBox[{"selected", "=", 
          RowBox[{"records", "[", 
           RowBox[{"[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "records", "]"}], "/", "2"}], "]"}], ",", 
               RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], "]"}],
            "]"}]}], ";", "\n", " ", 
         RowBox[{"err", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Tr", "[", 
                 RowBox[{
                  RowBox[{"rec", "[", "\"\<ResponseOperator\>\"", "]"}], " ", 
                  ".", " ", "r"}], "]"}], "-", 
                RowBox[{"grandSum", "[", 
                 RowBox[{"applyTransfer", "[", 
                  RowBox[{
                   RowBox[{"rec", "[", "\"\<Transfer\>\"", "]"}], ",", "r"}], 
                  "]"}], "]"}]}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"rec", ",", "selected"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"r", ",", "states"}], "}"}]}], "]"}], "]"}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"err", "<", "tol"}], 
           ",", "\"\<Random-input response-operator validation failed.\>\""}],
           "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Count\>\"", "->", "count"}], ",", 
           RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
           RowBox[{"\"\<Times\>\"", "->", 
            RowBox[{"Lookup", "[", 
             RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}]}], ",", 
           RowBox[{"\"\<MaxError\>\"", "->", "err"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstCompare", "[", 
       RowBox[{"a_", ",", "b_", ",", "ar_", ",", "br_", ",", "tol_"}], "]"}], 
      " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"err", ",", "matrixError"}], "}"}], ",", "\n", " ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"SameQ", "[", 
            RowBox[{
             RowBox[{"KeyTake", "[", 
              RowBox[{"a", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
                 ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
                 ",", "\"\<Settings\>\""}], "}"}]}], "]"}], ",", "\n", "  ", 
             RowBox[{"KeyTake", "[", 
              RowBox[{"b", ",", 
               RowBox[{"{", 
                
                RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
                 ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
                 ",", "\"\<Settings\>\""}], "}"}]}], "]"}]}], "]"}], ",", 
           "\n", "  ", "\"\<A/B comparison refused: computed model, bulk, \
grid or numerical settings differ.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "ar", "]"}], "==", 
             RowBox[{"Length", "[", "br", "]"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Length", "[", "ar", "]"}], "==", 
             RowBox[{"Length", "[", 
              RowBox[{"a", "[", "\"\<Times\>\"", "]"}], "]"}]}], " ", "&&", 
            "\n", "  ", 
            RowBox[{"SameQ", "[", 
             RowBox[{
              RowBox[{"Lookup", "[", 
               RowBox[{"ar", ",", "\"\<Time\>\""}], "]"}], ",", 
              RowBox[{"Lookup", "[", 
               RowBox[{"br", ",", "\"\<Time\>\""}], "]"}], ",", 
              RowBox[{"a", "[", "\"\<Times\>\"", "]"}]}], "]"}]}], 
           ",", "\"\<A/B comparison refused: record times do not match the \
used snapshots.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"err", "=", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"ar", ",", "\"\<SigmaAB\>\""}], "]"}], "-", 
            RowBox[{"Lookup", "[", 
             RowBox[{"br", ",", "\"\<SigmaOutput\>\""}], "]"}]}], "]"}]}], ";",
          "\n", " ", 
         RowBox[{"matrixError", "=", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"ar", ",", "\"\<RhoAB\>\""}], "]"}], "-", 
            RowBox[{"Lookup", "[", 
             RowBox[{"br", ",", "\"\<OutputF1\>\""}], "]"}]}], "]"}]}], ";", 
         "\n", " ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"err", ",", "matrixError"}], "]"}], "<", "tol"}], 
           ",", "\"\<Independent A/B edge matrices or grand sums \
disagree.\>\""}], "]"}], ";", "\n", " ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<MaxSigmaError\>\"", "->", "err"}], ",", 
           RowBox[{"\"\<MaxMatrixError\>\"", "->", "matrixError"}], ",", 
           RowBox[{"\"\<Tolerance\>\"", "->", "tol"}], ",", 
           RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
       "]"}]}], ";", "\n", 
     RowBox[{
      RowBox[{"qstEdgeConservationError", "[", "p_", "]"}], " ", ":=", " ", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"h", "=", 
           RowBox[{"N", "[", 
            RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}]}], ",", "z"}],
          "}"}], ",", "\n", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"z", "=", 
             RowBox[{"siteOp", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "j", 
               ",", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{"h", " ", ".", " ", "z"}], "-", 
              RowBox[{"z", " ", ".", " ", "h"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "}"}]}], "}"}]}], 
          "]"}], "]"}]}], "\n", "]"}]}], ";"}], "\n", ")"}], ";"}], 
  "\n"}]], "Input",
 InitializationCell->True,
 CellLabel->
  "In[170]:=",ExpressionUUID->"4bcb0153-91a5-3b4f-9857-995b5925bbfa"]
