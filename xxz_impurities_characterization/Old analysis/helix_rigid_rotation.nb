Cell[CellGroupData[{

Cell["2. Helix states and their free parameters", "Section",ExpressionUUID->"7b494a29-59a0-1e44-92ac-c9ed11f1124b"],

Cell["\<\
Definition (product state, no entanglement):
|psi(q, theta, phi)> = Tensor_{j=1}^{n} [ cos(theta/2) |up> + exp(i (phi + \
(j-1) q)) sin(theta/2) |down> ].
Free parameters:
n: number of sites.
q: azimuthal winding per bond (pitch 2 Pi / q sites).
theta: common polar angle; <S^z_j> = cos(theta)/2 and |<S^perp_j>| = \
sin(theta)/2 for every j.
phi: azimuth of site 1; site j points along phi_j = phi + (j-1) q.
Sign convention: with |up> = |0> and the phase exp(i alpha) on the |down> \
component, the local Bloch vector is (sin theta cos alpha, sin theta sin \
alpha, cos theta), i.e. the azimuth increases with j for q > 0. The test \
\"Spin profile and Bloch-vector sign\" checks this numerically.\
\>", "Text",ExpressionUUID->"c08719d7-35a9-4541-bca0-292b57066d6a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HelixSpinor", "[", 
     RowBox[{"theta_", ",", " ", "alpha_"}], "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"theta", "/", "2"}], "]"}], ",", " ", 
      RowBox[{
       RowBox[{"Exp", "[", 
        RowBox[{"I", " ", "alpha"}], "]"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HelixState", "[", 
     RowBox[{
     "n_Integer", ",", " ", "q_", ",", " ", "theta_", ",", " ", "phi_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Flatten", "[", 
     RowBox[{"KroneckerProduct", " ", "@@", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"HelixSpinor", "[", 
         RowBox[{"theta", ",", " ", 
          RowBox[{"phi", " ", "+", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"j", " ", "-", " ", "1"}], ")"}], " ", "q"}]}]}], "]"}], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BlochUnitVector", "[", 
     RowBox[{"theta_", ",", " ", "alpha_"}], "]"}], " ", ":=", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "theta", "]"}], " ", 
       RowBox[{"Cos", "[", "alpha", "]"}]}], ",", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "theta", "]"}], " ", 
       RowBox[{"Sin", "[", "alpha", "]"}]}], ",", " ", 
      RowBox[{"Cos", "[", "theta", "]"}]}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HelixAzimuths", "[", 
     RowBox[{"n_Integer", ",", " ", "q_", ",", " ", "phi_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"phi", " ", "+", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"j", " ", "-", " ", "1"}], ")"}], " ", "q"}]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HelixSpinProfile", "[", 
     RowBox[{
     "n_Integer", ",", " ", "q_", ",", " ", "theta_", ",", " ", "phi_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"BlochUnitVector", "[", 
        RowBox[{"theta", ",", " ", 
         RowBox[{"phi", " ", "+", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"j", " ", "-", " ", "1"}], ")"}], " ", "q"}]}]}], "]"}], "/",
        "2"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"HelixSectorWeights", "[", 
     RowBox[{"n_Integer", ",", " ", "theta_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"n", "/", "2"}], " ", "-", " ", "k"}], ",", " ", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"n", ",", " ", "k"}], "]"}], " ", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"theta", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"n", " ", "-", " ", "k"}], ")"}]}], ")"}]}], " ", 
         RowBox[{
          RowBox[{"Sin", "[", 
           RowBox[{"theta", "/", "2"}], "]"}], "^", 
          RowBox[{"(", 
           RowBox[{"2", " ", "k"}], ")"}]}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"HelixFreeParameters", "[", 
    RowBox[{
    "n_Integer", ",", " ", "q_", ",", " ", "theta_", ",", " ", "phi_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Sites\>\"", " ", "->", " ", "n"}], ",", " ", 
     RowBox[{"\"\<Winding q\>\"", " ", "->", " ", "q"}], ",", " ", 
     RowBox[{"\"\<Pitch 2Pi/q\>\"", " ", "->", " ", 
      RowBox[{"2", " ", 
       RowBox[{"Pi", "/", "q"}]}]}], ",", " ", 
     RowBox[{"\"\<Polar angle theta\>\"", " ", "->", " ", "theta"}], ",", " ", 
     RowBox[{"\"\<Initial azimuth phi\>\"", " ", "->", " ", "phi"}], ",", " ", 
     RowBox[{"\"\<<S^z_j>\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"Cos", "[", "theta", "]"}], "/", "2"}]}], ",", " ", 
     RowBox[{"\"\<|<S^perp_j>|\>\"", " ", "->", " ", 
      RowBox[{
       RowBox[{"Sin", "[", "theta", "]"}], "/", "2"}]}], ",", " ", 
     RowBox[{"\"\<<S^z_tot>\>\"", " ", "->", " ", 
      RowBox[{"n", " ", 
       RowBox[{
        RowBox[{"Cos", "[", "theta", "]"}], "/", "2"}]}]}], ",", " ", 
     RowBox[{"\"\<Var S^z_tot\>\"", " ", "->", " ", 
      RowBox[{"n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "theta", "]"}], "^", "2"}], "/", "4"}]}]}]}], 
    "|>"}]}], ";"}]}], "Code",
 CellLabel->"In[11]:=",ExpressionUUID->"08813c22-2c9f-664e-aeab-9bdd262df237"],

Cell["\<\
HelixSectorWeights lists the weight of the helix in each S^z_tot = m sector. \
A rotation exp(-i alpha S^z_tot) multiplies the sector-m component by exp(-i \
alpha m), so a rigid rotation at angular velocity w is the statement that the \
sector components acquire only the relative phases exp(-i w m t). Var S^z_tot \
= n sin^2(theta)/4 controls how fast any mismatch between those phases \
destroys the overlap.\
\>", "Text",ExpressionUUID->"c4b6f111-f867-954c-a6ed-a36a7edce7fa"],

Cell[CellGroupData[{

Cell["Tests of the helix definitions", "Subsection",ExpressionUUID->"f1e3a28c-b74f-034b-a9b9-a80ad041801b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"n", " ", "=", " ", "5"}], ",", " ", 
     RowBox[{"q", " ", "=", " ", "0.7"}], ",", " ", 
     RowBox[{"theta", " ", "=", " ", "0.9"}], ",", " ", 
     RowBox[{"phi", " ", "=", " ", "0.3"}], ",", " ", 
     RowBox[{"alpha", " ", "=", " ", "1.234"}], ",", " ", "psi"}], "}"}], ",",
    "\n", "  ", 
   RowBox[{
    RowBox[{"psi", " ", "=", " ", 
     RowBox[{"N", "[", 
      RowBox[{"HelixState", "[", 
       RowBox[{"n", ",", " ", "q", ",", " ", "theta", ",", " ", "phi"}], 
       "]"}], "]"}]}], ";", "\n", "  ", 
    RowBox[{"TestReport", "[", 
     RowBox[{"{", "\n", "    ", 
      RowBox[{
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"Norm", "[", "psi", "]"}], ",", " ", "1.", ",", " ", 
         RowBox[{"SameTest", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], " ", "<", " ", 
             RowBox[{"10", "^", 
              RowBox[{"-", "12"}]}]}], " ", "&"}], ")"}]}], ",", " ", 
         RowBox[{"TestID", " ", "->", " ", "\"\<Normalization\>\""}]}], "]"}],
        ",", "\n", "    ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"LocalSpinExpectations", "[", 
          RowBox[{"psi", ",", " ", "n"}], "]"}], ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{"HelixSpinProfile", "[", 
           RowBox[{"n", ",", " ", "q", ",", " ", "theta", ",", " ", "phi"}], 
           "]"}], "]"}], ",", " ", 
         RowBox[{"SameTest", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], "]"}], " ", "<", 
             " ", 
             RowBox[{"10", "^", 
              RowBox[{"-", "12"}]}]}], " ", "&"}], ")"}]}], ",", " ", 
         RowBox[{
         "TestID", " ", "->", 
          " ", "\"\<Spin profile and Bloch-vector sign\>\""}]}], "]"}], ",", 
       "\n", "    ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"ZRotationOperator", "[", 
            RowBox[{"alpha", ",", " ", "n"}], "]"}], "]"}], " ", ".", " ", 
          "psi"}], ",", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", "n", " ", 
            RowBox[{"alpha", "/", "2"}]}], "]"}], " ", 
          RowBox[{"N", "[", 
           RowBox[{"HelixState", "[", 
            RowBox[{"n", ",", " ", "q", ",", " ", "theta", ",", " ", 
             RowBox[{"phi", " ", "+", " ", "alpha"}]}], "]"}], "]"}]}], ",", 
         " ", 
         RowBox[{"SameTest", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"#1", " ", "-", " ", "#2"}], "]"}], "]"}], " ", "<", 
             " ", 
             RowBox[{"10", "^", 
              RowBox[{"-", "12"}]}]}], " ", "&"}], ")"}]}], ",", " ", 
         RowBox[{"TestID", " ", "->", " ", "\"\<Rotation shifts phi\>\""}]}], 
        "]"}], ",", "\n", "    ", 
       RowBox[{"VerificationTest", "[", 
        RowBox[{
         RowBox[{"Normal", "[", 
          RowBox[{"Values", "[", 
           RowBox[{"GroupBy", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Normal", "[", 
                 RowBox[{"Diagonal", "[", 
                  RowBox[{"TotalSzOperator", "[", "n", "]"}], "]"}], "]"}], ",",
                 " ", 
                RowBox[{
                 RowBox[{"Abs", "[", "psi", "]"}], "^", "2"}]}], "}"}], "]"}],
              ",", " ", 
             RowBox[{"First", " ", "->", " ", "Last"}], ",", " ", "Total"}], 
            "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"HelixSectorWeights", "[", 
             RowBox[{"n", ",", " ", "theta"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], "]"}], ",", " ", 
         RowBox[{"SameTest", " ", "->", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Max", "[", 
