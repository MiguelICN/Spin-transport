       RowBox[{"p", "[", "\"\<FieldOmega\>\"", "]"}], " ", 
       RowBox[{"t", "/", "2"}]}], "]"}], " ", 
     RowBox[{"HelixState", "[", 
      RowBox[{
       RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", " ", 
