         RowBox[{"p", "[", "\"\<bR\>\"", "]"}]}], "]"}], " ", "t"}], "]"}], " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
