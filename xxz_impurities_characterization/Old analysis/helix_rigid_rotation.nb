        RowBox[{"p", "[", "\"\<phi0\>\"", "]"}], " ", "+", " ", 
        RowBox[{
         RowBox[{"p", "[", "\"\<FieldOmega\>\"", "]"}], " ", "t"}]}]}], 
      "]"}]}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"RigidityDiagnostics", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"psi", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"HelixState", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", " ", 
           RowBox[{"p", "[", "\"\<q\>\"", "]"}], ",", " ", 
           RowBox[{"p", "[", "\"\<theta\>\"", "]"}], ",", " ", 
           RowBox[{"p", "[", "\"\<phi0\>\"", "]"}]}], "]"}], "]"}]}], ",", 
       " ", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"N", "[", 
         RowBox[{"RotatingFrameGenerator", "[", "p", "]"}], "]"}]}], ",", " ",
        "e"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"e", " ", "=", " ", 
       RowBox[{"Re", "[", 
        RowBox[{
