Cell[CellGroupData[{

Cell["4. Dynamics and plots", "Section",ExpressionUUID->"4c814762-3f5e-d74c-8f7b-da3427852edb"],

Cell[CellGroupData[{

Cell["4.1 Laboratory-frame integrator and diagnostics", "Subsection",ExpressionUUID->"950d1113-6334-5845-9967-061bd1c97c62"],

Cell["\<\
The laboratory-frame evolution solves i d psi/dt = H(t) psi with NDSolve, \
without using the rotating frame. Since the rotated fields are R_z(w t) h(0), \
the edge operator splits exactly as C0 + cos(w t) C1 + sin(w t) C2, where C0 \
contains the z components (which do not rotate), C1 the x, y components at t \
= 0, and C2 the same components rotated by Pi/2.\
\>", "Text",ExpressionUUID->"04c66c49-786b-6d43-8be8-95dbf1be89e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"EdgeFieldDecomposition", "[", "p_Association", "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"f", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"ProtocolFields", "[", 
           RowBox[{"p", ",", " ", "0"}], "]"}], "]"}]}], ",", " ", 
        RowBox[{"n", " ", "=", " ", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "3"}], "]"}], "]"}]}], "}"}], ",", " ", 
           "1", ",", " ", "n"}], "]"}], " ", "+", " ", 
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", " ", "0", ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "3"}], "]"}], "]"}]}], "}"}], ",", " ", 
           "n", ",", " ", "n"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "2"}], "]"}], "]"}], ",", " ", "0"}], 
            "}"}], ",", " ", "1", ",", " ", "n"}], "]"}], " ", "+", " ", 
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "2"}], "]"}], "]"}], ",", " ", "0"}], 
            "}"}], ",", " ", "n", ",", " ", "n"}], "]"}]}], ",", " ", 
        RowBox[{
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "0"}], 
            "}"}], ",", " ", "1", ",", " ", "n"}], "]"}], " ", "+", " ", 
         RowBox[{"EdgeFieldOperator", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", 
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"2", ",", " ", "2"}], "]"}], "]"}]}], ",", " ", 
             RowBox[{"f", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", " ", "1"}], "]"}], "]"}], ",", " ", "0"}], 
            "}"}], ",", " ", "n", ",", " ", "n"}], "]"}]}]}], "}"}]}], 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"LabFrameEvolution", "[", 
    RowBox[{"p_Association", ",", " ", "psi0_List", ",", " ", "tMax_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", 
       RowBox[{"w", " ", "=", " ", 
        RowBox[{"p", "[", "\"\<FieldOmega\>\"", "]"}]}], ",", " ", "c", ",", 
       " ", "h0", ",", " ", "c1", ",", " ", "c2", ",", " ", "x", ",", " ", 
       "t"}], "}"}], ",", " ", 
     RowBox[{
      RowBox[{"c", " ", "=", " ", 
       RowBox[{"Normal", "[", 
        RowBox[{"N", "[", 
         RowBox[{"EdgeFieldDecomposition", "[", "p", "]"}], "]"}], "]"}]}], ";",
       " ", 
      RowBox[{"h0", " ", "=", " ", 
       RowBox[{
        RowBox[{"Normal", "[", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"XXZBulkHamiltonian", "[", 
            RowBox[{
             RowBox[{"p", "[", "\"\<J\>\"", "]"}], ",", " ", 
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", " ", "n"}], "]"}],
            " ", "+", " ", 
           RowBox[{
            RowBox[{"p", "[", "\"\<hz\>\"", "]"}], " ", 
            RowBox[{"TotalSzOperator", "[", "n", "]"}]}]}], "]"}], "]"}], " ",
         "+", " ", 
        RowBox[{"c", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", " ", 
      RowBox[{"c1", " ", "=", " ", 
       RowBox[{"c", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", " ", 
      RowBox[{"c2", " ", "=", " ", 
       RowBox[{"c", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], ";", " ", 
      RowBox[{"NDSolveValue", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}], " ", "==", " ", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"h0", " ", "+", " ", 
               RowBox[{
                RowBox[{"Cos", "[", 
                 RowBox[{"w", " ", "t"}], "]"}], " ", "c1"}], " ", "+", " ", 
               RowBox[{
                RowBox[{"Sin", "[", 
                 RowBox[{"w", " ", "t"}], "]"}], " ", "c2"}]}], ")"}], " ", ".",
              " ", 
             RowBox[{"x", "[", "t", "]"}]}]}]}], ",", " ", 
          RowBox[{
           RowBox[{"x", "[", "0", "]"}], " ", "==", " ", 
           RowBox[{"N", "[", "psi0", "]"}]}]}], "}"}], ",", " ", "x", ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "0", ",", " ", "tMax"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<ExplicitRungeKutta\>\"", ",", " ", 
           RowBox[{"\"\<DifferenceOrder\>\"", " ", "->", " ", "8"}]}], 
          "}"}]}], ",", " ", 
        RowBox[{"AccuracyGoal", " ", "->", " ", "13"}], ",", " ", 
        RowBox[{"PrecisionGoal", " ", "->", " ", "13"}], ",", " ", 
        RowBox[{"MaxSteps", " ", "->", " ", "Infinity"}], ",", " ", 
        RowBox[{"InterpolationOrder", " ", "->", " ", "All"}]}], "]"}]}]}], 
    "]"}]}], ";"}]}], "Code",
 CellLabel->"In[33]:=",ExpressionUUID->"64546882-05af-974f-bdc6-f1ee71607ccc"],

Cell["\<\
Diagnostics along the trajectory:
RigidFidelity: F(t) = |<psi(q, theta, phi0 + hz t)|psi(t)>|^2, the overlap \
with the helix rotated at the Larmor frequency hz.
BestFidelity: the maximum over all rotation angles a of |<U(a) \
psi0|psi(t)>|^2, computed from the S^z_tot sector decomposition; it is 1 iff \
psi(t) is some rotated copy of the initial helix, at whatever rate.
IntegratorError: max_t || psi_lab(t) - psi_exact(t) ||, comparing NDSolve \
with the rotating-frame solution of Section 3 (ExactTrajectory evaluates that \
solution on a uniform time grid with a single matrix exponential).
Local observables: <S_j(t)>, unwrapped azimuths, transverse length and S^z \
per site, and the Bloch-vector length 2|<S_j>| (equal to 1 iff spin j is \
unentangled from the rest).\
\>", "Text",ExpressionUUID->"a1d82bc1-1dcc-e148-9faa-3178a4e2faae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"UnwrapPhases", "[", "list_List", "]"}], " ", ":=", " ", 
    RowBox[{"FoldList", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", " ", "+", " ", 
        RowBox[{"Mod", "[", 
         RowBox[{
          RowBox[{"#2", " ", "-", " ", "#1"}], ",", " ", 
          RowBox[{"2", " ", "Pi"}], ",", " ", 
          RowBox[{"-", "Pi"}]}], "]"}]}], " ", "&"}], ",", " ", 
      RowBox[{"First", "[", "list", "]"}], ",", " ", 
      RowBox[{"Rest", "[", "list", "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BestRotationFidelity", "[", 
     RowBox[{"p_Association", ",", " ", "psi_List"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"psi0", " ", "=", " ", 
         RowBox[{"N", "[", 
          RowBox[{"HelixState", "[", 
           RowBox[{
            RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", " ", 
