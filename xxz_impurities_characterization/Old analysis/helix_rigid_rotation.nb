           RowBox[{"Diagonal", "[", 
            RowBox[{"TotalSzOperator", "[", 
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], "]"}], "]"}], 
          "]"}]}], ",", " ", "u", ",", " ", "chi"}], "}"}], ",", " ", 
      RowBox[{
       RowBox[{"u", " ", "=", " ", 
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          RowBox[{"(", 
           RowBox[{"tMax", "/", "nT"}], ")"}], " ", 
          RowBox[{"Normal", "[", 
           RowBox[{"N", "[", 
            RowBox[{"RotatingFrameGenerator", "[", "p", "]"}], "]"}], "]"}]}],
          "]"}]}], ";", " ", 
       RowBox[{"chi", " ", "=", " ", 
        RowBox[{"NestList", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"u", " ", ".", " ", "#"}], " ", "&"}], ",", " ", 
          RowBox[{"N", "[", "psi0", "]"}], ",", " ", "nT"}], "]"}]}], ";", 
       " ", 
       RowBox[{"MapThread", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"p", "[", "\"\<FieldOmega\>\"", "]"}], " ", "#1", " ", 
             "m"}], "]"}], " ", "#2"}], " ", "&"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Subdivide", "[", 
            RowBox[{"0.", ",", " ", "tMax", ",", " ", "nT"}], "]"}], ",", " ",
            "chi"}], "}"}]}], "]"}]}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"RigidHelixPrediction", "[", 
     RowBox[{"p_Association", ",", " ", "t_"}], "]"}], " ", ":=", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", "I"}], " ", 
       RowBox[{"StaticHelixEnergy", "[", 
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], ",", " ", 
         RowBox[{"p", "[", "\"\<q\>\"", "]"}], ",", " ", 
