Cell["\<\
In A both edge Bloch vectors stay on the sphere and trace the latitude circle \
z = cos(theta), the edge spin being a pure rotating state. In B and D they \
move into the interior of the sphere.\
\>", "Text",ExpressionUUID->"e3fb069d-793f-8445-bba2-19b1327b6050"]
}, Open  ]],

Cell[CellGroupData[{

Cell["4.4 Sensitivity of rigidity to the matching conditions", "Subsection",ExpressionUUID->"035af8c7-01b3-2344-8264-423df5d62342"],

Cell["\<\
Maximum over two periods of 1 - BestFidelity, as a function of the detuning \
hz - w (at Delta = cos q) and of the anisotropy mismatch Delta - cos q (at hz \
= w). Both conditions are sharp: the infidelity is at machine precision only \
at zero mismatch, and over two periods it already reaches about 0.11 at |hz - \
w| = 0.02 and about 0.03 at |Delta - cos q| = 0.02. The scan uses the exact \
rotating-frame solution, which is valid for any parameters because H(t) = U(w \
t) H(0) U(w t)^dagger holds for every Delta and hz.\
\>", "Text",ExpressionUUID->"3efa1786-99ca-9c44-b805-a0e42f3e80c1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"scanDetuning", " ", "=", " ", 
   RowBox[{"InfidelityScan", "[", 
    RowBox[{
     RowBox[{"protocols", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<hz\>\"", ",", " ", 
     RowBox[{"omegaDrive", " ", "+", " ", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2", ",", " ", "20"}], "]"}]}], ",",
      " ", "tFinal", ",", " ", "120"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scanAnisotropy", " ", "=", " ", 
   RowBox[{"InfidelityScan", "[", 
    RowBox[{
     RowBox[{"protocols", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", "\"\<Delta\>\"", ",", " ", 
     RowBox[{
      RowBox[{"Cos", "[", "qWinding", "]"}], " ", "+", " ", 
      RowBox[{"Subdivide", "[", 
       RowBox[{
        RowBox[{"-", "0.2"}], ",", " ", "0.2", ",", " ", "20"}], "]"}]}], ",",
      " ", "tFinal", ",", " ", "120"}], "]"}]}], ";"}], "\n", 
 RowBox[{"GraphicsRow", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"scanDetuning", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"scanDetuning", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "16"}]}], ",", " ", "1"}], "}"}]}], "]"}]}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<hz - \[CapitalOmega]\>\"", ",", 
          " ", "\"\<max_t (1 - F_best)\>\""}], "}"}]}]}], "]"}], ",", " ", 
     RowBox[{"ListLogPlot", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"scanAnisotropy", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"scanAnisotropy", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "16"}]}], ",", " ", "1"}], "}"}]}], "]"}]}], 
         "}"}], "]"}], ",", " ", 
       RowBox[{"Joined", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"PlotMarkers", " ", "->", " ", "Automatic"}], ",", " ", 
       RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<\[CapitalDelta] - cos q\>\"", ",", 
          " ", "\"\<max_t (1 - F_best)\>\""}], "}"}]}]}], "]"}]}], "}"}], ",",
    " ", 
   RowBox[{"ImageSize", " ", "->", " ", "800"}]}], "]"}]}], "Code",
 CellLabel->"In[70]:=",ExpressionUUID->"5b6ccf39-0b75-0c4e-97d6-3a9223662737"],

