         RowBox[{"(", 
          RowBox[{"g", " ", ".", " ", "psi"}], ")"}]}], "]"}]}], ";", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Delta - Cos[q]\>\"", " ", "->", " ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", "-", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"p", "[", "\"\<q\>\"", "]"}], "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<hz - FieldOmega\>\"", " ", "->", " ", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<hz\>\"", "]"}], " ", "-", " ", 
           RowBox[{"p", "[", "\"\<FieldOmega\>\"", "]"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<RotatingFrameResidual\>\"", " ", "->", " ", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"g", " ", ".", " ", "psi"}], " ", "-", " ", 
           RowBox[{"e", " ", "psi"}]}], "]"}]}], ",", " ", 
        RowBox[{"\"\<RotatingFrameEnergy\>\"", " ", "->", " ", "e"}]}], 
       "|>"}]}]}], "]"}]}], ";"}]}], "Code",
 CellLabel->"In[23]:=",ExpressionUUID->"80d37b64-bdfe-5a44-980a-92be2b91c725"],

Cell["\<\
RotatingFrameResidual = || G psi0 - <G> psi0 || vanishes iff the helix \
co-rotates rigidly with the fields. It is the single number that decides the \
question for a given protocol; Section 4 confirms it by brute-force \
integration in the laboratory frame, where nothing about the rotating frame \
is assumed.\
\>", "Text",ExpressionUUID->"fced3bae-6d56-d24e-9d05-c9fc9de6b8cf"]
}, Open  ]],

