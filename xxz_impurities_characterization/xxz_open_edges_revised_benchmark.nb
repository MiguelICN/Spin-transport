            "]"}]}], ";", "\n", "  ", 
          RowBox[{"hm", "=", 
           RowBox[{"N", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{"h", "[", 
              RowBox[{"[", 
               RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Basis\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Basis\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], 
            "}"}]}], ";", "\n", "  ", 
          RowBox[{"q", "=", 
           RowBox[{"zzBulkCharges", "[", 
            RowBox[{"g", ",", "p", ",", 
