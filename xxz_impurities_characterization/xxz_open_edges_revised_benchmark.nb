     RowBox[{"<", 
      RowBox[{"psi", 
       RowBox[{"(", "0", ")"}]}]}], "|", 
     RowBox[{
      RowBox[{"psi", 
       RowBox[{"(", "t", ")"}]}], ">"}], "|", 
     RowBox[{
      RowBox[{
       RowBox[{"^", "2."}], " ", "Mixed", " ", "inputs", " ", "use", " ", 
       "the", " ", "normalized", "\n", "full"}], "-", 
      RowBox[{"state", " ", "overlap", " ", 
       RowBox[{
        RowBox[{"Tr", "[", 
         RowBox[{"rho", 
          RowBox[{"(", "0", ")"}], "rho", 
          RowBox[{"(", "t", ")"}]}], "]"}], "/", 
