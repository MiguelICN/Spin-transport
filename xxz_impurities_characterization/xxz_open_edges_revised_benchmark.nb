Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Full", " ", "open"}], "-", 
    RowBox[{"chain", " ", "XXZ", " ", 
     RowBox[{"Hamiltonian", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"xxzH", "[", "p_Association", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"p", "[", "\"\<Delta\>\"", "]"}]}], ",", "h", ",", "x", ",", 
        "y", ",", "z"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"IntegerQ", "[", "l", "]"}], " ", "&&", " ", 
          RowBox[{"l", ">=", "3"}]}], 
         ",", "\"\<L must be an integer >=3.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"p", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<h\>\"", 
               ",", "\"\<bLeft\>\"", ",", "\"\<bRight\>\""}], "}"}]}], "]"}], 
           ",", "realQ"}], "]"}], ",", "\n", 
         "  ", "\"\<J, Delta and fields must be finite real numbers.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", " ", 
       RowBox[{"h", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"{", "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "^", "l"}], ",", 
            RowBox[{"2", "^", "l"}]}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"h", "+=", 
          RowBox[{
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}], "+", 
             RowBox[{"d", " ", 
              RowBox[{"bondOp", "[", 
               RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}]}]}], 
            ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"l", "-", "1"}]}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"h", "+=", 
          RowBox[{
           RowBox[{"p", "[", "\"\<h\>\"", "]"}], " ", 
           RowBox[{"siteOp", "[", 
            RowBox[{"z", ",", "k", ",", "l"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "l"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{"h", "+", 
         RowBox[{
          RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}], " ", 
          RowBox[{"siteOp", "[", 
           RowBox[{"z", ",", "1", ",", "l"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"p", "[", "\"\<bRight\>\"", "]"}], " ", 
          RowBox[{"siteOp", "[", 
           RowBox[{"z", ",", "l", ",", "l"}], " ", "]"}]}]}], "]"}]}]}], "\n",
      "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"3f6b100f-3b9c-8f4d-94d1-36eb58930eaf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Reject", " ", "Hamiltonians", " ", "that", " ", "the", " ", "real"}], ",",
     " ", 
    RowBox[{"magnetization", "-", 
     RowBox[{"block", " ", "solver", " ", "cannot", " ", 
      RowBox[{"represent", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"u1Check", "[", 
      RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "nd", ",", "off", ",",
          "scale", ",", "leak"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Dimensions", "[", "a", "]"}], "==", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"2", "^", "l"}], ",", 
             RowBox[{"2", "^", "l"}]}], "}"}]}], 
          ",", "\"\<Hamiltonian dimensions do not match L.\>\""}], "]"}], ";",
         "\n", " ", 
        RowBox[{"nd", "=", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"IntegerDigits", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{
               RowBox[{"2", "^", "l"}], "-", "1"}]}], "]"}], ",", "2", ",", 
            "l"}], "]"}]}]}], ";", "\n", " ", 
        RowBox[{"off", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Most", "[", 
            RowBox[{"ArrayRules", "[", "a", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"nd", "[", 
              RowBox[{"[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "!=", 
             RowBox[{"nd", "[", 
              RowBox[{"[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], 
            "&"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"scale", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"Norm", "[", 
            RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
        RowBox[{"leak", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"off", "===", 
            RowBox[{"{", "}"}]}], ",", "0.", ",", 
           RowBox[{"Max", "[", 
            RowBox[{"Abs", "[", 
             RowBox[{"Last", " ", "/@", " ", "off"}], "]"}], "]"}]}], "]"}]}],
         ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"leak", "<=", 
           RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
          "  ", "\"\<H mixes total-Sz sectors. This solver would drop matrix \
elements. Use a solver for the surviving symmetries or full ED.\>\""}], "]"}],
         ";", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<MaxOffBlockElement\>\"", "->", "leak"}], ",", 
          RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
          RowBox[{"\"\<RelativeLeakage\>\"", "->", 
           RowBox[{"leak", "/", "scale"}]}], ",", 
          RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"realSectorCheck", "[", 
      RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "u", ",", "scale"}], 
        "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"u", "=", 
         RowBox[{"u1Check", "[", 
          RowBox[{"a", ",", "l", ",", "tol"}], "]"}]}], ";", 
        RowBox[{"scale", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"Norm", "[", 
            RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{"a", "-", 
             RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], "]"}], "<=", 
           RowBox[{"tol", " ", "scale"}]}], 
          ",", "\"\<H must be Hermitian before block diagonalization.\>\""}], 
         "]"}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{"Im", "[", "a", "]"}], "]"}], "<=", 
           RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
          "  ", "\"\<The legacy fixSign solver requires a real Hamiltonian. \
Complex Hermitian models need phase-preserving eigenvectors.\>\""}], "]"}], ";",
         "\n", " ", "u"}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"2dd261f3-4968-5b43-88d6-108d6c924e37"]
}, Closed]],

Cell[CellGroupData[{

Cell["Reduced density matrix", "Subsection",ExpressionUUID->"6710b28a-f3e6-7a47-ad00-2fc73dafd7a6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Coefficient", " ", "matrix", " ", "for", " ", "a", " ", "chosen", " ", 
     "set", " ", "of", " ", "sites"}], ";", " ", 
    RowBox[{"rho", "=", 
     RowBox[{"A", ".", "A\[Dagger]", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"partitionFactor", "[", 
      RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"r", "=", 
          RowBox[{
           RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], ",", "rest"}], "}"}], ",", "\n", 
       " ", 
       RowBox[{
        RowBox[{"rest", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "l", "]"}], ",", "sites"}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"ArrayReshape", "[", 
             RowBox[{"fac", ",", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"ConstantArray", "[", 
                 RowBox[{"2", ",", "l"}], "]"}], ",", 
                RowBox[{"{", "r", "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
            RowBox[{"Ordering", "[", 
             RowBox[{"Join", "[", 
              RowBox[{"sites", ",", "rest", ",", 
               RowBox[{"{", 
                RowBox[{"l", "+", "1"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"Length", "[", "sites", "]"}]}], ",", 
            RowBox[{
             RowBox[{"2", "^", 
              RowBox[{"Length", "[", "rest", "]"}]}], " ", "r"}]}], "}"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reducedState", "[", 
      RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "=", 
         RowBox[{"partitionFactor", "[", 
          RowBox[{"fac", ",", "sites", ",", "l"}], "]"}]}], "}"}], ",", "\n", 
       " ", 
       RowBox[{"a", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}]}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"reducedKet", "[", 
      RowBox[{"v_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"reducedState", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", "v", "}"}], "]"}], ",", "sites", ",", "l"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeRho", "[", 
      RowBox[{"v_", ",", "l_Integer"}], "]"}], " ", ":=", " ", 
     RowBox[{"reducedKet", "[", 
      RowBox[{"v", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[13]:=",ExpressionUUID->"3ba67228-c675-3448-b05b-31012f853ad5"],

