Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"12.4", "c"}], " ", "\[LongDash]", " ", 
    RowBox[{
    "Export", " ", "plots", " ", "and", " ", "raw", " ", "DOS", " ", 
     "data"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"exDOSDir", " ", "=", " ", 
     RowBox[{"newFolder", "[", "\n", "   ", 
      RowBox[{"exDOSOutputRoot", ",", "\n", "   ", 
       RowBox[{
       "exDOSRunLabel", " ", "<>", "\n", "    ", "\"\<_L\>\"", " ", "<>", " ", 
        RowBox[{"ToString", "[", 
         RowBox[{"exDOSModelUsed", "[", "\"\<L\>\"", "]"}], "]"}], " ", "<>", 
        "\n", "    ", "\"\<_Delta\>\"", " ", "<>", " ", 
        RowBox[{"safeToken", "[", 
         RowBox[{"exDOSModelUsed", "[", "\"\<Delta\>\"", "]"}], "]"}]}]}], 
      "\n", "   ", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"Do", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"savePNG", "[", "\n", "   ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"exDOSDir", ",", "\n", "     ", 
            RowBox[{"\"\<dos_g_\>\"", " ", "<>", " ", 
             RowBox[{"safeToken", "[", 
              RowBox[{
               RowBox[{"exDOSData", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<g\>\"", "]"}], 
              "]"}], " ", "<>", " ", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
         "\n", "   ", 
         RowBox[{"exDOSPlots", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "\n", "   ", "]"}], ";", "\n", 
       "\n", "  ", 
       RowBox[{"savePNG", "[", "\n", "   ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"exDOSDir", ",", "\n", "     ", 
            RowBox[{"\"\<cdf_g_\>\"", " ", "<>", " ", 
             RowBox[{"safeToken", "[", 
              RowBox[{
               RowBox[{"exDOSData", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<g\>\"", "]"}], 
              "]"}], " ", "<>", " ", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
         "\n", "   ", 
         RowBox[{"exDOSCDFPlots", "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "\n", "   ", "]"}]}], ",", "\n", 
      "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", " ", 
        RowBox[{"Length", "[", "exDOSData", "]"}]}], "}"}]}], "\n", "  ", 
     "]"}], ";"}], "\n", "\n", 
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{
      RowBox[{"StringQ", "[", 
       RowBox[{"Export", "[", "\n", "    ", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"exDOSDir", ",", " ", "\"\<sector_dos.wxf\>\""}], "}"}], 
          "]"}], ",", "\n", "    ", 
         RowBox[{"<|", "\n", "     ", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", " ", "->", " ", "exDOSModelUsed"}], ",", 
           "\n", "     ", 
           
           RowBox[{"\"\<SelectedSector\>\"", " ", "->", " ", 
            "exDOSSectorUsed"}], ",", "\n", "     ", 
           RowBox[{"\"\<Settings\>\"", " ", "->", " ", "exDOSSettingsUsed"}], 
           ",", "\n", "     ", 
           RowBox[{"\"\<Results\>\"", " ", "->", " ", "exDOSData"}]}], "\n", 
          "     ", "|>"}], ",", "\n", "    ", "\"\<WXF\>\""}], "\n", "    ", 
        "]"}], "]"}], ",", "\n", "  ", "\"\<DOS data export failed.\>\""}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<DOS plots and data saved to: \>\"", ",", " ", "exDOSDir"}], 
