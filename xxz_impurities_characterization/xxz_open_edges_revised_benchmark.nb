      RowBox[{
       RowBox[{"Or", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<m\>\"", "->", "0"}], ",", 
          RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
          RowBox[{"\"\<F\>\"", "->", "1"}]}], "|>"}]}], ",", " ", 
       RowBox[{"or", " ", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<m\>\"", "->", "1"}], ",", 
           RowBox[{"\"\<R\>\"", "->", 
            RowBox[{"-", "1"}]}]}], "|>"}], "."}]}]}], " ", "*)"}], "\n", " ", 
     RowBox[{"\"\<LValues\>\"", "->", 
      RowBox[{"{", "14", "}"}]}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", 
      RowBox[{"1", "/", "2"}]}], ",", "\n", " ", 
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<gMin\>\"", "->", "0"}], ",", 
     RowBox[{"\"\<gMax\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<gPoints\>\"", "->", "100"}], ",", "\n", " ", 
     RowBox[{"\"\<MinimumDimension\>\"", "->", "400"}], ",", 
     RowBox[{"\"\<RankWindow\>\"", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], ",", "\n", " ", 
     RowBox[{"\"\<GapResolution\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", "\n", " ", 
     RowBox[{"\"\<WorkingPrecision\>\"", "->", "MachinePrecision"}], ",", 
     RowBox[{"\"\<BlockLength\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<StoreEnergies\>\"", "->", "True"}]}], "|>"}]}], ";"}], "\n", 
