Cell[CellGroupData[{

Cell["10.3 ZZ Hamiltonian and compatible edge-resolved sectors", "Subsection",ExpressionUUID->"cbc611dc-5f65-c642-9796-09a3f98e9c88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeH", "[", 
    RowBox[{"g_", ",", "p_Association"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", "=", 
       RowBox[{"edgeBonds", "[", 
        RowBox[{"edgeModel", "[", "p", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"realQ", "[", "g", "]"}], 
        ",", "\"\<g must be finite and real.\>\""}], "]"}], ";", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"b", "[", "\"\<Bulk\>\"", "]"}], "+", 
        RowBox[{"g", " ", 
         RowBox[{"b", "[", "\"\<ZZ\>\"", "]"}]}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeSpaces", "[", 
    RowBox[{"p_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "bits", ",", "q", ",", 
       "ids", ",", "m", ",", "a", ",", "b", ",", "names", ",", "spaces", ",", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"bits", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{
            RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"q", "=", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"charges", "[", "p", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"AssociateTo", "[", 
       RowBox[{"q", ",", 
        RowBox[{"\"\<RF\>\"", "->", 
         RowBox[{
          RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
          RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ids", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", "^", "l"}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"bits", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], " ", 
              "&&", "\n", "    ", 
              RowBox[{
               RowBox[{"bits", "[", 
                RowBox[{"[", 
                 RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "bitA"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"bits", "[", 
                RowBox[{"[", 
                 RowBox[{"#", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "bitB"}]}], 
             "&"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ids", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"m", "=", 
          RowBox[{
           RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
         RowBox[{"a", "=", 
          RowBox[{
           RowBox[{"1", "/", "2"}], "-", "bitA"}]}], ";", 
         RowBox[{"b", "=", 
          RowBox[{
           RowBox[{"1", "/", "2"}], "-", "bitB"}]}], ";", "\n", "  ", 
         RowBox[{"names", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"a", "==", "b"}], ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}], ",", 
            RowBox[{"m", "==", "0"}], ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}], ",", "True", ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"spaces", "=", 
          RowBox[{"{", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Basis\>\"", "->", 
              RowBox[{"IdentityMatrix", "[", 
               RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", "\n", 
             "    ", 
             RowBox[{"\"\<Labels\>\"", "->", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
                RowBox[{"\"\<sA\>\"", "->", "a"}], ",", 
                RowBox[{"\"\<sB\>\"", "->", "b"}], ",", 
                RowBox[{"\"\<mBulk\>\"", "->", 
                 RowBox[{"m", "-", "a", "-", "b"}]}]}], "|>"}]}]}], "|>"}], 
           "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"spaces", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"splitCharge", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                   "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
               "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
         RowBox[{"out", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{"#", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}], 
              "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"nDown", ",", "0", ",", "l"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bitA", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bitB", ",", "0", ",", "1"}], "}"}]}], "]"}], ";", "out"}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeSetup", "[", 
    RowBox[{"p_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"edgeSetup", "[", 
    RowBox[{"p", ",", "\"\<ZZ\>\"", ",", "zzEdgeSpaces", ",", "tol"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeED", "[", 
    RowBox[{"g_", ",", "p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"edgeED", "[", 
    RowBox[{"g", ",", 
     RowBox[{"zzEdgeSetup", "[", 
      RowBox[{"p", ",", "tol"}], "]"}], ",", "tol"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->
  "In[117]:=",ExpressionUUID->"f28464a9-52e0-1d4f-b702-94410f1ff00a"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
10.3a ZZ integrability for every g; audited sector diagonalization\
\>", "Subsection",ExpressionUUID->"56f4f868-f020-dd48-ae24-9c1503dcae17"],

Cell["\<\
Let a,b=+/-1/2 be the eigenvalues of the two outer Sz operators, and let \
N=L-2. The exact conserved projectors are P_ab=|a><a|_1 tensor I_bulk tensor \
|b><b|_L. Since both outer Sz operators commute with H_ZZ, the four subspaces \
P_ab H are invariant. On each subspace the Hamiltonian is exactly
H_ab = J Sum_(j=1)^(N-1) (S_j^x S_(j+1)^x + S_j^y S_(j+1)^y + Delta S_j^z \
S_(j+1)^z) + g a S_1^z + g b S_N^z.
The bulk indices in this displayed equation are relabeled j=1,...,N; physical \
sites remain 2,...,L-1 in the code. Therefore H_ZZ is a direct sum of four \
open XXZ Hamiltonians with longitudinal boundary fields. These fields are \
induced by the edge couplings; no fields have been added to the full chain.
Integrability does not follow merely from conserving magnetization. For each \
H_ab, the six-vertex R matrix and diagonal reflection matrices produce \
commuting double-row transfer matrices t_ab(u): [t_ab(u),t_ab(v)]=0. H_ab \
belongs to this commuting family through the Hamiltonian derivative at its \
regular point, up to normalization and an additive scalar. The two diagonal \
boundary parameters are independent, so no impurity fine-tuning relation \
constrains g. In the normalization of reference [1], its Pauli-matrix \
boundary coefficients are h_-=2ga/J and h_+=2gb/J; its Delta=cosh(eta) and \
h_+/-=sinh(eta)coth(xi_+/-) parametrization covers the fields by analytic \
continuation and limits. The critical isotropic points use the corresponding \
XXX or staggered limits.
Lift the commuting charges of each block to the full chain with P_ab. Charges \
in different edge blocks have orthogonal support, and charges within a block \
commute. Together with the edge projectors this proves sector-by-sector \
integrability for every real g, on either side of Delta=1. Finite-size level \
statistics are not the proof of this statement.
Reference [1]: N. Kitanine et al., Correlation functions of the open XXZ \
chain I, J. Stat. Mech. (2007) P10009, section 2, equations (2.1), \
(2.8)-(2.16): https://arxiv.org/abs/0707.1995 .\
\>", "Text",ExpressionUUID->"88e8060e-9ff4-ce48-81b1-8416e72063a2"],

Cell["\<\
The generic spin/spatial labels in 10.1 are retained. For nonzero g, the new \
ZZ ED also asks the original charges function which bulk charges are allowed \
by the actual fields ga,gb, and splits only charges that preserve the current \
subspace and commute with its Hamiltonian. This covers compatible exceptional \
bulk Casimirs, including the two-site middle chain at L=4. At g=0 the \
original compatible endpoint refinement is reused. The numerical routine does \
not construct the transfer matrix or resolve every Bethe conserved charge; \
integrability and a finite spin/spatial symmetry classification are separate \
statements.
edgeSetupAudit tests the orthonormality and completeness of the parent bases, \
disjoint computational index coverage, charge labels, and invariance under \
BOTH H_bulk and the edge perturbation separately. edgeCheckedED optionally \
compares against a full unsplit spectrum when its fourth argument is True. \
This expensive comparison is off during production sweeps. edgeEndpointReport \
distinguishes candidate endpoint charges from the additional labels actually \
present in each independently diagonalized sector. No previous definition is \
cleared or redefined.\
\>", "Text",ExpressionUUID->"0c50585c-18ad-f04c-80ce-bc8040a34d20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "edgeSetupAudit", ",", "zzBulkCharges", ",", "zzResolvedED", ",", 
    "edgeEndpointReport", ",", "\n", " ", "edgeCheckedED", ",", 
    "edgeCheckedPoint", ",", "edgeCheckedSweep", ",", "zzBlockCheck"}], "]"}],
   ";"}]], "Input",
 CellLabel->
  "In[121]:=",ExpressionUUID->"3a4db9e0-6e53-004a-9ccb-a49c144e710c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Check", " ", "basis", " ", "completeness"}], ",", " ", 
    RowBox[{
    "invariance", " ", "of", " ", "BOTH", " ", "Hamiltonian", " ", "parts"}], 
    ",", " ", 
    RowBox[{"and", " ", 
     RowBox[{"labels", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeSetupAudit", "[", 
     RowBox[{"setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "groups", ",", "ids", ",", "other", ",", "b", ",", "all", ",", "hm", ",",
         "a", ",", "q", ",", "bits", ",", 
        RowBox[{"dim", "=", "0"}], ",", "\n", "  ", 
        RowBox[{"basisError", "=", "0."}], ",", 
        RowBox[{"blockLeak", "=", "0."}], ",", 
        RowBox[{"spaceLeak", "=", "0."}], ",", 
        RowBox[{"labelError", "=", "0."}], ",", "parts", ",", "scale"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"parts", "=", 
        RowBox[{"Values", "[", 
         RowBox[{"KeyTake", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Bulk\>\"", ",", 
             RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}]}], "}"}]}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Indices\>\"", "]"}], "&"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"all", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", "\"\<Indices\>\"", "]"}], 
           "&"}], " ", "/@", " ", "groups"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", "all", "]"}], "===", 
          RowBox[{"Range", "[", 
           RowBox[{"2", "^", "l"}], "]"}]}], 
         ",", "\"\<Sector index blocks are not a disjoint complete partition.\
\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"charges", "[", "p", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<RF\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
           RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"{", "\n", "  ", 
          RowBox[{
           RowBox[{"\"\<m\>\"", "->", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Band", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"l", "/", "2"}], "-", 
                 RowBox[{"(", 
                  RowBox[{"Total", " ", "/@", " ", "bits"}], ")"}]}], ")"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", "^", "l"}], ",", 
                RowBox[{"2", "^", "l"}]}], "}"}]}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<sA\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "1", ",",
               "l"}], "]"}]}], ",", 
           RowBox[{"\"\<sB\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "l", ",",
               "l"}], "]"}]}]}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<mBulk\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<m\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sA\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sB\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{
            RowBox[{"First", "[", "group", "]"}], "[", "\"\<Indices\>\"", 
            "]"}]}], ";", 
          RowBox[{"other", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", "l"}], "]"}], ",", "ids"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"b", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Join", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"#", "[", "\"\<Basis\>\"", "]"}], "]"}], "&"}], " ", 
               "/@", " ", "group"}], ")"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "b", "]"}], "==", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "[", "ids", "]"}], ",", 
               RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], 
            ",", "\"\<A block has an incomplete symmetry basis.\>\""}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"basisError", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"basisError", ",", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
                "b"}], "-", 
               RowBox[{"id", "[", 
                RowBox[{"Length", "[", "ids", "]"}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"dim", "+=", 
           RowBox[{
            RowBox[{"Dimensions", "[", "b", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"scale", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Norm", "[", 
                 RowBox[{"part", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
             "\n", "   ", 
             RowBox[{"blockLeak", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"blockLeak", ",", 
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{"part", "[", 
                   RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "/", 
                 "scale"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"hm", "=", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"part", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
              "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "=", 
                 RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
                RowBox[{"a", "=", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                  " ", "hm", " ", ".", " ", "b"}]}], ";", "\n", "    ", 
                RowBox[{"spaceLeak", "=", 
                 RowBox[{"Max", "[", 
                  RowBox[{"spaceLeak", ",", 
                   RowBox[{
                    RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{"hm", " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "/", 
                    "scale"}]}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"part", ",", "parts"}], "}"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"labelError", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{"labelError", ",", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], ",", 
                  "\n", "     ", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], " ", ".", " ", 
                    "b"}], "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "[", "name", 
                    "]"}], " ", "b"}]}], "]"}]}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"{", 
                RowBox[{"name", ",", 
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"Keys", "[", "q", "]"}], ",", 
                   RowBox[{"Keys", "[", 
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                  "]"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dim", "==", 
           RowBox[{"2", "^", "l"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
            "basisError", ",", "blockLeak", ",", "spaceLeak", ",", 
             "labelError"}], "]"}], "<", 
           RowBox[{"100", " ", "tol"}]}]}], ",", "\n", 
         "  ", "\"\<Edge-sector completeness, invariance, or charge-label \
audit failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<DimensionSum\>\"", "->", "dim"}], ",", 
         RowBox[{"\"\<ExpectedDimension\>\"", "->", 
          RowBox[{"2", "^", "l"}]}], ",", 
         RowBox[{"\"\<BasisError\>\"", "->", "basisError"}], ",", "\n", "  ", 
         RowBox[{"\"\<IndexBlockLeakage\>\"", "->", "blockLeak"}], ",", 
         RowBox[{"\"\<SectorLeakage\>\"", "->", "spaceLeak"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<ChargeLabelError\>\"", "->", "labelError"}], ",", 
         RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[122]:=",ExpressionUUID->"63c0f67e-26ce-1c47-81e5-0d8ba86406a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "each", " ", "ZZ", " ", "block"}], ",", " ", 
    RowBox[{
    "reuse", " ", "charges", " ", "for", " ", "its", " ", "ACTUAL", " ", 
     "effective", " ", "boundary", " ", 
     RowBox[{"fields", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBulkCharges", "[", 
     RowBox[{"g_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pb", ",", "q", ",", "names", ",", "alias"}], "}"}], ",", "\n",
       " ", 
      RowBox[{
       RowBox[{"pb", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<L\>\"", "->", 
             RowBox[{
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
            RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", "   ", 
            RowBox[{"\"\<bLeft\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sA\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<bRight\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sB\>\"", "]"}]}]}]}], "|>"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"charges", "[", "pb", "]"}]}], ";", "\n", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "These", " ", "bulk", " ", "parities", " ", "already", " ", "have", " ",
           "the", " ", "full"}], "-", 
         RowBox[{"chain", " ", "parent", " ", 
          RowBox[{"label", "."}]}]}], " ", "*)"}], "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<R\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<RF\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"names", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "q", "]"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "#"}], "]"}], ",", "0", ",", "1"}], "]"}], "&"}]}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"alias", "=", 
            RowBox[{"Switch", "[", 
             RowBox[{
             "name", ",", "\"\<R\>\"", ",", "\"\<RBulk\>\"", ",", "\"\<F\>\"",
               ",", "\"\<FBulk\>\"", ",", "\"\<RF\>\"", ",", "\"\<RFBulk\>\"",
               ",", "\n", "    ", "\"\<S2\>\"", ",", "\"\<BulkS2\>\"", 
              ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredBulkS2\>\""}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"alias", "->", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"id", "[", "2", "]"}], ",", 
              RowBox[{"q", "[", "name", "]"}], ",", 
              RowBox[{"id", "[", "2", "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[123]:=",ExpressionUUID->"cc9effe6-e9e3-a449-b251-741bb06684b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Original", " ", "ED", " ", "is", " ", "reused", " ", "at", " ", "g"}], "=", 
     RowBox[{"0.", " ", "At", " ", "other", " ", "g"}]}], ",", " ", 
    RowBox[{"add", " ", "compatible", " ", "bulk", " ", 
     RowBox[{"charges", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzResolvedED", "[", 
