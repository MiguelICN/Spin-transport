    RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"ptB", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"r", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"negativity", "[", "r_", "]"}], " ", ":=", " ", 
     RowBox[{"Total", "[", 
      RowBox[{"Clip", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"herm", "[", 
            RowBox[{"ptB", "[", "r", " ", "]"}], "]"}], "]"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n",
    "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Concurrence", " ", "from", " ", "an", " ", "exact", " ", "reduced"}], "-", 
      RowBox[{"state", " ", "factor"}]}], ";", " ", 
     RowBox[{"stable", " ", "at", " ", "rank", " ", 
      RowBox[{"deficiency", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"concurrence", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r", ",", "f", ",", "s"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"q", ",", "r"}], "}"}], "=", 
