Cell["12.4.1 Density of states of the selected symmetry sector", "Subsection",
 CellChangeTimes->{{4.0009501648533497`*^9, 
  4.0009501842880707`*^9}},ExpressionUUID->"dbc0edf4-17b9-7541-928f-\
