Cell[CellGroupData[{

Cell["\<\
11.9 Export the four plot families and scalar eigenstate data\
\>", "Subsection",ExpressionUUID->"dfe2ef95-9529-014e-9c5d-6ef1920188ec"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"exDir", "=", 
   RowBox[{"newFolder", "[", 
    RowBox[{"exOutputRoot", ",", 
     RowBox[{"exRunLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"exUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"exUsed", "[", "\"\<J\>\"", "]"}], "]"}], 
      "<>", "\"\<_Delta\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"exUsed", "[", "\"\<Delta\>\"", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeSave", "[", 
   RowBox[{
   "exDir", ",", "exUsed", ",", "\"\<Exchange\>\"", ",", "exGUsed", ",", 
    "exGroups", ",", "exResults", ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<spectrum\>\"", ",", "exSpectrumPlots"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<half_entropy\>\"", ",", "exHalfPlots"}], "}"}], ",", "\n",
       "  ", 
      RowBox[{"{", 
       RowBox[{"\"\<edge_bulk_entropy\>\"", ",", "exEdgePlots"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\"\<ipr\>\"", ",", "exIPRPlots"}], "}"}]}], "}"}], ",", 
    "exSettingsUsed"}], "]"}], ";"}]}], "Input",
 CellLabel->
  "In[315]:=",ExpressionUUID->"dd834897-c263-5d4a-8ba6-00c6fd321daa"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Saved: \"\>", 
