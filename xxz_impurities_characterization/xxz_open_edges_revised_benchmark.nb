Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"edgeCheckedSweep", "[", 
    RowBox[{"grid_List", ",", "setup_", ",", "tol_", ",", "cfg_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "<", "2"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"edgeCheckedPoint", "[", 
            RowBox[{"#", ",", "setup", ",", "tol"}], "]"}], "&"}], " ", "/@", 
          " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"DistributeDefinitions", "[", "edgeCheckedPoint", "]"}], ";", 
      "\n", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ss", "=", "setup"}], ",", 
          RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
        RowBox[{"ParallelMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"edgeCheckedPoint", "[", 
            RowBox[{"#", ",", "ss", ",", "tt"}], "]"}], "&"}], ",", "grid", ",", 
          RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[128]:=",ExpressionUUID->"12aaeea5-934b-ba4f-bcfd-bf5ee2d2465b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Independently", " ", "verify", " ", "all", " ", "four", " ", "operator", " ",
     "blocks", " ", "against", " ", "their", " ", "effective", " ", 
    RowBox[{"fields", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBlockCheck", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "n", ",", "bits", ",", "h", ",", "x", ",", "y", ",", "z", ",", "bulk",
         ",", "ids", ",", "target", ",", "rows", ",", "err"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          " ", "&&", " ", 
          RowBox[{"realQ", "[", "g", "]"}]}], 
         ",", "\"\<Expected a ZZ setup and real g.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"l", "-", "2"}]}], ";", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"h", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<Bulk\>\"", 
          "]"}], "+", 
         RowBox[{"g", " ", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<ZZ\>\"", 
           "]"}]}]}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"bulk", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", "\n", 
             "   ", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
              RowBox[{"bondOp", "[", 
               RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ids", "=", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"2", "^", "l"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "a"}], " ", "&&",
                   " ", 
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "b"}]}], 
                 "&"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"target", "=", 
              RowBox[{"bulk", "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "a"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "1", ",", "n"}], "]"}]}], "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "b"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "n", ",", "n"}], "]"}]}]}]}], ";", "\n", 
             "   ", 
             RowBox[{"err", "=", 
              RowBox[{"maxAbs", "[", 
               RowBox[{
                RowBox[{"h", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "-", "target"}], 
               "]"}]}], ";", "\n", "   ", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{"err", "<", 
                RowBox[{"100", " ", "tol", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"1.", ",", 
                   RowBox[{"Norm", "[", 
                    RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], 
               ",", "\"\<Fixed-edge ZZ block reduction failed.\>\""}], "]"}], 
             ";", "\n", "   ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<sA\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "a"}]}], ",", 
               RowBox[{"\"\<sB\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "b"}]}], ",", 
               RowBox[{"\"\<EffectiveLeftField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "a"}], ")"}]}]}], ",", "\n", 
               "    ", 
               RowBox[{"\"\<EffectiveRightField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "b"}], ")"}]}]}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"Length", "[", "ids", "]"}]}], ",", 
               RowBox[{"\"\<OperatorError\>\"", "->", "err"}]}], "|>"}]}], ",",
             "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"b", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\n", " ", "rows"}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[129]:=",ExpressionUUID->"99019044-a91f-4b4c-8105-cdeb3a27bb16"]
}, Closed]],

