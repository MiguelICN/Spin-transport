              RowBox[{"#", ",", "ss", ",", "tt"}], "]"}], "&"}], ",", "grid", 
            ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeSweepCheck", "[", 
      RowBox[{"results_", ",", "grid_", ",", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "keys"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"results", ",", "\"\<g\>\""}], "]"}], "===", "grid"}], 
          ",", "\"\<g-sweep order was not preserved.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"data", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"results", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        RowBox[{"keys", "=", 
         RowBox[{"Keys", "[", 
          RowBox[{"First", "[", "data", "]"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"results", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<DimensionSum\>\"", "]"}], "==", 
               RowBox[{"2", "^", 
                RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], "&"}]}], "]"}], " ",
            "&&", "\n", "  ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"data", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", 
                 RowBox[{"Keys", "[", "#", "]"}], "]"}], "===", 
                RowBox[{"Sort", "[", "keys", "]"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{
                   RowBox[{"Values", "[", "#", "]"}], 
                   ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
                RowBox[{"2", "^", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}]}],
           ",", "\n", 
          "  ", "\"\<The g sweep has incomplete or inconsistent parent \
sectors.\>\""}], "]"}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"SameQ", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "key", "]"}], "[", "\"\<Dimension\>\"", 
                 "]"}], "&"}], " ", "/@", " ", "data"}], ")"}]}], ",", "\n", 
            "   ", "\"\<A parent-sector dimension changed along g.\>\""}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "keys"}], "}"}]}], "]"}], ";", "keys"}]}], 
      "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->
  "In[107]:=",ExpressionUUID->"ef8c6194-6917-cc49-ab23-f964305cba82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeLabel", "[", "a_", "]"}], " ", ":=", " ", 
    RowBox[{"sectorLabel", "[", 
     RowBox[{"Association", "[", 
      RowBox[{"KeyValueMap", "[", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Switch", "[", 
           RowBox[{
           "#1", ",", "\"\<sA\>\"", ",", "\"\<s_1\>\"", ",", "\"\<sB\>\"", 
            ",", "\"\<s_L\>\"", ",", "\"\<mBulk\>\"", 
            ",", "\"\<m_{\\\\rm bulk}\>\"", ",", "_", ",", "#1"}], "]"}], "->",
           "#2"}], "&"}], ",", "a"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Small", " ", "markers", " ", "in", " ", "points"}], ";", " ", 
    RowBox[{
    "preserve", " ", "distinct", " ", "shapes", " ", "for", " ", "overlaid", " ", 
     RowBox[{"sectors", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeMarkers", "[", 
