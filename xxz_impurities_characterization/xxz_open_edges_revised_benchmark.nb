Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Stop", " ", "the", " ", "current", " ", "cell", " ", "if", " ", "an", " ",
     "input", " ", "or", " ", "validation", " ", 
    RowBox[{"fails", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"check", "[", 
      RowBox[{"test_", ",", "message_"}], "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"TrueQ", "[", "test", "]"}]}], ",", 
       RowBox[{
        RowBox[{"Print", "[", 
         RowBox[{"Style", "[", 
          RowBox[{"message", ",", "Red"}], " ", "]"}], "]"}], ";", 
        RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"realQ", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
      RowBox[{"NumberQ", "[", 
       RowBox[{"N", "[", "x", " ", "]"}], "]"}], " ", "&&", " ", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"N", "[", "x", " ", "]"}], "]"}], "==", "0"}], "]"}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"id", "[", "n_", "]"}], " ", ":=", " ", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Band", "[", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", "1"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"maxAbs", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Head", "[", "a", "]"}], "===", "SparseArray"}], ",", "\n", 
       " ", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"Abs", "[", 
           RowBox[{"a", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}]}], "]"}],
        ",", 
       RowBox[{"Max", "[", 
        RowBox[{"0", ",", 
         RowBox[{"Sequence", "@@", 
          RowBox[{"Abs", "[", 
           RowBox[{"Flatten", "[", "a", " ", "]"}], "]"}]}]}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"herm", "[", "a_", "]"}], " ", ":=", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"a", "+", 
        RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ")"}], "/", "2"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ketRho", "[", "v_", "]"}], " ", ":=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "v", ",", 
       RowBox[{"Conjugate", "[", "v", " ", "]"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"3d494314-a393-3c4e-8c68-673fddccfc5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Embed", " ", "a", " ", "one"}], "-", 
