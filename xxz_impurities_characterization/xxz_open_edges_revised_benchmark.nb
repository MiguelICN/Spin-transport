   RowBox[{
    RowBox[{
     RowBox[{"caption", "[", 
      RowBox[{"p_", ",", "deltaText_", ",", 
       RowBox[{"extra_", ":", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Column", "[", "\n", " ", 
