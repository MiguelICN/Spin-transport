  "In[365]:=",ExpressionUUID->"875e1453-941c-7b45-9fa2-2263f21b3bc5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Enumerate", " ", "only", " ", "fixed"}], "-", 
    RowBox[{"m", " ", "bit", " ", 
     RowBox[{"strings", ".", " ", "Each"}], " ", "symmetry", " ", "orbit", " ",
      "contributes", " ", "at", " ", "most", " ", "one", " ", 
     RowBox[{"column", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sgBasis", "[", 
     RowBox[{"l_Integer", ",", "lab_Association", ",", "wp_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"l", "/", "2"}], "-", 
          RowBox[{"lab", "[", "\"\<m\>\"", "]"}]}]}], ",", "states", ",", 
        "index", ",", "seen", ",", 
        RowBox[{"bRules", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"cols", "=", "0"}], ",", "x", ",", "rx", ",", "orbit", ",", 
        "signs", ",", "\n", "  ", "weights", ",", "rows", ",", "vals", ",", 
        "nn", ",", "b", ",", 
        RowBox[{"dim", "=", 
         RowBox[{"sgDimension", "[", 
          RowBox[{"l", ",", "lab"}], "]"}]}], ",", 
        RowBox[{"r", "=", 
         RowBox[{"lab", "[", "\"\<R\>\"", "]"}]}], ",", "f"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"states", "=", 
        RowBox[{"Sort", "[", 
         RowBox[{"Total", " ", "/@", " ", 
          RowBox[{"Subsets", "[", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"l", "-", "1"}]}], "]"}]}], ",", 
            RowBox[{"{", "n", "}"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"index", "=", 
        RowBox[{"AssociationThread", "[", 
         RowBox[{"states", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "states", "]"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"seen", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"False", ",", 
          RowBox[{"Length", "[", "states", "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"seen", "[", 
             RowBox[{"[", 
              RowBox[{"index", "[", "x", "]"}], "]"}], "]"}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"rx", "=", 
           RowBox[{"FromDigits", "[", 
            RowBox[{
             RowBox[{"Reverse", "[", 
              RowBox[{"IntegerDigits", "[", 
               RowBox[{"x", ",", "2", ",", "l"}], "]"}], "]"}], ",", "2"}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"lab", "[", "\"\<m\>\"", "]"}], "==", "0"}], ",", 
            RowBox[{
             RowBox[{"f", "=", 
              RowBox[{"lab", "[", "\"\<F\>\"", "]"}]}], ";", 
             RowBox[{"orbit", "=", 
              RowBox[{"{", 
               RowBox[{"x", ",", "rx", ",", 
                RowBox[{
                 RowBox[{"2", "^", "l"}], "-", "1", "-", "x"}], ",", 
                RowBox[{
                 RowBox[{"2", "^", "l"}], "-", "1", "-", "rx"}]}], "}"}]}], ";", 
             RowBox[{"signs", "=", 
              RowBox[{"{", 
               RowBox[{"1", ",", "r", ",", "f", ",", 
                RowBox[{"r", " ", "f"}]}], "}"}]}]}], ",", "\n", "    ", 
            RowBox[{
             RowBox[{"orbit", "=", 
              RowBox[{"{", 
               RowBox[{"x", ",", "rx"}], "}"}]}], ";", 
             RowBox[{"signs", "=", 
              RowBox[{"{", 
               RowBox[{"1", ",", "r"}], "}"}]}]}]}], "]"}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"seen", "[", 
            RowBox[{"[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"index", ",", 
               RowBox[{"DeleteDuplicates", "[", "orbit", "]"}]}], "]"}], 
             "]"}], "]"}], "=", "True"}], ";", "\n", "  ", 
          RowBox[{"weights", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Merge", "[", 
              RowBox[{
               RowBox[{"MapThread", "[", 
                RowBox[{"Rule", ",", 
                 RowBox[{"{", 
                  RowBox[{"orbit", ",", "signs"}], "}"}]}], "]"}], ",", 
               "Total"}], "]"}], ",", 
             RowBox[{
              RowBox[{"#", "!=", "0"}], "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "weights", "]"}], "==", "0"}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", 
          RowBox[{"cols", "++"}], ";", "\n", "  ", 
          RowBox[{"rows", "=", 
           RowBox[{"Lookup", "[", 
            RowBox[{"index", ",", 
             RowBox[{"Keys", "[", "weights", "]"}]}], "]"}]}], ";", 
          RowBox[{"vals", "=", 
           RowBox[{"Values", "[", "weights", "]"}]}], ";", 
          RowBox[{"nn", "=", 
           RowBox[{"Sqrt", "[", 
            RowBox[{"Total", "[", 
             RowBox[{"vals", "^", "2"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"bRules", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"bRules", ",", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"#1", ",", "cols"}], "}"}], "->", "#2"}], "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"rows", ",", 
                 RowBox[{"N", "[", 
                  RowBox[{
                   RowBox[{"vals", "/", "nn"}], ",", "wp"}], "]"}]}], "}"}]}],
               "]"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", "states"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"sgCheck", "[", 
        RowBox[{
         RowBox[{"cols", "==", "dim"}], 
         ",", "\"\<Orbit count does not agree with the character dimension.\>\
\""}], "]"}], ";", "\n", " ", 
       RowBox[{"b", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{"bRules", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Length", "[", "states", "]"}], ",", "dim"}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", "lab"}], ",", 
         RowBox[{"\"\<States\>\"", "->", "states"}], ",", 
         RowBox[{"\"\<Index\>\"", "->", "index"}], ",", 
         RowBox[{"\"\<Basis\>\"", "->", "b"}], ",", "\n", "  ", 
         RowBox[{"\"\<Dimension\>\"", "->", "dim"}], ",", 
         RowBox[{"\"\<MagnetizationDimension\>\"", "->", 
          RowBox[{"Length", "[", "states", "]"}]}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[368]:=",ExpressionUUID->"223afee3-2e79-6f42-a03f-e6d8c2f546c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Apply", " ", "local", " ", "bonds", " ", "to", " ", "the", " ", 
     "selected", " ", "basis"}], ",", " ", 
    RowBox[{
    "without", " ", "making", " ", "a", " ", "full", " ", "Hamiltonian", " ", 
     "or", " ", "other", " ", 
     RowBox[{"sectors", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sgAction", "[", 
     RowBox[{"basis_", ",", "kind_", ",", "wp_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"basis", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"states", "=", 
         RowBox[{"basis", "[", "\"\<States\>\"", "]"}]}], ",", 
        RowBox[{"index", "=", 
         RowBox[{"basis", "[", "\"\<Index\>\"", "]"}]}], ",", 
        RowBox[{"b", "=", 
         RowBox[{"basis", "[", "\"\<Basis\>\"", "]"}]}], ",", "\n", "  ", 
        "entries", ",", "terms", ",", "row", ",", "col", ",", "amp", ",", "x",
         ",", "bits", ",", "z", ",", "bonds", ",", "y", ",", "merged"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"entries", "=", 
        RowBox[{"Most", "[", 
         RowBox[{"ArrayRules", "[", "b", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"bonds", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"kind", "==", "\"\<EdgeXY\>\""}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"l", "-", "1"}]}], "}"}], ",", 
          RowBox[{"Range", "[", 
           RowBox[{"2", ",", 
            RowBox[{"l", "-", "2"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"terms", "=", 
        RowBox[{
         RowBox[{"Reap", "[", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"row", "=", 
              RowBox[{"entry", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
             RowBox[{"col", "=", 
              RowBox[{"entry", "[", 
               RowBox[{"[", 
                RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";", 
             RowBox[{"amp", "=", 
              RowBox[{"Last", "[", "entry", "]"}]}], ";", "\n", "   ", 
             RowBox[{"x", "=", 
              RowBox[{"states", "[", 
               RowBox[{"[", "row", "]"}], "]"}]}], ";", 
             RowBox[{"bits", "=", 
              RowBox[{"IntegerDigits", "[", 
               RowBox[{"x", ",", "2", ",", "l"}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"kind", "==", "\"\<BulkZZ\>\""}], ",", 
               RowBox[{
                RowBox[{"z", "=", 
                 RowBox[{"Total", "[", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"2", " ", 
                    RowBox[{"bits", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}], 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"1", "-", 
                    RowBox[{"2", " ", 
                    RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}]}]}], ")"}], "/", 
                    "4"}]}], ",", 
                    RowBox[{"{", 
                    RowBox[{"j", ",", "bonds"}], "}"}]}], "]"}], "]"}]}], ";",
                 "\n", "     ", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"z", "!=", "0"}], ",", 
                  RowBox[{"Sow", "[", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"row", ",", "col"}], "}"}], "->", 
                    RowBox[{"amp", " ", "z"}]}], "]"}]}], "]"}]}], ",", "\n", 
               "     ", 
               RowBox[{"Do", "[", 
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"bits", "[", 
                    RowBox[{"[", "j", "]"}], "]"}], "!=", 
                    RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"j", "+", "1"}], "]"}], "]"}]}], ",", 
                   RowBox[{
                    RowBox[{"y", "=", 
                    RowBox[{"BitXor", "[", 
                    RowBox[{"x", ",", 
                    RowBox[{
                    RowBox[{"2", "^", 
                    RowBox[{"(", 
                    RowBox[{"l", "-", "j"}], ")"}]}], "+", 
                    RowBox[{"2", "^", 
                    RowBox[{"(", 
                    RowBox[{"l", "-", "j", "-", "1"}], ")"}]}]}]}], "]"}]}], ";",
                     "\n", "       ", 
                    RowBox[{"Sow", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"index", "[", "y", "]"}], ",", "col"}], "}"}], "->", 
                    RowBox[{"amp", "/", "2"}]}], "]"}]}]}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"j", ",", "bonds"}], "}"}]}], "]"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"entry", ",", "entries"}], "}"}]}], "]"}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"terms", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"SparseArray", "[", 
           RowBox[{
            RowBox[{"{", "}"}], ",", 
            RowBox[{"Dimensions", "[", "b", "]"}]}], "]"}], "]"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"merged", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", 
             RowBox[{"Total", "[", 
              RowBox[{"Last", " ", "/@", " ", "#"}], "]"}]}], "}"}], "&"}], 
          " ", "/@", " ", 
          RowBox[{"GatherBy", "[", 
           RowBox[{
            RowBox[{"First", "[", "terms", "]"}], ",", "First"}], "]"}]}], 
         ")"}]}], ";", "\n", " ", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"merged", ",", "1"}], "]"}], ",", 
           RowBox[{"Dimensions", "[", "b", "]"}]}], "]"}], ",", "wp"}], 
        "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[369]:=",ExpressionUUID->"9b6bddb1-6117-3849-9aeb-64344ec5c5b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgSetup", "[", 
    RowBox[{"l_Integer", ",", "choice_", ",", 
     RowBox[{"wp_", ":", "MachinePrecision"}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"lab", "=", 
        RowBox[{"sgLabels", "[", 
         RowBox[{"l", ",", "choice"}], "]"}]}], ",", "basis", ",", "b", ",", 
       RowBox[{"parts", "=", 
        RowBox[{"<|", "|>"}]}], ",", "a", ",", "h", ",", 
       RowBox[{"leak", "=", "0"}], ",", 
       RowBox[{"herm", "=", "0"}], ",", "orth", ",", "scale"}], "}"}], ",", 
     "\n", " ", 
     RowBox[{
      RowBox[{"basis", "=", 
       RowBox[{"sgBasis", "[", 
        RowBox[{"l", ",", "lab", ",", "wp"}], "]"}]}], ";", 
      RowBox[{"b", "=", 
       RowBox[{"basis", "[", "\"\<Basis\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"orth", "=", 
       RowBox[{"sgMax", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", "b"}], "-", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Band", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", "1"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"basis", "[", "\"\<Dimension\>\"", "]"}], ",", 
             RowBox[{"basis", "[", "\"\<Dimension\>\"", "]"}]}], "}"}]}], 
          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"sgAction", "[", 
           RowBox[{"basis", ",", "kind", ",", "wp"}], "]"}]}], ";", 
         RowBox[{"h", "=", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", "a"}]}], ";", 
         RowBox[{"scale", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"sgMax", "[", "a", "]"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"leak", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"leak", ",", 
            RowBox[{
             RowBox[{"sgMax", "[", 
              RowBox[{"a", "-", 
               RowBox[{"b", ".", "h"}]}], "]"}], "/", "scale"}]}], "]"}]}], ";", 
         RowBox[{"herm", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"herm", ",", 
            RowBox[{
             RowBox[{"sgMax", "[", 
              RowBox[{"h", "-", 
               RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], "]"}], "/", 
             "scale"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"parts", ",", 
           RowBox[{"kind", "->", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"h", "+", 
                RowBox[{"ConjugateTranspose", "[", "h", "]"}]}], ")"}], "/", 
              "2"}], "]"}]}]}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"kind", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<BulkXY\>\"", ",", "\"\<BulkZZ\>\"", 
            ",", "\"\<EdgeXY\>\""}], "}"}]}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"orth", ",", "leak", ",", "herm"}], "]"}], "<", "tol"}], 
        ",", "\"\<Target-sector basis or invariance audit failed.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
        RowBox[{"\"\<Labels\>\"", "->", "lab"}], ",", 
        RowBox[{"\"\<Dimension\>\"", "->", 
         RowBox[{"basis", "[", "\"\<Dimension\>\"", "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<MagnetizationDimension\>\"", "->", 
         RowBox[{"basis", "[", "\"\<MagnetizationDimension\>\"", "]"}]}], ",",
         
        RowBox[{"\"\<Parts\>\"", "->", "parts"}], ",", "\n", "  ", 
        RowBox[{"\"\<WorkingPrecision\>\"", "->", "wp"}], ",", 
        RowBox[{"\"\<Audit\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<BasisError\>\"", "->", "orth"}], ",", "\n", "   ", 
           RowBox[{"\"\<RelativeSectorLeakage\>\"", "->", "leak"}], ",", 
           RowBox[{"\"\<RelativeHermiticityError\>\"", "->", "herm"}], ",", 
           RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "|>"}]}]}],
     "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[370]:=",ExpressionUUID->"5fbe3a2a-891a-db49-a3ff-7b135dd312f5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Missing", " ", "values", " ", "retain", " ", 
    RowBox[{"degeneracies", ":", " ", 
     RowBox[{"do", " ", "not", " ", "deduplicate", " ", "or", " ", "Chop", " ", 
      RowBox[{"energies", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sgStatistics", "[", 
     RowBox[{"energies_List", ",", "cfg_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"e", "=", 
         RowBox[{"Sort", "[", "energies", "]"}]}], ",", "d", ",", "lo", ",", 
        "hi", ",", "w", ",", "gaps", ",", "pairs", ",", "cut", ",", "ratios", 
        ",", "status", ",", "valid", ",", "n", ",", "blocks", ",", "bs", ",", 
        "\n", "  ", 
        RowBox[{"iid", "=", 
         RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], ",", 
        RowBox[{"bse", "=", 
         RowBox[{"Missing", "[", "\"\<TooFewBlocks\>\"", "]"}]}], ",", 
        RowBox[{"nb", "=", "0"}], ",", 
        RowBox[{"used", "=", "0"}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"d", "=", 
        RowBox[{"Length", "[", "e", "]"}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"lo", ",", "hi"}], "}"}], "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{
             RowBox[{"Floor", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
                RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", 
             "1"}]}], "]"}], ",", "\n", "   ", 
          RowBox[{"Min", "[", 
           RowBox[{"d", ",", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], 
         "}"}]}], ";", "\n", " ", 
       RowBox[{"w", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"hi", ">=", "lo"}], ",", 
          RowBox[{"e", "[", 
           RowBox[{"[", 
            RowBox[{"lo", ";;", "hi"}], "]"}], "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", 
       RowBox[{"gaps", "=", 
        RowBox[{"Differences", "[", "w", "]"}]}], ";", 
       RowBox[{"pairs", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"cut", "=", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<GapResolution\>\"", "]"}], " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"sgMax", "[", "e", "]"}]}], "]"}]}]}], ";", "\n", " ", 
       RowBox[{"ratios", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", "#", "]"}], "<=", "cut"}], ",", 
             RowBox[{"Missing", "[", "\"\<UnresolvedGapPair\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Min", "[", "#", "]"}], "/", 
              RowBox[{"Max", "[", "#", "]"}]}]}], "]"}], "&"}], " ", "/@", 
          " ", "pairs"}], ")"}]}], ";", "\n", " ", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "ratios", "]"}]}], ";", 
       RowBox[{"status", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "w", "]"}], "<", "3"}], 
          ",", "\"\<TooFewLevels\>\"", ",", "\n", "   ", 
          RowBox[{
           RowBox[{"Count", "[", 
            RowBox[{"ratios", ",", "_Missing"}], "]"}], ">", "0"}], 
          ",", "\"\<UnresolvedGaps\>\"", ",", "True", ",", "\"\<OK\>\""}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"status", "==", "\"\<OK\>\""}], " ", "&&", " ", 
          RowBox[{"n", ">=", "2"}]}], ",", 
         RowBox[{"iid", "=", 
          RowBox[{
           RowBox[{"StandardDeviation", "[", "ratios", "]"}], "/", 
           RowBox[{"Sqrt", "[", "n", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"bs", "=", 
        RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
         RowBox[{
          RowBox[{"blocks", "=", 
           RowBox[{"Partition", "[", 
            RowBox[{"ratios", ",", "bs"}], "]"}]}], ";", 
          RowBox[{"nb", "=", 
           RowBox[{"Length", "[", "blocks", "]"}]}], ";", 
          RowBox[{"used", "=", 
           RowBox[{"nb", " ", "bs"}]}], ";", "\n", "   ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"nb", ">=", "4"}], ",", 
            RowBox[{"bse", "=", 
             RowBox[{
              RowBox[{"StandardDeviation", "[", 
               RowBox[{"Mean", " ", "/@", " ", "blocks"}], "]"}], "/", 
              RowBox[{"Sqrt", "[", "nb", "]"}]}]}]}], "]"}]}]}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<SectorDimension\>\"", "->", "d"}], ",", 
         RowBox[{"\"\<WindowRanks\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
         RowBox[{"\"\<WindowLevels\>\"", "->", 
          RowBox[{"Length", "[", "w", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<GapPairs\>\"", "->", "n"}], ",", 
         RowBox[{"\"\<UnresolvedGaps\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{"gaps", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "<=", "cut"}]}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<UnresolvedGapPairs\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{"ratios", ",", "_Missing"}], "]"}]}], ",", 
         RowBox[{"\"\<GapResolution\>\"", "->", "cut"}], ",", "\n", "  ", 
         RowBox[{"\"\<Ratios\>\"", "->", "ratios"}], ",", 
         RowBox[{"\"\<MeanR\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
            RowBox[{"Mean", "[", "ratios", "]"}], ",", 
            RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<IIDSEM\>\"", "->", "iid"}], ",", 
         RowBox[{"\"\<BlockSEM\>\"", "->", "bse"}], ",", 
         RowBox[{"\"\<BlockLength\>\"", "->", "bs"}], ",", 
         RowBox[{"\"\<Blocks\>\"", "->", "nb"}], ",", "\n", "  ", 
         RowBox[{"\"\<BlockRatiosUsed\>\"", "->", "used"}], ",", 
         RowBox[{"\"\<BlockTailRatios\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
            RowBox[{"n", "-", "used"}], ",", 
            RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<MeanSpacing\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "gaps", "]"}], ">", "0"}], ",", 
            RowBox[{"Mean", "[", "gaps", "]"}], ",", 
            RowBox[{"Missing", "[", "\"\<NoGaps\>\"", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "status"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",
 CellLabel->
  "In[371]:=",ExpressionUUID->"6da6b171-08a5-3045-b050-7bf955a2066b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgPoint", "[", 
    RowBox[{"g_", ",", "setup_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "h", ",", "e", ",", "scale", ",", "im", ",", "traceErr", ",", 
       "momentErr", ",", "stats", ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}]}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
              "[", "\"\<BulkXY\>\"", "]"}], "+", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], " ", 
              RowBox[{
               RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
               "[", "\"\<BulkZZ\>\"", "]"}]}]}], ")"}]}], "+", "\n", "   ", 
          RowBox[{"g", " ", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Parts\>\"", "]"}], 
            "[", "\"\<EdgeXY\>\"", "]"}]}]}], ",", "wp"}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"e", "=", 
       RowBox[{"Eigenvalues", "[", 
        RowBox[{"Normal", "[", "h", "]"}], "]"}]}], ";", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{"sgMax", "[", "h", "]"}], ",", 
         RowBox[{"sgMax", "[", "e", "]"}]}], "]"}]}], ";", 
      RowBox[{"im", "=", 
       RowBox[{"sgMax", "[", 
        RowBox[{"Im", "[", "e", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"e", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "e", "]"}], "==", 
          RowBox[{"setup", "[", "\"\<Dimension\>\"", "]"}]}], " ", "&&", " ", 
         RowBox[{"im", "<", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}], " ", 
           "scale"}]}]}], ",", "\n", 
        "  ", "\"\<Target-sector eigenvalue count or reality check \
failed.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"e", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"traceErr", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Total", "[", "e", "]"}], "-", 
          RowBox[{"Tr", "[", "h", "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"Length", "[", "e", "]"}], " ", "scale"}]}], "]"}]}]}], ";",
       "\n", " ", 
      RowBox[{"momentErr", "=", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"e", "^", "2"}], "]"}], "-", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"h", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], "^", 
            "2"}], "]"}]}], "]"}], "/", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{"h", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}], "^", 
            "2"}], "]"}]}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"traceErr", ",", "momentErr"}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Spectral trace/moment check failed.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"stats", "=", 
       RowBox[{"sgStatistics", "[", 
        RowBox[{"e", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"g", "==", "0"}], "]"}], ",", 
        RowBox[{"stats", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"stats", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Status\>\"", "->", "\"\<DecoupledEndpoint\>\""}], ",",
              "\n", "   ", 
             RowBox[{"\"\<MeanR\>\"", "->", 
              RowBox[{
              "Missing", "[", "\"\<EndpointHasAdditionalSymmetries\>\"", 
               "]"}]}], ",", 
             RowBox[{"\"\<IIDSEM\>\"", "->", 
              RowBox[{"Missing", "[", "\"\<Endpoint\>\"", "]"}]}], ",", 
             RowBox[{"\"\<BlockSEM\>\"", "->", 
              RowBox[{"Missing", "[", "\"\<Endpoint\>\"", "]"}]}]}], "|>"}]}],
           "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<L\>\"", "->", 
           RowBox[{"setup", "[", "\"\<L\>\"", "]"}]}], ",", 
          RowBox[{"\"\<J\>\"", "->", 
           RowBox[{"cfg", "[", "\"\<J\>\"", "]"}]}], ",", 
          RowBox[{"\"\<Delta\>\"", "->", 
           RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}]}], ",", 
          RowBox[{"\"\<g\>\"", "->", "g"}], ",", "\n", "   ", 
          RowBox[{"\"\<gOverAbsJ\>\"", "->", 
           RowBox[{"g", "/", 
            RowBox[{"Abs", "[", 
             RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], "]"}]}]}], ",", 
          RowBox[{"\"\<Labels\>\"", "->", 
           RowBox[{"setup", "[", "\"\<Labels\>\"", "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<Regime\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], "==", "0"}], "]"}],
              ",", "\"\<FreeFermionControl\>\"", ",", "\"\<Interacting\>\""}],
             "]"}]}], ",", "\n", "   ", 
          RowBox[{"\"\<RelativeTraceError\>\"", "->", "traceErr"}], ",", 
          RowBox[{"\"\<RelativeSecondMomentError\>\"", "->", "momentErr"}]}], 
         "|>"}], ",", "stats", ",", "\n", "   ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"cfg", "[", "\"\<StoreEnergies\>\"", "]"}], "]"}], ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Energies\>\"", "->", "e"}], "|>"}], ",", 
          RowBox[{"<|", "|>"}]}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[372]:=",ExpressionUUID->"e8e1297a-2481-124e-b431-9fd7121b6e1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgValidate", "[", "cfg_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ls", "=", 
        RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}], ",", 
       "labs"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", "cfg", "]"}], "]"}], "===", 
         RowBox[{"Sort", "[", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Sector\>\"", ",", "\"\<LValues\>\"", ",", "\"\<J\>\"",
             ",", "\"\<Delta\>\"", ",", "\"\<Grid\>\"", ",", "\"\<gMin\>\"", 
            ",", "\"\<gMax\>\"", ",", "\"\<gPoints\>\"", ",", "\n", 
            "   ", "\"\<MinimumDimension\>\"", ",", "\"\<RankWindow\>\"", 
            ",", "\"\<GapResolution\>\"", ",", "\"\<ValidationTolerance\>\"", 
            ",", "\"\<WorkingPrecision\>\"", ",", "\"\<BlockLength\>\"", 
            ",", "\"\<StoreEnergies\>\""}], "}"}], "]"}]}], ",", "\n", 
        "  ", "\"\<Configuration keys are incomplete or unknown. This chapter \
implements equal XY edges and zero fields only.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "ls", "]"}], " ", "&&", " ", 
         RowBox[{"ls", "=!=", 
          RowBox[{"{", "}"}]}], " ", "&&", " ", 
         RowBox[{"DuplicateFreeQ", "[", "ls", "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"ls", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"IntegerQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{"#", ">=", "4"}]}], "&"}]}], "]"}]}], ",", "\n", 
        "  ", "\"\<LValues must be a nonempty list of distinct integers \
>=4.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"Mod", "[", 
            RowBox[{"ls", ",", "2"}], "]"}], "]"}], "]"}], "==", "1"}], 
        ",", "\"\<Use separate size scans for even and odd L.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<gMin\>\"", 
               ",", "\"\<gMax\>\""}], "}"}]}], "]"}], ",", "sgRealQ"}], "]"}],
          " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], "!=", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}]}]}], ",", "\n", 
        "  ", "\"\<J, Delta and g endpoints must be real, J nonzero, and \
gMin<gMax.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Linear\>\"", ",", "\"\<Log\>\""}], "}"}], ",", 
           RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], ">=", "2"}]}], ",", 
        "\n", "  ", "\"\<Choose Linear/Log and at least two gPoints.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Log\>\""}], ",", 
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ">", "0"}], 
          ",", "\"\<A logarithmic g scan requires gMin>0; zero is a separate \
endpoint.\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"wp", "===", "MachinePrecision"}], " ", "||", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"IntegerQ", "[", "wp", "]"}], " ", "&&", " ", 
           RowBox[{"wp", ">=", "20"}]}], ")"}]}], 
        ",", "\"\<WorkingPrecision must be MachinePrecision or an integer \
>=20.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"wp", "=!=", "MachinePrecision"}], ",", 
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"Lookup", "[", 
             RowBox[{"cfg", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<gMin\>\"",
                 ",", "\"\<gMax\>\""}], "}"}]}], "]"}], ",", 
            RowBox[{"_", "?", "MachineNumberQ"}]}], "]"}], ",", "\n", 
          "   ", "\"\<For high precision use exact or genuinely \
high-precision parameters, not machine decimals.\>\""}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatchQ", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", "sgRealQ"}], 
          "]"}], " ", "&&", "\n", "   ", 
         RowBox[{"0", "<=", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}]}], 
        ",", "\"\<Invalid fractional rank window.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"cfg", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<GapResolution\>\"", 
               ",", "\"\<ValidationTolerance\>\""}], "}"}]}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"sgRealQ", "[", "#", "]"}], " ", "&&", " ", 
             RowBox[{"#", ">", "0"}]}], "&"}]}], "]"}], " ", "&&", "\n", 
         "   ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BlockLength\>\"", "]"}], ">=", "2"}], " ", 
         "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}], "]"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}], ">=", 
          "1"}]}], ",", "\n", 
        "   ", "\"\<Invalid tolerances, block length, or minimum dimension.\>\
\""}], "]"}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"True", ",", "False"}], "}"}], ",", 
          RowBox[{"cfg", "[", "\"\<StoreEnergies\>\"", "]"}]}], "]"}], 
        ",", "\"\<StoreEnergies must be True or False.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"labs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"sgLabels", "[", 
          RowBox[{"#", ",", 
           RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}], "&"}], " ", "/@",
         " ", "ls"}]}], ";", "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"SameQ", "@@", "labs"}], 
        ",", "\"\<Automatic selected different labels across L; choose a \
fixed sector or separate size families.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"sgCheck", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"sgDimension", "[", 
            RowBox[{"l", ",", 
             RowBox[{"labs", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ">=", 
           RowBox[{"cfg", "[", "\"\<MinimumDimension\>\"", "]"}]}], ",", "\n",
           "   ", 
          RowBox[{"\"\<Selected sector is below MinimumDimension at L=\>\"", "<>", 
           RowBox[{"ToString", "[", "l", "]"}], 
           "<>", "\"\<. Increase L or explicitly lower the minimum.\>\""}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"l", ",", "ls"}], "}"}]}], "]"}], ";", "\n", " ", "cfg"}]}], 
    "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[373]:=",ExpressionUUID->"8d7f7548-e16e-8d45-96fd-21f57bb489ba"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgGrid", "[", "cfg_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"t", ",", 
       RowBox[{"wp", "=", 
        RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}]}]}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"sgValidate", "[", "cfg", "]"}], ";", "\n", " ", 
      RowBox[{"t", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Linear\>\""}],
          ",", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{"Subdivide", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", 
             RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "-", "1"}]}], 
            "]"}], ",", "wp"}], "]"}], ",", "\n", "   ", 
         RowBox[{"Exp", "[", 
          RowBox[{"Subdivide", "[", 
           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "wp"}], "]"}], 
             "]"}], ",", 
            RowBox[{"Log", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "wp"}], "]"}], 
             "]"}], ",", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "-", "1"}]}], 
           "]"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"t", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "wp"}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"t", "[", 
        RowBox[{"[", 
         RowBox[{"-", "1"}], "]"}], "]"}], "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "wp"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"Differences", "[", "t", "]"}], ">", "0"}], "]"}]}], 
        ",", "\"\<Grid is not distinct at this working precision.\>\""}], 
       "]"}], ";", "t"}]}], "\n", "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[374]:=",ExpressionUUID->"31f0cca4-4d7d-e045-a781-6f73670c5e2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Sizes", " ", "run", " ", "sequentially"}], ";", " ", 
    RowBox[{
    "only", " ", "one", " ", "selected", " ", "block", " ", "and", " ", "its",
      " ", "temporary", " ", "dense", " ", "eigensolver", " ", "are", " ", 
     RowBox[{"resident", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sgScan", "[", 
     RowBox[{"cfg_Association", ",", "grid_List"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"setup", ",", 
        RowBox[{"rows", "=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"audits", "=", 
         RowBox[{"{", "}"}]}], ",", "elapsed", ",", "part", ",", "labels"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"sgValidate", "[", "cfg", "]"}], ";", 
       RowBox[{"sgCheck", "[", 
        RowBox[{
         RowBox[{"grid", "===", 
          RowBox[{"sgGrid", "[", "cfg", "]"}]}], 
         ",", "\"\<Grid and settings disagree; rebuild the grid.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"elapsed", "=", 
        RowBox[{"First", "[", 
         RowBox[{"AbsoluteTiming", "[", 
          RowBox[{
           RowBox[{"Do", "[", "\n", "   ", 
            RowBox[{
             RowBox[{
              RowBox[{"Print", "[", 
               
               RowBox[{"\"\<Building L=\>\"", ",", "l", 
                ",", "\"\<; sector \>\"", ",", 
                RowBox[{"sgLabels", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}], 
                ",", "\"\<; D=\>\"", ",", 
                RowBox[{"sgDimension", "[", 
                 RowBox[{"l", ",", 
                  RowBox[{"sgLabels", "[", 
                   RowBox[{"l", ",", 
                    RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}]}], "]"}]}], 
                 "]"}]}], "]"}], ";", "\n", "   ", 
              RowBox[{"setup", "=", 
               RowBox[{"sgSetup", "[", 
                RowBox[{"l", ",", 
                 RowBox[{"cfg", "[", "\"\<Sector\>\"", "]"}], ",", 
                 RowBox[{"cfg", "[", "\"\<WorkingPrecision\>\"", "]"}], ",", 
                 RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
                "]"}]}], ";", "\n", "   ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"audits", ",", 
                RowBox[{"KeyDrop", "[", 
                 RowBox[{"setup", ",", 
                  RowBox[{"{", "\"\<Parts\>\"", "}"}]}], "]"}]}], "]"}], ";", 
              "\n", "   ", 
              RowBox[{"part", "=", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"sgPoint", "[", 
                  RowBox[{"g", ",", "setup", ",", "cfg"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"g", ",", "grid"}], "}"}]}], "]"}]}], ";", 
              RowBox[{"rows", "=", 
               RowBox[{"Join", "[", 
                RowBox[{"rows", ",", "part"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"l", ",", 
               RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], "}"}]}], "]"}],
            ";", "Null"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
         RowBox[{"\"\<gGrid\>\"", "->", "grid"}], ",", 
         RowBox[{"\"\<Setups\>\"", "->", "audits"}], ",", 
         RowBox[{"\"\<Seconds\>\"", "->", "elapsed"}], ",", 
         RowBox[{"\"\<Results\>\"", "->", "rows"}], ",", "\n", "  ", 
         RowBox[{"\"\<Notes\>\"", 
          "->", "\"\<Equal XY end bonds; zero fields; full eigenvalue list of \
one selected sector only. Error bars are descriptive estimates, not \
calibrated confidence intervals.\>\""}]}], "|>"}]}]}], "\n", "]"}]}], 
   ";"}]}]], "Input",
 CellLabel->
  "In[375]:=",ExpressionUUID->"2ff9d28a-c806-2c46-a3be-bf98a25ac800"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sgPlot", "[", 
    RowBox[{"run_Association", ",", "style_Association"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cfg", "=", 
        RowBox[{"run", "[", "\"\<Settings\>\"", "]"}]}], ",", 
       RowBox[{"rows", "=", 
        RowBox[{"run", "[", "\"\<Results\>\"", "]"}]}], ",", "valid", ",", 
       "data", ",", "labels", ",", "colors", ",", 
       RowBox[{"err", "=", 
        RowBox[{"style", "[", "\"\<ErrorBar\>\"", "]"}]}], ",", "\n", "  ", 
       "cap", ",", "xlab", ",", "ylab", ",", 
       RowBox[{"latex", "=", "False"}], ",", "gplot", ",", "labs", ",", 
       "excluded"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"None", ",", "\"\<IIDSEM\>\"", ",", "\"\<BlockSEM\>\""}], 
           "}"}], ",", "err"}], "]"}], 
        ",", "\"\<ErrorBar must be None, IIDSEM or BlockSEM.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sgRealQ", "[", 
          RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], "]"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<MarkerSize must be positive.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"style", "[", "\"\<UseMaTeX\>\"", "]"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ",", "Null"}], 
           "]"}], "]"}], ";", "\n", "  ", 
         RowBox[{"latex", "=", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"DownValues", "[", "MaTeX`MaTeX", "]"}], "]"}], ">", 
           "0"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"xlab", "=", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<g / |J|\>\"", ",", "15"}], "]"}]}], ";", 
      RowBox[{"ylab", "=", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Mean adjacent-gap ratio\>\"", ",", "15"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{"latex", ",", 
        RowBox[{
         RowBox[{"xlab", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"\"\<g/|J|\>\"", ",", 
               RowBox[{"Magnification", "->", "1.2"}]}], "]"}], ",", "xlab"}],
             "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"ylab", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"\"\<\\\\langle\\\\tilde r\\\\rangle\>\"", ",", 
               RowBox[{"Magnification", "->", "1.2"}]}], "]"}], ",", "ylab"}],
             "]"}], "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"data", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"valid", "=", 
           RowBox[{"Select", "[", 
            RowBox[{"rows", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", "\"\<L\>\"", "]"}], "==", "l"}], " ", "&&", 
               " ", 
               RowBox[{"NumericQ", "[", 
                RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], "]"}]}], "&"}]}], 
            "]"}]}], ";", "\n", "   ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", "\"\<gOverAbsJ\>\"", "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"err", "=!=", "None"}], " ", "&&", " ", 
                  RowBox[{"NumericQ", "[", 
                   RowBox[{"#", "[", "err", "]"}], "]"}]}], ",", 
                 RowBox[{"Around", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], ",", 
                   RowBox[{"#", "[", "err", "]"}]}], "]"}], ",", 
                 RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}]}], "]"}]}], "}"}], 
             "&"}], " ", "/@", " ", "valid"}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"l", ",", 
           RowBox[{"cfg", "[", "\"\<LValues\>\"", "]"}]}], "}"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"labels", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<L=\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\"\<; D=\>\"",
            "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"#", "[", "\"\<Dimension\>\"", "]"}], "]"}]}], "&"}], " ",
          "/@", " ", 
         RowBox[{"run", "[", "\"\<Setups\>\"", "]"}]}], ")"}]}], ";", "\n", 
      " ", 
      RowBox[{"colors", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], "[", "k", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"labs", "=", 
       RowBox[{
        RowBox[{"First", "[", 
         RowBox[{"run", "[", "\"\<Setups\>\"", "]"}], "]"}], 
        "[", "\"\<Labels\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"excluded", "=", 
       RowBox[{"Count", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"rows", ",", "\"\<MeanR\>\""}], "]"}], ",", "_Missing"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"cap", "=", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\"\<Equal XY edge bonds; J=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<J\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<; Delta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<Delta\>\"", "]"}], ",", "InputForm"}], 
             "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<Sector \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"labs", ",", "InputForm"}], "]"}], 
            "<>", "\"\<; rank window \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<RankWindow\>\"", "]"}], ",", 
              "InputForm"}], "]"}]}], ",", "\n", "  ", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], 
            "<>", "\"\< grid; g in [\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gMin\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<, \>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<gMax\>\"", "]"}], ",", "InputForm"}], 
             "]"}], "<>", "\"\<]; points=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"cfg", "[", "\"\<gPoints\>\"", "]"}], "]"}]}], ",", "\n",
            "  ", "\"\<Poisson: 0.386294; GOE: approximately 0.5307\>\"", ",",
            "\n", "  ", 
           RowBox[{"\"\<Error bars: \>\"", "<>", 
            RowBox[{"ToString", "[", "err", "]"}], 
            "<>", "\"\< (diagnostic); omitted means: \>\"", "<>", 
            RowBox[{"ToString", "[", "excluded", "]"}]}]}], "}"}], ",", 
         RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"gplot", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"data", ",", 
         RowBox[{"Joined", "->", "False"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Directive", "[", 
              RowBox[{"#", ",", 
               RowBox[{"AbsolutePointSize", "[", 
                RowBox[{"style", "[", "\"\<MarkerSize\>\"", "]"}], "]"}]}], 
              "]"}], "&"}], " ", "/@", " ", "colors"}], ")"}]}], ",", "\n", 
         "  ", 
         RowBox[{"IntervalMarkers", "->", "\"\<Bars\>\""}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"xlab", ",", "ylab"}], "}"}]}], ",", "\n", "  ", 
         RowBox[{"ScalingFunctions", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], "==", "\"\<Log\>\""}],
             ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Log\>\"", ",", "None"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"None", ",", "None"}], "}"}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"PlotRange", "->", 
          RowBox[{"{", 
           RowBox[{"All", ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"ImageSize", "->", 
          RowBox[{"style", "[", "\"\<ImageSize\>\"", "]"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"PointLegend", "[", 
             RowBox[{"colors", ",", "labels"}], "]"}], ",", "Right"}], 
           "]"}]}], ",", 
         RowBox[{"PlotLabel", "->", "cap"}]}], "]"}]}], ";", "\n", " ", 
      "gplot"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sgBaseFolder", "[", "]"}], " ", ":=", " ", 
   RowBox[{"Quiet", "[", 
    RowBox[{"Check", "[", 
     RowBox[{
      RowBox[{"NotebookDirectory", "[", "]"}], ",", 
      RowBox[{"Directory", "[", "]"}]}], "]"}], "]"}]}], ";"}]}], "Input",
