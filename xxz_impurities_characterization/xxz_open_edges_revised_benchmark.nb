             " ", "\"\<,\\\\quad AB=\\\\{1,L\\\\}\>\""}], ",", "\n", " ", 
            "deltaText", ",", "extra"}], "}"}], ",", "\"\<\>\""}], "]"}]}], ",", 
       RowBox[{"Alignment", "->", "Center"}], ",", 
