Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"12.4", "a"}], " ", "\[LongDash]", " ", 
    RowBox[{"Editable", " ", "DOS", " ", "settings"}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"check", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ValueQ", "[", "exResults", "]"}], " ", "&&", " ", 
       RowBox[{"ValueQ", "[", "exUsed", "]"}], " ", "&&", " ", 
       RowBox[{"ValueQ", "[", "exGUsed", "]"}]}], ",", "\n", 
      "  ", "\"\<Run 11.4 or load its matching results first.\>\""}], "]"}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"Choose", " ", "existing", " ", "g", " ", 
     RowBox[{"samples", ".", " ", "You"}], " ", "can", " ", "replace", " ", 
     "this", " ", "with", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0.1", ",", "0.5", ",", "1."}], "}"}], "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{"exDOSGValues", " ", "=", " ", 
     RowBox[{"DeleteDuplicates", "[", 
      RowBox[{"{", "\n", "   ", 
       RowBox[{
        RowBox[{"First", "[", "exGUsed", "]"}], ",", "\n", "   ", 
        RowBox[{"exGUsed", "[", 
         RowBox[{"[", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
