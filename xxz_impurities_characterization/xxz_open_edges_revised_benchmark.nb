          RowBox[{"q", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"q", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"q", "[", "#", "]"}], "[", 
