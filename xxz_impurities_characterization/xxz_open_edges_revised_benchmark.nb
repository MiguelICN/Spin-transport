     RowBox[{"size_", ":", "3"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{
        "k", ",", "1", ",", "\"\<\[FilledCircle]\>\"", ",", "2", 
         ",", "\"\<\[EmptySquare]\>\"", ",", "_", 
         ",", "\"\<\[EmptyDiamond]\>\""}], "]"}], ",", "\n", "  ", 
       RowBox[{"size", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"k", ",", "1", ",", "1", ",", "2", ",", 
          RowBox[{"4", "/", "3"}], ",", "_", ",", 
          RowBox[{"5", "/", "3"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeGridNote", "[", "grid_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dg", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Differences", "[", "grid", "]"}], "]"}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{"dg", "-", 
          RowBox[{"First", "[", "dg", "]"}]}], "]"}], "<", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}], " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "dg", "]"}]}], "]"}]}]}], ",", "\n", "  ", 
       RowBox[{"\"\<;\\\\quad \\\\delta g=\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"First", "[", "dg", "]"}], "]"}]}], ",", "\n", 
       "  ", "\"\<;\\\\quad \\\\text{nonuniform supplied grid}\>\""}], 
      "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeCaption", "[", 
     RowBox[{"p_", ",", "kind_", ",", "grid_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"tex", "[", 
         RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
       RowBox[{"{", "\n", " ", 
        RowBox[{
         RowBox[{"\"\<\\\\mathrm{OBC}:\\\\quad L=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], "<>", 
          " ", "\"\<,\\\\quad S^a=\\\\sigma^a/2,\\\\quad \
AB=\\\\{1,L\\\\}\>\""}], ",", "\n", " ", 
         RowBox[{"\"\<J_{\\\\rm bulk}=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}], "<>", 
          " ", "\"\<,\\\\quad \\\\Delta_{\\\\rm bulk}=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], 
          "<>", "\"\<,\\\\quad i_{\\\\rm bulk}=2,\\\\ldots,L-2\>\""}], ",", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"kind", "==", "\"\<ZZ\>\""}], 
           ",", "\"\<H_{\\\\rm edge}=g(S_1^zS_2^z+S_{L-1}^zS_L^z)\>\"", ",", 
           "\n", "  ", "\"\<H_{\\\\rm \
edge}=g(S_1^xS_2^x+S_1^yS_2^y+S_{L-1}^xS_L^x+S_{L-1}^yS_L^y)\>\""}], "]"}], ",",
          "\n", " ", 
         RowBox[{"\"\<g\\\\in[\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"First", "[", "grid", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"Last", "[", "grid", "]"}], "]"}], 
          "<>", "\"\<];\\\\quad N_g=\>\"", "<>", "\n", "  ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "grid", "]"}], "]"}], "<>", 
          RowBox[{"edgeGridNote", "[", "grid", "]"}], "<>", 
          " ", "\"\<;\\\\quad h=b_L=b_R=0\>\""}]}], "}"}]}], ",", 
      RowBox[{"Alignment", "->", "Center"}], ",", 
      RowBox[{"Spacings", "->", ".3"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Rank", " ", "within", " ", "a", " ", "parent", " ", "sector", " ", "is", 
