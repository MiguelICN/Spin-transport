Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"sgExport", "[", 
    RowBox[{
    "run_Association", ",", "plot_", ",", "style_Association", ",", 
     "root_String", ",", "label_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dir", ",", 
       RowBox[{"k", "=", "1"}], ",", "stem", ",", "files"}], "}"}], ",", "\n",
      " ", 
     RowBox[{
      RowBox[{"sgCheck", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"DirectoryQ", "[", "root", "]"}], " ", "||", " ", 
         RowBox[{"StringQ", "[", 
          RowBox[{"CreateDirectory", "[", 
           RowBox[{"root", ",", 
            RowBox[{"CreateIntermediateDirectories", "->", "True"}]}], "]"}], 
          "]"}]}], ",", "\"\<Cannot create output root.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"stem", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"label", ",", 
         RowBox[{
          RowBox[{"Except", "[", 
           RowBox[{
           "LetterCharacter", "|", "DigitCharacter", "|", "\"\<_\>\"", 
            "|", "\"\<-\>\""}], "]"}], "->", "\"\<_\>\""}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"dir", "=", 
       RowBox[{"FileNameJoin", "[", 
        RowBox[{"{", 
         RowBox[{"root", ",", "stem"}], "}"}], "]"}]}], ";", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{"FileExistsQ", "[", "dir", "]"}], ",", 
        RowBox[{
         RowBox[{"k", "++"}], ";", 
         RowBox[{"dir", "=", 
          RowBox[{"FileNameJoin", "[", 
           RowBox[{"{", 
            RowBox[{"root", ",", 
             RowBox[{"stem", "<>", "\"\<_\>\"", "<>", 
