    " ", 
    RowBox[{"not", " ", "overlap", " ", 
     RowBox[{"tracking", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgePanels", "[", 
    RowBox[{
    "data_", ",", "grid_", ",", "groups_", ",", "p_", ",", "kind_", ",", 
     "key_", ",", "ylabel_", ",", "title_", ",", "chop_", ",", 
     RowBox[{"markerSize_", ":", "3"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "styles", ",", "labels", ",", "curves", ",", "lineStyles", ",", 
       "values", ",", "branches", ",", "markers", ",", "groupMarkers", ",", 
       "dimText", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "==", 
          RowBox[{"Length", "[", "grid", "]"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "grid", "]"}], ">=", "2"}]}], ",", "\n", 
        "  ", "\"\<Plot data and g grid must have the same number of samples.\
\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", "markerSize", "]"}], " ", "&&", " ", 
         RowBox[{"markerSize", ">", "0"}]}], 
        ",", "\"\<MarkerSize must be positive.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"styles", "=", 
          RowBox[{"curveStyles", "[", 
           RowBox[{"Length", "[", "group", "]"}], "]"}]}], ";", 
         RowBox[{"groupMarkers", "=", 
          RowBox[{"edgeMarkers", "[", 
           RowBox[{
            RowBox[{"Length", "[", "group", "]"}], ",", "markerSize"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"labels", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"edgeLabel", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "data", "]"}], "[", "#", "]"}], 
              "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], " ", "/@", " ", 
           "group"}]}], ";", "\n", "  ", 
         RowBox[{"dimText", "=", 
          RowBox[{"dimLabel", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "data", "]"}], "[", "#", "]"}], 
              "[", "\"\<Dimension\>\"", "]"}], "&"}], " ", "/@", " ", 
            "group"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"curves", "=", 
          RowBox[{"{", "}"}]}], ";", 
         RowBox[{"lineStyles", "=", 
          RowBox[{"{", "}"}]}], ";", 
         RowBox[{"markers", "=", 
          RowBox[{"{", "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"values", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"group", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}], "[", "key", "]"}], 
                "&"}], " ", "/@", " ", "data"}], ")"}]}], ";", "\n", "   ", 
            RowBox[{"branches", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"N", "[", "grid", "]"}], ",", "#"}], "}"}], "]"}], 
                "&"}], " ", "/@", " ", 
               RowBox[{"Transpose", "[", "values", "]"}]}], ")"}]}], ";", 
            "\n", "   ", 
            RowBox[{"curves", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"curves", ",", "branches"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"lineStyles", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"lineStyles", ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"styles", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", "branches", "]"}]}], "]"}]}], "]"}]}],
             ";", "\n", "   ", 
            RowBox[{"markers", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"markers", ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"groupMarkers", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", "branches", "]"}]}], "]"}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "group", "]"}]}], "}"}]}], "]"}], ";", 
         "\n", "  ", 
         RowBox[{"g", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "chop"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
             "curves", ",", "\"\<g\>\"", ",", "ylabel", ",", "lineStyles", ",", 
              RowBox[{"{", "}"}], ",", "\n", "    ", "False", ",", "False", ",",
               "markers", ",", "dimText"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"title", ",", 
           RowBox[{"edgeCaption", "[", 
            RowBox[{"p", ",", "kind", ",", "grid"}], "]"}], ",", 
           RowBox[{"Legended", "[", 
            RowBox[{"g", ",", 
             RowBox[{"Placed", "[", "\n", "     ", 
              RowBox[{
               RowBox[{"PointLegend", "[", 
                RowBox[{"styles", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"tex", "[", 
                    RowBox[{"#", ",", "15"}], "]"}], "&"}], " ", "/@", " ", 
                  "labels"}], ",", "\n", "      ", 
                 RowBox[{"LegendMarkers", "->", 
                  RowBox[{"First", " ", "/@", " ", "groupMarkers"}]}], ",", 
                 RowBox[{"LegendMarkerSize", "->", 
                  RowBox[{"Max", "[", 
                   RowBox[{"6", ",", 
                    RowBox[{"2", " ", "markerSize"}]}], "]"}]}]}], "]"}], ",",
                "Right"}], "]"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeSave", "[", 
    RowBox[{
    "dir_", ",", "p_", ",", "kind_", ",", "grid_", ",", "groups_", ",", 
     "results_", ",", "plots_", ",", "settings_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "files", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"savePNG", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", 
               RowBox[{
                RowBox[{"spec", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<_group_\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}],
               "}"}], "]"}], ",", 
            RowBox[{"spec", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "k"}], "]"}], "]"}]}], "]"}], ",", "\n", 
          "   ", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"spec", ",", "plots"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"files", "=", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", "\"\<eigenstate_g_sweep.wxf\>\""}], "}"}], 
          "]"}], ",", "\n", "  ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", "->", "p"}], ",", 
           RowBox[{"\"\<EdgeType\>\"", "->", "kind"}], ",", 
           RowBox[{"\"\<gGrid\>\"", "->", "grid"}], ",", 
           RowBox[{"\"\<Groups\>\"", "->", "groups"}], ",", "\n", "   ", 
           RowBox[{"\"\<Results\>\"", "->", "results"}], ",", 
           RowBox[{"\"\<Settings\>\"", "->", "settings"}], ",", "\n", "   ", 
           
           RowBox[{"\"\<Notes\>\"", 
            "->", "\"\<No fields. Edge bonds replaced. g has energy units. \
Entropies in nats. IPR=sum computational probabilities squared. Eigenvectors \
are computed per point and discarded after observables. Every plot uses \
unjoined small markers at every supplied g. Eigenstates are energy ranked \
within each parent sector. Degenerate eigenvectors remain basis dependent; \
g=0 uses compatible extra charges.\>\""}]}], "|>"}], ",", "\"\<WXF\>\""}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", "files", "]"}], 
        ",", "\"\<g-sweep data export failed.\>\""}], "]"}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Saved: \>\"", ",", "dir"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Input",
