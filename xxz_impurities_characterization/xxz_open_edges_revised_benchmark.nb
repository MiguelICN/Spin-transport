Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Tensor", " ", "product", " ", "of", " ", "normalized", " ", "local", " ", 
    RowBox[{"spinors", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"productKet", "[", "locals_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "v", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", 
           " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"locals", ",", "\n", "  ", 
             RowBox[{
              RowBox[{
               RowBox[{"VectorQ", "[", 
                RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
            "]"}]}], ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"v", "=", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"N", "[", 
                RowBox[{"#2", "/", 
                 RowBox[{"Norm", "[", "#2", " ", "]"}]}], "]"}]}], "]"}], 
             "]"}], "&"}], ",", 
           RowBox[{"{", "1.", "}"}], ",", "locals"}], "]"}]}], ";", " ", 
        RowBox[{"v", "/", 
         RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"first", "=", 
      RowBox[{"0", " ", "starts", " ", "with", " ", "up"}]}], ";", " ", 
     RowBox[{"first", "=", 
      RowBox[{"1", " ", "starts", " ", "with", " ", 
       RowBox[{"down", "."}]}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"neel", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"first_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"UnitVector", "[", 
         RowBox[{"2", ",", 
          RowBox[{"1", "+", 
           RowBox[{"Mod", "[", 
            RowBox[{
             RowBox[{"k", "-", "1", "+", "first"}], ",", "2"}], "]"}]}]}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "phi", " ", "is", " ", "the", " ", "azimuth", " ", "of", " ", "the", " ", 
     "first", " ", "spin", " ", "in", " ", "this", " ", 
     RowBox[{"vector", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"helix", "[", 
      RowBox[{"n_Integer", ",", "q_", ",", 
       RowBox[{"theta_", ":", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"phi_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"productKet", "[", "\n", " ", 
      RowBox[{"Table", "[", 
