Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"spinCurrentOp", "[", "jxy_", "]"}], " ", ":=", " ", 
   RowBox[{"jxy", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "1", "]"}], ",", 
         RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], "-", "\n", " ", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{
         RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
         RowBox[{"PauliMatrix", "[", "1", "]"}]}], "]"}]}], ")"}], "/", 
     "4"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateRecord", "[", 
    RowBox[{
    "t_", ",", "a_", ",", "eng_", ",", "fac0_", ",", "rho0_", ",", 
     "purity0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], ",", "rec", ",", "pauli", ",",
        "axes", ",", "ra", ",", "rb", ",", "rr", ",", "ma", ",", "mb", ",", 
       "c", ",", "extra", ",", "cur"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rec", "=", 
       RowBox[{"observables", "[", 
        RowBox[{"t", ",", 
         RowBox[{"partitionFactor", "[", 
          RowBox[{"a", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}], ",", "rho0"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ra", ",", "rb", ",", "rr"}], "}"}], "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"rec", ",", 
         RowBox[{"{", 
          RowBox[{"\"\<RhoA\>\"", ",", "\"\<RhoB\>\"", ",", "\"\<RhoAB\>\""}],
           "}"}]}], "]"}]}], ";", 
      RowBox[{"pauli", "=", 
       RowBox[{"PauliMatrix", " ", "/@", " ", 
        RowBox[{"Range", "[", "3", "]"}]}]}], ";", 
      RowBox[{"axes", "=", 
       RowBox[{"{", 
        RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], ";",
       "\n", " ", 
      RowBox[{"ma", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"#", " ", ".", " ", "ra"}], "]"}], "]"}], "&"}], " ", "/@",
         " ", "pauli"}]}], ";", 
      RowBox[{"mb", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"#", " ", ".", " ", "rb"}], "]"}], "]"}], "&"}], " ", "/@",
         " ", "pauli"}]}], ";", "\n", " ", 
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"pauli", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"pauli", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], " ", ".", " ", "rr"}],
            "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "3"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"cur", "=", 
       RowBox[{"{", 
        RowBox[{"0.", ",", "0."}], "}"}]}], ";", "\n", " ", 
      RowBox[{"extra", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"\"\<PurityA\>\"", "->", 
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"ra", " ", ".", " ", "ra"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<PurityB\>\"", "->", 
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"rb", " ", ".", " ", "rb"}], "]"}], "]"}]}], ",", "\n",
             "   ", 
            RowBox[{"\"\<FullOverlap\>\"", "->", 
             RowBox[{
              RowBox[{
               RowBox[{"Norm", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", 
                  " ", "a"}], ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "/",
               "purity0"}]}], ",", "\n", "   ", 
            RowBox[{"\"\<CurrentLeft\>\"", "->", 
             RowBox[{"cur", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<CurrentRight\>\"", "->", 
             RowBox[{"cur", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<LocalA\>\"", "<>", 
              RowBox[{"axes", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "->", 
             RowBox[{"ma", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"\"\<LocalB\>\"", "<>", 
              RowBox[{"axes", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "->", 
             RowBox[{"mb", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ",", "\n", "  ", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"\"\<Correlation\>\"", "<>", 
                  RowBox[{"axes", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "<>", 
                  RowBox[{"axes", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                 RowBox[{"c", "[", 
                  RowBox[{"[", 
                   RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ",", "\n", "   ", 
                RowBox[{
                 RowBox[{"\"\<Connected\>\"", "<>", 
                  RowBox[{"axes", "[", 
                   RowBox[{"[", "i", "]"}], "]"}], "<>", 
                  RowBox[{"axes", "[", 
                   RowBox[{"[", "j", "]"}], "]"}]}], "->", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"c", "[", 
                    RowBox[{"[", 
                    RowBox[{"i", ",", "j"}], "]"}], "]"}], "-", 
                   RowBox[{
                    RowBox[{"ma", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], " ", 
                    RowBox[{"mb", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"i", ",", "3"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"j", ",", "3"}], "}"}]}], "]"}], ",", "2"}], "]"}]}], 
         "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"rec", ",", "extra"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateTrajectory", "[", 
    RowBox[{"eng_", ",", "fac0_", ",", "times_List", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rho0", ",", "purity0", ",", "recs"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">=", "1"}]}], 
        ",", "\"\<Supply real times.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"rho0", "=", 
       RowBox[{"reducedState", "[", 
        RowBox[{"fac0", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
      RowBox[{"purity0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", " ", 
            "fac0"}], ")"}], " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "fac0", "]"}], " ", ".", " ", 
            "fac0"}], ")"}]}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"recs", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"stateRecord", "[", 
          RowBox[{"t", ",", 
           RowBox[{"evolve", "[", 
            RowBox[{"t", ",", "eng"}], "]"}], ",", "eng", ",", "fac0", ",", 
           "rho0", ",", "purity0"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<", 
          "tol"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], ">=", 
          RowBox[{"-", "tol"}]}]}], 
        ",", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", "\n", 
      " ", "recs"}]}], "\n", "]"}]}], ";"}]}], "Code",
