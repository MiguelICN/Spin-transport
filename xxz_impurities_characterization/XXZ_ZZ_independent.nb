     RowBox[{"{", 
      RowBox[{"dir", "=", 
       RowBox[{"newFolder", "[", 
        RowBox[{"root", ",", "tag"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"KeyValueMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"savePNG", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", 
              RowBox[{"#1", "<>", "\"\<.png\>\""}]}], "}"}], "]"}], ",", 
           "#2"}], "]"}], "&"}], ",", "plots"}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
