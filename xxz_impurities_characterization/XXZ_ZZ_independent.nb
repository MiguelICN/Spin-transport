 RowBox[{
  RowBox[{
   RowBox[{"chBulkFactor", "[", 
    RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cp", "=", 
        RowBox[{"chParameters", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", "|>"}]}], "]"}]}], ",", "beta"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], ",", "\n", 
       " ", "\"\<Gibbs\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"realQ", "[", "beta", "]"}], 
          ",", "\"\<Finite real Gibbs Beta required.\>\""}], "]"}], ";", 
        RowBox[{"chMapGibbsFactor", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "beta"}], 
         "]"}]}], ",", "\n", " ", "\"\<SectorTypical\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"realQ", "[", "beta", "]"}], " ", "&&", " ", 
           RowBox[{"IntegerQ", "[", 
            RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], "]"}], 
           " ", "&&", " ", 
           RowBox[{
            RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], ">", 
            "0"}]}], ",", "\n", 
          "  ", "\"\<SectorTypical needs real Beta and a positive \
SamplesPerSector.\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"chMapTypicalFactor", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "beta", ",", 
          RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], ",", 
          RowBox[{"spec", "[", "\"\<Seed\>\"", "]"}]}], "]"}]}], ",", "\n", 
       " ", "_", ",", 
       RowBox[{"bulkFactor", "[", 
        RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chClusters", "[", 
     RowBox[{"levels_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ordered", "=", 
         RowBox[{"SortBy", "[", 
          RowBox[{"levels", ",", "First"}], "]"}]}], ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}], ",", "group"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "ordered", "]"}], ">", "0"}], " ", "&&", 
          " ", 
          RowBox[{"realQ", "[", "tol", "]"}], " ", "&&", " ", 
          RowBox[{"tol", ">", "0"}]}], 
         ",", "\"\<Invalid spectral cluster input.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"group", "=", 
        RowBox[{"{", 
         RowBox[{"First", "[", "ordered", "]"}], "}"}]}], ";", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"x", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "-", 
             RowBox[{
              RowBox[{"First", "[", "group", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "<=", "tol"}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"group", ",", "x"}], "]"}], ",", 
           RowBox[{
            RowBox[{"AppendTo", "[", 
             RowBox[{"out", ",", "group"}], "]"}], ";", 
            RowBox[{"group", "=", 
             RowBox[{"{", "x", "}"}]}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{"Rest", "[", "ordered", "]"}]}], "}"}]}], "]"}], ";", "\n",
        " ", 
       RowBox[{"Append", "[", 
        RowBox[{"out", ",", "group"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
  "\n", "\n"}], "\n"}], "Code",ExpressionUUID->"8a1bf91e-b38f-ea4a-bd66-\
5e3add3898d1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chBuild", "[", 
    RowBox[{"p_", ",", "bf_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cp", "=", 
        RowBox[{"chParameters", "[", 
         RowBox[{"p", ",", "cfg"}], "]"}]}], ",", "e", ",", "weights", ",", 
       "bl", ",", "ids", ",", "r", ",", "zero"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixQ", "[", 
          RowBox[{"bf", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "bf", "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], " ",
          "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"bf", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "-",
             "1"}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}], 
        ",", "\"\<Invalid bulk factor.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "bf", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}], "]"}], 
        ",", "\"\<Symmetries must be Automatic or None.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cfg", "[", "\"\<ProjectionCutoff\>\"", "]"}], "==", "0"}], 
        ",", "\"\<Chapter 3 prunes exactly zero columns only: set \
ProjectionCutoff->0.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}], ">", "0"}], " ", "&&",
          "\n", "  ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], "]"}], " ", 
         "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], ">", 
          "0"}]}], ",", "\"\<Invalid channel batch limits.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<Positive EDTolerance required.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"e", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"chEDTolerance", "=", 
           RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"chZzEngine", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "bf", ",", 
           RowBox[{"\"\<Symmetries\>\"", "->", 
            RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}]}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"weights", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"bl", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"e", "[", "\"\<Blocks\>\"", "]"}], "[", 
                 RowBox[{"[", "s", "]"}], "]"}], "[", "k", "]"}]}], ";", "\n",
               " ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Labels\>\"", "->", 
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<sA\>\"", "->", 
                    RowBox[{
                    RowBox[{"chZzSigns", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "1"}], "]"}], "]"}], "/", "2"}]}], ",", 
                   RowBox[{"\"\<sB\>\"", "->", 
                    RowBox[{
                    RowBox[{"chZzSigns", "[", 
                    RowBox[{"[", 
                    RowBox[{"s", ",", "2"}], "]"}], "]"}], "/", "2"}]}], ",", 
                   RowBox[{"\"\<mBulk\>\"", "->", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"e", "[", "\"\<L\>\"", "]"}], "/", "2"}], "-", 
                    RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}]}]}]}], "|>"}]}], ",", "\n",
                 " ", 
                RowBox[{"\"\<Dimension\>\"", "->", 
                 RowBox[{"Length", "[", 
                  RowBox[{"bl", "[", "\"\<E\>\"", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<ActiveColumns\>\"", "->", 
                 RowBox[{"Last", "[", 
                  RowBox[{"Dimensions", "[", 
                   RowBox[{"bl", "[", "\"\<C\>\"", "]"}], "]"}], "]"}]}], ",", 
                RowBox[{"\"\<Weight\>\"", "->", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"bl", "[", "\"\<C\>\"", "]"}], 
                    ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "/", 
                  "4"}]}]}], "|>"}]}], ",", "\n", " ", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"e", "[", "\"\<Occupied\>\"", "]"}]}], "}"}]}], "]"}], 
           ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"weights", ",", "\"\<Weight\>\""}], "]"}], "]"}], "-", 
           "1"}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Channel sector weights do not sum to one.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"e", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
          RowBox[{"\"\<TotalL\>\"", "->", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BulkFactor\>\"", "->", "bf"}], ",", 
          RowBox[{"\"\<SectorWeights\>\"", "->", "weights"}], ",", "\n", " ", 
          RowBox[{"\"\<DiscardedWeight\>\"", "->", "0."}], ",", 
          RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
          RowBox[{"\"\<FactorRank\>\"", "->", "r"}]}], "|>"}]}], "]"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chConjugateEngine", "[", "eng_", "]"}], " ", ":=", " ", 
    RowBox[{"Join", "[", 
     RowBox[{"eng", ",", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<BulkFactor\>\"", "->", 
         RowBox[{"Conjugate", "[", 
          RowBox[{"eng", "[", "\"\<BulkFactor\>\"", "]"}], "]"}]}], ",", "\n",
         " ", 
        RowBox[{"\"\<Blocks\>\"", "->", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Association", "[", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "->", 
                RowBox[{"Join", "[", 
                 RowBox[{"#2", ",", 
                  RowBox[{"<|", 
                   RowBox[{"\"\<C\>\"", "->", 
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"#2", "[", "\"\<C\>\"", "]"}], "]"}]}], "|>"}]}], 
                 "]"}]}], "&"}], ",", "blocks"}], "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"blocks", ",", 
             RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}]}], "}"}]}], 
          "]"}]}]}], "|>"}]}], "]"}]}], ";"}], "\n", "\n", 
  "\n"}], "\n"}], "Code",ExpressionUUID->"b4efd999-e462-e848-b9bb-\
8f8bdf739088"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chPrepare", "[", 
    RowBox[{"eng_", ",", "times_List", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "method", ",", "cost", ",", "entries", ",", "overlaps", ",", 
       "rankmax"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"method", "=", 
       RowBox[{"cfg", "[", "\"\<ZZMethod\>\"", "]"}]}], ";", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "Automatic", ",", "\"\<Direct\>\"", ",", "\"\<Overlap\>\""}], 
           "}"}], ",", "method"}], "]"}], 
        ",", "\"\<ZZMethod must be Automatic, Direct or Overlap.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"cost", "=", 
       RowBox[{"chZzCost", "[", 
        RowBox[{"eng", ",", 
         RowBox[{"Length", "[", "times", "]"}]}], "]"}]}], ";", 
      RowBox[{"entries", "=", 
       RowBox[{"6", " ", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], 
               "[", "\"\<E\>\"", "]"}], "]"}], "^", "2"}], ")"}], "&"}], " ", 
          "/@", " ", 
          RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "]"}]}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"method", "===", "Automatic"}], ",", 
        RowBox[{"method", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"cost", "[", "\"\<Overlap\>\"", "]"}], "<", 
             RowBox[{"cost", "[", "\"\<Direct\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{"entries", "<=", 
             RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}]}]}], 
           ",", "\"\<Overlap\>\"", ",", "\"\<Direct\>\""}], "]"}]}]}], "]"}], 
      ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"method", "==", "\"\<Overlap\>\""}], ",", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"entries", "<=", 
           RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}]}], 
          ",", "\"\<ZZ overlap cache exceeds MaxOverlapEntries; raise the \
limit or choose Direct.\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"rankmax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Last", "[", 
           RowBox[{"Dimensions", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], 
             "[", "\"\<C\>\"", "]"}], "]"}], "]"}], "&"}], " ", "/@", " ", 
         RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"method", "!=", "\"\<Direct\>\""}], " ", "||", " ", 
         RowBox[{"rankmax", "<=", 
          RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}]}]}], 
        ",", "\"\<One ZZ time slice exceeds MaxColumns; raise the \
limit.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Method\>\"", "->", "method"}], ",", 
        RowBox[{"\"\<EstimatedFlops\>\"", "->", "cost"}], ",", 
        RowBox[{"\"\<OverlapEntries\>\"", "->", "entries"}], ",", 
        RowBox[{"\"\<Overlaps\>\"", "->", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"method", "==", "\"\<Overlap\>\""}], ",", 
           RowBox[{"chZzOverlaps", "[", "eng", "]"}], ",", 
           RowBox[{"Missing", "[", "\"\<NotRequired\>\"", "]"}]}], "]"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chSeries", "[", 
     RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", 
      RowBox[{"prepared_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "pr", ",", "raw", ",", "chi", ",", "cd", ",", "fs", ",", "fds", ",", 
        "width"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "times", "]"}], ">", "0"}], " ", "&&", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"times", ",", "realQ"}], "]"}]}], 
         ",", "\"\<Channel times must be finite and real.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"pr", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"prepared", "===", "Automatic"}], ",", 
          RowBox[{"chPrepare", "[", 
           RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}], ",", 
          "prepared"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">", 
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"Join", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"chSeries", "[", 
               RowBox[{"eng", ",", "#", ",", "cfg", ",", "pr"}], "]"}], "&"}],
              " ", "/@", " ", 
             RowBox[{"Partition", "[", 
              RowBox[{"times", ",", 
               RowBox[{"UpTo", "[", 
                RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
              "]"}]}], ")"}]}], "]"}]}], "]"}], ";", "\n", " ", 
