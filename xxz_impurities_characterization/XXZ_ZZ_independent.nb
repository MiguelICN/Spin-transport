                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "+", "b"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                  "2"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"a", "+", "b"}], ")"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                 "2"}]}]}], ",", "\n", "   ", 
              RowBox[{"\"\<VarianceMinus\>\"", "->", 
               RowBox[{
                RowBox[{"Total", "[", 
