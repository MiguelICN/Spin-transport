Cell["  2.3 One active initial-state assignment  ", "Subsection",ExpressionUUID->"1e700372-3dea-5847-a9fe-8a3db4bf42a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Choose", " ", "Neel"}], ",", " ", 
    RowBox[{"Eigenstate", " ", 
     RowBox[{"(", "independent", ")"}]}], ",", " ", 
    RowBox[{"or", " ", "SelectedEigenvector", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"from", " ", "section", " ", "1", "B"}], ")"}], "."}]}]}], " ",
    "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dynBulkChoice", "=", "\"\<Neel\>\""}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynBulkMu", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynBulkSector", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<F\>\"", "->", "1"}]}], "|>"}]}], ";", 
    RowBox[{"dynBulkLevel", "=", "1"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynBulkSpecification", "=", 
     RowBox[{"Switch", "[", 
      RowBox[{"dynBulkChoice", ",", "\n", " ", "\"\<Neel\>\"", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
         RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}], ",", "\n", 
       " ", "\"\<Eigenstate\>\"", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Type\>\"", "->", "\"\<Eigenstate\>\""}], ",", 
         RowBox[{"\"\<Mu\>\"", "->", "dynBulkMu"}], ",", 
         RowBox[{"\"\<Sector\>\"", "->", "dynBulkSector"}], ",", 
         RowBox[{"\"\<Level\>\"", "->", "dynBulkLevel"}]}], "|>"}], ",", "\n",
        " ", "\"\<SelectedEigenvector\>\"", ",", "susSelectedBulk", ",", "\n",
        " ", "_", ",", 
       RowBox[{"check", "[", 
        RowBox[{"False", ",", "\"\<Unknown dynBulkChoice.\>\""}], "]"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"For", " ", "a", " ", "selected", " ", "section"}], "-", 
      RowBox[{"1", "B", " ", "ket"}]}], ",", " ", 
     RowBox[{"set", " ", "dynModel", " ", "L"}], ",", "J", ",", 
     RowBox[{
      RowBox[{"Delta", " ", "to", " ", "its", " ", "Model"}], ";", " ", 
      RowBox[{"g", " ", "remains", " ", 
       RowBox[{"free", ".", "\n", " ", "To"}], " ", "test", " ", "generation",
        " ", "from", " ", "initially", " ", "separable", " ", "edges", " ", 
       "use", " ", 
       RowBox[{
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"1", "/", "2"}], ",", "4"}], "]"}], "."}]}]}]}], " ", 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"dynEdgeState", "=", 
     RowBox[{"Normalize", "[", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynInitial", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", 
       RowBox[{"\"\<EdgeState\>\"", "->", "dynEdgeState"}], ",", 
       RowBox[{"\"\<Bulk\>\"", "->", "dynBulkSpecification"}]}], "|>"}]}], 
    ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
       "Replace", " ", "the", " ", "assignment", " ", "above", " ", "for", " ",
         "a", " ", "bulk", " ", 
        RowBox[{"helix", ":", "\n", " ", "dynInitial"}]}], "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", 
         RowBox[{"\"\<EdgeState\>\"", "->", 
          RowBox[{"Normalize", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<Bulk\>\"", "->", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
