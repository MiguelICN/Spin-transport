          RowBox[{"run", "[", "\"\<Rows\>\"", "]"}], ",", "\"\<Energy\>\""}], 
         "]"}]}], ",", 
       RowBox[{"a", "=", 
        RowBox[{
         RowBox[{"run", "[", "\"\<ZLeft\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "id"}], "]"}], "]"}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{
         RowBox[{"run", "[", "\"\<ZRight\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "id"}], "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<TargetID\>\"", "->", "j"}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{
           RowBox[{
            RowBox[{"run", "[", "\"\<Rows\>\"", "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Omega\>\"", "->", 
          RowBox[{
           RowBox[{"e", "[", 
