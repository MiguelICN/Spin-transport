Cell[CellGroupData[{

Cell["  1.2 Fixed Delta: editable g scan  ", "Subsection",ExpressionUUID->"6da4369c-bd07-8a4b-b510-64c03f758f83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"statGModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "5."}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGGrid", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"0.01", ",", "0.2", ",", "200"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"statGPlotSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<PlotChop\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SectorKeys", "->", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ", 
      "limits", " ", 
      RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
    RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
     RowBox[{"computed", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"statGOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGRunLabel", "=", "\"\<ZZ_static_g\>\""}], ";"}]}], "Code",Expre\
ssionUUID->"17b8df11-ee35-c142-a1b0-e4a7a9eef82f"],

Cell["\<\
  All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches.  \
\>", "Text",ExpressionUUID->"90cc57a3-8b0c-0044-a15c-d560fbdb3736"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.3 Compute complete eigenpairs and the three eigenstate observables  \
\>", "Subsection",ExpressionUUID->"1edb3824-70a2-7242-a6c8-30734a4d5623"],

