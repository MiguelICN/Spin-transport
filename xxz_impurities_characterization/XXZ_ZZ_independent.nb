Cell[CellGroupData[{

Cell["\<\
 2.8 Optional eigenstate comparison at fixed edge input, model and time grid \
\>", "Subsection",ExpressionUUID->"8845e706-33a4-4a49-b90b-5857e7d012d4"],

Cell["\<\
 Run after chapter-2 definitions. This test needs no section-1B evaluation. \
\>", "Text",ExpressionUUID->"42572437-c672-cb4d-9de2-56828296c7aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"boundaryDynamicsTest", "[", 
     RowBox[{
     "p_", ",", "mu_", ",", "ids_List", ",", "ts_List", ",", "edge_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"cut_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "28"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"cat", ",", "resp", ",", "fac", ",", "eng", ",", "recs", ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}], ",", "row"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"cat", "=", 
        RowBox[{"bulkEigenCatalog", "[", 
         RowBox[{"p", ",", "mu", ",", "tol"}], "]"}]}], ";", 
       RowBox[{"resp", "=", 
        RowBox[{"boundaryResponse", "[", 
         RowBox[{"cat", ",", "tol"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fac", "=", 
           RowBox[{"joinStates", "[", 
            RowBox[{
             RowBox[{"stateFactor", "[", 
              RowBox[{"edge", ",", "4", ",", "tol"}], "]"}], ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"bulkEigenKet", "[", 
                RowBox[{"cat", ",", "k"}], "]"}], "}"}], "]"}], ",", 
             RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"eng", "=", 
           RowBox[{"occupiedEngine", "[", 
            RowBox[{"p", ",", "fac", ",", "tol", ",", "cut"}], "]"}]}], ";", 
          RowBox[{"recs", "=", 
           RowBox[{"stateTrajectory", "[", 
            RowBox[{"eng", ",", "fac", ",", "ts", ",", 
             RowBox[{"100", " ", "tol"}]}], "]"}]}], ";", 
          RowBox[{"row", "=", 
           RowBox[{
            RowBox[{"resp", "[", "\"\<Rows\>\"", "]"}], "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Eigenstate\>\"", "->", "row"}], ",", 
              RowBox[{"\"\<BulkSpecification\>\"", "->", 
               RowBox[{"bulkEigenSpec", "[", 
                RowBox[{"cat", ",", "k"}], "]"}]}], ",", 
              RowBox[{"\"\<SectorWeights\>\"", "->", 
               RowBox[{"eng", "[", "\"\<SectorWeights\>\"", "]"}]}], ",", 
              "\n", "   ", 
              RowBox[{"\"\<DiscardedWeight\>\"", "->", 
               RowBox[{"eng", "[", "\"\<DiscardedWeight\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Records\>\"", "->", "recs"}], ",", 
              RowBox[{"\"\<MaxConcurrence\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"recs", ",", "\"\<Concurrence\>\""}], "]"}], "]"}]}],
               ",", "\n", "   ", 
              RowBox[{"\"\<MaxNegativity\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"recs", ",", "\"\<Negativity\>\""}], "]"}], "]"}]}], 
              ",", 
              RowBox[{"\"\<MaxEdgeBulkEntropy\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"recs", ",", "\"\<EntropyAB\>\""}], "]"}], "]"}]}]}],
              "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "ids"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Model\>\"", "->", "p"}], ",", 
         RowBox[{"\"\<Mu\>\"", "->", "mu"}], ",", 
         RowBox[{"\"\<Times\>\"", "->", "ts"}], ",", 
         RowBox[{"\"\<EdgeInput\>\"", "->", "edge"}], ",", 
         RowBox[{"\"\<Results\>\"", "->", "out"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->
  "In[292]:=",ExpressionUUID->"16cabf08-1adc-d042-82f8-55c7016dd6cd"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"Optional", " ", "controlled", " ", 
    RowBox[{"comparison", ".", " ", "Use"}], " ", "IDs", " ", "from", " ", 
    "a", " ", "catalog", " ", "with", " ", "identical", " ", "L"}], ",", "J", 
   ",", "Delta", ",", 
   RowBox[{
    RowBox[{
     RowBox[{"mu", ".", "\n", " ", "A"}], " ", "product"}], " ", "|", 
    RowBox[{"++", 
     RowBox[{">", " ", 
      RowBox[{
       RowBox[{
       "edge", " ", "input", " ", "tests", " ", "GENERATION", " ", "rather", " ",
         "than", " ", "decay", " ", "of", " ", "pre"}], "-", 
       RowBox[{"existing", " ", "Bell", " ", 
        RowBox[{"entanglement", "."}]}]}]}]}]}]}], " ", "*)"}]], "Code",
 CellLabel->
  "In[293]:=",ExpressionUUID->"9baea21c-05cd-4e4c-8ddd-4e6ee2874919"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"testEigenstates", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.45"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testMu", "=", "0"}], ";", 
  RowBox[{"testIDs", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "2"}], "}"}]}], ";", 
  RowBox[{"testTimes", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "100", ",", 
      RowBox[{"1", "/", "2"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"testEdge", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{
     RowBox[{"1", "/", "2"}], ",", "4"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "testEigenstates", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"testRun", "=", 
      RowBox[{"boundaryDynamicsTest", "[", 
       RowBox[{
       "testModel", ",", "testMu", ",", "testIDs", ",", "testTimes", ",", 
        "testEdge"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"KeyTake", "[", 
             RowBox[{
              RowBox[{"#", "[", "\"\<Eigenstate\>\"", "]"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<ID\>\"", ",", "\"\<Energy\>\"", 
                ",", "\"\<ChiPlus\>\"", ",", "\"\<ChiMinus\>\""}], "}"}]}], 
             "]"}], ",", 
            RowBox[{"KeyTake", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<MaxConcurrence\>\"", ",", "\"\<MaxNegativity\>\"",
                 ",", "\"\<MaxEdgeBulkEntropy\>\""}], "}"}]}], "]"}]}], "]"}],
           "&"}], " ", "/@", " ", 
         RowBox[{"testRun", "[", "\"\<Results\>\"", "]"}]}], ")"}], "]"}], 
      "]"}], ";", "\n", " ", 
     RowBox[{"testPlots", "=", 
      RowBox[{"Association", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\"\<Concurrence_state_\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"r", "[", "\"\<Eigenstate\>\"", "]"}], "[", "\"\<ID\>\"",
              "]"}], "]"}]}], "->", 
          RowBox[{"recordPlot", "[", 
           RowBox[{
            RowBox[{"r", "[", "\"\<Records\>\"", "]"}], ",", 
            RowBox[{"{", "\"\<Concurrence\>\"", "}"}], ",", 
            RowBox[{"observableLabel", "[", "\"\<Concurrence\>\"", "]"}], ",",
             "\n", " ", 
            RowBox[{"\"\<\\\\text{Edge entanglement: bulk state }\>\"", "<>", 
