Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"staticCaption", "[", "run_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"run", "[", "\"\<BaseModel\>\"", "]"}]}], ",", 
        RowBox[{"axis", "=", 
         RowBox[{"run", "[", "\"\<Axis\>\"", "]"}]}], ",", "fixed"}], "}"}], ",",
       "\n", " ", 
      RowBox[{
       RowBox[{"fixed", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"axis", "==", "\"\<g\>\""}], ",", "\"\<Delta\>\"", 
          ",", "\"\<g\>\""}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"tex", "[", 
            RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
          RowBox[{"{", "\n", " ", 
           RowBox[{
            RowBox[{"\"\<\\\\mathrm{ZZ}:\\\\quad L=\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
             "<>", "\"\<;\\\\quad J=\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}]}], ",", "\n", " ", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"fixed", "==", "\"\<Delta\>\""}], 
               ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}], 
             "<>", "\"\<=\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"p", "[", "fixed", "]"}], "]"}], 
             "<>", "\"\<;\\\\quad \>\"", "<>", "\n", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"axis", "==", "\"\<Delta\>\""}], 
               ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}], 
             "<>", "\"\<\\\\in[\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"First", "[", 
               RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
             "<>", "\"\<,\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Last", "[", 
               RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
             "<>", "\"\<]; N=\>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{"Length", "[", 
               RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}]}], ",",
             "\n", " ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", 
                RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], ">", "1"}], 
              ",", 
              RowBox[{"\"\<\\\\delta \>\"", "<>", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"axis", "==", "\"\<Delta\>\""}], 
                 ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}], 
               "<>", "\"\<\\\\in[\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"Min", "[", 
                 RowBox[{"Differences", "[", 
                  RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
                "]"}], "<>", "\"\<,\>\"", "<>", 
               RowBox[{"texNumber", "[", 
                RowBox[{"Max", "[", 
                 RowBox[{"Differences", "[", 
                  RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}], "]"}], 
                "]"}], "<>", " ", "\"\<]\>\""}], ",", 
              " ", "\"\<\\\\text{one sampled parameter value}\>\""}], "]"}]}],
            "}"}]}], ",", 
         RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"One", " ", "panel", " ", "per", " ", "symmetry", " ", "orbit"}], 
    ",", " ", 
    RowBox[{"with", " ", "individual", " ", "curves", " ", "and", " ", 
     RowBox[{"dimensions", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"staticPlots", "[", 
     RowBox[{"run_", ",", 
      RowBox[{"chop_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"markerSize_", ":", "3"}], ",", 
      RowBox[{"selection_", ":", "All"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"specs", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            
            RowBox[{"\"\<Eigenvalues\>\"", ",", "\"\<E_n\>\"", 
             ",", "\"\<\\\\text{Spectrum}\>\""}], "}"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<HalfEntropy\>\"", 
             ",", "\"\<S(\\\\rho_{1:\\\\lfloor L/2\\\\rfloor})\>\"", 
             ",", "\"\<\\\\text{Half-chain entanglement}\>\""}], "}"}], ",", 
           "\n", " ", 
           RowBox[{"{", 
            
            RowBox[{"\"\<EdgesEntropy\>\"", 
             ",", "\"\<S_{AB:M}(|E_n\\\\rangle)\>\"", 
             ",", "\"\<\\\\text{Edges versus bulk entanglement}\>\""}], "}"}],
            ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<IPR\>\"", 
             ",", "\"\<\\\\mathrm{IPR}_{\\\\rm comp}\>\"", 
             ",", "\"\<\\\\text{Computational-basis IPR}\>\""}], "}"}]}], 
          "}"}]}], ",", 
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "all", ",", "groups", ",", "rows", ",", 
        "members", ",", "labels", ",", "curves", ",", "axis", ",", "legends", 
        ",", "styles", ",", "markers", ",", "g", ",", "cap", ",", "history", ",",
         "dimText", ",", "family", ",", "note", ",", "key"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"axis", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"run", "[", "\"\<Axis\>\"", "]"}], "==", "\"\<Delta\>\""}],
           ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"all", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"pt", ",", "x"}], "}"}], ",", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{
                 RowBox[{"<|", 
                  RowBox[{
                   RowBox[{"\"\<x\>\"", "->", "x"}], ",", 
                   RowBox[{"\"\<Sector\>\"", "->", "#"}]}], "|>"}], "&"}], 
                " ", "/@", " ", 
                RowBox[{"pt", "[", "\"\<Sectors\>\"", "]"}]}], ")"}]}], "]"}],
             ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"run", "[", "\"\<Points\>\"", "]"}], ",", 
              RowBox[{"run", "[", "\"\<Grid\>\"", "]"}]}], "}"}]}], "]"}], ",",
           "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"all", ",", 
           RowBox[{
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{
              RowBox[{"#", "[", "\"\<Sector\>\"", "]"}], 
              ",", "\"\<SymmetrySource\>\""}], "]"}], "&"}]}], "]"}], 
         ",", "\"\<Recompute the static scan with symmetry-paired \
eigenvectors before plotting.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{"all", ",", 
          RowBox[{
           RowBox[{"staticGroupKey", "[", 
            RowBox[{
             RowBox[{"#", "[", "\"\<Sector\>\"", "]"}], "[", "\"\<Labels\>\"",
              "]"}], "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rows", "=", "group"}], ";", 
          RowBox[{"members", "=", 
           RowBox[{"GatherBy", "[", 
            RowBox[{"rows", ",", 
             RowBox[{
              RowBox[{"sectorKey", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<Sector\>\"", "]"}], 
                "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}]}], "]"}]}], ";", 
          RowBox[{"labels", "=", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "[", "\"\<Sector\>\"", "]"}], 
              "[", "\"\<Labels\>\"", "]"}], "&"}], " ", "/@", " ", 
            "members"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"selection", "=!=", "All"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Intersection", "[", 
               RowBox[{
                RowBox[{"sectorKey", " ", "/@", " ", "labels"}], ",", 
                "selection"}], "]"}], "===", 
              RowBox[{"{", "}"}]}]}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"styles", "=", 
           RowBox[{"curveStyles", "[", 
            RowBox[{"Length", "[", "members", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"markers", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Switch", "[", 
                RowBox[{
                "k", ",", "1", ",", "\"\<\[FilledCircle]\>\"", ",", "2", 
                 ",", "\"\<\[EmptySquare]\>\"", ",", "3", 
                 ",", "\"\<\[EmptyDiamond]\>\"", ",", "_", 
                 ",", "\"\<\[EmptyCircle]\>\""}], "]"}], ",", 
               RowBox[{"markerSize", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"k", "-", "1"}], ")"}], "/", "3"}]}], ")"}]}]}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", "members", "]"}]}], "}"}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"legends", "=", 
              RowBox[{"Table", "[", "\n", "    ", 
               RowBox[{
                RowBox[{
                 RowBox[{"history", "=", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<x\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Sector\>\"", "]"}], 
                    "[", "\"\<Dimension\>\"", "]"}]}], "}"}], "&"}], " ", "/@",
                     " ", 
                    RowBox[{"members", "[", 
                    RowBox[{"[", "k", "]"}], "]"}]}], ")"}]}], ";", "\n", 
                 "    ", 
                 RowBox[{"dimText", "=", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
