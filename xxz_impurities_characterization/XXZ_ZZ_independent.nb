Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstAverageState", "[", 
    RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "scale", ",", "clusters", ",", "r", ",", "widths", ",", "lev", ",", 
       "cross", ",", "f", ",", "x"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
         RowBox[{"relativeTol", ">", "0"}]}], 
        ",", "\"\<Cluster tolerance must be positive.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"maxAbs", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{
            RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], ",", "\"\<E\>\""}], 
           "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"clusters", "=", 
       RowBox[{"energyClusters", "[", 
        RowBox[{"eng", ",", 
         RowBox[{"relativeTol", " ", "scale"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"lev", "[", "item_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"item", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"v", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"0.", "+", 
               RowBox[{"0.", "I"}]}], ",", 
              RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}]}], "]"}]}]}], 
          "}"}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", "\"\<V\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"item", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "+", 
            RowBox[{"0.", "I"}]}]}], ";", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"partitionFactor", "[", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", "v", "}"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"item", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"cross", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"b", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"b", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"r", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"0.", "+", 
          RowBox[{"0.", "I"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"lev", " ", "/@", " ", "cluster"}]}], ";", 
         RowBox[{"r", "+=", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cross", "[", 
              RowBox[{"#", ",", "#"}], "]"}], "&"}], " ", "/@", " ", "f"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "=", 
             RowBox[{"cross", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"f", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
            RowBox[{"r", "+=", 
             RowBox[{"x", "+", 
              RowBox[{"ConjugateTranspose", "[", "x", "]"}]}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "f", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}], ",", 
             RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"cluster", ",", "clusters"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"widths", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
        "clusters"}]}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
