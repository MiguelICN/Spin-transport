          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"g2", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
         RowBox[{"framePlot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dos", "[", "\"\<CDF\>\"", "]"}], "}"}], ",", "\"\<E\>\"",
            ",", "\"\<F(E)\>\"", ",", 
           RowBox[{"{", "Blue", "}"}], ",", 
           RowBox[{"{", "}"}], ",", "True", ",", "False", ",", "Automatic", ",", 
           RowBox[{
            RowBox[{"sectorTex", "[", "labels", "]"}], 
            "<>", "\"\<;\\\\quad d_{\\\\rm sector}=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"dos", "[", "\"\<Dimension\>\"", "]"}], "]"}]}]}], 
          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"g1", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"g1", ",", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dos", "[", "\"\<WindowEnergies\>\"", "]"}], ",", 
            "None"}], "}"}]}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Orange", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"g2", "=", 
       RowBox[{"Show", "[", 
        RowBox[{"g2", ",", 
         RowBox[{"GridLines", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"dos", "[", "\"\<WindowEnergies\>\"", "]"}], ",", 
            RowBox[{"N", "[", 
             RowBox[{"dos", "[", "\"\<RankWindow\>\"", "]"}], "]"}]}], 
           "}"}]}], ",", 
         RowBox[{"GridLinesStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Orange", ",", "Dashed"}], "]"}]}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<DOS\>\"", "->", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"\"\<\\\\text{Normalized sector density of states}\>\"", ",", 
           RowBox[{"regimeCaption", "[", "p", "]"}], ",", "g1"}], "]"}]}], ",",
         "\n", "  ", 
        RowBox[{"\"\<CDF\>\"", "->", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"\"\<\\\\text{Empirical cumulative density}\>\"", ",", 
           RowBox[{"regimeCaption", "[", "p", "]"}], ",", "g2"}], "]"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gapDiagnostic", "[", 
    RowBox[{"e_List", ",", 
     RowBox[{"window_", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"blockLength_", ":", "10"}], ",", 
     RowBox[{"minimumDimension_", ":", "500"}], ",", 
     RowBox[{"minimumRatios_", ":", "100"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", ",", "vals", ",", "resolved", ",", "blocks", ",", "sem"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "blockLength", "]"}], " ", "&&", " ", 
         RowBox[{"blockLength", ">=", "2"}]}], 
        ",", "\"\<BlockLength must be at least two.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"r", "=", 
       RowBox[{"exGapRatios", "[", 
        RowBox[{"e", ",", "window", ",", "tol"}], "]"}]}], ";", 
      RowBox[{"vals", "=", 
       RowBox[{"r", "[", "\"\<Ratios\>\"", "]"}]}], ";", 
      RowBox[{"resolved", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"vals", ",", "NumericQ"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"r", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"r", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<ResolvedRatioCount\>\"", "->", 
            RowBox[{"Length", "[", "resolved", "]"}]}], ",", 
           RowBox[{"\"\<RatioEntryCount\>\"", "->", 
            RowBox[{"Length", "[", "vals", "]"}]}]}], "|>"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "e", "]"}], "<", "minimumDimension"}], " ", "||",
          " ", 
         RowBox[{
          RowBox[{"Length", "[", "resolved", "]"}], "<", "minimumRatios"}]}], 
        ",", "\n", "  ", 
        RowBox[{"Return", "[", 
         RowBox[{"Join", "[", 
          RowBox[{"r", ",", 
           RowBox[{"<|", 
            RowBox[{
             
             RowBox[{"\"\<Status\>\"", 
              "->", "\"\<InsufficientStatistics\>\""}], ",", 
             RowBox[{"\"\<MeanR\>\"", "->", 
              RowBox[{
              "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",", 
             "\n", "   ", 
             RowBox[{"\"\<BlockSEM\>\"", "->", 
              RowBox[{
              "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",", 
             RowBox[{"\"\<BlockLength\>\"", "->", "blockLength"}], ",", 
             RowBox[{"\"\<CompleteBlocks\>\"", "->", "0"}], ",", 
             RowBox[{"\"\<FractionRBelow005\>\"", "->", 
              RowBox[{
              "Missing", "[", "\"\<InsufficientStatistics\>\"", "]"}]}], ",", 
             "\n", "   ", 
             RowBox[{"\"\<MinimumDimension\>\"", "->", "minimumDimension"}], ",", 
             RowBox[{"\"\<MinimumRatios\>\"", "->", "minimumRatios"}]}], 
            "|>"}]}], "]"}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"blocks", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "==", "\"\<OK\>\""}], ",", 
         RowBox[{"Mean", " ", "/@", " ", 
          RowBox[{"Partition", "[", 
           RowBox[{"vals", ",", "blockLength"}], "]"}]}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"sem", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "blocks", "]"}], ">=", "2"}], ",", 
         RowBox[{
          RowBox[{"StandardDeviation", "[", "blocks", "]"}], "/", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Length", "[", "blocks", "]"}], "]"}]}], ",", 
         RowBox[{"Missing", "[", "\"\<TooFewBlocks\>\"", "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"r", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<BlockLength\>\"", "->", "blockLength"}], ",", 
          RowBox[{"\"\<CompleteBlocks\>\"", "->", 
           RowBox[{"Length", "[", "blocks", "]"}]}], ",", 
          RowBox[{"\"\<BlockSEM\>\"", "->", "sem"}], ",", "\n", "  ", 
          RowBox[{"\"\<FractionRBelow005\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "==", "\"\<OK\>\""}],
              ",", 
             RowBox[{
              RowBox[{"Count", "[", 
               RowBox[{"vals", ",", 
                RowBox[{"x_", "/;", 
                 RowBox[{"x", "<", ".05"}]}]}], "]"}], "/", 
              RowBox[{"Length", "[", "vals", "]"}]}], ",", 
             RowBox[{"Missing", "[", 
              RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "]"}]}], "]"}]}]}], 
         "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"gapScan", "[", 
    RowBox[{
    "run_", ",", "labels_", ",", "window_", ",", "tol_", ",", "blockLength_", 
     ",", 
     RowBox[{"minimumDimension_", ":", "500"}], ",", 
     RowBox[{"minimumRatios_", ":", "100"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", "\n", " ", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"pt", "=", 
          RowBox[{
           RowBox[{"run", "[", "\"\<Points\>\"", "]"}], "[", 
