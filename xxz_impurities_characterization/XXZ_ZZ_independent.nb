        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}], ";", "c"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"energyClusters", "[", 
    RowBox[{"eng_", ",", "absoluteTol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"levels", ",", 
       RowBox[{"clusters", "=", 
        RowBox[{"{", "}"}]}], ",", "current"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"levels", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], "[", 
                RowBox[{"[", "n", "]"}], "]"}], ",", "k", ",", "n"}], "}"}], ",",
              "\n", "  ", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "]"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], 
                "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", "First"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"current", "=", 
       RowBox[{"{", 
        RowBox[{"First", "[", "levels", "]"}], "}"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"item", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"current", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "<=", "absoluteTol"}], 
          ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"current", ",", "item"}], "]"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"clusters", ",", "current"}], "]"}], ";", 
           RowBox[{"current", "=", 
            RowBox[{"{", "item", "}"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"item", ",", 
          RowBox[{"Rest", "[", "levels", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Append", "[", 
       RowBox[{"clusters", ",", "current"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeAveragedMap", "[", 
     RowBox[{"eng_", ",", 
      RowBox[{"relativeTol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"scale", ",", "clusters", ",", "c", ",", "widths"}], "}"}], ",",
       "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
          RowBox[{"relativeTol", ">", "0"}]}], 
         ",", "\"\<Energy-cluster tolerance must be positive.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], ",", "\"\<E\>\""}],
             "]"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"clusters", "=", 
        RowBox[{"energyClusters", "[", 
         RowBox[{"eng", ",", 
          RowBox[{"relativeTol", " ", "scale"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"c", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", "I"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "cluster", "]"}], "==", "1"}], ",", 
            RowBox[{
             RowBox[{"c", "+=", 
              RowBox[{"mapSingletonChoi", "[", 
               RowBox[{"eng", ",", 
                RowBox[{"First", "[", "cluster", "]"}]}], "]"}]}], ";", 
             RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"c", "+=", 
           RowBox[{"mapClusterChoi", "[", 
            RowBox[{"eng", ",", "cluster"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"cluster", ",", "clusters"}], "}"}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"widths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
         "clusters"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
         RowBox[{"\"\<ChoiState\>\"", "->", 
          RowBox[{"c", "/", "4"}]}], ",", 
         RowBox[{"\"\<Transfer\>\"", "->", 
          RowBox[{"choiToTransfer", "[", "c", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",", 
         RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
          RowBox[{"relativeTol", " ", "scale"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
         RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
         RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
          RowBox[{"Max", "[", "widths", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<SingletonClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<DegenerateClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<TPError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<MapEntropy\>\"", "->", 
          RowBox[{"entropy", "[", 
           RowBox[{"c", "/", "4"}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", 
              RowBox[{"choiPartialTransposeOut", "[", 
               RowBox[{"c", "/", "4"}], "]"}], "]"}], "]"}], "]"}], "]"}]}]}],
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"onsetTime", "[", 
    RowBox[{"times_List", ",", "vals_List", ",", "threshold_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", ",", "k"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], "==", 
          RowBox[{"Length", "[", "vals", "]"}]}], " ", "&&", " ", 
         RowBox[{"realQ", "[", "threshold", "]"}], " ", "&&", " ", 
         RowBox[{"threshold", ">", "0"}]}], 
        ",", "\"\<Invalid onset threshold/data.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"pos", "=", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"vals", ",", 
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
           RowBox[{"x", ">", "threshold"}]}]}], ",", 
         RowBox[{"Missing", "[", "\"\<BelowThreshold\>\"", "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MissingQ", "[", "pos", "]"}], ",", 
        RowBox[{"Return", "[", "pos", "]"}]}], "]"}], ";", 
      RowBox[{"k", "=", 
       RowBox[{"First", "[", "pos", "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", "==", "1"}], ",", 
        RowBox[{"First", "[", "times", "]"}], ",", 
        RowBox[{
         RowBox[{"times", "[", 
          RowBox[{"[", 
           RowBox[{"k", "-", "1"}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"threshold", "-", 
            RowBox[{"vals", "[", 
             RowBox[{"[", 
              RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", 
             RowBox[{"times", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"vals", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", 
             RowBox[{"vals", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}]}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->\
"ddde1de8-daa7-e547-824d-5d7a00d11f68"],

Cell["\<\
  For a fixed normalized bulk state rhoM, Phi_t(X)=Tr_M[U_t (X tensor rhoM) \
U_t dagger]. C_t=sum_ij |i><j| tensor Phi_t(|i><j|); Tr C_t=4 and C_t/4 is \
the Choi state. C_t depends only on the model, bulk state and time. There is \
no initial-edge-state input to chBuild. Full correlated preparations belong \
to chapter 2; one cannot assign them a universal CPTP map for arbitrary edge \
inputs.  \
\>", "Text",ExpressionUUID->"4dddae27-7227-d041-a5bf-96e8abcbb71e"],

Cell["\<\
  ZZ fast implementation: diagonalize only occupied conditional BULK \
magnetization blocks. At zero fields reuse spin-flip partner eigenvectors; \
equal end couplings allow reflection-parity ED. Evolve pruned columns in \
real-arithmetic time batches for pure/low-rank states, or cache six overlap \
matrices for a rank-independent mixed-bulk time loop. Automatic selects by \
estimated cost and cache limit. Only the bulk-sector-diagonal part of rhoM \
affects this channel; no sector dephasing is applied to the exchange \
preparation.  \
\>", "Text",ExpressionUUID->"e1308c49-82db-b248-8f6c-82f04d67b62d"],

Cell["\<\
  Map observables include CP/TP diagnostics, Choi spectrum/entropy/rank, \
reference-output negativity, exact time-local generator and canonical rates \
where invertible, finite-step and instantaneous RHP witnesses, selected-pair \
BLP backflow, covariance violations, unitality, double-quantum coherence, \
signalling and retention. Probe edge states below affect only BLP/signalling \
diagnostics, not the Choi matrix. A PPT Choi state does not prove \
entanglement breaking in 4x4.  \
\>", "Text",ExpressionUUID->"0f09606f-4997-2645-8268-e79becccd56d"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  Fast channel definitions: conditional/column-pruned batches  \
\>", "Subsubsection",ExpressionUUID->"ad6a76b6-057f-b444-9bf0-f5db2ccbefe5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chMapSectors", "[", "n_Integer", "]"}], " ", ":=", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", 
     RowBox[{"PositionIndex", "[", 
      RowBox[{"DigitCount", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{
           RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}]}], "]"}], ",", " ", 
        "2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapReflectPerm", "[", 
    RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"AssociationThread", "[", 
      RowBox[{"ix", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "ix", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"IntegerReverse", "[", 
       RowBox[{
        RowBox[{"ix", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "n"}], 
       "]"}], " ", "+", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapParityQ", "[", 
    RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "ix", "]"}]}], ",", " ", "jr", ",", " ", "fix",
        ",", " ", "pr", ",", " ", "nf", ",", " ", "qe", ",", " ", "qo"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"jr", " ", "=", " ", 
       RowBox[{"chMapReflectPerm", "[", 
        RowBox[{"ix", ",", " ", "n"}], "]"}]}], ";", " ", 
      RowBox[{"fix", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"jr", " ", "-", " ", 
           RowBox[{"Range", "[", "d", "]"}]}], ",", " ", "0"}], "]"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"pr", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", "d", "]"}], ",", " ", "jr"}], "}"}], "]"}], 
         ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", " ", 
      RowBox[{"nf", " ", "=", " ", 
       RowBox[{"Length", "[", "fix", "]"}]}], ";", "\n", "  ", 
      RowBox[{"qe", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"fix", ",", " ", 
                RowBox[{"Range", "[", "nf", "]"}]}], "}"}], "]"}], " ", "->", 
             " ", "1."}], "]"}], ",", "\n", "      ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pr", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                RowBox[{"nf", " ", "+", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], "]"}],
              " ", "->", " ", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
           "      ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pr", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                RowBox[{"nf", " ", "+", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], "]"}],
              " ", "->", " ", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", " ", 
           RowBox[{"nf", " ", "+", " ", 
            RowBox[{"Length", "[", "pr", "]"}]}]}], "}"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"qo", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"pr", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "Nothing", ",", " ", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"pr", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}], 
               " ", "->", " ", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
             "      ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"pr", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}], 
               " ", "->", " ", 
               RowBox[{
                RowBox[{"-", "1"}], "/", 
                RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", 
             RowBox[{"Length", "[", "pr", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
      ";", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"qe", ",", " ", "qo"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chMapSectorEigen", "[", 
     RowBox[{"h_", ",", "ix_List", ",", "n_Integer", ",", "parity_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"hb", "=", 
         RowBox[{"N", "[", 
          RowBox[{"h", "[", 
           RowBox[{"[", 
            RowBox[{"ix", ",", "ix"}], "]"}], "]"}], "]"}]}], ",", "es", ",", 
        "out", ",", "perm", ",", "scale"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{"hb", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{"Im", "[", "hb", "]"}], "]"}], "<=", 
           RowBox[{"chEDTolerance", " ", "scale"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{"hb", "-", 
             RowBox[{"ConjugateTranspose", "[", "hb", "]"}]}], "]"}], "<=", 
           RowBox[{"chEDTolerance", " ", "scale"}]}]}], 
         ",", "\"\<Channel ED requires a real symmetric Hamiltonian.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"TrueQ", "[", "parity", "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Length", "[", "ix", "]"}], ">", "1"}]}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{"perm", "=", 
           RowBox[{"chMapReflectPerm", "[", 
            RowBox[{"ix", ",", "n"}], "]"}]}], ";", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"maxAbs", "[", 
              RowBox[{"hb", "-", 
               RowBox[{"hb", "[", 
                RowBox[{"[", 
                 RowBox[{"perm", ",", "perm"}], "]"}], "]"}]}], "]"}], "<=", 
             RowBox[{"chEDTolerance", " ", "scale"}]}], 
            ",", "\"\<Channel reflection block is not invariant.\>\""}], 
           "]"}], ";", "\n", "  ", 
          RowBox[{"es", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"x", "=", 
                 RowBox[{"Eigensystem", "[", 
                  RowBox[{"Normal", "[", 
                   RowBox[{
                    RowBox[{"Transpose", "[", "q", "]"}], " ", ".", " ", "hb",
                     " ", ".", " ", "q"}], "]"}], "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"x", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", 
                 RowBox[{"Normal", "[", 
                  RowBox[{"q", " ", ".", " ", 
                   RowBox[{"Transpose", "[", 
                    RowBox[{"x", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}],
               "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"q", ",", 
               RowBox[{"chMapParityQ", "[", 
                RowBox[{"ix", ",", "n"}], "]"}]}], "}"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"out", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<E\>\"", "->", 
              RowBox[{"Join", "@@", 
               RowBox[{"es", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
             RowBox[{"\"\<V\>\"", "->", 
              RowBox[{"Join", "[", 
               RowBox[{
                RowBox[{"Sequence", "@@", 
                 RowBox[{"es", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "2"}], 
               "]"}]}]}], "|>"}]}]}], ",", "\n", "  ", 
