a52dd4cf09f6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAPlots", "=", 
   RowBox[{"texturePanels", "[", 
    RowBox[{
    "qstARecords", ",", "qstAShortRecords", ",", "qstAUsed", ",", 
     "qstAShortUsed", ",", "False"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "qstAExportLogPlots", "]"}], ",", 
    RowBox[{"qstAPlots", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"qstAPlots", ",", "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], "&"}],
           ",", 
          RowBox[{"texturePanels", "[", 
           RowBox[{
           "qstARecords", ",", "qstAShortRecords", ",", "qstAUsed", ",", 
            "qstAShortUsed", ",", "True"}], "]"}]}], "]"}], "]"}]}], 
      "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"qstAPlots", "[", "\"\<GrandSums\>\"", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"d385a5dc-0971-b747-82eb-\
5d31c4415542"],

Cell["\<\
  Every curve uses small unjoined markers. Triangle marks on an annotated \
upper rail identify Infinity or invalid rugosity values, with their actual \
times and values stated below the panel. Log-time plots exclude t=0 \
explicitly; only the horizontal axis is logarithmic. Coherence indices \
0,1,2,3 mean 00,01,10,11. Extreme response vectors inside a degenerate \
eigenspace are not unique; their individual f1 overlaps depend on the \
returned basis.  \
\>", "Text",ExpressionUUID->"1a0e2082-5d51-1947-948c-1e633885401c"]
}, Open  ]],

