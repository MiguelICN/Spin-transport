              RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], 
            "]"}]}], ",", 
          RowBox[{"\"\<MixedInputEntropy\>\"", "->", 
           RowBox[{"entropy", "[", "mixed", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<U1CovarianceError\>\"", "->", 
           RowBox[{"u1CovarianceViolation", "[", "s", "]"}]}], ",", 
          RowBox[{"\"\<ReflectionCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"swapEdge", "[", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<FlipCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"flipEdge", "[", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<RFCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"swapEdge", "[", "]"}], " ", ".", " ", 
              RowBox[{"flipEdge", "[", "]"}]}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<TimeReversalError\>\"", "->", 
           RowBox[{"Missing", "[", "\"\<NotSampled\>\"", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumReal\>\"", "->", 
           RowBox[{"Re", "[", "lambda", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumImag\>\"", "->", 
           RowBox[{"Im", "[", "lambda", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumAbs\>\"", "->", 
           RowBox[{"Abs", "[", "lambda", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<BLPDistance\>\"", "->", 
           RowBox[{
            RowBox[{"traceNormHermitian", "[", 
             RowBox[{"applyTransfer", "[", 
              RowBox[{"s", ",", 
               RowBox[{
                RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], "-", 
                RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}]}]}], "]"}], 
             "]"}], "/", "2"}]}], ",", "\n", " ", 
          RowBox[{"\"\<SignalAtoB\>\"", "->", 
           RowBox[{"Norm", "[", 
