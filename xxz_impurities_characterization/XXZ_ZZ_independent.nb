 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstExport", "[", 
     RowBox[{"root_", ",", "tag_", ",", "plots_", ",", "data_"}], "]"}], " ", 
    ":=", " ", 
    RowBox[{"Module", "[", 
