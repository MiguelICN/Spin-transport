 RowBox[{
  RowBox[{
   RowBox[{"qstRandomResponseCheck", "[", 
    RowBox[{"records_", ",", "count_", ",", "seed_", ",", "tol_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
