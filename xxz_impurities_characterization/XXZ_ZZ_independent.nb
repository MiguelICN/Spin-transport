            RowBox[{
             RowBox[{
              RowBox[{"#1", "->", 
               RowBox[{"N", "[", 
                RowBox[{"Normal", "[", 
                 RowBox[{"#2", "[", 
                  RowBox[{"[", 
                   RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], 
              "&"}], ",", "qq"}], "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"extra", "=", 
