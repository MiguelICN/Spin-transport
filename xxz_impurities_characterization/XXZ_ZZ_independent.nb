Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"staticExportIndex", "[", "plots_Association", "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ids", "=", 
        RowBox[{"{", "}"}]}], ",", "parts", ",", "tail", ",", "point", ",", 
       "id", ",", "n"}], "}"}], ",", "\n", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"parts", "=", 
         RowBox[{"StringSplit", "[", 
          RowBox[{"key", ",", 
           RowBox[{"RegularExpression", "[", "\"\<_sectors?_\>\"", "]"}], ",",
            "2"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"tail", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "parts", "]"}], "==", "2"}], ",", 
           RowBox[{"Last", "[", "parts", "]"}], ",", "key"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"point", "=", 
         RowBox[{"StringJoin", "[", 
          RowBox[{"StringCases", "[", 
           RowBox[{"tail", ",", 
            RowBox[{
            "RegularExpression", "[", "\"\<_point_[0-9]+$\>\"", "]"}]}], 
           "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"id", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{"tail", ",", 
           RowBox[{
            RowBox[{"RegularExpression", "[", "\"\<_point_[0-9]+$\>\"", "]"}],
             "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"MemberQ", "[", 
            RowBox[{"ids", ",", "id"}], "]"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"ids", ",", "id"}], "]"}]}], "]"}], ";", 
        RowBox[{"n", "=", 
         RowBox[{"First", "[", 
          RowBox[{"FirstPosition", "[", 
           RowBox[{"ids", ",", "id"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<File\>\"", "->", 
           RowBox[{
            RowBox[{"First", "[", "parts", "]"}], "<>", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"StringContainsQ", "[", 
               RowBox[{"key", ",", "\"\<_sectors_\>\""}], "]"}], 
              ",", "\"\<_sectors_\>\"", ",", "\"\<_sector_\>\""}], "]"}], "<>",
             "\n", "    ", 
            RowBox[{"IntegerString", "[", 
             RowBox[{"n", ",", "10", ",", "3"}], "]"}], "<>", "point", 
            "<>", "\"\<.png\>\""}]}], ",", 
          RowBox[{"\"\<PlotKey\>\"", "->", "key"}]}], "|>"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"key", ",", 
         RowBox[{"Keys", "[", "plots", "]"}]}], "}"}]}], "]"}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"staticExportBundle", "[", 
     RowBox[{"root_", ",", "tag_", ",", "plots_Association", ",", "data_"}], 
     "]"}], " ", ":=", " ", 
