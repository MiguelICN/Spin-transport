         "\n", " ", 
        RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
         RowBox[{"relativeTol", " ", "scale"}]}], ",", 
        RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
        RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", "\n", " ", 
        RowBox[{"\"\<SingletonClusters\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<DegenerateClusters\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", "\n", 
        " ", 
        RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
         RowBox[{"Max", "[", "widths", "]"}]}], ",", 
        RowBox[{"\"\<TraceError\>\"", "->", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Tr", "[", "r", "]"}], "-", "1"}], "]"}]}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstAverageChannel", "[", 
