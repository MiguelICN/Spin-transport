                   RowBox[{"qq", "[", "#", "]"}], ",", "Infinity"}], "]"}]}], 
                "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"extra", "=", 
          RowBox[{"Association", "[", 
