Cell["  2.2 Independent model and time parameters  ", "Subsection",ExpressionUUID->"621016af-3121-9f4f-ba7b-16a5c2c94dc0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "1000."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynSettings", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<ValidationTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", 
     RowBox[{"\"\<ProjectionCutoff\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "28"}]}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynLogHorizontalAxis", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynRunLabel", "=", "\"\<ZZ_state_dynamics\>\""}], ";"}]}], "Code",
