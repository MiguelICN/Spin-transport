Cell[CellGroupData[{

Cell["  2. Dynamics of the reduced edge density matrix  ", "Title",ExpressionUUID->"8c830c8a-1677-3042-87dc-9930af9c38f0"],

Cell[CellGroupData[{

Cell["  2.1 Definitions: state preparations and observables  ", "Subsection",ExpressionUUID->"96164c9c-eece-ed48-9c9f-e01b6f192ebf"],

Cell[CellGroupData[{

Cell["  State preparation and complete state-observable records  ", \
"Subsubsection",ExpressionUUID->"a2873a40-197b-ef4f-bbba-a90b2267d07e"],

Cell["\<\
 Edge observables from the 4 x environment-rank coefficient matrix . \
\>", "Text",ExpressionUUID->"04d77794-f893-be4b-b586-b4f2e8f0948c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"observables", "[", 
    RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", "z", ",",
        "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"a", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
      RowBox[{"a1", "=", 
       RowBox[{"traceB", "[", "r", "]"}]}], ";", 
      RowBox[{"b1", "=", 
       RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
       RowBox[{"entropy", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "z"}], "}"}], "=", 
       RowBox[{"PauliMatrix", " ", "/@", " ", 
        RowBox[{"{", 
         RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
      RowBox[{"ma", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
      RowBox[{"mb", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Reverse", "[", 
        RowBox[{"Sort", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"Eigenvalues", "[", 
           RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], "]"}]}],
       ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
        RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
        RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
        RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
        RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
        RowBox[{"\"\<Purity\>\"", "->", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
        RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
        RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
        RowBox[{"\"\<MutualInfo\>\"", "->", 
         RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
        RowBox[{"\"\<Concurrence\>\"", "->", 
         RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
        RowBox[{"\"\<Negativity\>\"", "->", 
         RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<InitialOverlap\>\"", "->", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
        RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
        RowBox[{"\"\<ConnectedZZ\>\"", "->", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
           "]"}], "-", 
          RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
        RowBox[{"\"\<ConnectedXX\>\"", "->", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
           "]"}], "-", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<TraceError\>\"", "->", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
        RowBox[{"\"\<HermiticityError\>\"", "->", 
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"r", "-", 
            RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
           ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<MinEigenvalue\>\"", "->", 
         RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{4.001990383304888*^9, 4.0019903842642975`*^9}},
 CellLabel->
  "In[391]:=",ExpressionUUID->"4f24c9e4-6cdc-2241-9ccd-ffc73063103f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bulkFactor", "[", 
    RowBox[{"p_Association", ",", "spec_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
       RowBox[{"d", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], ",", 
       "v", ",", "h", ",", "e", ",", "w", ",", "beta", ",", "mat", ",", 
       "emin", ",", "r"}], "}"}], ",", "\n", " ", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], ",", "\n", " ", 
       RowBox[{"\"\<Eigenstate\>\"", "|", "\"\<Eigenvector\>\""}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"bulkSelectedKet", "[", 
          RowBox[{"p", ",", "spec", ",", "tol"}], "]"}], "}"}], "]"}], ",", 
       "\n", " ", "\"\<Neel\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"neel", "[", 
          RowBox[{"n", ",", 
           RowBox[{"Lookup", "[", 
            RowBox[{"spec", ",", "\"\<First\>\"", ",", "0"}], "]"}]}], "]"}], 
         ",", "d", ",", "tol"}], "]"}], ",", "\n", " ", "\"\<Polarized\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"productKet", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"2", ",", 
              RowBox[{"1", "+", 
               RowBox[{"spec", "[", "\"\<Bit\>\"", "]"}]}]}], "]"}], ",", 
            "n"}], "]"}], "]"}], ",", "d", ",", "tol"}], "]"}], ",", "\n", 
       " ", "\"\<Helix\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"helix", "[", 
          RowBox[{"n", ",", 
           RowBox[{"spec", "[", "\"\<q\>\"", "]"}], ",", 
           RowBox[{"spec", "[", "\"\<theta\>\"", "]"}], ",", 
           RowBox[{"spec", "[", "\"\<phi\>\"", "]"}]}], "]"}], ",", "d", ",", 
         "tol"}], "]"}], ",", "\n", " ", "\"\<InfiniteT\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "d", "]"}], "/", 
         RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}], ",", "\n", 
       " ", "\"\<Gibbs\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"realQ", "[", "beta", "]"}], 
          ",", "\"\<Beta must be finite and real.\>\""}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}], "]"}], "]"}]}],
         ";", "\n", "  ", 
        RowBox[{"w", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "beta"}], 
           RowBox[{"(", 
            RowBox[{"e", "-", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"beta", ">=", "0"}], ",", 
               RowBox[{"Min", "[", "e", "]"}], ",", 
               RowBox[{"Max", "[", "e", "]"}]}], "]"}]}], ")"}]}], "]"}]}], ";", 
        RowBox[{"w", "/=", 
         RowBox[{"Total", "[", "w", "]"}]}], ";", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", "w", "]"}], " ", "v"}], "]"}]}], ",", "\n", 
       " ", "\"\<Typical\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"r", "=", 
         RowBox[{"spec", "[", "\"\<Samples\>\"", "]"}]}], ";", "\n", "  ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"realQ", "[", "beta", "]"}], " ", "&&", " ", 
           RowBox[{"IntegerQ", "[", "r", "]"}], " ", "&&", " ", 
           RowBox[{"r", ">=", "1"}]}], 
          ",", "\"\<Invalid typicality Beta/Samples.\>\""}], "]"}], ";", "\n",
         "  ", 
        RowBox[{"h", "=", 
         RowBox[{"N", "[", 
          RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}]}], ";", 
        RowBox[{"emin", "=", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"beta", ">=", "0"}], ",", 
            RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"h", ",", "Infinity"}], "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"mat", "=", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"SeedRandom", "[", 
            RowBox[{"spec", "[", "\"\<Seed\>\"", "]"}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"MatrixExp", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "beta"}], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"h", "-", 
                    RowBox[{"emin", " ", 
                    RowBox[{"id", "[", "d", "]"}]}]}], ")"}], "/", "2"}]}], ",",
                 "\n", "    ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                  "]"}], "+", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                   "]"}]}]}]}], "]"}], ",", 
              RowBox[{"{", "r", "}"}]}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"mat", "/", 
         RowBox[{"Norm", "[", 
          RowBox[{"mat", ",", "\"\<Frobenius\>\""}], "]"}]}]}], ",", "\n", 
       " ", "\"\<User\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"spec", "[", "\"\<State\>\"", "]"}], ",", "d", ",", "tol"}], 
        "]"}], ",", "\n", " ", "_", ",", 
       RowBox[{"check", "[", 
        RowBox[{
        "False", 
         ",", "\"\<Bulk Type must be Eigenstate, Eigenvector, Neel, \
Polarized, Helix, InfiniteT, Gibbs, Typical or User.\>\""}], "]"}]}], "]"}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"initialFactor", "[", 
     RowBox[{"p_", ",", "spec_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Switch", "[", 
     RowBox[{
      RowBox[{"spec", "[", "\"\<Mode\>\"", "]"}], ",", "\n", 
      " ", "\"\<Product\>\"", ",", 
      RowBox[{"joinStates", "[", 
       RowBox[{
        RowBox[{"stateFactor", "[", 
         RowBox[{
          RowBox[{"spec", "[", "\"\<EdgeState\>\"", "]"}], ",", "4", ",", 
          "tol"}], "]"}], ",", 
        RowBox[{"bulkFactor", "[", 
         RowBox[{"p", ",", 
          RowBox[{"spec", "[", "\"\<Bulk\>\"", "]"}], ",", "tol"}], "]"}], ",", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "\n", 
      " ", "\"\<Full\>\"", ",", 
      RowBox[{"stateFactor", "[", 
       RowBox[{
        RowBox[{"spec", "[", "\"\<FullState\>\"", "]"}], ",", 
        RowBox[{"2", "^", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "tol"}], "]"}], ",", 
      "\n", " ", "_", ",", 
      RowBox[{"check", "[", 
       RowBox[{
       "False", ",", "\"\<Initial Mode must be Product or Full.\>\""}], 
       "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateInputDiagnostics", "[", 
    RowBox[{"p_", ",", "fac_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "gram", ",", "ha", ",", "energy", ",", "kinetic", ",", "mean", ",", 
       "var", ",", "comm", ",", "qr", ",", "rr", ",", "ra", ",", "rb", ",", 
       "r"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"gram", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
        "fac"}]}], ";", 
      RowBox[{"ha", "=", 
       RowBox[{
        RowBox[{"regimeHamiltonian", "[", "p", "]"}], " ", ".", " ", 
        "fac"}]}], ";", "\n", " ", 
      RowBox[{"energy", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
        "ha"}]}], ";", 
      RowBox[{"kinetic", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "ha", "]"}], " ", ".", " ", 
        "ha"}]}], ";", "\n", " ", 
      RowBox[{"mean", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", "energy", "]"}], "]"}]}], ";", 
      RowBox[{"var", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"0.", ",", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", "kinetic", "]"}], "]"}], "-", 
          RowBox[{"mean", "^", "2"}]}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"qr", ",", "rr"}], "}"}], "=", 
       RowBox[{"QRDecomposition", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"fac", ",", "ha", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"ra", "=", 
       RowBox[{"rr", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"1", ";;", "r"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"rb", "=", 
       RowBox[{"rr", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ";;", 
           RowBox[{"2", " ", "r"}]}]}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"comm", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rb", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "ra", "]"}]}], "-", 
          RowBox[{"ra", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "rb", "]"}]}]}], 
         ",", "\"\<Frobenius\>\""}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"comm", "<", "tol"}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<The chosen initial density matrix is stationary within the \
diagnostic tolerance; constant observables are expected.\>\"", "]"}]}], "]"}],
       ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Purity\>\"", "->", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"gram", " ", ".", " ", "gram"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MeanEnergy\>\"", "->", "mean"}], ",", 
        RowBox[{"\"\<EnergyVariance\>\"", "->", "var"}], ",", "\n", "  ", 
        RowBox[{"\"\<CommutatorNorm\>\"", "->", "comm"}], ",", 
        RowBox[{"\"\<StationaryWithinTolerance\>\"", "->", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"comm", "<", "tol"}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Code",
