Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"texNumber", "[", 
    RowBox[{"x_", "?", "NumericQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{"x", "==", "0"}], "]"}], ",", "\"\<0\>\"", ",", 
     RowBox[{"ToString", "[", 
      RowBox[{
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", "x", "]"}], ",", "6", ",", "\n", " ", 
         RowBox[{"NumberPadding", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<\>\"", ",", "\"\<\>\""}], "}"}]}], ",", 
         RowBox[{"ExponentFunction", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "4"}], "<", "#", "<", "6"}], ",", "Null", ",", 
              "#"}], "]"}], "&"}], ")"}]}], ",", "\n", " ", 
         RowBox[{"NumberFormat", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"#3", "==", "\"\<\>\""}], ",", 
              RowBox[{"StringReplace", "[", 
               RowBox[{"#1", ",", 
                RowBox[{
                 RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
                 "->", "\"\<\>\""}]}], "]"}], ",", 
              RowBox[{
               RowBox[{"StringReplace", "[", 
                RowBox[{"#1", ",", 
                 RowBox[{
                  RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
                  "->", "\"\<\>\""}]}], "]"}], "<>", "\"\<\\\\times 10^{\>\"",
                "<>", "#3", "<>", "\"\<}\>\""}]}], "]"}], "&"}], ")"}]}]}], 
        "]"}], ",", "OutputForm"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"samplingCaption", "[", 
    RowBox[{"ts_List", ",", 
     RowBox[{"cfg_", ":", 
      RowBox[{"<|", "|>"}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"dt", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Differences", "[", "ts", "]"}], "]"}]}], ",", "eps", ",", 
       "uniform", ",", "note", ",", 
       RowBox[{"grid", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"cfg", ",", "\"\<Grid\>\"", ",", "Automatic"}], "]"}]}], ",",
        "pos", ",", "ld"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"ts", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", "\"\<\\\\text{no time samples}\>\"", "]"}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"eps", "=", 
       RowBox[{"64", " ", "$MachineEpsilon", " ", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"N", "[", "ts", "]"}], "]"}], "]"}]}], "]"}]}]}], ";", 
      "\n", " ", 
      RowBox[{"uniform", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "dt", "]"}], "<", "2"}], " ", "||", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "dt", "]"}], "-", 
          RowBox[{"Min", "[", "dt", "]"}]}], "<=", "eps"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"note", "=", 
       RowBox[{"\"\<t\\\\in[\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"First", "[", "ts", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"Last", "[", "ts", "]"}], "]"}], 
        "<>", "\"\<];\\\\quad N_t=\>\"", "<>", 
        RowBox[{"ToString", "[", 
         RowBox[{"Length", "[", "ts", "]"}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"dt", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"note", "=", 
         RowBox[{"note", "<>", 
          RowBox[{"If", "[", 
           RowBox[{"uniform", ",", 
            RowBox[{"\"\<;\\\\quad \\\\delta t=\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Mean", "[", "dt", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<;\\\\quad \\\\delta t\\\\in[\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Min", "[", "dt", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"Max", "[", "dt", "]"}], "]"}], "<>", "\"\<]\>\""}]}], 
           "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "Infer", " ", "log", " ", "sampling", " ", "only", " ", "if", " ", 
        "no", " ", "saved", " ", "grid", " ", "specification", " ", "is", " ", 
        RowBox[{"supplied", "."}]}], " ", "*)"}], "\n", " ", 
      RowBox[{"pos", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"N", "[", "ts", "]"}], ",", 
         RowBox[{
          RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"ld", "=", 
       RowBox[{"Differences", "[", 
        RowBox[{"Log", "[", "pos", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
