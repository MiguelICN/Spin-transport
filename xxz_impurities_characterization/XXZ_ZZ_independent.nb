Notebook[{

Cell[CellGroupData[{
Cell["  XXZ bulk with ZZ edge coupling  ", "Title",ExpressionUUID->"880e012f-aca8-bd40-b98c-3ec6f78ea5e0"],

Cell["\<\
  L total spins: edges A=1 and B=L, bulk M={2,...,L-1}. No magnetic fields \
are added. This notebook is self-contained. Evaluate its initialization cells \
once; the two static scans, state dynamics and channel dynamics then run \
independently. All model parameters are editable within their own run. g must \
be nonzero; Delta may be zero. These .m files use separate named contexts. \
Evaluate the Begin cell first: it saves the caller search path and restricts \
symbol lookup to System` while this file context is active. Evaluate the \
final cell to restore the path. Evaluate all required definition cells before \
a chosen run; run cells are executable. Get evaluates every run.  \
\>", "Text",ExpressionUUID->"786ff3cd-635e-ca45-96cf-948d17874db7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Begin", "[", "\"\<XXZZZ`\>\"", "]"}], ";", " ", 
  RowBox[{"XXZZZ`savedContextPath", "=", "$ContextPath"}], ";", " ", 
  RowBox[{"$ContextPath", "=", 
   RowBox[{"{", "\"\<System`\>\"", "}"}]}], ";"}]], "Code",
 CellLabel->"In[1]:=",ExpressionUUID->"2de346e0-579a-3248-bfb9-5ae6d58cf7cd"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1. Statics: complete sector eigenpairs, entropies and IPR  \
\>", "Title",ExpressionUUID->"eeb3c4c2-15fa-0f44-a0fc-cb496b141f11"],

Cell[CellGroupData[{

Cell["  1.1 Definitions shared by all four chapters  ", "Subsection",ExpressionUUID->"8b54c920-84dc-7843-aa69-036ff7e011dc"],

Cell["\<\
  Initialization cells contain definitions only. They do not start a scan, \
diagonalize a model, choose an initial state, plot, or export. Their \
benchmark conventions are S=sigma/2, hbar=1, bit 0=up, natural-log entropy, \
edge basis {00,01,10,11}. Both end bonds replace the usual XXZ end bonds.  \
\>", "Text",ExpressionUUID->"026b228b-10aa-6148-9eec-38473c5b3320"],

Cell["\<\
  H = J Sum[j=2,...,L-2](Sjx S(j+1)x + Sjy S(j+1)y + Delta Sjz S(j+1)z) + g \
(S1z S2z + S(L-1)z SLz). J and g have energy units. In the exchange case the \
spin-flip matrix element is g/2.  \
\>", "Text",ExpressionUUID->"f5635f6b-86fd-fb45-9cdd-73a211611dd7"],

Cell["\<\
  ZZ resolves sA, sB and mBulk first. Reflection R is compatible when sA=sB; \
RF is compatible when sA=-sB and mBulk=0. Symmetry partners retain separate \
data and share a static panel. Actual conditional-bulk charges are checked \
and added when compatible, including the two-site bulk Casimir at Delta=+/-1 \
with equal conditional fields. Each eigenvector in this basis has zero \
edges-versus-bulk entropy. At Delta=0 the Hamiltonian is free fermionic \
(conditional bulk for ZZ); the benchmark spin/spatial classification stays \
valid, with additional conserved mode occupations and possible degeneracies. \
It is not a classification of every integrability charge. No degenerate \
energy vectors are silently mixed or pooled across the listed sectors.  \
\>", "Text",ExpressionUUID->"3feeca1d-bd66-7a41-9052-c41c33ca7895"],

Cell[CellGroupData[{

Cell["  Utilities, spin operators and Hamiltonian guards  ", "Subsubsection",ExpressionUUID->"4a14eeba-ef4f-af41-bd0a-b0628f2d6231"],

Cell[" Stop the current cell if an input or validation fails . ", "Text",ExpressionUUID->"1ef48876-9046-7145-9faa-e99e1d379d41"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"check", "[", 
    RowBox[{"test_", ",", "message_"}], "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"!", 
      RowBox[{"TrueQ", "[", "test", "]"}]}], ",", 
     RowBox[{
      RowBox[{"Print", "[", 
       RowBox[{"Style", "[", 
        RowBox[{"message", ",", "Red"}], " ", "]"}], "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"realQ", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
    RowBox[{"NumberQ", "[", 
     RowBox[{"N", "[", "x", " ", "]"}], "]"}], " ", "&&", " ", 
    RowBox[{"TrueQ", "[", 
     RowBox[{
      RowBox[{"Im", "[", 
       RowBox[{"N", "[", "x", " ", "]"}], "]"}], "==", "0"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"id", "[", "n_", "]"}], " ", ":=", " ", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Band", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", "1"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxAbs", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Head", "[", "a", "]"}], "===", "SparseArray"}], ",", "\n", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"Abs", "[", 
         RowBox[{"a", "[", "\"\<NonzeroValues\>\"", "]"}], "]"}]}]}], "]"}], ",", 
     RowBox[{"Max", "[", 
      RowBox[{"0", ",", 
       RowBox[{"Sequence", "@@", 
        RowBox[{"Abs", "[", 
         RowBox[{"Flatten", "[", "a", " ", "]"}], "]"}]}]}], "]"}]}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"herm", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"a", "+", 
      RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], ")"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"ketRho", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"Outer", "[", 
    RowBox[{"Times", ",", "v", ",", 
     RowBox[{"Conjugate", "[", "v", " ", "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[2]:=",ExpressionUUID->"376a6826-fbee-6f43-b4ed-bb6acda83e89"],

Cell[" Embed a one-spin or nearest-neighbour operator . ", "Text",ExpressionUUID->"25e950ac-ad25-4e4c-8dc8-bc4e9c6ca93b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"siteOp", "[", 
    RowBox[{"a_", ",", "k_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]}], "]"}], ",", 
     RowBox[{"SparseArray", "[", "a", "]"}], ",", 
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"l", "-", "k"}], ")"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bondOp", "[", 
    RowBox[{"a_", ",", "b_", ",", "k_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", "\n", " ", 
    RowBox[{
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"k", "-", "1"}], ")"}]}], "]"}], ",", 
     RowBox[{"SparseArray", "[", "a", "]"}], ",", 
     RowBox[{"SparseArray", "[", "b", "]"}], ",", 
     RowBox[{"id", "[", 
      RowBox[{"2", "^", 
       RowBox[{"(", 
        RowBox[{"l", "-", "k", "-", "1"}], ")"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[8]:=",ExpressionUUID->"e0adbcf6-f2b1-0f43-b71c-2f371e33d402"],

Cell["\<\
 Reject Hamiltonians that the real, magnetization-block solver cannot \
represent . \
\>", "Text",ExpressionUUID->"40dc99c6-ebe0-fd44-bab7-6be7cc9552c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"u1Check", "[", 
    RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "nd", ",", "off", ",", 
       "scale", ",", "leak"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "a", "]"}], "==", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "l"}], ",", 
           RowBox[{"2", "^", "l"}]}], "}"}]}], 
        ",", "\"\<Hamiltonian dimensions do not match L.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"nd", "=", 
       RowBox[{"Total", " ", "/@", " ", 
        RowBox[{"IntegerDigits", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "]"}], ",", "2", ",", 
          "l"}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"off", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Most", "[", 
          RowBox[{"ArrayRules", "[", "a", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"nd", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "1"}], "]"}], "]"}], "]"}], "]"}], "!=", 
           RowBox[{"nd", "[", 
            RowBox[{"[", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], "]"}]}], "&"}]}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"leak", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"off", "===", 
          RowBox[{"{", "}"}]}], ",", "0.", ",", 
         RowBox[{"Max", "[", 
          RowBox[{"Abs", "[", 
           RowBox[{"Last", " ", "/@", " ", "off"}], "]"}], "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"leak", "<=", 
         RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
        "  ", "\"\<H mixes total-Sz sectors. This solver would drop matrix \
elements. Use a solver for the surviving symmetries or full ED.\>\""}], "]"}],
       ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<MaxOffBlockElement\>\"", "->", "leak"}], ",", 
        RowBox[{"\"\<Scale\>\"", "->", "scale"}], ",", 
        RowBox[{"\"\<RelativeLeakage\>\"", "->", 
         RowBox[{"leak", "/", "scale"}]}], ",", 
        RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"realSectorCheck", "[", 
    RowBox[{"h_", ",", "l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"SparseArray", "[", "h", "]"}]}], ",", "u", ",", "scale"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"u", "=", 
       RowBox[{"u1Check", "[", 
        RowBox[{"a", ",", "l", ",", "tol"}], "]"}]}], ";", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{"a", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"a", "-", 
           RowBox[{"ConjugateTranspose", "[", "a", "]"}]}], "]"}], "<=", 
         RowBox[{"tol", " ", "scale"}]}], 
        ",", "\"\<H must be Hermitian before block diagonalization.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"Im", "[", "a", "]"}], "]"}], "<=", 
         RowBox[{"tol", " ", "scale"}]}], ",", "\n", 
        "  ", "\"\<The legacy fixSign solver requires a real Hamiltonian. \
Complex Hermitian models need phase-preserving eigenvectors.\>\""}], "]"}], ";",
       "\n", " ", "u"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[10]:=",ExpressionUUID->"456687c0-da85-2441-970a-797a68d3cdd7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Partial traces, entropies and two-qubit entanglement  ", \
"Subsubsection",ExpressionUUID->"111d9b13-f425-0545-9750-b0d47a6137bd"],

Cell[" Coefficient matrix for a chosen set of sites; rho=A . A\[Dagger] . ", \
"Text",ExpressionUUID->"ad84f975-f1d4-454f-bf07-debea1ec6dee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"partitionFactor", "[", 
    RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{
         RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ",", "rest"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"rest", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", "l", "]"}], ",", "sites"}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{"fac", ",", 
            RowBox[{"Join", "[", 
             RowBox[{
              RowBox[{"ConstantArray", "[", 
               RowBox[{"2", ",", "l"}], "]"}], ",", 
              RowBox[{"{", "r", "}"}]}], "]"}]}], "]"}], ",", "\n", "  ", 
          RowBox[{"Ordering", "[", 
           RowBox[{"Join", "[", 
            RowBox[{"sites", ",", "rest", ",", 
             RowBox[{"{", 
              RowBox[{"l", "+", "1"}], "}"}]}], "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"2", "^", 
           RowBox[{"Length", "[", "sites", "]"}]}], ",", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"Length", "[", "rest", "]"}]}], " ", "r"}]}], "}"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedState", "[", 
    RowBox[{"fac_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"partitionFactor", "[", 
        RowBox[{"fac", ",", "sites", ",", "l"}], "]"}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"a", " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"reducedKet", "[", 
    RowBox[{"v_", ",", "sites_List", ",", "l_Integer"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"reducedState", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", "v", "}"}], "]"}], ",", "sites", ",", "l"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeRho", "[", 
    RowBox[{"v_", ",", "l_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"reducedKet", "[", 
    RowBox[{"v", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[12]:=",ExpressionUUID->"d7916e31-23f7-3648-99e0-9a88acd181e2"],

Cell[" Single-edge reductions, in edge basis {00,01,10,11} . ", "Text",ExpressionUUID->"4e8f7751-02f3-0b4a-af6a-36e1226e8b30"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"traceB", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "3"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "1"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "2"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "3"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "4"}], "]"}], "]"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"traceA", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "3"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"3", ",", "4"}], "]"}], "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "1"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "3"}], "]"}], "]"}]}], ",", 
       RowBox[{
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"2", ",", "2"}], "]"}], "]"}], "+", 
        RowBox[{"r", "[", 
         RowBox[{"[", 
          RowBox[{"4", ",", "4"}], "]"}], "]"}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[16]:=",ExpressionUUID->"703561ec-7d85-1447-b034-53fd9290ad3a"],

Cell[" Von Neumann entropy, natural logarithms . ", "Text",ExpressionUUID->"7a4d80b8-4d69-764d-8214-0b7b07ade290"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"entropy", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"e", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"N", "[", 
             RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], "}"}], ",", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"e", "===", 
         RowBox[{"{", "}"}]}], ",", "0.", ",", 
        RowBox[{"-", 
         RowBox[{"Total", "[", 
          RowBox[{"e", " ", 
           RowBox[{"Log", "[", "e", " ", "]"}]}], "]"}]}]}], "]"}]}], "]"}]}],
    ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Pure", "-", 
     RowBox[{"state", " ", "entropy", " ", "for", " ", "sites", " ", "1"}]}], 
    ",", "...", ",", 
    RowBox[{"floor", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"L", "/", "2"}], ")"}], "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"halfEntropy", "[", 
     RowBox[{"v_", ",", "l_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "p", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"p", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"SingularValueList", "[", 
            RowBox[{"ArrayReshape", "[", 
             RowBox[{"v", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", "^", 
                 RowBox[{"Floor", "[", 
                  RowBox[{"l", "/", "2"}], "]"}]}], ",", 
                RowBox[{"2", "^", 
                 RowBox[{"Ceiling", "[", 
                  RowBox[{"l", "/", "2"}], "]"}]}]}], "}"}]}], "]"}], "]"}], "^",
            "2"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"p", "===", 
          RowBox[{"{", "}"}]}], ",", "0.", ",", 
         RowBox[{"-", 
          RowBox[{"Total", "[", 
           RowBox[{"p", " ", 
            RowBox[{"Log", "[", "p", " ", "]"}]}], "]"}]}]}], "]"}]}]}], 
     "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Pure", "-", 
    RowBox[{
    "state", " ", "entanglement", " ", "of", " ", "both", " ", "edges", " ", 
     "together", " ", "versus", " ", "the", " ", 
     RowBox[{"middle", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeEntropy", "[", 
    RowBox[{"v_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"entropy", "[", 
    RowBox[{"edgeRho", "[", 
     RowBox[{"v", ",", "l"}], " ", "]"}], "]"}]}], ";"}], "\n"}], "Code",
