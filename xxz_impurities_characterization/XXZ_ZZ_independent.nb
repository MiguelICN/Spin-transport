Cell[CellGroupData[{

Cell["  4.A.2 Initial factor and occupied-sector diagonalization  ", \
"Subsection",ExpressionUUID->"44f652ce-1850-064b-8ed1-76fc1cb06b7e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAModelUsed", "=", 
   RowBox[{"regimeModel", "[", "qstAModel", "]"}]}], ";", 
  RowBox[{"qstABulkUsed", "=", "qstABulk"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstASettingsUsed", "=", "qstASettings"}], ";", 
  RowBox[{"qstABulkNoteUsed", "=", "qstABulkNote"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstABulkFactor", "=", 
   RowBox[{"qstBulkFactor", "[", 
    RowBox[{"qstAModelUsed", ",", "qstABulkUsed", ",", 
     RowBox[{"qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstAFactor", "=", 
   RowBox[{"joinStates", "[", 
    RowBox[{
     RowBox[{"stateFactor", "[", 
      RowBox[{"edgeF1Ket", ",", "4", ",", 
       RowBox[{
       "qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}],
      ",", "qstABulkFactor", ",", 
     RowBox[{"qstAModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstAInitialRhoAB", "=", 
   RowBox[{"reducedState", "[", 
    RowBox[{"qstAFactor", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"qstAModelUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"qstAModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstAGlobalPurity", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{"MatrixPower", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "qstAFactor", "]"}], " ", ".", " ",
         "qstAFactor"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qstASetupSeconds", ",", "qstAEngine"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"occupiedEngine", "[", 
     RowBox[{"qstAModelUsed", ",", "qstAFactor", ",", "\n", " ", 
      RowBox[{"qstASettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
      RowBox[{"qstASettingsUsed", "[", "\"\<SectorCut\>\"", "]"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Discarded weight: \>\"", ",", 
    RowBox[{"qstAEngine", "[", "\"\<DiscardedWeight\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{"qstAEngine", "[", "\"\<SectorWeights\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"c8e4f891-0c4c-6248-a095-\
fa8cc461aa9a"]
}, Open  ]],

