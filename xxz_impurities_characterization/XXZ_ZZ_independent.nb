Cell[BoxData[{
 RowBox[{
  RowBox[{"texReady", "=", "Automatic"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tex", "[", 
    RowBox[{"s_String", ",", 
     RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "g", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"texReady", "===", "Automatic"}], ",", 
        RowBox[{"texReady", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], ",",
             "False"}], "]"}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", "texReady", "]"}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"s", ",", 
               RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", "$Failed"}], 
            "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
           RowBox[{"Return", "[", "g", "]"}]}], "]"}], ";", 
         RowBox[{"texReady", "=", "False"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"s", ",", "Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "size"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"resultRoot", "[", "]"}], " ", ":=", " ", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_edge_regimes_results\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"regimeCaption", "[", 
     RowBox[{"p_", ",", 
      RowBox[{"extra_", ":", "\"\<\>\""}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"tex", "[", 
         RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"{", "\n", " ", 
          RowBox[{
           RowBox[{"\"\<\\\\mathrm{ZZ}:\\\\quad L=\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], 
            "<>", "\"\<;\\\\quad J=\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}], "<>", "\n", 
            " ", "\"\<;\\\\quad g=\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"p", "[", "\"\<g\>\"", "]"}], "]"}], 
            "<>", "\"\<;\\\\quad \\\\Delta=\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}]}], ",", "\n", 
           " ", "\"\<M=\\\\{2,\\\\ldots,L-1\\\\},\\\\quad AB=\\\\{1,L\\\\},\\\
\\quad S^a=\\\\sigma^a/2,\\\\quad \\\\hbar=1\>\"", ",", "extra"}], "}"}], 
         ",", "\"\<\>\""}], "]"}]}], ",", 
      RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorTex", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"sectorLabel", "[", 
    RowBox[{"Association", "[", 
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Switch", "[", 
          RowBox[{
          "#1", ",", "\n", " ", "\"\<sA\>\"", ",", "\"\<s_A\>\"", 
           ",", "\"\<sB\>\"", ",", "\"\<s_B\>\"", ",", "\"\<mBulk\>\"", 
           ",", "\"\<m_M\>\"", ",", "\"\<SBulk\>\"", ",", "\"\<S_M\>\"", 
           ",", "\"\<StaggeredSBulk\>\"", ",", "\"\<S_{M,\\\\rm stag}\>\"", ",",
            "_", ",", "#1"}], "]"}], "->", "#2"}], "&"}], ",", "a"}], "]"}], 
     "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"exportBundle", "[", 
    RowBox[{"root_", ",", "tag_", ",", "plots_Association", ",", "data_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
