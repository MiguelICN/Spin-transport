Cell[CellGroupData[{

Cell["\<\
  4.B.1 Texturizing power of the bulk-induced channel \[LongDash] editable \
inputs  \
\>", "Subsection",ExpressionUUID->"7f854d93-35d7-9e44-b9e1-4bc96813b82a"],

Cell["\<\
  Phi_t(X)=Tr_E[U_t (X tensor rhoE) U_t dagger] is constructed without an \
edge input. f1 is used only afterward to measure texturizing power. \
OmegaTF=1-Sigma[Phi(f1)]/4 and OmegaR=-log(Sigma[Phi(f1)]/4). The response \
operator R=4 Phi_dual(f1) satisfies Sigma[Phi(rho)]=Tr[R rho]. A free channel \
fixes f1; a texture-preserving channel has R=4 f1. These are tested by \
separate distances. The three Sigma routes are direct output, \
(ones.S.ones)/4, and grandSum[Choi]/4; Choi is unnormalized with trace 4. \
Their agreement tests indexing conventions, not independent channel physics. \
For ZZ, ResponseOperator=Transpose[Gamma], OutputF1=Gamma/4, and \
OmegaTF=3/4-Sum[Re Gamma_ij,i<j]/8 are also checked. Thus ZZ texture is a \
functional of the six overlaps already underlying the dephasing channel.  \
\>", "Text",ExpressionUUID->"db2313a0-0fde-c24e-aaad-11efdf7ec84a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBBulk", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
     RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBBulkNote", "=", "\"\<Neel bulk, first bit 0\>\""}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternatives", ":", " ", 
      RowBox[{
      "replace", " ", "the", " ", "one", " ", "assignment", " ", "above", " ",
        "and", " ", "its", " ", 
       RowBox[{"note", ".", "\n", " ", "qstBBulk"}]}]}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Polarized\>\""}], ",", 
       RowBox[{"\"\<Bit\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "planar", " ", "*)"}], "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "4"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "conical", " ", "*)"}], "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<PolarHelix\>\""}], ",", 
       RowBox[{"\"\<ThetaList\>\"", "->", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "6"}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"Pi", "/", "6"}]}], ",", 
           RowBox[{
            RowBox[{"qstBModel", "[", "\"\<L\>\"", "]"}], "-", "3"}]}], "]"}],
          "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<PhiList\>\"", "->", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"qstBModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], 
         "]"}]}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<User\>\""}], ",", 
       RowBox[{"\"\<State\>\"", "->", "yourBulkDensityMatrix"}]}], "|>"}]}], ";",
     "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{"\"\<Type\>\"", "->", "\"\<InfiniteT\>\""}], "|>"}]}], ";", 
    "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Gibbs\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Typical\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
       RowBox[{"\"\<Samples\>\"", "->", "4"}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{
    "A", " ", "polar", " ", "helix", " ", "is", " ", "specified", " ", "by", " ",
      "the", " ", "actual", " ", "local", " ", "angles"}], ";", " ", 
    RowBox[{
     RowBox[{"no", " ", "exact"}], "-", 
     RowBox[{"eigenstate", " ", "condition", " ", "is", " ", 
      RowBox[{"assumed", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  "\n"}], "\n"}], "Code",ExpressionUUID->"3455520c-61e8-8f46-80e5-\
819447562203"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<EDTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<ValidationTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", 
      RowBox[{"\"\<SectorCut\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<KrausTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "KrausTolerance", " ", "is", " ", "used", " ", "only", " ", "by", " ", 
     "B"}], ",", " ", 
    RowBox[{
    "retained", " ", "in", " ", "both", " ", "snapshots", " ", "for", " ", 
     "optional", " ", "exact", " ", 
     RowBox[{"A", "/", "B"}], " ", 
     RowBox[{"comparison", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBParallel", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Enabled\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<Kernels\>\"", "->", "12"}], ",", 
      RowBox[{"\"\<ChunkSize\>\"", "->", "16"}], ",", 
      RowBox[{"\"\<MemoryMB\>\"", "->", "512"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Exchange", " ", "B", " ", "with", " ", "a", " ", "full"}], "-", 
       RowBox[{"rank", " ", "bulk", " ", "at", " ", "total", " ", "L"}]}], "=", 
      RowBox[{
       RowBox[{"12", " ", "requires", " ", "MemoryMB"}], ">=", 
       RowBox[{
       "1024", "\n", " ", "for", " ", "ONE", " ", "serial", " ", 
        "slice"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "floor", " ", "multiplies", " ", "by", " ", "the", " ", 
       "number", " ", "of", " ", "active", " ", 
       RowBox[{"workers", ".", "\n", " ", "This"}], " ", "transient"}], "-", 
      RowBox[{
      "factor", " ", "budget", " ", "excludes", " ", "eigensystems"}]}]}], ",",
     " ", 
    RowBox[{"records", " ", "and", " ", "worker", " ", 
     RowBox[{"copies", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"qstBComputeInfiniteTime", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBClusterTolerances", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBRandomTests", "=", "20"}], ";", 
  RowBox[{"qstBRandomSeed", "=", "2026"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBExportLogPlots", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBRunLabel", "=", "\"\<ZZ_texturizing_power\>\""}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"ae202559-8337-e541-9664-\
a7a612c2890e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  4.B.2 Independent bulk-only map construction  ", "Subsection",ExpressionUUID->"fb2bd3ec-a121-104e-89d4-9456493e2c01"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBModelUsed", "=", 
   RowBox[{"regimeModel", "[", "qstBModel", "]"}]}], ";", 
  RowBox[{"qstBBulkUsed", "=", "qstBBulk"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBSettingsUsed", "=", "qstBSettings"}], ";", 
  RowBox[{"qstBBulkNoteUsed", "=", "qstBBulkNote"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBBulkFactor", "=", 
   RowBox[{"qstBulkFactor", "[", 
    RowBox[{"qstBModelUsed", ",", "qstBBulkUsed", ",", 
     RowBox[{"qstBSettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qstBSetupSeconds", ",", "qstBEngine"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"mapBuild", "[", 
     RowBox[{"qstBModelUsed", ",", "qstBBulkFactor", ",", "\n", " ", 
      RowBox[{"qstBSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
      RowBox[{"qstBSettingsUsed", "[", "\"\<SectorCut\>\"", "]"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Discarded weight: \>\"", ",", 
    RowBox[{"qstBEngine", "[", "\"\<DiscardedWeight\>\"", "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{"qstBEngine", "[", "\"\<SectorWeights\>\"", "]"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"6fd5467e-1743-2a45-8526-\
cef1f791d672"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.B.3 Evolution and records \[LongDash] rerun here after changing only the \
time grid  \
\>", "Subsection",ExpressionUUID->"bfef106f-fac2-924f-814d-97ab121312f9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBTimeUsed", "=", "qstBTime"}], ";", 
  RowBox[{"qstBTimes", "=", 
   RowBox[{"timeGrid", "[", "qstBTimeUsed", "]"}]}], ";", 
  RowBox[{"qstBParallelUsed", "=", "qstBParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBUsed", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Model\>\"", "->", "qstBModelUsed"}], ",", 
     RowBox[{"\"\<BulkSpecification\>\"", "->", "qstBBulkUsed"}], ",", 
     RowBox[{"\"\<BulkFactor\>\"", "->", "qstBBulkFactor"}], ",", "\n", " ", 
     RowBox[{"\"\<BulkNote\>\"", "->", "qstBBulkNoteUsed"}], ",", 
     RowBox[{"\"\<Settings\>\"", "->", "qstBSettingsUsed"}], ",", 
     RowBox[{"\"\<Parallel\>\"", "->", "qstBParallelUsed"}], ",", "\n", " ", 
     RowBox[{"\"\<TimeSettings\>\"", "->", "qstBTimeUsed"}], ",", 
     RowBox[{"\"\<Times\>\"", "->", "qstBTimes"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"qstBSeconds", ",", "qstBRecords"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"qstMapRecords", "[", 
     RowBox[{
     "qstBEngine", ",", "qstBTimes", ",", "qstBSettingsUsed", ",", 
      "qstBParallelUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBWindowR", "=", 
   RowBox[{"qstWindowMean", "[", 
    RowBox[{"qstBRecords", ",", "\"\<OmegaR\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBInfiniteTime", "=", 
   RowBox[{"Missing", "[", "\"\<NotComputedForThisRun\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBConsistency", "=", 
   RowBox[{"Missing", "[", "\"\<NotCompared\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<SigmaOutput\>\"", 
          ",", "\"\<OmegaTF\>\"", ",", "\"\<OmegaR\>\""}], "}"}]}], "]"}], 
      "&"}], " ", "/@", " ", 
     RowBox[{"Take", "[", 
      RowBox[{"qstBRecords", ",", 
       RowBox[{"UpTo", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"bc847080-3591-7346-852a-\
483b6ea999b7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  4.B.4 Validation  ", "Subsection",ExpressionUUID->"857a7aff-1c04-f043-a814-4d60aaebddcd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBChecks", "=", 
   RowBox[{"qstMapChecks", "[", 
    RowBox[{
    "qstBEngine", ",", "qstBBulkFactor", ",", "qstBRecords", ",", 
     "qstBSettingsUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", "qstBChecks", "]"}], "]"}], ";"}], "\n"}], "Code",E\
xpressionUUID->"f481bc5d-d780-3e49-9509-aa57b63b47cb"],

Cell["\<\
  The checks include t=0, physical bounds or CP/TP, batched versus \
single-time endpoints, and full-chain MatrixExp references at \
first/middle/last times for L<=6, built from regimeHamiltonian. These test \
the evolution/partial-trace pipeline, not independent Hamiltonian assembly. \
Above L=6 that expensive reference is explicitly marked SkippedAboveL. Setup \
audits check invariant blocks before any ED. Negative grand sums within \
roundoff are retained and their rugosity is marked invalid, never clipped.  \
\>", "Text",ExpressionUUID->"5f45e66f-dd27-4549-9d94-4cac482d594c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBRandomCheck", "=", 
   RowBox[{"qstRandomResponseCheck", "[", 
    RowBox[{"qstBRecords", ",", "qstBRandomTests", ",", "qstBRandomSeed", ",", 
     RowBox[{"qstBSettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", "qstBRandomCheck", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"d923e89d-cd08-f847-b71e-\
6776843b879f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.B.5 Optional infinite-time values and sampled-window rugosity  \
\>", "Subsection",ExpressionUUID->"46440a4f-bb3b-6646-9ae9-70ee925efcf9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBInfiniteTime", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "qstBComputeInfiniteTime", "]"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"qstAverageChannel", "[", 
        RowBox[{"qstBEngine", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
      "qstBClusterTolerances"}], ",", 
     RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBWindowR", "=", 
   RowBox[{"qstWindowMean", "[", 
    RowBox[{"qstBRecords", ",", "\"\<OmegaR\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"qstBInfiniteTime", ",", "qstBWindowR"}], "}"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"2fe0ad74-bda6-a343-8904-\
a34e31dc9ed2"],

Cell["\<\
  Energy clusters include all evolved sectors together (ZZ: all four edge \
configurations), preserving coherences within each degenerate cluster. \
Compare the results at all cluster tolerances. The sampled-window rugosity \
uses trapezoidal integration in physical time, including on a logarithmic \
grid. A sampled zero makes this estimate \
Missing[SingularSamplesRequireQuadrature], because an isolated logarithmic \
singularity need not have an infinite integral. It is never replaced by the \
rugosity of an averaged state.  \
\>", "Text",ExpressionUUID->"488897ca-c72a-af4b-a8a0-d751508aa40a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.B.6 Plots from the settings attached to the computed records  \
\>", "Subsection",ExpressionUUID->"cd58f97d-0b83-0948-901b-ba603ac6b4a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"chopRecordsInPlace", "[", 
    RowBox[{"qstBRecords", ",", "recordChopTolerance"}], "]"}], ";"}], "\n", 
  "\n", "\n", "\n"}]], "Code",ExpressionUUID->"92bbe0a5-cb54-cf46-9fd6-\
424783808e6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBPlots", "=", 
   RowBox[{"texturizingPanels", "[", 
    RowBox[{"qstBRecords", ",", "qstBUsed", ",", "False"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "qstBExportLogPlots", "]"}], ",", 
    RowBox[{"qstBPlots", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"qstBPlots", ",", "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], "&"}],
           ",", 
          RowBox[{"texturizingPanels", "[", 
           RowBox[{"qstBRecords", ",", "qstBUsed", ",", "True"}], "]"}]}], 
         "]"}], "]"}]}], "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"qstBPlots", "[", "\"\<ThreeRoutes\>\"", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"e0ca6c8c-bd81-4647-bace-\
2e7ac3a4e8cb"],

Cell["\<\
  Every curve uses small unjoined markers. Triangle marks on an annotated \
upper rail identify Infinity or invalid rugosity values, with their actual \
times and values stated below the panel. Log-time plots exclude t=0 \
explicitly; only the horizontal axis is logarithmic. Coherence indices \
0,1,2,3 mean 00,01,10,11. Extreme response vectors inside a degenerate \
eigenspace are not unique; their individual f1 overlaps depend on the \
returned basis.  \
\>", "Text",ExpressionUUID->"4f0f0272-a97d-ea46-94d6-910f541f412b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  4.B.7 Export this run  ", "Subsection",ExpressionUUID->"be3a6d0d-1c9b-5d43-ab98-c19424cb1446"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBData", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Used\>\"", "->", "qstBUsed"}], ",", 
     RowBox[{"\"\<Engine\>\"", "->", "qstBEngine"}], ",", 
     RowBox[{"\"\<Records\>\"", "->", "qstBRecords"}], ",", 
     RowBox[{"\"\<Checks\>\"", "->", "qstBChecks"}], ",", "\n", " ", 
     RowBox[{"\"\<SectorWeights\>\"", "->", 
      RowBox[{"qstBEngine", "[", "\"\<SectorWeights\>\"", "]"}]}], ",", 
     RowBox[{"\"\<EvolvedBlockLabels\>\"", "->", 
      RowBox[{"Lookup", "[", 
       RowBox[{
        RowBox[{"qstBEngine", "[", "\"\<Sectors\>\"", "]"}], 
        ",", "\"\<Labels\>\""}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<SetupSeconds\>\"", "->", "qstBSetupSeconds"}], ",", 
     RowBox[{"\"\<EvolutionSeconds\>\"", "->", "qstBSeconds"}], ",", "\n", 
     " ", 
     RowBox[{"\"\<WindowMeanR\>\"", "->", "qstBWindowR"}], ",", 
     RowBox[{"\"\<InfiniteTime\>\"", "->", "qstBInfiniteTime"}], ",", 
     RowBox[{"\"\<ConsistencyCheck\>\"", "->", "qstBConsistency"}], ",", "\n",
      " ", 
     RowBox[{"\"\<RandomResponseCheck\>\"", "->", "qstBRandomCheck"}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBDirectory", "=", 
   RowBox[{"qstExport", "[", 
    RowBox[{
    "qstBOutputRoot", ",", "qstBRunLabel", ",", "qstBPlots", ",", 
     "qstBData"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "qstBDirectory", "]"}], ";"}], "\n"}], "Code",Expressi\
onUUID->"f0a490f8-7f95-294d-a05e-4c1d0b6eac9d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.C Optional A/B consistency \[LongDash] evaluate only after both runs  \
\>", "Subsection",ExpressionUUID->"c8ca2c53-c809-c548-940b-586a509ccd4b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ValueQ", "[", "qstAUsed", "]"}], " ", "&&", " ", 
      RowBox[{"ValueQ", "[", "qstBUsed", "]"}], " ", "&&", " ", 
      RowBox[{"ValueQ", "[", "qstARecords", "]"}], " ", "&&", " ", 
      RowBox[{"ValueQ", "[", "qstBRecords", "]"}]}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"qstAConsistency", "=", 
       RowBox[{"qstBConsistency", "=", 
        RowBox[{"qstCompare", "[", 
         RowBox[{
         "qstAUsed", ",", "qstBUsed", ",", "qstARecords", ",", "qstBRecords", 
          ",", "\n", "  ", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{
            "qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}], ",", 
            RowBox[{
            "qstBSettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
           "]"}]}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"qstComparisonDirectory", "=", 
       RowBox[{"qstSaveComparison", "[", 
        RowBox[{
        "qstBOutputRoot", ",", "qstAUsed", ",", "qstBUsed", ",", 
         "qstAConsistency"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Print", "[", "qstAConsistency", "]"}], ";", 
      RowBox[{"Print", "[", "qstComparisonDirectory", "]"}]}], ",", "\n", " ", 
     RowBox[{
     "Print", "[", "\"\<A/B comparison skipped: both independent sections \
must be computed first.\>\"", "]"}]}], "]"}], ";"}], "\n"}]], "Code",Expressio\
nUUID->"7e116b31-fb32-c742-8acb-ef3294cace42"],

Cell["\<\
  The optional comparison checks full edge matrices and grand sums for \
identical computed model, bulk specification and factor, actual times and \
numerical tolerances. Parallel/batch settings may differ. It automatically \
saves a separate comparison bundle with both used snapshots under the B \
output parent, even if A and B were exported earlier. The earlier bundles \
retain NotCompared; the separate comparison is authoritative. No plots need \
to be re-exported.  \
\>", "Text",ExpressionUUID->"501539c3-6a75-ae4e-9521-0171b8dc312e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  4.D Reevaluation guide  ", "Subsection",ExpressionUUID->"fa4d2c94-11e0-2b45-a7bb-5fd2fb747514"],

Cell["\<\
  Model or bulk state (A): A.2 initial factor onward. Model or bulk state \
(B): B.2 map construction onward. ED/validation/SectorCut tolerances: the \
corresponding construction onward. Time grid only: that section's evolution, \
validation, optional averages, plots and export; changing only the fine grid \
requires only its fine evolution/checks/plots/export. Parallel/batch \
settings: evolution onward. Cluster tolerances: long-time cells only (then \
export to save). Number or seed of random inputs (B): response-operator check \
only (then export). Plot style or labels: plots and export only. BulkNote \
used in captions is snapshotted at construction; to change a caption \
annotation without recomputation, edit the BulkNote entry in the used \
snapshot explicitly. No model variable is read by plotting. Definitions are \
evaluated once; no ResetKernels or Global clear is used.  \
\>", "Text",ExpressionUUID->"65efc327-4cce-764e-97ed-a06b9cc06d5e"],

