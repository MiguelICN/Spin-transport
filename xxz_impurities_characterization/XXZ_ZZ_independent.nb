             RowBox[{"signalMatrix", "[", 
              RowBox[{"s", ",", 
               RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}]}], "]"}], ",", 
             "2"}], "]"}]}], ",", 
          RowBox[{"\"\<RetentionA\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"retentionMatrix", "[", 
              RowBox[{"s", ",", 
               RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}]}], "]"}], ",", 
             "2"}], "]"}]}]}], "|>"}], ",", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{"\"\<MinDephasingEigenvalue\>\"", "->", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"herm", "[", "f", "]"}], "]"}], "]"}], "]"}], "/", 
           "4"}]}], "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chTrajectory", "[", 
     RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", "probes_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "prepared", ",", "recs", ",", "raw", ",", "zero", ",", "dist", ",", 
        "blp", ",", "dt", ",", "rhp", ",", "margin"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", " ", 
          RowBox[{"And", "@@", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], 
            "]"}]}]}], ",", "\"\<Channel times must increase.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], ">", 
           "0"}], " ", "&&", " ", 
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], "]"}], " ", "&&",
           " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], ">", "0"}]}], ",",
          "\n", " ", "\"\<Invalid channel diagnostic tolerances.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}], ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}], ",", "2", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{"MatrixQ", " ", "/@", " ", 
            RowBox[{"Lookup", "[", 
             RowBox[{"probes", ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Rho1\>\"", ",", "\"\<Rho2\>\"", 
                ",", "\"\<RhoB\>\""}], "}"}]}], "]"}]}], ")"}]}], 
         ",", "\"\<Channel probes must be density matrices.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"prepared", "=", 
        RowBox[{"chPrepare", "[", 
         RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}]}], ";", 
       RowBox[{"zero", "=", 
        RowBox[{"First", "[", 
         RowBox[{"chSeries", "[", 
          RowBox[{"eng", ",", 
           RowBox[{"{", "0.", "}"}], ",", "cfg", ",", "prepared"}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
            RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
         ",", "\"\<Channel t=0 reconstruction failed.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"recs", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"raw", "=", 
              RowBox[{"chSeries", "[", 
               RowBox[{"eng", ",", "tc", ",", "cfg", ",", "prepared"}], 
               "]"}]}], ";", "\n", "  ", 
             RowBox[{"MapThread", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"chRecord", "[", 
                 RowBox[{"#1", ",", "#2", ",", "cfg", ",", "probes"}], "]"}], 
                "&"}], ",", 
               RowBox[{"{", 
                RowBox[{"tc", ",", "raw"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"tc", ",", 
              RowBox[{"Partition", "[", 
               RowBox[{"times", ",", 
                RowBox[{"UpTo", "[", 
                 RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
               "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"recs", ",", "\"\<TPError\>\""}], "]"}], "]"}], "<", 
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ", "&&",
           " ", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"recs", ",", "\"\<MinChoiEigenvalue\>\""}], "]"}], "]"}],
            ">=", 
           RowBox[{"-", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}], 
         ",", "\"\<Channel CP/TP validation failed.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"dist", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"recs", ",", "\"\<BLPDistance\>\""}], "]"}]}], ";", 
       RowBox[{"blp", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Accumulate", "[", 
           RowBox[{"Clip", "[", 
            RowBox[{
             RowBox[{"Differences", "[", "dist", "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], ",", 
          "0."}], "]"}]}], ";", "\n", " ", 
       RowBox[{"recs", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"dt", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", "==", "1"}], ",", 
              RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
              RowBox[{
               RowBox[{"times", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "-", 
               RowBox[{"times", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", 
           RowBox[{"margin", "=", 
            RowBox[{"Missing", "[", "\"\<NotZZ\>\"", "]"}]}], ";", "\n", "  ", 
           RowBox[{"rhp", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"k", "==", "1"}], ",", 
              RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"recs", "[", 
                   RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                  "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
                 RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], 
                ",", 
                RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"margin", "=", 
                   RowBox[{"chZzIntermediateMinEig", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}], ",", 
                    RowBox[{
                    "cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], 
                    "]"}]}], ";", "\n", " ", 
                  RowBox[{"Max", "[", 
                   RowBox[{"0.", ",", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"traceNormHermitian", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}], "/", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<DephasingFactors\>\"", "]"}]}], "]"}], "/", 
                    "4"}], "-", "1"}]}], "]"}]}], ")"}]}], "]"}]}], "]"}]}], ";",
            "\n", "  ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"recs", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<BLPAccumulated\>\"", "->", 
                RowBox[{"blp", "[", 
                 RowBox[{"[", "k", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<RHPFiniteStep\>\"", "->", "rhp"}], ",", "\n", 
               "  ", 
               RowBox[{"\"\<RHPFiniteStepRate\>\"", "->", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"MissingQ", "[", "rhp", "]"}], ",", "rhp", ",", 
                  RowBox[{"rhp", "/", "dt"}]}], "]"}]}], ",", 
               
               RowBox[{"\"\<IntermediateSupportMinimum\>\"", "->", 
                "margin"}]}], "|>"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "recs", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Records\>\"", "->", "recs"}], ",", 
         RowBox[{"\"\<Method\>\"", "->", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"prepared", ",", 
            RowBox[{"{", "\"\<Overlaps\>\"", "}"}]}], "]"}]}], ",", 
         RowBox[{"\"\<InitialTransferError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
            RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}]}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",E\
