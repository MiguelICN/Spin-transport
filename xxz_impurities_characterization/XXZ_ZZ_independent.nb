Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"selectedStaticSector", "[", 
    RowBox[{"point_", ",", "labels_Association"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "ss", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"ss", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"point", "[", "\"\<Sectors\>\"", "]"}], ",", 
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", 
           RowBox[{"And", "@@", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Lookup", "[", 
                 RowBox[{
                  RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "#1", ",", 
                  RowBox[{"Missing", "[", "]"}]}], "]"}], "==", "#2"}], "&"}],
               ",", "labels"}], "]"}]}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "ss", "]"}], "==", "1"}], 
        ",", "\"\<Sector selector must identify exactly one resolved sector \
at each point; include every required refinement label.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"First", "[", "ss", "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorDOS", "[", 
    RowBox[{"e0_List", ",", 
     RowBox[{"window_", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"1", "/", "4"}], ",", 
        RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
     RowBox[{"bins_", ":", "30"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", "=", 
        RowBox[{"Sort", "[", "e0", "]"}]}], ",", "d", ",", "lo", ",", "hi", ",",
        "pad", ",", "edges", ",", "counts", ",", "heights", ",", "cdf"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "e", "]"}], ">=", "1"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"e", ",", "realQ"}], "]"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", "bins", "]"}], " ", "&&", " ", 
         RowBox[{"bins", ">=", "1"}], " ", "&&", "\n", "  ", 
         RowBox[{
          RowBox[{"Length", "[", "window", "]"}], "==", "2"}], " ", "&&", " ", 
         RowBox[{"0", "<=", 
          RowBox[{"window", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<", 
          RowBox[{"window", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}]}], 
        ",", "\"\<Invalid DOS settings.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"d", "=", 
       RowBox[{"Length", "[", "e", "]"}]}], ";", 
      RowBox[{"lo", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1", ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{
            RowBox[{"window", "[", 
             RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", "1"}]}], 
        "]"}]}], ";", 
      RowBox[{"hi", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"d", ",", 
         RowBox[{"Ceiling", "[", 
          RowBox[{
           RowBox[{"window", "[", 
            RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"pad", "=", 
       RowBox[{
        RowBox[{"10", "^", 
         RowBox[{"-", "8"}]}], " ", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"First", "[", "e", "]"}], "]"}], ",", 
          RowBox[{"Abs", "[", 
           RowBox[{"Last", "[", "e", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Last", "[", "e", "]"}], "-", 
           RowBox[{"First", "[", "e", "]"}]}]}], "]"}]}]}], ";", "\n", " ", 
      RowBox[{"edges", "=", 
       RowBox[{"Subdivide", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "e", "]"}], "-", "pad"}], ",", 
         RowBox[{
          RowBox[{"Last", "[", "e", "]"}], "+", "pad"}], ",", "bins"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"counts", "=", 
       RowBox[{"Last", "[", 
        RowBox[{"HistogramList", "[", 
         RowBox[{"e", ",", 
          RowBox[{"{", "edges", "}"}], ",", "\"\<Count\>\""}], "]"}], "]"}]}],
       ";", 
      RowBox[{"heights", "=", 
       RowBox[{"counts", "/", 
        RowBox[{"(", 
         RowBox[{"d", " ", 
          RowBox[{"Differences", "[", "edges", "]"}]}], ")"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"cdf", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}], "/", "d"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{"k", "/", "d"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "d"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Energies\>\"", "->", "e"}], ",", 
        RowBox[{"\"\<Dimension\>\"", "->", "d"}], ",", 
        RowBox[{"\"\<BinEdges\>\"", "->", "edges"}], ",", 
        RowBox[{"\"\<BinCounts\>\"", "->", "counts"}], ",", 
        RowBox[{"\"\<Density\>\"", "->", "heights"}], ",", "\n", "  ", 
        RowBox[{"\"\<CDF\>\"", "->", "cdf"}], ",", 
        RowBox[{"\"\<RankWindow\>\"", "->", "window"}], ",", 
        RowBox[{"\"\<WindowRanks\>\"", "->", 
         RowBox[{"{", 
          RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
        RowBox[{"\"\<WindowEnergies\>\"", "->", 
         RowBox[{"e", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"lo", ",", "hi"}], "}"}], "]"}], "]"}]}], ",", "\n", "  ", 
        RowBox[{"\"\<DensityIntegral\>\"", "->", 
         RowBox[{"Total", "[", 
          RowBox[{"heights", " ", 
           RowBox[{"Differences", "[", "edges", "]"}]}], "]"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dosPanels", "[", 
    RowBox[{"dos_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"edges", "=", 
        RowBox[{"dos", "[", "\"\<BinEdges\>\"", "]"}]}], ",", 
       RowBox[{"rho", "=", 
        RowBox[{"dos", "[", "\"\<Density\>\"", "]"}]}], ",", "hist", ",", 
