 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mapTrajectory", "[", 
     RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", "probes_"}], "]"}], 
    " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "recs", ",", "dist", ",", "rhp", ",", "dt", ",", "previous", ",", 
        "s0"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
          RowBox[{"And", "@@", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], 
            "]"}]}]}], ",", "\"\<Map times must increase.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], "]"}], 
          " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], ">", 
           "0"}], " ", "&&", "\n", "  ", 
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], "]"}], " ", "&&",
           " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<Invalid map tolerances.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}], ",", "4", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}], ",", "2", ",", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixQ", "[", 
           RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], "]"}], " ", "&&", 
          " ", 
          RowBox[{"MatrixQ", "[", 
           RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}], "]"}], " ", "&&", 
          " ", 
          RowBox[{"MatrixQ", "[", 
           RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}], "]"}]}], 
         ",", "\"\<Map probes must be density matrices.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"s0", "=", 
        RowBox[{
         RowBox[{"mapAt", "[", 
          RowBox[{"0", ",", "eng"}], "]"}], "[", "\"\<Transfer\>\"", "]"}]}], 
       ";", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"maxAbs", "[", 
           RowBox[{"s0", "-", 
            RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
         ",", "\"\<The t=0 map is not identity.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"recs", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"mapRecord", "[", 
           RowBox[{"#", ",", "eng", ",", "cfg", ",", "probes"}], "]"}], "&"}],
          " ", "/@", " ", "times"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"recs", ",", "\"\<TPError\>\""}], "]"}], "]"}], "<", 
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ", "&&",
           "\n", "  ", 
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"recs", ",", "\"\<MinChoiEigenvalue\>\""}], "]"}], "]"}],
            ">=", 
           RowBox[{"-", 
            RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}], 
         ",", "\"\<Choi CP/TP validation failed.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"dist", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"recs", ",", "\"\<BLPDistance\>\""}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dt", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"times", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "-", 
              RowBox[{"times", "[", 
               RowBox[{"[", 
                RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"rhp", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"recs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                 "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
                RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",",
                "\n", "   ", 
               RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
               RowBox[{"Max", "[", 
                RowBox[{"0.", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"traceNormHermitian", "[", 
                    RowBox[{"transferToChoi", "[", 
                    RowBox[{"rightSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Transfer\>\"", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<Transfer\>\"", "]"}]}], "]"}], "]"}], "]"}], "/",
                    "4"}], "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"recs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<BLPAccumulated\>\"", "->", 
               RowBox[{"Total", "[", 
                RowBox[{"Clip", "[", 
                 RowBox[{
                  RowBox[{"Differences", "[", 
                   RowBox[{"Take", "[", 
                    RowBox[{"dist", ",", "k"}], "]"}], "]"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ",",
               "\n", "   ", 
              RowBox[{"\"\<RHPFiniteStep\>\"", "->", "rhp"}], ",", 
              RowBox[{"\"\<RHPFiniteStepRate\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MissingQ", "[", "rhp", "]"}], ",", "rhp", ",", 
                 RowBox[{"rhp", "/", "dt"}]}], "]"}]}]}], "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "recs", "]"}]}], "}"}]}], "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",ExpressionUUID->\
