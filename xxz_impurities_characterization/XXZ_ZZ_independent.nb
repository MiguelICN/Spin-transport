Cell[CellGroupData[{

Cell["  Time grids  ", "Subsubsection",ExpressionUUID->"72d5d5c8-a873-034c-9c86-7ace63c8b6d9"],

Cell["\<\
 Linear or logarithmic sampling, including t=0. Linear dt is nominal: the \
last step may be shorter . \
\>", "Text",ExpressionUUID->"7df22fee-0f4a-994f-87a1-360c5c6c73e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"t", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "0.", "}"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"Subdivide", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}],
                "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "=", 
           RowBox[{"N", "[", 
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], ",",
          "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[65]:=",ExpressionUUID->"164e5746-8cf9-9643-98e8-56d8c87ac0b7"]
}, Open  ]],

