              RowBox[{"observableTitle", "[", "key", "]"}], ",", "p", ",", 
              "log"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"key", ",", "scalars"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"curves", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                 RowBox[{"Re", "[", 
                  RowBox[{
                   RowBox[{"#", "[", "\"\<RhoAB\>\"", "]"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"k", ",", "k"}], "]"}], "]"}], "]"}]}], "}"}], 
               "&"}], " ", "/@", " ", "records"}], ")"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"!", "log"}], " ", "||", " ", 
              RowBox[{
               RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], "&"}]}], "]"}],
           ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"g", "=", 
        RowBox[{"Block", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
          RowBox[{"framePlot", "[", 
           RowBox[{
           "curves", ",", "\"\<t\>\"", ",", "\"\<\\\\rho_{AB;ss}\>\"", ",", 
            RowBox[{"curveStyles", "[", "4", "]"}], ",", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               
               RowBox[{"\"\<\\\\rho_{\>\"", "<>", "#", "<>", "\"\<,\>\"", "<>",
                 "#", "<>", "\"\<}(t)\>\""}], "&"}], " ", "/@", " ", 
              "basis"}], ")"}], ",", "False", ",", "log", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
              RowBox[{"{", "4", "}"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n",
        " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"out", ",", 
         RowBox[{"\"\<EdgePopulations\>\"", "->", 
          RowBox[{"plotPanel", "[", 
           RowBox[{"\"\<\\\\text{Edge populations}\>\"", ",", 
            RowBox[{"trajectoryCaption", "[", 
             RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"fn", "=", 
           RowBox[{"Switch", "[", 
            RowBox[{
            "part", ",", "\"\<Re\>\"", ",", "Re", ",", "\"\<Im\>\"", ",", 
             "Im", ",", "\"\<Abs\>\"", ",", "Abs"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"curves", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                    RowBox[{"fn", "[", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<RhoAB\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], 
                   "}"}], "&"}], " ", "/@", " ", "records"}], ")"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"!", "log"}], " ", "||", " ", 
                 RowBox[{
                  RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"pair", ",", "pairs"}], "}"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"g", "=", 
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
             RowBox[{"framePlot", "[", 
              RowBox[{"curves", ",", "\"\<t\>\"", ",", 
               
               RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
                "<>", "\"\<}\\\\rho_{AB;ij}\>\""}], ",", 
               RowBox[{"curveStyles", "[", "6", "]"}], ",", "\n", "   ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"part", "==", "\"\<Abs\>\""}], 
                    ",", "\"\<|\\\\rho_{\>\"", ",", 
                    
                    RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
                    "<>", "\"\<}\\\\rho_{\>\""}]}], "]"}], "<>", 
                   RowBox[{"basis", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], 
                   "<>", "\"\<,\>\"", "<>", 
                   RowBox[{"basis", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}], "<>", 
                   RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"part", "==", "\"\<Abs\>\""}], ",", "\"\<}|\>\"", 
                    ",", "\"\<}\>\""}], "]"}]}], "&"}], " ", "/@", " ", 
                 "pairs"}], ")"}], ",", "False", ",", "log", ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
                 RowBox[{"{", "6", "}"}]}], "]"}]}], "]"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{"\"\<EdgeCoherences_\>\"", "<>", "part"}], "->", 
             RowBox[{"plotPanel", "[", 
              RowBox[{"\"\<\\\\text{Edge coherences}\>\"", ",", 
               RowBox[{"trajectoryCaption", "[", 
