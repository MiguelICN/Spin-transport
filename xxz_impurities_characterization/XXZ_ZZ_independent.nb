                  RowBox[{"Abs", "[", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "-", "b"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                  "2"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"Abs", "[", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{"a", "-", "b"}], ")"}], "[", 
                   RowBox[{"[", 
                    RowBox[{"j", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                 "2"}]}]}]}], "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", "e", "]"}]}], "}"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Catalog\>\"", "->", "cat"}], ",", 
        RowBox[{"\"\<Rows\>\"", "->", "rows"}], ",", 
        RowBox[{"\"\<ZLeft\>\"", "->", "a"}], ",", 
        RowBox[{"\"\<ZRight\>\"", "->", "b"}], ",", 
        RowBox[{"\"\<GapTolerance\>\"", "->", "gapTol"}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"boundaryPeaks", "[", 
    RowBox[{"run_", ",", "id_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"e", "=", 
        RowBox[{"Lookup", "[", 
