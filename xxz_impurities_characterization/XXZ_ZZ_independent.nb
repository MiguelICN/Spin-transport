 RowBox[{
  RowBox[{
   RowBox[{"chRecord", "[", 
    RowBox[{"t_", ",", "v_", ",", "cfg_", ",", "probes_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"v", "[", "\"\<Choi\>\"", "]"}]}], ",", 
       RowBox[{"s", "=", 
        RowBox[{"v", "[", "\"\<Transfer\>\"", "]"}]}], ",", 
       RowBox[{"sd", "=", 
        RowBox[{"v", "[", "\"\<TransferDerivative\>\"", "]"}]}], ",", "e", ",",
        "pt", ",", "sv", ",", "gen", ",", "rates", ",", "mixed", ",", 
       "lambda", ",", "f", ",", "fd", ",", "z", ",", "entropyC"}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"f", "=", 
       RowBox[{"v", "[", "\"\<DephasingFactors\>\"", "]"}]}], ";", 
      RowBox[{"fd", "=", 
       RowBox[{"v", "[", "\"\<DephasingDerivative\>\"", "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"e", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"herm", "[", "f", "]"}], "]"}], "]"}], ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{"0.", ",", "12"}], "]"}]}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"pt", "=", 
