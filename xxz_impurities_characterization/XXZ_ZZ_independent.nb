              RowBox[{"pp", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "ids"}], 
           "]"}]}], ";", 
         RowBox[{"hm", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"h", "[", 
             RowBox[{"[", 
              RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
         "\n", "  ", 
