Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"recordPlot", "[", 
    RowBox[{
    "records_", ",", "keys_List", ",", "ylabel_", ",", "title_", ",", "p_", ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"curves", ",", "styles", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"curves", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
                RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", 
             " ", "records"}], ")"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"!", "log"}], " ", "||", " ", 
               RowBox[{
                RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], ")"}]}], 
            "&"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"key", ",", "keys"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"curves", ",", 
          RowBox[{
           RowBox[{"#", "===", 
            RowBox[{"{", "}"}]}], "&"}]}], "]"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tex", "[", 
             RowBox[{"title", ",", "20"}], "]"}], ",", 
            RowBox[{"tex", "[", 
             
             RowBox[{"\"\<\\\\text{No valid samples under the selected \
tolerances.}\>\"", ",", "14"}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"styles", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Directive", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ColorData", "[", "97", "]"}], "[", "k", "]"}], ",", 
           RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"g", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
         RowBox[{"framePlot", "[", 
          RowBox[{
          "curves", ",", "\"\<t\>\"", ",", "ylabel", ",", "styles", ",", "\n",
            "  ", 
           RowBox[{"(", 
            RowBox[{"observableLabel", " ", "/@", " ", "keys"}], ")"}], ",", 
           "False", ",", "log", ",", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"Length", "[", "keys", "]"}], "}"}]}], "]"}]}], "]"}]}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"plotPanel", "[", 
       RowBox[{"title", ",", 
        RowBox[{"trajectoryCaption", "[", 
         RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"statePlots", "[", 
     RowBox[{"records_", ",", "p_", ",", 
      RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "scalars", ",", "curves", ",", "styles",
         ",", "g", ",", "fn", ",", 
        RowBox[{"pairs", "=", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", "4", "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ",", 
        RowBox[{"basis", "=", 
         RowBox[{"{", 
          
          RowBox[{"\"\<00\>\"", ",", "\"\<01\>\"", ",", "\"\<10\>\"", 
           ",", "\"\<11\>\""}], "}"}]}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"scalars", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Keys", "[", 
           RowBox[{"First", "[", "records", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", " ", "!=", " ", "\"\<Time\>\""}], " ", "&&", " ", 
            RowBox[{"NumericQ", "[", 
             RowBox[{
              RowBox[{"First", "[", "records", "]"}], "[", "#", "]"}], 
             "]"}]}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"key", "->", 
            RowBox[{"recordPlot", "[", 
             RowBox[{"records", ",", 
              RowBox[{"{", "key", "}"}], ",", 
