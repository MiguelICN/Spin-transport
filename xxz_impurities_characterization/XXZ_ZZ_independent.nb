Cell[CellGroupData[{

Cell["  Optional selected-sector DOS and gap diagnostics  ", "Subsubsection",ExpressionUUID->"952ecee4-dee7-474f-9652-3836ca66b6c2"],

Cell["\<\
 Raw levels only: no Chop, unfolding, or removal of degenerate levels . \
\>", "Text",ExpressionUUID->"2632087c-a83d-cc41-9c4a-f84a259c1678"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exGapRatios", "[", 
     RowBox[{"energies_List", ",", 
      RowBox[{"window_", ":", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"1", "/", "4"}], ",", 
         RowBox[{"3", "/", "4"}]}], "}"}]}], ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"e", "=", 
         RowBox[{"Sort", "[", 
          RowBox[{"N", "[", "energies", "]"}], "]"}]}], ",", "d", ",", "lo", ",",
         "hi", ",", "w", ",", "gaps", ",", "cut", ",", "pairs", ",", "ratios",
         ",", "unresolved", ",", "status"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"e", ",", "realQ"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Length", "[", "window", "]"}], "==", "2"}], " ", "&&", 
          " ", 
          RowBox[{"0", "<=", 
           RowBox[{"window", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<", 
           RowBox[{"window", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<=", "1"}], " ", "&&", "\n", 
          "  ", 
          RowBox[{"realQ", "[", "tol", "]"}], " ", "&&", " ", 
          RowBox[{"tol", ">", "0"}]}], 
         ",", "\"\<Invalid energy list, rank window, or gap tolerance.\>\""}],
         "]"}], ";", "\n", " ", 
       RowBox[{"d", "=", 
        RowBox[{"Length", "[", "e", "]"}]}], ";", 
       RowBox[{"lo", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1", ",", 
          RowBox[{
           RowBox[{"Floor", "[", 
            RowBox[{
             RowBox[{"window", "[", 
              RowBox[{"[", "1", "]"}], "]"}], " ", "d"}], "]"}], "+", "1"}]}],
          "]"}]}], ";", 
       RowBox[{"hi", "=", 
        RowBox[{"Min", "[", 
         RowBox[{"d", ",", 
          RowBox[{"Ceiling", "[", 
           RowBox[{
            RowBox[{"window", "[", 
             RowBox[{"[", "2", "]"}], "]"}], " ", "d"}], "]"}]}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"w", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"d", ">", "0"}], " ", "&&", " ", 
           RowBox[{"hi", ">=", "lo"}]}], ",", 
          RowBox[{"e", "[", 
           RowBox[{"[", 
            RowBox[{"lo", ";;", "hi"}], "]"}], "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", 
       RowBox[{"gaps", "=", 
        RowBox[{"Differences", "[", "w", "]"}]}], ";", "\n", " ", 
       RowBox[{"cut", "=", 
        RowBox[{"tol", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], ";", 
       RowBox[{"pairs", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"gaps", ",", "2", ",", "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"ratios", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", "#", "]"}], "<=", "cut"}], ",", 
             RowBox[{"Missing", "[", "\"\<UnresolvedGapPair\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Min", "[", "#", "]"}], "/", 
              RowBox[{"Max", "[", "#", "]"}]}]}], "]"}], "&"}], ",", 
          "pairs"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"unresolved", "=", 
        RowBox[{"Count", "[", 
         RowBox[{"ratios", ",", "_Missing"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"status", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "w", "]"}], "<", "3"}], 
          ",", "\"\<TooFewLevels\>\"", ",", 
          RowBox[{"unresolved", ">", "0"}], ",", "\"\<UnresolvedGaps\>\"", ",",
           "True", ",", "\"\<OK\>\""}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<SectorDimension\>\"", "->", "d"}], ",", 
         RowBox[{"\"\<WindowRanks\>\"", "->", 
          RowBox[{"{", 
           RowBox[{"lo", ",", "hi"}], "}"}]}], ",", 
         RowBox[{"\"\<WindowLevels\>\"", "->", 
          RowBox[{"Length", "[", "w", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<GapPairs\>\"", "->", 
          RowBox[{"Length", "[", "pairs", "]"}]}], ",", 
         RowBox[{"\"\<UnresolvedGapPairs\>\"", "->", "unresolved"}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<UnresolvedGaps\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{"gaps", ",", 
            RowBox[{"x_", "/;", 
             RowBox[{"x", "<=", "cut"}]}]}], "]"}]}], ",", 
         RowBox[{"\"\<GapResolution\>\"", "->", "cut"}], ",", "\n", "  ", 
         RowBox[{"\"\<Ratios\>\"", "->", "ratios"}], ",", 
         RowBox[{"\"\<MeanR\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"status", "==", "\"\<OK\>\""}], ",", 
            RowBox[{"Mean", "[", "ratios", "]"}], ",", 
            RowBox[{"Missing", "[", "status", "]"}]}], "]"}]}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<IIDSEM\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"status", "==", "\"\<OK\>\""}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Length", "[", "ratios", "]"}], ">=", "2"}]}], ",", 
            RowBox[{
             RowBox[{"StandardDeviation", "[", "ratios", "]"}], "/", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"Length", "[", "ratios", "]"}], "]"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<Unavailable\>\"", "]"}]}], "]"}]}], ",",
          "\n", "  ", 
         RowBox[{"\"\<MeanSpacing\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "gaps", "]"}], ">", "0"}], ",", 
            RowBox[{"Mean", "[", "gaps", "]"}], ",", 
            RowBox[{"Missing", "[", "\"\<NoGaps\>\"", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Status\>\"", "->", "status"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}], "\n", "\n", "\n", "\n"}]], "Code",
