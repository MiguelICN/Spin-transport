        "}"}]}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"boundaryFidelityCheck", "[", 
    RowBox[{"run_", ",", "id_Integer", ",", "gValues_List"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cat", "=", 
        RowBox[{"run", "[", "\"\<Catalog\>\"", "]"}]}], ",", "v", ",", "e", ",",
        "op", ",", "ev", ",", "vec", ",", "ov", ",", "k", ",", "chi"}], "}"}],
      ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"run", "[", "\"\<Rows\>\"", "]"}], "[", 
           RowBox[{"[", "id", "]"}], "]"}], "[", "\"\<DegeneratePartners\>\"",
           "]"}], "===", 
         RowBox[{"{", "}"}]}], 
        ",", "\"\<Nondegenerate state required for fidelity check.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"v", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"cat", "[", "\"\<States\>\"", "]"}], "[", 
         RowBox[{"[", "id", "]"}], "]"}], "[", "\"\<Vector\>\"", "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"cat", "[", "\"\<States\>\"", "]"}], ",", "\"\<Energy\>\""}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"op", "=", 
            RowBox[{
             RowBox[{"run", "[", "\"\<ZLeft\>\"", "]"}], "+", 
             RowBox[{"sgn", " ", 
              RowBox[{"run", "[", "\"\<ZRight\>\"", "]"}]}]}]}], ";", 
           RowBox[{"chi", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"run", "[", "\"\<Rows\>\"", "]"}], "[", 
              RowBox[{"[", "id", "]"}], "]"}], "[", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"sgn", "==", "1"}], ",", "\"\<ChiPlus\>\"", 
               ",", "\"\<ChiMinus\>\""}], "]"}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{"ev", ",", "vec"}], "}"}], "=", 
               RowBox[{"Eigensystem", "[", 
                RowBox[{
                 RowBox[{"DiagonalMatrix", "[", "e", "]"}], "+", 
                 RowBox[{"g", " ", 
                  RowBox[{"op", "/", "2"}]}]}], "]"}]}], ";", 
              RowBox[{"ov", "=", 
               RowBox[{
                RowBox[{"Abs", "[", 
                 RowBox[{"vec", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "id"}], "]"}], "]"}], "]"}], "^", 
                "2"}]}], ";", 
              RowBox[{"k", "=", 
               RowBox[{"First", "[", 
                RowBox[{"Ordering", "[", 
                 RowBox[{"ov", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<g\>\"", "->", "g"}], ",", 
                RowBox[{"\"\<Sign\>\"", "->", "sgn"}], ",", 
                RowBox[{"\"\<Infidelity\>\"", "->", 
                 RowBox[{"1", "-", 
                  RowBox[{"ov", "[", 
                   RowBox[{"[", "k", "]"}], "]"}]}]}], ",", 
                RowBox[{"\"\<Prediction\>\"", "->", 
                 RowBox[{
                  RowBox[{"g", "^", "2"}], " ", 
                  RowBox[{"chi", "/", "4"}]}]}], ",", 
                RowBox[{"\"\<MatchedOverlap\>\"", "->", 
                 RowBox[{"ov", "[", 
                  RowBox[{"[", "k", "]"}], "]"}]}]}], "|>"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"g", ",", "gValues"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"sgn", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}], ",", "1"}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",
