             RowBox[{"ss", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", 
            RowBox[{"ops", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"staticOperations", "[", 
                RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"sectorKey", "[", 
                  RowBox[{"staticTransformLabels", "[", 
                   RowBox[{
                    RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], ",", "#"}], 
                   "]"}], "]"}], "===", 
                 RowBox[{"sectorKey", "[", 
                  RowBox[{"dst", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                "&"}]}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{"ops", "=!=", 
               RowBox[{"{", "}"}]}], 
              ",", "\"\<No symmetry operator for the requested sector \
partner.\>\""}], "]"}], ";", 
            RowBox[{"op", "=", 
             RowBox[{"First", "[", "ops", "]"}]}], ";", "\n", "   ", 
            RowBox[{"mapped", "=", 
             RowBox[{"staticIndexMap", "[", 
              RowBox[{
               RowBox[{"src", "[", "\"\<Indices\>\"", "]"}], ",", "l", ",", 
               "op"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", "mapped", "]"}], "===", 
                RowBox[{"Sort", "[", 
                 RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}], "]"}]}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"src", "[", "\"\<Dimension\>\"", "]"}], "==", 
                RowBox[{"dst", "[", "\"\<Dimension\>\"", "]"}]}]}], 
              ",", "\"\<Symmetry partner dimensions/indices disagree.\>\""}], 
             "]"}], ";", "\n", "   ", 
            RowBox[{"pos", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{
               RowBox[{"AssociationThread", "[", 
                RowBox[{"mapped", ",", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "mapped", "]"}], "]"}]}], "]"}], ",", 
               RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}]}], "]"}]}], ";", 
            RowBox[{"rows", "=", 
             RowBox[{
              RowBox[{"src", "[", "\"\<Vectors\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "pos"}], "]"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Validate", " ", "the", " ", "mapped", " ", "basis", " ", 
              "against", " ", "the", " ", "ACTUAL", " ", "returned", " ", 
              "child", " ", 
              RowBox[{"eigenspace", "."}]}], " ", "*)"}], "\n", "   ", 
            RowBox[{"span", "=", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"rows", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"rows", " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", 
                   RowBox[{"dst", "[", "\"\<Vectors\>\"", "]"}], "]"}]}], 
                 ")"}], " ", ".", " ", 
                RowBox[{"dst", "[", "\"\<Vectors\>\"", "]"}]}]}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"h", "=", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{
                RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}], ",", 
                  RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}]}], "]"}], 
                "]"}], "]"}], "]"}]}], ";", 
            RowBox[{"scale", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Norm", "[", 
                RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", 
            "   ", 
            RowBox[{"res", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"h", " ", ".", " ", "#2"}], "-", 
                   RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"dst", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
                  "rows"}], "}"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"err", "=", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"src", "[", "\"\<Eigenvalues\>\"", "]"}], "-", 
               RowBox[{"dst", "[", "\"\<Eigenvalues\>\"", "]"}]}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"span", "<", 
                RowBox[{"100", " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"res", ",", "err"}], "]"}], "<", 
                RowBox[{"100", " ", "tol", " ", "scale"}]}]}], 
              ",", "\"\<Symmetry-paired child-sector validation \
failed.\>\""}], "]"}], ";", "\n", "   ", 
            RowBox[{
             RowBox[{"ss", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "=", 
             RowBox[{"Join", "[", 
              RowBox[{"dst", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Vectors\>\"", "->", 
                  RowBox[{"Developer`ToPackedArray", "[", "rows", "]"}]}], ",", 
                 RowBox[{"\"\<Residual\>\"", "->", "res"}], ",", 
                 RowBox[{"\"\<SymmetrySource\>\"", "->", 
                  RowBox[{"sectorKey", "[", 
                   RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<SymmetryOperation\>\"", "->", "op"}], ",", 
                 RowBox[{"\"\<PairingError\>\"", "->", 
                  RowBox[{"Max", "[", 
                   RowBox[{"span", ",", 
                    RowBox[{"res", "/", "scale"}], ",", 
                    RowBox[{"err", "/", "scale"}]}], "]"}]}]}], "|>"}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Rest", "[", "group", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"out", "[", "\"\<Sectors\>\"", "]"}], "=", "ss"}], ";", 
      "out"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticEquivalenceCheck", "[", 
    RowBox[{"ss_", ",", "l_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"groups", ",", "src", ",", "op", ",", "half", ",", "err"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"groups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"ss", ",", 
         RowBox[{
          RowBox[{"staticGroupKey", "[", 
           RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}]}], "]"}]}],
       ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"src", "=", 
          RowBox[{"First", "[", "group", "]"}]}], ";", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"op", "=", 
             RowBox[{"s", "[", "\"\<SymmetryOperation\>\"", "]"}]}], ";", 
            "\n", "  ", 
            RowBox[{"half", "=", 
             RowBox[{
              RowBox[{"EvenQ", "[", "l", "]"}], " ", "||", " ", 
              RowBox[{"!", 
               RowBox[{"MemberQ", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<R\>\"", ",", "\"\<RF\>\""}], "}"}], ",", 
                 "op"}], "]"}]}]}]}], ";", "\n", "  ", 
            RowBox[{"err", "=", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<IPR\>\"", "]"}], "-", 
                 RowBox[{"src", "[", "\"\<IPR\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<EdgesEntropy\>\"", "]"}], "-", 
                 RowBox[{"src", "[", "\"\<EdgesEntropy\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{"half", ",", 
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"s", "[", "\"\<HalfEntropy\>\"", "]"}], "-", 
                   RowBox[{"src", "[", "\"\<HalfEntropy\>\"", "]"}]}], "]"}], 
                 ",", "0."}], "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{"err", "<", 
               RowBox[{"100", " ", "tol"}]}], 
              ",", "\"\<Symmetry-paired entropy/IPR check failed.\>\""}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "True"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticSectorSlug", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", "<>", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"#2", ",", "InputForm"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<-\>\"", "->", "\"\<minus\>\""}], ",", 
             RowBox[{"\"\</\>\"", "->", "\"\<over\>\""}], ",", 
             RowBox[{"\"\< \>\"", "->", "\"\<\>\""}], ",", 
             RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}]}], "}"}]}], "]"}]}], 
        "&"}], ",", 
       RowBox[{"KeySort", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"a", ",", "\"\<sA\>\""}], "]"}], ",", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"a", ",", 
            RowBox[{"{", "\"\<m\>\"", "}"}]}], "]"}], ",", "a"}], "]"}], 
        "]"}]}], "]"}], ",", "\"\<_\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"staticGroupSlug", "[", "labels_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"s", "=", 
        RowBox[{"StringRiffle", "[", 
         RowBox[{
          RowBox[{"staticSectorSlug", " ", "/@", " ", "labels"}], 
          ",", "\"\<__\>\""}], "]"}]}], "}"}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"StringLength", "[", "s", "]"}], "<=", "190"}], ",", "s", ",", 
        RowBox[{
         RowBox[{"StringTake", "[", 
          RowBox[{"s", ",", "155"}], "]"}], "<>", "\"\<_\>\"", "<>", 
         RowBox[{"IntegerString", "[", 
          RowBox[{
           RowBox[{"Hash", "[", 
            RowBox[{"s", ",", "\"\<SHA256\>\""}], "]"}], ",", "16", ",", 
           "16"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n", "\n", 
  "\n"}], "\n"}], "Code",
 CellLabel->"In[51]:=",ExpressionUUID->"2a10b900-6ded-774d-a007-017c386f86c6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"staticPoint", "[", 
    RowBox[{"p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"addEntropies", "[", 
         RowBox[{"staticPairED", "[", 
          RowBox[{
           RowBox[{"regimeED", "[", 
            RowBox[{"p", ",", "tol"}], "]"}], ",", "tol"}], "]"}], "]"}]}], ",",
        "out"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"s", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<IPR\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                 " ", "/@", " ", 
                 RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
              "|>"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"out", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"2.", "^", 
               RowBox[{"(", 
                RowBox[{"-", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ")"}]}], "-", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
             RowBox[{"1", "+", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
             RowBox[{
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "]"}], " ", 
               RowBox[{"Log", "[", "2", "]"}]}], "+", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
             RowBox[{
              RowBox[{"Log", "[", "4", "]"}], "+", 
              RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], 
        ",", "\"\<Eigenstate bounds failed.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{"out", ",", "\"\<EdgesEntropy\>\""}], "]"}], "]"}], "<", 
         RowBox[{"100", " ", "tol"}]}], 
        ",", "\"\<ZZ fixed-edge eigenstate lost its product structure.\>\""}],
        "]"}], ";", "\n", " ", 
      RowBox[{"staticEquivalenceCheck", "[", 
       RowBox[{"out", ",", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"ed", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Hamiltonian\>\"", ",", "\"\<Sectors\>\""}], "}"}]}], 
         "]"}], ",", 
        RowBox[{"<|", 
         RowBox[{"\"\<Sectors\>\"", "->", "out"}], "|>"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticScan", "[", 
    RowBox[{"base_Association", ",", "axis_String", ",", "grid_List", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"models", ",", "points"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<g\>\"", ",", "\"\<Delta\>\""}], "}"}], ",", "axis"}],
           "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "grid", "]"}], ">=", "1"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"grid", ",", "realQ"}], "]"}], " ", "&&", "\n", "  ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "grid", "]"}], "==", "1"}], " ", "||", " ", 
           RowBox[{"And", "@@", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Differences", "[", 
               RowBox[{"N", "[", "grid", "]"}], "]"}], ">", "0"}], "]"}]}]}], 
          ")"}]}], 
        ",", "\"\<Use an increasing real scan grid for g or Delta.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"models", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"regimeModel", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"base", ",", 
            RowBox[{"<|", 
             RowBox[{"axis", "->", "#"}], "|>"}]}], "]"}], "]"}], "&"}], " ", 
        "/@", " ", "grid"}]}], ";", "\n", " ", 
      RowBox[{"points", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"staticPoint", "[", 
           RowBox[{"#", ",", "tol"}], "]"}], "&"}], ",", "models"}], "]"}]}], 
      ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Axis\>\"", "->", "axis"}], ",", 
        RowBox[{"\"\<Grid\>\"", "->", "grid"}], ",", 
        RowBox[{"\"\<BaseModel\>\"", "->", "base"}], ",", 
        RowBox[{"\"\<EDTolerance\>\"", "->", "tol"}], ",", 
        RowBox[{"\"\<Points\>\"", "->", "points"}], ",", "\n", "  ", 
        RowBox[{"\"\<SectorKeys\>\"", "->", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"sectorKey", "[", 
                 RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], " ",
                "/@", " ", 
               RowBox[{"#", "[", "\"\<Sectors\>\"", "]"}]}], ")"}], "&"}], 
            " ", "/@", " ", "points"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[59]:=",ExpressionUUID->"c9f3b0b4-744d-e843-beb4-9ea0cf5eed69"],

Cell["\<\
 Static eigenvectors in partner sectors are generated by F, R or RF and \
checked against the independently computed child eigenspace and Hamiltonian. \
All raw eigenvalues and labels are retained. Opposite parities are never \
merged. Odd-L antiparallel half-chain entropies have two distinct \
F-equivalence families. Recompute static scans after updating these \
definitions; old independently diagonalized degenerate eigenbases must not be \
used to claim entropy/IPR equality. \
\>", "Text",ExpressionUUID->"71014210-679a-dd46-bbce-3ec4a0552011"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Occupied-sector engine and exact phase evolution  ", "Subsubsection",ExpressionUUID->"b63ac265-2092-6940-981e-685b70f76cb2"],

Cell["\<\
 Single-time evolution, useful for checks and direct access . \
\>", "Text",ExpressionUUID->"b274a14a-018f-fc4c-8643-d64d462f77bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"evolve", "[", 
     RowBox[{"t_", ",", "engine_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "a", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", "I"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
            RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], " ", 
            "]"}], "]"}], "+=", 
          RowBox[{
           RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}], " ", 
             RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], 
       ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Batch", " ", "matrix", " ", "products", " ", "over", " ", "time"}], ";", 
    " ", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], " ", "is", " ", 
     "the", " ", "kth", " ", 
     RowBox[{"factor", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"evolveBatch", "[", 
     RowBox[{"times_List", ",", "engine_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"a", ",", "ph"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", "I"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
            RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}], ",", 
            RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ph", "=", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "I"}], " ", 
             RowBox[{"Outer", "[", 
              RowBox[{"Times", ",", 
               RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
               RowBox[{"N", "[", "times", " ", "]"}]}], "]"}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"a", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "c", ",", 
                "All"}], " ", "]"}], "]"}], "+=", 
             RowBox[{
              RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
              RowBox[{"(", 
               RowBox[{"ph", " ", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "c"}], " ", "]"}], "]"}]}], ")"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"c", ",", 
              RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], 
       ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",
