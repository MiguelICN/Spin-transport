    RowBox[{
    "qstAEngine", ",", "qstAFactor", ",", "qstABulkFactor", ",", 
     "qstAShortRecords", ",", 
     RowBox[{"qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
