Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chTimeReversal", "[", 
     RowBox[{"eng_", ",", "times_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ix", ",", "ts", ",", "neg", ",", "pos", ",", "conj", ",", "errs"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ix", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<TimeReversalCheck\>\"", "]"}], 
          ",", "\"\<None\>\"", ",", 
          RowBox[{"{", "}"}], ",", "\"\<Endpoints\>\"", ",", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"Ceiling", "[", 
              RowBox[{
               RowBox[{"Length", "[", "times", "]"}], "/", "2"}], "]"}], ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}], "]"}], 
          ",", "\"\<All\>\"", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "times", "]"}], "]"}], ",", "_", ",", 
          RowBox[{"check", "[", 
           RowBox[{
           "False", 
            ",", "\"\<TimeReversalCheck must be None, Endpoints or All \
(strings).\>\""}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ix", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Indices\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Times\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Errors\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Maximum\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}]}], 
           "|>"}], "]"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"ts", "=", 
        RowBox[{"times", "[", 
         RowBox[{"[", "ix", "]"}], "]"}]}], ";", 
       RowBox[{"conj", "=", 
        RowBox[{"chConjugateEngine", "[", "eng", "]"}]}], ";", "\n", " ", 
       RowBox[{"neg", "=", 
        RowBox[{"chSeries", "[", 
         RowBox[{"eng", ",", 
          RowBox[{"-", "ts"}], ",", "cfg"}], "]"}]}], ";", 
       RowBox[{"pos", "=", 
        RowBox[{"chSeries", "[", 
         RowBox[{"conj", ",", "ts", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"errs", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"#1", "[", "\"\<Transfer\>\"", "]"}], "-", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"#2", "[", "\"\<Transfer\>\"", "]"}], "]"}]}], "]"}], 
           "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"neg", ",", "pos"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "errs", "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
         ",", "\"\<Conjugate-bulk time-reversal check failed.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Indices\>\"", "->", "ix"}], ",", 
         RowBox[{"\"\<Times\>\"", "->", "ts"}], ",", 
         RowBox[{"\"\<Errors\>\"", "->", "errs"}], ",", 
         RowBox[{"\"\<Maximum\>\"", "->", 
          RowBox[{"Max", "[", "errs", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", "\n", "\n", "\n"}]], "Code",ExpressionUUID->"2e86611f-07e3-\
d845-b4f0-5e8d8d89df32"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chAverage", "[", 
     RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "chi", ",", "f", ",", "scale", ",", "absolute", ",", "all", ",", 
        "clusters", ",", "widths", ",", "g", ",", "ids", ",", "masks", ",", 
        "e1", ",", "e2", ",", "labels", ",", 
        RowBox[{"matched", "=", "0"}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
          RowBox[{"relativeTol", ">", "0"}]}], 
         ",", "\"\<Positive averaging tolerance required.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"Flatten", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                 RowBox[{"[", "s", "]"}], "]"}], "[", "k", "]"}], 
               "[", "\"\<E\>\"", "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "4"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", 
                RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "}"}]}], 
             "]"}], "]"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"absolute", "=", 
        RowBox[{"relativeTol", " ", "scale"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"6", " ", 
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Length", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "[", "#", "]"}], 
                  "[", "\"\<E\>\"", "]"}], "]"}], "^", "2"}], ")"}], "&"}], 
             " ", "/@", " ", 
             RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "]"}]}], "<=", 
          RowBox[{
           RowBox[{"eng", "[", "\"\<Settings\>\"", "]"}], 
           "[", "\"\<MaxOverlapEntries\>\"", "]"}]}], 
         ",", "\"\<ZZ average overlap cache exceeds MaxOverlapEntries.\>\""}],
         "]"}], ";", "\n", " ", 
       RowBox[{"g", "=", 
        RowBox[{"chZzOverlaps", "[", "eng", "]"}]}], ";", 
       RowBox[{"f", "=", 
        RowBox[{"N", "[", 
         RowBox[{"IdentityMatrix", "[", "4", "]"}], "]"}]}], ";", 
       RowBox[{"clusters", "=", 
        RowBox[{"<|", "|>"}]}], ";", 
       RowBox[{"widths", "=", 
        RowBox[{"{", "}"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"all", "=", 
           RowBox[{"Flatten", "[", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "s", "]"}], "]"}], "[", "k", "]"}], 
                    "[", "\"\<E\>\"", "]"}], "[", 
                    RowBox[{"[", "n", "]"}], "]"}], ",", "s", ",", "n"}], 
                  "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"n", ",", 
                   RowBox[{"Length", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                    RowBox[{"[", "s", "]"}], "]"}], "[", "k", "]"}], 
                    "[", "\"\<E\>\"", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "4"}], "}"}]}], "]"}], ",", "1"}], "]"}]}], 
          ";", "\n", "  ", 
          RowBox[{"ids", "=", 
           RowBox[{"chClusters", "[", 
            RowBox[{"all", ",", "absolute"}], "]"}]}], ";", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"clusters", ",", 
            RowBox[{"k", "->", "ids"}]}], "]"}], ";", 
          RowBox[{"widths", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"widths", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"Last", "[", "#", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "-", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
              "ids"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"labels", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                   RowBox[{"[", "s", "]"}], "]"}], "[", "k", "]"}], 
                 "[", "\"\<E\>\"", "]"}], "]"}]}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"s", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"labels", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"item", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", 
                  RowBox[{"item", "[", 
                   RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "=", "j"}],
               ",", 
              RowBox[{"{", 
               RowBox[{"item", ",", 
                RowBox[{"ids", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", 
              RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"masks", "=", 
              RowBox[{"Outer", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Boole", "[", 
                  RowBox[{"#1", "==", "#2"}], "]"}], "&"}], ",", 
                RowBox[{"labels", "[", 
                 RowBox[{"[", "s", "]"}], "]"}], ",", 
                RowBox[{"labels", "[", 
                 RowBox[{"[", "s2", "]"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{
              RowBox[{"f", "[", 
               RowBox[{"[", 
                RowBox[{"s", ",", "s2"}], "]"}], "]"}], "+=", 
              RowBox[{"Total", "[", 
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"g", "[", 
                   RowBox[{"{", 
                    RowBox[{"s", ",", "s2"}], "}"}], "]"}], "[", "k", "]"}], " ",
                  "masks"}], "]"}], "]"}]}], ";", 
             RowBox[{"matched", "+=", 
              RowBox[{"Total", "[", 
               RowBox[{"Flatten", "[", "masks", "]"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "4"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"s2", ",", 
              RowBox[{"s", "+", "1"}], ",", "4"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"eng", "[", "\"\<Occupied\>\"", "]"}]}], "}"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"[", 
            RowBox[{"s2", ",", "s"}], "]"}], "]"}], "=", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"f", "[", 
            RowBox[{"[", 
             RowBox[{"s", ",", "s2"}], "]"}], "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"s2", ",", 
           RowBox[{"s", "+", "1"}], ",", "4"}], "}"}]}], "]"}], ";", 
       RowBox[{"chi", "=", 
        RowBox[{"chZzChoi", "[", "f", "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Choi\>\"", "->", 
          RowBox[{"4", " ", "chi"}]}], ",", 
         RowBox[{"\"\<ChoiState\>\"", "->", "chi"}], ",", 
         RowBox[{"\"\<Transfer\>\"", "->", 
          RowBox[{"chZzSuper", "[", "f", "]"}]}], ",", 
         RowBox[{"\"\<DephasingFactors\>\"", "->", "f"}], ",", "\n", " ", 
         RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",", 
         RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", "absolute"}], ",", 
         RowBox[{"\"\<ClustersByBulkSector\>\"", "->", "clusters"}], ",", 
         "\n", " ", 
         RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
         RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
          RowBox[{"Max", "[", "widths", "]"}]}], ",", 
         RowBox[{"\"\<MatchedEnergyPairs\>\"", "->", "matched"}], ",", "\n", 
         " ", 
         RowBox[{"\"\<TPError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"Diagonal", "[", "f", "]"}], "-", "1"}], "]"}]}], ",", 
         RowBox[{"\"\<MapEntropy\>\"", "->", 
          RowBox[{"entropy", "[", 
           RowBox[{"f", "/", "4"}], "]"}]}], ",", "\n", " ", 
         RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", 
              RowBox[{"choiPartialTransposeOut", "[", "chi", "]"}], "]"}], 
             "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
  "\n", "\n", "\n"}]], "Code",ExpressionUUID->"c46d3322-5ccb-5540-bdc0-\
f847b4ed2a4e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chSinglePlot", "[", 
    RowBox[{
    "records_", ",", "key_", ",", "label_", ",", "title_", ",", "p_", ",", 
     "log_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rows", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
              RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", " ", 
           "records"}], ")"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", 
            RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&&", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"!", "log"}], " ", "||", " ", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], ")"}]}], 
          "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tex", "[", 
             RowBox[{"title", ",", "20"}], "]"}], ",", 
            RowBox[{"tex", "[", 
             
             RowBox[{"\"\<\\\\text{No valid samples under the selected \
tolerances.}\>\"", ",", "14"}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"g", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
         RowBox[{"framePlot", "[", 
          RowBox[{
           RowBox[{"{", "rows", "}"}], ",", "\"\<t\>\"", ",", "label", ",", 
           RowBox[{"{", "Blue", "}"}], ",", 
           RowBox[{"{", "label", "}"}], ",", "False", ",", "log", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], "}"}]}], 
          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"plotPanel", "[", 
       RowBox[{"title", ",", 
        RowBox[{"trajectoryCaption", "[", 
         RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chPlots", "[", 
    RowBox[{"records_", ",", "p_", ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"out", "=", 
       RowBox[{"mapPlots", "[", 
        RowBox[{"records", ",", "p", ",", "log"}], "]"}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"out", ",", 
        RowBox[{"\"\<TimeReversalError\>\"", "->", 
         RowBox[{"chSinglePlot", "[", 
          RowBox[{
          "records", ",", "\"\<TimeReversalError\>\"", ",", "\n", 
           "  ", "\"\<\\\\|S_{-t}^{[\\\\rho_E]}-(S_t^{[\\\\rho_E^*]})^*\\\\|_{\
\\\\max}\>\"", ",", "\"\<\\\\text{Conjugate-bulk time-reversal check}\>\"", ",",
            "p", ",", "log"}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"AssociateTo", "[", 
       RowBox[{"out", ",", 
        RowBox[{"\"\<MinDephasingEigenvalue\>\"", "->", 
         RowBox[{"chSinglePlot", "[", 
          RowBox[{
          "records", ",", "\"\<MinDephasingEigenvalue\>\"", 
           ",", "\"\<\\\\lambda_{\\\\min}(F_t)/4\>\"", 
           ",", "\"\<\\\\text{Choi support minimum}\>\"", ",", "p", ",", 
           "log"}], "]"}]}], ",", "\n", " ", 
        RowBox[{"\"\<IntermediateSupportMinimum\>\"", "->", 
         RowBox[{"chSinglePlot", "[", 
          RowBox[{
          "records", ",", "\"\<IntermediateSupportMinimum\>\"", 
           ",", "\"\<\\\\lambda_{\\\\min}(F_t\\\\oslash F_s)/4\>\"", 
           ",", "\"\<\\\\text{Intermediate-map support minimum}\>\"", ",", 
           "p", ",", "log"}], "]"}]}]}], "]"}], ";", "\n", " ", "out"}]}], 
    "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"a219a6aa-806f-7e4f-\
b1e6-07eb91042610"],

Cell["\<\
  Revision-2 channel engine adapted to the existing conventions: L is TOTAL \
length; the bulk has L-2 spins; S=sigma/2 and the exchange flip amplitude is \
g/2. Stored Choi still has trace 4, ChoiState trace 1. No fields are \
introduced. Guide field-retuning examples and its SU(2) suggestion do not \
apply to these XY-only end bonds. The legacy map helpers remain available to \
the unchanged QST chapter; chapter 3 uses only the new ch-prefixed engine.  \
\>", "Text",ExpressionUUID->"bbb0e5b4-1eb9-0046-bb4e-8b2c9514b600"]
}, Closed]]
}, Open  ]],

Cell[CellGroupData[{

Cell["  3.2 Independent map parameters and bulk state  ", "Subsection",ExpressionUUID->"1f0d5366-be42-4f49-b401-5a54bcd57e90"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapBulk", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
      RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternative", ":", " ", "mapBulk"}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"mapTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<EDTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<ValidationTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
      RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<RankTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
      RowBox[{"\"\<AverageEnergyTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<SignalThreshold\>\"", "->", "0.01"}], ",", "\n", " ", 
      RowBox[{"\"\<Symmetries\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<ZZMethod\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<BatchTimes\>\"", "->", "64"}], ",", "\n", " ", 
      RowBox[{"\"\<MaxColumns\>\"", "->", "4096"}], ",", 
      RowBox[{"\"\<MaxEntries\>\"", "->", 
       RowBox[{"2", "^", "22"}]}], ",", 
      RowBox[{"\"\<MaxOverlapEntries\>\"", "->", 
       RowBox[{"2", "^", "24"}]}], ",", "\n", " ", 
      RowBox[{"\"\<TimeReversalCheck\>\"", "->", "\"\<Endpoints\>\""}]}], 
     "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Exact", " ", "zero"}], "-", 
     RowBox[{"column", " ", "pruning", " ", 
      RowBox[{"only", ".", " ", 
       RowBox[{"ZZMethod", ":", " ", "Automatic"}]}]}]}], ",", 
    " ", "\"\<Direct\>\"", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\"\<Overlap\>\"", ".", "\n", " ", "MaxEntries"}], " ", 
       "limits", " ", "ONE", " ", "exchange", " ", "Choi"}], "-", 
      RowBox[{"factor", " ", "array"}]}], ";", " ", 
     RowBox[{
      RowBox[{"derivatives", "/", "temporaries"}], " ", "add", " ", 
      RowBox[{"memory", ".", "\n", " ", 
       RowBox[{"TimeReversalCheck", ":", " ", "\"\<None\>\""}]}]}]}], ",", 
    " ", 
    RowBox[{"\"\<Endpoints\>\"", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"first", "/", "middle"}], "/", "last"}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"or", " ", 
         RowBox[{"\"\<All\>\"", ".", "\n", " ", "Optional"}], " ", "sector"}],
         "-", 
        RowBox[{"defined", " ", "thermal", " ", "estimator", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"different", " ", "finite"}], "-", 
           RowBox[{"sample", " ", "ensemble"}]}], ")"}]}]}], ":", "\n", " ", 
       "mapBulk"}], "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", "->", "\"\<SectorTypical\>\""}], ",", 
        RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
        RowBox[{"\"\<SamplesPerSector\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"Existing", " ", "Type"}], "->", 
      RowBox[{
       RowBox[{"\"\<Typical\>\"", " ", "keeps", " ", "its", " ", "original", " ",
         "global", " ", "random"}], "-", 
       RowBox[{"vector", " ", 
        RowBox[{"definition", "."}]}]}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"mapComputeInfiniteTimeAverage", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapLogHorizontalAxis", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapRunLabel", "=", "\"\<ZZ_map_dynamics\>\""}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"a1969ba2-aded-c94a-af08-\
6bb0166ec051"]
}, Closed]],

Cell[CellGroupData[{

