nUUID->"10a8abc1-b0a6-9c40-9c76-0976d53b3600"],

Cell["\<\
  ZZ integrability: every fixed-edge block is an open XXZ bulk with diagonal \
boundary fields g sA and g sB, hence integrable for every g and Delta. These \
gap ratios are an integrable control, not a Poisson-to-GOE crossover probe. \
Finite-size effects, additional conserved charges and degeneracies can \
prevent a Poisson-like histogram; integrability alone does not guarantee a \
particular finite-size mean.  \
\>", "Text",ExpressionUUID->"883eb703-6647-fb4e-ad43-bd8576c58e5a"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.10 Optional DOS inspection before choosing a gap-ratio rank window  \
\>", "Subsection",ExpressionUUID->"c191a17c-ef0c-9545-85c7-c5a4af6d784c"],

Cell["\<\
  This postprocessing section uses one completed static scan of your choice. \
It never merges distinct symmetry sectors. Inspect normalized DOS and \
empirical CDF first, then edit diagRankWindow and rerun the diagnostic cells. \
The orange lines show the actual rank-window energy boundaries; a rank \
fraction is not an energy fraction. This section does not affect either \
dynamics chapter.  \
\>", "Text",ExpressionUUID->"cc9b7e86-bd25-584f-ad63-defd02adaf2a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"diagRun", "=", "statGRun"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Or", " ", 
    RowBox[{"statDeltaRun", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagSector", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<m\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<sA\>\"", "->", 
       RowBox[{"1", "/", "2"}]}], ",", 
      RowBox[{"\"\<sB\>\"", "->", 
       RowBox[{"1", "/", "2"}]}], ",", 
      RowBox[{"\"\<mBulk\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<R\>\"", "->", "1"}]}], "|>"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagRankWindow", "=", 
    RowBox[{"{", 
     RowBox[{"0.30", ",", "0.70"}], "}"}]}], ";", 
   RowBox[{"diagBins", "=", "30"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagGapResolution", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}], ";", 
   RowBox[{"diagBlockLength", "=", "10"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagMinimumDimension", "=", "500"}], ";", 
   RowBox[{"diagMinimumRatios", "=", "100"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagLogHorizontalAxis", "=", "False"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagSampleIndices", "=", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}], "/", "2"}], 
        "]"}], ",", 
       RowBox[{"Length", "[", 
        RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "}"}], 
     "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagOutputRoot", "=", 
    RowBox[{"resultRoot", "[", "]"}]}], ";", 
   RowBox[{"diagRunLabel", "=", "\"\<ZZ_spectral_diagnostics\>\""}], ";"}], 
  "\n", "\n"}], "\n"}], "Code",ExpressionUUID->"69f94fa2-6ba1-7b42-af1d-\
2bb29addc8e4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagDOS", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"s", "=", 
          RowBox[{"selectedStaticSector", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "diagSector"}], "]"}]}]}], 
        "}"}], ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<PointIndex\>\"", "->", "k"}], ",", 
         RowBox[{"\"\<Model\>\"", "->", 
          RowBox[{"p", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<DOS\>\"", "->", 
          RowBox[{"sectorDOS", "[", 
           RowBox[{
            RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
            "diagRankWindow", ",", "diagBins"}], "]"}]}]}], "|>"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "diagSampleIndices"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagDOSPlots", "=", 
    RowBox[{"Association", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#1", "<>", "\"\<_sector_\>\"", "<>", 
               RowBox[{"staticSectorSlug", "[", 
                RowBox[{"row", "[", "\"\<Labels\>\"", "]"}], "]"}], 
               "<>", "\"\<_point_\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"row", "[", "\"\<PointIndex\>\"", "]"}], "]"}]}], 
              ")"}], "->", "#2"}], "&"}], ",", "\n", " ", 
           RowBox[{"dosPanels", "[", 
            RowBox[{
             RowBox[{"row", "[", "\"\<DOS\>\"", "]"}], ",", 
             RowBox[{"row", "[", "\"\<Model\>\"", "]"}], ",", 
             RowBox[{"row", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "diagDOS"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     "]"}]}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"First", "[", 
    RowBox[{"Values", "[", "diagDOSPlots", "]"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"6f28a21d-541c-294f-b324-\
d6a4bd1273ad"],

Cell["\<\
  The L=8 static defaults are small demonstrations: their default ZZ/exchange \
windows contain only 4/11 ratios. The gap mean is withheld below \
diagMinimumDimension=500 or diagMinimumRatios=100. DOS remains available. For \
quantitative work select a sufficiently large resolved sector and recompute \
its spectrum; inspect the actual dimension and error estimate. Reducing these \
thresholds deliberately is a demonstration, not evidence of a crossover.  \
\>", "Text",ExpressionUUID->"001482c3-f7d7-e743-8c97-08cf051e714e"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.11 Optional gap-ratio calculation and export after DOS inspection  \
\>", "Subsection",ExpressionUUID->"75c55e00-e243-b243-a473-a1c5a1799c1b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"diagDOS", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<DOS\>\"", "]"}], "[", "\"\<RankWindow\>\"", 
         "]"}], "===", "diagRankWindow"}], "&"}]}], "]"}], ",", "\n", 
    " ", "\"\<RankWindow changed: rerun the DOS data/plot cell to refresh the \
displayed boundaries first.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diagGapRows", "=", 
   RowBox[{"gapScan", "[", 
    RowBox[{
    "diagRun", ",", "diagSector", ",", "diagRankWindow", ",", 
     "diagGapResolution", ",", "diagBlockLength", ",", "diagMinimumDimension",
      ",", "diagMinimumRatios"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Parameter\>\"", ",", "\"\<SectorDimension\>\"", 
          ",", "\"\<WindowRanks\>\"", ",", "\"\<Status\>\"", 
          ",", "\"\<MeanR\>\"", ",", "\"\<BlockSEM\>\""}], "}"}]}], "]"}], 
      "&"}], " ", "/@", " ", "diagGapRows"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"65ca5de9-e6a3-4e49-9004-\
8544398e56bf"],

Cell["\<\
  No levels are removed or unfolded. Any unresolved gap pair makes that mean \
Missing. IID and contiguous-block standard errors are descriptive estimates, \
not calibrated independent-sample confidence intervals. Delta=0 has extra \
integrable charges and degeneracies; Delta=+/-1/2 is a special \
bulk-degeneracy control. A mean alone is not a chaos diagnosis.  \
\>", "Text",ExpressionUUID->"a3b2aa62-bb11-ec47-9411-aca4824b1b4d"],

