                    RowBox[{"Last", " ", "/@", " ", "history"}], "]"}], "]"}],
                     "==", "1"}], " ", "&&", " ", 
                    RowBox[{
                    RowBox[{"Length", "[", "history", "]"}], "==", 
                    RowBox[{"Length", "[", 
                    RowBox[{"run", "[", "\"\<Grid\>\"", "]"}], "]"}]}]}], ",",
                     "\n", "      ", 
                    RowBox[{"\"\<d=\>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"history", "[", 
                    RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}]}], ",", "\n",
                     "      ", 
                    
                    RowBox[{"\"\<(\>\"", "<>", "axis", "<>", 
                    " ", "\"\<,d)=\\\\{\>\"", "<>", 
                    RowBox[{"StringRiffle", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"\"\<(\>\"", "<>", 
                    RowBox[{"texNumber", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", 
                    " ", "\"\<,\>\"", "<>", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", 
                    " ", "\"\<)\>\""}], "&"}], " ", "/@", " ", "history"}], 
                    ")"}], ",", "\"\<,\>\""}], "]"}], 
                    "<>", "\"\<\\\\}\>\""}]}], "]"}]}], ";", "\n", "    ", 
                 RowBox[{"family", "=", 
                  RowBox[{"If", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"spec", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], 
                    "===", "\"\<HalfEntropy\>\""}], " ", "&&", " ", 
                    RowBox[{"OddQ", "[", 
                    RowBox[{
                    RowBox[{"run", "[", "\"\<BaseModel\>\"", "]"}], 
                    "[", "\"\<L\>\"", "]"}], "]"}], " ", "&&", " ", 
                    RowBox[{"KeyExistsQ", "[", 
                    RowBox[{
                    RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], ",", "\"\<sA\>\""}], 
                    "]"}], " ", "&&", " ", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<sA\>\"", "]"}], 
                    "!=", 
                    RowBox[{
                    RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<sB\>\"", 
                    "]"}]}]}], ",", "\n", "      ", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<sA\>\"", "]"}], 
                    " ", 
                    RowBox[{
                    RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<mBulk\>\"", 
                    "]"}]}], ">", "0"}], ",", "\"\<;\\\\ G_1\>\"", 
                    ",", "\"\<;\\\\ G_2\>\""}], "]"}], ",", "\"\<\>\""}], 
                   "]"}]}], ";", "\n", "    ", 
                 RowBox[{
                  RowBox[{"sectorTex", "[", 
                   RowBox[{"labels", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "]"}], 
                  "<>", "\"\<;\\\\quad \>\"", "<>", "dimText", "<>", 
                  "family"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", 
                  RowBox[{"Length", "[", "members", "]"}]}], "}"}]}], "]"}]}],
              ";", "\n", "   ", 
             RowBox[{"curves", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Flatten", "[", 
                 RowBox[{
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"row", "[", "\"\<x\>\"", "]"}], ",", 
                    RowBox[{
                    RowBox[{"row", "[", "\"\<Sector\>\"", "]"}], 
                    "[", "\"\<Dimension\>\"", "]"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"row", "[", "\"\<Sector\>\"", "]"}], "[", 
                    RowBox[{"spec", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"row", ",", "member"}], "}"}]}], "]"}], ",", 
                  "1"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"member", ",", "members"}], "}"}]}], "]"}]}], ";", 
             "\n", "   ", 
             RowBox[{"note", "=", 
              RowBox[{"\"\<\\\\text{\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"Length", "[", "members", "]"}], "]"}], 
               "<>", "\"\< sector\>\"", "<>", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Length", "[", "members", "]"}], "==", "1"}], 
                 ",", "\"\<\>\"", ",", "\"\<s\>\""}], "]"}], 
               "<>", "\"\< in this group; dimensions are per sector}\>\""}]}],
              ";", "\n", "   ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"spec", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], 
                 "===", "\"\<HalfEntropy\>\""}], " ", "&&", " ", 
                RowBox[{"OddQ", "[", 
                 RowBox[{
                  RowBox[{"run", "[", "\"\<BaseModel\>\"", "]"}], 
                  "[", "\"\<L\>\"", "]"}], "]"}], " ", "&&", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "members", "]"}], "==", "4"}]}], ",", 
               RowBox[{"note", "=", 
                RowBox[{
                "note", 
                 "<>", "\"\<;\\\\quad G_1\\\\not\\\\equiv G_2\\\\ \\\\text{in \
general}\>\""}]}]}], "]"}], ";", "\n", "   ", 
             RowBox[{"g", "=", 
              RowBox[{"Block", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"plotChop", "=", "chop"}], "}"}], ",", 
                RowBox[{"framePlot", "[", 
                 RowBox[{"curves", ",", "axis", ",", 
                  RowBox[{"spec", "[", 
                   RowBox[{"[", "2", "]"}], "]"}], ",", "styles", ",", 
                  "legends", ",", "False", ",", "False", ",", "markers", ",", 
                  "note"}], "]"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"cap", "=", 
              RowBox[{"Column", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"staticCaption", "[", "run", "]"}], "}"}], ",", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"tex", "[", 
                    RowBox[{"#", ",", "11"}], "]"}], "&"}], " ", "/@", " ", 
                    "legends"}], ")"}]}], "]"}], ",", 
                RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";", "\n", 
             "   ", 
             RowBox[{"key", "=", 
              RowBox[{
               RowBox[{"spec", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<_sectors_\>\"", "<>", 
               RowBox[{"staticGroupSlug", "[", "labels", "]"}]}]}], ";", "\n",
              "   ", 
             RowBox[{"AssociateTo", "[", 
              RowBox[{"out", ",", 
               RowBox[{"key", "->", 
                RowBox[{"plotPanel", "[", 
                 RowBox[{
                  RowBox[{"spec", "[", 
                   RowBox[{"[", "3", "]"}], "]"}], ",", "cap", ",", "g"}], 
                 "]"}]}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"spec", ",", "specs"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "out"}]}], 
     "\n", "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",
