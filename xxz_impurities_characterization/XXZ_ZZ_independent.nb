       " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"StringQ", "[", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", "file"}], "}"}], "]"}], ",", 
            RowBox[{"Join", "[", 
