 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstWindowMean", "[", 
     RowBox[{"records_", ",", "key_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"records", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{"y", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"records", ",", "key"}], "]"}]}], ",", "bad", ",", "inf", ",",
         "value"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"bad", "=", 
        RowBox[{"Count", "[", 
         RowBox[{"y", ",", "_Missing"}], "]"}]}], ";", 
       RowBox[{"inf", "=", 
        RowBox[{"Count", "[", 
         RowBox[{"y", ",", "Infinity"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"value", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"bad", ">", "0"}], ",", 
          RowBox[{"Missing", "[", "\"\<InvalidSamples\>\"", "]"}], ",", 
          RowBox[{"inf", ">", "0"}], ",", 
          RowBox[{
          "Missing", "[", "\"\<SingularSamplesRequireQuadrature\>\"", "]"}], ",",
           "\n", "  ", "True", ",", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"Differences", "[", "t", "]"}], " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"Most", "[", "y", "]"}], "+", 
                RowBox[{"Rest", "[", "y", "]"}]}], ")"}], "/", "2"}]}], "]"}],
            "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Last", "[", "t", "]"}], "-", 
             RowBox[{"First", "[", "t", "]"}]}], ")"}]}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Observable\>\"", "->", "key"}], ",", 
         RowBox[{"\"\<Window\>\"", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"First", "[", "t", "]"}], ",", 
            RowBox[{"Last", "[", "t", "]"}]}], "}"}]}], ",", 
         RowBox[{"\"\<Method\>\"", 
          "->", "\"\<Trapezoidal in physical time\>\""}], ",", "\n", " ", 
         RowBox[{"\"\<Value\>\"", "->", "value"}], ",", 
         RowBox[{"\"\<InfiniteSamples\>\"", "->", "inf"}], ",", 
         RowBox[{"\"\<InvalidSamples\>\"", "->", "bad"}], ",", "\n", " ", 
         RowBox[{"\"\<Note\>\"", 
          "->", "\"\<A logarithmic singularity at a sampled zero need not \
make the time integral infinite; no value is inferred there.\>\""}]}], 
        "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",E\
