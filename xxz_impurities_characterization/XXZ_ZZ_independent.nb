Cell[CellGroupData[{

Cell["\<\
 1B.1 Isolated-bulk eigenstates and longitudinal boundary response: \
definitions \
\>", "Subsection",ExpressionUUID->"72ec5a13-930f-cb46-8f94-91b9870c6e41"],

Cell["\<\
 No g enters H0. A complete fixed-mu space is retained, including all \
parities. \
\>", "Text",ExpressionUUID->"5cda9bd3-d234-1049-9b43-d92199df13d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bulkEigenCatalog", "[", 
    RowBox[{"p_Association", ",", "mu_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "ids", ",", 
       "h", ",", "q", ",", "spaces", ",", "ss", ",", 
       RowBox[{"states", "=", 
        RowBox[{"{", "}"}]}], ",", "v", ",", 
       RowBox[{"k", "=", "0"}], ",", "other", ",", "bp"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "n", "]"}], " ", "&&", " ", 
         RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{
           RowBox[{"n", "/", "2"}], "-", "mu"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", "mu", "]"}], "<=", 
          RowBox[{"n", "/", "2"}]}]}], 
        ",", "\"\<Invalid bulk magnetization.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"ids", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"2", "^", "n"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"IntegerDigits", "[", 
             RowBox[{
              RowBox[{"#", "-", "1"}], ",", "2", ",", "n"}], "]"}], "]"}], "==", 
           RowBox[{
            RowBox[{"n", "/", "2"}], "-", "mu"}]}], "&"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"bulkHamiltonian", "[", "p", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"bp", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<L\>\"", "->", "n"}], ",", 
         RowBox[{"\"\<J\>\"", "->", 
          RowBox[{"p", "[", "\"\<J\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Delta\>\"", "->", 
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}]}], ",", 
         RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
         RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", " ", 
      RowBox[{"q", "=", 
       RowBox[{"charges", "[", "bp", "]"}]}], ";", 
      RowBox[{"other", "=", 
       RowBox[{"Complement", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"2", "^", "n"}], "]"}], ",", "ids"}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"q", "=", 
       RowBox[{"KeySelect", "[", 
        RowBox[{"q", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"q", "[", "#", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "<", 
           "tol"}], "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"q", "=", 
       RowBox[{"Association", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"N", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"#2", "[", 
               RowBox[{"[", 
                RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], 
           "&"}], ",", "q"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"spaces", "=", 
       RowBox[{"edgeRefine", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Basis\>\"", "->", 
             RowBox[{"IdentityMatrix", "[", 
              RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"<|", 
              RowBox[{"\"\<mBulk\>\"", "->", "mu"}], "|>"}]}]}], "|>"}], 
          "}"}], ",", "q", ",", "tol"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"ss", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"diagonalizeBlock", "[", 
          RowBox[{"#", ",", "h", ",", "ids", ",", "tol"}], "]"}], "&"}], " ", 
        "/@", " ", "spaces"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"k", "++"}], ";", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"states", ",", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<ID\>\"", "->", "k"}], ",", 
               RowBox[{"\"\<Labels\>\"", "->", 
                RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
               RowBox[{"\"\<Level\>\"", "->", "j"}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"s", "[", "\"\<Dimension\>\"", "]"}]}], ",", "\n", 
               "   ", 
               RowBox[{"\"\<Energy\>\"", "->", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Vector\>\"", "->", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}], "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}], "|>"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"s", "[", "\"\<Dimension\>\"", "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"s", ",", "ss"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "states", "]"}], "==", 
         RowBox[{"Length", "[", "ids", "]"}]}], 
        ",", "\"\<Incomplete isolated-bulk basis.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Model\>\"", "->", 
         RowBox[{"KeyTake", "[", 
          RowBox[{"p", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\""}], 
            "}"}]}], "]"}]}], ",", 
        RowBox[{"\"\<Mu\>\"", "->", "mu"}], ",", 
        RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", 
        RowBox[{"\"\<Hamiltonian\>\"", "->", "h"}], ",", 
        RowBox[{"\"\<States\>\"", "->", "states"}], ",", 
        RowBox[{"\"\<Tolerance\>\"", "->", "tol"}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkEigenKet", "[", 
    RowBox[{"cat_", ",", "id_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "s", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"1", "<=", "id", "<=", 
         RowBox[{"Length", "[", 
          RowBox[{"cat", "[", "\"\<States\>\"", "]"}], "]"}]}], 
        ",", "\"\<Bulk eigenstate ID out of range.\>\""}], "]"}], ";", 
      RowBox[{"s", "=", 
       RowBox[{
        RowBox[{"cat", "[", "\"\<States\>\"", "]"}], "[", 
        RowBox[{"[", "id", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Normal", "[", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Thread", "[", 
          RowBox[{
           RowBox[{"cat", "[", "\"\<Indices\>\"", "]"}], "->", 
           RowBox[{"s", "[", "\"\<Vector\>\"", "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"cat", "[", "\"\<Model\>\"", "]"}], "[", "\"\<L\>\"", 
              "]"}], "-", "2"}], ")"}]}], "}"}]}], "]"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkEigenSpec", "[", 
    RowBox[{"cat_", ",", "id_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Eigenvector\>\""}], ",", 
     RowBox[{"\"\<Model\>\"", "->", 
      RowBox[{"cat", "[", "\"\<Model\>\"", "]"}]}], ",", 
     RowBox[{"\"\<State\>\"", "->", 
      RowBox[{"bulkEigenKet", "[", 
       RowBox[{"cat", ",", "id"}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<Selection\>\"", "->", 
      RowBox[{"KeyDrop", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cat", "[", "\"\<States\>\"", "]"}], "[", 
         RowBox[{"[", "id", "]"}], "]"}], ",", 
        RowBox[{"{", "\"\<Vector\>\"", "}"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Mu\>\"", "->", 
      RowBox[{"cat", "[", "\"\<Mu\>\"", "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkSelectedKet", "[", 
    RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"cat", ",", "ss", ",", "ket", ",", "e", ",", "h"}], "}"}], ",", 
     "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], 
         "===", "\"\<Eigenvector\>\""}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{"And", "@@", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{"#1", "==", "#2"}], "]"}], "&"}], ",", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Lookup", "[", 
                 RowBox[{
                  RowBox[{"spec", "[", "\"\<Model\>\"", "]"}], ",", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", 
                    ",", "\"\<Delta\>\""}], "}"}]}], "]"}], ",", 
                RowBox[{"Lookup", "[", 
                 RowBox[{"p", ",", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", 
                    ",", "\"\<Delta\>\""}], "}"}]}], "]"}]}], "}"}]}], 
             "]"}]}], 
           ",", "\"\<Saved eigenvector belongs to a different L,J,Delta. \
Rebuild it for this bulk.\>\""}], "]"}], ";", "\n", "  ", 
         RowBox[{"ket", "=", 
          RowBox[{"spec", "[", "\"\<State\>\"", "]"}]}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"cat", "=", 
          RowBox[{"bulkEigenCatalog", "[", 
           RowBox[{"p", ",", 
            RowBox[{"spec", "[", "\"\<Mu\>\"", "]"}], ",", "tol"}], "]"}]}], ";",
          "\n", "  ", 
         RowBox[{"ss", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"cat", "[", "\"\<States\>\"", "]"}], ",", 
            RowBox[{"Function", "[", 
             RowBox[{"s", ",", 
              RowBox[{
               RowBox[{"And", "@@", 
                RowBox[{"KeyValueMap", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                    RowBox[{"Lookup", "[", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "#1", ",", 
                    RowBox[{"Missing", "[", "]"}]}], "]"}], "==", "#2"}], 
                   "&"}], ",", 
                  RowBox[{"spec", "[", "\"\<Sector\>\"", "]"}]}], "]"}]}], 
               " ", "&&", " ", 
               RowBox[{
                RowBox[{"s", "[", "\"\<Level\>\"", "]"}], "==", 
                RowBox[{"spec", "[", "\"\<Level\>\"", "]"}]}]}]}], "]"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "ss", "]"}], "==", "1"}], 
           ",", "\"\<Sector/level must select exactly one bulk eigenstate; \
include any extra spin label at Delta=+/-1.\>\""}], "]"}], ";", "\n", "  ", 
         RowBox[{"ket", "=", 
          RowBox[{"bulkEigenKet", "[", 
           RowBox[{"cat", ",", 
            RowBox[{
             RowBox[{"First", "[", "ss", "]"}], "[", "\"\<ID\>\"", "]"}]}], 
           "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"ket", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "ket", "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], " ",
          "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Norm", "[", "ket", "]"}], "-", "1"}], "]"}], "<", 
          RowBox[{"100", " ", "tol"}]}]}], 
        ",", "\"\<Invalid bulk eigenket.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"bulkHamiltonian", "[", "p", "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{
        RowBox[{"Conjugate", "[", "ket", "]"}], " ", ".", " ", 
        RowBox[{"(", 
         RowBox[{"h", " ", ".", " ", "ket"}], ")"}]}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"h", " ", ".", " ", "ket"}], "-", 
           RowBox[{"e", " ", "ket"}]}], "]"}], "<", 
         RowBox[{"100", " ", "tol", " ", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Norm", "[", 
             RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], 
        ",", "\"\<Bulk input is not an eigenvector of the current H0.\>\""}], 
       "]"}], ";", "ket"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"boundaryResponse", "[", 
    RowBox[{"cat_", ",", 
     RowBox[{"gapTol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"cat", "[", "\"\<Model\>\"", "]"}], "[", "\"\<L\>\"", "]"}],
          "-", "2"}]}], ",", 
       RowBox[{"ids", "=", 
        RowBox[{"cat", "[", "\"\<Indices\>\"", "]"}]}], ",", "v", ",", "e", ",",
        "zl", ",", "zr", ",", "a", ",", "b", ",", "d", ",", "keep", ",", 
       "near", ",", "chi", ",", "rows"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"cat", "[", "\"\<States\>\"", "]"}], ",", "\"\<Vector\>\""}],
         "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{
         RowBox[{"cat", "[", "\"\<States\>\"", "]"}], ",", "\"\<Energy\>\""}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"zl", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"siteOp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "1", ",",
             "n"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"zr", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{
          RowBox[{"siteOp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "n", ",",
             "n"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"a", "=", 
       RowBox[{
        RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "zl", " ", ".", 
        " ", 
        RowBox[{"Transpose", "[", "v", "]"}]}]}], ";", 
      RowBox[{"b", "=", 
       RowBox[{
        RowBox[{"Conjugate", "[", "v", "]"}], " ", ".", " ", "zr", " ", ".", 
        " ", 
        RowBox[{"Transpose", "[", "v", "]"}]}]}], ";", "\n", " ", 
      RowBox[{"rows", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"d", "=", 
           RowBox[{"e", "-", 
            RowBox[{"e", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}]}], ";", 
          RowBox[{"near", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"Length", "[", "e", "]"}], "]"}], ",", "j"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"d", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], "<=", 
               RowBox[{"gapTol", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], "&"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"keep", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"Length", "[", "e", "]"}], "]"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{"near", ",", "j"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"chi", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"near", "===", 
              RowBox[{"{", "}"}]}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"a", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                    "2"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}], ",", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"a", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], " ", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}]}], "]"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
                "}"}], ",", "\n", "   ", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{"Re", "[", 
                    RowBox[{
                    RowBox[{"Conjugate", "[", 
                    RowBox[{"a", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], " ", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}]}], "]"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}], ",", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{"b", "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                    "2"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}]}], 
                "}"}]}], "}"}], ",", 
             RowBox[{
             "Missing", "[", "\"\<DegenerateOrUnresolved\>\"", "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"KeyDrop", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"cat", "[", "\"\<States\>\"", "]"}], "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"{", "\"\<Vector\>\"", "}"}]}], "]"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<DegeneratePartners\>\"", "->", "near"}], ",", 
              RowBox[{"\"\<ChiTensor\>\"", "->", "chi"}], ",", "\n", "   ", 
              RowBox[{"\"\<ChiPlus\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MatrixQ", "[", "chi", "]"}], ",", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "+", "b"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                    "2"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}], ",",
                  "chi"}], "]"}]}], ",", 
              RowBox[{"\"\<ChiMinus\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MatrixQ", "[", "chi", "]"}], ",", 
                 RowBox[{"Total", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{"a", "-", "b"}], ")"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"keep", ",", "j"}], "]"}], "]"}], "]"}], "^", 
                    "2"}], "/", 
                   RowBox[{
                    RowBox[{"d", "[", 
                    RowBox[{"[", "keep", "]"}], "]"}], "^", "2"}]}], "]"}], ",",
                  "chi"}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"\"\<VariancePlus\>\"", "->", 
