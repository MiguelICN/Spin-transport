          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<results.wxf\>\""}], "}"}], "]"}], ",", 
           "data", ",", "\"\<WXF\>\""}], "]"}], "]"}], 
        ",", "\"\<Numerical data export failed.\>\""}], "]"}], ";", "dir"}]}],
     "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[89]:=",ExpressionUUID->"faed67d9-6f9b-ff4d-835a-4c44d4c702c3"],

