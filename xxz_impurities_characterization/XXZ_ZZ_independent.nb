 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"statGSeconds", ",", "statGRun"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"staticScan", "[", 
     RowBox[{
     "statGModel", ",", "\"\<g\>\"", ",", "statGGrid", ",", 
      "statGEDTolerance"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
