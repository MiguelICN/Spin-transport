Cell[" 1B.4 MaTeX figures and numerical export ", "Subsection",ExpressionUUID->"f83fda0d-7642-dc46-b6a0-c26af2b57b2e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"susCaption", "=", 
   RowBox[{"Column", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"tex", "[", 
       RowBox[{
        RowBox[{"\"\<H_0:\\\\quad N=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{
           RowBox[{"susModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], "]"}], 
         "<>", "\"\<;\\\\quad J=\>\"", "<>", 
         RowBox[{"texNumber", "[", 
          RowBox[{"susModel", "[", "\"\<J\>\"", "]"}], "]"}], 
         "<>", "\"\<;\\\\quad \\\\Delta=\>\"", "<>", 
         RowBox[{"texNumber", "[", 
          RowBox[{"susModel", "[", "\"\<Delta\>\"", "]"}], "]"}], 
         "<>", "\"\<;\\\\quad \\\\mu=\>\"", "<>", 
         RowBox[{"texNumber", "[", "susMu", "]"}]}], ",", "13"}], "]"}], ",", 
      "\n", " ", 
      RowBox[{"tex", "[", 
       RowBox[{
        RowBox[{"\"\<\\\\text{all parity sectors in the fixed magnetization \
space};\\\\quad d=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "susRows", "]"}], "]"}]}], ",", "12"}], 
       "]"}]}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"susPlots", "=", 
   RowBox[{"<|", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pts", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", "\"\<Energy\>\"", "]"}], ",", 
             RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{"susRows", ",", 
            RowBox[{
             RowBox[{"NumericQ", "[", 
              RowBox[{"#", "[", "key", "]"}], "]"}], "&"}]}], "]"}]}], 
         ")"}]}], "}"}], ",", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"pts", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"AssociateTo", "[", 
         RowBox[{"susPlots", ",", 
          RowBox[{"key", "->", 
           RowBox[{"plotPanel", "[", 
            
            RowBox[{"\"\<\\\\text{Boundary fidelity susceptibility}\>\"", ",",
              "susCaption", ",", "\n", " ", 
             RowBox[{"Block", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
               RowBox[{"framePlot", "[", 
                RowBox[{
                 RowBox[{"{", "pts", "}"}], ",", "\"\<E_n\>\"", ",", 
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"key", "===", "\"\<ChiPlus\>\""}], 
                   ",", "\"\<\\\\chi_n^{(+)}\>\"", 
                   ",", "\"\<\\\\chi_n^{(-)}\>\""}], "]"}], ",", 
                 RowBox[{"{", "Blue", "}"}], ",", 
                 RowBox[{"{", "}"}], ",", "False", ",", "False", ",", 
                 RowBox[{"{", 
                  RowBox[{"{", 
                   RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], 
                  "}"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}]}], 
     "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"key", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<ChiPlus\>\"", ",", "\"\<ChiMinus\>\""}], "}"}]}], "}"}]}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "susPeaks", "]"}], ">", "0"}], ",", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"susPlots", ",", 
        RowBox[{"key", "->", 
         RowBox[{"plotPanel", "[", 
          
          RowBox[{"\"\<\\\\text{Discrete boundary transition weights}\>\"", ",",
            "susCaption", ",", "\n", " ", 
           RowBox[{"Block", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
             RowBox[{"framePlot", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<Omega\>\"", "]"}], ",", 
                    RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@",
                   " ", "susPeaks"}], ")"}], "}"}], ",", "\"\<E_m-E_n\>\"", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"key", "===", "\"\<WeightPlus\>\""}], 
                 ",", "\"\<|\\\\langle m|V_+|n\\\\rangle|^2\>\"", 
                 ",", "\"\<|\\\\langle m|V_-|n\\\\rangle|^2\>\""}], "]"}], ",", 
               RowBox[{"{", "Blue", "}"}], ",", 
               RowBox[{"{", "}"}], ",", "False", ",", "False", ",", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], "}"}], 
               ",", 
               RowBox[{"\"\<n_{\\\\rm ID}=\>\"", "<>", 
                RowBox[{"ToString", "[", "susSelectedID", "]"}]}]}], "]"}]}], 
            "]"}]}], "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"key", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<WeightPlus\>\"", ",", "\"\<WeightMinus\>\""}], "}"}]}], 
       "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"ListQ", "[", "susFidelity", "]"}], ",", 
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"rr", "=", 
          RowBox[{"Select", "[", 
           RowBox[{"susFidelity", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Sign\>\"", "]"}], "==", "sgn"}], "&"}]}],
            "]"}]}], "}"}], ",", "\n", " ", 
        RowBox[{"AssociateTo", "[", 
         RowBox[{"susPlots", ",", 
          RowBox[{
           RowBox[{"\"\<Fidelity_\>\"", "<>", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"sgn", "==", "1"}], ",", "\"\<plus\>\"", 
              ",", "\"\<minus\>\""}], "]"}]}], "->", 
           RowBox[{"plotPanel", "[", 
            
            RowBox[{"\"\<\\\\text{Weak-field fidelity check}\>\"", ",", 
             "susCaption", ",", "\n", " ", 
             RowBox[{"Block", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
               RowBox[{"framePlot", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<g\>\"", "]"}], ",", 
                    RowBox[{"#", "[", "\"\<Infidelity\>\"", "]"}]}], "}"}], 
                    "&"}], " ", "/@", " ", "rr"}], ")"}], ",", 
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"#", "[", "\"\<g\>\"", "]"}], ",", 
                    RowBox[{"#", "[", "\"\<Prediction\>\"", "]"}]}], "}"}], 
                    "&"}], " ", "/@", " ", "rr"}], ")"}]}], "}"}], 
                 ",", "\"\<g\>\"", ",", "\"\<1-F_n\>\"", ",", 
                 RowBox[{"{", 
                  RowBox[{"Blue", ",", "Red"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<1-F_n\>\"", ",", "\"\<g^2\\\\chi_n/4\>\""}], 
                  "}"}], ",", "False", ",", "False", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"\"\<\[EmptySquare]\>\"", ",", "4"}], "}"}]}], 
                  "}"}]}], "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"sgn", ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", 
          RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Length", "[", "susPlots", "]"}], ">", "0"}], ",", 
    RowBox[{"Print", "[", 
     RowBox[{"Column", "[", 
      RowBox[{"Values", "[", "susPlots", "]"}], "]"}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"susDirectory", "=", 
   RowBox[{"exportBundle", "[", 
    RowBox[{
    "susOutputRoot", ",", "\"\<ZZ_bulk_susceptibility\>\"", ",", "susPlots", ",",
      "\n", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Response\>\"", "->", "susResponse"}], ",", 
       RowBox[{"\"\<RankKey\>\"", "->", "susRankKey"}], ",", 
       RowBox[{"\"\<EnergyWindow\>\"", "->", "susEnergyWindow"}], ",", 
       RowBox[{"\"\<RankedIDs\>\"", "->", 
        RowBox[{"Lookup", "[", 
         RowBox[{"susRanked", ",", "\"\<ID\>\""}], "]"}]}], ",", 
       RowBox[{"\"\<SelectedBulk\>\"", "->", "susSelectedBulk"}], ",", 
       RowBox[{"\"\<Peaks\>\"", "->", "susPeaks"}], ",", 
       RowBox[{"\"\<FidelityCheck\>\"", "->", "susFidelity"}]}], "|>"}]}], 
    "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->
  "In[578]:=",ExpressionUUID->"47fc4964-b319-7c47-83b4-ae88f444d1e8"],

