Cell[CellGroupData[{

Cell["\<\
  3.5 Compute Choi states, transfer matrices and map observables  \
\>", "Subsection",ExpressionUUID->"ea08afb9-7d91-f145-ac81-5cfae2d03f9b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapTimeUsed", "=", "mapTime"}], ";", 
  RowBox[{"mapTimes", "=", 
   RowBox[{"timeGrid", "[", "mapTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mapSeconds", ",", "mapChannelRun"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"chTrajectory", "[", 
     RowBox[{
     "mapEngine", ",", "mapTimes", ",", "mapSettingsUsed", ",", 
      "mapProbesUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapRecords", "=", 
   RowBox[{"mapChannelRun", "[", "\"\<Records\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapPlotSnapshot", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
     RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
     RowBox[{"\"\<Times\>\"", "->", 
      RowBox[{"Lookup", "[", 
       RowBox[{"mapRecords", ",", "\"\<Time\>\""}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mapSummary", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<SignalThreshold\>\"", "->", 
      RowBox[{"mapSettingsUsed", "[", "\"\<SignalThreshold\>\"", "]"}]}], ",",
      "\n", " ", 
     RowBox[{"\"\<SignalOnset\>\"", "->", 
      RowBox[{"onsetTime", "[", 
       RowBox[{"mapTimes", ",", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mapRecords", ",", "\"\<SignalAtoB\>\""}], "]"}], ",", 
        RowBox[{"mapSettingsUsed", "[", "\"\<SignalThreshold\>\"", "]"}]}], 
       "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<BLPGridLowerBound\>\"", "->", 
      RowBox[{
       RowBox[{"Last", "[", "mapRecords", "]"}], "[", "\"\<BLPAccumulated\>\"",
        "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<RHPValidSteps\>\"", "->", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{"mapRecords", ",", "\"\<RHPFiniteStep\>\""}], "]"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<TPError\>\"", 
          ",", "\"\<MinChoiEigenvalue\>\"", ",", "\"\<MapEntropy\>\"", 
          ",", "\"\<MinSingularValue\>\""}], "}"}]}], "]"}], "&"}], " ", "/@",
      " ", 
     RowBox[{"Take", "[", 
      RowBox[{"mapRecords", ",", 
       RowBox[{"UpTo", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"ece15a73-11fb-bc4e-9013-\
26eea00b5826"],

Cell["\<\
  The derivative of the unitary factor is analytic, using -i E exp(-i E t). \
Near-singular transfer matrices produce Missing values for the generator and \
divisibility diagnostics; no pseudoinverse is substituted. Covariance is \
tested for the chosen bulk preparation, which may break symmetries of H. Rate \
normalization uses G_(mu,nu)=sigma_mu tensor sigma_nu / 2.  \
\>", "Text",ExpressionUUID->"dc2551c5-2680-fd45-85c1-409de27719cc"],

Cell["\<\
  The fast spectral average uses same-bulk-sector overlap contractions for \
ZZ. Exchange uses vectorized singleton contributions and coherent Choi \
factors for globally degenerate clusters. Large mixed factors and highly \
degenerate clusters still have substantial memory costs. Chunk limits bound \
individual working arrays, not total peak memory.  \
\>", "Text",ExpressionUUID->"9316c0ed-b688-2745-b86e-296caf0de3ab"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  3.5a Conjugate-bulk time-reversal check; reuse the eigensystem  \
\>", "Subsection",ExpressionUUID->"2ae8c84f-6c6f-c04d-a150-219b3f7447e0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapTimeReversal", "=", 
   RowBox[{"chTimeReversal", "[", 
    RowBox[{"mapEngine", ",", "mapTimes", ",", "mapSettingsUsed"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mapRecords", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
        RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"mapRecords", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{"\"\<TimeReversalError\>\"", "->", 
         RowBox[{
          RowBox[{"mapTimeReversal", "[", "\"\<Errors\>\"", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "|>"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "]"}]}], 
     "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "mapTimeReversal", "]"}], ";"}], "\n"}], "Code",Expres\
sionUUID->"e987da7f-6849-7f4d-8d62-5e14de32cf0f"],

Cell["\<\
  For complex bulk states the valid relation is \
S[-t;rhoM]=Conjugate[S[t;Conjugate[rhoM]]]. The check conjugates eigenbasis \
coefficients and reuses eigenvectors; it never assumes the same complex bulk \
is time-reversal invariant. Unsampled rows carry Missing[NotSampled]. ZZ \
canonical rates use a 3-by-3 projected dephasing generator plus twelve zero \
rates; its intermediate-map support minimum is shown separately from the full \
Choi minimum, which includes twelve exact zeros.  \
\>", "Text",ExpressionUUID->"c22f5eab-090c-0647-b2d5-d8d484a29ed2"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  3.6 Optional infinite-time average across all energy-degenerate sectors  \
\>", "Subsection",ExpressionUUID->"eb32bf00-a173-3848-9f71-73a82f1786cd"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapAverage", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "mapComputeInfiniteTimeAverage", "]"}], ",", "\n", 
     " ", 
     RowBox[{"chAverage", "[", 
      RowBox[{"mapEngine", ",", 
       RowBox[{
       "mapSettingsUsed", "[", "\"\<AverageEnergyTolerance\>\"", "]"}]}], 
      "]"}], ",", 
     RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AssociationQ", "[", "mapAverage", "]"}], ",", 
    RowBox[{"Print", "[", 
     RowBox[{"Dataset", "[", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"mapAverage", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<TPError\>\"", ",", "\"\<MapEntropy\>\"", 
          ",", "\"\<ChoiPTMinimum\>\"", ",", "\"\<MaxClusterWidth\>\""}], 
         "}"}]}], "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n"}], "Code",Expressi\
onUUID->"dbdf19b5-1c5d-c949-94f3-15346f32c6cd"],

Cell["\<\
  Exchange clusters span all occupied total-magnetization sectors. ZZ needs \
only equal-energy contributions within the same bulk-magnetization sector, \
since the partial trace annihilates cross-bulk-sector terms. Both use bounded \
cluster width, not transitive chains of near-equalities. Vary \
AverageEnergyTolerance; exact degeneracies are preserved. The result is a \
spectral infinite-time average.  \
\>", "Text",ExpressionUUID->"3f39acc9-6411-c441-822a-75b59e02513a"]
}, Closed]],

Cell[CellGroupData[{

Cell["  3.7 MaTeX plots  ", "Subsection",ExpressionUUID->"1bb275ab-94ed-e54f-9502-1ba91d21b682"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"AssociationQ", "[", "mapPlotSnapshot", "]"}]}], ",", 
    RowBox[{"mapPlotSnapshot", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
       RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
       RowBox[{"\"\<Times\>\"", "->", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mapRecords", ",", "\"\<Time\>\""}], "]"}]}]}], "|>"}]}]}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chopRecordsInPlace", "[", 
    RowBox[{"mapRecords", ",", "recordChopTolerance"}], "]"}], ";"}], "\n", 
  "\n", "\n"}], "\n"}], "Code",ExpressionUUID->"2bd53557-b3dc-9a44-bd70-\
d93d41382f00"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapPlotsUsed", "=", 
   RowBox[{"chPlots", "[", 
    RowBox[{
    "mapRecords", ",", "mapPlotSnapshot", ",", "mapLogHorizontalAxis"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"mapPlotsUsed", "[", "\"\<MapEntropy\>\"", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"3581dbb0-fc82-6743-a6e2-\
9aaadfcb447c"]
}, Closed]],

Cell[CellGroupData[{

Cell["  3.8 Export this independent map run  ", "Subsection",ExpressionUUID->"b05b3637-ffc9-8c44-a5a3-9064a9b30973"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapDirectory", "=", 
   RowBox[{"exportBundle", "[", 
    RowBox[{
    "mapOutputRoot", ",", "mapRunLabel", ",", "mapPlotsUsed", ",", "\n", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
       RowBox[{"\"\<BulkSpecification\>\"", "->", "mapBulkUsed"}], ",", 
       RowBox[{"\"\<BulkFactor\>\"", "->", "mapBulkFactor"}], ",", "\n", " ", 
       RowBox[{"\"\<Settings\>\"", "->", "mapSettingsUsed"}], ",", 
       RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
       RowBox[{"\"\<Times\>\"", "->", "mapTimes"}], ",", "\n", " ", 
       RowBox[{"\"\<Probes\>\"", "->", "mapProbesUsed"}], ",", 
       RowBox[{"\"\<Summary\>\"", "->", "mapSummary"}], ",", 
       RowBox[{"\"\<Performance\>\"", "->", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"mapChannelRun", ",", 
          RowBox[{"{", "\"\<Records\>\"", "}"}]}], "]"}]}], ",", 
       RowBox[{"\"\<TimeReversalCheck\>\"", "->", "mapTimeReversal"}], ",", 
       RowBox[{"\"\<Engine\>\"", "->", "mapEngine"}], ",", 
       RowBox[{"\"\<Records\>\"", "->", "mapRecords"}], ",", 
       RowBox[{"\"\<InfiniteTimeAverage\>\"", "->", "mapAverage"}], ",", "\n",
        " ", 
       RowBox[{"\"\<SetupSeconds\>\"", "->", "mapSetupSeconds"}], ",", 
       RowBox[{"\"\<EvolutionSeconds\>\"", "->", "mapSeconds"}]}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "mapDirectory", "]"}], ";"}], "\n"}], "Code",Expressio\
nUUID->"440ecf3f-5dd0-4941-bc90-027b3cf95396"],

Cell["\<\
  Examples for direct use: applyTransfer[mapRecords[[k]][\"Transfer\"],rhoAB] \
predicts any product-preparation edge input; mapRecords[[k]][\"ChoiState\"] \
is the normalized input-output Choi state. No chapter-2 evaluation is used.  \
\>", "Text",ExpressionUUID->"8d297c81-fb13-c44f-965a-688aa4c46388"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["  4. Quantum-state texture of the edge spins  ", "Title",ExpressionUUID->"56bfadf4-5e1b-b44d-8d8e-59c7cd0297d3"],

Cell[CellGroupData[{

Cell["  4.1 Definitions shared only by the QST sections  ", "Subsection",ExpressionUUID->"998d5572-d036-9a44-abfa-e333e778b9da"],

Cell["\<\
  Sections A and B reuse initialization definitions, never evaluated results \
of chapters 1\[Dash]3 or of each other. Only the two edges are placed in \
f1=|++><++|; an all-plus bulk is excluded. The basis is {00,01,10,11}, with \
bit 0=up. All quantities are basis dependent. Sigma(rho)=sum of every matrix \
entry=D <f1|rho|f1>; TF=1-Sigma/D; R=-log(Sigma/D). D=4 for the pair and D=2 \
for a single edge. SigmaAB/4 is the probability of ++ (Hadamards followed by \
00). Nonmultiplicativity is SigmaAB-SigmaA SigmaB; l1 coherence sums absolute \
off-diagonal entries. References: the supplied QST specification, [P] de Leon \
et al., Role of quantum state texture in quantum chaos (draft), and [V] \
Vieira et al., arXiv:2609.05248. No claim about chaos follows from texture \
alone.  \
\>", "Text",ExpressionUUID->"a19f200a-9016-2844-a7e7-c7c15156d68c"],

Cell[CellGroupData[{

Cell["  Texture, evolution, averages and validation  ", "Subsubsection",ExpressionUUID->"bd95e7d1-6adc-9e4c-b3b5-5ec4b58f8d2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "edgeF1Ket", ",", "edgeF1", ",", "grandSum", ",", "textureF", ",", 
    "rugosity", ",", "l1Coherence", ",", "textureRecords", ",", "\n", " ", 
    "responseOperator", ",", "texturizingRecord", ",", "qstBulkFactor", ",", 
    "qstRunChunks", ",", "qstStateChunk", ",", "qstMapChunk", ",", "\n", " ", 
    "qstStateRecords", ",", "qstMapRecords", ",", "qstAverageState", ",", 
    "qstAverageChannel", ",", "qstWindowMean", ",", "\n", " ", 
    "qstReferenceTrace", ",", "qstReferenceEmbed", ",", "qstSmallReference", ",",
     "qstStateChecks", ",", "qstMapChecks", ",", "\n", " ", 
    "qstRandomResponseCheck", ",", "qstCompare", ",", "qstSaveComparison", ",",
     "qstEdgeConservationError", ",", "qstTex", ",", "qstTicks", ",", 
    "qstCaption", ",", "qstPanel", ",", "\n", " ", "texturePanels", ",", 
    "texturizingPanels", ",", "qstExport"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeF1Ket", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], ";", 
  RowBox[{"edgeF1", "=", 
   RowBox[{"ketRho", "[", "edgeF1Ket", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"grandSum", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", "r", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"textureF", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"grandSum", "[", "r", "]"}], "/", 
     RowBox[{"Length", "[", "r", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rugosity", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{"grandSum", "[", "r", "]"}], "/", 
        RowBox[{"Length", "[", "r", "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"p", "==", "0"}], "]"}], ",", "Infinity", ",", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"p", ">", "0"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Log", "[", "p", "]"}]}], ",", "True", ",", 
       RowBox[{"Missing", "[", 
        RowBox[{"\"\<NegativeGrandSum\>\"", ",", "p"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"l1Coherence", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Abs", "[", "r", "]"}], "]"}], "]"}], "-", 
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Diagonal", "[", "r", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"textureRecords", "[", "records_List", "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"rec", ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "=", 
            RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", 
           RowBox[{"a", "=", 
            RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
           RowBox[{"b", "=", 
            RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}]}], "}"}], ",", "\n", 
         " ", 
         RowBox[{"Join", "[", 
          RowBox[{"rec", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<SigmaAB\>\"", "->", 
              RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<SigmaA\>\"", "->", 
              RowBox[{"grandSum", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<SigmaB\>\"", "->", 
              RowBox[{"grandSum", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<TextureFAB\>\"", "->", 
              RowBox[{"textureF", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<TextureFA\>\"", "->", 
              RowBox[{"textureF", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<TextureFB\>\"", "->", 
              RowBox[{"textureF", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<RugosityAB\>\"", "->", 
              RowBox[{"rugosity", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<RugosityA\>\"", "->", 
              RowBox[{"rugosity", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<RugosityB\>\"", "->", 
              RowBox[{"rugosity", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<Nonmultiplicativity\>\"", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"grandSum", "[", "r", "]"}], "-", 
                RowBox[{
                 RowBox[{"grandSum", "[", "a", "]"}], " ", 
                 RowBox[{"grandSum", "[", "b", "]"}]}]}], ")"}]}], ",", "\n", 
             " ", 
             RowBox[{"\"\<L1Coherence\>\"", "->", 
              RowBox[{"l1Coherence", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<L1Normalized\>\"", "->", 
              RowBox[{
               RowBox[{"l1Coherence", "[", "r", "]"}], "/", "3"}]}], ",", 
             "\n", " ", 
             RowBox[{"\"\<LinearEntropy\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{"rec", "[", "\"\<Purity\>\"", "]"}]}]}], ",", 
             RowBox[{"\"\<NormalizedEntropy\>\"", "->", 
              RowBox[{
               RowBox[{"rec", "[", "\"\<EntropyAB\>\"", "]"}], "/", 
               RowBox[{"Log", "[", "4", "]"}]}]}], ",", "\n", " ", 
             RowBox[{"\"\<F1Probability\>\"", "->", 
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
                "r", " ", ".", " ", "edgeF1Ket"}], "]"}]}]}], "|>"}]}], 
          "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"responseOperator", "[", 
     RowBox[{"s_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
    RowBox[{"Transpose", "[", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Total", "[", "s", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", "\n", 
  "\n"}], "\n"}], "Code",ExpressionUUID->"c045f46e-d9d8-2b47-9c8f-\
b4f7c34604bb"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstBulkFactor", "[", 
     RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "f", ",", 
        "theta", ",", "phi", ",", "prob"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], 
           "==", "\"\<PolarHelix\>\""}], ",", "\n", "  ", 
          RowBox[{
           RowBox[{"theta", "=", 
            RowBox[{"spec", "[", "\"\<ThetaList\>\"", "]"}]}], ";", 
           RowBox[{"phi", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"spec", ",", "\"\<PhiList\>\"", ",", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", "n"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "theta", "]"}], "==", "n"}], " ", "&&", 
              " ", 
              RowBox[{
               RowBox[{"Length", "[", "phi", "]"}], "==", "n"}], " ", "&&", 
              " ", 
              RowBox[{"AllTrue", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{"theta", ",", "phi"}], "]"}], ",", "realQ"}], 
               "]"}]}], ",", "\n", 
             "   ", "\"\<PolarHelix requires real ThetaList and PhiList with \
L-2 entries.\>\""}], "]"}], ";", "\n", "  ", 
           RowBox[{"stateFactor", "[", 
            RowBox[{
             RowBox[{"productKet", "[", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Cos", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"I", " ", "#2"}], "]"}], " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}]}]}], "}"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theta", ",", "phi"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"2", "^", "n"}], ",", "tol"}], "]"}]}], ",", "\n", "  ", 
          RowBox[{"bulkFactor", "[", 
           RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"prob", "=", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "^", "n"}], "]"}]}], ",", 
             RowBox[{"2", "^", "n"}]}], "]"}], " ", ".", " ", "f"}], "]"}], "^",
          "2"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"1", "-", "prob"}], "]"}], ">", "tol"}], 
         ",", "\"\<QST: an all-plus bulk is excluded; f1 is reserved for the \
two edges.\>\""}], "]"}], ";", "f"}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
  "\n", "\n"}]], "Code",ExpressionUUID->"6c760096-7bcd-ff47-aa0b-\
ff371ab7a5be"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstRunChunks", "[", 
    RowBox[{"fn_", ",", "times_List", ",", "eng_", ",", "cfg_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bytes", ",", "size", ",", "chunks", ",", "results", ",", 
       RowBox[{"kernels", "=", "1"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
         RowBox[{"And", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], "]"}]}]}],
         ",", "\"\<QST times must increase.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], ">", "0"}], " ", "&&",
          "\n", "  ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<Invalid QST parallel/batch settings.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
           RowBox[{"Quiet", "[", 
            RowBox[{"LaunchKernels", "[", 
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], "]"}]}], 
          "]"}], ";", "\n", "  ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}], 
           ",", "\"\<No parallel kernels available. Set Enabled->False for \
serial batches.\>\""}], "]"}], ";", "\n", "  ", 
         RowBox[{"kernels", "=", 
          RowBox[{"Length", "[", 
           RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{"qstStateChunk", ",", "qstMapChunk"}], "]"}]}]}], "]"}], ";",
       "\n", " ", 
      RowBox[{"bytes", "=", 
       RowBox[{"16", " ", 
        RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}], " ", 
        RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}]}], ";", "\n", " ", 
      RowBox[{"size", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], " ", 
           RowBox[{
            RowBox[{"2", "^", "20"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "kernels", " ", "bytes"}], ")"}]}]}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"size", ">=", "1"}], ",", 
        RowBox[{"\"\<QST batch memory budget is too small. Minimum MemoryMB \
for one factor per worker: \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"4", " ", "kernels", " ", 
            RowBox[{"bytes", "/", 
             RowBox[{"2", "^", "20"}]}]}], "]"}], "]"}], 
         "<>", "\"\<. This excludes eigensystems and retained \
records.\>\""}]}], "]"}], ";", "\n", " ", 
      RowBox[{"chunks", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"times", ",", 
         RowBox[{"UpTo", "[", "size", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"results", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"ts", ",", 
             RowBox[{"CheckAbort", "[", 
              RowBox[{
               RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
            "]"}], ",", "chunks", ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",", 
         "\n", "  ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"ts", ",", 
             RowBox[{"CheckAbort", "[", 
              RowBox[{
               RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
            "]"}], ",", "chunks"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "results", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "results", "]"}], "==", 
          RowBox[{"Length", "[", "chunks", "]"}]}], " ", "&&", "\n", "  ", 
         RowBox[{"And", "@@", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ListQ", "[", "#1", "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#1", "]"}], "==", 
                RowBox[{"Length", "[", "#2", "]"}]}], " ", "&&", " ", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"#1", ",", "AssociationQ"}], "]"}]}], ")"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"results", ",", "chunks"}], "}"}]}], "]"}]}]}], ",", 
        "\n", "  ", "\"\<A QST batch failed or aborted; no partial trajectory \
is returned.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"results", ",", "1"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstStateChunk", "[", 
    RowBox[{"times_", ",", "eng_", ",", "fac_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"evolveBatch", "[", 
         RowBox[{"times", ",", "eng"}], "]"}]}], ",", "rho0", ",", 
       "purity0"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rho0", "=", 
       RowBox[{"reducedState", "[", 
        RowBox[{"fac", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"purity0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
            "fac"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"stateRecord", "[", 
         RowBox[{
          RowBox[{"times", "[", 
           RowBox[{"[", "k", "]"}], "]"}], ",", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", "eng", ",",
           "fac", ",", "rho0", ",", "purity0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstStateRecords", "[", 
     RowBox[{"eng_", ",", "fac_", ",", "times_", ",", "cfg_"}], "]"}], " ", ":=",
     " ", 
    RowBox[{"textureRecords", "[", "\n", " ", 
     RowBox[{"qstRunChunks", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"ts", ",", 
         RowBox[{"qstStateChunk", "[", 
          RowBox[{"ts", ",", "eng", ",", "fac"}], "]"}]}], "]"}], ",", 
       "times", ",", "eng", ",", "cfg"}], "]"}], "]"}]}], ";"}], "\n", "\n", 
  "\n"}], "\n"}], "Code",ExpressionUUID->"56efb16e-1d72-4d48-a01d-\
daf5f9b917a1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"texturizingRecord", "[", 
    RowBox[{"t_", ",", "s_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"transferToChoi", "[", "s", "]"}]}], ",", "out", ",", "r", ",",
        "e", ",", "v", ",", "order", ",", "sig", ",", "p", ",", "ce", ",", 
       "mixed"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"applyTransfer", "[", 
        RowBox[{"s", ",", "edgeF1"}], "]"}]}], ";", 
      RowBox[{"r", "=", 
       RowBox[{"responseOperator", "[", "s", "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "v"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"herm", "[", "r", "]"}], "]"}]}], ";", 
      RowBox[{"order", "=", 
       RowBox[{"Ordering", "[", 
        RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"e", "[", 
         RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"v", "=", 
       RowBox[{"v", "[", 
        RowBox[{"[", "order", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"sig", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"grandSum", "[", "out", "]"}], ",", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "16"}], "]"}], " ", ".", " ", "s", " ", ".", 
            " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "16"}], "]"}]}], "]"}], "/", "4"}], ",", 
         RowBox[{
          RowBox[{"grandSum", "[", "c", "]"}], "/", "4"}]}], "}"}]}], ";", 
      "\n", " ", 
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{"sig", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}], ";", 
      RowBox[{"ce", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"herm", "[", "c", "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"mixed", "=", 
       RowBox[{"applyTransfer", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<Transfer\>\"", "->", "s"}], ",", 
          RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
          RowBox[{"\"\<ChoiState\>\"", "->", 
           RowBox[{"c", "/", "4"}]}], ",", 
          RowBox[{"\"\<OutputF1\>\"", "->", "out"}], ",", "\n", " ", 
          RowBox[{"\"\<SigmaRoutes\>\"", "->", "sig"}], ",", 
          RowBox[{"\"\<SigmaOutput\>\"", "->", 
           RowBox[{"First", "[", "sig", "]"}]}], ",", 
          RowBox[{"\"\<OmegaTF\>\"", "->", 
           RowBox[{"1", "-", "p"}]}], ",", "\n", " ", 
          RowBox[{"\"\<OmegaRoute1\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}]}], ",", 
          RowBox[{"\"\<OmegaRoute2\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "/", "4"}]}]}], ",", 
          RowBox[{"\"\<OmegaRoute3\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "/", "4"}]}]}], ",", "\n", " ", 
          RowBox[{"\"\<OmegaR\>\"", "->", 
           RowBox[{"rugosity", "[", "out", "]"}]}], ",", 
          RowBox[{"\"\<ResponseOperator\>\"", "->", "r"}], ",", 
          RowBox[{"\"\<ResponseEigenvalues\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<ResponseEigenvectors\>\"", "->", "v"}], ",", "\n", " ", 
          RowBox[{"\"\<ResponseMinimum\>\"", "->", 
           RowBox[{"First", "[", "e", "]"}]}], ",", 
          RowBox[{"\"\<ResponseMaximum\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<MinimumVectorF1Overlap\>\"", "->", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
              RowBox[{"First", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<MaximumVectorF1Overlap\>\"", "->", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
              RowBox[{"Last", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<ResponseTraceMinus4\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "r", "]"}], "-", "4"}], "]"}]}], ",", 
          RowBox[{"\"\<ResponseHermiticityError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"r", "-", 
             RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], "]"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<ResponseF1Error\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", 
              RowBox[{"r", " ", ".", " ", "edgeF1"}], "]"}], "-", 
             RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<RouteError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"sig", "-", 
             RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<FreeMaxDistance\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"out", "-", "edgeF1"}], "]"}]}], ",", 
          RowBox[{"\"\<FreeTraceDistance\>\"", "->", 
