Cell[" Negativity between spin 1 and spin L . ", "Text",ExpressionUUID->"812b5387-67a2-6745-92da-d7bc11eaf73c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ptB", "[", "r_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"r", ",", 
         RowBox[{"{", 
          RowBox[{"2", ",", "2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"negativity", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"Total", "[", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"-", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"herm", "[", 
           RowBox[{"ptB", "[", "r", " ", "]"}], "]"}], "]"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Concurrence", " ", "from", " ", "an", " ", "exact", " ", "reduced"}], "-", 
     RowBox[{"state", " ", "factor"}]}], ";", " ", 
    RowBox[{"stable", " ", "at", " ", "rank", " ", 
     RowBox[{"deficiency", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"concurrence", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", ",", "r", ",", "f", ",", "s"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"q", ",", "r"}], "}"}], "=", 
       RowBox[{"QRDecomposition", "[", 
        RowBox[{"ConjugateTranspose", "[", "a", " ", "]"}], "]"}]}], ";", " ", 
      RowBox[{"f", "=", 
       RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], ";", "\n", " ", 
      RowBox[{"s", "=", 
       RowBox[{"PadRight", "[", 
        RowBox[{
         RowBox[{"Reverse", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"SingularValueList", "[", "\n", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "f", "]"}], " ", ".", " ", 
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{
                RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
                RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
              " ", "f"}], ",", 
             RowBox[{"Tolerance", "->", "0"}]}], "]"}], "]"}], "]"}], ",", 
         "4"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"0.", ",", 
        RowBox[{
         RowBox[{"First", "[", "s", "]"}], "-", 
         RowBox[{"Total", "[", 
          RowBox[{"Rest", "[", "s", " ", "]"}], "]"}]}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[21]:=",ExpressionUUID->"94edfe7b-50c6-f145-b7d8-968846b0803b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Pure and mixed state constructors  ", "Subsubsection",ExpressionUUID->"86c20160-8c85-ec42-895f-43fd33310b70"],

Cell[" Tensor product of normalized local spinors . ", "Text",ExpressionUUID->"e8c6895f-7660-ba47-9f7c-9979657e26fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"productKet", "[", "locals_List", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "v", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", " ", 
          RowBox[{"AllTrue", "[", 
           RowBox[{"locals", ",", "\n", "  ", 
            RowBox[{
             RowBox[{
              RowBox[{"VectorQ", "[", 
               RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", " ", 
              RowBox[{
               RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
           "]"}]}], ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"v", "=", 
        RowBox[{"Fold", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{"#1", ",", 
              RowBox[{"N", "[", 
               RowBox[{"#2", "/", 
                RowBox[{"Norm", "[", "#2", " ", "]"}]}], "]"}]}], "]"}], 
            "]"}], "&"}], ",", 
          RowBox[{"{", "1.", "}"}], ",", "locals"}], "]"}]}], ";", " ", 
       RowBox[{"v", "/", 
        RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"first", "=", 
     RowBox[{"0", " ", "starts", " ", "with", " ", "up"}]}], ";", " ", 
    RowBox[{"first", "=", 
     RowBox[{"1", " ", "starts", " ", "with", " ", 
      RowBox[{"down", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"neel", "[", 
     RowBox[{"n_Integer", ",", 
      RowBox[{"first_", ":", "0"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"productKet", "[", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"UnitVector", "[", 
        RowBox[{"2", ",", 
         RowBox[{"1", "+", 
          RowBox[{"Mod", "[", 
           RowBox[{
            RowBox[{"k", "-", "1", "+", "first"}], ",", "2"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "phi", " ", "is", " ", "the", " ", "azimuth", " ", "of", " ", "the", " ", 
    "first", " ", "spin", " ", "in", " ", "this", " ", 
    RowBox[{"vector", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"helix", "[", 
    RowBox[{"n_Integer", ",", "q_", ",", 
     RowBox[{"theta_", ":", 
      RowBox[{"Pi", "/", "2"}]}], ",", 
     RowBox[{"phi_", ":", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"productKet", "[", "\n", " ", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"theta", "/", "2"}], "]"}], ",", 
        RowBox[{
         RowBox[{"Exp", "[", 
          RowBox[{"I", 
           RowBox[{"(", 
            RowBox[{"phi", "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"k", "-", "1"}], ")"}], "q"}]}], ")"}]}], "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[24]:=",ExpressionUUID->"949c0261-fe1e-7644-8342-392670bd6278"],

Cell[" Accept a vector or a positive, trace-one density matrix . ", "Text",ExpressionUUID->"695f6823-2730-0648-a198-3b9f1a32b01b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"stateFactor", "[", 
     RowBox[{"input_", ",", "dim_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Normal", "[", "input", " ", "]"}], "]"}]}], ",", "e", ",", 
        "v", ",", "keep"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"VectorQ", "[", 
          RowBox[{"x", ",", "NumericQ"}], "]"}], ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "x", "]"}], "==", "dim"}], " ", "&&", 
             " ", 
             RowBox[{
              RowBox[{"Norm", "[", "x", "]"}], ">", "0"}]}], 
            ",", "\"\<Invalid state vector.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"Return", "[", 
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{"x", "/", 
              RowBox[{"Norm", "[", "x", "]"}]}], "}"}], "]"}], "]"}]}]}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MatrixQ", "[", 
           RowBox[{"x", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Dimensions", "[", "x", "]"}], "==", 
           RowBox[{"{", 
            RowBox[{"dim", ",", "dim"}], "}"}]}]}], 
         ",", "\"\<Invalid density-matrix dimensions.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"x", "-", 
              RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], 
             ",", "\"\<Frobenius\>\""}], "]"}], "<=", "tol"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "x", "]"}], "-", "1"}], "]"}], "<=", 
           "tol"}]}], ",", "\n", 
         "  ", "\"\<Density matrix must be Hermitian with trace one.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"herm", "[", "x", " ", "]"}], "]"}]}], ";", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Re", "[", "e", " ", "]"}], "]"}], ">=", 
          RowBox[{"-", "tol"}]}], 
         ",", "\"\<Density matrix is not positive.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"e", "=", 
        RowBox[{"Clip", "[", 
         RowBox[{
          RowBox[{"Re", "[", "e", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
       RowBox[{"e", "/=", 
        RowBox[{"Total", "[", "e", "]"}]}], ";", 
       RowBox[{"keep", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", "dim", "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"e", "[", 
             RowBox[{"[", "#", " ", "]"}], "]"}], ">", "0"}], "&"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          RowBox[{"e", "[", 
           RowBox[{"[", "keep", " ", "]"}], "]"}], "]"}], " ", 
         RowBox[{"v", "[", 
          RowBox[{"[", "keep", " ", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Reorder", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"edge", " ", "1"}], ",", 
       RowBox[{"edge", " ", "L"}], ",", "middle"}], ")"}], " ", "to", " ", 
     "physical", " ", "sites", " ", "1"}], ",", "...", ",", 
    RowBox[{"L", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"joinStates", "[", 
    RowBox[{"ef_", ",", "mf_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"KroneckerProduct", "[", 
        RowBox[{"ef", ",", "mf"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{
         RowBox[{"ArrayReshape", "[", 
          RowBox[{"a", ",", 
           RowBox[{"{", 
            RowBox[{"2", ",", "2", ",", 
             RowBox[{"2", "^", 
              RowBox[{"(", 
               RowBox[{"l", "-", "2"}], ")"}]}], ",", 
             RowBox[{
              RowBox[{"Dimensions", "[", "a", "]"}], "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"2", "^", "l"}], ",", 
         RowBox[{
          RowBox[{"Dimensions", "[", "a", "]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[27]:=",ExpressionUUID->"75a5b56f-167a-6046-b676-cfd30b4f6f11"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Symmetry operators and validated diagonalization  ", "Subsubsection",ExpressionUUID->"cb72326e-0f2e-774f-bb70-93a0eac392f8"],

Cell[" Charges allowed by the effective longitudinal fields . ", "Text",ExpressionUUID->"8e5d7556-b797-d84b-ba5d-851458372b65"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"charges", "[", "p_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"2", "^", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], ",", "r", ",", "f", ",", 
        "fields", ",", 
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "st", ",", "sx", ",", "sy", ",", "sz"}],
        "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"fields", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<h\>\"", "]"}], ",", "l"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bRight\>\"", "]"}]}], ";", "\n", " ", 
       RowBox[{"r", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "+", 
                RowBox[{"FromDigits", "[", 
                 RowBox[{
                  RowBox[{"Reverse", "[", 
                   RowBox[{"IntegerDigits", "[", 
                    RowBox[{"k", ",", "2", ",", "l"}], " ", "]"}], "]"}], ",",
                   "2"}], "]"}]}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", "\n", "  ", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"f", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"d", "-", "k"}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "@@", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"#1", "==", "#2"}], "]"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"fields", ",", 
              RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<R\>\"", "->", "r"}]}], " ", "]"}]}], "]"}], ";", "\n",
        " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"And", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"#", "==", "0"}], "]"}], "&"}], " ", "/@", " ", 
            "fields"}], ")"}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<F\>\"", "->", "f"}]}], " ", "]"}]}], "]"}], ";", "\n",
        " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#1", " ", "==", " ", 
                RowBox[{"-", "#2"}]}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"fields", ",", 
               RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], 
          " ", "&&", "\n", "  ", 
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"out", ",", "\"\<R\>\""}], "]"}], " ", "&&", " ", 
             RowBox[{"KeyExistsQ", "[", 
              RowBox[{"out", ",", "\"\<F\>\""}], "]"}]}], ")"}]}]}], ",", 
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"\"\<RF\>\"", "->", 
            RowBox[{"r", " ", ".", " ", "f"}]}]}], "]"}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}], 
            " ", "||", " ", 
            RowBox[{"TrueQ", "[", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", "==", " ", 
              RowBox[{"-", "1"}]}], "]"}]}], ")"}], " ", "&&", " ", 
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#", "==", 
                RowBox[{"First", "[", "fields", " ", "]"}]}], "]"}], "&"}], 
             " ", "/@", " ", "fields"}], ")"}]}]}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{"st", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}], ",", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"1", ",", "l"}], "]"}], ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", 
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"sx", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"st", "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}], " ", 
               RowBox[{"siteOp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", 
                 "k", ",", "l"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"sy", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"st", "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}], " ", 
               RowBox[{"siteOp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}], ",", 
                 "k", ",", "l"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"sz", "=", 
           RowBox[{"Total", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"siteOp", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "k",
                 ",", "l"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{
                 RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "1"}], "]"}],
                ",", "\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "]"}], "->", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"sx", " ", ".", " ", "sx"}], "+", 
               RowBox[{"sy", " ", ".", " ", "sy"}], "+", 
               RowBox[{"sz", " ", ".", " ", "sz"}]}], ")"}]}]}], "]"}]}]}], 
        "]"}], ";", "\n", " ", "out"}]}], "\n", "]"}]}], ";"}], 
  "\n"}]], "Code",
 CellLabel->"In[29]:=",ExpressionUUID->"6008b6e1-659a-014d-90d9-66feaf585ae5"],

Cell["\<\
 Split a charge eigenspace; no energy eigenvectors are mixed here . \
\>", "Text",ExpressionUUID->"92439d0b-e9cf-3e4a-aa34-1ac0fb785d25"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"splitCharge", "[", 
     RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "e", ",", "v", ",", 
        "order", ",", "groups", ",", "label"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", 
          RowBox[{"herm", "[", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", "q",
             " ", ".", " ", "b"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Re", "[", "e", " ", "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"e", "[", 
          RowBox[{"[", "order", " ", "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"v", "=", 
        RowBox[{"v", "[", 
         RowBox[{"[", "order", " ", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"Split", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "e", " ", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "#1", " ", "]"}], "]"}], "-", 
              RowBox[{"e", "[", 
               RowBox[{"[", "#2", " ", "]"}], "]"}]}], "]"}], "<", "tol"}], 
           "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"label", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "name"}], "]"}], ",", "\n", "   ", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "+", 
                    RowBox[{"4", " ", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"e", "[", 
                    RowBox[{"[", "g", " ", "]"}], "]"}], "]"}]}]}], "]"}]}], 
                 ")"}], "/", "2"}], ",", 
               RowBox[{"1", "/", "2"}]}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"Mean", "[", 
               RowBox[{"e", "[", 
                RowBox[{"[", "g", " ", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
          ";", "\n", "  ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Basis\>\"", "->", 
             RowBox[{"b", " ", ".", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"Orthogonalize", "[", 
                RowBox[{"v", "[", 
                 RowBox[{"[", "g", " ", "]"}], "]"}], "]"}], "]"}]}]}], ",", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "\n", "   ", 
               RowBox[{
                RowBox[{"Switch", "[", 
                 RowBox[{
                 "name", ",", "\"\<S2\>\"", ",", "\"\<S\>\"", 
                  ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredS\>\"", ",", 
                  "_", ",", "name"}], "]"}], "->", "label"}]}], "]"}]}]}], 
           "|>"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "Hamiltonian", " ", "is", " ", "real", " ", "symmetric"}], ";",
     " ", 
    RowBox[{"retain", " ", "real", " ", "packed", " ", 
     RowBox[{"vectors", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fixSign", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"N", "[", "v", " ", "]"}], "]"}]}], ",", "k"}], "}"}], ",", 
     "\n", " ", 
     RowBox[{
      RowBox[{"k", "=", 
       RowBox[{"First", "[", 
        RowBox[{"Ordering", "[", 
         RowBox[{
          RowBox[{"Abs", "[", "w", "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"[", "k", " ", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "w"}], ",", "w"}], " ", "]"}], "]"}]}]}], "\n", "]"}]}],
   ";"}], "\n"}], "Code",
 CellLabel->"In[30]:=",ExpressionUUID->"bfe214cf-d4c9-fc41-9d42-6b3b0fdac3e5"],

Cell["\<\
 Raw eigenpairs in one resolved sector; preserve arbitrarily small gaps . \
\>", "Text",ExpressionUUID->"aa34d091-4bf0-8548-b7f2-d1a8281c321f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"diagonalizeBlock", "[", 
     RowBox[{"s_", ",", "hm_", ",", "ids_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "h", ",", "e", ",", 
        "v", ",", "order", ",", "rows", ",", "gaps", ",", "res", ",", "orth", 
        ",", "leak", ",", "scale"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"herm", "[", 
         RowBox[{
          RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", "hm", 
          " ", ".", " ", "b"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", "h", " ", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Re", "[", "e", " ", "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Developer`ToPackedArray", "[", 
         RowBox[{"Re", "[", 
          RowBox[{"e", "[", 
           RowBox[{"[", "order", " ", "]"}], "]"}], "]"}], "]"}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"fixSign", " ", "/@", " ", 
         RowBox[{"Transpose", "[", 
          RowBox[{"b", " ", ".", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "order", " ", "]"}], "]"}], "]"}]}], "]"}]}]}], ";",
        "\n", " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Developer`ToPackedArray", "[", "rows", "]"}]}], ";", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"Norm", "[", 
           RowBox[{"hm", ",", "Infinity"}], " ", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"res", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"hm", " ", ".", " ", "#2"}], "-", 
              RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
           RowBox[{"{", 
            RowBox[{"e", ",", "rows"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"orth", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"rows", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "rows", "]"}]}], "-", 
          RowBox[{"IdentityMatrix", "[", 
           RowBox[{"Length", "[", "rows", " ", "]"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"leak", "=", 
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"hm", " ", ".", " ", "b"}], "-", 
          RowBox[{"b", " ", ".", " ", "h"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"res", "<", 
           RowBox[{"100", " ", "tol", " ", "scale"}]}], " ", "&&", " ", 
          RowBox[{"orth", "<", 
           RowBox[{"100", " ", "tol"}]}], " ", "&&", " ", 
          RowBox[{"leak", "<", 
           RowBox[{"100", " ", "tol", " ", "scale"}]}]}], 
         ",", "\"\<Sector validation failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"gaps", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Differences", "[", "e", "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Dimension\>\"", "->", 
          RowBox[{"Length", "[", "e", "]"}]}], ",", 
         RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", "\n", "  ", 
         RowBox[{"\"\<Eigenvalues\>\"", "->", "e"}], ",", 
         RowBox[{"\"\<Vectors\>\"", "->", "rows"}], ",", 
         RowBox[{"\"\<Residual\>\"", "->", "res"}], ",", 
         RowBox[{"\"\<OrthogonalityError\>\"", "->", "orth"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<MinPositiveGap\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"gaps", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Missing", "[", "\"\<NoGap\>\"", "]"}], ",", 
            RowBox[{"Min", "[", "gaps", " ", "]"}]}], "]"}]}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[32]:=",ExpressionUUID->"8580bac3-4ffc-514f-b38a-a3454e60fa8f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Eigenvector reconstruction and eigenstate entropies  ", \
"Subsubsection",ExpressionUUID->"3a668822-8d69-7c4d-8525-2c530e6cecbf"],

Cell["\<\
 Full vector from the chosen sector and its energy-order index . \
\>", "Text",ExpressionUUID->"b443279a-b4f9-b647-803d-8a46449accd6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"eigenket", "[", 
    RowBox[{"ed_", ",", "sector_Integer", ",", "level_Integer"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{
        RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "[", 
        RowBox[{"[", "sector", " ", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Normal", "[", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"Thread", "[", 
         RowBox[{
          RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], "->", 
          RowBox[{
           RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}], "[", 
           RowBox[{"[", "level", " ", "]"}], "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"2", "^", 
          RowBox[{
           RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
           "]"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorTable", "[", "ed_", "]"}], " ", ":=", " ", 
   RowBox[{"MapIndexed", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Sector\>\"", "->", 
         RowBox[{"First", "[", "#2", "]"}]}], ",", 
        RowBox[{"\"\<Labels\>\"", "->", 
         RowBox[{"#1", "[", "\"\<Labels\>\"", "]"}]}], ",", "\n", " ", 
        RowBox[{"\"\<Dimension\>\"", "->", 
         RowBox[{"#1", "[", "\"\<Dimension\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Emin\>\"", "->", 
         RowBox[{"First", "[", 
          RowBox[{"#1", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], ",", "\n",
         " ", 
        RowBox[{"\"\<Emax\>\"", "->", 
         RowBox[{"Last", "[", 
          RowBox[{"#1", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MinPositiveGap\>\"", "->", 
         RowBox[{"#1", "[", "\"\<MinPositiveGap\>\"", "]"}]}], ",", "\n", " ", 
        RowBox[{"\"\<Residual\>\"", "->", 
         RowBox[{"#1", "[", "\"\<Residual\>\"", "]"}]}]}], "|>"}], "&"}], ",", 
     RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n"}], "Code",
 CellLabel->"In[33]:=",ExpressionUUID->"88d9545d-6f20-6845-a744-19eae0fe293c"],

Cell["\<\
 One ground-state vector; ties follow sector order, then energy order . \
\>", "Text",ExpressionUUID->"47aa80fa-7388-ab46-b142-0c14af9ebfa4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"groundKet", "[", "ed_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pairs", ",", "c"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"pairs", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "[", 
                 RowBox[{"[", "k", " ", "]"}], "]"}], 
                "[", "\"\<Eigenvalues\>\"", "]"}], "[", 
               RowBox[{"[", "r", " ", "]"}], "]"}], ",", "k", ",", "r"}], 
             "}"}], ",", "\n", "  ", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", 
               RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"r", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "[", 
                RowBox[{"[", "k", " ", "]"}], "]"}], "[", "\"\<Dimension\>\"",
                "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"c", "=", 
        RowBox[{"First", "[", 
         RowBox[{"SortBy", "[", 
          RowBox[{"pairs", ",", "First"}], " ", "]"}], "]"}]}], ";", 
       RowBox[{"eigenket", "[", 
        RowBox[{"ed", ",", 
         RowBox[{"c", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"c", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Add", " ", "both", " ", "pure"}], "-", 
    RowBox[{"eigenstate", " ", "entropies", " ", "to", " ", "an", " ", "ED", " ", 
     RowBox[{"result", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"addEntropies", "[", "ed_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", "ed"}], ",", 
       RowBox[{"l", "=", 
        RowBox[{
         RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
         "]"}]}], ",", "s", ",", "v"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"out", "[", "\"\<Sectors\>\"", "]"}], "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"s", "=", 
           RowBox[{
            RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "[", 
            RowBox[{"[", "k", " ", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"v", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"eigenket", "[", 
              RowBox[{"ed", ",", "k", ",", "r"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"r", ",", 
               RowBox[{"s", "[", "\"\<Dimension\>\"", "]"}]}], "}"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"Join", "[", 
           RowBox[{"s", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<HalfEntropy\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"halfEntropy", "[", 
                   RowBox[{"#", ",", "l"}], "]"}], "&"}], " ", "/@", " ", 
                 "v"}], ")"}]}], ",", "\n", "   ", 
              RowBox[{"\"\<EdgesEntropy\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"edgeEntropy", "[", 
                   RowBox[{"#", ",", "l"}], "]"}], "&"}], " ", "/@", " ", 
                 "v"}], ")"}]}]}], "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "]"}]}], "}"}]}], 
        "]"}]}], ";", "out"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[35]:=",ExpressionUUID->"0f11e53d-afb5-7c43-83b1-96f5942ddda4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Compatible subspaces from the benchmark  ", "Subsubsection",ExpressionUUID->"4fa82926-0538-504b-9843-1d0d75e3f6d2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zzEdgeSpaces", "[", 
     RowBox[{"p_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "bits", ",", "q", ",", 
        "ids", ",", "m", ",", "a", ",", "b", ",", "names", ",", "spaces", ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       RowBox[{"q", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"charges", "[", "p", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<RF\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
           RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", "l"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"bits", "[", 
                  RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], " ",
                "&&", "\n", "    ", 
               RowBox[{
                RowBox[{"bits", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "bitA"}], " ", 
               "&&", " ", 
               RowBox[{
                RowBox[{"bits", "[", 
                 RowBox[{"[", 
                  RowBox[{"#", ",", 
                   RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "bitB"}]}], 
              "&"}]}], "]"}]}], ";", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"ids", "===", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"m", "=", 
           RowBox[{
            RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
          RowBox[{"a", "=", 
           RowBox[{
            RowBox[{"1", "/", "2"}], "-", "bitA"}]}], ";", 
          RowBox[{"b", "=", 
           RowBox[{
            RowBox[{"1", "/", "2"}], "-", "bitB"}]}], ";", "\n", "  ", 
          RowBox[{"names", "=", 
           RowBox[{"Which", "[", 
            RowBox[{
             RowBox[{"a", "==", "b"}], ",", 
             RowBox[{"{", "\"\<R\>\"", "}"}], ",", 
             RowBox[{"m", "==", "0"}], ",", 
             RowBox[{"{", "\"\<RF\>\"", "}"}], ",", "True", ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Basis\>\"", "->", 
               RowBox[{"IdentityMatrix", "[", 
                RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", "\n", 
              "    ", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
                 RowBox[{"\"\<sA\>\"", "->", "a"}], ",", 
                 RowBox[{"\"\<sB\>\"", "->", "b"}], ",", 
                 RowBox[{"\"\<mBulk\>\"", "->", 
                  RowBox[{"m", "-", "a", "-", "b"}]}]}], "|>"}]}]}], "|>"}], "}"}
            ]}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"spaces", "=", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"splitCharge", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                    "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
                "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
          RowBox[{"out", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}], 
               "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", "\n", 
         "  ", 
         RowBox[{"{", 
          RowBox[{"nDown", ",", "0", ",", "l"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"bitA", ",", "0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"bitB", ",", "0", ",", "1"}], "}"}]}], "]"}], ";", 
       "out"}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[37]:=",ExpressionUUID->"59eeff93-c880-8d41-a39b-912d95710823"],

Cell["\<\
 Reuse splitCharge, including its spin-Casimir label conversion . \
\>", "Text",ExpressionUUID->"302d0364-ff67-eb48-a4a9-7876e1b9a85e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeSplit", "[", 
     RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alias", ",", "label", ",", "out"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"alias", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{"name", ",", 
          RowBox[{"\"\<BulkS2\>\"", "|", "\"\<EdgeS2\>\""}], ",", "\"\<S2\>\"",
           ",", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredS2\>\"", ",", 
          "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"label", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "name", ",", "\"\<BulkS2\>\"", ",", "\"\<SBulk\>\"", 
          ",", "\"\<EdgeS2\>\"", ",", "\"\<SEdge\>\"", ",", "\n", 
          "  ", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredSBulk\>\"", ",",
           "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"out", "=", 
        RowBox[{"splitCharge", "[", 
         RowBox[{"s", ",", "q", ",", "alias", ",", "tol"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"alias", "=!=", "name"}], ",", 
         RowBox[{"out", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"t", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"t", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Labels\>\"", "->", 
                  RowBox[{"Append", "[", "\n", "   ", 
                   RowBox[{
                    RowBox[{"KeyDrop", "[", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "}"}]}], "]"}], ",", 
                    "\n", "   ", 
                    RowBox[{"label", "->", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "]"}]}]}], "]"}]}], 
                 "|>"}]}], "]"}]}], "]"}], ",", "out"}], "]"}]}]}], "]"}], ";",
        "\n", " ", "out"}]}], "\n", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "charge", " ", "is", " ", "split", " ", "only", " ", "when", " ",
     "it", " ", "preserves", " ", "the", " ", "CURRENT", " ", 
    RowBox[{"subspace", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeRefine", "[", 
    RowBox[{"spaces_", ",", "q_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", "spaces"}], ",", "next", ",", "b", ",", "a"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"next", "=", 
          RowBox[{"{", "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"b", "=", 
             RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
            RowBox[{"a", "=", 
             RowBox[{"herm", "[", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
               RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "]"}]}],
             ";", "\n", "   ", 
            RowBox[{"next", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"next", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "<", 
                  RowBox[{"tol", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], ",", "\n", "     ", 
                 RowBox[{"edgeSplit", "[", 
                  RowBox[{"s", ",", 
                   RowBox[{"q", "[", "name", "]"}], ",", "name", ",", "tol"}],
                   "]"}], ",", 
                 RowBox[{"{", "s", "}"}]}], "]"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "out"}], "}"}]}], "]"}], ";", 
         RowBox[{"out", "=", "next"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"name", ",", 
          RowBox[{"Keys", "[", "q", "]"}]}], "}"}]}], "]"}], ";", "out"}]}], 
    "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[38]:=",ExpressionUUID->"95b79c12-cf35-584f-a3c6-f901392aa1f2"],

Cell["\<\
 In each ZZ block, reuse charges for its ACTUAL effective boundary fields . \
\>", "Text",ExpressionUUID->"38ed6f70-004b-1945-bfd7-906ba0fbc0ce"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"zzBulkCharges", "[", 
     RowBox[{"g_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pb", ",", "q", ",", "names", ",", "alias"}], "}"}], ",", "\n",
       " ", 
      RowBox[{
       RowBox[{"pb", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<L\>\"", "->", 
             RowBox[{
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
            RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", "   ", 
            RowBox[{"\"\<bLeft\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sA\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<bRight\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sB\>\"", "]"}]}]}]}], "|>"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"charges", "[", "pb", "]"}]}], ";", "\n", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "These", " ", "bulk", " ", "parities", " ", "already", " ", "have", " ",
           "the", " ", "full"}], "-", 
         RowBox[{"chain", " ", "parent", " ", 
          RowBox[{"label", "."}]}]}], " ", "*)"}], "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<R\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<RF\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"names", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "q", "]"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "#"}], "]"}], ",", "0", ",", "1"}], "]"}], "&"}]}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"alias", "=", 
            RowBox[{"Switch", "[", 
             RowBox[{
             "name", ",", "\"\<R\>\"", ",", "\"\<RBulk\>\"", ",", "\"\<F\>\"",
               ",", "\"\<FBulk\>\"", ",", "\"\<RF\>\"", ",", "\"\<RFBulk\>\"",
               ",", "\n", "    ", "\"\<S2\>\"", ",", "\"\<BulkS2\>\"", 
              ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredBulkS2\>\""}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"alias", "->", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"id", "[", "2", "]"}], ",", 
              RowBox[{"q", "[", "name", "]"}], ",", 
              RowBox[{"id", "[", "2", "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
     "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[40]:=",ExpressionUUID->"482fffb6-40e2-3246-9324-e1fca0e9e99f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Field-free model, full sectors and static scans  ", "Subsubsection",ExpressionUUID->"aa57e4c9-683a-fc4f-8c20-a2e4f347fbb4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regimeModel", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"p", ",", "\"\<L\>\"", ",", 
         RowBox[{"Missing", "[", "]"}]}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "l", "]"}], " ", "&&", " ", 
         RowBox[{"l", ">=", "4"}]}], 
        ",", "\"\<Use integer total length L>=4.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ContainsAll", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "p", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<g\>\""}], 
            "}"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"p", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<g\>\""}], 
              "}"}]}], "]"}], ",", "realQ"}], "]"}]}], ",", "\n", 
        "  ", "\"\<Specify finite real J, Delta and g.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "\"\<J\>\"", "]"}], "!=", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"p", "[", "\"\<g\>\"", "]"}], "!=", "0"}]}], 
        ",", "\"\<J and g must be nonzero; g=0 is outside these \
notebooks.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "p", "]"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
             ",", "\"\<g\>\""}], "}"}]}], "]"}], "===", 
         RowBox[{"{", "}"}]}], ",", "\n", 
        "  ", "\"\<Model parameters are only L, J, Delta and g. No \
magnetic-field parameter is accepted.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"p", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
          ",", "\"\<g\>\""}], "}"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"geometryParameters", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"KeyTake", "[", 
      RowBox[{"p", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"regimeParts", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "x", ",", "y", ",", "z", 
       ",", "xy", ",", "zz", ",", "b"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"b", "=", 
       RowBox[{
        RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bondOp", "[", 
             RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
            RowBox[{"bondOp", "[", 
             RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}], "+", 
            RowBox[{
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "2", ",", 
             RowBox[{"l", "-", "2"}]}], "}"}]}], "]"}], "]"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"xy", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bondOp", "[", 
            RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
           RowBox[{"bondOp", "[", 
            RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"zz", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"bondOp", "[", 
           RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Bulk\>\"", "->", 
         RowBox[{"SparseArray", "[", "b", "]"}]}], ",", 
        RowBox[{"\"\<Interaction\>\"", "->", 
         RowBox[{"SparseArray", "[", "zz", "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"regimeHamiltonian", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "=", 
        RowBox[{"regimeModel", "[", "p", "]"}]}], ",", "b"}], "}"}], ",", 
     "\n", " ", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"regimeParts", "[", "q", "]"}]}], ";", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"b", "[", "\"\<Bulk\>\"", "]"}], "+", 
        RowBox[{
         RowBox[{"q", "[", "\"\<g\>\"", "]"}], " ", 
         RowBox[{"b", "[", "\"\<Interaction\>\"", "]"}]}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkHamiltonian", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "x", ",", 
       "y", ",", "z"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bondOp", "[", 
             RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
            RowBox[{"bondOp", "[", 
             RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", 
            RowBox[{
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"parameterNote", "[", "p_", "]"}], " ", ":=", " ", 
    RowBox[{"Which", "[", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "0"}], "]"}], ",", 
      "\n", " ", "\"\<Delta=0: free-fermion Hamiltonian (conditional \
free-fermion bulk for ZZ). Additional mode occupations are conserved; \
spin/spatial sectors need not have nondegenerate energies.\>\"", ",", "\n", 
      " ", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"Abs", "[", 
         RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], "==", 
        RowBox[{"1", "/", "2"}]}], "]"}], ",", "\n", 
      " ", "\"\<Delta=+/-1/2: special bulk cross-magnetization degeneracies \
can affect weak-g level statistics.\>\"", ",", "True", 
      ",", "\"\<Generic anisotropy within the stated spin/spatial symmetry \
classification.\>\""}], "]"}]}], ";"}], "\n", "\n", "\n"}], "\n"}], "Code",
 CellLabel->"In[41]:=",ExpressionUUID->"c6d4acf8-ef47-5e4e-a6fe-c96f433f1d23"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regimeParentSpaces", "[", 
    RowBox[{"l_Integer", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"regimeParentSpaces", "[", 
     RowBox[{"l", ",", "tol"}], "]"}], " ", "=", "\n", " ", 
    RowBox[{"zzEdgeSpaces", "[", 
     RowBox[{
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<L\>\"", "->", "l"}], ",", 
        RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
