Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"mapPlots", "[", 
     RowBox[{"records_", ",", "p_", ",", 
      RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "keys", ",", "aug", ",", "names"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"keys", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<MinChoiEigenvalue\>\"", ",", "\"\<TPError\>\"", 
          ",", "\"\<ChoiTraceError\>\"", ",", "\"\<KrausRank\>\"", 
          ",", "\"\<MapEntropy\>\"", ",", "\"\<ChoiPTMinimum\>\"", 
          ",", "\"\<ChoiNegativity\>\"", ",", "\n", 
          "  ", "\"\<MinSingularValue\>\"", ",", "\"\<MinimumRate\>\"", 
          ",", "\"\<RHPInstantaneous\>\"", ",", "\"\<RHPFiniteStep\>\"", 
          ",", "\"\<RHPFiniteStepRate\>\"", ",", "\n", 
          "  ", "\"\<UnitalityError\>\"", ",", "\"\<MixedInputEntropy\>\"", 
          ",", "\"\<U1CovarianceError\>\"", 
          ",", "\"\<ReflectionCovarianceError\>\"", 
          ",", "\"\<FlipCovarianceError\>\"", ",", "\"\<RFCovarianceError\>\"",
           ",", "\n", "  ", "\"\<TimeReversalError\>\"", 
          ",", "\"\<DoubleQuantumReal\>\"", ",", "\"\<DoubleQuantumImag\>\"", 
          ",", "\"\<DoubleQuantumAbs\>\"", ",", "\"\<BLPDistance\>\"", 
          ",", "\"\<BLPAccumulated\>\"", ",", "\"\<SignalAtoB\>\"", 
          ",", "\"\<RetentionA\>\""}], "}"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"AssociateTo", "[", 
          RowBox[{"out", ",", 
           RowBox[{"key", "->", 
            RowBox[{"recordPlot", "[", 
             RowBox[{"records", ",", 
              RowBox[{"{", "key", "}"}], ",", 
              RowBox[{"observableLabel", "[", "key", "]"}], ",", 
              RowBox[{"observableTitle", "[", "key", "]"}], ",", "p", ",", 
              "log"}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"key", ",", "keys"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"names", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"spec", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<>", 
              RowBox[{"ToString", "[", "k", "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"spec", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"aug", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"r", ",", 
               RowBox[{"Join", "[", 
                RowBox[{"r", ",", 
                 RowBox[{"Association", "[", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{"Rule", ",", 
                    RowBox[{"{", 
                    RowBox[{"names", ",", 
                    RowBox[{"r", "[", 
                    RowBox[{"spec", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], 
                  "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{"spec", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "->", 
             RowBox[{"recordPlot", "[", 
              RowBox[{"aug", ",", "names", ",", 
               RowBox[{"spec", "[", 
                RowBox[{"[", "3", "]"}], "]"}], ",", 
               RowBox[{"spec", "[", 
                RowBox[{"[", "4", "]"}], "]"}], ",", "p", ",", "log"}], 
              "]"}]}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"{", 
          RowBox[{"spec", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              
              RowBox[{"\"\<ChoiEigenvalues\>\"", ",", "16", 
               ",", "\"\<\\\\lambda_k(C_t)\>\"", 
               ",", "\"\<\\\\text{Choi eigenvalues}\>\""}], "}"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<CanonicalRates\>\"", ",", "15", 
               ",", "\"\<\\\\gamma_k(t)\>\"", 
               ",", "\"\<\\\\text{Canonical rates}\>\""}], "}"}]}], "}"}]}], 
          "}"}]}], "]"}], ";", "out"}]}], "\n", "]"}]}], ";"}], 
  "\n"}]], "Code",
 CellLabel->
  "In[101]:=",ExpressionUUID->"f13445d7-7cdd-924a-bb02-b1d7a25d537d"]
