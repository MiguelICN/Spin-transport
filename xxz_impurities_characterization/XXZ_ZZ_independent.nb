          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"ar", ",", "\"\<Time\>\""}], "]"}], ",", 
           RowBox[{"Lookup", "[", 
            RowBox[{"br", ",", "\"\<Time\>\""}], "]"}], ",", 
           RowBox[{"a", "[", "\"\<Times\>\"", "]"}]}], "]"}]}], 
        ",", "\"\<A/B comparison refused: record times do not match the used \
snapshots.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"err", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"ar", ",", "\"\<SigmaAB\>\""}], "]"}], "-", 
         RowBox[{"Lookup", "[", 
          RowBox[{"br", ",", "\"\<SigmaOutput\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"matrixError", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"ar", ",", "\"\<RhoAB\>\""}], "]"}], "-", 
         RowBox[{"Lookup", "[", 
          RowBox[{"br", ",", "\"\<OutputF1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"err", ",", "matrixError"}], "]"}], "<", "tol"}], 
        ",", "\"\<Independent A/B edge matrices or grand sums \
disagree.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<MaxSigmaError\>\"", "->", "err"}], ",", 
        RowBox[{"\"\<MaxMatrixError\>\"", "->", "matrixError"}], ",", 
        RowBox[{"\"\<Tolerance\>\"", "->", "tol"}], ",", 
        RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstEdgeConservationError", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"N", "[", 
         RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}]}], ",", "z"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"siteOp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "j", ",", 
            RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"h", " ", ".", " ", "z"}], "-", 
           RowBox[{"z", " ", ".", " ", "h"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"96ae7837-\
8cdb-3045-a4ac-5f8b225dc804"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  QST plotting and export definitions  ", "Subsubsection",ExpressionUUID->"b42b4514-7dae-1a44-99d3-54a28c6c8d08"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstTex", "[", 
    RowBox[{"s_String", ",", 
     RowBox[{"size_", ":", "14"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"tex", "[", 
    RowBox[{"s", ",", "size"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstTicks", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lo_", ",", "hi_"}], "}"}], ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"If", "[", 
        RowBox[{"log", ",", "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"0", "<", "lo", "<=", "hi"}], 
            ",", "\"\<Log ticks require a positive range.\>\""}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"10.", "^", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"Log10", "[", "lo", "]"}], "]"}], ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{"Log10", "[", "hi", "]"}], "]"}]}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"lo", "<=", "#", "<=", "hi"}], "&"}]}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"lo", "==", "hi"}], ",", 
           RowBox[{"{", "lo", "}"}], ",", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"lo", ",", "hi", ",", "4"}], "]"}]}], "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"log", " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "v", "]"}], "<", "2"}]}], ",", 
        RowBox[{"v", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"lo", "==", "hi"}], ",", 
           RowBox[{"{", "lo", "}"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"Log", "[", "lo", "]"}], ",", 
              RowBox[{"Log", "[", "hi", "]"}], ",", "4"}], "]"}], "]"}]}], 
          "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"log", ",", 
             RowBox[{"Log", "[", "#", "]"}], ",", "#"}], "]"}], ",", 
           RowBox[{"qstTex", "[", 
            RowBox[{
             RowBox[{"texNumber", "[", "#", "]"}], ",", "11"}], "]"}]}], 
          "}"}], "&"}], " ", "/@", " ", "v"}], ")"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstCaption", "[", "snap_", "]"}], " ", ":=", " ", 
   RowBox[{"Column", "[", 
    RowBox[{
     RowBox[{"{", "\n", " ", 
      RowBox[{
       RowBox[{"qstTex", "[", 
        RowBox[{
         RowBox[{"\"\<\\\\mathrm{ZZ}: L=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{
            RowBox[{"snap", "[", "\"\<Model\>\"", "]"}], "[", "\"\<L\>\"", 
            "]"}], "]"}], "<>", "\"\<; J=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{
            RowBox[{"snap", "[", "\"\<Model\>\"", "]"}], "[", "\"\<J\>\"", 
            "]"}], "]"}], "<>", "\"\<; \\\\Delta=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{
            RowBox[{"snap", "[", "\"\<Model\>\"", "]"}], "[", "\"\<Delta\>\"",
             "]"}], "]"}], "<>", "\"\<; g=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{
            RowBox[{"snap", "[", "\"\<Model\>\"", "]"}], "[", "\"\<g\>\"", 
            "]"}], "]"}]}], ",", "12"}], "]"}], ",", "\n", " ", 
       RowBox[{"Style", "[", 
        RowBox[{
         RowBox[{"\"\<Bulk: \>\"", "<>", 
          RowBox[{"snap", "[", "\"\<BulkNote\>\"", "]"}]}], ",", "12"}], 
        "]"}], ",", "\n", " ", 
       RowBox[{"qstTex", "[", 
        RowBox[{
         RowBox[{"samplingCaption", "[", 
          RowBox[{
           RowBox[{"snap", "[", "\"\<Times\>\"", "]"}], ",", 
           RowBox[{"Lookup", "[", 
            RowBox[{"snap", ",", "\"\<TimeSettings\>\"", ",", 
             RowBox[{"<|", "|>"}]}], "]"}]}], "]"}], ",", "12"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"Alignment", "->", "Center"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstPanel", "[", 
     RowBox[{"records_", ",", "keys_", ",", "ylabel_", ",", "snap_", ",", 
      RowBox[{"log_", ":", "False"}], ",", 
      RowBox[{"labels_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "selected", ",", "curves", ",", "finite", ",", "rail", ",", "bad", ",",
         "allcurves", ",", "styles", ",", "markers", ",", "legend", ",", "yr",
         ",", "xr", ",", "g", ",", 
        RowBox[{"notes", "=", 
         RowBox[{"{", "}"}]}], ",", "excluded", ",", "badIds"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"selected", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"records", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "log"}], " ", "||", " ", 
            RowBox[{
             RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ">", "0"}]}], "&"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "selected", "]"}], ">", "0"}], 
         ",", "\"\<No positive times available for log-time plot.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"curves", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
               RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", " ",
             "selected"}], ")"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "keys"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"finite", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"Last", "[", "#", "]"}], "]"}], "&"}]}], "]"}], "&"}], 
         " ", "/@", " ", "curves"}]}], ";", "\n", " ", 
       RowBox[{"rail", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Flatten", "[", 
            RowBox[{"finite", ",", "1"}], "]"}], "===", 
           RowBox[{"{", "}"}]}], ",", "1.", ",", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Last", " ", "/@", " ", 
               RowBox[{"Flatten", "[", 
                RowBox[{"finite", ",", "1"}], "]"}]}], "]"}]}], "]"}], "+", 
           RowBox[{".15", " ", 
            RowBox[{"Max", "[", 
             RowBox[{"1.", ",", 
              RowBox[{"Max", "[", 
               RowBox[{"Abs", "[", 
                RowBox[{"Last", " ", "/@", " ", 
                 RowBox[{"Flatten", "[", 
                  RowBox[{"finite", ",", "1"}], "]"}]}], "]"}], "]"}]}], 
             "]"}]}]}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"bad", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"Not", "[", 
              RowBox[{"realQ", "[", 
               RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}], "&"}]}], "]"}], 
          "&"}], " ", "/@", " ", "curves"}]}], ";", "\n", " ", 
       RowBox[{"badIds", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "keys", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"bad", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "=!=", 
            RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"allcurves", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"finite", ",", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"First", "[", "#", "]"}], ",", "rail"}], "}"}], 
                "&"}], " ", "/@", " ", "#"}], ")"}], "&"}], ",", 
            RowBox[{"bad", "[", 
             RowBox[{"[", "badIds", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{"log", ",", 
         RowBox[{"allcurves", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Log", "[", 
                RowBox[{"First", "[", "#", "]"}], "]"}], ",", 
               RowBox[{"Last", "[", "#", "]"}]}], "}"}], "&"}], ",", 
            "allcurves", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"styles", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "keys", "]"}], "]"}]}], ",", 
          RowBox[{
           RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
           "badIds"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"markers", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Switch", "[", 
               RowBox[{
                RowBox[{"Mod", "[", 
                 RowBox[{
                  RowBox[{"k", "-", "1"}], ",", "3"}], "]"}], ",", "0", 
                ",", "\"\<\[FilledCircle]\>\"", ",", "1", 
                ",", "\"\<\[EmptyCircle]\>\"", ",", "2", 
                ",", "\"\<\[Times]\>\""}], "]"}], ",", "3"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}], ",", 
          "\n", "  ", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<\[EmptyUpTriangle]\>\"", ",", "7"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"Length", "[", "badIds", "]"}], "}"}]}], "]"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"legend", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"qstTex", "[", 
             RowBox[{"#", ",", "11"}], "]"}], "&"}], " ", "/@", " ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"labels", "===", "Automatic"}], ",", 
             RowBox[{"observableLabel", " ", "/@", " ", "keys"}], ",", 
             "labels"}], "]"}]}], ",", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"qstTex", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"observableLabel", "[", 
                RowBox[{"keys", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], "]"}], 
               "<>", "\"\<\\\\;(\\\\mathrm{singular/invalid})\>\""}], ",", 
              "10"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "badIds"}], "}"}]}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"yr", "=", 
        RowBox[{"MinMax", "[", 
         RowBox[{"Last", " ", "/@", " ", 
          RowBox[{"Flatten", "[", 
           RowBox[{"allcurves", ",", "1"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "yr", "]"}], "==", 
          RowBox[{"Last", "[", "yr", "]"}]}], ",", 
         RowBox[{"yr", "+=", " ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", ".05"}], ",", ".05"}], "}"}], " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Abs", "[", 
              RowBox[{"First", "[", "yr", "]"}], "]"}]}], "]"}]}]}]}], "]"}], 
       ";", "\n", " ", 
       RowBox[{"xr", "=", 
        RowBox[{"MinMax", "[", 
         RowBox[{"Lookup", "[", 
          RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"g", "=", 
        RowBox[{"ListPlot", "[", 
         RowBox[{"allcurves", ",", 
          RowBox[{"Joined", "->", "False"}], ",", 
          RowBox[{"PlotStyle", "->", "styles"}], ",", 
          RowBox[{"PlotMarkers", "->", "markers"}], ",", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", "\n", "  ", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"qstTex", "[", "\"\<t\>\"", "]"}], ",", 
             RowBox[{"qstTex", "[", "ylabel", "]"}]}], "}"}]}], ",", 
          RowBox[{"FrameTicks", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"qstTicks", "[", "yr", "]"}], ",", "None"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"qstTicks", "[", 
                RowBox[{"xr", ",", "log"}], "]"}], ",", "None"}], "}"}]}], 
            "}"}]}], ",", "\n", "  ", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"ImageSize", "->", "1100"}], ",", 
          RowBox[{"AspectRatio", "->", ".52"}], ",", 
          RowBox[{"ImagePadding", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"140", ",", "40"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"100", ",", "50"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"Placed", "[", 
            RowBox[{
             RowBox[{"PointLegend", "[", 
              RowBox[{"styles", ",", "legend", ",", 
               RowBox[{"LegendMarkers", "->", "markers"}]}], "]"}], ",", 
             "Below"}], "]"}]}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bad", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "=!=", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"notes", ",", 
             RowBox[{
              RowBox[{"keys", "[", 
               RowBox[{"[", "k", "]"}], "]"}], 
              "<>", "\"\< rail marks (actual values retained): \>\"", "<>", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"bad", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], ",", "InputForm"}], 
               "]"}]}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"excluded", "=", 
        RowBox[{"If", "[", 
         RowBox[{"log", ",", 
          RowBox[{"Select", "[", 
           RowBox[{"records", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"#", "[", "\"\<Time\>\"", "]"}], "<=", "0"}], "&"}]}], 
           "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"excluded", "=!=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"notes", ",", 
           
           RowBox[{"\"\<Log-time panel excludes t<=0 only; omitted values: \>\
\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"KeyTake", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"Prepend", "[", 
                   RowBox[{"keys", ",", "\"\<Time\>\""}], "]"}]}], "]"}], 
                "&"}], " ", "/@", " ", "excluded"}], ",", "InputForm"}], 
             "]"}]}]}], "]"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Column", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"qstCaption", "[", "snap", "]"}], ",", "g"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{"#", ",", "10"}], "]"}], "&"}], " ", "/@", " ", 
            "notes"}]}], "]"}], ",", 
         RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", "\n", "\n"}], "\n"}], "Code",ExpressionUUID->"36c95fd0-2063-\
2b4a-841f-b56897057cda"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"texturePanels", "[", 
     RowBox[{"records_", ",", "short_", ",", "snap_", ",", "shortSnap_", ",", 
      RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"out", ",", 
        RowBox[{"pairs", "=", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", "4", "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "rr", ",", "keys"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"out", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"spec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{"qstPanel", "[", 
             RowBox[{"records", ",", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", "snap", ",", "log"}], 
             "]"}]}], ",", "\n", " ", 
           RowBox[{"{", 
            RowBox[{"spec", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<GrandSums\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<SigmaAB\>\"", ",", "\"\<SigmaA\>\"", 
                   ",", "\"\<SigmaB\>\""}], "}"}], ",", "\"\<\\\\Sigma\>\""}],
                 "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<TextureF\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<TextureFAB\>\"", ",", "\"\<TextureFA\>\"", 
                   ",", "\"\<TextureFB\>\""}], "}"}], ",", "\"\<T_F\>\""}], 
                "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Rugosity\>\"", ",", 
                 RowBox[{"{", 
                  
