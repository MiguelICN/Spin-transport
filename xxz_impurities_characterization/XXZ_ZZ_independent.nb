    RowBox[{"p_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", "=", 
       RowBox[{"regimeModel", "[", "p", "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", 
        RowBox[{
         RowBox[{"q", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
       RowBox[{"\"\<Original\>\"", "->", "q"}], ",", 
       RowBox[{"\"\<gA\>\"", "->", 
        RowBox[{"q", "[", "\"\<g\>\"", "]"}]}], ",", 
       RowBox[{"\"\<gB\>\"", "->", 
        RowBox[{"q", "[", "\"\<g\>\"", "]"}]}], ",", "\n", " ", 
       RowBox[{"\"\<w\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<ed\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<DefectSite\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<omegaA\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<omegaB\>\"", "->", "0"}]}], "|>"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chChainHamiltonian", "[", 
    RowBox[{"delta_", ",", "p_"}], "]"}], " ", ":=", " ", 
