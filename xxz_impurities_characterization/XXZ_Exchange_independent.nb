Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"bulkFactor", "[", 
    RowBox[{"p_Association", ",", "spec_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
       RowBox[{"d", "=", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], ",", 
       "v", ",", "h", ",", "e", ",", "w", ",", "beta", ",", "mat", ",", 
       "emin", ",", "r"}], "}"}], ",", "\n", " ", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], ",", "\n", 
       " ", "\"\<Neel\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"neel", "[", 
          RowBox[{"n", ",", 
           RowBox[{"Lookup", "[", 
            RowBox[{"spec", ",", "\"\<First\>\"", ",", "0"}], "]"}]}], "]"}], 
         ",", "d", ",", "tol"}], "]"}], ",", "\n", " ", "\"\<Polarized\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"productKet", "[", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"UnitVector", "[", 
             RowBox[{"2", ",", 
              RowBox[{"1", "+", 
               RowBox[{"spec", "[", "\"\<Bit\>\"", "]"}]}]}], "]"}], ",", 
            "n"}], "]"}], "]"}], ",", "d", ",", "tol"}], "]"}], ",", "\n", 
       " ", "\"\<Helix\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"helix", "[", 
          RowBox[{"n", ",", 
           RowBox[{"spec", "[", "\"\<q\>\"", "]"}], ",", 
           RowBox[{"spec", "[", "\"\<theta\>\"", "]"}], ",", 
           RowBox[{"spec", "[", "\"\<phi\>\"", "]"}]}], "]"}], ",", "d", ",", 
         "tol"}], "]"}], ",", "\n", " ", "\"\<InfiniteT\>\"", ",", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"IdentityMatrix", "[", "d", "]"}], "/", 
         RowBox[{"Sqrt", "[", "d", "]"}]}], "]"}], ",", "\n", 
       " ", "\"\<Gibbs\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"realQ", "[", "beta", "]"}], 
          ",", "\"\<Beta must be finite and real.\>\""}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", 
            RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}], "]"}], "]"}]}],
         ";", "\n", "  ", 
        RowBox[{"w", "=", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "beta"}], 
           RowBox[{"(", 
            RowBox[{"e", "-", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"beta", ">=", "0"}], ",", 
               RowBox[{"Min", "[", "e", "]"}], ",", 
               RowBox[{"Max", "[", "e", "]"}]}], "]"}]}], ")"}]}], "]"}]}], ";", 
        RowBox[{"w", "/=", 
         RowBox[{"Total", "[", "w", "]"}]}], ";", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", "w", "]"}], " ", "v"}], "]"}]}], ",", "\n", 
       " ", "\"\<Typical\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"r", "=", 
         RowBox[{"spec", "[", "\"\<Samples\>\"", "]"}]}], ";", "\n", "  ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"realQ", "[", "beta", "]"}], " ", "&&", " ", 
           RowBox[{"IntegerQ", "[", "r", "]"}], " ", "&&", " ", 
           RowBox[{"r", ">=", "1"}]}], 
          ",", "\"\<Invalid typicality Beta/Samples.\>\""}], "]"}], ";", "\n",
         "  ", 
        RowBox[{"h", "=", 
         RowBox[{"N", "[", 
          RowBox[{"bulkHamiltonian", "[", "p", "]"}], "]"}]}], ";", 
        RowBox[{"emin", "=", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"beta", ">=", "0"}], ",", 
            RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", 
          RowBox[{"Norm", "[", 
           RowBox[{"h", ",", "Infinity"}], "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"mat", "=", 
         RowBox[{"BlockRandom", "[", 
          RowBox[{
           RowBox[{"SeedRandom", "[", 
            RowBox[{"spec", "[", "\"\<Seed\>\"", "]"}], "]"}], ";", "\n", 
           "   ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"MatrixExp", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"-", "beta"}], 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"h", "-", 
                    RowBox[{"emin", " ", 
                    RowBox[{"id", "[", "d", "]"}]}]}], ")"}], "/", "2"}]}], ",",
                 "\n", "    ", 
                RowBox[{
                 RowBox[{"RandomVariate", "[", 
                  RowBox[{
                   RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                  "]"}], "+", 
                 RowBox[{"I", " ", 
                  RowBox[{"RandomVariate", "[", 
                   RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", "d"}], 
                   "]"}]}]}]}], "]"}], ",", 
              RowBox[{"{", "r", "}"}]}], "]"}], "]"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"mat", "/", 
         RowBox[{"Norm", "[", 
          RowBox[{"mat", ",", "\"\<Frobenius\>\""}], "]"}]}]}], ",", "\n", 
       " ", "\"\<User\>\"", ",", 
       RowBox[{"stateFactor", "[", 
        RowBox[{
         RowBox[{"spec", "[", "\"\<State\>\"", "]"}], ",", "d", ",", "tol"}], 
        "]"}], ",", "\n", " ", "_", ",", 
       RowBox[{"check", "[", 
        RowBox[{
        "False", 
         ",", "\"\<Bulk Type must be Neel, Polarized, Helix, InfiniteT, \
Gibbs, Typical or User.\>\""}], "]"}]}], "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"initialFactor", "[", 
     RowBox[{"p_", ",", "spec_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Switch", "[", 
     RowBox[{
      RowBox[{"spec", "[", "\"\<Mode\>\"", "]"}], ",", "\n", 
      " ", "\"\<Product\>\"", ",", 
      RowBox[{"joinStates", "[", 
       RowBox[{
        RowBox[{"stateFactor", "[", 
         RowBox[{
          RowBox[{"spec", "[", "\"\<EdgeState\>\"", "]"}], ",", "4", ",", 
          "tol"}], "]"}], ",", 
        RowBox[{"bulkFactor", "[", 
         RowBox[{"p", ",", 
          RowBox[{"spec", "[", "\"\<Bulk\>\"", "]"}], ",", "tol"}], "]"}], ",", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "\n", 
      " ", "\"\<Full\>\"", ",", 
      RowBox[{"stateFactor", "[", 
       RowBox[{
        RowBox[{"spec", "[", "\"\<FullState\>\"", "]"}], ",", 
        RowBox[{"2", "^", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "tol"}], "]"}], ",", 
      "\n", " ", "_", ",", 
      RowBox[{"check", "[", 
       RowBox[{
       "False", ",", "\"\<Initial Mode must be Product or Full.\>\""}], 
       "]"}]}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"stateInputDiagnostics", "[", 
    RowBox[{"p_", ",", "fac_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "gram", ",", "ha", ",", "energy", ",", "kinetic", ",", "mean", ",", 
       "var", ",", "comm", ",", "qr", ",", "rr", ",", "ra", ",", "rb", ",", 
       "r"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"gram", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
        "fac"}]}], ";", 
      RowBox[{"ha", "=", 
       RowBox[{
        RowBox[{"regimeHamiltonian", "[", "p", "]"}], " ", ".", " ", 
        "fac"}]}], ";", "\n", " ", 
      RowBox[{"energy", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
        "ha"}]}], ";", 
      RowBox[{"kinetic", "=", 
       RowBox[{
        RowBox[{"ConjugateTranspose", "[", "ha", "]"}], " ", ".", " ", 
        "ha"}]}], ";", "\n", " ", 
      RowBox[{"mean", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", "energy", "]"}], "]"}]}], ";", 
      RowBox[{"var", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"0.", ",", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", "kinetic", "]"}], "]"}], "-", 
          RowBox[{"mean", "^", "2"}]}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"qr", ",", "rr"}], "}"}], "=", 
       RowBox[{"QRDecomposition", "[", 
        RowBox[{"Join", "[", 
         RowBox[{"fac", ",", "ha", ",", "2"}], "]"}], "]"}]}], ";", 
      RowBox[{"ra", "=", 
       RowBox[{"rr", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"1", ";;", "r"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"rb", "=", 
       RowBox[{"rr", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{
           RowBox[{"r", "+", "1"}], ";;", 
           RowBox[{"2", " ", "r"}]}]}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"comm", "=", 
       RowBox[{"Norm", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"rb", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "ra", "]"}]}], "-", 
          RowBox[{"ra", " ", ".", " ", 
           RowBox[{"ConjugateTranspose", "[", "rb", "]"}]}]}], 
         ",", "\"\<Frobenius\>\""}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"comm", "<", "tol"}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<The chosen initial density matrix is stationary within the \
diagnostic tolerance; constant observables are expected.\>\"", "]"}]}], "]"}],
       ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Purity\>\"", "->", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"gram", " ", ".", " ", "gram"}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<MeanEnergy\>\"", "->", "mean"}], ",", 
        RowBox[{"\"\<EnergyVariance\>\"", "->", "var"}], ",", "\n", "  ", 
        RowBox[{"\"\<CommutatorNorm\>\"", "->", "comm"}], ",", 
        RowBox[{"\"\<StationaryWithinTolerance\>\"", "->", 
         RowBox[{"TrueQ", "[", 
          RowBox[{"comm", "<", "tol"}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",
