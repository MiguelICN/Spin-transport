      "checks"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstMapChecks", "[", 
    RowBox[{"eng_", ",", "bf_", ",", "records_", ",", "settings_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
