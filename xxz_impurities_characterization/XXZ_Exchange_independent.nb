Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"staticTransformLabels", "[", 
    RowBox[{"a_Association", ",", "op_String"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", "=", "a"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<F\>\"", ",", "\"\<RF\>\""}], "}"}], ",", "op"}], 
         "]"}], ",", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"KeyExistsQ", "[", 
             RowBox[{"b", ",", "k"}], "]"}], ",", 
            RowBox[{
             RowBox[{"b", "[", "k", "]"}], "=", 
             RowBox[{"-", 
              RowBox[{"b", "[", "k", "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<m\>\"", ",", "\"\<mBulk\>\"", ",", "\"\<sA\>\"", 
              ",", "\"\<sB\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<R\>\"", ",", "\"\<RF\>\""}], "}"}], ",", "op"}], 
          "]"}], " ", "&&", " ", 
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"b", ",", "\"\<sA\>\""}], "]"}]}], ",", 
        RowBox[{"b", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"b", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<sA\>\"", "->", 
              RowBox[{"b", "[", "\"\<sB\>\"", "]"}]}], ",", 
             RowBox[{"\"\<sB\>\"", "->", 
              RowBox[{"b", "[", "\"\<sA\>\"", "]"}]}]}], "|>"}]}], "]"}]}]}], 
       "]"}], ";", "b"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticOperations", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"a", ",", "\"\<sA\>\""}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<I\>\"", ",", "\"\<F\>\"", ",", "\"\<R\>\"", 
       ",", "\"\<RF\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<I\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticGroupKey", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"First", "[", 
    RowBox[{"Sort", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"sectorKey", "[", 
        RowBox[{"staticTransformLabels", "[", 
         RowBox[{"a", ",", "#"}], "]"}], "]"}], "&"}], " ", "/@", " ", 
      RowBox[{"staticOperations", "[", "a", "]"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticIndexMap", "[", 
    RowBox[{"ids_", ",", "l_", ",", "op_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"v", "=", "ids"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<F\>\"", ",", "\"\<RF\>\""}], "}"}], ",", "op"}], 
         "]"}], ",", 
        RowBox[{"v", "=", 
         RowBox[{
          RowBox[{"2", "^", "l"}], "+", "1", "-", "v"}]}]}], "]"}], ";", "\n",
       " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<RF\>\""}], "}"}], ",", "op"}], 
         "]"}], ",", 
        RowBox[{"v", "=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"1", "+", 
             RowBox[{"FromDigits", "[", 
              RowBox[{
               RowBox[{"Reverse", "[", 
                RowBox[{"IntegerDigits", "[", 
                 RowBox[{
                  RowBox[{"#", "-", "1"}], ",", "2", ",", "l"}], "]"}], "]"}],
                ",", "2"}], "]"}]}], "&"}], " ", "/@", " ", "v"}], ")"}]}]}], 
       "]"}], ";", "v"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticPairED", "[", 
    RowBox[{"ed_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", "ed"}], ",", 
       RowBox[{"ss", "=", 
        RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], ",", 
       RowBox[{"l", "=", 
        RowBox[{
         RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
         "]"}]}], ",", "groups", ",", "src", ",", "dst", ",", "ops", ",", 
       "op", ",", "mapped", ",", "pos", ",", "rows", ",", "h", ",", "res", ",",
        "span", ",", "err", ",", "scale"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"groups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "ss", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"staticGroupKey", "[", 
           RowBox[{
            RowBox[{"ss", "[", 
             RowBox[{"[", "#", "]"}], "]"}], "[", "\"\<Labels\>\"", "]"}], 
           "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"src", "=", 
          RowBox[{"ss", "[", 
           RowBox[{"[", 
            RowBox[{"First", "[", "group", "]"}], "]"}], "]"}]}], ";", "\n", 
         "  ", 
         RowBox[{
          RowBox[{"ss", "[", 
           RowBox[{"[", 
            RowBox[{"First", "[", "group", "]"}], "]"}], "]"}], "=", 
          RowBox[{"Join", "[", 
           RowBox[{"src", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<SymmetrySource\>\"", "->", 
               RowBox[{"sectorKey", "[", 
                RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<SymmetryOperation\>\"", "->", "\"\<I\>\""}], ",", 
              RowBox[{"\"\<PairingError\>\"", "->", "0."}]}], "|>"}]}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dst", "=", 
             RowBox[{"ss", "[", 
              RowBox[{"[", "j", "]"}], "]"}]}], ";", 
            RowBox[{"ops", "=", 
             RowBox[{"Select", "[", 
              RowBox[{
               RowBox[{"staticOperations", "[", 
                RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{
                 RowBox[{"sectorKey", "[", 
                  RowBox[{"staticTransformLabels", "[", 
                   RowBox[{
                    RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], ",", "#"}], 
                   "]"}], "]"}], "===", 
                 RowBox[{"sectorKey", "[", 
                  RowBox[{"dst", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                "&"}]}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{"ops", "=!=", 
               RowBox[{"{", "}"}]}], 
              ",", "\"\<No symmetry operator for the requested sector \
partner.\>\""}], "]"}], ";", 
            RowBox[{"op", "=", 
             RowBox[{"First", "[", "ops", "]"}]}], ";", "\n", "   ", 
            RowBox[{"mapped", "=", 
             RowBox[{"staticIndexMap", "[", 
              RowBox[{
               RowBox[{"src", "[", "\"\<Indices\>\"", "]"}], ",", "l", ",", 
               "op"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", "mapped", "]"}], "===", 
                RowBox[{"Sort", "[", 
                 RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}], "]"}]}], " ", "&&",
                " ", 
               RowBox[{
                RowBox[{"src", "[", "\"\<Dimension\>\"", "]"}], "==", 
                RowBox[{"dst", "[", "\"\<Dimension\>\"", "]"}]}]}], 
              ",", "\"\<Symmetry partner dimensions/indices disagree.\>\""}], 
             "]"}], ";", "\n", "   ", 
            RowBox[{"pos", "=", 
             RowBox[{"Lookup", "[", 
              RowBox[{
               RowBox[{"AssociationThread", "[", 
                RowBox[{"mapped", ",", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "mapped", "]"}], "]"}]}], "]"}], ",", 
               RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}]}], "]"}]}], ";", 
            RowBox[{"rows", "=", 
             RowBox[{
              RowBox[{"src", "[", "\"\<Vectors\>\"", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "pos"}], "]"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"(*", " ", 
             RowBox[{
             "Validate", " ", "the", " ", "mapped", " ", "basis", " ", 
              "against", " ", "the", " ", "ACTUAL", " ", "returned", " ", 
              "child", " ", 
              RowBox[{"eigenspace", "."}]}], " ", "*)"}], "\n", "   ", 
            RowBox[{"span", "=", 
             RowBox[{"maxAbs", "[", 
              RowBox[{"rows", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"rows", " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", 
                   RowBox[{"dst", "[", "\"\<Vectors\>\"", "]"}], "]"}]}], 
                 ")"}], " ", ".", " ", 
                RowBox[{"dst", "[", "\"\<Vectors\>\"", "]"}]}]}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"h", "=", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{
                RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}], ",", 
                  RowBox[{"dst", "[", "\"\<Indices\>\"", "]"}]}], "]"}], 
                "]"}], "]"}], "]"}]}], ";", 
            RowBox[{"scale", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Norm", "[", 
                RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", 
            "   ", 
            RowBox[{"res", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Norm", "[", 
                  RowBox[{
                   RowBox[{"h", " ", ".", " ", "#2"}], "-", 
                   RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"dst", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
                  "rows"}], "}"}]}], "]"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"err", "=", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{"src", "[", "\"\<Eigenvalues\>\"", "]"}], "-", 
               RowBox[{"dst", "[", "\"\<Eigenvalues\>\"", "]"}]}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"span", "<", 
                RowBox[{"100", " ", "tol"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Max", "[", 
                 RowBox[{"res", ",", "err"}], "]"}], "<", 
                RowBox[{"100", " ", "tol", " ", "scale"}]}]}], 
              ",", "\"\<Symmetry-paired child-sector validation \
failed.\>\""}], "]"}], ";", "\n", "   ", 
            RowBox[{
             RowBox[{"ss", "[", 
              RowBox[{"[", "j", "]"}], "]"}], "=", 
             RowBox[{"Join", "[", 
              RowBox[{"dst", ",", 
               RowBox[{"<|", 
                RowBox[{
                 RowBox[{"\"\<Vectors\>\"", "->", 
                  RowBox[{"Developer`ToPackedArray", "[", "rows", "]"}]}], ",", 
                 RowBox[{"\"\<Residual\>\"", "->", "res"}], ",", 
                 RowBox[{"\"\<SymmetrySource\>\"", "->", 
                  RowBox[{"sectorKey", "[", 
                   RowBox[{"src", "[", "\"\<Labels\>\"", "]"}], "]"}]}], ",", 
                 RowBox[{"\"\<SymmetryOperation\>\"", "->", "op"}], ",", 
                 RowBox[{"\"\<PairingError\>\"", "->", 
                  RowBox[{"Max", "[", 
                   RowBox[{"span", ",", 
                    RowBox[{"res", "/", "scale"}], ",", 
                    RowBox[{"err", "/", "scale"}]}], "]"}]}]}], "|>"}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"Rest", "[", "group", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"out", "[", "\"\<Sectors\>\"", "]"}], "=", "ss"}], ";", 
      "out"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticEquivalenceCheck", "[", 
    RowBox[{"ss_", ",", "l_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"groups", ",", "src", ",", "op", ",", "half", ",", "err"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"groups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"ss", ",", 
         RowBox[{
          RowBox[{"staticGroupKey", "[", 
           RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}]}], "]"}]}],
       ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"src", "=", 
          RowBox[{"First", "[", "group", "]"}]}], ";", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"op", "=", 
             RowBox[{"s", "[", "\"\<SymmetryOperation\>\"", "]"}]}], ";", 
            "\n", "  ", 
            RowBox[{"half", "=", 
             RowBox[{
              RowBox[{"EvenQ", "[", "l", "]"}], " ", "||", " ", 
              RowBox[{"!", 
               RowBox[{"MemberQ", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"\"\<R\>\"", ",", "\"\<RF\>\""}], "}"}], ",", 
                 "op"}], "]"}]}]}]}], ";", "\n", "  ", 
            RowBox[{"err", "=", 
             RowBox[{"Max", "[", 
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<IPR\>\"", "]"}], "-", 
                 RowBox[{"src", "[", "\"\<IPR\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<EdgesEntropy\>\"", "]"}], "-", 
                 RowBox[{"src", "[", "\"\<EdgesEntropy\>\"", "]"}]}], "]"}], ",", 
               RowBox[{"If", "[", 
                RowBox[{"half", ",", 
                 RowBox[{"maxAbs", "[", 
                  RowBox[{
                   RowBox[{"s", "[", "\"\<HalfEntropy\>\"", "]"}], "-", 
                   RowBox[{"src", "[", "\"\<HalfEntropy\>\"", "]"}]}], "]"}], 
                 ",", "0."}], "]"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"check", "[", 
             RowBox[{
              RowBox[{"err", "<", 
               RowBox[{"100", " ", "tol"}]}], 
              ",", "\"\<Symmetry-paired entropy/IPR check failed.\>\""}], 
             "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "True"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticSectorSlug", "[", "a_", "]"}], " ", ":=", " ", 
   RowBox[{"StringRiffle", "[", 
    RowBox[{
     RowBox[{"KeyValueMap", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"#1", "<>", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{"#2", ",", "InputForm"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\"\<-\>\"", "->", "\"\<minus\>\""}], ",", 
             RowBox[{"\"\</\>\"", "->", "\"\<over\>\""}], ",", 
             RowBox[{"\"\< \>\"", "->", "\"\<\>\""}], ",", 
             RowBox[{"\"\<.\>\"", "->", "\"\<p\>\""}]}], "}"}]}], "]"}]}], 
        "&"}], ",", 
       RowBox[{"KeySort", "[", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"KeyExistsQ", "[", 
           RowBox[{"a", ",", "\"\<sA\>\""}], "]"}], ",", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"a", ",", 
            RowBox[{"{", "\"\<m\>\"", "}"}]}], "]"}], ",", "a"}], "]"}], 
        "]"}]}], "]"}], ",", "\"\<_\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticGroupSlug", "[", "labels_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"s", "=", 
       RowBox[{"StringRiffle", "[", 
        RowBox[{
         RowBox[{"staticSectorSlug", " ", "/@", " ", "labels"}], 
         ",", "\"\<__\>\""}], "]"}]}], "}"}], ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"StringLength", "[", "s", "]"}], "<=", "190"}], ",", "s", ",", 
       RowBox[{
        RowBox[{"StringTake", "[", 
         RowBox[{"s", ",", "155"}], "]"}], "<>", "\"\<_\>\"", "<>", 
        RowBox[{"IntegerString", "[", 
         RowBox[{
          RowBox[{"Hash", "[", 
           RowBox[{"s", ",", "\"\<SHA256\>\""}], "]"}], ",", "16", ",", 
          "16"}], "]"}]}]}], "]"}]}], "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[62]:=",ExpressionUUID->"4a960904-2b87-0b42-9816-2e286f4e374d"],

