        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "[", "4", "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "keys", ",", "rr"}], "}"}],
      ",", "\n", " ", 
