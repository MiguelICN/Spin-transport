              RowBox[{"Length", "[", "vals", "]"}]}], ",", 
             RowBox[{"Missing", "[", 
              RowBox[{"r", "[", "\"\<Status\>\"", "]"}], "]"}]}], "]"}]}]}], 
         "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
