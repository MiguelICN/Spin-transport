Cell[CellGroupData[{

Cell["  3. Dynamics of the edge dynamical map  ", "Title",ExpressionUUID->"c7d6fba0-f1e0-1744-9137-8c8fbb948547"],

Cell[CellGroupData[{

Cell["\<\
  3.1 Definitions: complete map from a fixed bulk preparation  \
\>", "Subsection",ExpressionUUID->"466e72f2-3c2c-8a4b-9125-ee35d9af8859"],

Cell[CellGroupData[{

Cell["  Channel construction, diagnostics and long-time average  ", \
"Subsubsection",ExpressionUUID->"39b8756b-a4d1-b943-b175-efc018cfe308"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"edgeMapFactor", "[", 
    RowBox[{"f_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"joinStates", "[", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "4", "]"}], ",", "f", ",", "l"}], "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"choiFactor", "[", 
    RowBox[{"a_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Dimensions", "[", "a", "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "/", "4"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"IntegerQ", "[", "r", "]"}], 
        ",", "\"\<The general Choi factor requires 4r columns.\>\""}], "]"}], 
      ";", "\n", " ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"ArrayReshape", "[", 
           RowBox[{
            RowBox[{"partitionFactor", "[", 
             RowBox[{"a", ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", "l"}], "}"}], ",", "l"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"4", ",", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"l", "-", "2"}], ")"}]}], ",", "4", ",", "r"}], 
             "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"2", ",", "3", ",", "1", ",", "4"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"16", ",", 
          RowBox[{
           RowBox[{"2", "^", 
            RowBox[{"(", 
             RowBox[{"l", "-", "2"}], ")"}]}], " ", "r"}]}], "}"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"choiToTransfer", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"c", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"3", ",", "1", ",", "4", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"transferToChoi", "[", "s_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"s", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "4", ",", "1", ",", "3"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"applyTransfer", "[", 
    RowBox[{"s_", ",", "x_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"s", " ", ".", " ", 
      RowBox[{"Flatten", "[", "x", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"choiTraceOut", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"TensorContract", "[", 
    RowBox[{
     RowBox[{"ArrayReshape", "[", 
      RowBox[{"c", ",", 
       RowBox[{"{", 
        RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{"2", ",", "4"}], "}"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"choiPartialTransposeOut", "[", "c_", "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{
       RowBox[{"ArrayReshape", "[", 
        RowBox[{"c", ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4", ",", "4", ",", "4"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "4", ",", "3", ",", "2"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapBuild", "[", 
    RowBox[{"p_", ",", "bulkFac_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"projectionCut_", ":", "0"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "eng"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixQ", "[", 
          RowBox[{"bulkFac", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "bulkFac", "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], " ",
          "&&", "\n", "  ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"bulkFac", ",", "\"\<Frobenius\>\""}], "]"}], "^", 
             "2"}], "-", "1"}], "]"}], "<", 
          RowBox[{"100", " ", "tol"}]}]}], 
        ",", "\"\<Invalid normalized bulk factor.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"a", "=", 
       RowBox[{"edgeMapFactor", "[", 
        RowBox[{"bulkFac", ",", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"eng", "=", 
       RowBox[{"occupiedEngine", "[", 
        RowBox[{"p", ",", "a", ",", "tol", ",", "projectionCut"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"eng", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<BulkFactor\>\"", "->", "bulkFac"}], ",", 
          
          RowBox[{"\"\<MapConstruction\>\"", 
           "->", "\"\<FourInputFactor\>\""}]}], "|>"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapChoiFromFactor", "[", 
    RowBox[{"a_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"w", "=", 
       RowBox[{"choiFactor", "[", 
