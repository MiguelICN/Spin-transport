Cell["\<\
  2.4 Assemble the factor, inspect sector weights, and diagonalize occupied \
sectors  \
\>", "Subsection",ExpressionUUID->"808a305b-e218-ea40-ab8b-8882d1687151"],

Cell[CellGroupData[{

