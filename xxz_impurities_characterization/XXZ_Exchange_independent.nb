     RowBox[{"coherence", "-", 
      RowBox[{
      "sensitive", " ", "alternatives", " ", "include", " ", "the", " ", 
       "two", " ", "orthogonal", " ", "Bell", " ", 
       RowBox[{"states", "."}]}]}]}]}], " ", "*)"}], "\n"}]], "Code",Expressio\
nUUID->"8dcf3f9f-e8d5-c648-8678-2532d149bcbd"]
