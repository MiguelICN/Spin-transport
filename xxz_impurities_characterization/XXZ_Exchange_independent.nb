Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAChecks", "=", 
   RowBox[{"qstStateChecks", "[", 
    RowBox[{
    "qstAEngine", ",", "qstAFactor", ",", "qstABulkFactor", ",", 
     "qstARecords", ",", 
     RowBox[{"qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstAShortChecks", "=", 
   RowBox[{"qstStateChecks", "[", 
    RowBox[{
    "qstAEngine", ",", "qstAFactor", ",", "qstABulkFactor", ",", 
     "qstAShortRecords", ",", 
     RowBox[{"qstASettingsUsed", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", "qstAChecks", "]"}], "]"}], ";"}], "\n"}], "Code",E\
xpressionUUID->"9f80a039-0684-bf4d-9723-45efee1f356b"],

Cell["\<\
  The checks include t=0, physical bounds or CP/TP, batched versus \
single-time endpoints, and full-chain MatrixExp references at \
first/middle/last times for L<=6, built from regimeHamiltonian. These test \
the evolution/partial-trace pipeline, not independent Hamiltonian assembly. \
Above L=6 that expensive reference is explicitly marked SkippedAboveL. Setup \
audits check invariant blocks before any ED. Negative grand sums within \
roundoff are retained and their rugosity is marked invalid, never clipped.  \
\>", "Text",ExpressionUUID->"f96c7411-f5b6-3f48-93c0-4ae16114ea3d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.A.5 Optional infinite-time values and sampled-window rugosity  \
\>", "Subsection",ExpressionUUID->"cf87cfe5-e9b6-024c-95f5-6aaaba44b66c"],

Cell[BoxData[""], "Input",ExpressionUUID->"74b691bf-3bf0-824f-86e3-e23741a5d182"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAInfiniteTime", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "qstAComputeInfiniteTime", "]"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"qstAverageState", "[", 
        RowBox[{"qstAEngine", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
      "qstAClusterTolerances"}], ",", 
     RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"qstAWindowR", "=", 
   RowBox[{"qstWindowMean", "[", 
    RowBox[{"qstARecords", ",", "\"\<RugosityAB\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"qstAInfiniteTime", ",", "qstAWindowR"}], "}"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"fafa0687-ad2d-9f49-ab0a-\
44ab16194957"],

Cell["\<\
  Energy clusters include all evolved sectors together (ZZ: all four edge \
configurations), preserving coherences within each degenerate cluster. \
Compare the results at all cluster tolerances. The sampled-window rugosity \
uses trapezoidal integration in physical time, including on a logarithmic \
grid. A sampled zero makes this estimate \
Missing[SingularSamplesRequireQuadrature], because an isolated logarithmic \
singularity need not have an infinite integral. It is never replaced by the \
rugosity of an averaged state.  \
\>", "Text",ExpressionUUID->"f0b0e343-7fdd-7545-ba2a-5f3fa6d8bdca"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.A.6 Plots from the settings attached to the computed records  \
\>", "Subsection",ExpressionUUID->"81568b57-c5e2-b74d-a366-5bb0842f27f0"],

Cell[BoxData[""], "Input",ExpressionUUID->"f4409ba8-ac87-8e44-80f4-7f4df1e2713f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"chopRecordsInPlace", "[", 
   RowBox[{"qstARecords", ",", "recordChopTolerance"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chopRecordsInPlace", "[", 
   RowBox[{"qstAShortRecords", ",", "recordChopTolerance"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"924fb6c5-97c1-6e44-b312-\
f6ed07e03307"],

Cell[BoxData[""], "Input",ExpressionUUID->"8cf05bb9-c7a1-5a47-a5f2-74bc22de9f62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAPlots", "=", 
   RowBox[{"texturePanels", "[", 
    RowBox[{
    "qstARecords", ",", "qstAShortRecords", ",", "qstAUsed", ",", 
     "qstAShortUsed", ",", "False"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "qstAExportLogPlots", "]"}], ",", 
    RowBox[{"qstAPlots", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"qstAPlots", ",", "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\"\<log_\>\"", "<>", "#1"}], ")"}], "->", "#2"}], "&"}],
           ",", 
          RowBox[{"texturePanels", "[", 
           RowBox[{
           "qstARecords", ",", "qstAShortRecords", ",", "qstAUsed", ",", 
            "qstAShortUsed", ",", "True"}], "]"}]}], "]"}], "]"}]}], 
      "]"}]}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"qstAPlots", "[", "\"\<GrandSums\>\"", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"b00642a5-b47a-0a4b-8f73-\
d6c74c5363b5"],

Cell["\<\
  Every curve uses small unjoined markers. Triangle marks on an annotated \
upper rail identify Infinity or invalid rugosity values, with their actual \
times and values stated below the panel. Log-time plots exclude t=0 \
explicitly; only the horizontal axis is logarithmic. Coherence indices \
0,1,2,3 mean 00,01,10,11. Extreme response vectors inside a degenerate \
eigenspace are not unique; their individual f1 overlaps depend on the \
returned basis.  \
\>", "Text",ExpressionUUID->"28e7e2a4-6459-2149-a048-cba589752515"]
}, Open  ]],

