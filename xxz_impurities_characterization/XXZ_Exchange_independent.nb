Cell[CellGroupData[{

Cell["  2.3 One active initial-state assignment  ", "Subsection",ExpressionUUID->"deb2557c-b83c-b34f-ad37-fc8f2cf42085"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynInitial", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", "\n", " ", 
     RowBox[{"\"\<EdgeState\>\"", "->", 
      RowBox[{"Normalize", "[", 
       RowBox[{"{", 
        RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
     "\n", " ", 
     RowBox[{"\"\<Bulk\>\"", "->", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
        RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
      "Replace", " ", "the", " ", "assignment", " ", "above", " ", "for", " ",
        "a", " ", "bulk", " ", 
       RowBox[{"helix", ":", "\n", " ", "dynInitial"}]}], "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Mode\>\"", "->", "\"\<Product\>\""}], ",", 
        RowBox[{"\"\<EdgeState\>\"", "->", 
         RowBox[{"Normalize", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0", ",", "1"}], "}"}], "]"}]}], ",", 
        "\n", "  ", 
        RowBox[{"\"\<Bulk\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
           RowBox[{"\"\<q\>\"", "->", 
            RowBox[{"Pi", "/", "3"}]}], ",", 
           RowBox[{"\"\<theta\>\"", "->", 
            RowBox[{"Pi", "/", "2"}]}], ",", 
           RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}]}], "|>"}]}], ";", 
     "\n", " ", 
     RowBox[{
     "Full", " ", "helix", " ", "on", " ", "physical", " ", "sites", " ", 
      "1"}]}], ",", "...", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"L", ":", "\n", " ", "dynInitial"}], "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
        RowBox[{"\"\<FullState\>\"", "->", 
         RowBox[{"helix", "[", 
          RowBox[{
           RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ",", 
           RowBox[{"Pi", "/", "3"}], ",", 
           RowBox[{"Pi", "/", "2"}], ",", "0"}], "]"}]}]}], "|>"}]}], ";", 
     "\n", " ", 
     RowBox[{
      RowBox[{"General", " ", "full", " ", 
       RowBox[{"vector", "/", "density"}], " ", 
       RowBox[{"matrix", ":", "\n", " ", "dynInitial"}]}], "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Mode\>\"", "->", "\"\<Full\>\""}], ",", 
        RowBox[{"\"\<FullState\>\"", "->", "yourFullState"}]}], "|>"}]}], ";",
      "\n", " ", 
     RowBox[{
     "A", " ", "mixed", " ", "edge", " ", "state", " ", "is", " ", "also", " ",
       "allowed", " ", "in", " ", "Product", " ", 
      RowBox[{"mode", "."}]}]}]}], "\n", "*)"}]}]}], "Code",
