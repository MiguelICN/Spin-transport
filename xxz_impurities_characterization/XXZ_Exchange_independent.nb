Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"staticPoint", "[", 
    RowBox[{"p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"addEntropies", "[", 
         RowBox[{"staticPairED", "[", 
          RowBox[{
           RowBox[{"regimeED", "[", 
            RowBox[{"p", ",", "tol"}], "]"}], ",", "tol"}], "]"}], "]"}]}], ",",
        "out"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", 
           RowBox[{"Join", "[", 
            RowBox[{"s", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<IPR\>\"", "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                 " ", "/@", " ", 
                 RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
              "|>"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"AllTrue", "[", 
         RowBox[{"out", ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"2.", "^", 
               RowBox[{"(", 
                RowBox[{"-", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ")"}]}], "-", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
             RowBox[{"1", "+", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
             RowBox[{
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "]"}], " ", 
               RowBox[{"Log", "[", "2", "]"}]}], "+", 
              RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "  ", 
            RowBox[{
             RowBox[{"Min", "[", 
              RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
             RowBox[{
              RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
             RowBox[{
              RowBox[{"Log", "[", "4", "]"}], "+", 
              RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], 
        ",", "\"\<Eigenstate bounds failed.\>\""}], "]"}], ";", "\n", " ", 
      "\n", " ", 
      RowBox[{"staticEquivalenceCheck", "[", 
       RowBox[{"out", ",", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"KeyDrop", "[", 
         RowBox[{"ed", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Hamiltonian\>\"", ",", "\"\<Sectors\>\""}], "}"}]}], 
         "]"}], ",", 
        RowBox[{"<|", 
         RowBox[{"\"\<Sectors\>\"", "->", "out"}], "|>"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"staticScan", "[", 
    RowBox[{"base_Association", ",", "axis_String", ",", "grid_List", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"models", ",", "points"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<g\>\"", ",", "\"\<Delta\>\""}], "}"}], ",", "axis"}],
           "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "grid", "]"}], ">=", "1"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"grid", ",", "realQ"}], "]"}], " ", "&&", "\n", "  ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "grid", "]"}], "==", "1"}], " ", "||", " ", 
           RowBox[{"And", "@@", 
            RowBox[{"Thread", "[", 
             RowBox[{
              RowBox[{"Differences", "[", 
               RowBox[{"N", "[", "grid", "]"}], "]"}], ">", "0"}], "]"}]}]}], 
          ")"}]}], 
        ",", "\"\<Use an increasing real scan grid for g or Delta.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"models", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"regimeModel", "[", 
          RowBox[{"Join", "[", 
           RowBox[{"base", ",", 
            RowBox[{"<|", 
             RowBox[{"axis", "->", "#"}], "|>"}]}], "]"}], "]"}], "&"}], " ", 
        "/@", " ", "grid"}]}], ";", "\n", " ", 
      RowBox[{"points", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"staticPoint", "[", 
           RowBox[{"#", ",", "tol"}], "]"}], "&"}], ",", "models"}], "]"}]}], 
      ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Axis\>\"", "->", "axis"}], ",", 
        RowBox[{"\"\<Grid\>\"", "->", "grid"}], ",", 
        RowBox[{"\"\<BaseModel\>\"", "->", "base"}], ",", 
        RowBox[{"\"\<EDTolerance\>\"", "->", "tol"}], ",", 
        RowBox[{"\"\<Points\>\"", "->", "points"}], ",", "\n", "  ", 
        RowBox[{"\"\<SectorKeys\>\"", "->", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"Flatten", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"sectorKey", "[", 
                 RowBox[{"#", "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], " ",
                "/@", " ", 
               RowBox[{"#", "[", "\"\<Sectors\>\"", "]"}]}], ")"}], "&"}], 
            " ", "/@", " ", "points"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[71]:=",ExpressionUUID->"9c3aa84e-e88b-744c-9dc4-a4058f09df6d"],

Cell["\<\
 Static eigenvectors in partner sectors are generated by F, R or RF and \
checked against the independently computed child eigenspace and Hamiltonian. \
All raw eigenvalues and labels are retained. Opposite parities are never \
merged. Odd-L antiparallel half-chain entropies have two distinct \
F-equivalence families. Recompute static scans after updating these \
definitions; old independently diagonalized degenerate eigenbases must not be \
used to claim entropy/IPR equality. \
\>", "Text",ExpressionUUID->"e7a8470f-8d8b-f643-83cf-0058ec0c9980"]
}, Open  ]],

