Cell[CellGroupData[{

Cell["\<\
  4.B.1 Texturizing power of the bulk-induced channel \[LongDash] editable \
inputs  \
\>", "Subsection",ExpressionUUID->"66bf670d-09aa-ee4d-bd50-33da7daefe2d"],

Cell["\<\
  Phi_t(X)=Tr_E[U_t (X tensor rhoE) U_t dagger] is constructed without an \
edge input. f1 is used only afterward to measure texturizing power. \
OmegaTF=1-Sigma[Phi(f1)]/4 and OmegaR=-log(Sigma[Phi(f1)]/4). The response \
operator R=4 Phi_dual(f1) satisfies Sigma[Phi(rho)]=Tr[R rho]. A free channel \
fixes f1; a texture-preserving channel has R=4 f1. These are tested by \
separate distances. The three Sigma routes are direct output, \
(ones.S.ones)/4, and grandSum[Choi]/4; Choi is unnormalized with trace 4. \
Their agreement tests indexing conventions, not independent channel physics. \
For ZZ, ResponseOperator=Transpose[Gamma], OutputF1=Gamma/4, and \
OmegaTF=3/4-Sum[Re Gamma_ij,i<j]/8 are also checked. Thus ZZ texture is a \
functional of the six overlaps already underlying the dephasing channel.  \
\>", "Text",ExpressionUUID->"8b1110d3-e62b-5648-93aa-b0b646c73563"],

Cell[BoxData[""], "Input",ExpressionUUID->"ebd238fb-4eea-0d4c-aa95-744af80e6a73"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstBModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", 
      RowBox[{"9", "/", "20"}]}], ",", 
     RowBox[{"\"\<g\>\"", "->", 
      RowBox[{"1", "/", "10"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBBulk", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
     RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBBulkNote", "=", "\"\<Neel bulk, first bit 0\>\""}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternatives", ":", " ", 
      RowBox[{
      "replace", " ", "the", " ", "one", " ", "assignment", " ", "above", " ",
        "and", " ", "its", " ", 
       RowBox[{"note", ".", "\n", " ", "qstBBulk"}]}]}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Polarized\>\""}], ",", 
       RowBox[{"\"\<Bit\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "planar", " ", "*)"}], "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "4"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "conical", " ", "*)"}], "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<PolarHelix\>\""}], ",", 
       RowBox[{"\"\<ThetaList\>\"", "->", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "6"}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"Pi", "/", "6"}]}], ",", 
           RowBox[{
            RowBox[{"qstBModel", "[", "\"\<L\>\"", "]"}], "-", "3"}]}], "]"}],
          "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<PhiList\>\"", "->", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"qstBModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], 
         "]"}]}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<User\>\""}], ",", 
       RowBox[{"\"\<State\>\"", "->", "yourBulkDensityMatrix"}]}], "|>"}]}], ";",
     "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{"\"\<Type\>\"", "->", "\"\<InfiniteT\>\""}], "|>"}]}], ";", 
    "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Gibbs\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstBBulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Typical\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
       RowBox[{"\"\<Samples\>\"", "->", "4"}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{
    "A", " ", "polar", " ", "helix", " ", "is", " ", "specified", " ", "by", " ",
      "the", " ", "actual", " ", "local", " ", "angles"}], ";", " ", 
    RowBox[{
     RowBox[{"no", " ", "exact"}], "-", 
     RowBox[{"eigenstate", " ", "condition", " ", "is", " ", 
      RowBox[{"assumed", "."}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"qstBTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "40."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.2"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<EDTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<ValidationTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", 
      RowBox[{"\"\<SectorCut\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<KrausTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "KrausTolerance", " ", "is", " ", "used", " ", "only", " ", "by", " ", 
     "B"}], ",", " ", 
    RowBox[{
    "retained", " ", "in", " ", "both", " ", "snapshots", " ", "for", " ", 
     "optional", " ", "exact", " ", 
     RowBox[{"A", "/", "B"}], " ", 
     RowBox[{"comparison", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstBParallel", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Enabled\>\"", "->", "False"}], ",", 
      RowBox[{"\"\<Kernels\>\"", "->", "12"}], ",", 
      RowBox[{"\"\<ChunkSize\>\"", "->", "16"}], ",", 
      RowBox[{"\"\<MemoryMB\>\"", "->", "512"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Exchange", " ", "B", " ", "with", " ", "a", " ", "full"}], "-", 
       RowBox[{"rank", " ", "bulk", " ", "at", " ", "total", " ", "L"}]}], "=", 
      RowBox[{
       RowBox[{"12", " ", "requires", " ", "MemoryMB"}], ">=", 
       RowBox[{
       "1024", "\n", " ", "for", " ", "ONE", " ", "serial", " ", 
        "slice"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "floor", " ", "multiplies", " ", "by", " ", "the", " ", 
       "number", " ", "of", " ", "active", " ", 
       RowBox[{"workers", ".", "\n", " ", "This"}], " ", "transient"}], "-", 
      RowBox[{
      "factor", " ", "budget", " ", "excludes", " ", "eigensystems"}]}]}], ",",
     " ", 
    RowBox[{"records", " ", "and", " ", "worker", " ", 
     RowBox[{"copies", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"qstBComputeInfiniteTime", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBClusterTolerances", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"10", "^", 
      RowBox[{"-", "12"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "10"}]}], ",", 
     RowBox[{"10", "^", 
      RowBox[{"-", "8"}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBRandomTests", "=", "20"}], ";", 
  RowBox[{"qstBRandomSeed", "=", "2026"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBExportLogPlots", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstBRunLabel", "=", "\"\<Exchange_texturizing_power\>\""}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"a045a2bf-fc49-db42-86f5-\
cd4366c9b0cf"]
}, Open  ]],

