Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeSplit", "[", 
     RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"alias", ",", "label", ",", "out"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"alias", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{"name", ",", 
          RowBox[{"\"\<BulkS2\>\"", "|", "\"\<EdgeS2\>\""}], ",", "\"\<S2\>\"",
           ",", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredS2\>\"", ",", 
          "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"label", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{
         "name", ",", "\"\<BulkS2\>\"", ",", "\"\<SBulk\>\"", 
          ",", "\"\<EdgeS2\>\"", ",", "\"\<SEdge\>\"", ",", "\n", 
          "  ", "\"\<StaggeredBulkS2\>\"", ",", "\"\<StaggeredSBulk\>\"", ",",
           "_", ",", "name"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"out", "=", 
        RowBox[{"splitCharge", "[", 
         RowBox[{"s", ",", "q", ",", "alias", ",", "tol"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"alias", "=!=", "name"}], ",", 
         RowBox[{"out", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{"Function", "[", 
             RowBox[{"t", ",", 
              RowBox[{"Join", "[", 
               RowBox[{"t", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Labels\>\"", "->", 
                  RowBox[{"Append", "[", "\n", "   ", 
                   RowBox[{
                    RowBox[{"KeyDrop", "[", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "}"}]}], "]"}], ",", 
                    "\n", "   ", 
                    RowBox[{"label", "->", 
                    RowBox[{
                    RowBox[{"t", "[", "\"\<Labels\>\"", "]"}], "[", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"alias", "==", "\"\<S2\>\""}], ",", "\"\<S\>\"", 
                    ",", "\"\<StaggeredS\>\""}], "]"}], "]"}]}]}], "]"}]}], 
                 "|>"}]}], "]"}]}], "]"}], ",", "out"}], "]"}]}]}], "]"}], ";",
        "\n", " ", "out"}]}], "\n", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "A", " ", "charge", " ", "is", " ", "split", " ", "only", " ", "when", " ",
     "it", " ", "preserves", " ", "the", " ", "CURRENT", " ", 
    RowBox[{"subspace", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeRefine", "[", 
    RowBox[{"spaces_", ",", "q_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"out", "=", "spaces"}], ",", "next", ",", "b", ",", "a"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"next", "=", 
          RowBox[{"{", "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"b", "=", 
             RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
            RowBox[{"a", "=", 
             RowBox[{"herm", "[", 
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
               RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "]"}]}],
             ";", "\n", "   ", 
            RowBox[{"next", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"next", ",", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "<", 
                  RowBox[{"tol", " ", 
                   RowBox[{"Max", "[", 
                    RowBox[{"1.", ",", 
                    RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], ",", "Infinity"}], 
                    "]"}]}], "]"}]}]}], ",", "\n", "     ", 
                 RowBox[{"edgeSplit", "[", 
                  RowBox[{"s", ",", 
                   RowBox[{"q", "[", "name", "]"}], ",", "name", ",", "tol"}],
                   "]"}], ",", 
                 RowBox[{"{", "s", "}"}]}], "]"}]}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "out"}], "}"}]}], "]"}], ";", 
         RowBox[{"out", "=", "next"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"name", ",", 
          RowBox[{"Keys", "[", "q", "]"}]}], "}"}]}], "]"}], ";", "out"}]}], 
    "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[48]:=",ExpressionUUID->"77196a65-32d6-ed4b-b9eb-8ebb1911d1ea"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  Field-free model, full sectors and static scans  ", "Subsubsection",ExpressionUUID->"036b4982-c262-f94b-8ef3-0d12ad3fadae"],

Cell[BoxData[""], "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"ce09f98b-e87e-1449-8162-e984440670bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"regimeModel", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"p", ",", "\"\<L\>\"", ",", 
         RowBox[{"Missing", "[", "]"}]}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "l", "]"}], " ", "&&", " ", 
         RowBox[{"l", ">=", "4"}]}], 
        ",", "\"\<Use integer total length L>=4.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ContainsAll", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "p", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<g\>\""}], 
            "}"}]}], "]"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"p", ",", 
             RowBox[{"{", 
              RowBox[{"\"\<J\>\"", ",", "\"\<Delta\>\"", ",", "\"\<g\>\""}], 
              "}"}]}], "]"}], ",", "realQ"}], "]"}]}], ",", "\n", 
        "  ", "\"\<Specify finite real J, Delta and g.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"p", "[", "\"\<J\>\"", "]"}], "!=", "0"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"p", "[", "\"\<g\>\"", "]"}], "!=", "0"}]}], 
        ",", "\"\<J and g must be nonzero; g=0 is outside these \
notebooks.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "p", "]"}], ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
             ",", "\"\<g\>\""}], "}"}]}], "]"}], "===", 
         RowBox[{"{", "}"}]}], ",", "\n", 
        "  ", "\"\<Model parameters are only L, J, Delta and g. No \
magnetic-field parameter is accepted.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"p", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\"", 
          ",", "\"\<g\>\""}], "}"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"geometryParameters", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"KeyTake", "[", 
      RowBox[{"p", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<L\>\"", ",", "\"\<J\>\"", ",", "\"\<Delta\>\""}], 
        "}"}]}], "]"}], ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<h\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"regimeParts", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "x", ",", "y", ",", "z", 
       ",", "xy", ",", "zz", ",", "b"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"b", "=", 
       RowBox[{
        RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bondOp", "[", 
             RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
            RowBox[{"bondOp", "[", 
             RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}], "+", 
            RowBox[{
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "2", ",", 
             RowBox[{"l", "-", "2"}]}], "}"}]}], "]"}], "]"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"xy", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bondOp", "[", 
            RowBox[{"x", ",", "x", ",", "k", ",", "l"}], "]"}], "+", 
           RowBox[{"bondOp", "[", 
            RowBox[{"y", ",", "y", ",", "k", ",", "l"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"zz", "=", 
       RowBox[{"Total", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"bondOp", "[", 
           RowBox[{"z", ",", "z", ",", "k", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", 
              RowBox[{"l", "-", "1"}]}], "}"}]}], "}"}]}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Bulk\>\"", "->", 
         RowBox[{"SparseArray", "[", "b", "]"}]}], ",", 
        RowBox[{"\"\<Interaction\>\"", "->", 
         RowBox[{"SparseArray", "[", "xy", "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"regimeHamiltonian", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q", "=", 
        RowBox[{"regimeModel", "[", "p", "]"}]}], ",", "b"}], "}"}], ",", 
     "\n", " ", 
     RowBox[{
      RowBox[{"b", "=", 
       RowBox[{"regimeParts", "[", "q", "]"}]}], ";", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"b", "[", "\"\<Bulk\>\"", "]"}], "+", 
        RowBox[{
         RowBox[{"q", "[", "\"\<g\>\"", "]"}], " ", 
         RowBox[{"b", "[", "\"\<Interaction\>\"", "]"}]}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"bulkHamiltonian", "[", "p_Association", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "x", ",", 
       "y", ",", "z"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
        RowBox[{"Total", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"bondOp", "[", 
             RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
            RowBox[{"bondOp", "[", 
             RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", 
            RowBox[{
             RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
             RowBox[{"bondOp", "[", 
              RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}], "]"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"parameterNote", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Which", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", 
      RowBox[{
       RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "==", "0"}], "]"}], ",", 
     "\n", " ", "\"\<Delta=0: free-fermion Hamiltonian (conditional \
free-fermion bulk for ZZ). Additional mode occupations are conserved; \
spin/spatial sectors need not have nondegenerate energies.\>\"", ",", "\n", 
     " ", 
     RowBox[{"TrueQ", "[", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], "==", 
       RowBox[{"1", "/", "2"}]}], "]"}], ",", "\n", 
     " ", "\"\<Delta=+/-1/2: special bulk cross-magnetization degeneracies \
can affect weak-g level statistics.\>\"", ",", "True", 
     ",", "\"\<Generic anisotropy within the stated spin/spatial symmetry \
classification.\>\""}], "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[51]:=",ExpressionUUID->"ea4e98d6-8fab-3a48-af79-8e0932b603cf"],

