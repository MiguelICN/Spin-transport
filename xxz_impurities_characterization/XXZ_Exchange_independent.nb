 RowBox[{
  RowBox[{"texReady", "=", "Automatic"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tex", "[", 
    RowBox[{"s_String", ",", 
     RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "g", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"texReady", "===", "Automatic"}], ",", 
        RowBox[{"texReady", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"Check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], ",",
             "False"}], "]"}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", "texReady", "]"}], ",", 
        RowBox[{
         RowBox[{"g", "=", 
          RowBox[{"Quiet", "[", 
           RowBox[{"Check", "[", 
            RowBox[{
             RowBox[{"MaTeX`MaTeX", "[", 
              RowBox[{"s", ",", 
               RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", "$Failed"}], 
            "]"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"MatchQ", "[", 
            RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
           RowBox[{"Return", "[", "g", "]"}]}], "]"}], ";", 
         RowBox[{"texReady", "=", "False"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Style", "[", 
       RowBox[{"s", ",", "Black", ",", 
        RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
        RowBox[{"FontSize", "->", "size"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
