Cell[CellGroupData[{

Cell["  1.5 Export this scan  ", "Subsection",ExpressionUUID->"96a192c4-7e45-704f-abeb-1ff27baf2f56"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"ebcea78e-3655-c848-bc6e-e4aee9cb0df9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"statGDirectory", "=", 
   RowBox[{"staticExportBundle", "[", 
    RowBox[{
    "statGOutputRoot", ",", "statGRunLabel", ",", "statGPlots", ",", "\n", 
     " ", 
     RowBox[{"Join", "[", 
      RowBox[{"statGRun", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Seconds\>\"", "->", "statGSeconds"}], ",", 
         RowBox[{"\"\<PlotSettings\>\"", "->", "statGPlotSettings"}]}], 
        "|>"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "statGDirectory", "]"}], ";"}], "\n"}], "Code",
 CellLabel->
  "In[183]:=",ExpressionUUID->"4d6e8e39-6285-6a42-a9eb-841f5998ad02"],

Cell[BoxData["\<\"C:\\\\Users\\\\Miguel\\\\Documents\\\\GitHub\\\\Spin-\
transport\\\\xxz_impurities_characterization\\\\xxz_edge_regimes_results\\\\\
Exchange_static_g_run3\"\>"], "Print",
