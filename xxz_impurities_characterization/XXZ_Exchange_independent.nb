       RowBox[{"\"\<Records\>\"", "->", "mapRecords"}], ",", 
       RowBox[{"\"\<InfiniteTimeAverage\>\"", "->", "mapAverage"}], ",", "\n",
        " ", 
       RowBox[{"\"\<SetupSeconds\>\"", "->", "mapSetupSeconds"}], ",", 
       RowBox[{"\"\<EvolutionSeconds\>\"", "->", "mapSeconds"}]}], "|>"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "mapDirectory", "]"}], ";"}], "\n"}], "Code",Expressio\
nUUID->"0f5a910c-1d99-0449-b52e-27c0adf7fb30"],

Cell["\<\
  Examples for direct use: applyTransfer[mapRecords[[k]][\"Transfer\"],rhoAB] \
predicts any product-preparation edge input; mapRecords[[k]][\"ChoiState\"] \
is the normalized input-output Choi state. No chapter-2 evaluation is used.  \
\>", "Text",ExpressionUUID->"ed0bb589-0063-3a46-bd4f-0d333581b63c"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["  4. Quantum-state texture of the edge spins  ", "Title",ExpressionUUID->"44cae25a-2d03-0748-94bc-17a3002e79f3"],

Cell[CellGroupData[{

Cell["  4.1 Definitions shared only by the QST sections  ", "Subsection",ExpressionUUID->"256f45d3-4087-8e4a-b18c-d08573a480ab"],

Cell["\<\
  Sections A and B reuse initialization definitions, never evaluated results \
of chapters 1\[Dash]3 or of each other. Only the two edges are placed in \
f1=|++><++|; an all-plus bulk is excluded. The basis is {00,01,10,11}, with \
bit 0=up. All quantities are basis dependent. Sigma(rho)=sum of every matrix \
entry=D <f1|rho|f1>; TF=1-Sigma/D; R=-log(Sigma/D). D=4 for the pair and D=2 \
for a single edge. SigmaAB/4 is the probability of ++ (Hadamards followed by \
00). Nonmultiplicativity is SigmaAB-SigmaA SigmaB; l1 coherence sums absolute \
off-diagonal entries. References: the supplied QST specification, [P] de Leon \
et al., Role of quantum state texture in quantum chaos (draft), and [V] \
Vieira et al., arXiv:2609.05248. No claim about chaos follows from texture \
alone.  \
\>", "Text",ExpressionUUID->"e7804870-774c-fc42-a76d-9ba748bf4c71"],

Cell[CellGroupData[{

Cell["  Texture, evolution, averages and validation  ", "Subsubsection",ExpressionUUID->"e7b66208-39df-2240-8eb9-460fa477e96d"],

Cell[BoxData[""], "Input",ExpressionUUID->"4c20efab-cf6f-094b-8e1b-63988fb83d75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "edgeF1Ket", ",", "edgeF1", ",", "grandSum", ",", "textureF", ",", 
    "rugosity", ",", "l1Coherence", ",", "textureRecords", ",", "\n", " ", 
    "responseOperator", ",", "texturizingRecord", ",", "qstBulkFactor", ",", 
    "qstRunChunks", ",", "qstStateChunk", ",", "qstMapChunk", ",", "\n", " ", 
    "qstStateRecords", ",", "qstMapRecords", ",", "qstAverageState", ",", 
    "qstAverageChannel", ",", "qstWindowMean", ",", "\n", " ", 
    "qstReferenceTrace", ",", "qstReferenceEmbed", ",", "qstSmallReference", ",",
     "qstStateChecks", ",", "qstMapChecks", ",", "\n", " ", 
    "qstRandomResponseCheck", ",", "qstCompare", ",", "qstSaveComparison", ",",
     "qstEdgeConservationError", ",", "qstTex", ",", "qstTicks", ",", 
    "qstCaption", ",", "qstPanel", ",", "\n", " ", "texturePanels", ",", 
    "texturizingPanels", ",", "qstExport"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"edgeF1Ket", "=", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], ";", 
  RowBox[{"edgeF1", "=", 
   RowBox[{"ketRho", "[", "edgeF1Ket", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"grandSum", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Re", "[", 
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", "r", "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"textureF", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"1", "-", 
    RowBox[{
     RowBox[{"grandSum", "[", "r", "]"}], "/", 
     RowBox[{"Length", "[", "r", "]"}]}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rugosity", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{"grandSum", "[", "r", "]"}], "/", 
        RowBox[{"Length", "[", "r", "]"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Which", "[", 
      RowBox[{
       RowBox[{"TrueQ", "[", 
        RowBox[{"p", "==", "0"}], "]"}], ",", "Infinity", ",", 
       RowBox[{"TrueQ", "[", 
        RowBox[{"p", ">", "0"}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Log", "[", "p", "]"}]}], ",", "True", ",", 
       RowBox[{"Missing", "[", 
        RowBox[{"\"\<NegativeGrandSum\>\"", ",", "p"}], "]"}]}], "]"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"l1Coherence", "[", 
    RowBox[{"r_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{"Abs", "[", "r", "]"}], "]"}], "]"}], "-", 
    RowBox[{"Total", "[", 
     RowBox[{"Abs", "[", 
      RowBox[{"Diagonal", "[", "r", "]"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"textureRecords", "[", "records_List", "]"}], " ", ":=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{"rec", ",", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"r", "=", 
            RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}]}], ",", 
           RowBox[{"a", "=", 
            RowBox[{"rec", "[", "\"\<RhoA\>\"", "]"}]}], ",", 
           RowBox[{"b", "=", 
            RowBox[{"rec", "[", "\"\<RhoB\>\"", "]"}]}]}], "}"}], ",", "\n", 
         " ", 
         RowBox[{"Join", "[", 
          RowBox[{"rec", ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<SigmaAB\>\"", "->", 
              RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<SigmaA\>\"", "->", 
              RowBox[{"grandSum", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<SigmaB\>\"", "->", 
              RowBox[{"grandSum", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<TextureFAB\>\"", "->", 
              RowBox[{"textureF", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<TextureFA\>\"", "->", 
              RowBox[{"textureF", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<TextureFB\>\"", "->", 
              RowBox[{"textureF", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<RugosityAB\>\"", "->", 
              RowBox[{"rugosity", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<RugosityA\>\"", "->", 
              RowBox[{"rugosity", "[", "a", "]"}]}], ",", 
             RowBox[{"\"\<RugosityB\>\"", "->", 
              RowBox[{"rugosity", "[", "b", "]"}]}], ",", "\n", " ", 
             RowBox[{"\"\<Nonmultiplicativity\>\"", "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"grandSum", "[", "r", "]"}], "-", 
                RowBox[{
                 RowBox[{"grandSum", "[", "a", "]"}], " ", 
                 RowBox[{"grandSum", "[", "b", "]"}]}]}], ")"}]}], ",", "\n", 
             " ", 
             RowBox[{"\"\<L1Coherence\>\"", "->", 
              RowBox[{"l1Coherence", "[", "r", "]"}]}], ",", 
             RowBox[{"\"\<L1Normalized\>\"", "->", 
              RowBox[{
               RowBox[{"l1Coherence", "[", "r", "]"}], "/", "3"}]}], ",", 
             "\n", " ", 
             RowBox[{"\"\<LinearEntropy\>\"", "->", 
              RowBox[{"1", "-", 
               RowBox[{"rec", "[", "\"\<Purity\>\"", "]"}]}]}], ",", 
             RowBox[{"\"\<NormalizedEntropy\>\"", "->", 
              RowBox[{
               RowBox[{"rec", "[", "\"\<EntropyAB\>\"", "]"}], "/", 
               RowBox[{"Log", "[", "4", "]"}]}]}], ",", "\n", " ", 
             RowBox[{"\"\<F1Probability\>\"", "->", 
              RowBox[{"Re", "[", 
               RowBox[{
                RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
                "r", " ", ".", " ", "edgeF1Ket"}], "]"}]}]}], "|>"}]}], 
          "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"responseOperator", "[", 
    RowBox[{"s_", "?", "MatrixQ"}], "]"}], " ", ":=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"ArrayReshape", "[", 
     RowBox[{
      RowBox[{"Total", "[", "s", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n"}], "Code",\
ExpressionUUID->"4d66228a-db26-6646-89bc-c3dbbd094624"],

Cell[BoxData[""], "Input",ExpressionUUID->"96f60605-a6ec-3945-83be-bd29cb341ba8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstBulkFactor", "[", 
     RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{
          RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", "f", ",", 
        "theta", ",", "phi", ",", "prob"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], 
           "==", "\"\<PolarHelix\>\""}], ",", "\n", "  ", 
          RowBox[{
           RowBox[{"theta", "=", 
            RowBox[{"spec", "[", "\"\<ThetaList\>\"", "]"}]}], ";", 
           RowBox[{"phi", "=", 
            RowBox[{"Lookup", "[", 
             RowBox[{"spec", ",", "\"\<PhiList\>\"", ",", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"0", ",", "n"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "theta", "]"}], "==", "n"}], " ", "&&", 
              " ", 
              RowBox[{
               RowBox[{"Length", "[", "phi", "]"}], "==", "n"}], " ", "&&", 
              " ", 
              RowBox[{"AllTrue", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{"theta", ",", "phi"}], "]"}], ",", "realQ"}], 
               "]"}]}], ",", "\n", 
             "   ", "\"\<PolarHelix requires real ThetaList and PhiList with \
L-2 entries.\>\""}], "]"}], ";", "\n", "  ", 
           RowBox[{"stateFactor", "[", 
            RowBox[{
             RowBox[{"productKet", "[", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Cos", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}], ",", 
                   RowBox[{
                    RowBox[{"Exp", "[", 
                    RowBox[{"I", " ", "#2"}], "]"}], " ", 
                    RowBox[{"Sin", "[", 
                    RowBox[{"#1", "/", "2"}], "]"}]}]}], "}"}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"theta", ",", "phi"}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"2", "^", "n"}], ",", "tol"}], "]"}]}], ",", "\n", "  ", 
          RowBox[{"bulkFactor", "[", 
           RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"prob", "=", 
        RowBox[{
         RowBox[{"Norm", "[", 
          RowBox[{
           RowBox[{"ConstantArray", "[", 
            RowBox[{
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", 
               RowBox[{"2", "^", "n"}], "]"}]}], ",", 
             RowBox[{"2", "^", "n"}]}], "]"}], " ", ".", " ", "f"}], "]"}], "^",
          "2"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{"1", "-", "prob"}], "]"}], ">", "tol"}], 
         ",", "\"\<QST: an all-plus bulk is excluded; f1 is reserved for the \
two edges.\>\""}], "]"}], ";", "f"}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",\
ExpressionUUID->"48dd79be-fd97-f340-b0ea-03323ced6919"],

Cell[BoxData[""], "Input",ExpressionUUID->"85c92923-b6eb-2a40-bcda-34d8a1c60005"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstRunChunks", "[", 
    RowBox[{"fn_", ",", "times_List", ",", "eng_", ",", "cfg_"}], "]"}], " ", 
   ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"bytes", ",", "size", ",", "chunks", ",", "results", ",", 
       RowBox[{"kernels", "=", "1"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"times", ",", "realQ"}], "]"}], " ", "&&", " ", 
         RowBox[{"And", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], "]"}]}]}],
         ",", "\"\<QST times must increase.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], ">", "0"}], " ", "&&",
          "\n", "  ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<Invalid QST parallel/batch settings.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", 
         RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Kernels", "[", "]"}], "]"}], "==", "0"}], ",", 
           RowBox[{"Quiet", "[", 
            RowBox[{"LaunchKernels", "[", 
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], "]"}]}], 
          "]"}], ";", "\n", "  ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"Kernels", "[", "]"}], "]"}], ">", "0"}], 
           ",", "\"\<No parallel kernels available. Set Enabled->False for \
serial batches.\>\""}], "]"}], ";", "\n", "  ", 
         RowBox[{"kernels", "=", 
          RowBox[{"Length", "[", 
           RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
         RowBox[{"DistributeDefinitions", "[", 
          RowBox[{"qstStateChunk", ",", "qstMapChunk"}], "]"}]}]}], "]"}], ";",
       "\n", " ", 
      RowBox[{"bytes", "=", 
       RowBox[{"16", " ", 
        RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}], " ", 
        RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}]}]}], ";", "\n", " ", 
      RowBox[{"size", "=", 
       RowBox[{"Min", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<ChunkSize\>\"", "]"}], ",", 
         RowBox[{"Floor", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<MemoryMB\>\"", "]"}], " ", 
           RowBox[{
            RowBox[{"2", "^", "20"}], "/", 
            RowBox[{"(", 
             RowBox[{"4", " ", "kernels", " ", "bytes"}], ")"}]}]}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"size", ">=", "1"}], ",", 
        RowBox[{"\"\<QST batch memory budget is too small. Minimum MemoryMB \
for one factor per worker: \>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Ceiling", "[", 
           RowBox[{"4", " ", "kernels", " ", 
            RowBox[{"bytes", "/", 
             RowBox[{"2", "^", "20"}]}]}], "]"}], "]"}], 
         "<>", "\"\<. This excludes eigensystems and retained \
records.\>\""}]}], "]"}], ";", "\n", " ", 
      RowBox[{"chunks", "=", 
       RowBox[{"Partition", "[", 
        RowBox[{"times", ",", 
         RowBox[{"UpTo", "[", "size", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"results", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}], ",", "\n", 
         "  ", 
         RowBox[{"ParallelMap", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"ts", ",", 
             RowBox[{"CheckAbort", "[", 
              RowBox[{
               RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
            "]"}], ",", "chunks", ",", 
           RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}], ",", 
         "\n", "  ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{"Function", "[", 
            RowBox[{"ts", ",", 
             RowBox[{"CheckAbort", "[", 
              RowBox[{
               RowBox[{"fn", "[", "ts", "]"}], ",", "$Failed"}], "]"}]}], 
            "]"}], ",", "chunks"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ListQ", "[", "results", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "results", "]"}], "==", 
          RowBox[{"Length", "[", "chunks", "]"}]}], " ", "&&", "\n", "  ", 
         RowBox[{"And", "@@", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"ListQ", "[", "#1", "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#1", "]"}], "==", 
                RowBox[{"Length", "[", "#2", "]"}]}], " ", "&&", " ", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"#1", ",", "AssociationQ"}], "]"}]}], ")"}], "&"}], ",", 
            RowBox[{"{", 
             RowBox[{"results", ",", "chunks"}], "}"}]}], "]"}]}]}], ",", 
        "\n", "  ", "\"\<A QST batch failed or aborted; no partial trajectory \
is returned.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Flatten", "[", 
       RowBox[{"results", ",", "1"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstStateChunk", "[", 
    RowBox[{"times_", ",", "eng_", ",", "fac_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"evolveBatch", "[", 
         RowBox[{"times", ",", "eng"}], "]"}]}], ",", "rho0", ",", 
       "purity0"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rho0", "=", 
       RowBox[{"reducedState", "[", 
        RowBox[{"fac", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"purity0", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"Tr", "[", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "fac", "]"}], " ", ".", " ", 
            "fac"}], ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"stateRecord", "[", 
         RowBox[{
          RowBox[{"times", "[", 
           RowBox[{"[", "k", "]"}], "]"}], ",", 
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", "eng", ",",
           "fac", ",", "rho0", ",", "purity0"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstStateRecords", "[", 
    RowBox[{"eng_", ",", "fac_", ",", "times_", ",", "cfg_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"textureRecords", "[", "\n", " ", 
    RowBox[{"qstRunChunks", "[", 
     RowBox[{
      RowBox[{"Function", "[", 
       RowBox[{"ts", ",", 
        RowBox[{"qstStateChunk", "[", 
         RowBox[{"ts", ",", "eng", ",", "fac"}], "]"}]}], "]"}], ",", "times",
       ",", "eng", ",", "cfg"}], "]"}], "]"}]}], ";"}], "\n"}], "Code",Express\
ionUUID->"9d62e1a2-a971-9241-a250-f20b0fd2e331"],

Cell[BoxData[""], "Input",ExpressionUUID->"572db594-e3fb-ee40-ad94-88fbfd267e83"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"texturizingRecord", "[", 
    RowBox[{"t_", ",", "s_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"transferToChoi", "[", "s", "]"}]}], ",", "out", ",", "r", ",",
        "e", ",", "v", ",", "order", ",", "sig", ",", "p", ",", "ce", ",", 
       "mixed"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"applyTransfer", "[", 
        RowBox[{"s", ",", "edgeF1"}], "]"}]}], ";", 
      RowBox[{"r", "=", 
       RowBox[{"responseOperator", "[", "s", "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"e", ",", "v"}], "}"}], "=", 
       RowBox[{"Eigensystem", "[", 
        RowBox[{"herm", "[", "r", "]"}], "]"}]}], ";", 
      RowBox[{"order", "=", 
       RowBox[{"Ordering", "[", 
        RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", 
      RowBox[{"e", "=", 
       RowBox[{"Re", "[", 
        RowBox[{"e", "[", 
         RowBox[{"[", "order", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"v", "=", 
       RowBox[{"v", "[", 
        RowBox[{"[", "order", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"sig", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"grandSum", "[", "out", "]"}], ",", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "16"}], "]"}], " ", ".", " ", "s", " ", ".", 
            " ", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{"1", ",", "16"}], "]"}]}], "]"}], "/", "4"}], ",", 
         RowBox[{
          RowBox[{"grandSum", "[", "c", "]"}], "/", "4"}]}], "}"}]}], ";", 
      "\n", " ", 
      RowBox[{"p", "=", 
       RowBox[{
        RowBox[{"sig", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}], ";", 
      RowBox[{"ce", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"herm", "[", "c", "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"mixed", "=", 
       RowBox[{"applyTransfer", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<Transfer\>\"", "->", "s"}], ",", 
          RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
          RowBox[{"\"\<ChoiState\>\"", "->", 
           RowBox[{"c", "/", "4"}]}], ",", 
          RowBox[{"\"\<OutputF1\>\"", "->", "out"}], ",", "\n", " ", 
          RowBox[{"\"\<SigmaRoutes\>\"", "->", "sig"}], ",", 
          RowBox[{"\"\<SigmaOutput\>\"", "->", 
           RowBox[{"First", "[", "sig", "]"}]}], ",", 
          RowBox[{"\"\<OmegaTF\>\"", "->", 
           RowBox[{"1", "-", "p"}]}], ",", "\n", " ", 
          RowBox[{"\"\<OmegaRoute1\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "/", "4"}]}]}], ",", 
          RowBox[{"\"\<OmegaRoute2\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "/", "4"}]}]}], ",", 
          RowBox[{"\"\<OmegaRoute3\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"sig", "[", 
              RowBox[{"[", "3", "]"}], "]"}], "/", "4"}]}]}], ",", "\n", " ", 
          RowBox[{"\"\<OmegaR\>\"", "->", 
           RowBox[{"rugosity", "[", "out", "]"}]}], ",", 
          RowBox[{"\"\<ResponseOperator\>\"", "->", "r"}], ",", 
          RowBox[{"\"\<ResponseEigenvalues\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<ResponseEigenvectors\>\"", "->", "v"}], ",", "\n", " ", 
          RowBox[{"\"\<ResponseMinimum\>\"", "->", 
           RowBox[{"First", "[", "e", "]"}]}], ",", 
          RowBox[{"\"\<ResponseMaximum\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<MinimumVectorF1Overlap\>\"", "->", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
              RowBox[{"First", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<MaximumVectorF1Overlap\>\"", "->", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Conjugate", "[", "edgeF1Ket", "]"}], " ", ".", " ", 
              RowBox[{"Last", "[", "v", "]"}]}], "]"}], "^", "2"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<ResponseTraceMinus4\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "r", "]"}], "-", "4"}], "]"}]}], ",", 
          RowBox[{"\"\<ResponseHermiticityError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"r", "-", 
             RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], "]"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<ResponseF1Error\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", 
              RowBox[{"r", " ", ".", " ", "edgeF1"}], "]"}], "-", 
             RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<RouteError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"sig", "-", 
             RowBox[{"First", "[", "sig", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<FreeMaxDistance\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"out", "-", "edgeF1"}], "]"}]}], ",", 
          RowBox[{"\"\<FreeTraceDistance\>\"", "->", 
           RowBox[{"traceNormHermitian", "[", 
            RowBox[{"out", "-", "edgeF1"}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<PreservingMaxDistance\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"r", "-", 
             RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", 
          RowBox[{"\"\<PreservingTraceDistance\>\"", "->", 
           RowBox[{"traceNormHermitian", "[", 
            RowBox[{"r", "-", 
             RowBox[{"4", " ", "edgeF1"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<ChoiEigenvalues\>\"", "->", "ce"}], ",", 
          RowBox[{"\"\<MinChoiEigenvalue\>\"", "->", 
           RowBox[{"First", "[", "ce", "]"}]}], ",", 
          RowBox[{"\"\<TPError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
             RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", "\n", 
          " ", 
          RowBox[{"\"\<KrausRank\>\"", "->", 
           RowBox[{"Count", "[", 
            RowBox[{"ce", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", ">", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<KrausTolerance\>\"", "]"}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Last", "[", "ce", "]"}]}], "]"}]}]}]}]}], "]"}]}], 
          ",", "\n", " ", 
          RowBox[{"\"\<MapEntropy\>\"", "->", 
           RowBox[{"entropy", "[", 
            RowBox[{"c", "/", "4"}], "]"}]}], ",", 
          RowBox[{"\"\<UnitalityError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"mixed", "-", 
             RowBox[{
              RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], 
            "]"}]}], ",", 
          RowBox[{"\"\<MixedInputEntropy\>\"", "->", 
           RowBox[{"entropy", "[", "mixed", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<U1CovarianceError\>\"", "->", 
           RowBox[{"u1CovarianceViolation", "[", "s", "]"}]}], ",", 
          RowBox[{"\"\<ReflectionCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"swapEdge", "[", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<FlipCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"flipEdge", "[", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<RFCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"swapEdge", "[", "]"}], " ", ".", " ", 
              RowBox[{"flipEdge", "[", "]"}]}]}], "]"}]}]}], "|>"}], ",", 
        "\n", " ", 
        RowBox[{"<|", "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstMapChunk", "[", 
    RowBox[{"times_", ",", "eng_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"evolveBatch", "[", 
        RowBox[{"times", ",", "eng"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"texturizingRecord", "[", 
        RowBox[{
         RowBox[{"times", "[", 
          RowBox[{"[", "k", "]"}], "]"}], ",", 
         RowBox[{"choiToTransfer", "[", 
          RowBox[{"mapChoiFromFactor", "[", 
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], ",", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}], "]"}], ",", 
         "cfg"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstMapRecords", "[", 
    RowBox[{"eng_", ",", "times_", ",", "settings_", ",", "parallel_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"(", "\n", " ", 
    RowBox[{
     RowBox[{"check", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"realQ", "[", 
         RowBox[{"settings", "[", "\"\<KrausTolerance\>\"", "]"}], "]"}], " ",
         "&&", " ", 
        RowBox[{
         RowBox[{"settings", "[", "\"\<KrausTolerance\>\"", "]"}], ">", 
         "0"}]}], ",", "\"\<KrausTolerance must be positive.\>\""}], "]"}], ";",
      "\n", " ", 
     RowBox[{"qstRunChunks", "[", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"ts", ",", 
         RowBox[{"qstMapChunk", "[", 
          RowBox[{"ts", ",", "eng", ",", "settings"}], "]"}]}], "]"}], ",", 
       "times", ",", "eng", ",", "parallel"}], "]"}]}], ")"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"b4ec9f91-53a7-5b4f-817c-\
6bc2242a5766"],

Cell[BoxData[""], "Input",ExpressionUUID->"3e28fa3e-b7c4-4148-a7c7-2c17ebcfbd9e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstAverageState", "[", 
    RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "scale", ",", "clusters", ",", "r", ",", "widths", ",", "lev", ",", 
       "cross", ",", "f", ",", "x"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
         RowBox[{"relativeTol", ">", "0"}]}], 
        ",", "\"\<Cluster tolerance must be positive.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"maxAbs", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{
            RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], ",", "\"\<E\>\""}], 
           "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"clusters", "=", 
       RowBox[{"energyClusters", "[", 
        RowBox[{"eng", ",", 
         RowBox[{"relativeTol", " ", "scale"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"lev", "[", "item_", "]"}], " ", ":=", " ", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"s", "=", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"item", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", 
           RowBox[{"v", "=", 
            RowBox[{"ConstantArray", "[", 
             RowBox[{
              RowBox[{"0.", "+", 
               RowBox[{"0.", "I"}]}], ",", 
              RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}]}], "]"}]}]}], 
          "}"}], ",", "\n", "  ", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "[", 
            RowBox[{"[", 
             RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"s", "[", "\"\<V\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"item", "[", 
                RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "+", 
            RowBox[{"0.", "I"}]}]}], ";", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"partitionFactor", "[", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{"{", "v", "}"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
            RowBox[{
             RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"item", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], "}"}]}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{
       RowBox[{"cross", "[", 
        RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"Conjugate", "[", 
           RowBox[{"b", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ")"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", 
           RowBox[{"b", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ")"}]}]}], ";", "\n", 
      " ", 
      RowBox[{"r", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"0.", "+", 
          RowBox[{"0.", "I"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"f", "=", 
          RowBox[{"lev", " ", "/@", " ", "cluster"}]}], ";", 
         RowBox[{"r", "+=", 
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"cross", "[", 
              RowBox[{"#", ",", "#"}], "]"}], "&"}], " ", "/@", " ", "f"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"x", "=", 
             RowBox[{"cross", "[", 
              RowBox[{
               RowBox[{"f", "[", 
                RowBox[{"[", "i", "]"}], "]"}], ",", 
               RowBox[{"f", "[", 
                RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
            RowBox[{"r", "+=", 
             RowBox[{"x", "+", 
              RowBox[{"ConjugateTranspose", "[", "x", "]"}]}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", 
             RowBox[{"Length", "[", "f", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", 
             RowBox[{"i", "+", "1"}], ",", 
             RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"cluster", ",", "clusters"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"widths", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Last", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
        "clusters"}]}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
        RowBox[{"\"\<SigmaAB\>\"", "->", 
         RowBox[{"grandSum", "[", "r", "]"}]}], ",", 
        RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",",
         "\n", " ", 
        RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
         RowBox[{"relativeTol", " ", "scale"}]}], ",", 
        RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
        RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", "\n", " ", 
        RowBox[{"\"\<SingletonClusters\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
          "]"}]}], ",", 
        RowBox[{"\"\<DegenerateClusters\>\"", "->", 
         RowBox[{"Count", "[", 
          RowBox[{
           RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
           RowBox[{"_", "?", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", "\n", 
        " ", 
        RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
         RowBox[{"Max", "[", "widths", "]"}]}], ",", 
        RowBox[{"\"\<TraceError\>\"", "->", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Tr", "[", "r", "]"}], "-", "1"}], "]"}]}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstAverageChannel", "[", 
    RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"av", "=", 
        RowBox[{"timeAveragedMap", "[", 
         RowBox[{"eng", ",", "relativeTol"}], "]"}]}], ",", "r"}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"responseOperator", "[", 
        RowBox[{"av", "[", "\"\<Transfer\>\"", "]"}], "]"}]}], ";", 
      RowBox[{"Join", "[", 
       RowBox[{"av", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<OmegaTF\>\"", "->", 
           RowBox[{"1", "-", 
            RowBox[{
             RowBox[{"grandSum", "[", 
              RowBox[{"av", "[", "\"\<Choi\>\"", "]"}], "]"}], "/", 
             "16"}]}]}], ",", "\n", " ", 
          RowBox[{"\"\<ResponseOperator\>\"", "->", "r"}], ",", 
          RowBox[{"\"\<ResponseEigenvalues\>\"", "->", 
           RowBox[{"Sort", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"herm", "[", "r", "]"}], "]"}], "]"}], "]"}]}]}], 
         "|>"}]}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstWindowMean", "[", 
    RowBox[{"records_", ",", "key_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"t", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"records", ",", "\"\<Time\>\""}], "]"}]}], ",", 
       RowBox[{"y", "=", 
        RowBox[{"Lookup", "[", 
         RowBox[{"records", ",", "key"}], "]"}]}], ",", "bad", ",", "inf", ",",
        "value"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"bad", "=", 
       RowBox[{"Count", "[", 
        RowBox[{"y", ",", "_Missing"}], "]"}]}], ";", 
      RowBox[{"inf", "=", 
       RowBox[{"Count", "[", 
        RowBox[{"y", ",", "Infinity"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"value", "=", 
       RowBox[{"Which", "[", 
        RowBox[{
         RowBox[{"bad", ">", "0"}], ",", 
         RowBox[{"Missing", "[", "\"\<InvalidSamples\>\"", "]"}], ",", 
         RowBox[{"inf", ">", "0"}], ",", 
         RowBox[{
         "Missing", "[", "\"\<SingularSamplesRequireQuadrature\>\"", "]"}], ",",
          "\n", "  ", "True", ",", 
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "t", "]"}], " ", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Most", "[", "y", "]"}], "+", 
               RowBox[{"Rest", "[", "y", "]"}]}], ")"}], "/", "2"}]}], "]"}], 
          "/", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Last", "[", "t", "]"}], "-", 
            RowBox[{"First", "[", "t", "]"}]}], ")"}]}]}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Observable\>\"", "->", "key"}], ",", 
        RowBox[{"\"\<Window\>\"", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"First", "[", "t", "]"}], ",", 
           RowBox[{"Last", "[", "t", "]"}]}], "}"}]}], ",", 
        RowBox[{"\"\<Method\>\"", 
         "->", "\"\<Trapezoidal in physical time\>\""}], ",", "\n", " ", 
        RowBox[{"\"\<Value\>\"", "->", "value"}], ",", 
        RowBox[{"\"\<InfiniteSamples\>\"", "->", "inf"}], ",", 
        RowBox[{"\"\<InvalidSamples\>\"", "->", "bad"}], ",", "\n", " ", 
        RowBox[{"\"\<Note\>\"", 
         "->", "\"\<A logarithmic singularity at a sampled zero need not make \
the time integral infinite; no value is inferred there.\>\""}]}], "|>"}]}]}], 
    "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"6079e9c7-f053-de43-\
b8b2-af46dbf0ee67"],

Cell[BoxData[""], "Input",ExpressionUUID->"2572a2f2-4f3c-7a46-b2f3-d835da81843c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstReferenceTrace", "[", 
    RowBox[{"r_", ",", "l_"}], "]"}], " ", ":=", " ", 
   RowBox[{"ArrayReshape", "[", 
    RowBox[{
     RowBox[{"Table", "[", "\n", " ", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"r", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{
             RowBox[{"a", " ", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
             RowBox[{"2", " ", "m"}], "+", "b", "+", "1"}], ",", 
            RowBox[{
             RowBox[{"aa", " ", 
              RowBox[{"2", "^", 
               RowBox[{"(", 
                RowBox[{"l", "-", "1"}], ")"}]}]}], "+", 
             RowBox[{"2", " ", "m"}], "+", "bb", "+", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "0", ",", 
           RowBox[{
            RowBox[{"2", "^", 
             RowBox[{"(", 
              RowBox[{"l", "-", "2"}], ")"}]}], "-", "1"}]}], "}"}]}], "]"}], 
       ",", "\n", " ", 
       RowBox[{"{", 
        RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstReferenceEmbed", "[", 
    RowBox[{"x_", ",", "rm_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"x", "[", 
       RowBox[{"[", 
        RowBox[{
         RowBox[{
          RowBox[{"2", " ", "a"}], "+", "b", "+", "1"}], ",", 
         RowBox[{
          RowBox[{"2", " ", "aa"}], "+", "bb", "+", "1"}]}], "]"}], "]"}], "\n",
       " ", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"2", ",", 
            RowBox[{"a", "+", "1"}]}], "]"}], ",", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"2", ",", 
            RowBox[{"aa", "+", "1"}]}], "]"}]}], "]"}], ",", "rm", ",", "\n", 
        " ", 
        RowBox[{"Outer", "[", 
         RowBox[{"Times", ",", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"2", ",", 
            RowBox[{"b", "+", "1"}]}], "]"}], ",", 
          RowBox[{"UnitVector", "[", 
           RowBox[{"2", ",", 
            RowBox[{"bb", "+", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"b", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"aa", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"bb", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstSmallReference", "[", 
    RowBox[{"p_", ",", "bf_", ",", "records_", ",", "mode_", ",", 
     RowBox[{"maxL_", ":", "6"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "rm", ",", 
       RowBox[{"errs", "=", 
        RowBox[{"{", "}"}]}], ",", "u", ",", "ref"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"l", ">", "maxL"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Missing", "[", 
          RowBox[{"\"\<SkippedAboveL\>\"", ",", "maxL"}], "]"}], "]"}]}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Normal", "[", 
         RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"rm", "=", 
       RowBox[{"bf", " ", ".", " ", 
        RowBox[{"ConjugateTranspose", "[", "bf", "]"}]}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"u", "=", 
          RowBox[{"MatrixExp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], " ", "h"}], "]"}]}], ";",
          "\n", "  ", 
         RowBox[{"ref", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"mode", "==", "\"\<State\>\""}], ",", 
            RowBox[{"qstReferenceTrace", "[", 
             RowBox[{
              RowBox[{"u", " ", ".", " ", 
               RowBox[{"qstReferenceEmbed", "[", 
                RowBox[{"edgeF1", ",", "rm"}], "]"}], " ", ".", " ", 
               RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "l"}], 
             "]"}], ",", "\n", "   ", 
            RowBox[{"ArrayFlatten", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"qstReferenceTrace", "[", 
                RowBox[{
                 RowBox[{"u", " ", ".", " ", 
                  RowBox[{"qstReferenceEmbed", "[", 
                   RowBox[{
                    RowBox[{"Outer", "[", 
                    RowBox[{"Times", ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "i"}], "]"}], ",", 
                    RowBox[{"UnitVector", "[", 
                    RowBox[{"4", ",", "j"}], "]"}]}], "]"}], ",", "rm"}], 
                   "]"}], " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "u", "]"}]}], ",", "l"}],
                 "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "4"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"j", ",", "4"}], "}"}]}], "]"}], "]"}]}], "]"}]}], ";",
          "\n", "  ", 
         RowBox[{"AppendTo", "[", 
          RowBox[{"errs", ",", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"ref", "-", 
             RowBox[{"rec", "[", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"mode", "==", "\"\<State\>\""}], ",", "\"\<RhoAB\>\"",
                 ",", "\"\<Choi\>\""}], "]"}], "]"}]}], "]"}]}], "]"}]}], ",",
         "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"rec", ",", 
          RowBox[{"records", "[", 
           RowBox[{"[", 
            RowBox[{"DeleteDuplicates", "[", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{
                 RowBox[{"Length", "[", "records", "]"}], "/", "2"}], "]"}], ",", 
               RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], "]"}],
            "]"}]}], "}"}]}], "]"}], ";", 
      RowBox[{"Max", "[", "errs", "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"5610e754-f37c-2d43-a058-\
49e7d32a5cf9"],

Cell[BoxData[""], "Input",ExpressionUUID->"1ceac3fe-5b49-144b-9fd4-582189fbcab6"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"qstStateChecks", "[", 
    RowBox[{"eng_", ",", "fac_", ",", "bf_", ",", "records_", ",", "tol_"}], 
    "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "zero", ",", "r0", ",", "checks", ",", "endpoint", ",", "full"}], "}"}],
      ",", "\n", " ", 
     RowBox[{
      RowBox[{"zero", "=", 
       RowBox[{"First", "[", 
        RowBox[{"textureRecords", "[", 
         RowBox[{"stateTrajectory", "[", 
          RowBox[{"eng", ",", "fac", ",", 
           RowBox[{"{", "0.", "}"}], ",", "tol"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"r0", "=", 
       RowBox[{"zero", "[", "\"\<RhoAB\>\"", "]"}]}], ";", "\n", " ", 
      RowBox[{"endpoint", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"rec", "[", "\"\<RhoAB\>\"", "]"}], "-", 
            RowBox[{"reducedState", "[", 
             RowBox[{
              RowBox[{"evolve", "[", 
               RowBox[{
                RowBox[{"rec", "[", "\"\<Time\>\"", "]"}], ",", "eng"}], 
               "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"rec", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "records", "]"}], ",", 
              RowBox[{"Last", "[", "records", "]"}]}], "}"}]}], "}"}]}], 
         "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"full", "=", 
       RowBox[{"qstSmallReference", "[", 
        RowBox[{
         RowBox[{"eng", "[", "\"\<Parameters\>\"", "]"}], ",", "bf", ",", 
         "records", ",", "\"\<State\>\""}], "]"}]}], ";", "\n", " ", 
      RowBox[{"checks", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<InitialF1Error\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"r0", "-", "edgeF1"}], "]"}]}], ",", 
         RowBox[{"\"\<InitialTextureError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"zero", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
             RowBox[{"zero", "[", "\"\<TextureFAB\>\"", "]"}], ",", 
             RowBox[{"zero", "[", "\"\<RugosityAB\>\"", "]"}]}], "}"}], 
           "]"}]}], ",", "\n", " ", 
         RowBox[{"\"\<PauliIdentityError\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"maxAbs", "[", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{
                  RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "1", "-", 
                  RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}], "-", 
                  RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}], "-", 
                  RowBox[{"#", "[", "\"\<CorrelationXX\>\"", "]"}]}], ",", 
                 "\n", "  ", 
                 RowBox[{
                  RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "1", "-", 
                  RowBox[{"#", "[", "\"\<LocalAX\>\"", "]"}]}], ",", 
                 RowBox[{
                  RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "1", "-", 
                  RowBox[{"#", "[", "\"\<LocalBX\>\"", "]"}]}], ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "/", "4"}], "-", 
                  RowBox[{"#", "[", "\"\<F1Probability\>\"", "]"}]}]}], "}"}],
                "]"}], "&"}], ",", "records"}], "]"}], "]"}]}], ",", "\n", 
         " ", 
         RowBox[{"\"\<BoundsViolation\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"0.", ",", 
            RowBox[{"Max", "[", 
             RowBox[{"Flatten", "[", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}]}], ",", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaAB\>\"", "]"}], "-", "4"}], ",", 
                   RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}]}], ",", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaA\>\"", "]"}], "-", "2"}], ",", 
                   RowBox[{"-", 
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}]}], ",", 
                   RowBox[{
                    RowBox[{"#", "[", "\"\<SigmaB\>\"", "]"}], "-", "2"}]}], 
                  "}"}], "&"}], ",", "records"}], "]"}], "]"}], "]"}]}], 
           "]"}]}], ",", "\n", " ", 
         RowBox[{"\"\<TraceError\>\"", "->", 
          RowBox[{"Max", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}], ",", 
