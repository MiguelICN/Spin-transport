    RowBox[{"s_", ",", " ", "r1_", ",", " ", "r2_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"chTraceNorm", "[", 
     RowBox[{"ArrayReshape", "[", 
      RowBox[{
       RowBox[{"s", " ", ".", " ", 
        RowBox[{"Flatten", "[", 
         RowBox[{"r1", " ", "-", " ", "r2"}], "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "4"}], "}"}]}], "]"}], "]"}], "/", "2"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"603db69a-6c47-8e40-bbfa-\
bc16f729d5f5"],

Cell[BoxData[""], "Input",ExpressionUUID->"7ee92308-ab2b-9c48-8f62-398b7747a073"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chParameters", "[", 
    RowBox[{"p_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"q", "=", 
       RowBox[{"regimeModel", "[", "p", "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<L\>\"", "->", 
        RowBox[{
         RowBox[{"q", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
       RowBox[{"\"\<Original\>\"", "->", "q"}], ",", 
       RowBox[{"\"\<gA\>\"", "->", 
        RowBox[{
         RowBox[{"q", "[", "\"\<g\>\"", "]"}], "/", "2"}]}], ",", 
       RowBox[{"\"\<gB\>\"", "->", 
        RowBox[{
         RowBox[{"q", "[", "\"\<g\>\"", "]"}], "/", "2"}]}], ",", "\n", " ", 
       RowBox[{"\"\<w\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<ed\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<DefectSite\>\"", "->", "1"}], ",", 
       RowBox[{"\"\<omegaA\>\"", "->", "0"}], ",", 
       RowBox[{"\"\<omegaB\>\"", "->", "0"}]}], "|>"}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chChainHamiltonian", "[", 
    RowBox[{"delta_", ",", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{"bulkHamiltonian", "[", 
         RowBox[{"p", "[", "\"\<Original\>\"", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"realSectorCheck", "[", 
       RowBox[{"h", ",", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", "chEDTolerance"}], "]"}], ";",
       "h"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chFullHamiltonian", "[", 
    RowBox[{"delta_", ",", "kind_", ",", "p_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", "=", 
       RowBox[{"N", "[", 
        RowBox[{"regimeHamiltonian", "[", 
         RowBox[{"p", "[", "\"\<Original\>\"", "]"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"realSectorCheck", "[", 
       RowBox[{"h", ",", 
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "+", "2"}], ",", 
        "chEDTolerance"}], "]"}], ";", "h"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chSiteOp", "[", 
    RowBox[{"delta_", ",", "a_", ",", "j_", ",", "n_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"siteOp", "[", 
    RowBox[{"a", ",", "j", ",", "n"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chPauli", "[", 
    RowBox[{"delta_", ",", "k_"}], "]"}], " ", ":=", " ", 
   RowBox[{"PauliMatrix", "[", "k", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chBulkFactor", "[", 
    RowBox[{"p_", ",", "spec_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cp", "=", 
        RowBox[{"chParameters", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", "|>"}]}], "]"}]}], ",", "beta"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"Switch", "[", 
      RowBox[{
       RowBox[{"spec", "[", "\"\<Type\>\"", "]"}], ",", "\n", 
       " ", "\"\<Gibbs\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{"realQ", "[", "beta", "]"}], 
          ",", "\"\<Finite real Gibbs Beta required.\>\""}], "]"}], ";", 
        RowBox[{"chMapGibbsFactor", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "beta"}], 
         "]"}]}], ",", "\n", " ", "\"\<SectorTypical\>\"", ",", 
       RowBox[{
        RowBox[{"beta", "=", 
         RowBox[{"spec", "[", "\"\<Beta\>\"", "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"realQ", "[", "beta", "]"}], " ", "&&", " ", 
           RowBox[{"IntegerQ", "[", 
            RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], "]"}], 
           " ", "&&", " ", 
           RowBox[{
            RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], ">", 
            "0"}]}], ",", "\n", 
          "  ", "\"\<SectorTypical needs real Beta and a positive \
SamplesPerSector.\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"chMapTypicalFactor", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "beta", ",", 
          RowBox[{"spec", "[", "\"\<SamplesPerSector\>\"", "]"}], ",", 
          RowBox[{"spec", "[", "\"\<Seed\>\"", "]"}]}], "]"}]}], ",", "\n", 
       " ", "_", ",", 
       RowBox[{"bulkFactor", "[", 
        RowBox[{"p", ",", "spec", ",", "tol"}], "]"}]}], "]"}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chClusters", "[", 
    RowBox[{"levels_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"ordered", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{"levels", ",", "First"}], "]"}]}], ",", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}], ",", "group"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "ordered", "]"}], ">", "0"}], " ", "&&", " ", 
         RowBox[{"realQ", "[", "tol", "]"}], " ", "&&", " ", 
         RowBox[{"tol", ">", "0"}]}], 
        ",", "\"\<Invalid spectral cluster input.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"group", "=", 
       RowBox[{"{", 
        RowBox[{"First", "[", "ordered", "]"}], "}"}]}], ";", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"x", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"First", "[", "group", "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "<=", "tol"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"group", ",", "x"}], "]"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"out", ",", "group"}], "]"}], ";", 
           RowBox[{"group", "=", 
            RowBox[{"{", "x", "}"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Rest", "[", "ordered", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Append", "[", 
       RowBox[{"out", ",", "group"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"bf959210-3371-7249-902a-\
725f9e45653a"],

Cell[BoxData[""], "Input",ExpressionUUID->"9f65c9af-6d16-ce43-8a84-49dea51161c8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chBuild", "[", 
    RowBox[{"p_", ",", "bf_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cp", "=", 
        RowBox[{"chParameters", "[", 
         RowBox[{"p", ",", "cfg"}], "]"}]}], ",", "e", ",", "weights", ",", 
       "bl", ",", "ids", ",", "r", ",", "zero"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixQ", "[", 
          RowBox[{"bf", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "bf", "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}]}], " ",
          "&&", " ", 
         RowBox[{
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{"bf", ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "-",
             "1"}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}], 
        ",", "\"\<Invalid bulk factor.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"r", "=", 
       RowBox[{
        RowBox[{"Dimensions", "[", "bf", "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"MemberQ", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "None"}], "}"}], ",", 
          RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}], "]"}], 
        ",", "\"\<Symmetries must be Automatic or None.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"cfg", "[", "\"\<ProjectionCutoff\>\"", "]"}], "==", "0"}], 
        ",", "\"\<Chapter 3 prunes exactly zero columns only: set \
ProjectionCutoff->0.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxColumns\>\"", "]"}], ">", "0"}], " ", "&&",
          "\n", "  ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}], ">", "0"}], " ", "&&",
          " ", 
         RowBox[{"IntegerQ", "[", 
          RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], "]"}], " ", 
         "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MaxOverlapEntries\>\"", "]"}], ">", 
          "0"}]}], ",", "\"\<Invalid channel batch limits.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], "]"}], " ", "&&", 
         " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<Positive EDTolerance required.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"e", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"chEDTolerance", "=", 
           RowBox[{"cfg", "[", "\"\<EDTolerance\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"chExEngine", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], ",", "cp", ",", "bf", ",", 
           RowBox[{"\"\<Symmetries\>\"", "->", 
            RowBox[{"cfg", "[", "\"\<Symmetries\>\"", "]"}]}]}], "]"}]}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"weights", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Labels\>\"", "->", 
            RowBox[{"<|", 
             RowBox[{"\"\<m\>\"", "->", 
              RowBox[{
               RowBox[{
                RowBox[{"p", "[", "\"\<L\>\"", "]"}], "/", "2"}], "-", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"bl", "[", "\"\<Sector\>\"", "]"}], "-", "1"}], 
                ")"}]}]}], "|>"}]}], ",", 
           RowBox[{"\"\<Dimension\>\"", "->", 
            RowBox[{"Length", "[", 
             RowBox[{"bl", "[", "\"\<E\>\"", "]"}], "]"}]}], ",", "\n", " ", 
           RowBox[{"\"\<ActiveColumns\>\"", "->", 
            RowBox[{"Length", "[", 
             RowBox[{"bl", "[", "\"\<Columns\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"\"\<Weight\>\"", "->", 
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"bl", "[", "\"\<C\>\"", "]"}], 
                ",", "\"\<Frobenius\>\""}], "]"}], "^", "2"}], "/", "4"}]}]}],
           "|>"}], ",", 
         RowBox[{"{", 
          RowBox[{"bl", ",", 
           RowBox[{"e", "[", "\"\<Blocks\>\"", "]"}]}], "}"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"weights", ",", "\"\<Weight\>\""}], "]"}], "]"}], "-", 
           "1"}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Channel sector weights do not sum to one.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"e", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Parameters\>\"", "->", "p"}], ",", 
          RowBox[{"\"\<TotalL\>\"", "->", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
          RowBox[{"\"\<BulkFactor\>\"", "->", "bf"}], ",", 
          RowBox[{"\"\<SectorWeights\>\"", "->", "weights"}], ",", "\n", " ", 
          RowBox[{"\"\<DiscardedWeight\>\"", "->", "0."}], ",", 
          RowBox[{"\"\<Settings\>\"", "->", "cfg"}], ",", 
          RowBox[{"\"\<FactorRank\>\"", "->", "r"}]}], "|>"}]}], "]"}]}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chConjugateEngine", "[", "eng_", "]"}], " ", ":=", " ", 
   RowBox[{"Join", "[", 
    RowBox[{"eng", ",", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<BulkFactor\>\"", "->", 
        RowBox[{"Conjugate", "[", 
         RowBox[{"eng", "[", "\"\<BulkFactor\>\"", "]"}], "]"}]}], ",", "\n", 
       " ", 
       RowBox[{"\"\<Blocks\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{"#", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<C\>\"", "->", 
               RowBox[{"Conjugate", "[", 
                RowBox[{"#", "[", "\"\<C\>\"", "]"}], "]"}]}], "|>"}]}], 
            "]"}], "&"}], " ", "/@", " ", 
          RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}]}], ")"}]}]}], "|>"}]}], 
    "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"2dd49dca-c3f9-f444-837c-\
9ce5b6669f05"],

Cell[BoxData[""], "Input",ExpressionUUID->"3533e9df-85eb-0f4d-82c1-568d2dea16b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chPrepare", "[", 
    RowBox[{"eng_", ",", "times_List", ",", "cfg_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "method", ",", "cost", ",", "entries", ",", "overlaps", ",", 
       "rankmax"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"entries", "=", 
       RowBox[{"16", " ", 
        RowBox[{"2", "^", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], " ", 
        RowBox[{"eng", "[", "\"\<RankC\>\"", "]"}]}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"entries", "<=", 
         RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}]}], 
        ",", "\"\<One exchange Choi factor exceeds MaxEntries; raise the \
limit or reduce the bulk factor rank.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Method\>\"", "->", "\"\<PrunedRealBatches\>\""}], ",", 
        RowBox[{"\"\<EntriesPerChoiFactor\>\"", "->", "entries"}], ",", "\n", 
        " ", 
        RowBox[{"\"\<ActiveColumnCounts\>\"", "->", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"#", "[", "\"\<Columns\>\"", "]"}], "]"}], "&"}], " ", "/@",
            " ", 
           RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}]}], ")"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chSeries", "[", 
    RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", 
     RowBox[{"prepared_", ":", "Automatic"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "pr", ",", "raw", ",", "chi", ",", "cd", ",", "fs", ",", "fds", ",", 
       "width"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">", "0"}], " ", "&&", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{"times", ",", "realQ"}], "]"}]}], 
        ",", "\"\<Channel times must be finite and real.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"pr", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"prepared", "===", "Automatic"}], ",", 
         RowBox[{"chPrepare", "[", 
          RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}], ",", "prepared"}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "times", "]"}], ">", 
         RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Join", "@@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"chSeries", "[", 
              RowBox[{"eng", ",", "#", ",", "cfg", ",", "pr"}], "]"}], "&"}], 
            " ", "/@", " ", 
            RowBox[{"Partition", "[", 
             RowBox[{"times", ",", 
              RowBox[{"UpTo", "[", 
               RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
             "]"}]}], ")"}]}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"raw", "=", 
       RowBox[{"chExChoiSeries", "[", 
        RowBox[{"eng", ",", "times", ",", 
         RowBox[{"\"\<MaxEntries\>\"", "->", 
          RowBox[{"cfg", "[", "\"\<MaxEntries\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Derivative\>\"", "->", "True"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"chi", ",", "cd"}], "}"}], "=", "raw"}], ";", "\n", " ", 
      RowBox[{"MapThread", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Choi\>\"", "->", 
            RowBox[{"4", " ", "#1"}]}], ",", 
           RowBox[{"\"\<ChoiState\>\"", "->", "#1"}], ",", 
           RowBox[{"\"\<Transfer\>\"", "->", 
            RowBox[{"chChoiToSuper", "[", "#1", "]"}]}], ",", 
           RowBox[{"\"\<TransferDerivative\>\"", "->", 
            RowBox[{"chChoiToSuper", "[", "#2", "]"}]}]}], "|>"}], "&"}], ",", 
        RowBox[{"{", 
         RowBox[{"chi", ",", "cd"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"7d508396-753a-1547-a4d2-\
665e9a3e224c"],

Cell[BoxData[""], "Input",ExpressionUUID->"8d996de1-f4f4-6347-8d5a-83c95b32b5e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chRecord", "[", 
    RowBox[{"t_", ",", "v_", ",", "cfg_", ",", "probes_"}], "]"}], " ", ":=", 
   " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"v", "[", "\"\<Choi\>\"", "]"}]}], ",", 
       RowBox[{"s", "=", 
        RowBox[{"v", "[", "\"\<Transfer\>\"", "]"}]}], ",", 
       RowBox[{"sd", "=", 
        RowBox[{"v", "[", "\"\<TransferDerivative\>\"", "]"}]}], ",", "e", ",",
        "pt", ",", "sv", ",", "gen", ",", "rates", ",", "mixed", ",", 
       "lambda", ",", "f", ",", "fd", ",", "z", ",", "entropyC"}], "}"}], ",",
      "\n", " ", 
     RowBox[{
      RowBox[{"e", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"herm", "[", "c", "]"}], "]"}], "]"}], "]"}]}], ";", 
      RowBox[{"pt", "=", 
       RowBox[{"Sort", "[", 
        RowBox[{"Re", "[", 
         RowBox[{"Eigenvalues", "[", 
          RowBox[{"herm", "[", 
           RowBox[{"choiPartialTransposeOut", "[", 
            RowBox[{"c", "/", "4"}], "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"sv", "=", 
       RowBox[{"transferMinSV", "[", "s", "]"}]}], ";", 
      RowBox[{"entropyC", "=", 
       RowBox[{"entropy", "[", 
        RowBox[{"c", "/", "4"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sv", ">=", 
         RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",", 
        RowBox[{
         RowBox[{"gen", "=", 
          RowBox[{"rightSolve", "[", 
           RowBox[{"sd", ",", "s"}], "]"}]}], ";", 
         RowBox[{"rates", "=", 
          RowBox[{"chCanonicalRates", "[", "gen", "]"}]}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"gen", "=", 
          RowBox[{"Missing", "[", 
           RowBox[{"\"\<NearSingularMap\>\"", ",", "sv"}], "]"}]}], ";", 
         RowBox[{"rates", "=", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"Missing", "[", 
             RowBox[{"\"\<NearSingularMap\>\"", ",", "sv"}], "]"}], ",", 
            "15"}], "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"mixed", "=", 
       RowBox[{"applyTransfer", "[", 
        RowBox[{"s", ",", 
         RowBox[{
          RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], "]"}]}], ";", 
      RowBox[{"lambda", "=", 
       RowBox[{"s", "[", 
        RowBox[{"[", 
         RowBox[{"4", ",", "4"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Join", "[", 
       RowBox[{"v", ",", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<ChoiEigenvalues\>\"", "->", "e"}], ",", 
          RowBox[{"\"\<MinChoiEigenvalue\>\"", "->", 
           RowBox[{"First", "[", "e", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<TPError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
             RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<ChoiTraceError\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "c", "]"}], "-", "4"}], "]"}]}], ",", "\n", 
          " ", 
          RowBox[{"\"\<KrausRank\>\"", "->", 
           RowBox[{"Count", "[", 
            RowBox[{"e", ",", 
             RowBox[{"x_", "/;", 
              RowBox[{"x", ">", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Max", "[", "e", "]"}]}], "]"}]}]}]}]}], "]"}]}], ",", 
          RowBox[{"\"\<MapEntropy\>\"", "->", "entropyC"}], ",", "\n", " ", 
          RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
           RowBox[{"First", "[", "pt", "]"}]}], ",", 
          RowBox[{"\"\<ChoiNegativity\>\"", "->", 
           RowBox[{"Total", "[", 
            RowBox[{"Clip", "[", 
             RowBox[{
              RowBox[{"-", "pt"}], ",", 
              RowBox[{"{", 
               RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ",", 
          "\n", " ", 
          RowBox[{"\"\<MinSingularValue\>\"", "->", "sv"}], ",", 
          RowBox[{"\"\<Generator\>\"", "->", "gen"}], ",", 
          RowBox[{"\"\<CanonicalRates\>\"", "->", "rates"}], ",", "\n", " ", 
          RowBox[{"\"\<MinimumRate\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MissingQ", "[", "gen", "]"}], ",", 
             RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
             RowBox[{"First", "[", "rates", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<RHPInstantaneous\>\"", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MissingQ", "[", "gen", "]"}], ",", 
             RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"Total", "[", 
               RowBox[{"Clip", "[", 
                RowBox[{
                 RowBox[{"-", "rates"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], "/", 
              "2"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<UnitalityError\>\"", "->", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"mixed", "-", 
             RowBox[{
              RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], 
            "]"}]}], ",", 
          RowBox[{"\"\<MixedInputEntropy\>\"", "->", 
           RowBox[{"entropy", "[", "mixed", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<U1CovarianceError\>\"", "->", 
           RowBox[{"u1CovarianceViolation", "[", "s", "]"}]}], ",", 
          RowBox[{"\"\<ReflectionCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"swapEdge", "[", "]"}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<FlipCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{"flipEdge", "[", "]"}]}], "]"}]}], ",", 
          RowBox[{"\"\<RFCovarianceError\>\"", "->", 
           RowBox[{"covarianceViolation", "[", 
            RowBox[{"s", ",", 
             RowBox[{
              RowBox[{"swapEdge", "[", "]"}], " ", ".", " ", 
              RowBox[{"flipEdge", "[", "]"}]}]}], "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<TimeReversalError\>\"", "->", 
           RowBox[{"Missing", "[", "\"\<NotSampled\>\"", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumReal\>\"", "->", 
           RowBox[{"Re", "[", "lambda", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumImag\>\"", "->", 
           RowBox[{"Im", "[", "lambda", "]"}]}], ",", 
          RowBox[{"\"\<DoubleQuantumAbs\>\"", "->", 
           RowBox[{"Abs", "[", "lambda", "]"}]}], ",", "\n", " ", 
          RowBox[{"\"\<BLPDistance\>\"", "->", 
           RowBox[{
            RowBox[{"traceNormHermitian", "[", 
             RowBox[{"applyTransfer", "[", 
              RowBox[{"s", ",", 
               RowBox[{
                RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], "-", 
                RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}]}]}], "]"}], 
             "]"}], "/", "2"}]}], ",", "\n", " ", 
          RowBox[{"\"\<SignalAtoB\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"signalMatrix", "[", 
              RowBox[{"s", ",", 
               RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}]}], "]"}], ",", 
             "2"}], "]"}]}], ",", 
          RowBox[{"\"\<RetentionA\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"retentionMatrix", "[", 
              RowBox[{"s", ",", 
               RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}]}], "]"}], ",", 
             "2"}], "]"}]}]}], "|>"}], ",", "\n", " ", 
        RowBox[{"<|", "|>"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chTrajectory", "[", 
    RowBox[{"eng_", ",", "times_List", ",", "cfg_", ",", "probes_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "prepared", ",", "recs", ",", "raw", ",", "zero", ",", "dist", ",", 
       "blp", ",", "dt", ",", "rhp", ",", "margin"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], ">=", "2"}], " ", "&&", " ", 
         RowBox[{"And", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "times", "]"}], ">", "0"}], "]"}]}]}],
         ",", "\"\<Channel times must increase.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], "]"}], 
         " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}], ">", 
          "0"}], " ", "&&", " ", 
         RowBox[{"realQ", "[", 
          RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], "]"}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<RankTolerance\>\"", "]"}], ">", "0"}]}], ",",
         "\n", " ", "\"\<Invalid channel diagnostic tolerances.\>\""}], "]"}],
       ";", "\n", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{
        RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], ",", "4", ",", 
        RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";", 
      RowBox[{"stateFactor", "[", 
       RowBox[{
        RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}], ",", "4", ",", 
        RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";", 
      RowBox[{"stateFactor", "[", 
       RowBox[{
        RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}], ",", "2", ",", 
        RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], "]"}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"And", "@@", 
         RowBox[{"(", 
          RowBox[{"MatrixQ", " ", "/@", " ", 
           RowBox[{"Lookup", "[", 
            RowBox[{"probes", ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<Rho1\>\"", ",", "\"\<Rho2\>\"", 
               ",", "\"\<RhoB\>\""}], "}"}]}], "]"}]}], ")"}]}], 
        ",", "\"\<Channel probes must be density matrices.\>\""}], "]"}], ";",
       "\n", " ", 
      RowBox[{"prepared", "=", 
       RowBox[{"chPrepare", "[", 
        RowBox[{"eng", ",", "times", ",", "cfg"}], "]"}]}], ";", 
      RowBox[{"zero", "=", 
       RowBox[{"First", "[", 
        RowBox[{"chSeries", "[", 
         RowBox[{"eng", ",", 
          RowBox[{"{", "0.", "}"}], ",", "cfg", ",", "prepared"}], "]"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
           RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<Channel t=0 reconstruction failed.\>\""}], "]"}], ";", "\n",
       " ", 
      RowBox[{"recs", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"raw", "=", 
             RowBox[{"chSeries", "[", 
              RowBox[{"eng", ",", "tc", ",", "cfg", ",", "prepared"}], 
              "]"}]}], ";", "\n", "  ", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"chRecord", "[", 
                RowBox[{"#1", ",", "#2", ",", "cfg", ",", "probes"}], "]"}], 
               "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"tc", ",", "raw"}], "}"}]}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"tc", ",", 
             RowBox[{"Partition", "[", 
              RowBox[{"times", ",", 
               RowBox[{"UpTo", "[", 
                RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], "]"}]}], 
              "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<TPError\>\""}], "]"}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ", "&&",
          " ", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<MinChoiEigenvalue\>\""}], "]"}], "]"}], 
          ">=", 
          RowBox[{"-", 
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}], 
        ",", "\"\<Channel CP/TP validation failed.\>\""}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"dist", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"recs", ",", "\"\<BLPDistance\>\""}], "]"}]}], ";", 
      RowBox[{"blp", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", 
          RowBox[{"Clip", "[", 
           RowBox[{
            RowBox[{"Differences", "[", "dist", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}], ",", 
         "0."}], "]"}]}], ";", "\n", " ", 
      RowBox[{"recs", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dt", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{
              RowBox[{"times", "[", 
               RowBox[{"[", "k", "]"}], "]"}], "-", 
              RowBox[{"times", "[", 
               RowBox[{"[", 
                RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", 
          RowBox[{"margin", "=", 
           RowBox[{"Missing", "[", "\"\<NotZZ\>\"", "]"}]}], ";", "\n", "  ", 
          RowBox[{"rhp", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"k", "==", "1"}], ",", 
             RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"recs", "[", 
                  RowBox[{"[", 
                   RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                 "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
                RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",", 
               RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
               RowBox[{"Max", "[", 
                RowBox[{"0.", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"traceNormHermitian", "[", 
                    RowBox[{"transferToChoi", "[", 
                    RowBox[{"rightSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Transfer\>\"", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<Transfer\>\"", "]"}]}], "]"}], "]"}], "]"}], "/",
                    "4"}], "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n",
           "  ", 
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"recs", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<BLPAccumulated\>\"", "->", 
               RowBox[{"blp", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<RHPFiniteStep\>\"", "->", "rhp"}], ",", "\n", "  ", 
              RowBox[{"\"\<RHPFiniteStepRate\>\"", "->", 
               RowBox[{"If", "[", 
                RowBox[{
                 RowBox[{"MissingQ", "[", "rhp", "]"}], ",", "rhp", ",", 
                 RowBox[{"rhp", "/", "dt"}]}], "]"}]}], ",", 
              
              RowBox[{"\"\<IntermediateSupportMinimum\>\"", "->", 
               "margin"}]}], "|>"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", 
           RowBox[{"Length", "[", "recs", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Records\>\"", "->", "recs"}], ",", 
        RowBox[{"\"\<Method\>\"", "->", 
         RowBox[{"KeyDrop", "[", 
          RowBox[{"prepared", ",", 
           RowBox[{"{", "\"\<Overlaps\>\"", "}"}]}], "]"}]}], ",", 
        RowBox[{"\"\<InitialTransferError\>\"", "->", 
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"zero", "[", "\"\<Transfer\>\"", "]"}], "-", 
           RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->\
"3656c378-c018-0f45-90af-f8d40fef5709"],

Cell[BoxData[""], "Input",ExpressionUUID->"cf24ac43-0243-2946-bab9-efd004fb6d3a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chTimeReversal", "[", 
     RowBox[{"eng_", ",", "times_", ",", "cfg_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ix", ",", "ts", ",", "neg", ",", "pos", ",", "conj", ",", "errs"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ix", "=", 
        RowBox[{"Switch", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<TimeReversalCheck\>\"", "]"}], 
          ",", "\"\<None\>\"", ",", 
          RowBox[{"{", "}"}], ",", "\"\<Endpoints\>\"", ",", 
          RowBox[{"DeleteDuplicates", "[", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"Ceiling", "[", 
              RowBox[{
               RowBox[{"Length", "[", "times", "]"}], "/", "2"}], "]"}], ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}], "]"}], 
          ",", "\"\<All\>\"", ",", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "times", "]"}], "]"}], ",", "_", ",", 
          RowBox[{"check", "[", 
           RowBox[{
           "False", 
            ",", "\"\<TimeReversalCheck must be None, Endpoints or All \
(strings).\>\""}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"ix", "===", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Indices\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Times\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Errors\>\"", "->", 
             RowBox[{"{", "}"}]}], ",", 
            RowBox[{"\"\<Maximum\>\"", "->", 
             RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}]}], 
           "|>"}], "]"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"ts", "=", 
        RowBox[{"times", "[", 
         RowBox[{"[", "ix", "]"}], "]"}]}], ";", 
       RowBox[{"conj", "=", 
        RowBox[{"chConjugateEngine", "[", "eng", "]"}]}], ";", "\n", " ", 
       RowBox[{"neg", "=", 
        RowBox[{"chSeries", "[", 
         RowBox[{"eng", ",", 
          RowBox[{"-", "ts"}], ",", "cfg"}], "]"}]}], ";", 
       RowBox[{"pos", "=", 
        RowBox[{"chSeries", "[", 
         RowBox[{"conj", ",", "ts", ",", "cfg"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"errs", "=", 
        RowBox[{"MapThread", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"maxAbs", "[", 
            RowBox[{
             RowBox[{"#1", "[", "\"\<Transfer\>\"", "]"}], "-", 
             RowBox[{"Conjugate", "[", 
              RowBox[{"#2", "[", "\"\<Transfer\>\"", "]"}], "]"}]}], "]"}], 
           "&"}], ",", 
          RowBox[{"{", 
           RowBox[{"neg", ",", "pos"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", "errs", "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
         ",", "\"\<Conjugate-bulk time-reversal check failed.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Indices\>\"", "->", "ix"}], ",", 
         RowBox[{"\"\<Times\>\"", "->", "ts"}], ",", 
         RowBox[{"\"\<Errors\>\"", "->", "errs"}], ",", 
         RowBox[{"\"\<Maximum\>\"", "->", 
          RowBox[{"Max", "[", "errs", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
   ";"}], "\n"}]], "Code",ExpressionUUID->"47d9fe0c-843e-4b4e-a0d3-\
ba7bb4b4276c"],

Cell[BoxData[""], "Input",ExpressionUUID->"438d4b83-71dc-0244-b748-66cc81618573"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chAverage", "[", 
     RowBox[{"eng_", ",", "relativeTol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "chi", ",", "f", ",", "scale", ",", "absolute", ",", "all", ",", 
        "clusters", ",", "widths", ",", "g", ",", "ids", ",", "masks", ",", 
        "e1", ",", "e2", ",", "labels", ",", 
        RowBox[{"matched", "=", "0"}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
          RowBox[{"relativeTol", ">", "0"}]}], 
         ",", "\"\<Positive averaging tolerance required.\>\""}], "]"}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"16", " ", 
           RowBox[{"2", "^", 
            RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], " ", 
           RowBox[{"eng", "[", "\"\<RankC\>\"", "]"}]}], "<=", 
          RowBox[{
           RowBox[{"eng", "[", "\"\<Settings\>\"", "]"}], 
           "[", "\"\<MaxEntries\>\"", "]"}]}], 
         ",", "\"\<One exchange average Choi factor exceeds \
MaxEntries.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"all", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"Table", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], "[", 
                 RowBox[{"[", "n", "]"}], "]"}], ",", "k", ",", "n"}], "}"}], 
              ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", 
                RowBox[{"Length", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], 
                 "]"}]}], "}"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Length", "[", 
               RowBox[{"eng", "[", "\"\<Blocks\>\"", "]"}], "]"}]}], "}"}]}], 
           "]"}], ",", "1"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"all", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"absolute", "=", 
        RowBox[{"relativeTol", " ", "scale"}]}], ";", 
       RowBox[{"clusters", "=", 
        RowBox[{"chClusters", "[", 
         RowBox[{"all", ",", "absolute"}], "]"}]}], ";", 
       RowBox[{"widths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
         "clusters"}]}], ";", "\n", " ", 
       RowBox[{"chi", "=", 
        RowBox[{"chExTimeAverage", "[", 
         RowBox[{"eng", ",", "absolute"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Choi\>\"", "->", 
          RowBox[{"4", " ", "chi"}]}], ",", 
         RowBox[{"\"\<ChoiState\>\"", "->", "chi"}], ",", 
         RowBox[{"\"\<Transfer\>\"", "->", 
          RowBox[{"chChoiToSuper", "[", "chi", "]"}]}], ",", 
         RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",",
          "\n", " ", 
         RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", "absolute"}], ",", 
         RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
         RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
         RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
          RowBox[{"Max", "[", "widths", "]"}]}], ",", "\n", " ", 
         RowBox[{"\"\<SingletonClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<DegenerateClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", "\n", 
         " ", 
         RowBox[{"\"\<TPError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"4", " ", 
             RowBox[{"chChoiTraceOut", "[", "chi", "]"}]}], "-", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<MapEntropy\>\"", "->", 
          RowBox[{"entropy", "[", "chi", "]"}]}], ",", "\n", " ", 
         RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", 
              RowBox[{"choiPartialTransposeOut", "[", "chi", "]"}], "]"}], 
             "]"}], "]"}], "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"186c9f34-9a41-d847-acd2-8f7d124f391c"],

Cell[BoxData[""], "Input",ExpressionUUID->"12988aad-4324-cc47-a820-02c94f758db1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chSinglePlot", "[", 
    RowBox[{
    "records_", ",", "key_", ",", "label_", ",", "title_", ",", "p_", ",", 
     "log_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rows", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rows", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", "\"\<Time\>\"", "]"}], ",", 
              RowBox[{"#", "[", "key", "]"}]}], "}"}], "&"}], " ", "/@", " ", 
           "records"}], ")"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", 
            RowBox[{"Last", "[", "#", "]"}], "]"}], " ", "&&", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"!", "log"}], " ", "||", " ", 
             RowBox[{
              RowBox[{"First", "[", "#", "]"}], ">", "0"}]}], ")"}]}], 
          "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"rows", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"tex", "[", 
             RowBox[{"title", ",", "20"}], "]"}], ",", 
            RowBox[{"tex", "[", 
             
             RowBox[{"\"\<\\\\text{No valid samples under the selected \
tolerances.}\>\"", ",", "14"}], "]"}]}], "}"}], "]"}], "]"}]}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"g", "=", 
       RowBox[{"Block", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"plotChop", "=", "0"}], "}"}], ",", 
         RowBox[{"framePlot", "[", 
          RowBox[{
           RowBox[{"{", "rows", "}"}], ",", "\"\<t\>\"", ",", "label", ",", 
           RowBox[{"{", "Blue", "}"}], ",", 
           RowBox[{"{", "label", "}"}], ",", "False", ",", "log", ",", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{"\"\<\[FilledCircle]\>\"", ",", "3"}], "}"}], "}"}]}], 
          "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"plotPanel", "[", 
       RowBox[{"title", ",", 
        RowBox[{"trajectoryCaption", "[", 
         RowBox[{"p", ",", "records"}], "]"}], ",", "g"}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chPlots", "[", 
    RowBox[{"records_", ",", "p_", ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"out", "=", 
       RowBox[{"mapPlots", "[", 
        RowBox[{"records", ",", "p", ",", "log"}], "]"}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"AssociateTo", "[", 
       RowBox[{"out", ",", 
        RowBox[{"\"\<TimeReversalError\>\"", "->", 
         RowBox[{"chSinglePlot", "[", 
          RowBox[{
          "records", ",", "\"\<TimeReversalError\>\"", ",", "\n", 
           "  ", "\"\<\\\\|S_{-t}^{[\\\\rho_E]}-(S_t^{[\\\\rho_E^*]})^*\\\\|_{\
\\\\max}\>\"", ",", "\"\<\\\\text{Conjugate-bulk time-reversal check}\>\"", ",",
            "p", ",", "log"}], "]"}]}]}], "]"}], ";", "\n", " ", "\n", " ", 
      "out"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->\
"cd1ccb0d-9d32-a24c-af22-7c27cf593418"],

Cell["\<\
  Revision-2 channel engine adapted to the existing conventions: L is TOTAL \
length; the bulk has L-2 spins; S=sigma/2 and the exchange flip amplitude is \
g/2. Stored Choi still has trace 4, ChoiState trace 1. No fields are \
introduced. Guide field-retuning examples and its SU(2) suggestion do not \
apply to these XY-only end bonds. The legacy map helpers remain available to \
the unchanged QST chapter; chapter 3 uses only the new ch-prefixed engine.  \
\>", "Text",ExpressionUUID->"ca850413-5756-8b4d-86bd-a85c3a0421dd"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["  3.2 Independent map parameters and bulk state  ", "Subsection",ExpressionUUID->"53d0d748-7065-934b-a0f0-06ef2cdb175e"],

Cell[BoxData[""], "Input",ExpressionUUID->"c07df302-943a-3f49-84ea-7495e537167e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapBulk", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
      RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternative", ":", " ", "mapBulk"}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"mapTime", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", 
     RowBox[{"\"\<tMax\>\"", "->", "400."}], ",", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", 
     RowBox[{"\"\<LogPoints\>\"", "->", "201"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<EDTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<ValidationTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
      RowBox[{"\"\<ProjectionCutoff\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<RankTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MinimumSingularValue\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "8"}]}]}], ",", "\n", " ", 
      RowBox[{"\"\<AverageEnergyTolerance\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<SignalThreshold\>\"", "->", "0.01"}], ",", "\n", " ", 
      RowBox[{"\"\<Symmetries\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<ZZMethod\>\"", "->", "Automatic"}], ",", 
      RowBox[{"\"\<BatchTimes\>\"", "->", "64"}], ",", "\n", " ", 
      RowBox[{"\"\<MaxColumns\>\"", "->", "4096"}], ",", 
      RowBox[{"\"\<MaxEntries\>\"", "->", 
       RowBox[{"2", "^", "22"}]}], ",", 
      RowBox[{"\"\<MaxOverlapEntries\>\"", "->", 
       RowBox[{"2", "^", "24"}]}], ",", "\n", " ", 
      RowBox[{"\"\<TimeReversalCheck\>\"", "->", "\"\<Endpoints\>\""}]}], 
     "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Exact", " ", "zero"}], "-", 
     RowBox[{"column", " ", "pruning", " ", 
      RowBox[{"only", ".", " ", 
       RowBox[{"ZZMethod", ":", " ", "Automatic"}]}]}]}], ",", 
    " ", "\"\<Direct\>\"", ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"\"\<Overlap\>\"", ".", "\n", " ", "MaxEntries"}], " ", 
       "limits", " ", "ONE", " ", "exchange", " ", "Choi"}], "-", 
      RowBox[{"factor", " ", "array"}]}], ";", " ", 
     RowBox[{
      RowBox[{"derivatives", "/", "temporaries"}], " ", "add", " ", 
      RowBox[{"memory", ".", "\n", " ", 
       RowBox[{"TimeReversalCheck", ":", " ", "\"\<None\>\""}]}]}]}], ",", 
    " ", 
    RowBox[{"\"\<Endpoints\>\"", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"first", "/", "middle"}], "/", "last"}], ")"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"or", " ", 
         RowBox[{"\"\<All\>\"", ".", "\n", " ", "Optional"}], " ", "sector"}],
         "-", 
        RowBox[{"defined", " ", "thermal", " ", "estimator", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"different", " ", "finite"}], "-", 
           RowBox[{"sample", " ", "ensemble"}]}], ")"}]}]}], ":", "\n", " ", 
       "mapBulk"}], "=", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Type\>\"", "->", "\"\<SectorTypical\>\""}], ",", 
        RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
        RowBox[{"\"\<SamplesPerSector\>\"", "->", "2"}], ",", 
        RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
     RowBox[{
      RowBox[{"Existing", " ", "Type"}], "->", 
      RowBox[{
       RowBox[{"\"\<Typical\>\"", " ", "keeps", " ", "its", " ", "original", " ",
         "global", " ", "random"}], "-", 
       RowBox[{"vector", " ", 
        RowBox[{"definition", "."}]}]}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"mapComputeInfiniteTimeAverage", "=", "True"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapLogHorizontalAxis", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapRunLabel", "=", "\"\<Exchange_map_dynamics\>\""}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"0d013fb8-4923-d249-9b82-\
7b2172816eaa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  3.3 Probe settings for witnesses; these do not define the map  \
