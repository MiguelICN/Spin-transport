                RowBox[{"Table", "[", 
                 RowBox[{
                  
                  RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
                   "<>", "\"\<}\\\\Gamma_{\>\"", "<>", 
                   RowBox[{"IntegerString", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", "2", ",",
                     "2"}], "]"}], "<>", "\"\<,\>\"", "<>", 
                   RowBox[{"IntegerString", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", "2", ",",
                     "2"}], "]"}], "<>", "\"\<}\>\""}], ",", 
                  RowBox[{"{", 
                   RowBox[{"pair", ",", "pairs"}], "}"}]}], "]"}]}], 
               "]"}]}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"part", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\""}], "}"}]}], "}"}]}], 
         "]"}]}], "]"}], ";", "out"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"qstExport", "[", 
     RowBox[{"root_", ",", "tag_", ",", "plots_", ",", "data_"}], "]"}], " ", 
    ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"dir", ",", "params"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"dir", "=", 
        RowBox[{"exportBundle", "[", 
         RowBox[{"root", ",", "tag", ",", "plots", ",", "data"}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"params", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{"data", ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<Used\>\"", ",", "\"\<ShortTimeUsed\>\"", 
            ",", "\"\<Checks\>\"", ",", "\"\<ShortTimeChecks\>\"", 
            ",", "\"\<RandomResponseCheck\>\"", 
            ",", "\"\<ConsistencyCheck\>\"", ",", "\"\<WindowMeanR\>\"", 
            ",", "\"\<InfiniteTime\>\""}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"StringQ", "[", 
          RowBox[{"Export", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
            RowBox[{"ToString", "[", 
             RowBox[{"params", ",", "InputForm"}], "]"}], 
            ",", "\"\<Text\>\""}], "]"}], "]"}], 
         ",", "\"\<QST parameters.txt export failed.\>\""}], "]"}], ";", 
       "dir"}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstSaveComparison", "[", 
    RowBox[{"root_", ",", "a_", ",", "b_", ",", "comparison_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"payload", ",", "dir"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"payload", "=", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<AUsed\>\"", "->", "a"}], ",", 
         RowBox[{"\"\<BUsed\>\"", "->", "b"}], ",", 
         RowBox[{"\"\<ConsistencyCheck\>\"", "->", "comparison"}]}], "|>"}]}],
       ";", "\n", " ", 
      RowBox[{"dir", "=", 
       RowBox[{"exportBundle", "[", 
        RowBox[{"root", ",", "\"\<Exchange_QST_AB_comparison\>\"", ",", 
         RowBox[{"<|", "|>"}], ",", "payload"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", 
         RowBox[{"Export", "[", 
          RowBox[{
           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "\"\<comparison.txt\>\""}], "}"}], "]"}], ",", 
           RowBox[{"ToString", "[", 
            RowBox[{"payload", ",", "InputForm"}], "]"}], 
           ",", "\"\<Text\>\""}], "]"}], "]"}], 
        ",", "\"\<QST comparison export failed.\>\""}], "]"}], ";", "dir"}]}],
     "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"d81f6936-b181-c149-\
9138-4e80fba5c4d3"],

Cell["\<\
  Only new QST symbols are cleared. Stored quantities are never clipped: an \
exactly zero grand sum gives Infinity; a negative grand sum gives \
Missing[NegativeGrandSum,...] and is reported. The new batch wrapper calls \
evolveBatch, stateRecord and mapChoiFromFactor unchanged. It supports serial \
batches or existing/new parallel kernels without resetting them. MemoryMB \
bounds estimated transient factor storage, not the total ED/record memory. A \
failed or aborted batch stops the parent evaluation; partial results are not \
returned. QST uses the revised shared numerical definitions; model and bulk \
inputs remain independent of chapters 1\[Dash]3.  \
\>", "Text",ExpressionUUID->"453b3e4c-ba32-8e44-af88-c12dda35852d"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  4.A.1 Open dynamics of the textureless edge state \[LongDash] editable \
inputs  \
\>", "Subsection",ExpressionUUID->"1eede255-7567-2c48-bf3d-70b59bf7f372"],

Cell["\<\
  rho(0)=f1_AB tensor rhoE. There is no editable edge state. The exact \
full-system unitary is reduced to the two edges at every time. Every standard \
chapter-2 state observable is retained alongside the texture quantities. ZZ \
uses the four conditional bulk Hamiltonians; exchange uses occupied \
full-chain symmetry sectors.  \
\>", "Text",ExpressionUUID->"1495a3bb-5d37-9045-8973-4f76d1c2f61e"],

Cell[BoxData[""], "Input",ExpressionUUID->"43250ed7-e7fa-eb45-915b-27de7760f8ae"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"qstAModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"qstABulk", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Type\>\"", "->", "\"\<Neel\>\""}], ",", 
     RowBox[{"\"\<First\>\"", "->", "0"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstABulkNote", "=", "\"\<Neel bulk, first bit 0\>\""}], ";"}], 
  "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Alternatives", ":", " ", 
      RowBox[{
      "replace", " ", "the", " ", "one", " ", "assignment", " ", "above", " ",
        "and", " ", "its", " ", 
       RowBox[{"note", ".", "\n", " ", "qstABulk"}]}]}], "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Polarized\>\""}], ",", 
       RowBox[{"\"\<Bit\>\"", "->", "0"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "planar", " ", "*)"}], "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Helix\>\""}], ",", 
       RowBox[{"\"\<q\>\"", "->", 
        RowBox[{"Pi", "/", "3"}]}], ",", 
       RowBox[{"\"\<theta\>\"", "->", 
        RowBox[{"Pi", "/", "4"}]}], ",", 
       RowBox[{"\"\<phi\>\"", "->", "0"}]}], "|>"}]}], ";", " ", 
    RowBox[{"(*", " ", "conical", " ", "*)"}], "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<PolarHelix\>\""}], ",", 
       RowBox[{"\"\<ThetaList\>\"", "->", 
        RowBox[{"N", "[", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"Pi", "/", "6"}], ",", 
           RowBox[{"5", " ", 
            RowBox[{"Pi", "/", "6"}]}], ",", 
           RowBox[{
            RowBox[{"qstAModel", "[", "\"\<L\>\"", "]"}], "-", "3"}]}], "]"}],
          "]"}]}], ",", "\n", "  ", 
       RowBox[{"\"\<PhiList\>\"", "->", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{
           RowBox[{"qstAModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], 
         "]"}]}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<User\>\""}], ",", 
       RowBox[{"\"\<State\>\"", "->", "yourBulkDensityMatrix"}]}], "|>"}]}], ";",
     "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{"\"\<Type\>\"", "->", "\"\<InfiniteT\>\""}], "|>"}]}], ";", 
    "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Gibbs\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{"qstABulk", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Type\>\"", "->", "\"\<Typical\>\""}], ",", 
       RowBox[{"\"\<Beta\>\"", "->", "1."}], ",", 
       RowBox[{"\"\<Samples\>\"", "->", "4"}], ",", 
       RowBox[{"\"\<Seed\>\"", "->", "1234"}]}], "|>"}]}], ";", "\n", " ", 
    RowBox[{
    "A", " ", "polar", " ", "helix", " ", "is", " ", "specified", " ", "by", " ",
      "the", " ", "actual", " ", "local", " ", "angles"}], ";", " ", 
    RowBox[{
     RowBox[{"no", " ", "exact"}], "-", 
     RowBox[{"eigenstate", " ", "condition", " ", "is", " ", 
      RowBox[{"assumed", "."}]}]}]}], " ", "*)"}]}], "\n"}], "Code",Expression\
UUID->"e3d9ccde-b3a2-dc44-91d4-b68d1ce6a147"],

