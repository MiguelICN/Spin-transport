Cell[CellGroupData[{

Cell["  Compatible subspaces from the benchmark  ", "Subsubsection",ExpressionUUID->"630b9f04-0335-1f4d-b846-6444425826fc"],

Cell[BoxData[""], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"4353ed85-3b0b-7c45-9269-878dc15a9f52"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"exEdgeSpaces", "[", 
     RowBox[{"p_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "bits", ",", "q", ",", 
        "ids", ",", "m", ",", "names", ",", "spaces", ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       RowBox[{"q", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"charges", "[", "p", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"m", "=", 
           RowBox[{
            RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
          RowBox[{"ids", "=", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", "l"}], "]"}], ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"bits", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], 
              "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"names", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"m", "==", "0"}], ",", 
             RowBox[{"{", 
              RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}], ",", 
             RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Basis\>\"", "->", 
               RowBox[{"IdentityMatrix", "[", 
                RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"<|", 
                RowBox[{"\"\<m\>\"", "->", "m"}], "|>"}]}]}], "|>"}], "}"}]}],
           ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{"spaces", "=", 
             RowBox[{"Flatten", "[", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"splitCharge", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                    "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
                "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
          RowBox[{"out", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}], 
               "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"nDown", ",", "0", ",", "l"}], "}"}]}], "]"}], ";", 
       "out"}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[47]:=",ExpressionUUID->"c9de25a4-b7a6-924d-a932-6b6f733932dc"],

