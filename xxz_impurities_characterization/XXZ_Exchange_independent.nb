Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"mapProbes", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Rho1\>\"", "->", 
       RowBox[{"ketRho", "[", 
        RowBox[{"{", 
