Cell[CellGroupData[{

Cell["  1.6 Fixed g: editable Delta scan  ", "Subsection",ExpressionUUID->"dbb84248-eb72-1e4c-aa62-191602abbf8c"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[136]:=",ExpressionUUID->"a466c18f-d50b-8648-be35-7183a64a5698"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"statDeltaModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statDeltaGrid", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Subdivide", "[", 
     RowBox[{
      RowBox[{"-", "2"}], ",", "2", ",", "400"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statDeltaEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"statDeltaPlotSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<PlotChop\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SectorKeys", "->", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ", 
      "limits", " ", 
      RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
    RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
     RowBox[{"computed", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"statDeltaOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statDeltaRunLabel", "=", "\"\<Exchange_static_Delta\>\""}], 
  ";"}], "\n"}], "Code",
 CellChangeTimes->{{4.0013849204985504`*^9, 4.001384931215294*^9}},
 CellLabel->
  "In[137]:=",ExpressionUUID->"d8ec9601-ebf7-b348-9898-96983369a035"],

Cell["\<\
  All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches.  \
\>", "Text",ExpressionUUID->"0d7d0e72-0919-c149-9b06-20e62dcb7690"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.7 Compute complete eigenpairs and the three eigenstate observables  \
\>", "Subsection",ExpressionUUID->"783be1fc-58a0-e441-ad57-d4fbb5fc15f5"],

Cell[BoxData[""], "Input",
 CellLabel->
  "In[143]:=",ExpressionUUID->"324f02b6-a052-514c-9922-39d53d8084ed"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"statDeltaSeconds", ",", "statDeltaRun"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"staticScan", "[", 
     RowBox[{
     "statDeltaModel", ",", "\"\<Delta\>\"", ",", "statDeltaGrid", ",", 
      "statDeltaEDTolerance"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Seconds: \>\"", ",", "statDeltaSeconds", 
    ",", "\"\<; parameter points: \>\"", ",", 
    RowBox[{"Length", "[", 
     RowBox[{"statDeltaRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
