      RowBox[{"Lookup", "[", 
       RowBox[{"mapRecords", ",", "\"\<Time\>\""}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"mapSummary", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<SignalThreshold\>\"", "->", 
      RowBox[{"mapSettingsUsed", "[", "\"\<SignalThreshold\>\"", "]"}]}], ",",
      "\n", " ", 
     RowBox[{"\"\<SignalOnset\>\"", "->", 
      RowBox[{"onsetTime", "[", 
       RowBox[{"mapTimes", ",", 
        RowBox[{"Lookup", "[", 
         RowBox[{"mapRecords", ",", "\"\<SignalAtoB\>\""}], "]"}], ",", 
        RowBox[{"mapSettingsUsed", "[", "\"\<SignalThreshold\>\"", "]"}]}], 
       "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<BLPGridLowerBound\>\"", "->", 
      RowBox[{
       RowBox[{"Last", "[", "mapRecords", "]"}], "[", "\"\<BLPAccumulated\>\"",
        "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<RHPValidSteps\>\"", "->", 
      RowBox[{"Count", "[", 
       RowBox[{
        RowBox[{"Lookup", "[", 
         RowBox[{"mapRecords", ",", "\"\<RHPFiniteStep\>\""}], "]"}], ",", 
        RowBox[{"_", "?", "NumericQ"}]}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Time\>\"", ",", "\"\<TPError\>\"", 
          ",", "\"\<MinChoiEigenvalue\>\"", ",", "\"\<MapEntropy\>\"", 
          ",", "\"\<MinSingularValue\>\""}], "}"}]}], "]"}], "&"}], " ", "/@",
      " ", 
     RowBox[{"Take", "[", 
      RowBox[{"mapRecords", ",", 
       RowBox[{"UpTo", "[", "8", "]"}]}], "]"}]}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"e1bfe91e-df49-9d42-ba9b-\
5b011d8805e0"],

Cell["\<\
  The derivative of the unitary factor is analytic, using -i E exp(-i E t). \
Near-singular transfer matrices produce Missing values for the generator and \
divisibility diagnostics; no pseudoinverse is substituted. Covariance is \
tested for the chosen bulk preparation, which may break symmetries of H. Rate \
normalization uses G_(mu,nu)=sigma_mu tensor sigma_nu / 2.  \
\>", "Text",ExpressionUUID->"44f14568-b89c-eb41-8d76-00a51816bee9"],

Cell["\<\
  The fast spectral average uses same-bulk-sector overlap contractions for \
ZZ. Exchange uses vectorized singleton contributions and coherent Choi \
factors for globally degenerate clusters. Large mixed factors and highly \
degenerate clusters still have substantial memory costs. Chunk limits bound \
individual working arrays, not total peak memory.  \
\>", "Text",ExpressionUUID->"55a41efa-5fa3-9741-94a7-22436e340979"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  3.5a Conjugate-bulk time-reversal check; reuse the eigensystem  \
\>", "Subsection",ExpressionUUID->"93c97a6a-1685-c743-8ffb-929a2d900416"],

Cell[BoxData[""], "Input",ExpressionUUID->"64ce5c6d-1dd4-2144-859c-8efda3e28ab0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapTimeReversal", "=", 
   RowBox[{"chTimeReversal", "[", 
    RowBox[{"mapEngine", ",", "mapTimes", ",", "mapSettingsUsed"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"mapRecords", "[", 
      RowBox[{"[", 
       RowBox[{
        RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
        RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"mapRecords", "[", 
        RowBox[{"[", 
         RowBox[{
          RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{"\"\<TimeReversalError\>\"", "->", 
         RowBox[{
          RowBox[{"mapTimeReversal", "[", "\"\<Errors\>\"", "]"}], "[", 
          RowBox[{"[", "k", "]"}], "]"}]}], "|>"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", 
       RowBox[{"mapTimeReversal", "[", "\"\<Indices\>\"", "]"}], "]"}]}], 
     "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "mapTimeReversal", "]"}], ";"}], "\n"}], "Code",Expres\
sionUUID->"8fc83dc6-40d8-234c-93b8-c2b3cbc4afc0"],

Cell["\<\
  For complex bulk states the valid relation is \
S[-t;rhoM]=Conjugate[S[t;Conjugate[rhoM]]]. The check conjugates eigenbasis \
coefficients and reuses eigenvectors; it never assumes the same complex bulk \
is time-reversal invariant. Unsampled rows carry Missing[NotSampled]. ZZ \
canonical rates use a 3-by-3 projected dephasing generator plus twelve zero \
rates; its intermediate-map support minimum is shown separately from the full \
Choi minimum, which includes twelve exact zeros.  \
\>", "Text",ExpressionUUID->"8261109e-dcc6-e549-99e1-95da7092f8df"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  3.6 Optional infinite-time average across all energy-degenerate sectors  \
\>", "Subsection",ExpressionUUID->"231a7801-ca4f-8b42-8c6d-31e74231a4bb"],

Cell[BoxData[""], "Input",ExpressionUUID->"cddcdf6d-10d5-0a47-a6e3-f2ccbf8448b1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapAverage", "=", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"TrueQ", "[", "mapComputeInfiniteTimeAverage", "]"}], ",", "\n", 
     " ", 
     RowBox[{"chAverage", "[", 
      RowBox[{"mapEngine", ",", 
       RowBox[{
       "mapSettingsUsed", "[", "\"\<AverageEnergyTolerance\>\"", "]"}]}], 
      "]"}], ",", 
     RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"AssociationQ", "[", "mapAverage", "]"}], ",", 
    RowBox[{"Print", "[", 
     RowBox[{"Dataset", "[", 
      RowBox[{"KeyTake", "[", 
       RowBox[{"mapAverage", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<TPError\>\"", ",", "\"\<MapEntropy\>\"", 
          ",", "\"\<ChoiPTMinimum\>\"", ",", "\"\<MaxClusterWidth\>\""}], 
         "}"}]}], "]"}], "]"}], "]"}]}], "]"}], ";"}], "\n"}], "Code",Expressi\
onUUID->"1c3eeaa8-1557-db40-93b9-c5b7a8bb0461"],

Cell["\<\
  Exchange clusters span all occupied total-magnetization sectors. ZZ needs \
only equal-energy contributions within the same bulk-magnetization sector, \
since the partial trace annihilates cross-bulk-sector terms. Both use bounded \
cluster width, not transitive chains of near-equalities. Vary \
AverageEnergyTolerance; exact degeneracies are preserved. The result is a \
spectral infinite-time average.  \
\>", "Text",ExpressionUUID->"6ae72e62-5af9-884a-89bf-0b864275e38a"]
}, Open  ]],

