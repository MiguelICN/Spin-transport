                    "&"}], " ", "/@", " ", "pairs"}], ")"}]}], "}"}]}], "]"}],
                    "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";", 
           "\n", "   ", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"out", ",", 
             RowBox[{
