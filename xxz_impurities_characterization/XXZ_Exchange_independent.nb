       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"MatrixQ", "[", 
          RowBox[{"probes", "[", "\"\<Rho1\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{"MatrixQ", "[", 
          RowBox[{"probes", "[", "\"\<Rho2\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{"MatrixQ", "[", 
          RowBox[{"probes", "[", "\"\<RhoB\>\"", "]"}], "]"}]}], 
        ",", "\"\<Map probes must be density matrices.\>\""}], "]"}], ";", 
      "\n", " ", 
      RowBox[{"s0", "=", 
       RowBox[{
        RowBox[{"mapAt", "[", 
         RowBox[{"0", ",", "eng"}], "]"}], "[", "\"\<Transfer\>\"", "]"}]}], ";", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{"s0", "-", 
           RowBox[{"IdentityMatrix", "[", "16", "]"}]}], "]"}], "<", 
         RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
        ",", "\"\<The t=0 map is not identity.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"recs", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"mapRecord", "[", 
          RowBox[{"#", ",", "eng", ",", "cfg", ",", "probes"}], "]"}], "&"}], 
        " ", "/@", " ", "times"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Max", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<TPError\>\""}], "]"}], "]"}], "<", 
          RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}], " ", "&&",
          "\n", "  ", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"recs", ",", "\"\<MinChoiEigenvalue\>\""}], "]"}], "]"}], 
          ">=", 
          RowBox[{"-", 
           RowBox[{"cfg", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}], 
        ",", "\"\<Choi CP/TP validation failed.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"dist", "=", 
       RowBox[{"Lookup", "[", 
        RowBox[{"recs", ",", "\"\<BLPDistance\>\""}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dt", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", "==", "1"}], ",", 
            RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", 
             RowBox[{"times", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}]}], "]"}]}], ";", "\n", 
         "  ", 
         RowBox[{"rhp", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"k", "==", "1"}], ",", 
            RowBox[{"Missing", "[", "\"\<NoPreviousTime\>\"", "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"recs", "[", 
                 RowBox[{"[", 
                  RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                "[", "\"\<MinSingularValue\>\"", "]"}], "<", 
               RowBox[{"cfg", "[", "\"\<MinimumSingularValue\>\"", "]"}]}], ",",
               "\n", "   ", 
              RowBox[{"Missing", "[", "\"\<NearSingularMap\>\"", "]"}], ",", 
              RowBox[{"Max", "[", 
               RowBox[{"0.", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"traceNormHermitian", "[", 
                   RowBox[{"transferToChoi", "[", 
                    RowBox[{"rightSolve", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Transfer\>\"", 
                    "]"}], ",", 
                    RowBox[{
                    RowBox[{"recs", "[", 
                    RowBox[{"[", 
                    RowBox[{"k", "-", "1"}], "]"}], "]"}], 
                    "[", "\"\<Transfer\>\"", "]"}]}], "]"}], "]"}], "]"}], "/",
                   "4"}], "-", "1"}]}], "]"}]}], "]"}]}], "]"}]}], ";", "\n", 
         "  ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"recs", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ",", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<BLPAccumulated\>\"", "->", 
              RowBox[{"Total", "[", 
               RowBox[{"Clip", "[", 
                RowBox[{
                 RowBox[{"Differences", "[", 
                  RowBox[{"Take", "[", 
                   RowBox[{"dist", ",", "k"}], "]"}], "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}], "]"}]}], ",",
              "\n", "   ", 
             RowBox[{"\"\<RHPFiniteStep\>\"", "->", "rhp"}], ",", 
             RowBox[{"\"\<RHPFiniteStepRate\>\"", "->", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"MissingQ", "[", "rhp", "]"}], ",", "rhp", ",", 
                RowBox[{"rhp", "/", "dt"}]}], "]"}]}]}], "|>"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "recs", "]"}]}], "}"}]}], "]"}]}]}], "\n", 
    "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"992b9525-a600-224b-b03d-\
230dac244475"],

Cell[BoxData[""], "Input",ExpressionUUID->"4cf39570-b105-5d43-97ec-0921943ca1e1"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mapLevelFactors", "[", 
    RowBox[{"eng_", ",", "item_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"s", "=", 
        RowBox[{
         RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"item", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}], ",", "v", ",", "c",
        ",", "w"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"0.", "+", 
          RowBox[{"0.", "I"}]}], ",", 
         RowBox[{"eng", "[", "\"\<Dimension\>\"", "]"}]}], "]"}]}], ";", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", 
         RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"s", "[", "\"\<V\>\"", "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"item", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], "+", 
        RowBox[{"0.", "I"}]}]}], ";", "\n", " ", 
      RowBox[{"c", "=", 
       RowBox[{
        RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"item", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"w", "=", 
       RowBox[{"partitionFactor", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", "v", "}"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
         RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"{", 
       RowBox[{"w", ",", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{"c", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Columns\>\"", "]"}], "/", "4"}]}], 
           "}"}]}], "]"}]}], "}"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapLevelCross", "[", 
    RowBox[{"a_", ",", "b_"}], "]"}], " ", ":=", " ", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"[", "2", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"b", "[", 
        RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"a", "[", 
       RowBox[{"[", "1", "]"}], "]"}], " ", ".", " ", 
      RowBox[{"ConjugateTranspose", "[", 
       RowBox[{"b", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapSingletonChoi", "[", 
    RowBox[{"eng_", ",", "item_"}], "]"}], " ", ":=", " ", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", "=", 
       RowBox[{"mapLevelFactors", "[", 
        RowBox[{"eng", ",", "item"}], "]"}]}], "}"}], ",", 
     RowBox[{"mapLevelCross", "[", 
      RowBox[{"a", ",", "a"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapClusterChoi", "[", 
    RowBox[{"eng_", ",", "cluster_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"f", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"mapLevelFactors", "[", 
           RowBox[{"eng", ",", "#"}], "]"}], "&"}], " ", "/@", " ", 
         "cluster"}]}], ",", "c", ",", "x"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Total", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"mapLevelCross", "[", 
           RowBox[{"#", ",", "#"}], "]"}], "&"}], " ", "/@", " ", "f"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"mapLevelCross", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"f", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
         RowBox[{"c", "+=", 
          RowBox[{"x", "+", 
           RowBox[{"ConjugateTranspose", "[", "x", "]"}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"i", "+", "1"}], ",", 
          RowBox[{"Length", "[", "f", "]"}]}], "}"}]}], "]"}], ";", "c"}]}], 
    "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"energyClusters", "[", 
    RowBox[{"eng_", ",", "absoluteTol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"levels", ",", 
       RowBox[{"clusters", "=", 
        RowBox[{"{", "}"}]}], ",", "current"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"levels", "=", 
       RowBox[{"SortBy", "[", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], "[", 
                RowBox[{"[", "n", "]"}], "]"}], ",", "k", ",", "n"}], "}"}], ",",
              "\n", "  ", 
             RowBox[{"{", 
              RowBox[{"k", ",", 
               RowBox[{"Length", "[", 
                RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "]"}]}], "}"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{"n", ",", 
               RowBox[{"Length", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], "[", 
                  RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<E\>\"", "]"}], 
                "]"}]}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", "First"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"current", "=", 
       RowBox[{"{", 
        RowBox[{"First", "[", "levels", "]"}], "}"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"item", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", 
            RowBox[{"current", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "<=", "absoluteTol"}], 
          ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"current", ",", "item"}], "]"}], ",", 
          RowBox[{
           RowBox[{"AppendTo", "[", 
            RowBox[{"clusters", ",", "current"}], "]"}], ";", 
           RowBox[{"current", "=", 
            RowBox[{"{", "item", "}"}]}]}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"item", ",", 
          RowBox[{"Rest", "[", "levels", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"Append", "[", 
       RowBox[{"clusters", ",", "current"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeAveragedMap", "[", 
     RowBox[{"eng_", ",", 
      RowBox[{"relativeTol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"scale", ",", "clusters", ",", "c", ",", "widths"}], "}"}], ",",
       "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", "relativeTol", "]"}], " ", "&&", " ", 
          RowBox[{"relativeTol", ">", "0"}]}], 
         ",", "\"\<Energy-cluster tolerance must be positive.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"scale", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"1.", ",", 
          RowBox[{"maxAbs", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"eng", "[", "\"\<Sectors\>\"", "]"}], ",", "\"\<E\>\""}],
             "]"}], "]"}]}], "]"}]}], ";", 
       RowBox[{"clusters", "=", 
        RowBox[{"energyClusters", "[", 
         RowBox[{"eng", ",", 
          RowBox[{"relativeTol", " ", "scale"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"c", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", "I"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"16", ",", "16"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "cluster", "]"}], "==", "1"}], ",", 
            RowBox[{
             RowBox[{"c", "+=", 
              RowBox[{"mapSingletonChoi", "[", 
               RowBox[{"eng", ",", 
                RowBox[{"First", "[", "cluster", "]"}]}], "]"}]}], ";", 
             RowBox[{"Continue", "[", "]"}]}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"c", "+=", 
           RowBox[{"mapClusterChoi", "[", 
            RowBox[{"eng", ",", "cluster"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"cluster", ",", "clusters"}], "}"}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"widths", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Last", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "&"}], " ", "/@", " ", 
         "clusters"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Choi\>\"", "->", "c"}], ",", 
         RowBox[{"\"\<ChoiState\>\"", "->", 
          RowBox[{"c", "/", "4"}]}], ",", 
         RowBox[{"\"\<Transfer\>\"", "->", 
          RowBox[{"choiToTransfer", "[", "c", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<RelativeEnergyTolerance\>\"", "->", "relativeTol"}], ",", 
         RowBox[{"\"\<AbsoluteEnergyTolerance\>\"", "->", 
          RowBox[{"relativeTol", " ", "scale"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<Clusters\>\"", "->", "clusters"}], ",", 
         RowBox[{"\"\<ClusterWidths\>\"", "->", "widths"}], ",", 
         RowBox[{"\"\<MaxClusterWidth\>\"", "->", 
          RowBox[{"Max", "[", "widths", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<SingletonClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", "1"}], 
           "]"}]}], ",", 
         RowBox[{"\"\<DegenerateClusters\>\"", "->", 
          RowBox[{"Count", "[", 
           RowBox[{
            RowBox[{"Length", " ", "/@", " ", "clusters"}], ",", 
            RowBox[{"_", "?", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"#", ">", "1"}], "&"}], ")"}]}]}], "]"}]}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<TPError\>\"", "->", 
          RowBox[{"maxAbs", "[", 
           RowBox[{
            RowBox[{"choiTraceOut", "[", "c", "]"}], "-", 
            RowBox[{"IdentityMatrix", "[", "4", "]"}]}], "]"}]}], ",", 
         RowBox[{"\"\<MapEntropy\>\"", "->", 
          RowBox[{"entropy", "[", 
           RowBox[{"c", "/", "4"}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<ChoiPTMinimum\>\"", "->", 
          RowBox[{"Min", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", 
              RowBox[{"choiPartialTransposeOut", "[", 
               RowBox[{"c", "/", "4"}], "]"}], "]"}], "]"}], "]"}], "]"}]}]}],
         "|>"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"onsetTime", "[", 
    RowBox[{"times_List", ",", "vals_List", ",", "threshold_"}], "]"}], " ", ":=",
    " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"pos", ",", "k"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "times", "]"}], "==", 
          RowBox[{"Length", "[", "vals", "]"}]}], " ", "&&", " ", 
         RowBox[{"realQ", "[", "threshold", "]"}], " ", "&&", " ", 
         RowBox[{"threshold", ">", "0"}]}], 
        ",", "\"\<Invalid onset threshold/data.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"pos", "=", 
       RowBox[{"FirstPosition", "[", 
        RowBox[{"vals", ",", 
         RowBox[{"x_", "/;", 
          RowBox[{
           RowBox[{"NumericQ", "[", "x", "]"}], " ", "&&", " ", 
           RowBox[{"x", ">", "threshold"}]}]}], ",", 
         RowBox[{"Missing", "[", "\"\<BelowThreshold\>\"", "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"MissingQ", "[", "pos", "]"}], ",", 
        RowBox[{"Return", "[", "pos", "]"}]}], "]"}], ";", 
      RowBox[{"k", "=", 
       RowBox[{"First", "[", "pos", "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"k", "==", "1"}], ",", 
        RowBox[{"First", "[", "times", "]"}], ",", 
        RowBox[{
         RowBox[{"times", "[", 
          RowBox[{"[", 
           RowBox[{"k", "-", "1"}], "]"}], "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"threshold", "-", 
            RowBox[{"vals", "[", 
             RowBox[{"[", 
              RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", 
             RowBox[{"times", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"vals", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "-", 
             RowBox[{"vals", "[", 
              RowBox[{"[", 
               RowBox[{"k", "-", "1"}], "]"}], "]"}]}], ")"}]}]}]}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->\
"cc5d087a-2cc7-7740-a10b-5b97f63e97cf"],

Cell["\<\
  For a fixed normalized bulk state rhoM, Phi_t(X)=Tr_M[U_t (X tensor rhoM) \
U_t dagger]. C_t=sum_ij |i><j| tensor Phi_t(|i><j|); Tr C_t=4 and C_t/4 is \
the Choi state. C_t depends only on the model, bulk state and time. There is \
no initial-edge-state input to chBuild. Full correlated preparations belong \
to chapter 2; one cannot assign them a universal CPTP map for arbitrary edge \
inputs.  \
\>", "Text",ExpressionUUID->"37a4fc25-255c-1b4d-8b80-03198134c3d5"],

Cell["\<\
  Exchange fast implementation: build each occupied total-magnetization block \
directly from the bulk factor, retaining only its active edge-input/bulk \
columns. Reflection parity and spin-flip partner reuse reduce ED. \
Real-arithmetic batched products are scattered directly into the Choi factor \
W, and C=W W dagger. A definite-bulk-magnetization input occupies three \
total-magnetization blocks. No full D-by-4r initial array is constructed.  \
\>", "Text",ExpressionUUID->"bcf39f2b-77ec-374b-8f85-d5b0078c5f9d"],

Cell["\<\
  Map observables include CP/TP diagnostics, Choi spectrum/entropy/rank, \
reference-output negativity, exact time-local generator and canonical rates \
where invertible, finite-step and instantaneous RHP witnesses, selected-pair \
BLP backflow, covariance violations, unitality, double-quantum coherence, \
signalling and retention. Probe edge states below affect only BLP/signalling \
diagnostics, not the Choi matrix. A PPT Choi state does not prove \
entanglement breaking in 4x4.  \
\>", "Text",ExpressionUUID->"611ca7ef-8e28-2347-a5a0-2fb6ab2fd5ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
  Fast channel definitions: conditional/column-pruned batches  \
\>", "Subsubsection",ExpressionUUID->"d200ac87-6f5b-814e-a19e-f0bfa9a3601c"],

Cell[BoxData[""], "Input",ExpressionUUID->"74eb0ca0-0ca6-a948-aaae-64fb31007fed"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chMapSectors", "[", "n_Integer", "]"}], " ", ":=", " ", 
   RowBox[{"Values", "[", 
    RowBox[{"KeySort", "[", 
     RowBox[{"PositionIndex", "[", 
      RowBox[{"DigitCount", "[", 
       RowBox[{
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", 
          RowBox[{
           RowBox[{"2", "^", "n"}], " ", "-", " ", "1"}]}], "]"}], ",", " ", 
        "2", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapReflectPerm", "[", 
    RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"AssociationThread", "[", 
      RowBox[{"ix", ",", " ", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "ix", "]"}], "]"}]}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{"IntegerReverse", "[", 
       RowBox[{
        RowBox[{"ix", " ", "-", " ", "1"}], ",", " ", "2", ",", " ", "n"}], 
       "]"}], " ", "+", " ", "1"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapParityQ", "[", 
    RowBox[{"ix_List", ",", " ", "n_Integer"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Length", "[", "ix", "]"}]}], ",", " ", "jr", ",", " ", "fix",
        ",", " ", "pr", ",", " ", "nf", ",", " ", "qe", ",", " ", "qo"}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"jr", " ", "=", " ", 
       RowBox[{"chMapReflectPerm", "[", 
        RowBox[{"ix", ",", " ", "n"}], "]"}]}], ";", " ", 
      RowBox[{"fix", " ", "=", " ", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Position", "[", 
         RowBox[{
          RowBox[{"jr", " ", "-", " ", 
           RowBox[{"Range", "[", "d", "]"}]}], ",", " ", "0"}], "]"}], 
        "]"}]}], ";", "\n", "  ", 
      RowBox[{"pr", " ", "=", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Range", "[", "d", "]"}], ",", " ", "jr"}], "}"}], "]"}], 
         ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], " ", "<", " ", 
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], " ", "&"}]}], "]"}]}], ";", " ", 
      RowBox[{"nf", " ", "=", " ", 
       RowBox[{"Length", "[", "fix", "]"}]}], ";", "\n", "  ", 
      RowBox[{"qe", " ", "=", " ", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"fix", ",", " ", 
                RowBox[{"Range", "[", "nf", "]"}]}], "}"}], "]"}], " ", "->", 
             " ", "1."}], "]"}], ",", "\n", "      ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pr", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                RowBox[{"nf", " ", "+", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], "]"}],
              " ", "->", " ", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
           "      ", 
           RowBox[{"Thread", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"pr", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                RowBox[{"nf", " ", "+", " ", 
                 RowBox[{"Range", "[", 
                  RowBox[{"Length", "[", "pr", "]"}], "]"}]}]}], "}"}], "]"}],
              " ", "->", " ", 
             RowBox[{"1", "/", 
              RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"d", ",", " ", 
           RowBox[{"nf", " ", "+", " ", 
            RowBox[{"Length", "[", "pr", "]"}]}]}], "}"}]}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"qo", " ", "=", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"pr", " ", "===", " ", 
          RowBox[{"{", "}"}]}], ",", " ", "Nothing", ",", " ", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"pr", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}], 
               " ", "->", " ", 
               RowBox[{"1", "/", 
                RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}], ",", "\n", 
             "      ", 
             RowBox[{"Thread", "[", 
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"pr", "[", 
                   RowBox[{"[", 
                    RowBox[{"All", ",", " ", "2"}], "]"}], "]"}], ",", " ", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "pr", "]"}], "]"}]}], "}"}], "]"}], 
               " ", "->", " ", 
               RowBox[{
                RowBox[{"-", "1"}], "/", 
                RowBox[{"Sqrt", "[", "2.", "]"}]}]}], "]"}]}], "]"}], ",", 
           " ", 
           RowBox[{"{", 
            RowBox[{"d", ",", " ", 
             RowBox[{"Length", "[", "pr", "]"}]}], "}"}]}], "]"}]}], "]"}]}], 
      ";", "\n", "  ", 
      RowBox[{"{", 
       RowBox[{"qe", ",", " ", "qo"}], "}"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"chEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapSectorEigen", "[", 
    RowBox[{"h_", ",", "ix_List", ",", "n_Integer", ",", "parity_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"hb", "=", 
        RowBox[{"N", "[", 
         RowBox[{"h", "[", 
          RowBox[{"[", 
           RowBox[{"ix", ",", "ix"}], "]"}], "]"}], "]"}]}], ",", "es", ",", 
       "out", ",", "perm", ",", "scale"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"scale", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"1.", ",", 
         RowBox[{"Norm", "[", 
          RowBox[{"hb", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"maxAbs", "[", 
           RowBox[{"Im", "[", "hb", "]"}], "]"}], "<=", 
          RowBox[{"chEDTolerance", " ", "scale"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"maxAbs", "[", 
           RowBox[{"hb", "-", 
            RowBox[{"ConjugateTranspose", "[", "hb", "]"}]}], "]"}], "<=", 
          RowBox[{"chEDTolerance", " ", "scale"}]}]}], 
        ",", "\"\<Channel ED requires a real symmetric Hamiltonian.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"TrueQ", "[", "parity", "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "ix", "]"}], ">", "1"}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"perm", "=", 
          RowBox[{"chMapReflectPerm", "[", 
           RowBox[{"ix", ",", "n"}], "]"}]}], ";", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"hb", "-", 
              RowBox[{"hb", "[", 
               RowBox[{"[", 
                RowBox[{"perm", ",", "perm"}], "]"}], "]"}]}], "]"}], "<=", 
            RowBox[{"chEDTolerance", " ", "scale"}]}], 
           ",", "\"\<Channel reflection block is not invariant.\>\""}], "]"}],
          ";", "\n", "  ", 
         RowBox[{"es", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"x", "=", 
                RowBox[{"Eigensystem", "[", 
                 RowBox[{"Normal", "[", 
                  RowBox[{
                   RowBox[{"Transpose", "[", "q", "]"}], " ", ".", " ", "hb", 
                   " ", ".", " ", "q"}], "]"}], "]"}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"Normal", "[", 
                 RowBox[{"q", " ", ".", " ", 
                  RowBox[{"Transpose", "[", 
                   RowBox[{"x", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "]"}]}], "}"}]}],
              "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"q", ",", 
              RowBox[{"chMapParityQ", "[", 
               RowBox[{"ix", ",", "n"}], "]"}]}], "}"}]}], "]"}]}], ";", "\n",
          "  ", 
         RowBox[{"out", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<E\>\"", "->", 
             RowBox[{"Join", "@@", 
              RowBox[{"es", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ",", 
            RowBox[{"\"\<V\>\"", "->", 
             RowBox[{"Join", "[", 
              RowBox[{
               RowBox[{"Sequence", "@@", 
                RowBox[{"es", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "2"}], 
              "]"}]}]}], "|>"}]}]}], ",", "\n", "  ", 
        RowBox[{
         RowBox[{"es", "=", 
          RowBox[{"Eigensystem", "[", 
           RowBox[{"Normal", "[", "hb", "]"}], "]"}]}], ";", 
         RowBox[{"out", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<E\>\"", "->", 
             RowBox[{"es", "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], ",", 
            RowBox[{"\"\<V\>\"", "->", 
             RowBox[{"Transpose", "[", 
              RowBox[{"es", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "|>"}]}]}]}], "]"}],
       ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"hb", " ", ".", " ", 
            RowBox[{"out", "[", "\"\<V\>\"", "]"}]}], "-", 
           RowBox[{"Transpose", "[", 
            RowBox[{
             RowBox[{"out", "[", "\"\<E\>\"", "]"}], " ", 
             RowBox[{"Transpose", "[", 
              RowBox[{"out", "[", "\"\<V\>\"", "]"}], "]"}]}], "]"}]}], "]"}],
          "<=", 
         RowBox[{"100", " ", "chEDTolerance", " ", "scale"}]}], 
        ",", "\"\<Channel eigenpair residual failed.\>\""}], "]"}], ";", "\n",
       " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{
             RowBox[{"out", "[", "\"\<V\>\"", "]"}], "^", "2"}], "]"}], "-", 
           "1"}], "]"}], "<=", 
         RowBox[{"100", " ", "chEDTolerance"}]}], 
        ",", "\"\<Channel eigenvector normalization failed.\>\""}], "]"}], ";",
       "out"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->\
"0452770c-c78e-3747-a409-edde179ae2a1"],

Cell[BoxData[""], "Input",ExpressionUUID->"556ad165-bf7d-3b40-8394-c58e7018392a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chMapPhaseBlock", "[", 
    RowBox[{"e_List", ",", " ", 
     RowBox[{"c_", "?", "MatrixQ"}], ",", " ", "tc_List", ",", " ", 
     RowBox[{"dot_", " ", ":", " ", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ph", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         RowBox[{"Outer", "[", 
          RowBox[{"Times", ",", " ", "e", ",", " ", "tc"}], "]"}]}], "]"}]}], 
      "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"TrueQ", "[", "dot", "]"}], ",", " ", 
        RowBox[{"ph", " ", "=", " ", 
         RowBox[{
          RowBox[{"-", "I"}], " ", "e", " ", "ph"}]}]}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{"ArrayReshape", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ph", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", " ", "tau"}], "]"}], "]"}], " ", "c"}], ",",
             " ", 
            RowBox[{"{", 
             RowBox[{"tau", ",", " ", 
              RowBox[{"Length", "[", "tc", "]"}]}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "1", ",", " ", "3"}], "}"}]}], "]"}], ",", 
        " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", "e", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"Length", "[", "tc", "]"}], " ", 
           RowBox[{"Last", "[", 
            RowBox[{"Dimensions", "[", "c", "]"}], "]"}]}]}], "}"}]}], 
       "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapRealDot", "[", 
    RowBox[{
     RowBox[{"v_", "?", "MatrixQ"}], ",", " ", 
     RowBox[{"b_", "?", "MatrixQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"v", " ", ".", " ", 
     RowBox[{"Re", "[", "b", "]"}]}], " ", "+", " ", 
    RowBox[{"I", " ", 
     RowBox[{"v", " ", ".", " ", 
      RowBox[{"Im", "[", "b", "]"}]}]}]}]}], ";"}], "\n"}], "Code",ExpressionU\
UID->"93c809c7-7088-0c45-93be-06b5a6a85576"],

Cell[BoxData[""], "Input",ExpressionUUID->"1cca3d45-5640-5d4e-95ef-20003dbb210e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"chMapGibbsFactor", "[", 
    RowBox[{"delta_", ",", " ", "p_Association", ",", " ", 
     RowBox[{"beta_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", "h", ",", " ", 
       "sec", ",", " ", "es", ",", " ", "e0", ",", " ", "w", ",", " ", "fac", 
       ",", " ", 
       RowBox[{"col", " ", "=", " ", "0"}]}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"chChainHamiltonian", "[", 
        RowBox[{"delta", ",", " ", "p"}], "]"}]}], ";", " ", 
      RowBox[{"sec", " ", "=", " ", 
       RowBox[{"chMapSectors", "[", "n", "]"}]}], ";", "\n", "  ", 
      RowBox[{"es", " ", "=", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Eigensystem", "[", 
          RowBox[{"Normal", "[", 
           RowBox[{"h", "[", 
            RowBox[{"[", 
             RowBox[{"ix", ",", " ", "ix"}], "]"}], "]"}], "]"}], "]"}], ",", 
         " ", 
         RowBox[{"{", 
          RowBox[{"ix", ",", " ", "sec"}], "}"}]}], "]"}]}], ";", " ", 
      RowBox[{"e0", " ", "=", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"beta", ">=", "0"}], ",", "Min", ",", "Max"}], "]"}], "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"es", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", " ", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
      "\n", "  ", 
      RowBox[{"fac", " ", "=", " ", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "n"}], ",", " ", 
           RowBox[{"2", "^", "n"}]}], "}"}]}], "]"}]}], ";", "\n", "  ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"w", " ", "=", " ", 
          RowBox[{"Sqrt", "[", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "beta"}], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"es", "[", 
                RowBox[{"[", 
                 RowBox[{"k", ",", " ", "1"}], "]"}], "]"}], " ", "-", " ", 
               "e0"}], ")"}]}], "]"}], "]"}]}], ";", " ", 
         RowBox[{
          RowBox[{"fac", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"sec", "[", 
              RowBox[{"[", "k", "]"}], "]"}], ",", " ", 
             RowBox[{"col", " ", "+", " ", 
              RowBox[{"Range", "[", 
               RowBox[{"Length", "[", "w", "]"}], "]"}]}]}], "]"}], "]"}], 
          " ", "=", " ", 
          RowBox[{"Transpose", "[", 
           RowBox[{"w", " ", 
            RowBox[{"es", "[", 
             RowBox[{"[", 
              RowBox[{"k", ",", " ", "2"}], "]"}], "]"}]}], "]"}]}], ";", " ", 
         RowBox[{"col", " ", "+=", " ", 
          RowBox[{"Length", "[", "w", "]"}]}]}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", " ", 
          RowBox[{"Length", "[", "sec", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      "  ", 
      RowBox[{"fac", "/", 
       RowBox[{"Norm", "[", 
        RowBox[{"fac", ",", " ", "\"\<Frobenius\>\""}], "]"}]}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chMapTypicalFactor", "[", 
    RowBox[{"delta_", ",", " ", "p_Association", ",", " ", 
     RowBox[{"beta_", "?", "NumericQ"}], ",", " ", "nr_Integer", ",", " ", 
     RowBox[{"seed_Integer", " ", ":", " ", "1"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"n", " ", "=", " ", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", " ", "h", ",", " ", 
       "sec", ",", " ", "e0", ",", " ", "cols"}], "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"h", " ", "=", " ", 
       RowBox[{"chChainHamiltonian", "[", 
        RowBox[{"delta", ",", " ", "p"}], "]"}]}], ";", " ", 
      RowBox[{"sec", " ", "=", " ", 
       RowBox[{"chMapSectors", "[", "n", "]"}]}], ";", " ", 
      RowBox[{"e0", " ", "=", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"beta", ">=", "0"}], ",", 
          RowBox[{"-", "1"}], ",", "1"}], "]"}], " ", 
        RowBox[{"Norm", "[", 
         RowBox[{"h", ",", " ", "Infinity"}], "]"}]}]}], ";", "\n", "  ", 
      RowBox[{"cols", " ", "=", " ", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"hk", " ", "=", " ", 
                 RowBox[{
                  RowBox[{"h", "[", 
                   RowBox[{"[", 
                    RowBox[{"ix", ",", " ", "ix"}], "]"}], "]"}], " ", "-", 
                  " ", 
                  RowBox[{"e0", " ", 
                   RowBox[{"SparseArray", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Band", "[", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", " ", "1"}], "}"}], "]"}], " ", "->", 
                    " ", "1."}], ",", " ", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"Length", "[", "ix", "]"}], ",", " ", 
                    RowBox[{"Length", "[", "ix", "]"}]}], "}"}]}], 
                    "]"}]}]}]}], "}"}], ",", "\n", "       ", 
               RowBox[{"Table", "[", 
                RowBox[{
                 RowBox[{"Module", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"v", " ", "=", " ", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{
                    RowBox[{"0.", " ", "+", " ", 
                    RowBox[{"0.", " ", "I"}]}], ",", " ", 
                    RowBox[{"2", "^", "n"}]}], "]"}]}], "}"}], ",", "\n", 
                   "         ", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"v", "[", 
                    RowBox[{"[", "ix", "]"}], "]"}], " ", "=", " ", 
                    RowBox[{"MatrixExp", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"-", "beta"}], " ", 
                    RowBox[{"hk", "/", "2"}]}], ",", " ", 
                    RowBox[{
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"Length", "[", "ix", "]"}]}], "]"}], " ", "+", 
                    " ", 
                    RowBox[{"I", " ", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{
                    RowBox[{"NormalDistribution", "[", "]"}], ",", " ", 
                    RowBox[{"Length", "[", "ix", "]"}]}], "]"}]}]}]}], 
                    "]"}]}], ";", " ", "v"}]}], "]"}], ",", " ", 
                 RowBox[{"{", "nr", "}"}]}], "]"}]}], "]"}], ",", "\n", 
             "      ", 
