             "<>", "\"\<;\\\\quad \>\"", "<>", "\n", " ", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"axis", "==", "\"\<Delta\>\""}], 
               ",", "\"\<\\\\Delta\>\"", ",", "\"\<g\>\""}], "]"}], 
             "<>", "\"\<\\\\in[\>\"", "<>", 
             RowBox[{"texNumber", "[", 
              RowBox[{"First", "[", 
