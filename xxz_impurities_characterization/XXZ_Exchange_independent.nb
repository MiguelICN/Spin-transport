 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"splitCharge", "[", 
     RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
    " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"b", "=", 
         RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "e", ",", "v", ",", 
        "order", ",", "groups", ",", "label"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"e", ",", "v"}], "}"}], "=", 
        RowBox[{"Eigensystem", "[", 
         RowBox[{"N", "[", 
          RowBox[{"herm", "[", 
           RowBox[{
            RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", "q",
             " ", ".", " ", "b"}], "]"}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"order", "=", 
        RowBox[{"Ordering", "[", 
         RowBox[{"Re", "[", "e", " ", "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"e", "[", 
          RowBox[{"[", "order", " ", "]"}], "]"}], "]"}]}], ";", 
       RowBox[{"v", "=", 
        RowBox[{"v", "[", 
         RowBox[{"[", "order", " ", "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"Split", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "e", " ", "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"e", "[", 
               RowBox[{"[", "#1", " ", "]"}], "]"}], "-", 
              RowBox[{"e", "[", 
               RowBox[{"[", "#2", " ", "]"}], "]"}]}], "]"}], "<", "tol"}], 
           "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"label", "=", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "name"}], "]"}], ",", "\n", "   ", 
             RowBox[{"Round", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"-", "1"}], "+", 
                  RowBox[{"Sqrt", "[", 
                   RowBox[{"1", "+", 
                    RowBox[{"4", " ", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"e", "[", 
                    RowBox[{"[", "g", " ", "]"}], "]"}], "]"}]}]}], "]"}]}], 
                 ")"}], "/", "2"}], ",", 
               RowBox[{"1", "/", "2"}]}], "]"}], ",", 
             RowBox[{"Round", "[", 
              RowBox[{"Mean", "[", 
               RowBox[{"e", "[", 
                RowBox[{"[", "g", " ", "]"}], "]"}], "]"}], "]"}]}], "]"}]}], 
          ";", "\n", "  ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Basis\>\"", "->", 
             RowBox[{"b", " ", ".", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"Orthogonalize", "[", 
                RowBox[{"v", "[", 
                 RowBox[{"[", "g", " ", "]"}], "]"}], "]"}], "]"}]}]}], ",", 
            RowBox[{"\"\<Labels\>\"", "->", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "\n", "   ", 
               RowBox[{
                RowBox[{"Switch", "[", 
                 RowBox[{
                 "name", ",", "\"\<S2\>\"", ",", "\"\<S\>\"", 
                  ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredS\>\"", ",", 
                  "_", ",", "name"}], "]"}], "->", "label"}]}], "]"}]}]}], 
           "|>"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"g", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "Hamiltonian", " ", "is", " ", "real", " ", "symmetric"}], ";",
     " ", 
    RowBox[{"retain", " ", "real", " ", "packed", " ", 
     RowBox[{"vectors", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fixSign", "[", "v_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"w", "=", 
        RowBox[{"Re", "[", 
