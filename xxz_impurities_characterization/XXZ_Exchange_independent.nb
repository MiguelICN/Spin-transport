      RowBox[{"Developer`ToPackedArray", "[", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"w", "[", 
           RowBox[{"[", "k", " ", "]"}], "]"}], "<", "0"}], ",", 
         RowBox[{"-", "w"}], ",", "w"}], " ", "]"}], "]"}]}]}], "\n", "]"}]}],
   ";"}], "\n"}], "Code",
