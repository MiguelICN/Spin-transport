Cell[CellGroupData[{

Cell["  1.2 Fixed Delta: editable g scan  ", "Subsection",ExpressionUUID->"ad84fd3a-f2ff-fc4a-8325-10e1817713f5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"statGModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "8"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "5."}], ",", 
     RowBox[{"\"\<g\>\"", "->", "0.1"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGGrid", "=", 
   RowBox[{"N", "[", 
    RowBox[{"Subdivide", "[", 
     RowBox[{"0.01", ",", "0.5", ",", "500"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"statGPlotSettings", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<PlotChop\>\"", "->", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"\"\<MarkerSize\>\"", "->", "3"}], ",", 
      RowBox[{"\"\<SectorKeys\>\"", "->", "All"}]}], "|>"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"SectorKeys", "->", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sectorKey", "[", "labels", "]"}], ",", "..."}], "}"}], " ", 
      "limits", " ", 
      RowBox[{"plots", "/", "exports"}]}]}], ";", " ", 
    RowBox[{"all", " ", "eigenpairs", " ", "remain", " ", 
     RowBox[{"computed", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"statGOutputRoot", "=", 
   RowBox[{"resultRoot", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"statGRunLabel", "=", "\"\<Exchange_static_g\>\""}], ";"}]}], "Code",
 CellChangeTimes->{{4.0013868669365673`*^9, 4.001386867015911*^9}, {
   4.001387108587553*^9, 4.0013871086733913`*^9}, 4.0014607521706486`*^9},
 CellLabel->
  "In[135]:=",ExpressionUUID->"8a4d00fc-bdd4-8547-ac0f-f80382ea5ea6"],

Cell["\<\
  All other scans and dynamics may be skipped. Use any increasing real grid; \
zero g is rejected. At every point all 2^L eigenstates are retained as sector \
vectors with their computational index lists. Ranks are energy order at that \
point, not overlap-tracked branches.  \
\>", "Text",ExpressionUUID->"4d5430a2-6a68-e24a-b3e2-d105d5801f8d"]
}, Open  ]],

