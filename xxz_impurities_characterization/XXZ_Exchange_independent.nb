Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"evolve", "[", 
     RowBox[{"t_", ",", "engine_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "a", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"0.", "+", 
           RowBox[{"0.", "I"}]}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
            RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], " ", 
            "]"}], "]"}], "+=", 
          RowBox[{
           RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], " ", 
               RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}], " ", 
             RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], 
       ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Batch", " ", "matrix", " ", "products", " ", "over", " ", "time"}], ";", 
    " ", 
    RowBox[{
     RowBox[{"a", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "All", ",", "k"}], "]"}], "]"}], " ", "is", " ", 
     "the", " ", "kth", " ", 
     RowBox[{"factor", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"evolveBatch", "[", 
    RowBox[{"times_List", ",", "engine_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"a", ",", "ph"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"a", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"0.", "+", 
          RowBox[{"0.", "I"}]}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
           RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}], ",", 
           RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ph", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"-", "I"}], " ", 
            RowBox[{"Outer", "[", 
             RowBox[{"Times", ",", 
              RowBox[{"s", "[", "\"\<E\>\"", "]"}], ",", 
              RowBox[{"N", "[", "times", " ", "]"}]}], "]"}]}], "]"}]}], ";", 
         "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "c", ",", 
               "All"}], " ", "]"}], "]"}], "+=", 
            RowBox[{
             RowBox[{"s", "[", "\"\<V\>\"", "]"}], " ", ".", " ", 
             RowBox[{"(", 
              RowBox[{"ph", " ", 
               RowBox[{
                RowBox[{"s", "[", "\"\<C\>\"", "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "c"}], " ", "]"}], "]"}]}], ")"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"c", ",", 
             RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
          "]"}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"s", ",", 
          RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}], ";",
       "a"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",
 CellLabel->"In[73]:=",ExpressionUUID->"29e25ec9-9ae5-9a44-826a-11567107f103"],

