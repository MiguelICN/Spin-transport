Cell[BoxData[{
 RowBox[{
  RowBox[{"mapTimeUsed", "=", "mapTime"}], ";", 
  RowBox[{"mapTimes", "=", 
   RowBox[{"timeGrid", "[", "mapTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"mapSeconds", ",", "mapChannelRun"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"chTrajectory", "[", 
     RowBox[{
     "mapEngine", ",", "mapTimes", ",", "mapSettingsUsed", ",", 
      "mapProbesUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapRecords", "=", 
   RowBox[{"mapChannelRun", "[", "\"\<Records\>\"", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapPlotSnapshot", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Model\>\"", "->", "mapModelUsed"}], ",", 
     RowBox[{"\"\<TimeSettings\>\"", "->", "mapTimeUsed"}], ",", 
