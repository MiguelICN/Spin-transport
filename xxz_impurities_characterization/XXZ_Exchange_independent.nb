 RowBox[{
  RowBox[{
   RowBox[{"qstTicks", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lo_", ",", "hi_"}], "}"}], ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "v", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"v", "=", 
       RowBox[{"If", "[", 
        RowBox[{"log", ",", "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"0", "<", "lo", "<=", "hi"}], 
            ",", "\"\<Log ticks require a positive range.\>\""}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"10.", "^", 
             RowBox[{"Range", "[", 
              RowBox[{
               RowBox[{"Floor", "[", 
                RowBox[{"Log10", "[", "lo", "]"}], "]"}], ",", 
               RowBox[{"Ceiling", "[", 
                RowBox[{"Log10", "[", "hi", "]"}], "]"}]}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"lo", "<=", "#", "<=", "hi"}], "&"}]}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"lo", "==", "hi"}], ",", 
           RowBox[{"{", "lo", "}"}], ",", 
           RowBox[{"Subdivide", "[", 
            RowBox[{"lo", ",", "hi", ",", "4"}], "]"}]}], "]"}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"log", " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "v", "]"}], "<", "2"}]}], ",", 
        RowBox[{"v", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"lo", "==", "hi"}], ",", 
           RowBox[{"{", "lo", "}"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"Log", "[", "lo", "]"}], ",", 
              RowBox[{"Log", "[", "hi", "]"}], ",", "4"}], "]"}], "]"}]}], 
          "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{"log", ",", 
             RowBox[{"Log", "[", "#", "]"}], ",", "#"}], "]"}], ",", 
           RowBox[{"qstTex", "[", 
            RowBox[{
             RowBox[{"texNumber", "[", "#", "]"}], ",", "11"}], "]"}]}], 
          "}"}], "&"}], " ", "/@", " ", "v"}], ")"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
