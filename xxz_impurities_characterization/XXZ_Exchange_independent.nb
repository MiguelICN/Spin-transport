           RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
           "}"}]}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"curves", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
