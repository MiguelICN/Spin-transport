          RowBox[{"heights", " ", 
           RowBox[{"Differences", "[", "edges", "]"}]}], "]"}]}]}], 
       "|>"}]}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
