                "]"}], "<>", " ", "\"\<]\>\""}], ",", 
              " ", "\"\<\\\\text{one sampled parameter value}\>\""}], "]"}]}],
            "}"}]}], ",", 
         RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "\n", "]"}]}], 
   ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"One", " ", "panel", " ", "per", " ", "symmetry", " ", "orbit"}], 
