          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Max", "[", 
             RowBox[{"Last", " ", "/@", " ", 
              RowBox[{"Flatten", "[", 
               RowBox[{"finite", ",", "1"}], "]"}]}], "]"}]}], "]"}], "+", 
          RowBox[{".15", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Max", "[", 
              RowBox[{"Abs", "[", 
               RowBox[{"Last", " ", "/@", " ", 
                RowBox[{"Flatten", "[", 
                 RowBox[{"finite", ",", "1"}], "]"}]}], "]"}], "]"}]}], 
            "]"}]}]}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"bad", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"#", ",", 
           RowBox[{
            RowBox[{"Not", "[", 
             RowBox[{"realQ", "[", 
              RowBox[{"Last", "[", "#", "]"}], "]"}], "]"}], "&"}]}], "]"}], 
         "&"}], " ", "/@", " ", "curves"}]}], ";", "\n", " ", 
      RowBox[{"badIds", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"Range", "[", 
          RowBox[{"Length", "[", "keys", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"bad", "[", 
            RowBox[{"[", "#", "]"}], "]"}], "=!=", 
           RowBox[{"{", "}"}]}], "&"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"allcurves", "=", 
       RowBox[{"Join", "[", 
        RowBox[{"finite", ",", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"First", "[", "#", "]"}], ",", "rail"}], "}"}], 
               "&"}], " ", "/@", " ", "#"}], ")"}], "&"}], ",", 
           RowBox[{"bad", "[", 
            RowBox[{"[", "badIds", "]"}], "]"}]}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{"log", ",", 
        RowBox[{"allcurves", "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"First", "[", "#", "]"}], "]"}], ",", 
              RowBox[{"Last", "[", "#", "]"}]}], "}"}], "&"}], ",", 
           "allcurves", ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"styles", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", 
          RowBox[{"Range", "[", 
           RowBox[{"Length", "[", "keys", "]"}], "]"}]}], ",", 
         RowBox[{
          RowBox[{"ColorData", "[", "97", "]"}], " ", "/@", " ", "badIds"}]}],
         "]"}]}], ";", "\n", " ", 
      RowBox[{"markers", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Switch", "[", 
              RowBox[{
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"k", "-", "1"}], ",", "3"}], "]"}], ",", "0", 
               ",", "\"\<\[FilledCircle]\>\"", ",", "1", 
               ",", "\"\<\[EmptyCircle]\>\"", ",", "2", 
               ",", "\"\<\[Times]\>\""}], "]"}], ",", "3"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}], ",", 
         "\n", "  ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<\[EmptyUpTriangle]\>\"", ",", "7"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"Length", "[", "badIds", "]"}], "}"}]}], "]"}]}], "]"}]}],
       ";", "\n", " ", 
      RowBox[{"legend", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"qstTex", "[", 
            RowBox[{"#", ",", "11"}], "]"}], "&"}], " ", "/@", " ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"labels", "===", "Automatic"}], ",", 
            RowBox[{"observableLabel", " ", "/@", " ", "keys"}], ",", 
            "labels"}], "]"}]}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"qstTex", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"observableLabel", "[", 
               RowBox[{"keys", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "]"}], 
              "<>", "\"\<\\\\;(\\\\mathrm{singular/invalid})\>\""}], ",", 
             "10"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "badIds"}], "}"}]}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"yr", "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"Last", " ", "/@", " ", 
         RowBox[{"Flatten", "[", 
          RowBox[{"allcurves", ",", "1"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "yr", "]"}], "==", 
         RowBox[{"Last", "[", "yr", "]"}]}], ",", 
        RowBox[{"yr", "+=", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"-", ".05"}], ",", ".05"}], "}"}], " ", 
          RowBox[{"Max", "[", 
           RowBox[{"1.", ",", 
            RowBox[{"Abs", "[", 
             RowBox[{"First", "[", "yr", "]"}], "]"}]}], "]"}]}]}]}], "]"}], ";",
       "\n", " ", 
      RowBox[{"xr", "=", 
       RowBox[{"MinMax", "[", 
        RowBox[{"Lookup", "[", 
         RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}], "]"}]}], ";", "\n",
       " ", 
      RowBox[{"g", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"allcurves", ",", 
         RowBox[{"Joined", "->", "False"}], ",", 
         RowBox[{"PlotStyle", "->", "styles"}], ",", 
         RowBox[{"PlotMarkers", "->", "markers"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", "\n", "  ", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"qstTex", "[", "\"\<t\>\"", "]"}], ",", 
            RowBox[{"qstTex", "[", "ylabel", "]"}]}], "}"}]}], ",", 
         RowBox[{"FrameTicks", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"qstTicks", "[", "yr", "]"}], ",", "None"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"qstTicks", "[", 
               RowBox[{"xr", ",", "log"}], "]"}], ",", "None"}], "}"}]}], 
           "}"}]}], ",", "\n", "  ", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"ImageSize", "->", "1100"}], ",", 
         RowBox[{"AspectRatio", "->", ".52"}], ",", 
         RowBox[{"ImagePadding", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"140", ",", "40"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"100", ",", "50"}], "}"}]}], "}"}]}], ",", 
         RowBox[{"FrameStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", 
            RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"PointLegend", "[", 
             RowBox[{"styles", ",", "legend", ",", 
              RowBox[{"LegendMarkers", "->", "markers"}]}], "]"}], ",", 
            "Below"}], "]"}]}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"bad", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=!=", 
           RowBox[{"{", "}"}]}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"notes", ",", 
            RowBox[{
             RowBox[{"keys", "[", 
              RowBox[{"[", "k", "]"}], "]"}], 
             "<>", "\"\< rail marks (actual values retained): \>\"", "<>", 
             RowBox[{"ToString", "[", 
              RowBox[{
               RowBox[{"bad", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", "InputForm"}], "]"}]}]}],
            "]"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", "keys", "]"}]}], "}"}]}], "]"}], ";", "\n", 
      " ", 
      RowBox[{"excluded", "=", 
       RowBox[{"If", "[", 
        RowBox[{"log", ",", 
         RowBox[{"Select", "[", 
          RowBox[{"records", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<Time\>\"", "]"}], "<=", "0"}], "&"}]}], 
          "]"}], ",", 
         RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"excluded", "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"notes", ",", 
          
          RowBox[{"\"\<Log-time panel excludes t<=0 only; omitted values: \
\>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"KeyTake", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"Prepend", "[", 
                  RowBox[{"keys", ",", "\"\<Time\>\""}], "]"}]}], "]"}], 
               "&"}], " ", "/@", " ", "excluded"}], ",", "InputForm"}], 
            "]"}]}]}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Column", "[", 
       RowBox[{
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"qstCaption", "[", "snap", "]"}], ",", "g"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"#", ",", "10"}], "]"}], "&"}], " ", "/@", " ", 
           "notes"}]}], "]"}], ",", 
        RowBox[{"Alignment", "->", "Center"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"256f1e75-6d81-4c48-bc9f-\
edfdd26c7ff9"],

