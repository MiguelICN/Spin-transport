        RowBox[{"eng", "[", "\"\<L\>\"", "]"}]}], ",", "rec", ",", "pauli", ",",
        "axes", ",", "ra", ",", "rb", ",", "rr", ",", "ma", ",", "mb", ",", 
       "c", ",", "extra", ",", "cur"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"rec", "=", 
