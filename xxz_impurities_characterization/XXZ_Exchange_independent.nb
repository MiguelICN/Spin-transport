Cell[BoxData[{
 RowBox[{
  RowBox[{"mapPlotsUsed", "=", 
   RowBox[{"chPlots", "[", 
    RowBox[{
    "mapRecords", ",", "mapPlotSnapshot", ",", "mapLogHorizontalAxis"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"mapPlotsUsed", "[", "\"\<MapEntropy\>\"", "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"dd1c64a6-aa95-d14b-816c-\
86455c6ee26c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["  3.8 Export this independent map run  ", "Subsection",ExpressionUUID->"a8cee21a-c3d6-2a4d-8405-559dc55e114c"],

