Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"texturePanels", "[", 
     RowBox[{"records_", ",", "short_", ",", "snap_", ",", "shortSnap_", ",", 
      RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"out", ",", 
        RowBox[{"pairs", "=", 
         RowBox[{"Subsets", "[", 
          RowBox[{
           RowBox[{"Range", "[", "4", "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "rr", ",", "keys"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"out", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"spec", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{"qstPanel", "[", 
             RowBox[{"records", ",", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", "snap", ",", "log"}], 
             "]"}]}], ",", "\n", " ", 
           RowBox[{"{", 
            RowBox[{"spec", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<GrandSums\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<SigmaAB\>\"", ",", "\"\<SigmaA\>\"", 
                   ",", "\"\<SigmaB\>\""}], "}"}], ",", "\"\<\\\\Sigma\>\""}],
                 "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<TextureF\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<TextureFAB\>\"", ",", "\"\<TextureFA\>\"", 
                   ",", "\"\<TextureFB\>\""}], "}"}], ",", "\"\<T_F\>\""}], 
                "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Rugosity\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<RugosityAB\>\"", ",", "\"\<RugosityA\>\"", 
                   ",", "\"\<RugosityB\>\""}], "}"}], ",", "\"\<R\>\""}], 
                "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Nonmultiplicativity\>\"", ",", 
                 RowBox[{"{", "\"\<Nonmultiplicativity\>\"", "}"}], 
                 ",", "\"\<\\\\Sigma_{AB}-\\\\Sigma_A\\\\Sigma_B\>\""}], 
                "}"}], ",", "\n", " ", 
               RowBox[{"{", 
                RowBox[{"\"\<Comparison\>\"", ",", 
                 RowBox[{"{", 
                  
                  RowBox[{"\"\<TextureFAB\>\"", ",", "\"\<L1Normalized\>\"", 
                   ",", "\"\<LinearEntropy\>\"", 
                   ",", "\"\<NormalizedEntropy\>\""}], "}"}], 
                 ",", "\"\<\\\\mathrm{comparison}\>\""}], "}"}]}], "}"}]}], 
            "}"}]}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"keys", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"part", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], "]"}], "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], "]"}]}], "&"}], 
             " ", "/@", " ", "pairs"}], ")"}]}], ";", "\n", "  ", 
          RowBox[{"rr", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{"Function", "[", 
              RowBox[{"r", ",", 
               RowBox[{"Join", "[", 
                RowBox[{"r", ",", 
                 RowBox[{"Association", "[", 
                  RowBox[{"MapThread", "[", 
                   RowBox[{"Rule", ",", 
                    RowBox[{"{", 
                    RowBox[{"keys", ",", "\n", "    ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"part", "==", "\"\<Re\>\""}], ",", "Re", ",", 
                    "Im"}], "]"}], "[", 
                    RowBox[{
                    RowBox[{"r", "[", "\"\<RhoAB\>\"", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
                    "&"}], " ", "/@", " ", "pairs"}], ")"}]}], "}"}]}], "]"}],
                   "]"}]}], "]"}]}], "]"}], ",", "records"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{"\"\<Coherences_\>\"", "<>", "part"}], "->", 
             RowBox[{"qstPanel", "[", 
              RowBox[{"rr", ",", "keys", ",", 
               
               RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
                "<>", "\"\<}\\\\rho_{ab}\>\""}], ",", "snap", ",", "log", ",", 
               RowBox[{"Table", "[", 
                RowBox[{
                 
                 RowBox[{"\"\<\\\\operatorname{\>\"", "<>", "part", 
                  "<>", "\"\<}\\\\rho_{\>\"", "<>", 
                  RowBox[{"IntegerString", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ",", "2", ",",
                     "2"}], "]"}], "<>", "\"\<,\>\"", "<>", 
                  RowBox[{"IntegerString", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"pair", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], "-", "1"}], ",", "2", ",",
                     "2"}], "]"}], "<>", "\"\<}\>\""}], ",", 
                 RowBox[{"{", 
                  RowBox[{"pair", ",", "pairs"}], "}"}]}], "]"}]}], "]"}]}]}],
            "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"part", ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\""}], "}"}]}], "}"}]}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"out", ",", 
         RowBox[{"\"\<ShortTimeSigma\>\"", "->", 
          RowBox[{"qstPanel", "[", 
           RowBox[{"short", ",", 
            RowBox[{"{", "\"\<SigmaAB\>\"", "}"}], 
            ",", "\"\<\\\\Sigma_{AB}\>\"", ",", "shortSnap", ",", "log"}], 
           "]"}]}]}], "]"}], ";", "out"}]}], "\n", "]"}]}], ";"}], 
  "\n"}]], "Code",ExpressionUUID->"7a9e08b7-a81b-dc4b-846c-dc8aac150c0b"],

