 RowBox[{
  RowBox[{
   RowBox[{"regimeSetup", "[", 
    RowBox[{"p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"pp", "=", 
        RowBox[{"regimeModel", "[", "p", "]"}]}], ",", "geo", ",", "parts", ",",
        "h", ",", "parents", ",", 
       RowBox[{"spaces", "=", 
        RowBox[{"{", "}"}]}], ",", "ids", ",", "other", ",", "hm", ",", "qq", 
       ",", "extra", ",", "children", ",", "groups", ",", "all", ",", "b", ",", 
       RowBox[{"basisError", "=", "0."}], ",", 
       RowBox[{"leak", "=", "0."}], ",", "scale"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"geo", "=", 
       RowBox[{"geometryParameters", "[", "pp", "]"}]}], ";", 
      RowBox[{"parts", "=", 
       RowBox[{"regimeParts", "[", "pp", "]"}]}], ";", "\n", " ", 
      RowBox[{"h", "=", 
       RowBox[{"SparseArray", "[", 
        RowBox[{
         RowBox[{"parts", "[", "\"\<Bulk\>\"", "]"}], "+", 
         RowBox[{
          RowBox[{"pp", "[", "\"\<g\>\"", "]"}], " ", 
          RowBox[{"parts", "[", "\"\<Interaction\>\"", "]"}]}]}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"realSectorCheck", "[", 
       RowBox[{"h", ",", 
        RowBox[{"pp", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}], ";", "\n",
       " ", 
      RowBox[{"parents", "=", 
       RowBox[{"regimeParentSpaces", "[", 
        RowBox[{
         RowBox[{"pp", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ids", "=", 
          RowBox[{"parent", "[", "\"\<Indices\>\"", "]"}]}], ";", "\n", "  ", 
         RowBox[{"children", "=", 
          RowBox[{"{", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Basis\>\"", "->", 
              RowBox[{"parent", "[", "\"\<Basis\>\"", "]"}]}], ",", 
             RowBox[{"\"\<Labels\>\"", "->", 
              RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], 
           "}"}]}], ";", "\n", "  ", "\n", "  ", 
         RowBox[{"spaces", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"spaces", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{"#", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", 
                  RowBox[{"\"\<ParentLabels\>\"", "->", 
                   RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], 
                 "|>"}]}], "]"}], "&"}], " ", "/@", " ", "children"}]}], 
           "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"parent", ",", "parents"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"groups", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"spaces", ",", 
         RowBox[{
          RowBox[{"#", "[", "\"\<Indices\>\"", "]"}], "&"}]}], "]"}]}], ";", 
      RowBox[{"all", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "#", "]"}], "[", "\"\<Indices\>\"", "]"}], 
          "&"}], " ", "/@", " ", "groups"}], "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Sort", "[", "all", "]"}], "===", 
         RowBox[{"Range", "[", 
          RowBox[{"2", "^", 
           RowBox[{"pp", "[", "\"\<L\>\"", "]"}]}], "]"}]}], 
        ",", "\"\<Computational blocks do not partition the full \
space.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ids", "=", 
          RowBox[{
           RowBox[{"First", "[", "group", "]"}], "[", "\"\<Indices\>\"", 
           "]"}]}], ";", 
         RowBox[{"other", "=", 
          RowBox[{"Complement", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", "^", 
              RowBox[{"pp", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "ids"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"b", "=", 
          RowBox[{"Transpose", "[", 
           RowBox[{"Join", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"Transpose", "[", 
                RowBox[{"#", "[", "\"\<Basis\>\"", "]"}], "]"}], "&"}], " ", "/@",
               " ", "group"}], ")"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Dimensions", "[", "b", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Length", "[", "ids", "]"}], ",", 
              RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], 
           ",", "\"\<Incomplete symmetry basis.\>\""}], "]"}], ";", "\n", 
         "  ", 
         RowBox[{"basisError", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"basisError", ",", 
            RowBox[{"maxAbs", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
               "b"}], "-", 
              RowBox[{"id", "[", 
               RowBox[{"Length", "[", "ids", "]"}], "]"}]}], "]"}]}], "]"}]}],
          ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"scale", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"Norm", "[", 
                RowBox[{"part", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
            "\n", "   ", 
            RowBox[{"leak", "=", 
             RowBox[{"Max", "[", 
              RowBox[{"leak", ",", 
               RowBox[{
                RowBox[{"maxAbs", "[", 
                 RowBox[{"part", "[", 
                  RowBox[{"[", 
                   RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "/", 
                "scale"}]}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"hm", "=", 
             RowBox[{"N", "[", 
              RowBox[{"Normal", "[", 
               RowBox[{"part", "[", 
                RowBox[{"[", 
                 RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
             "\n", "   ", 
            RowBox[{"Do", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"b", "=", 
                RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
               RowBox[{"leak", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{"leak", ",", 
                  RowBox[{
                   RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{"hm", " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", 
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                    " ", "hm", " ", ".", " ", "b"}], ")"}]}]}], "]"}], "/", 
                   "scale"}]}], "]"}]}]}], ",", 
              RowBox[{"{", 
               RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", "\n", 
           "   ", 
           RowBox[{"{", 
            RowBox[{"part", ",", 
             RowBox[{"Values", "[", "parts", "]"}]}], "}"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"basisError", ",", "leak"}], "]"}], "<", 
         RowBox[{"100", " ", "tol"}]}], 
        ",", "\"\<Sector completeness/invariance audit failed.\>\""}], "]"}], 
      ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Parameters\>\"", "->", "pp"}], ",", 
        RowBox[{"\"\<Hamiltonian\>\"", "->", "h"}], ",", 
        RowBox[{"\"\<Spaces\>\"", "->", "spaces"}], ",", "\n", "  ", 
        RowBox[{"\"\<Audit\>\"", "->", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Passed\>\"", "->", "True"}], ",", 
           RowBox[{"\"\<DimensionSum\>\"", "->", 
            RowBox[{"Total", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Dimensions", "[", 
                 RowBox[{"#", "[", "\"\<Basis\>\"", "]"}], "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}], "&"}], " ", "/@", " ", 
              "spaces"}], "]"}]}], ",", "\n", "   ", 
           RowBox[{"\"\<BasisError\>\"", "->", "basisError"}], ",", 
           RowBox[{"\"\<RelativeLeakage\>\"", "->", "leak"}]}], "|>"}]}], ",", 
        RowBox[{"\"\<ParameterNote\>\"", "->", 
         RowBox[{"parameterNote", "[", "pp", "]"}]}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sectorKey", "[", "a_Association", "]"}], " ", ":=", " ", 
   RowBox[{"ToString", "[", 
    RowBox[{
     RowBox[{"Normal", "[", 
      RowBox[{"KeySort", "[", "a", "]"}], "]"}], ",", "InputForm"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"regimeED", "[", 
    RowBox[{"p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"setup", "=", 
        RowBox[{"regimeSetup", "[", 
         RowBox[{"p", ",", "tol"}], "]"}]}], ",", "out"}], "}"}], ",", "\n", 
     " ", 
     RowBox[{
      RowBox[{"out", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{"Function", "[", 
          RowBox[{"s", ",", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"diagonalizeBlock", "[", 
              RowBox[{"s", ",", 
               RowBox[{"N", "[", 
                RowBox[{"Normal", "[", 
                 RowBox[{
                  RowBox[{"setup", "[", "\"\<Hamiltonian\>\"", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<Indices\>\"", "]"}]}], "]"}], 
                  "]"}], "]"}], "]"}], ",", 
               RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "tol"}], 
              "]"}], ",", "\n", "  ", 
             RowBox[{"<|", 
              RowBox[{"\"\<ParentLabels\>\"", "->", 
               RowBox[{"s", "[", "\"\<ParentLabels\>\"", "]"}]}], "|>"}]}], 
            "]"}]}], "]"}], ",", 
         RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}]}], "]"}]}], ";", "\n", 
      " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
         RowBox[{"2", "^", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], 
        ",", "\"\<Incomplete eigensystem.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Parameters\>\"", "->", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Hamiltonian\>\"", "->", 
         RowBox[{"setup", "[", "\"\<Hamiltonian\>\"", "]"}]}], ",", 
        RowBox[{"\"\<Sectors\>\"", "->", "out"}], ",", "\n", "  ", 
        RowBox[{"\"\<DimensionSum\>\"", "->", 
         RowBox[{"Total", "[", 
          RowBox[{"Lookup", "[", 
           RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}]}], ",", 
        RowBox[{"\"\<Audit\>\"", "->", 
         RowBox[{"setup", "[", "\"\<Audit\>\"", "]"}]}], ",", 
        RowBox[{"\"\<ParameterNote\>\"", "->", 
         RowBox[{"setup", "[", "\"\<ParameterNote\>\"", "]"}]}]}], "|>"}]}]}],
     "\n", "]"}]}], ";"}], "\n"}], "Code",
