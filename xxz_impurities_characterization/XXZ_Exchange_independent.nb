Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"t", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "0.", "}"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"Subdivide", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}],
                "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "=", 
           RowBox[{"N", "[", 
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], ",",
          "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n"}]], "Code",
 CellLabel->"In[78]:=",ExpressionUUID->"00ec12b4-bb02-544f-be13-868697819b0b"]
