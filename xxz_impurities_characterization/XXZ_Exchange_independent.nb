 RowBox[{
  RowBox[{
   RowBox[{"gapPanel", "[", 
    RowBox[{"rows_", ",", "run_", ",", 
     RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"valid", ",", "points", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"valid", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"rows", ",", 
         RowBox[{
          RowBox[{"NumericQ", "[", 
           RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], "]"}], "&"}]}], "]"}]}], 
      ";", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"valid", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Column", "[", 
          RowBox[{"{", 
           RowBox[{"tex", "[", 
            
            RowBox[{"\"\<\\\\text{No eligible mean: inspect dimensions, \
sample counts and unresolved gaps.}\>\"", ",", "18"}], "]"}], "}"}], "]"}], 
         "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"!", "log"}], " ", "||", " ", 
         RowBox[{"AllTrue", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"valid", ",", "\"\<Parameter\>\""}], "]"}], ",", 
           RowBox[{
            RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], 
        ",", "\"\<A logarithmic horizontal axis requires positive \
samples.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"points", "=", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{"log", ",", 
              RowBox[{"Log", "[", 
               RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}], "]"}], ",", 
              RowBox[{"#", "[", "\"\<Parameter\>\"", "]"}]}], "]"}], ",", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"NumericQ", "[", 
               RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}], "]"}], ",", 
              RowBox[{"Around", "[", 
               RowBox[{
                RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}], ",", 
                RowBox[{"#", "[", "\"\<BlockSEM\>\"", "]"}]}], "]"}], ",", 
              RowBox[{"#", "[", "\"\<MeanR\>\"", "]"}]}], "]"}]}], "}"}], 
          "&"}], " ", "/@", " ", "valid"}], ")"}]}], ";", "\n", " ", 
      RowBox[{"g", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{"points", ",", 
         RowBox[{"Joined", "->", "False"}], ",", 
         RowBox[{"PlotStyle", "->", "Blue"}], ",", 
         RowBox[{"PlotMarkers", "->", 
          RowBox[{"{", 
           RowBox[{"Automatic", ",", "3"}], "}"}]}], ",", 
         RowBox[{"IntervalMarkers", "->", "\"\<Bars\>\""}], ",", "\n", "  ", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
