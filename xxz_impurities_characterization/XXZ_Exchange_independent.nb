              RowBox[{
               RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
           "]"}]}], ",", "\"\<Invalid local spinor.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"v", "=", 
