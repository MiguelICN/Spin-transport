       RowBox[{"tol", "=", 
        RowBox[{"settings", "[", "\"\<ValidationTolerance\>\"", "]"}]}], ",", 
       "zero", ",", "checks"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"zero", "=", 
