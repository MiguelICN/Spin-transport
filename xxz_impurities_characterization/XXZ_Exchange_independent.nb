 RowBox[{
  RowBox[{
   RowBox[{"qstRandomResponseCheck", "[", 
    RowBox[{"records_", ",", "count_", ",", "seed_", ",", "tol_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"states", ",", "selected", ",", "err"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"IntegerQ", "[", "count", "]"}], " ", "&&", " ", 
         RowBox[{"count", ">", "0"}], " ", "&&", " ", 
         RowBox[{"IntegerQ", "[", "seed", "]"}]}], 
        ",", "\"\<Random test count must be positive; seed must be an \
integer.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"states", "=", 
       RowBox[{"BlockRandom", "[", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "seed", "]"}], ";", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"a", "=", 
               RowBox[{
                RowBox[{"RandomReal", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", "4"}], "}"}]}], "]"}], "+", 
                RowBox[{"I", " ", 
                 RowBox[{"RandomReal", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}]}]}], "}"}], ",",
              "\n", "  ", 
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"r", "=", 
                 RowBox[{"a", " ", ".", " ", 
                  RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], "}"}], ",", 
               RowBox[{"r", "/", 
                RowBox[{"Tr", "[", "r", "]"}]}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", "count", "}"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
      RowBox[{"selected", "=", 
       RowBox[{"records", "[", 
        RowBox[{"[", 
         RowBox[{"DeleteDuplicates", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"Ceiling", "[", 
             RowBox[{
              RowBox[{"Length", "[", "records", "]"}], "/", "2"}], "]"}], ",", 
            RowBox[{"Length", "[", "records", "]"}]}], "}"}], "]"}], "]"}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"err", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"rec", "[", "\"\<ResponseOperator\>\"", "]"}], " ", ".",
                " ", "r"}], "]"}], "-", 
             RowBox[{"grandSum", "[", 
              RowBox[{"applyTransfer", "[", 
               RowBox[{
                RowBox[{"rec", "[", "\"\<Transfer\>\"", "]"}], ",", "r"}], 
               "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"rec", ",", "selected"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"r", ",", "states"}], "}"}]}], "]"}], "]"}], "]"}]}], ";",
       "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"err", "<", "tol"}], 
        ",", "\"\<Random-input response-operator validation failed.\>\""}], 
       "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Count\>\"", "->", "count"}], ",", 
        RowBox[{"\"\<Seed\>\"", "->", "seed"}], ",", 
        RowBox[{"\"\<Times\>\"", "->", 
         RowBox[{"Lookup", "[", 
          RowBox[{"selected", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{"\"\<MaxError\>\"", "->", "err"}]}], "|>"}]}]}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstCompare", "[", 
    RowBox[{"a_", ",", "b_", ",", "ar_", ",", "br_", ",", "tol_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"err", ",", "matrixError"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"SameQ", "[", 
         RowBox[{
          RowBox[{"KeyTake", "[", 
           RowBox[{"a", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
              ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
              ",", "\"\<Settings\>\""}], "}"}]}], "]"}], ",", "\n", "  ", 
          RowBox[{"KeyTake", "[", 
           RowBox[{"b", ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<Model\>\"", ",", "\"\<BulkSpecification\>\"", 
              ",", "\"\<BulkFactor\>\"", ",", "\"\<Times\>\"", 
              ",", "\"\<Settings\>\""}], "}"}]}], "]"}]}], "]"}], ",", "\n", 
        "  ", "\"\<A/B comparison refused: computed model, bulk, grid or \
numerical settings differ.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "ar", "]"}], "==", 
          RowBox[{"Length", "[", "br", "]"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "ar", "]"}], "==", 
          RowBox[{"Length", "[", 
           RowBox[{"a", "[", "\"\<Times\>\"", "]"}], "]"}]}], " ", "&&", "\n",
          "  ", 
         RowBox[{"SameQ", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"ar", ",", "\"\<Time\>\""}], "]"}], ",", 
           RowBox[{"Lookup", "[", 
            RowBox[{"br", ",", "\"\<Time\>\""}], "]"}], ",", 
           RowBox[{"a", "[", "\"\<Times\>\"", "]"}]}], "]"}]}], 
        ",", "\"\<A/B comparison refused: record times do not match the used \
snapshots.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"err", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"ar", ",", "\"\<SigmaAB\>\""}], "]"}], "-", 
         RowBox[{"Lookup", "[", 
          RowBox[{"br", ",", "\"\<SigmaOutput\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"matrixError", "=", 
       RowBox[{"maxAbs", "[", 
        RowBox[{
         RowBox[{"Lookup", "[", 
          RowBox[{"ar", ",", "\"\<RhoAB\>\""}], "]"}], "-", 
         RowBox[{"Lookup", "[", 
          RowBox[{"br", ",", "\"\<OutputF1\>\""}], "]"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Max", "[", 
          RowBox[{"err", ",", "matrixError"}], "]"}], "<", "tol"}], 
        ",", "\"\<Independent A/B edge matrices or grand sums \
disagree.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<MaxSigmaError\>\"", "->", "err"}], ",", 
        RowBox[{"\"\<MaxMatrixError\>\"", "->", "matrixError"}], ",", 
        RowBox[{"\"\<Tolerance\>\"", "->", "tol"}], ",", 
        RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", "]"}]}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"qstEdgeConservationError", "[", "p_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"h", "=", 
        RowBox[{"N", "[", 
         RowBox[{"regimeHamiltonian", "[", "p", "]"}], "]"}]}], ",", "z"}], 
      "}"}], ",", "\n", " ", 
     RowBox[{"Max", "[", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"z", "=", 
          RowBox[{"siteOp", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "j", ",", 
            RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
         RowBox[{"maxAbs", "[", 
          RowBox[{
           RowBox[{"h", " ", ".", " ", "z"}], "-", 
           RowBox[{"z", " ", ".", " ", "h"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "}"}]}], "}"}]}], "]"}], 
      "]"}]}], "\n", "]"}]}], ";"}], "\n"}], "Code",ExpressionUUID->"231d109a-\
78cf-394e-9d85-06d3abea6007"]
