Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"entropy", "[", "r_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"e", "=", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"N", "[", 
             RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"#", ">", "0"}], "&"}]}], "]"}]}], "}"}], ",", "\n", " ", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"e", "===", 
         RowBox[{"{", "}"}]}], ",", "0.", ",", 
        RowBox[{"-", 
         RowBox[{"Total", "[", 
          RowBox[{"e", " ", 
