Cell[CellGroupData[{

Cell["\<\
  1.10 Optional DOS inspection before choosing a gap-ratio rank window  \
\>", "Subsection",ExpressionUUID->"5c00a23c-4bc3-1a47-b770-904b5c3f255c"],

Cell["\<\
  This postprocessing section uses one completed static scan of your choice. \
It never merges distinct symmetry sectors. Inspect normalized DOS and \
empirical CDF first, then edit diagRankWindow and rerun the diagnostic cells. \
The orange lines show the actual rank-window energy boundaries; a rank \
fraction is not an energy fraction. This section does not affect either \
dynamics chapter.  \
\>", "Text",ExpressionUUID->"978cb5c1-bba7-eb4c-a5bf-150a64b31763"],

Cell[BoxData[""], "Input",ExpressionUUID->"5898d8de-953a-7c4f-b2bb-7ff07e2b16de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"diagRun", "=", "statGRun"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Or", " ", 
    RowBox[{"statDeltaRun", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagSector", "=", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<m\>\"", "->", "0"}], ",", 
      RowBox[{"\"\<R\>\"", "->", "1"}], ",", 
      RowBox[{"\"\<F\>\"", "->", "1"}]}], "|>"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagRankWindow", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"1", "/", "4"}], ",", 
      RowBox[{"3", "/", "4"}]}], "}"}]}], ";", 
   RowBox[{"diagBins", "=", "30"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagGapResolution", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "10"}]}]}], ";", 
   RowBox[{"diagBlockLength", "=", "10"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagMinimumDimension", "=", "500"}], ";", 
   RowBox[{"diagMinimumRatios", "=", "100"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagLogHorizontalAxis", "=", "False"}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagSampleIndices", "=", 
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"Ceiling", "[", 
        RowBox[{
         RowBox[{"Length", "[", 
          RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}], "/", "2"}], 
        "]"}], ",", 
       RowBox[{"Length", "[", 
        RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "]"}]}], "}"}], 
     "]"}]}], ";"}]}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagOutputRoot", "=", 
    RowBox[{"resultRoot", "[", "]"}]}], ";", 
   RowBox[{"diagRunLabel", "=", "\"\<Exchange_spectral_diagnostics\>\""}], 
   ";"}]}], "\n"}], "Code",ExpressionUUID->"18145763-c3fa-074a-8b3f-\
5160d13e3e9f"],

Cell[BoxData[""], "Input",ExpressionUUID->"ce1d48d0-a1b6-2743-b751-858cdb699e79"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagDOS", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"With", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"p", "=", 
          RowBox[{
           RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"s", "=", 
          RowBox[{"selectedStaticSector", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"diagRun", "[", "\"\<Points\>\"", "]"}], "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "diagSector"}], "]"}]}]}], 
        "}"}], ",", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<PointIndex\>\"", "->", "k"}], ",", 
         RowBox[{"\"\<Model\>\"", "->", 
          RowBox[{"p", "[", "\"\<Parameters\>\"", "]"}]}], ",", 
         RowBox[{"\"\<Labels\>\"", "->", 
          RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
         RowBox[{"\"\<DOS\>\"", "->", 
          RowBox[{"sectorDOS", "[", 
           RowBox[{
            RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
            "diagRankWindow", ",", "diagBins"}], "]"}]}]}], "|>"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "diagSampleIndices"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"diagDOSPlots", "=", 
    RowBox[{"Association", "[", 
     RowBox[{"Flatten", "[", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"KeyValueMap", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#1", "<>", "\"\<_sector_\>\"", "<>", 
               RowBox[{"staticSectorSlug", "[", 
                RowBox[{"row", "[", "\"\<Labels\>\"", "]"}], "]"}], 
               "<>", "\"\<_point_\>\"", "<>", 
               RowBox[{"ToString", "[", 
                RowBox[{"row", "[", "\"\<PointIndex\>\"", "]"}], "]"}]}], 
              ")"}], "->", "#2"}], "&"}], ",", "\n", " ", 
           RowBox[{"dosPanels", "[", 
            RowBox[{
             RowBox[{"row", "[", "\"\<DOS\>\"", "]"}], ",", 
             RowBox[{"row", "[", "\"\<Model\>\"", "]"}], ",", 
             RowBox[{"row", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"row", ",", "diagDOS"}], "}"}]}], "]"}], ",", "1"}], "]"}], 
     "]"}]}], ";"}]}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"First", "[", 
    RowBox[{"Values", "[", "diagDOSPlots", "]"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"1cb972d0-e03f-f34a-8a6d-\
f7f7fd1d213f"],

Cell["\<\
  The L=8 static defaults are small demonstrations: their default ZZ/exchange \
windows contain only 4/11 ratios. The gap mean is withheld below \
diagMinimumDimension=500 or diagMinimumRatios=100. DOS remains available. For \
quantitative work select a sufficiently large resolved sector and recompute \
its spectrum; inspect the actual dimension and error estimate. Reducing these \
thresholds deliberately is a demonstration, not evidence of a crossover.  \
\>", "Text",ExpressionUUID->"6465fb4f-ab2f-9c44-8fe8-656c65a45e15"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
  1.11 Optional gap-ratio calculation and export after DOS inspection  \
\>", "Subsection",ExpressionUUID->"93e3678c-d22a-3047-99bc-2e833ec1d467"],

Cell[BoxData[""], "Input",ExpressionUUID->"6495417b-d51a-7842-acd7-938e06f3fa58"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"diagDOS", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<DOS\>\"", "]"}], "[", "\"\<RankWindow\>\"", 
         "]"}], "===", "diagRankWindow"}], "&"}]}], "]"}], ",", "\n", 
    " ", "\"\<RankWindow changed: rerun the DOS data/plot cell to refresh the \
displayed boundaries first.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"diagGapRows", "=", 
   RowBox[{"gapScan", "[", 
    RowBox[{
    "diagRun", ",", "diagSector", ",", "diagRankWindow", ",", 
     "diagGapResolution", ",", "diagBlockLength", ",", "diagMinimumDimension",
      ",", "diagMinimumRatios"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"Dataset", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"KeyTake", "[", 
       RowBox[{"#", ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<Parameter\>\"", ",", "\"\<SectorDimension\>\"", 
          ",", "\"\<WindowRanks\>\"", ",", "\"\<Status\>\"", 
          ",", "\"\<MeanR\>\"", ",", "\"\<BlockSEM\>\""}], "}"}]}], "]"}], 
      "&"}], " ", "/@", " ", "diagGapRows"}], "]"}], "]"}], 
  ";"}], "\n"}], "Code",ExpressionUUID->"01b210d1-d9b7-2341-85fa-\
0179b306206e"],

Cell["\<\
  No levels are removed or unfolded. Any unresolved gap pair makes that mean \
Missing. IID and contiguous-block standard errors are descriptive estimates, \
not calibrated independent-sample confidence intervals. Delta=0 has extra \
integrable charges and degeneracies; Delta=+/-1/2 is a special \
bulk-degeneracy control. A mean alone is not a chaos diagnosis.  \
\>", "Text",ExpressionUUID->"b95cc6dc-c0d4-2340-a33f-19048e328565"],

Cell[BoxData[""], "Input",ExpressionUUID->"cd03b422-1b6d-c444-86e4-9bb5bcd732de"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagGapPlot", "=", 
   RowBox[{"gapPanel", "[", 
    RowBox[{"diagGapRows", ",", "diagRun", ",", "diagLogHorizontalAxis"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{"diagGapPlot", ";"}]}], "\n"}], "Code",ExpressionUUID->"8548a491-\
2cdf-8344-812d-10884389ac72"],

Cell[BoxData[""], "Input",ExpressionUUID->"3d8890a1-466a-e74c-b90c-bf4459330b09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diagDirectory", "=", 
   RowBox[{"staticExportBundle", "[", 
    RowBox[{"diagOutputRoot", ",", "diagRunLabel", ",", 
     RowBox[{"Join", "[", 
      RowBox[{"diagDOSPlots", ",", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\"\<MeanGapRatio_sector_\>\"", "<>", 
           RowBox[{"staticSectorSlug", "[", 
            RowBox[{
             RowBox[{"First", "[", "diagGapRows", "]"}], "[", "\"\<Labels\>\"",
              "]"}], "]"}]}], ")"}], "->", "diagGapPlot"}], "|>"}]}], "]"}], ",",
      "\n", " ", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Axis\>\"", "->", 
        RowBox[{"diagRun", "[", "\"\<Axis\>\"", "]"}]}], ",", 
       RowBox[{"\"\<Grid\>\"", "->", 
        RowBox[{"diagRun", "[", "\"\<Grid\>\"", "]"}]}], ",", 
       RowBox[{"\"\<Sector\>\"", "->", "diagSector"}], ",", 
       RowBox[{"\"\<RankWindow\>\"", "->", "diagRankWindow"}], ",", "\n", " ", 
       RowBox[{"\"\<DOS\>\"", "->", "diagDOS"}], ",", 
       RowBox[{"\"\<GapRows\>\"", "->", "diagGapRows"}], ",", 
       RowBox[{"\"\<GapResolution\>\"", "->", "diagGapResolution"}], ",", 
       RowBox[{"\"\<BlockLength\>\"", "->", "diagBlockLength"}], ",", 
       RowBox[{"\"\<MinimumDimension\>\"", "->", "diagMinimumDimension"}], ",", 
       RowBox[{"\"\<MinimumRatios\>\"", "->", "diagMinimumRatios"}]}], 
      "|>"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"Print", "[", "diagDirectory", "]"}], ";"}]}], "\n"}], "Code",Expre\
ssionUUID->"599a0572-fe04-2242-b6b0-ac3d71fd6d01"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["  2. Dynamics of the reduced edge density matrix  ", "Title",ExpressionUUID->"4080b265-463b-5a48-b80f-923db7299470"],

Cell[CellGroupData[{

Cell["  2.1 Definitions: state preparations and observables  ", "Subsection",ExpressionUUID->"a7929286-974d-b44e-9601-1ece06a5fb2d"],

Cell[CellGroupData[{

Cell["  State preparation and complete state-observable records  ", \
"Subsubsection",ExpressionUUID->"fe06f652-0ff0-5b45-a5f8-aa3925d56e22"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Edge", " ", "observables", " ", "from", " ", "the", " ", "4", " ", "x", " ",
      "environment"}], "-", 
    RowBox[{"rank", " ", "coefficient", " ", 
     RowBox[{"matrix", "."}]}]}], "*)"}]}]], "Input",
 CellChangeTimes->{{4.0014607804078827`*^9, 4.0014607825088825`*^9}},
 CellLabel->
  "In[150]:=",ExpressionUUID->"46aba403-dc1e-424d-8911-4a50debd5389"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"observables", "[", 
     RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", "z", 
        ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"r", "=", 
        RowBox[{"a", " ", ".", " ", 
         RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
       RowBox[{"a1", "=", 
        RowBox[{"traceB", "[", "r", "]"}]}], ";", 
       RowBox[{"b1", "=", 
        RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
        RowBox[{"entropy", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "z"}], "}"}], "=", 
        RowBox[{"PauliMatrix", " ", "/@", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
       RowBox[{"ma", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
       RowBox[{"mb", "=", 
        RowBox[{"Re", "[", 
         RowBox[{"Tr", "[", 
          RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
       RowBox[{"e", "=", 
        RowBox[{"Reverse", "[", 
         RowBox[{"Sort", "[", 
          RowBox[{"Re", "[", 
           RowBox[{"Eigenvalues", "[", 
            RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
         RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
         RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
         RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
         RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
         RowBox[{"\"\<Purity\>\"", "->", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
         RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
         RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
         RowBox[{"\"\<MutualInfo\>\"", "->", 
          RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
         RowBox[{"\"\<Concurrence\>\"", "->", 
          RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
         RowBox[{"\"\<Negativity\>\"", "->", 
          RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<InitialOverlap\>\"", "->", 
          RowBox[{"Re", "[", 
           RowBox[{"Tr", "[", 
            RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
         RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
         RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
         RowBox[{"\"\<ConnectedZZ\>\"", "->", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
            "]"}], "-", 
           RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
         RowBox[{"\"\<ConnectedXX\>\"", "->", 
          RowBox[{
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"KroneckerProduct", "[", 
               RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
            "]"}], "-", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<TraceError\>\"", "->", 
          RowBox[{"Abs", "[", 
           RowBox[{
            RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
         RowBox[{"\"\<HermiticityError\>\"", "->", 
          RowBox[{"Norm", "[", 
