         RowBox[{"Flatten", "[", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{"ga", ",", " ", 
            RowBox[{"Conjugate", "[", "gb", "]"}]}], "]"}], "]"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"ga", ",", " ", 
           RowBox[{"Rest", "[", 
            RowBox[{"chPauliBasis2", "[", "]"}], "]"}]}], "}"}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"gb", ",", " ", 
           RowBox[{"Rest", "[", 
            RowBox[{"chPauliBasis2", "[", "]"}], "]"}]}], "}"}]}], "]"}], ",",
        " ", "1"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chCanonicalRates", "[", "lsup_", "]"}], " ", ":=", " ", 
   RowBox[{"Sort", "[", 
    RowBox[{"Re", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", " ", "+", " ", 
           RowBox[{"ConjugateTranspose", "[", "#", "]"}]}], ")"}], "/", "2"}],
         " ", "&"}], "[", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"chGksBasis", "[", "]"}], " ", ".", " ", 
          RowBox[{"Flatten", "[", "lsup", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"15", ",", " ", "15"}], "}"}]}], "]"}], "]"}], "]"}], "]"}],
     "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chRhpRate", "[", "rates_", "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"Total", "[", 
     RowBox[{"Clip", "[", 
      RowBox[{
       RowBox[{"-", "rates"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"0.", ",", " ", "Infinity"}], "}"}]}], "]"}], "]"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chTraceNorm", "[", "x_", "]"}], " ", ":=", " ", 
   RowBox[{"Total", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{"Eigenvalues", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"x", " ", "+", " ", 
         RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], ")"}], "/", "2"}], 
      "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"chRhpStep", "[", 
    RowBox[{"s2_", ",", " ", "s1_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"chTraceNorm", "[", 
     RowBox[{"chSuperToChoi", "[", 
