    "t_", ",", "a_", ",", "eng_", ",", "fac0_", ",", "rho0_", ",", 
     "purity0_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
