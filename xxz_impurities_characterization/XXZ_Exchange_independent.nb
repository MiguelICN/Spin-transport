           RowBox[{"FileNameJoin", "[", 
            RowBox[{"{", 
             RowBox[{"dir", ",", "file"}], "}"}], "]"}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{"data", ",", 
             RowBox[{"<|", 
              RowBox[{"\"\<ExportIndex\>\"", "->", "index"}], "|>"}]}], "]"}],
            ",", "\"\<WXF\>\""}], "]"}], "]"}], 
        ",", "\"\<Static numerical data export failed.\>\""}], "]"}], ";", 
