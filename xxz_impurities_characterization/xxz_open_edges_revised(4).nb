Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"One", " ", "observable", " ", "per", " ", "panel"}], ",", " ", 
    RowBox[{"with", " ", "Delta", " ", "encoded", " ", "by", " ", "curve", " ", 
     RowBox[{"color", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"deltaPanel", "[", 
     RowBox[{"results_", ",", "ts_", ",", "p_", ",", "time_", ",", "spec_", ",", 
      RowBox[{"log_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"range", ",", "curves", ",", "styles", ",", "note", ",", "g"}],
        "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"range", "=", 
        RowBox[{"MinMax", "[", 
         RowBox[{"Lookup", "[", 
          RowBox[{"results", ",", "\"\<Delta\>\""}], "]"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"curves", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"ts", ",", 
             RowBox[{
              RowBox[{"r", "[", "\"\<Values\>\"", "]"}], "[", 
              RowBox[{"spec", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"r", ",", "results"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{"log", ",", 
         RowBox[{"curves", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{"#", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"First", "[", "#", "]"}], ">", "0"}], "&"}]}], "]"}], 
            "&"}], " ", "/@", " ", "curves"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"styles", "=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Directive", "[", 
            RowBox[{
             RowBox[{"deltaColor", "[", 
              RowBox[{
               RowBox[{"#", "[", "\"\<Delta\>\"", "]"}], ",", "range"}], 
              "]"}], ",", 
             RowBox[{"AbsoluteThickness", "[", "2", "]"}]}], "]"}], "&"}], 
          " ", "/@", " ", "results"}], ")"}]}], ";", "\n", " ", 
       RowBox[{"note", "=", 
        RowBox[{"\"\<t\\\\in[0,\>\"", "<>", 
         RowBox[{"texNumber", "[", 
          RowBox[{"time", "[", "\"\<tMax\>\"", "]"}], "]"}], 
         "<>", "\"\<];\\\\quad N_t=\>\"", "<>", 
         RowBox[{"ToString", "[", 
          RowBox[{"Length", "[", "ts", "]"}], "]"}], "<>", "\n", "  ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"time", "[", "\"\<Grid\>\"", "]"}], 
            "==", "\"\<Linear\>\""}], ",", 
           RowBox[{"\"\<;\\\\quad \\\\delta t_{\\\\rm nominal}=\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"time", "[", "\"\<dt\>\"", "]"}], "]"}]}], ",", "\n", 
           "   ", "\"\<;\\\\quad \\\\text{logarithmic sampling}\>\""}], 
          "]"}]}]}], ";", "\n", " ", 
       RowBox[{"g", "=", 
        RowBox[{"Legended", "[", 
         RowBox[{
          RowBox[{"framePlot", "[", 
           RowBox[{"curves", ",", "\"\<t\\\\quad(\\\\hbar=1)\>\"", ",", 
            RowBox[{"spec", "[", 
             RowBox[{"[", "3", "]"}], "]"}], ",", "styles", ",", 
            RowBox[{"{", "}"}], ",", "True", ",", "log"}], "]"}], ",", "\n", 
          "  ", 
          RowBox[{"Placed", "[", 
           RowBox[{
            RowBox[{"deltaBar", "[", "range", "]"}], ",", "Right"}], "]"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"plotPanel", "[", 
        RowBox[{
         RowBox[{"spec", "[", 
          RowBox[{"[", "2", "]"}], "]"}], ",", 
         RowBox[{"caption", "[", 
          RowBox[{"p", ",", "\n", "  ", 
           RowBox[{"\"\<\\\\Delta\\\\in[\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"First", "[", "range", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
            RowBox[{"texNumber", "[", 
             RowBox[{"Last", "[", "range", "]"}], "]"}], "<>", "\n", 
            "  ", "\"\<];\\\\quad N_\\\\Delta=\>\"", "<>", 
            RowBox[{"ToString", "[", 
             RowBox[{"Length", "[", "results", "]"}], "]"}]}], ",", "note"}], 
          "]"}], ",", "g"}], "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",Expre\
ssionUUID->"406d1408-f05d-a24d-84ca-22c626b407a9"],

Cell[BoxData[
 RowBox[{
