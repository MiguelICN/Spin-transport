            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"edgeSweepCheck", "[", 
      RowBox[{"results_", ",", "grid_", ",", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"data", ",", "keys"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"results", ",", "\"\<g\>\""}], "]"}], "===", "grid"}], 
          ",", "\"\<g-sweep order was not preserved.\>\""}], "]"}], ";", "\n",
         " ", 
        RowBox[{"data", "=", 
         RowBox[{"Lookup", "[", 
          RowBox[{"results", ",", "\"\<Data\>\""}], "]"}]}], ";", 
        RowBox[{"keys", "=", 
         RowBox[{"Keys", "[", 
          RowBox[{"First", "[", "data", "]"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"AllTrue", "[", 
            RowBox[{"results", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", "\"\<DimensionSum\>\"", "]"}], "==", 
               RowBox[{"2", "^", 
                RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], "&"}]}], "]"}], " ",
            "&&", "\n", "  ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"data", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Sort", "[", 
                 RowBox[{"Keys", "[", "#", "]"}], "]"}], "===", 
                RowBox[{"Sort", "[", "keys", "]"}]}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"Lookup", "[", 
                  RowBox[{
                   RowBox[{"Values", "[", "#", "]"}], 
                   ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
                RowBox[{"2", "^", 
                 RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}]}],
           ",", "\n", 
          "  ", "\"\<The g sweep has incomplete or inconsistent parent \
sectors.\>\""}], "]"}], ";", "\n", " ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"SameQ", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", "key", "]"}], "[", "\"\<Dimension\>\"", 
                 "]"}], "&"}], " ", "/@", " ", "data"}], ")"}]}], ",", "\n", 
            "   ", "\"\<A parent-sector dimension changed along g.\>\""}], 
           "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"key", ",", "keys"}], "}"}]}], "]"}], ";", "keys"}]}], 
      "\n", "]"}]}], ";"}]}]}]], "Input",ExpressionUUID->"ef8c6194-6917-cc49-\
ab23-f964305cba82"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeLabel", "[", "a_", "]"}], " ", ":=", " ", 
    RowBox[{"sectorLabel", "[", 
     RowBox[{"Association", "[", 
      RowBox[{"KeyValueMap", "[", "\n", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Switch", "[", 
           RowBox[{
           "#1", ",", "\"\<sA\>\"", ",", "\"\<s_1\>\"", ",", "\"\<sB\>\"", 
            ",", "\"\<s_L\>\"", ",", "\"\<mBulk\>\"", 
            ",", "\"\<m_{\\\\rm bulk}\>\"", ",", "_", ",", "#1"}], "]"}], "->",
           "#2"}], "&"}], ",", "a"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Small", " ", "markers", " ", "in", " ", "points"}], ";", " ", 
    RowBox[{
    "preserve", " ", "distinct", " ", "shapes", " ", "for", " ", "overlaid", " ", 
     RowBox[{"sectors", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeMarkers", "[", 
    RowBox[{"n_", ",", 
     RowBox[{"size_", ":", "3"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Table", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Switch", "[", 
        RowBox[{
        "k", ",", "1", ",", "\"\<\[FilledCircle]\>\"", ",", "2", 
         ",", "\"\<\[EmptySquare]\>\"", ",", "_", 
         ",", "\"\<\[EmptyDiamond]\>\""}], "]"}], ",", "\n", "  ", 
       RowBox[{"size", " ", 
        RowBox[{"Switch", "[", 
         RowBox[{"k", ",", "1", ",", "1", ",", "2", ",", 
          RowBox[{"4", "/", "3"}], ",", "_", ",", 
          RowBox[{"5", "/", "3"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeGridNote", "[", "grid_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dg", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Differences", "[", "grid", "]"}], "]"}]}], "}"}], ",", "\n", 
     " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{"dg", "-", 
          RowBox[{"First", "[", "dg", "]"}]}], "]"}], "<", 
        RowBox[{
         RowBox[{"10", "^", 
          RowBox[{"-", "12"}]}], " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "dg", "]"}]}], "]"}]}]}], ",", "\n", "  ", 
       RowBox[{"\"\<;\\\\quad \\\\delta g=\>\"", "<>", 
        RowBox[{"texNumber", "[", 
         RowBox[{"First", "[", "dg", "]"}], "]"}]}], ",", "\n", 
       "  ", "\"\<;\\\\quad \\\\text{nonuniform supplied grid}\>\""}], 
      "]"}]}], "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"edgeCaption", "[", 
     RowBox[{"p_", ",", "kind_", ",", "grid_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Column", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"tex", "[", 
         RowBox[{"#", ",", "13"}], "]"}], "&"}], " ", "/@", " ", 
       RowBox[{"{", "\n", " ", 
        RowBox[{
         RowBox[{"\"\<\\\\mathrm{OBC}:\\\\quad L=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}], "<>", 
          " ", "\"\<,\\\\quad S^a=\\\\sigma^a/2,\\\\quad \
AB=\\\\{1,L\\\\}\>\""}], ",", "\n", " ", 
         RowBox[{"\"\<J_{\\\\rm bulk}=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<J\>\"", "]"}], "]"}], "<>", 
          " ", "\"\<,\\\\quad \\\\Delta_{\\\\rm bulk}=\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], "]"}], 
          "<>", "\"\<,\\\\quad i_{\\\\rm bulk}=2,\\\\ldots,L-2\>\""}], ",", 
         "\n", " ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"kind", "==", "\"\<ZZ\>\""}], 
           ",", "\"\<H_{\\\\rm edge}=g(S_1^zS_2^z+S_{L-1}^zS_L^z)\>\"", ",", 
           "\n", "  ", "\"\<H_{\\\\rm \
edge}=g(S_1^xS_2^x+S_1^yS_2^y+S_{L-1}^xS_L^x+S_{L-1}^yS_L^y)\>\""}], "]"}], ",",
          "\n", " ", 
         RowBox[{"\"\<g\\\\in[\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"First", "[", "grid", "]"}], "]"}], "<>", "\"\<,\>\"", "<>", 
          RowBox[{"texNumber", "[", 
           RowBox[{"Last", "[", "grid", "]"}], "]"}], 
          "<>", "\"\<];\\\\quad N_g=\>\"", "<>", "\n", "  ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", "[", "grid", "]"}], "]"}], "<>", 
          RowBox[{"edgeGridNote", "[", "grid", "]"}], "<>", 
          " ", "\"\<;\\\\quad h=b_L=b_R=0\>\""}]}], "}"}]}], ",", 
      RowBox[{"Alignment", "->", "Center"}], ",", 
      RowBox[{"Spacings", "->", ".3"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Rank", " ", "within", " ", "a", " ", "parent", " ", "sector", " ", "is", 
     " ", "energy", " ", "order", " ", "at", " ", "each", " ", "g"}], ",", 
    " ", 
    RowBox[{"not", " ", "overlap", " ", 
     RowBox[{"tracking", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgePanels", "[", 
    RowBox[{
    "data_", ",", "grid_", ",", "groups_", ",", "p_", ",", "kind_", ",", 
     "key_", ",", "ylabel_", ",", "title_", ",", "chop_", ",", 
     RowBox[{"markerSize_", ":", "3"}]}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", "\n", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "styles", ",", "labels", ",", "curves", ",", "lineStyles", ",", 
       "values", ",", "branches", ",", "markers", ",", "groupMarkers", ",", 
       "dimText", ",", "g"}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "data", "]"}], "==", 
          RowBox[{"Length", "[", "grid", "]"}]}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"Length", "[", "grid", "]"}], ">=", "2"}]}], ",", "\n", 
        "  ", "\"\<Plot data and g grid must have the same number of samples.\
\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"realQ", "[", "markerSize", "]"}], " ", "&&", " ", 
         RowBox[{"markerSize", ">", "0"}]}], 
        ",", "\"\<MarkerSize must be positive.\>\""}], "]"}], ";", "\n", " ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"styles", "=", 
          RowBox[{"curveStyles", "[", 
           RowBox[{"Length", "[", "group", "]"}], "]"}]}], ";", 
         RowBox[{"groupMarkers", "=", 
          RowBox[{"edgeMarkers", "[", 
           RowBox[{
            RowBox[{"Length", "[", "group", "]"}], ",", "markerSize"}], 
           "]"}]}], ";", "\n", "  ", 
         RowBox[{"labels", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"edgeLabel", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "data", "]"}], "[", "#", "]"}], 
              "[", "\"\<Labels\>\"", "]"}], "]"}], "&"}], " ", "/@", " ", 
           "group"}]}], ";", "\n", "  ", 
         RowBox[{"dimText", "=", 
          RowBox[{"dimLabel", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "data", "]"}], "[", "#", "]"}], 
              "[", "\"\<Dimension\>\"", "]"}], "&"}], " ", "/@", " ", 
            "group"}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"curves", "=", 
          RowBox[{"{", "}"}]}], ";", 
         RowBox[{"lineStyles", "=", 
          RowBox[{"{", "}"}]}], ";", 
         RowBox[{"markers", "=", 
          RowBox[{"{", "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"values", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"group", "[", 
                   RowBox[{"[", "k", "]"}], "]"}], "]"}], "[", "key", "]"}], 
                "&"}], " ", "/@", " ", "data"}], ")"}]}], ";", "\n", "   ", 
            RowBox[{"branches", "=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"N", "[", "grid", "]"}], ",", "#"}], "}"}], "]"}], 
                "&"}], " ", "/@", " ", 
               RowBox[{"Transpose", "[", "values", "]"}]}], ")"}]}], ";", 
            "\n", "   ", 
            RowBox[{"curves", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"curves", ",", "branches"}], "]"}]}], ";", "\n", "   ", 
            RowBox[{"lineStyles", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"lineStyles", ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"styles", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", "branches", "]"}]}], "]"}]}], "]"}]}],
             ";", "\n", "   ", 
            RowBox[{"markers", "=", 
             RowBox[{"Join", "[", 
              RowBox[{"markers", ",", 
               RowBox[{"ConstantArray", "[", 
                RowBox[{
                 RowBox[{"groupMarkers", "[", 
                  RowBox[{"[", "k", "]"}], "]"}], ",", 
                 RowBox[{"Length", "[", "branches", "]"}]}], "]"}]}], 
              "]"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "group", "]"}]}], "}"}]}], "]"}], ";", 
         "\n", "  ", 
         RowBox[{"g", "=", 
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"plotChop", "=", "chop"}], "}"}], ",", 
            RowBox[{"framePlot", "[", 
             RowBox[{
             "curves", ",", "\"\<g\>\"", ",", "ylabel", ",", "lineStyles", ",", 
              RowBox[{"{", "}"}], ",", "\n", "    ", "False", ",", "False", ",",
               "markers", ",", "dimText"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"plotPanel", "[", 
          RowBox[{"title", ",", 
           RowBox[{"edgeCaption", "[", 
            RowBox[{"p", ",", "kind", ",", "grid"}], "]"}], ",", 
           RowBox[{"Legended", "[", 
            RowBox[{"g", ",", 
             RowBox[{"Placed", "[", "\n", "     ", 
              RowBox[{
               RowBox[{"PointLegend", "[", 
                RowBox[{"styles", ",", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"tex", "[", 
                    RowBox[{"#", ",", "15"}], "]"}], "&"}], " ", "/@", " ", 
                  "labels"}], ",", "\n", "      ", 
                 RowBox[{"LegendMarkers", "->", 
                  RowBox[{"First", " ", "/@", " ", "groupMarkers"}]}], ",", 
                 RowBox[{"LegendMarkerSize", "->", 
                  RowBox[{"Max", "[", 
                   RowBox[{"6", ",", 
                    RowBox[{"2", " ", "markerSize"}]}], "]"}]}]}], "]"}], ",",
                "Right"}], "]"}]}], "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"group", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"edgeSave", "[", 
    RowBox[{
    "dir_", ",", "p_", ",", "kind_", ",", "grid_", ",", "groups_", ",", 
     "results_", ",", "plots_", ",", "settings_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "files", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"savePNG", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", 
               RowBox[{
                RowBox[{"spec", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<_group_\>\"", "<>", 
                RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}],
               "}"}], "]"}], ",", 
            RowBox[{"spec", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "k"}], "]"}], "]"}]}], "]"}], ",", "\n", 
          "   ", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"spec", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"spec", ",", "plots"}], "}"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"files", "=", 
       RowBox[{"Export", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", "\"\<eigenstate_g_sweep.wxf\>\""}], "}"}], 
          "]"}], ",", "\n", "  ", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Model\>\"", "->", "p"}], ",", 
           RowBox[{"\"\<EdgeType\>\"", "->", "kind"}], ",", 
           RowBox[{"\"\<gGrid\>\"", "->", "grid"}], ",", 
           RowBox[{"\"\<Groups\>\"", "->", "groups"}], ",", "\n", "   ", 
           RowBox[{"\"\<Results\>\"", "->", "results"}], ",", 
           RowBox[{"\"\<Settings\>\"", "->", "settings"}], ",", "\n", "   ", 
           
           RowBox[{"\"\<Notes\>\"", 
            "->", "\"\<No fields. Edge bonds replaced. g has energy units. \
Entropies in nats. IPR=sum computational probabilities squared. Eigenvectors \
are computed per point and discarded after observables. Every plot uses \
unjoined small markers at every supplied g. Eigenstates are energy ranked \
within each parent sector. Degenerate eigenvectors remain basis dependent; \
g=0 uses compatible extra charges.\>\""}]}], "|>"}], ",", "\"\<WXF\>\""}], 
        "]"}]}], ";", "\n", " ", 
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"StringQ", "[", "files", "]"}], 
        ",", "\"\<g-sweep data export failed.\>\""}], "]"}], ";", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Saved: \>\"", ",", "dir"}], "]"}]}]}], "\n", "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"63810cd1-8ae7-f64a-a03f-67fbdec6f480"]
}, Closed]],

Cell[CellGroupData[{

Cell["10.3 ZZ Hamiltonian and compatible edge-resolved sectors", "Subsection",ExpressionUUID->"cbc611dc-5f65-c642-9796-09a3f98e9c88"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeH", "[", 
    RowBox[{"g_", ",", "p_Association"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"b", "=", 
       RowBox[{"edgeBonds", "[", 
        RowBox[{"edgeModel", "[", "p", "]"}], "]"}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"check", "[", 
       RowBox[{
        RowBox[{"realQ", "[", "g", "]"}], 
        ",", "\"\<g must be finite and real.\>\""}], "]"}], ";", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"b", "[", "\"\<Bulk\>\"", "]"}], "+", 
        RowBox[{"g", " ", 
         RowBox[{"b", "[", "\"\<ZZ\>\"", "]"}]}]}], "]"}]}]}], "\n", "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeSpaces", "[", 
    RowBox[{"p_", ",", "tol_"}], "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "bits", ",", "q", ",", 
       "ids", ",", "m", ",", "a", ",", "b", ",", "names", ",", "spaces", ",", 
       RowBox[{"out", "=", 
        RowBox[{"{", "}"}]}]}], "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"bits", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"IntegerDigits", "[", 
          RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "0", ",", 
           RowBox[{
            RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
      RowBox[{"q", "=", 
       RowBox[{"KeyTake", "[", 
        RowBox[{
         RowBox[{"charges", "[", "p", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
      "\n", " ", 
      RowBox[{"AssociateTo", "[", 
       RowBox[{"q", ",", 
        RowBox[{"\"\<RF\>\"", "->", 
         RowBox[{
          RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
          RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ids", "=", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", "^", "l"}], "]"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"bits", "[", 
                 RowBox[{"[", "#", "]"}], "]"}], "]"}], "==", "nDown"}], " ", 
              "&&", "\n", "    ", 
              RowBox[{
               RowBox[{"bits", "[", 
                RowBox[{"[", 
                 RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "bitA"}], " ", "&&",
               " ", 
              RowBox[{
               RowBox[{"bits", "[", 
                RowBox[{"[", 
                 RowBox[{"#", ",", 
                  RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "bitB"}]}], 
             "&"}]}], "]"}]}], ";", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"ids", "===", 
            RowBox[{"{", "}"}]}], ",", 
           RowBox[{"Continue", "[", "]"}]}], "]"}], ";", "\n", "  ", 
         RowBox[{"m", "=", 
          RowBox[{
           RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", 
         RowBox[{"a", "=", 
          RowBox[{
           RowBox[{"1", "/", "2"}], "-", "bitA"}]}], ";", 
         RowBox[{"b", "=", 
          RowBox[{
           RowBox[{"1", "/", "2"}], "-", "bitB"}]}], ";", "\n", "  ", 
         RowBox[{"names", "=", 
          RowBox[{"Which", "[", 
           RowBox[{
            RowBox[{"a", "==", "b"}], ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}], ",", 
            RowBox[{"m", "==", "0"}], ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}], ",", "True", ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ";", "\n", "  ", 
         RowBox[{"spaces", "=", 
          RowBox[{"{", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Basis\>\"", "->", 
              RowBox[{"IdentityMatrix", "[", 
               RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", "\n", 
             "    ", 
             RowBox[{"\"\<Labels\>\"", "->", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<m\>\"", "->", "m"}], ",", 
                RowBox[{"\"\<sA\>\"", "->", "a"}], ",", 
                RowBox[{"\"\<sB\>\"", "->", "b"}], ",", 
                RowBox[{"\"\<mBulk\>\"", "->", 
                 RowBox[{"m", "-", "a", "-", "b"}]}]}], "|>"}]}]}], "|>"}], 
           "}"}]}], ";", "\n", "  ", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"spaces", "=", 
            RowBox[{"Flatten", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"splitCharge", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"N", "[", 
                   RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                   "name", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
               "spaces"}], ",", "1"}], "]"}]}], ",", "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", 
         RowBox[{"out", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"out", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Join", "[", 
               RowBox[{"#", ",", 
                RowBox[{"<|", 
                 RowBox[{"\"\<Indices\>\"", "->", "ids"}], "|>"}]}], "]"}], 
              "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"nDown", ",", "0", ",", "l"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bitA", ",", "0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"bitB", ",", "0", ",", "1"}], "}"}]}], "]"}], ";", "out"}]}],
     "\n", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeSetup", "[", 
    RowBox[{"p_", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"edgeSetup", "[", 
    RowBox[{"p", ",", "\"\<ZZ\>\"", ",", "zzEdgeSpaces", ",", "tol"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzEdgeED", "[", 
    RowBox[{"g_", ",", "p_Association", ",", 
     RowBox[{"tol_", ":", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
   RowBox[{"edgeED", "[", 
    RowBox[{"g", ",", 
     RowBox[{"zzEdgeSetup", "[", 
      RowBox[{"p", ",", "tol"}], "]"}], ",", "tol"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"f28464a9-52e0-1d4f-b702-94410f1ff00a"]
}, Closed]],

Cell[CellGroupData[{

Cell["\<\
10.3a ZZ integrability for every g; audited sector diagonalization\
\>", "Subsection",ExpressionUUID->"56f4f868-f020-dd48-ae24-9c1503dcae17"],

Cell["\<\
Let a,b=+/-1/2 be the eigenvalues of the two outer Sz operators, and let \
N=L-2. The exact conserved projectors are P_ab=|a><a|_1 tensor I_bulk tensor \
|b><b|_L. Since both outer Sz operators commute with H_ZZ, the four subspaces \
P_ab H are invariant. On each subspace the Hamiltonian is exactly
H_ab = J Sum_(j=1)^(N-1) (S_j^x S_(j+1)^x + S_j^y S_(j+1)^y + Delta S_j^z \
S_(j+1)^z) + g a S_1^z + g b S_N^z.
The bulk indices in this displayed equation are relabeled j=1,...,N; physical \
sites remain 2,...,L-1 in the code. Therefore H_ZZ is a direct sum of four \
open XXZ Hamiltonians with longitudinal boundary fields. These fields are \
induced by the edge couplings; no fields have been added to the full chain.
Integrability does not follow merely from conserving magnetization. For each \
H_ab, the six-vertex R matrix and diagonal reflection matrices produce \
commuting double-row transfer matrices t_ab(u): [t_ab(u),t_ab(v)]=0. H_ab \
belongs to this commuting family through the Hamiltonian derivative at its \
regular point, up to normalization and an additive scalar. The two diagonal \
boundary parameters are independent, so no impurity fine-tuning relation \
constrains g. In the normalization of reference [1], its Pauli-matrix \
boundary coefficients are h_-=2ga/J and h_+=2gb/J; its Delta=cosh(eta) and \
h_+/-=sinh(eta)coth(xi_+/-) parametrization covers the fields by analytic \
continuation and limits. The critical isotropic points use the corresponding \
XXX or staggered limits.
Lift the commuting charges of each block to the full chain with P_ab. Charges \
in different edge blocks have orthogonal support, and charges within a block \
commute. Together with the edge projectors this proves sector-by-sector \
integrability for every real g, on either side of Delta=1. Finite-size level \
statistics are not the proof of this statement.
Reference [1]: N. Kitanine et al., Correlation functions of the open XXZ \
chain I, J. Stat. Mech. (2007) P10009, section 2, equations (2.1), \
(2.8)-(2.16): https://arxiv.org/abs/0707.1995 .\
\>", "Text",ExpressionUUID->"88e8060e-9ff4-ce48-81b1-8416e72063a2"],

Cell["\<\
The generic spin/spatial labels in 10.1 are retained. For nonzero g, the new \
ZZ ED also asks the original charges function which bulk charges are allowed \
by the actual fields ga,gb, and splits only charges that preserve the current \
subspace and commute with its Hamiltonian. This covers compatible exceptional \
bulk Casimirs, including the two-site middle chain at L=4. At g=0 the \
original compatible endpoint refinement is reused. The numerical routine does \
not construct the transfer matrix or resolve every Bethe conserved charge; \
integrability and a finite spin/spatial symmetry classification are separate \
statements.
edgeSetupAudit tests the orthonormality and completeness of the parent bases, \
disjoint computational index coverage, charge labels, and invariance under \
BOTH H_bulk and the edge perturbation separately. edgeCheckedED optionally \
compares against a full unsplit spectrum when its fourth argument is True. \
This expensive comparison is off during production sweeps. edgeEndpointReport \
distinguishes candidate endpoint charges from the additional labels actually \
present in each independently diagonalized sector. No previous definition is \
cleared or redefined.\
\>", "Text",ExpressionUUID->"0c50585c-18ad-f04c-80ce-bc8040a34d20"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "edgeSetupAudit", ",", "zzBulkCharges", ",", "zzResolvedED", ",", 
    "edgeEndpointReport", ",", "\n", " ", "edgeCheckedED", ",", 
    "edgeCheckedPoint", ",", "edgeCheckedSweep", ",", "zzBlockCheck"}], "]"}],
   ";"}]], "Input",ExpressionUUID->"3a4db9e0-6e53-004a-9ccb-a49c144e710c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Check", " ", "basis", " ", "completeness"}], ",", " ", 
    RowBox[{
    "invariance", " ", "of", " ", "BOTH", " ", "Hamiltonian", " ", "parts"}], 
    ",", " ", 
    RowBox[{"and", " ", 
     RowBox[{"labels", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeSetupAudit", "[", 
     RowBox[{"setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "groups", ",", "ids", ",", "other", ",", "b", ",", "all", ",", "hm", ",",
         "a", ",", "q", ",", "bits", ",", 
        RowBox[{"dim", "=", "0"}], ",", "\n", "  ", 
        RowBox[{"basisError", "=", "0."}], ",", 
        RowBox[{"blockLeak", "=", "0."}], ",", 
        RowBox[{"spaceLeak", "=", "0."}], ",", 
        RowBox[{"labelError", "=", "0."}], ",", "parts", ",", "scale"}], 
       "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"parts", "=", 
        RowBox[{"Values", "[", 
         RowBox[{"KeyTake", "[", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Bulk\>\"", ",", 
             RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}]}], "}"}]}], "]"}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{
          RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}], ",", 
          RowBox[{
           RowBox[{"#", "[", "\"\<Indices\>\"", "]"}], "&"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"all", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"First", "[", "#", "]"}], "[", "\"\<Indices\>\"", "]"}], 
           "&"}], " ", "/@", " ", "groups"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Sort", "[", "all", "]"}], "===", 
          RowBox[{"Range", "[", 
           RowBox[{"2", "^", "l"}], "]"}]}], 
         ",", "\"\<Sector index blocks are not a disjoint complete partition.\
\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"KeyTake", "[", 
         RowBox[{
          RowBox[{"charges", "[", "p", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<R\>\"", ",", "\"\<F\>\""}], "}"}]}], "]"}]}], ";", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<RF\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<R\>\"", "]"}], " ", ".", " ", 
           RowBox[{"q", "[", "\"\<F\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"{", "\n", "  ", 
          RowBox[{
           RowBox[{"\"\<m\>\"", "->", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Band", "[", 
                RowBox[{"{", 
                 RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"l", "/", "2"}], "-", 
                 RowBox[{"(", 
                  RowBox[{"Total", " ", "/@", " ", "bits"}], ")"}]}], ")"}]}],
               ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"2", "^", "l"}], ",", 
                RowBox[{"2", "^", "l"}]}], "}"}]}], "]"}]}], ",", "\n", "  ", 
           RowBox[{"\"\<sA\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "1", ",",
               "l"}], "]"}]}], ",", 
           RowBox[{"\"\<sB\>\"", "->", 
            RowBox[{"siteOp", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", "l", ",",
               "l"}], "]"}]}]}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"AssociateTo", "[", 
        RowBox[{"q", ",", 
         RowBox[{"\"\<mBulk\>\"", "->", 
          RowBox[{
           RowBox[{"q", "[", "\"\<m\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sA\>\"", "]"}], "-", 
           RowBox[{"q", "[", "\"\<sB\>\"", "]"}]}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{
            RowBox[{"First", "[", "group", "]"}], "[", "\"\<Indices\>\"", 
            "]"}]}], ";", 
          RowBox[{"other", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", "l"}], "]"}], ",", "ids"}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"b", "=", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Join", "@@", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", 
                 RowBox[{"#", "[", "\"\<Basis\>\"", "]"}], "]"}], "&"}], " ", 
               "/@", " ", "group"}], ")"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Dimensions", "[", "b", "]"}], "==", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Length", "[", "ids", "]"}], ",", 
               RowBox[{"Length", "[", "ids", "]"}]}], "}"}]}], 
            ",", "\"\<A block has an incomplete symmetry basis.\>\""}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"basisError", "=", 
           RowBox[{"Max", "[", 
            RowBox[{"basisError", ",", 
             RowBox[{"maxAbs", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", " ", 
                "b"}], "-", 
               RowBox[{"id", "[", 
                RowBox[{"Length", "[", "ids", "]"}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"dim", "+=", 
           RowBox[{
            RowBox[{"Dimensions", "[", "b", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"scale", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"Norm", "[", 
                 RowBox[{"part", ",", "Infinity"}], "]"}]}], "]"}]}], ";", 
             "\n", "   ", 
             RowBox[{"blockLeak", "=", 
              RowBox[{"Max", "[", 
               RowBox[{"blockLeak", ",", 
                RowBox[{
                 RowBox[{"maxAbs", "[", 
                  RowBox[{"part", "[", 
                   RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "/", 
                 "scale"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"hm", "=", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"part", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
              "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "=", 
                 RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
                RowBox[{"a", "=", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "b", "]"}], " ", ".", 
                  " ", "hm", " ", ".", " ", "b"}]}], ";", "\n", "    ", 
                RowBox[{"spaceLeak", "=", 
                 RowBox[{"Max", "[", 
                  RowBox[{"spaceLeak", ",", 
                   RowBox[{
                    RowBox[{"maxAbs", "[", 
                    RowBox[{
                    RowBox[{"hm", " ", ".", " ", "b"}], "-", 
                    RowBox[{"b", " ", ".", " ", "a"}]}], "]"}], "/", 
                    "scale"}]}], "]"}]}]}], ",", 
               RowBox[{"{", 
                RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"part", ",", "parts"}], "}"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"b", "=", 
              RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", "\n", "   ", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{"labelError", "=", 
                RowBox[{"Max", "[", 
                 RowBox[{"labelError", ",", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], ",", 
                  "\n", "     ", 
                  RowBox[{"maxAbs", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"q", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], " ", ".", " ", 
                    "b"}], "-", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "[", "name", 
                    "]"}], " ", "b"}]}], "]"}]}], "]"}]}], ",", "\n", "    ", 
               RowBox[{"{", 
                RowBox[{"name", ",", 
                 RowBox[{"Intersection", "[", 
                  RowBox[{
                   RowBox[{"Keys", "[", "q", "]"}], ",", 
                   RowBox[{"Keys", "[", 
                    RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], "]"}]}], 
                  "]"}]}], "}"}]}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"s", ",", "group"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"dim", "==", 
           RowBox[{"2", "^", "l"}]}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"Max", "[", 
            RowBox[{
            "basisError", ",", "blockLeak", ",", "spaceLeak", ",", 
             "labelError"}], "]"}], "<", 
           RowBox[{"100", " ", "tol"}]}]}], ",", "\n", 
         "  ", "\"\<Edge-sector completeness, invariance, or charge-label \
audit failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<DimensionSum\>\"", "->", "dim"}], ",", 
         RowBox[{"\"\<ExpectedDimension\>\"", "->", 
          RowBox[{"2", "^", "l"}]}], ",", 
         RowBox[{"\"\<BasisError\>\"", "->", "basisError"}], ",", "\n", "  ", 
         RowBox[{"\"\<IndexBlockLeakage\>\"", "->", "blockLeak"}], ",", 
         RowBox[{"\"\<SectorLeakage\>\"", "->", "spaceLeak"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<ChargeLabelError\>\"", "->", "labelError"}], ",", 
         RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",ExpressionUUID->"63c0f67e-26ce-1c47-81e5-\
0d8ba86406a1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"In", " ", "each", " ", "ZZ", " ", "block"}], ",", " ", 
    RowBox[{
    "reuse", " ", "charges", " ", "for", " ", "its", " ", "ACTUAL", " ", 
     "effective", " ", "boundary", " ", 
     RowBox[{"fields", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBulkCharges", "[", 
     RowBox[{"g_", ",", "p_", ",", "labels_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pb", ",", "q", ",", "names", ",", "alias"}], "}"}], ",", "\n",
       " ", 
      RowBox[{
       RowBox[{"pb", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"p", ",", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<L\>\"", "->", 
             RowBox[{
              RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], ",", 
            RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", "   ", 
            RowBox[{"\"\<bLeft\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sA\>\"", "]"}]}]}], ",", 
            RowBox[{"\"\<bRight\>\"", "->", 
             RowBox[{"g", " ", 
              RowBox[{"labels", "[", "\"\<sB\>\"", "]"}]}]}]}], "|>"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"q", "=", 
        RowBox[{"charges", "[", "pb", "]"}]}], ";", "\n", " ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
         "These", " ", "bulk", " ", "parities", " ", "already", " ", "have", " ",
           "the", " ", "full"}], "-", 
         RowBox[{"chain", " ", "parent", " ", 
          RowBox[{"label", "."}]}]}], " ", "*)"}], "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<R\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<R\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"KeyExistsQ", "[", 
          RowBox[{"labels", ",", "\"\<RF\>\""}], "]"}], ",", 
         RowBox[{"q", "=", 
          RowBox[{"KeyDrop", "[", 
           RowBox[{"q", ",", 
            RowBox[{"{", "\"\<RF\>\"", "}"}]}], "]"}]}]}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"names", "=", 
        RowBox[{"SortBy", "[", 
         RowBox[{
          RowBox[{"Keys", "[", "q", "]"}], ",", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                "#"}], "]"}], ",", "0", ",", "1"}], "]"}], "&"}]}], "]"}]}], ";",
        "\n", " ", 
       RowBox[{"Association", "[", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"alias", "=", 
            RowBox[{"Switch", "[", 
             RowBox[{
             "name", ",", "\"\<R\>\"", ",", "\"\<RBulk\>\"", ",", "\"\<F\>\"",
               ",", "\"\<FBulk\>\"", ",", "\"\<RF\>\"", ",", "\"\<RFBulk\>\"",
               ",", "\n", "    ", "\"\<S2\>\"", ",", "\"\<BulkS2\>\"", 
              ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredBulkS2\>\""}], 
             "]"}]}], ";", "\n", "  ", 
           RowBox[{"alias", "->", 
            RowBox[{"KroneckerProduct", "[", 
             RowBox[{
              RowBox[{"id", "[", "2", "]"}], ",", 
              RowBox[{"q", "[", "name", "]"}], ",", 
              RowBox[{"id", "[", "2", "]"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"name", ",", "names"}], "}"}]}], "]"}], "]"}]}]}], "\n", 
     "]"}]}], ";"}]}]], "Input",ExpressionUUID->"cc9effe6-e9e3-a449-b251-\
741bb06684b0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Original", " ", "ED", " ", "is", " ", "reused", " ", "at", " ", "g"}], "=", 
     RowBox[{"0.", " ", "At", " ", "other", " ", "g"}]}], ",", " ", 
    RowBox[{"add", " ", "compatible", " ", "bulk", " ", 
     RowBox[{"charges", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzResolvedED", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "h", ",", 
        RowBox[{"out", "=", 
         RowBox[{"{", "}"}]}], ",", "ids", ",", "other", ",", "hm", ",", "q", 
        ",", "extra", ",", "spaces"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          " ", "&&", " ", 
          RowBox[{"realQ", "[", "g", "]"}]}], 
         ",", "\"\<Expected a ZZ setup and real g.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", 
          RowBox[{"g", "==", "0"}], "]"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"edgeED", "[", 
           RowBox[{"g", ",", "setup", ",", "tol"}], "]"}], "]"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"h", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<Bulk\>\"", 
           "]"}], "+", 
          RowBox[{"g", " ", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<ZZ\>\"", 
            "]"}]}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"realSectorCheck", "[", 
        RowBox[{"h", ",", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", "tol"}], "]"}], ";", "\n",
        " ", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ids", "=", 
           RowBox[{"parent", "[", "\"\<Indices\>\"", "]"}]}], ";", 
          RowBox[{"other", "=", 
           RowBox[{"Complement", "[", 
            RowBox[{
             RowBox[{"Range", "[", 
              RowBox[{"2", "^", 
               RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", "ids"}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"hm", "=", 
           RowBox[{"N", "[", 
            RowBox[{"Normal", "[", 
             RowBox[{"h", "[", 
              RowBox[{"[", 
               RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"{", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Basis\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Basis\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}], 
            "}"}]}], ";", "\n", "  ", 
          RowBox[{"q", "=", 
           RowBox[{"zzBulkCharges", "[", 
            RowBox[{"g", ",", "p", ",", 
             RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}], "]"}]}], ";", 
          "\n", "  ", 
          RowBox[{"q", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"q", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"q", "[", "#", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"other", ",", "ids"}], "]"}], "]"}], "]"}], "<", 
               RowBox[{"tol", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{"q", "[", "#", "]"}], ",", "Infinity"}], "]"}]}], 
                 "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"extra", "=", 
           RowBox[{"Association", "[", 
            RowBox[{"KeyValueMap", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "->", 
                RowBox[{"N", "[", 
                 RowBox[{"Normal", "[", 
                  RowBox[{"#2", "[", 
                   RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}],
                "&"}], ",", "q"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"extra", "=", 
           RowBox[{"KeySelect", "[", 
            RowBox[{"extra", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"maxAbs", "[", 
                RowBox[{
                 RowBox[{"hm", " ", ".", " ", 
                  RowBox[{"extra", "[", "#", "]"}]}], "-", 
                 RowBox[{
                  RowBox[{"extra", "[", "#", "]"}], " ", ".", " ", "hm"}]}], 
                "]"}], "<", "\n", "    ", 
               RowBox[{"tol", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Norm", "[", 
                   RowBox[{"hm", ",", "Infinity"}], "]"}]}], "]"}], " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1.", ",", 
                  RowBox[{"Norm", "[", 
                   RowBox[{
                    RowBox[{"extra", "[", "#", "]"}], ",", "Infinity"}], 
                   "]"}]}], "]"}]}]}], "&"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"spaces", "=", 
           RowBox[{"edgeRefine", "[", 
            RowBox[{"spaces", ",", "extra", ",", "tol"}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"out", "=", 
           RowBox[{"Join", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{
               RowBox[{"Join", "[", 
                RowBox[{
                 RowBox[{"diagonalizeBlock", "[", 
                  RowBox[{"#", ",", "hm", ",", "ids", ",", "tol"}], "]"}], ",",
                  "\n", "    ", 
                 RowBox[{"<|", 
                  RowBox[{"\"\<ParentLabels\>\"", "->", 
                   RowBox[{"parent", "[", "\"\<Labels\>\"", "]"}]}], "|>"}]}],
                 "]"}], "&"}], " ", "/@", " ", "spaces"}]}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"parent", ",", 
           RowBox[{"setup", "[", "\"\<Spaces\>\"", "]"}]}], "}"}]}], "]"}], ";",
        "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], 
         ",", "\"\<Incomplete refined ZZ ED.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Parameters\>\"", "->", 
          RowBox[{"Join", "[", 
           RowBox[{"p", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<g\>\"", "->", "g"}], ",", 
              RowBox[{"\"\<EdgeType\>\"", "->", "\"\<ZZ\>\""}]}], "|>"}]}], 
           "]"}]}], ",", 
         RowBox[{"\"\<Hamiltonian\>\"", "->", "h"}], ",", "\n", "  ", 
         RowBox[{"\"\<Sectors\>\"", "->", "out"}], ",", 
         RowBox[{"\"\<DimensionSum\>\"", "->", 
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}]}], ",", 
         "\n", "  ", 
         RowBox[{"\"\<EndpointRefinement\>\"", "->", 
          RowBox[{"{", "}"}]}]}], "|>"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",\
ExpressionUUID->"fa90568a-f5bf-fd4d-a1d6-6321ec3f8e1e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Candidate", " ", "endpoint", " ", "charges", " ", "need", " ", "not", " ",
     "preserve", " ", "every", " ", "individual", " ", "parent", " ", 
    RowBox[{"block", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeEndpointReport", "[", "ed_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"zero", "=", 
         RowBox[{"TrueQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<g\>\"", 
            "]"}], "==", "0"}], "]"}]}], ",", "rows"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"rows", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"s", ",", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<ParentLabels\>\"", "->", 
               RowBox[{"s", "[", "\"\<ParentLabels\>\"", "]"}]}], ",", "\n", 
              "   ", 
              RowBox[{"\"\<AdditionalLabels\>\"", "->", 
               RowBox[{"KeyDrop", "[", 
                RowBox[{
                 RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", 
                 RowBox[{"Keys", "[", 
                  RowBox[{"s", "[", "\"\<ParentLabels\>\"", "]"}], "]"}]}], 
                "]"}]}], ",", "\n", "   ", 
              RowBox[{"\"\<Dimension\>\"", "->", 
               RowBox[{"s", "[", "\"\<Dimension\>\"", "]"}]}]}], "|>"}]}], 
           "]"}], ",", 
          RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<g\>\"", "->", 
          RowBox[{
           RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<g\>\"", 
           "]"}]}], ",", 
         RowBox[{"\"\<AtDecoupledEndpoint\>\"", "->", "zero"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<CandidateEndpointCharges\>\"", "->", 
          RowBox[{"If", "[", 
           RowBox[{"zero", ",", 
            RowBox[{"ed", "[", "\"\<EndpointRefinement\>\"", "]"}], ",", 
            RowBox[{"{", "}"}]}], "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<ActuallyResolvedSectors\>\"", "->", 
          RowBox[{"Length", "[", 
           RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], "]"}]}], ",", 
         RowBox[{"\"\<SectorRefinements\>\"", "->", "rows"}], ",", "\n", "  ", 
         RowBox[{"\"\<DimensionSum\>\"", "->", 
          RowBox[{"ed", "[", "\"\<DimensionSum\>\"", "]"}]}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->"8fa787e4-b4ec-9b4c-\
a481-3dbe3cd46b9e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Full", "-", 
     RowBox[{"spectrum", " ", "comparison", " ", "is", " ", "opt"}], "-", 
     "in"}], ";", " ", 
    RowBox[{
    "do", " ", "not", " ", "repeat", " ", "full", " ", "ED", " ", "in", " ", 
     RowBox[{"production", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeCheckedED", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}], ",", 
      RowBox[{"fullCheck_", ":", "False"}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ed", ",", "e", ",", "error"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          ",", 
          RowBox[{"zzResolvedED", "[", 
           RowBox[{"g", ",", "setup", ",", "tol"}], "]"}], ",", 
          RowBox[{"edgeED", "[", 
           RowBox[{"g", ",", "setup", ",", "tol"}], "]"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Total", "[", 
           RowBox[{"Lookup", "[", 
            RowBox[{
             RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
             ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
          RowBox[{"2", "^", 
           RowBox[{
            RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}], 
            "[", "\"\<L\>\"", "]"}]}]}], ",", "\n", 
         "  ", "\"\<The resolved ED did not include every eigenstate.\>\""}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"error", "=", 
        RowBox[{"Missing", "[", "\"\<NotRequested\>\"", "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"TrueQ", "[", "fullCheck", "]"}], ",", 
         RowBox[{
          RowBox[{"e", "=", 
           RowBox[{"Sort", "[", 
            RowBox[{"Re", "[", 
             RowBox[{"Eigenvalues", "[", 
              RowBox[{"N", "[", 
               RowBox[{"Normal", "[", 
                RowBox[{"ed", "[", "\"\<Hamiltonian\>\"", "]"}], "]"}], "]"}],
               "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"error", "=", 
           RowBox[{"maxAbs", "[", 
            RowBox[{"e", "-", 
             RowBox[{"Sort", "[", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{
                 RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
                 ",", "\"\<Eigenvalues\>\""}], "]"}], "]"}], "]"}]}], "]"}]}],
           ";", "\n", "  ", 
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{"error", "<", 
             RowBox[{"100", " ", "tol", " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"maxAbs", "[", "e", "]"}]}], "]"}]}]}], 
            ",", "\"\<Resolved and full spectra disagree.\>\""}], "]"}]}]}], 
        "]"}], ";", "\n", " ", 
       RowBox[{"Join", "[", 
        RowBox[{"ed", ",", 
         RowBox[{"<|", 
          RowBox[{
           RowBox[{"\"\<Audit\>\"", "->", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<DimensionSum\>\"", "->", 
               RowBox[{"ed", "[", "\"\<DimensionSum\>\"", "]"}]}], ",", "\n", 
              "   ", 
              RowBox[{"\"\<MaxResidual\>\"", "->", 
               RowBox[{"Max", "[", 
                RowBox[{"Lookup", "[", 
                 RowBox[{
                  RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}], 
                  ",", "\"\<Residual\>\""}], "]"}], "]"}]}], ",", "\n", "   ", 
              RowBox[{"\"\<FullSpectrumError\>\"", "->", "error"}], ",", 
              RowBox[{"\"\<Passed\>\"", "->", "True"}]}], "|>"}]}], ",", "\n",
            "  ", 
           RowBox[{"\"\<EndpointReport\>\"", "->", 
            RowBox[{"edgeEndpointReport", "[", "ed", "]"}]}]}], "|>"}]}], 
        "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->"d0d891b4-\
a9aa-5c49-87f6-d439fa17688d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Preserve", " ", "every", " ", "parent", " ", "label"}], ",", " ", 
    RowBox[{
     RowBox[{
     "scalar", " ", "observable", " ", "and", " ", "g", " ", "sample", " ", 
      "from", " ", "chapters", " ", "10"}], "-", "11."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"edgeCheckedPoint", "[", 
     RowBox[{"g_", ",", "setup_", ",", "tol_"}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "ed", ",", "l", ",", "blocks", ",", "groups", ",", "data", ",", 
        "labels", ",", "rows"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"ed", "=", 
        RowBox[{"addEntropies", "[", 
         RowBox[{"edgeCheckedED", "[", 
          RowBox[{"g", ",", "setup", ",", "tol"}], "]"}], "]"}]}], ";", 
       RowBox[{"l", "=", 
        RowBox[{
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"blocks", "=", 
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{"Function", "[", 
           RowBox[{"s", ",", 
            RowBox[{"Join", "[", 
             RowBox[{"s", ",", 
              RowBox[{"<|", 
               RowBox[{"\"\<IPR\>\"", "->", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Total", "[", 
                    RowBox[{
                    RowBox[{"Abs", "[", "#", "]"}], "^", "4"}], "]"}], "&"}], 
                  " ", "/@", " ", 
                  RowBox[{"s", "[", "\"\<Vectors\>\"", "]"}]}], ")"}]}], 
               "|>"}]}], "]"}]}], "]"}], ",", 
          RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "]"}]}], ";", "\n", 
       " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"blocks", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"2.", "^", 
                RowBox[{"(", 
                 RowBox[{"-", "l"}], ")"}]}], "-", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<IPR\>\"", "]"}], "]"}], "<=", 
              RowBox[{"1", "+", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<HalfEntropy\>\"", "]"}], "]"}], "<=", 
              RowBox[{
               RowBox[{
                RowBox[{"Floor", "[", 
                 RowBox[{"l", "/", "2"}], "]"}], " ", 
                RowBox[{"Log", "[", "2", "]"}]}], "+", 
               RowBox[{"100", " ", "tol"}]}]}], " ", "&&", "\n", "   ", 
             RowBox[{
              RowBox[{"Min", "[", 
               RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], ">=", 
              RowBox[{
               RowBox[{"-", "100"}], " ", "tol"}]}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"#", "[", "\"\<EdgesEntropy\>\"", "]"}], "]"}], "<=", 
              RowBox[{
               RowBox[{"Log", "[", "4", "]"}], "+", 
               RowBox[{"100", " ", "tol"}]}]}]}], "&"}]}], "]"}], ",", "\n", 
         "  ", "\"\<Eigenstate entropy or IPR bounds failed.\>\""}], "]"}], ";",
        "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], ",", 
         RowBox[{"check", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"maxAbs", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"blocks", ",", "\"\<EdgesEntropy\>\""}], "]"}], "]"}], "<", 
            RowBox[{"100", " ", "tol"}]}], ",", "\n", 
           "  ", "\"\<A ZZ eigenvector lost its fixed-edge product structure.\
\>\""}], "]"}]}], "]"}], ";", "\n", " ", 
       RowBox[{"groups", "=", 
        RowBox[{"GatherBy", "[", 
         RowBox[{"blocks", ",", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"Normal", "[", 
              RowBox[{"KeySort", "[", 
               RowBox[{"#", "[", "\"\<ParentLabels\>\"", "]"}], "]"}], "]"}], 
             ",", "InputForm"}], "]"}], "&"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"data", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"labels", "=", 
             RowBox[{"KeySort", "[", 
              RowBox[{
               RowBox[{"First", "[", "group", "]"}], 
               "[", "\"\<ParentLabels\>\"", "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"rows", "=", 
             RowBox[{"SortBy", "[", 
              RowBox[{
               RowBox[{"Flatten", "[", 
                RowBox[{
                 RowBox[{"Table", "[", 
                  RowBox[{
                   RowBox[{"Transpose", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"s", "[", "\"\<Eigenvalues\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<HalfEntropy\>\"", "]"}], ",", "\n",
                     "    ", 
                    RowBox[{"s", "[", "\"\<EdgesEntropy\>\"", "]"}], ",", 
                    RowBox[{"s", "[", "\"\<IPR\>\"", "]"}]}], "}"}], "]"}], ",", 
                   RowBox[{"{", 
                    RowBox[{"s", ",", "group"}], "}"}]}], "]"}], ",", "1"}], 
                "]"}], ",", "First"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"ToString", "[", 
              RowBox[{
               RowBox[{"Normal", "[", "labels", "]"}], ",", "InputForm"}], 
              "]"}], "->", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Labels\>\"", "->", "labels"}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"Length", "[", "rows", "]"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<Energies\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<HalfEntropy\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "\n", "   ", 
               RowBox[{"\"\<EdgesEntropy\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ",", 
               RowBox[{"\"\<IPR\>\"", "->", 
                RowBox[{"rows", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "4"}], "]"}], "]"}]}]}], "|>"}]}]}], ",", 
           RowBox[{"{", 
            RowBox[{"group", ",", "groups"}], "}"}]}], "]"}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<g\>\"", "->", "g"}], ",", 
         RowBox[{"\"\<Data\>\"", "->", "data"}], ",", 
         RowBox[{"\"\<SectorTable\>\"", "->", 
          RowBox[{"sectorTable", "[", "ed", "]"}]}], ",", "\n", "  ", 
         RowBox[{"\"\<DimensionSum\>\"", "->", 
          RowBox[{"ed", "[", "\"\<DimensionSum\>\"", "]"}]}], ",", 
         RowBox[{"\"\<EndpointRefinement\>\"", "->", 
          RowBox[{"ed", "[", "\"\<EndpointRefinement\>\"", "]"}]}], ",", "\n",
          "  ", 
         RowBox[{"\"\<Audit\>\"", "->", 
          RowBox[{"ed", "[", "\"\<Audit\>\"", "]"}]}], ",", 
         RowBox[{"\"\<EndpointReport\>\"", "->", 
          RowBox[{"ed", "[", "\"\<EndpointReport\>\"", "]"}]}]}], "|>"}]}]}], 
     "\n", "]"}]}], ";"}]}]], "Input",ExpressionUUID->"c8b5a494-e2cf-cb46-\
b706-10cf295c774f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"edgeCheckedSweep", "[", 
    RowBox[{"grid_List", ",", "setup_", ",", "tol_", ",", "cfg_"}], "]"}], 
   " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "n", "}"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{"n", "=", 
       RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "<", "2"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"edgeCheckedPoint", "[", 
            RowBox[{"#", ",", "setup", ",", "tol"}], "]"}], "&"}], " ", "/@", 
          " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
      RowBox[{"DistributeDefinitions", "[", "edgeCheckedPoint", "]"}], ";", 
      "\n", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"ss", "=", "setup"}], ",", 
          RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
        RowBox[{"ParallelMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"edgeCheckedPoint", "[", 
            RowBox[{"#", ",", "ss", ",", "tt"}], "]"}], "&"}], ",", "grid", ",", 
          RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
       "]"}]}]}], "\n", "]"}]}], ";"}]], "Input",ExpressionUUID->"12aaeea5-\
934b-ba4f-bcfd-bf5ee2d2465b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Independently", " ", "verify", " ", "all", " ", "four", " ", "operator", " ",
     "blocks", " ", "against", " ", "their", " ", "effective", " ", 
    RowBox[{"fields", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"zzBlockCheck", "[", 
     RowBox[{"g_", ",", "setup_", ",", 
      RowBox[{"tol_", ":", 
       RowBox[{"10", "^", 
        RowBox[{"-", "10"}]}]}]}], "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "=", 
         RowBox[{"setup", "[", "\"\<Parameters\>\"", "]"}]}], ",", "l", ",", 
        "n", ",", "bits", ",", "h", ",", "x", ",", "y", ",", "z", ",", "bulk",
         ",", "ids", ",", "target", ",", "rows", ",", "err"}], "}"}], ",", 
      "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"setup", "[", "\"\<Kind\>\"", "]"}], "==", "\"\<ZZ\>\""}], 
          " ", "&&", " ", 
          RowBox[{"realQ", "[", "g", "]"}]}], 
         ",", "\"\<Expected a ZZ setup and real g.\>\""}], "]"}], ";", "\n", 
       " ", 
       RowBox[{"l", "=", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ";", 
       RowBox[{"n", "=", 
        RowBox[{"l", "-", "2"}]}], ";", 
       RowBox[{"bits", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"IntegerDigits", "[", 
           RowBox[{"k", ",", "2", ",", "l"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "0", ",", 
            RowBox[{
             RowBox[{"2", "^", "l"}], "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\n", " ", 
       RowBox[{"h", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<Bulk\>\"", 
          "]"}], "+", 
         RowBox[{"g", " ", 
          RowBox[{
           RowBox[{"setup", "[", "\"\<Bonds\>\"", "]"}], "[", "\"\<ZZ\>\"", 
           "]"}]}]}]}], ";", "\n", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x", ",", "y", ",", "z"}], "}"}], "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"PauliMatrix", "[", "k", "]"}], "/", "2"}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "3"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"bulk", "=", 
        RowBox[{
         RowBox[{"p", "[", "\"\<J\>\"", "]"}], " ", 
         RowBox[{"Total", "[", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"bondOp", "[", 
              RowBox[{"x", ",", "x", ",", "k", ",", "n"}], "]"}], "+", 
             RowBox[{"bondOp", "[", 
              RowBox[{"y", ",", "y", ",", "k", ",", "n"}], "]"}], "+", "\n", 
             "   ", 
             RowBox[{
              RowBox[{"p", "[", "\"\<Delta\>\"", "]"}], " ", 
              RowBox[{"bondOp", "[", 
               RowBox[{"z", ",", "z", ",", "k", ",", "n"}], "]"}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], "]"}]}]}], ";", "\n",
        " ", 
       RowBox[{"rows", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ids", "=", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Range", "[", 
                 RowBox[{"2", "^", "l"}], "]"}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", "1"}], "]"}], "]"}], "==", "a"}], " ", "&&",
                   " ", 
                  RowBox[{
                   RowBox[{"bits", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", 
                    RowBox[{"-", "1"}]}], "]"}], "]"}], "==", "b"}]}], 
                 "&"}]}], "]"}]}], ";", "\n", "   ", 
             RowBox[{"target", "=", 
              RowBox[{"bulk", "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "a"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "1", ",", "n"}], "]"}]}], "+", 
               RowBox[{"g", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"1", "/", "2"}], "-", "b"}], ")"}], " ", 
                RowBox[{"siteOp", "[", 
                 RowBox[{"z", ",", "n", ",", "n"}], "]"}]}]}]}], ";", "\n", 
             "   ", 
             RowBox[{"err", "=", 
              RowBox[{"maxAbs", "[", 
               RowBox[{
                RowBox[{"h", "[", 
                 RowBox[{"[", 
                  RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "-", "target"}], 
               "]"}]}], ";", "\n", "   ", 
             RowBox[{"check", "[", 
              RowBox[{
               RowBox[{"err", "<", 
                RowBox[{"100", " ", "tol", " ", 
                 RowBox[{"Max", "[", 
                  RowBox[{"1.", ",", 
                   RowBox[{"Norm", "[", 
                    RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], 
               ",", "\"\<Fixed-edge ZZ block reduction failed.\>\""}], "]"}], 
             ";", "\n", "   ", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<sA\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "a"}]}], ",", 
               RowBox[{"\"\<sB\>\"", "->", 
                RowBox[{
                 RowBox[{"1", "/", "2"}], "-", "b"}]}], ",", 
               RowBox[{"\"\<EffectiveLeftField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "a"}], ")"}]}]}], ",", "\n", 
               "    ", 
               RowBox[{"\"\<EffectiveRightField\>\"", "->", 
                RowBox[{"g", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"1", "/", "2"}], "-", "b"}], ")"}]}]}], ",", 
               RowBox[{"\"\<Dimension\>\"", "->", 
                RowBox[{"Length", "[", "ids", "]"}]}], ",", 
               RowBox[{"\"\<OperatorError\>\"", "->", "err"}]}], "|>"}]}], ",",
             "\n", "   ", 
            RowBox[{"{", 
             RowBox[{"a", ",", "0", ",", "1"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"b", ",", "0", ",", "1"}], "}"}]}], "]"}], ",", "1"}], 
         "]"}]}], ";", "\n", " ", "rows"}]}], "\n", "]"}]}], ";"}]}]], "Input",\
ExpressionUUID->"99019044-a91f-4b4c-8105-cdeb3a27bb16"]
}, Closed]],

Cell[CellGroupData[{

Cell["10.4 Editable ZZ sweep parameters", "Subsection",ExpressionUUID->"dce76c46-9a6d-9547-b7de-070177186f10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzModel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "10"}], ",", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", 
     RowBox[{"\"\<Delta\>\"", "->", "0.5"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"zzGGrid", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"0", ",", "1.0", ",", "0.01"}], "]"}]}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"Editable", " ", "window", " ", "0"}], "<=", "g", "<=", "1"}], ";",
     " ", 
    RowBox[{"only", " ", "|", "g", "|", 
     RowBox[{"<<", 
      RowBox[{"|", "J", "|", " ", 
       RowBox[{"is", " ", "weak", " ", 
        RowBox[{"coupling", "."}]}]}]}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"zzSettings", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MatchingTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", 
     RowBox[{"\"\<PlotChop\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MarkerSize\>\"", "->", "3"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzParallel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Enabled\>\"", "->", "True"}], ",", 
