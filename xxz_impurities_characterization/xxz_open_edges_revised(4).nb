    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"dynDir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
    "\n", " ", 
    RowBox[{"StringRiffle", "[", 
     RowBox[{
      RowBox[{"{", "\n", "  ", 
       RowBox[{
        RowBox[{"\"\<Model: \>\"", "<>", 
