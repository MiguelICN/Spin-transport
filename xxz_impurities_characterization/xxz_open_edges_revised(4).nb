Cell[CellGroupData[{

Cell["Basis adaptation respecting symmetries", "Subsection",ExpressionUUID->"650e6988-e3cf-3247-8ffb-1d39ca87a879"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Charges", " ", "allowed", " ", "by", " ", "the", " ", "effective", " ", 
    "longitudinal", " ", 
    RowBox[{"fields", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"charges", "[", "p_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"l", "=", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", 
        RowBox[{"d", "=", 
         RowBox[{"2", "^", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}], ",", "r", ",", "f", ",", 
        "fields", ",", 
        RowBox[{"out", "=", 
         RowBox[{"<|", "|>"}]}], ",", "st", ",", "sx", ",", "sy", ",", "sz"}],
        "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"fields", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{
          RowBox[{"p", "[", "\"\<h\>\"", "]"}], ",", "l"}], "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}]}], ";", 
       RowBox[{
        RowBox[{"fields", "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "+=", 
        RowBox[{"p", "[", "\"\<bRight\>\"", "]"}]}], ";", "\n", " ", 
       RowBox[{"r", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"1", "+", 
                RowBox[{"FromDigits", "[", 
                 RowBox[{
                  RowBox[{"Reverse", "[", 
                   RowBox[{"IntegerDigits", "[", 
                    RowBox[{"k", ",", "2", ",", "l"}], " ", "]"}], "]"}], ",",
                   "2"}], "]"}]}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", "\n", "  ", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"f", "=", 
        RowBox[{"SparseArray", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"d", "-", "k"}], ",", 
               RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "0", ",", 
              RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
