], "}"}]}], "\n", "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"dynAxes", "=", 
     RowBox[{"{", 
      RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], "}"}]}], ";", 
