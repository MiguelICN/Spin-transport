   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<EDTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MatchingTolerance\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "8"}]}]}], ",", 
     RowBox[{"\"\<PlotChop\>\"", "->", 
      RowBox[{"10", "^", 
       RowBox[{"-", "10"}]}]}], ",", 
     RowBox[{"\"\<MarkerSize\>\"", "->", "3"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exParallel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Enabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<Kernels\>\"", "->", "12"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exOutputRoot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_edge_coupling_results\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exRunLabel", "=", "\"\<Exchange\>\""}], ";"}]}], "Input",Expression\
UUID->"296f8af4-855b-7e4b-804e-64c73a0b7f23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
11.4 Compute all eigenpairs, both entropies, and IPR at every g\
\>", "Subsection",ExpressionUUID->"52cdf4f1-a727-6f45-a9a0-b9cd0bb2de5e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exUsed", "=", 
   RowBox[{"edgeModel", "[", "exModel", "]"}]}], ";", 
  RowBox[{"exGUsed", "=", "exGGrid"}], ";", 
  RowBox[{"exSettingsUsed", "=", "exSettings"}], ";", 
  RowBox[{"exParallelUsed", "=", "exParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "exGUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"exGUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "exGUsed", "]"}], "]"}], ">", "0"}], "]"}]}]}], 
    ",", "\"\<Exchange g grid must be real and strictly increasing.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exSetup", "=", 
   RowBox[{"exEdgeSetup", "[", 
    RowBox[{"exUsed", ",", 
     RowBox[{"exSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"exSetupAudit", "=", 
   RowBox[{"edgeSetupAudit", "[", 
    RowBox[{"exSetup", ",", 
     RowBox[{"exSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"exSeconds", ",", "exResults"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"edgeCheckedSweep", "[", 
     RowBox[{"exGUsed", ",", "exSetup", ",", 
      RowBox[{"exSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
      "exParallelUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exData", "=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"exResults", ",", "\"\<Data\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exKeys", "=", 
   RowBox[{"edgeSweepCheck", "[", 
    RowBox[{"exResults", ",", "exGUsed", ",", "exUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"exGroups", "=", 
   RowBox[{"Gather", "[", 
    RowBox[{"exKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "exData", ",", 
        RowBox[{"exSettingsUsed", "[", "\"\<MatchingTolerance\>\"", "]"}]}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Exchange sweep seconds: \>\"", ",", "exSeconds", 
    ",", "\"\<; parent sectors: \>\"", ",", 
    RowBox[{"Length", "[", "exKeys", "]"}], ",", "\n", 
    " ", "\"\<; plotted groups: \>\"", ",", 
    RowBox[{"Length", "[", "exGroups", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"First", "[", "exResults", "]"}], "[", "\"\<SectorTable\>\"", 
   "]"}], "]"}]}], "Input",ExpressionUUID->"4902f501-eded-4a4d-99b2-\
1baa8b599ad3"]
}, Closed]],

