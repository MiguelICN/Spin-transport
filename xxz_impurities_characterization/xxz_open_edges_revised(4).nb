Cell[CellGroupData[{

Cell["10.9 Computational-basis eigenvector IPR versus g", "Subsection",ExpressionUUID->"31fe550f-591e-df44-8b64-718c00889c85"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzIPRPlots", "=", 
   RowBox[{"edgePanels", "[", 
    RowBox[{
    "zzData", ",", "zzGUsed", ",", "zzGroups", ",", "zzUsed", 
     ",", "\"\<ZZ\>\"", ",", "\"\<IPR\>\"", ",", "\n", 
     " ", "\"\<\\\\mathrm{IPR}_{\\\\rm comp}\>\"", 
     ",", "\"\<\\\\text{ZZ edge coupling: computational-basis IPR}\>\"", ",", 
     "\n", " ", 
     RowBox[{"zzSettingsUsed", "[", "\"\<PlotChop\>\"", "]"}], ",", 
     RowBox[{"Lookup", "[", 
      RowBox[{"zzSettingsUsed", ",", "\"\<MarkerSize\>\"", ",", "3"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"zzIPRPlots", "[", 
  RowBox[{"[", "1", "]"}], "]"}]}], "Input",ExpressionUUID->"088f78ef-fdd9-\
f649-972d-e9c9214fbe21"]
}, Closed]],

