Cell[CellGroupData[{

Cell["9.8 PNG export and data", "Subsection",ExpressionUUID->"3e6064e1-bf5e-4242-8072-58c6c6dc3f2f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynDir", "=", 
   RowBox[{"newFolder", "[", 
    RowBox[{"dynOutputRoot", ",", 
     RowBox[{"dynRunLabel", "<>", "\"\<_L\>\"", "<>", 
      RowBox[{"ToString", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_J\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<J\>\"", "]"}], "]"}], "<>", 
      " ", "\"\<_h\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<h\>\"", "]"}], "]"}], "<>", "\n", 
      " ", "\"\<_bL\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<bLeft\>\"", "]"}], "]"}], "<>", 
      " ", "\"\<_bR\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"dynModelUsed", "[", "\"\<bRight\>\"", "]"}], "]"}], "<>", 
      "\n", " ", "\"\<_Delta\>\"", "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"First", "[", "dynDeltaUsed", "]"}], "]"}], "<>", "\"\<to\>\"",
       "<>", 
      RowBox[{"safeToken", "[", 
       RowBox[{"Last", "[", "dynDeltaUsed", "]"}], "]"}]}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", 
    RowBox[{
     RowBox[{"savePNG", "[", 
      RowBox[{
       RowBox[{"FileNameJoin", "[", 
