Cell["9.3 Choose fixed parameters and the Delta sweep", "Subsection",ExpressionUUID->"daf535ea-dcbd-4e42-a056-988e10bdebce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynModel", "=", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", "->", "6"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", "->", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<h\>\"", "->", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bLeft\>\"", "->", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bRight\>\"", "->", "0"}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dynDelta", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{
        RowBox[{"-", "5"}], ",", "5"}], "]"}], "/", "10"}], "]"}]}], ";"}], 
  "             ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Edit", " ", "this", " ", "list", " ", "to", " ", "change", " ", "the", " ", 
    RowBox[{"sweep", "."}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dynRunLabel", "=", "\"\<delta_dynamics\>\""}], ";"}]}], "Input",Exp\
ressionUUID->"311d1a5d-aee8-4345-8c3e-8b264bcfb4df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dynTime", "=", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", "->", "\"\<Linear\>\""}], ",", "\n", " ", 
     RowBox[{"\"\<tMax\>\"", "->", "50."}], ",", "\n", " ", 
     RowBox[{"\"\<dt\>\"", "->", "0.1"}], ",", "\n", " ", 
     RowBox[{"\"\<tMinPositive\>\"", "->", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<LogPoints\>\"", "->", "501"}]}], "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynParallel", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Enabled\>\"", "->", "True"}], ",", 
     RowBox[{"\"\<Kernels\>\"", "->", "12"}], ",", "\n", " ", 
     RowBox[{"\"\<MemoryBudgetGB\>\"", "->", "15."}], ",", 
     RowBox[{"\"\<BatchTimes\>\"", "->", "128"}]}], "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynEDTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynValidationTolerance", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "8"}]}]}], ";"}]}], "Input",ExpressionUUID->"54c51057-b619-\
3e43-8dc4-2bd192e138ee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plotChop", "=", 
   RowBox[{"10", "^", 
    RowBox[{"-", "10"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynExportLogTime", "=", "False"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynOutputRoot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_open_edges_delta_dynamics\>\""}], "}"}], "]"}]}], 
  ";"}]}], "Input",ExpressionUUID->"2d837793-86df-a549-a37e-2768f1f71365"]
}, Open  ]],

Cell[CellGroupData[{

Cell["9.4 Choose the fixed initial state", "Subsection",ExpressionUUID->"d74c9805-7b01-3841-ab20-2bcfa976a70c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dynStateMode", "=", "\"\<Factorized\>\""}], ";"}], 
  "             ", 
  RowBox[{"(*", " ", 
   RowBox[{"Factorized", " ", "or", " ", 
    RowBox[{"Full", "."}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"c42a05c8-bee3-7a45-9398-ec3d30bff580"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dynEdgeState", "=", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], ";"}], 
  "                ", 
  RowBox[{"(*", " ", 
   RowBox[{"Basis", " ", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"00", ",", "01", ",", "10", ",", "11"}], "}"}], "."}]}], " ", 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"dynMiddleState", "=", 
   RowBox[{"productKet", "[", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{
       RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Alternatives", ":", " ", 
    RowBox[{
     RowBox[{"neel", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
      "]"}], " ", "or", " ", 
     RowBox[{
      RowBox[{"helix", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "q"}], 
       "]"}], "."}]}]}], " ", "*)"}]}]}], "Input",ExpressionUUID->"389f66c4-\
77ef-7142-b2b4-c4471e30ff4e"],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Full", " ", 
     RowBox[{"mode", ":", " ", 
      RowBox[{
      "enter", " ", "one", " ", "fixed", " ", "vector", " ", "or", " ", 
       "density", " ", "matrix", " ", "in", " ", "site", " ", "order", " ", 
       "1"}]}]}], ",", "...", ",", 
    RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dynFullState", "=", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}]}], "]"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Example", ":", " ", "dynFullState"}], "=", 
      RowBox[{"eigenket", "[", 
       RowBox[{"evoED", ",", "sector", ",", "level"}], "]"}]}], ";", " ", 
     RowBox[{"evaluate", " ", "once", " ", "before", " ", "the", " ", 
      RowBox[{"sweep", "."}]}]}], " ", "*)"}]}]}]], "Input",ExpressionUUID->\
"c2ca05e8-f5e6-a24b-8934-a801f5e6269c"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.5 Prepare the fixed state and times", "Subsection",ExpressionUUID->"517c70f2-2635-5841-a93c-ccaf345393b8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"IntegerQ", "[", 
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"dynModel", "[", "\"\<L\>\"", "]"}], ">=", "3"}]}], 
    ",", "\"\<L must be an integer >=3.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"!", 
     RowBox[{"KeyExistsQ", "[", 
      RowBox[{"dynModel", ",", "\"\<Delta\>\""}], "]"}]}], 
    ",", "\"\<Put Delta values only in dynDelta.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"ListQ", "[", "dynDelta", "]"}], " ", "&&", " ", 
     RowBox[{
      RowBox[{"Length", "[", "dynDelta", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"dynDelta", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"Length", "[", 
       RowBox[{"DeleteDuplicates", "[", 
        RowBox[{
         RowBox[{"N", "[", "dynDelta", "]"}], ",", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"#1", "==", "#2"}], "]"}], "&"}]}], "]"}], "]"}], "==", 
      RowBox[{"Length", "[", "dynDelta", "]"}]}]}], ",", "\n", 
    " ", "\"\<Use at least two distinct real Delta values.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "dynStateMode"}], "]"}], ",", "\"\<Invalid dynStateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynModelUsed", "=", "dynModel"}], ";", 
  RowBox[{"dynDeltaUsed", "=", 
   RowBox[{"Sort", "[", 
    RowBox[{"N", "[", "dynDelta", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimeUsed", "=", "dynTime"}], ";", 
  RowBox[{"dynParallelUsed", "=", "dynParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynEDToleranceUsed", "=", "dynEDTolerance"}], ";", 
  RowBox[{"dynValidationToleranceUsed", "=", "dynValidationTolerance"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynTimes", "=", 
   RowBox[{"timeGrid", "[", "dynTimeUsed", "]"}]}], ";"}]}], "Input",Expressio\
nUUID->"fede1f3f-1913-3242-b006-744060c29973"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"dynStateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"dynEdgeFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynEdgeState", ",", "4", ",", "dynValidationToleranceUsed"}], 
       "]"}]}], ";", "\n", " ", 
     RowBox[{"dynMiddleFactor", "=", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"dynMiddleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], 
          ")"}]}], ",", "dynValidationToleranceUsed"}], "]"}]}], ";", "\n", 
     " ", 
     RowBox[{"dynFactor", "=", 
      RowBox[{"joinStates", "[", 
       RowBox[{"dynEdgeFactor", ",", "dynMiddleFactor", ",", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", 
    "\n", " ", 
    RowBox[{"dynFactor", "=", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"dynFullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "dynValidationToleranceUsed"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynRhoEdge0", "=", 
   RowBox[{"reducedState", "[", 
    RowBox[{"dynFactor", ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
     RowBox[{"dynModelUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynGram", "=", 
   RowBox[{
    RowBox[{"ConjugateTranspose", "[", "dynFactor", "]"}], " ", ".", " ", 
    "dynFactor"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPurity0", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Tr", "[", 
     RowBox[{"dynGram", " ", ".", " ", "dynGram"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPureInput", "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{"dynPurity0", "-", "1."}], "]"}], "<=", 
    "dynValidationToleranceUsed"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dynSpecsUsed", "=", "dynPlotSpecs"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"!", "dynPureInput"}], ",", "\n", " ", 
    RowBox[{"dynSpecsUsed", "=", 
     RowBox[{"Replace", "[", 
      RowBox[{"dynSpecsUsed", ",", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", ",", "_", ",", "_"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{"\"\<FullOverlap\>\"", 
          ",", "\"\<\\\\text{Normalized full-state overlap}\>\"", ",", "\n", 
          "   ", "\"\<\\\\operatorname{Tr}[\\\\rho(0)\\\\rho(t)]/\\\\\
operatorname{Tr}[\\\\rho(0)^2]\>\""}], "}"}]}], ",", "1"}], "]"}]}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Fixed initial purity: \>\"", ",", "dynPurity0", 
    ",", "\"\<; Delta points: \>\"", ",", 
    RowBox[{"Length", "[", "dynDeltaUsed", "]"}], ",", "\n", 
    " ", "\"\<; time points: \>\"", ",", 
    RowBox[{"Length", "[", "dynTimes", "]"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"824685ba-871b-1d4c-8515-8fb16a71351b"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.6 Independent sector ED and evolution at every Delta", "Subsection",ExpressionUUID->"e45c0c6e-6b21-4145-b137-ffe4d9adca23"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
    "Delta", " ", "values", " ", "are", " ", "processed", " ", "in", " ", 
     "order"}], ";", " ", 
    RowBox[{
    "time", " ", "batches", " ", "use", " ", "the", " ", "existing", " ", 
     "parallel", " ", 
     RowBox[{"kernels", ".", "\n", "Every"}], " ", "symmetry", " ", "sector", 
     " ", "is", " ", "diagonalized", " ", "independently"}]}], ",", " ", 
   RowBox[{
    RowBox[{"including", " ", "special", " ", "Delta"}], "=", 
    RowBox[{
     RowBox[{"+", 
      RowBox[{"/", 
       RowBox[{"-", "1."}]}]}], "\n", "The", " ", "full", " ", "initial", " ",
      "factor", " ", "is", " ", "reused", " ", "at", " ", "every", " ", 
     RowBox[{"Delta", "."}]}]}]}], "*)"}]], "Input",ExpressionUUID->"1d1ff702-\
8917-2f45-8b87-bb86575194f3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"dynResults", ",", "dynPlots", ",", "dynLogPlots"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"dynSweepSeconds", ",", "dynResults"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"Table", "[", "\n", "  ", 
     RowBox[{
      RowBox[{
       RowBox[{"delta", "=", 
        RowBox[{"dynDeltaUsed", "[", 
         RowBox[{"[", "k", "]"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Delta = \>\"", ",", "delta", ",", "\"\< (\>\"", ",", "k",
          ",", "\"\</\>\"", ",", 
         RowBox[{"Length", "[", "dynDeltaUsed", "]"}], ",", "\"\<)\>\""}], 
        "]"}], ";", "\n", "  ", 
       RowBox[{"dynCurrentModel", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"dynModelUsed", ",", 
          RowBox[{"<|", 
           RowBox[{"\"\<Delta\>\"", "->", "delta"}], "|>"}]}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dynEDSeconds", ",", "dynCurrentED"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", 
         RowBox[{"sectorED", "[", 
          RowBox[{"dynCurrentModel", ",", "dynEDToleranceUsed"}], "]"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynCurrentEngine", "=", 
        RowBox[{"makeEngine", "[", 
         RowBox[{"dynCurrentED", ",", "dynFactor"}], "]"}]}], ";", "\n", "  ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dynEvolutionSeconds", ",", "dynRecords"}], "}"}], "=", 
        RowBox[{"AbsoluteTiming", "[", "\n", "   ", 
         RowBox[{"evolveChunks", "[", 
          RowBox[{
          "dynTimes", ",", "dynCurrentEngine", ",", "dynRhoEdge0", ",", 
           "dynValidationToleranceUsed", ",", "dynParallelUsed"}], "]"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynRecords", "=", 
        RowBox[{"extraRecords", "[", 
         RowBox[{"dynRecords", ",", "dynCurrentEngine", ",", "dynPurity0"}], 
         "]"}]}], ";", "\n", "  ", 
       RowBox[{"dynValues", "=", 
        RowBox[{"Association", "[", 
         RowBox[{"Table", "[", "\n", "   ", 
          RowBox[{
           RowBox[{"key", "->", 
            RowBox[{"Developer`ToPackedArray", "[", 
             RowBox[{"N", "[", 
              RowBox[{"Lookup", "[", 
               RowBox[{"dynRecords", ",", "key"}], "]"}], "]"}], "]"}]}], ",",
            "\n", "   ", 
           RowBox[{"{", 
            RowBox[{"key", ",", 
             RowBox[{"DeleteCases", "[", 
              RowBox[{
               RowBox[{"Keys", "[", 
                RowBox[{"First", "[", "dynRecords", "]"}], "]"}], 
               ",", "\"\<Time\>\""}], "]"}]}], "}"}]}], "]"}], "]"}]}], ";", 
       "\n", "  ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<ED seconds: \>\"", ",", "dynEDSeconds", 
         ",", "\"\<; evolution seconds: \>\"", ",", "dynEvolutionSeconds"}], 
        "]"}], ";", "\n", "  ", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Delta\>\"", "->", "delta"}], ",", 
         RowBox[{"\"\<EDSeconds\>\"", "->", "dynEDSeconds"}], ",", 
         RowBox[{"\"\<EvolutionSeconds\>\"", "->", "dynEvolutionSeconds"}], ",",
          "\n", "   ", 
         RowBox[{"\"\<Sectors\>\"", "->", 
          RowBox[{"sectorTable", "[", "dynCurrentED", "]"}]}], ",", 
         RowBox[{"\"\<Values\>\"", "->", "dynValues"}]}], "|>"}]}], ",", "\n",
       "  ", 
      RowBox[{"{", 
       RowBox[{"k", ",", 
        RowBox[{"Length", "[", "dynDeltaUsed", "]"}]}], "}"}]}], "]"}], "\n", 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{
   "dynCurrentED", ",", "dynCurrentEngine", ",", "dynRecords", ",", 
    "dynValues"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Delta sweep seconds: \>\"", ",", "dynSweepSeconds"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"f5771247-a0f7-6a4c-993f-28962b279870"]
}, Closed]],

Cell[CellGroupData[{

Cell["9.7 Individual plots", "Subsection",ExpressionUUID->"a1acf311-5f90-664b-88e3-4274c7225ef7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "dynResults", "]"}], "==", 
      RowBox[{"Length", "[", "dynDeltaUsed", "]"}]}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"Lookup", "[", 
       RowBox[{"dynResults", ",", "\"\<Delta\>\""}], "]"}], "===", 
      "dynDeltaUsed"}]}], ",", "\"\<Incomplete Delta sweep.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dynPlots", "=", 
   RowBox[{"Association", "[", 
    RowBox[{"Table", "[", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"spec", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "->", 
