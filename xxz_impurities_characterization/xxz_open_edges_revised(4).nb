         RowBox[{"\"\<SetupAudit\>\"", "->", "exSetupAudit"}], ",", "\n", 
         "  ", 
         RowBox[{"\"\<PointAudits\>\"", "->", "exAuditTable"}], ",", 
         RowBox[{"\"\<EndpointReports\>\"", "->", 
          RowBox[{"Lookup", "[", 
           RowBox[{"exResults", ",", "\"\<EndpointReport\>\""}], "]"}]}]}], 
        "|>"}], ",", "\"\<WXF\>\""}], "]"}], "]"}], ",", "\n", 
    " ", "\"\<Exchange audit export failed.\>\""}], "]"}], ";"}]], "Input",Exp\
ressionUUID->"af939c0b-767e-eb47-ac9b-74de2276a090"]
