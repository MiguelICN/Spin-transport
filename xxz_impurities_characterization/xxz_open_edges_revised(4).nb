        RowBox[{"s", "=", 
         RowBox[{"PadRight", "[", 
          RowBox[{
           RowBox[{"Reverse", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"SingularValueList", "[", "\n", "  ", 
              RowBox[{
               RowBox[{
                RowBox[{"Transpose", "[", "f", "]"}], " ", ".", " ", 
                RowBox[{"KroneckerProduct", "[", 
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "2", "]"}], ",", 
                  RowBox[{"PauliMatrix", "[", "2", "]"}]}], "]"}], " ", ".", 
                " ", "f"}], ",", 
               RowBox[{"Tolerance", "->", "0"}]}], "]"}], "]"}], "]"}], ",", 
           "4"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"Max", "[", 
