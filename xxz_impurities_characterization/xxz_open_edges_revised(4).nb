Cell[CellGroupData[{

Cell["Framed plots and export layout", "Subsection",ExpressionUUID->"5ee0bdea-cd65-f942-8ca5-348df6ded9d1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Build", " ", "tick", " ", "lists", " ", "before", " ", "export"}], ";", 
    " ", 
    RowBox[{"logarithmic", " ", "plots", " ", "use", " ", "log", 
     RowBox[{"(", "t", ")"}], " ", 
     RowBox[{"coordinates", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"framePlot", "[", 
      RowBox[{
      "data_", ",", "xlabel_", ",", "ylabel_", ",", "styles_", ",", 
       "legends_", ",", 
       RowBox[{"joined_", ":", "True"}], ",", 
       RowBox[{"log_", ":", "False"}], ",", 
       RowBox[{"markers_", ":", "Automatic"}], ",", 
       RowBox[{"topLabel_", ":", "\"\<\>\""}]}], "]"}], " ", ":=", "\n", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"curves", "=", 
          RowBox[{"Map", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", 
               RowBox[{"Chop", "[", 
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], ",", "plotChop"}], "]"}]}], 
              "}"}], "&"}], ",", "data", ",", 
            RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "points", ",", "xr", ",",
          "yr", ",", "xt", ",", "yt"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{"log", ",", 
          RowBox[{"curves", "=", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], ",", 
             "curves", ",", 
             RowBox[{"{", "2", "}"}]}], "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"points", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{"curves", ",", "1"}], "]"}]}], ";", 
        RowBox[{"xr", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{"points", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], ";", 
        RowBox[{"yr", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{"points", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"xt", "=", 
         RowBox[{"If", "[", 
          RowBox[{"log", ",", 
           RowBox[{"logTicks", "@@", "xr"}], ",", 
           RowBox[{"ticks", "@@", "xr"}]}], "]"}]}], ";", 
        RowBox[{"yt", "=", 
         RowBox[{"ticks", "@@", "yr"}]}], ";", "\n", "  ", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{"curves", ",", 
          RowBox[{"Joined", "->", "joined"}], ",", 
          RowBox[{"InterpolationOrder", "->", "1"}], ",", "\n", "   ", 
          RowBox[{"PlotStyle", "->", "styles"}], ",", 
          RowBox[{"PlotMarkers", "->", 
           RowBox[{"If", "[", 
            RowBox[{"joined", ",", "None", ",", "markers"}], "]"}]}], ",", 
          "\n", "   ", 
          RowBox[{"Frame", "->", "True"}], ",", 
          RowBox[{"Axes", "->", "False"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"RotateLabel", "->", "True"}], ",", "\n", "   ", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tex", "[", 
                RowBox[{"ylabel", ",", "19"}], "]"}], ",", "None"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tex", "[", 
                RowBox[{"xlabel", ",", "20"}], "]"}], ",", "None"}], "}"}]}], 
            "}"}]}], ",", "\n", "   ", 
          RowBox[{"FrameTicks", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"yt", ",", "None"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"xt", ",", "None"}], "}"}]}], "}"}]}], ",", "\n", "   ", 
          RowBox[{"PlotLabel", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"topLabel", "==", "\"\<\>\""}], ",", "None", ",", 
             RowBox[{"tex", "[", 
              RowBox[{"topLabel", ",", "15"}], "]"}]}], "]"}]}], ",", "\n", 
          "   ", 
          RowBox[{"FrameStyle", "->", 
           RowBox[{"Directive", "[", 
            RowBox[{"Black", ",", 
             RowBox[{"AbsoluteThickness", "[", "1.5", "]"}]}], "]"}]}], ",", 
          "\n", "   ", 
          RowBox[{"ImagePadding", "->", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"140", ",", "40"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"100", ",", "50"}], "}"}]}], "}"}]}], ",", 
          RowBox[{"PlotRangePadding", "->", 
           RowBox[{"Scaled", "[", ".04", "]"}]}], ",", "\n", "   ", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"legends", "===", 
