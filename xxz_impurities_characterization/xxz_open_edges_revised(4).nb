Cell["4.2 Diagonalize and calculate eigenstate entropies", "Subsection",ExpressionUUID->"482e8da5-b059-5a47-b2c1-cb5523bb4d25"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepUsed", " ", "=", " ", "sweepModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"deltaUsed", " ", "=", " ", "deltaGrid"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "deltaUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"deltaUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "deltaUsed", " ", "]"}], "]"}], ">", "0"}], 
       "]"}]}]}], ",", "\"\<Delta grid must be strictly increasing.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"sweepSeconds", ",", "sweepData"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"sweepParallel", "[", 
     RowBox[{
     "deltaUsed", ",", "sweepUsed", ",", "edTolerance", ",", "parallel"}], 
     " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sweep seconds: \>\"", ",", "sweepSeconds"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"b31d5bcb-be69-f54d-8816-fd2c3f42586d"]
