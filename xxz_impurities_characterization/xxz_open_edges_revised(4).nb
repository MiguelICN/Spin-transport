        RowBox[{"zzSettingsUsed", ",", "\"\<MarkerSize\>\"", ",", "3"}], 
        "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{"zzSpectrumPlots", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}]}]], "Input",ExpressionUUID->"88b424ca-\
