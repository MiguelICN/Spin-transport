 RowBox[{
  RowBox[{"zzOutputRoot", "=", 
   RowBox[{"FileNameJoin", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"baseFolder", "[", "]"}], 
      ",", "\"\<xxz_edge_coupling_results\>\""}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzRunLabel", "=", "\"\<ZZ\>\""}], ";"}]}], "Input",ExpressionUUID->\
"da188a3c-e8a5-df4c-ad58-338e39ca43a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
10.5 Compute all eigenpairs, both entropies, and IPR at every g\
\>", "Subsection",ExpressionUUID->"02ef9ad1-6842-dc4f-8229-5059baed7cb5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzUsed", "=", 
   RowBox[{"edgeModel", "[", "zzModel", "]"}]}], ";", 
  RowBox[{"zzGUsed", "=", "zzGGrid"}], ";", 
  RowBox[{"zzSettingsUsed", "=", "zzSettings"}], ";", 
  RowBox[{"zzParallelUsed", "=", "zzParallel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "zzGUsed", "]"}], ">=", "2"}], " ", "&&", " ", 
     RowBox[{"AllTrue", "[", 
      RowBox[{"zzGUsed", ",", "realQ"}], "]"}], " ", "&&", "\n", " ", 
     RowBox[{"And", "@@", 
      RowBox[{"Thread", "[", 
       RowBox[{
        RowBox[{"Differences", "[", 
         RowBox[{"N", "[", "zzGUsed", "]"}], "]"}], ">", "0"}], "]"}]}]}], 
    ",", "\"\<ZZ g grid must be real and strictly increasing.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"zzSetup", "=", 
   RowBox[{"zzEdgeSetup", "[", 
    RowBox[{"zzUsed", ",", 
     RowBox[{"zzSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"zzSetupAudit", "=", 
   RowBox[{"edgeSetupAudit", "[", 
    RowBox[{"zzSetup", ",", 
     RowBox[{"zzSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ZZ parent-sector audit: \>\"", ",", "zzSetupAudit"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"zzSeconds", ",", "zzResults"}], "}"}], "=", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"edgeCheckedSweep", "[", 
     RowBox[{"zzGUsed", ",", "zzSetup", ",", 
      RowBox[{"zzSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}], ",", 
      "zzParallelUsed"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzData", "=", 
   RowBox[{"Lookup", "[", 
    RowBox[{"zzResults", ",", "\"\<Data\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzKeys", "=", 
   RowBox[{"edgeSweepCheck", "[", 
    RowBox[{"zzResults", ",", "zzGUsed", ",", "zzUsed"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"zzGroups", "=", 
   RowBox[{"Gather", "[", 
    RowBox[{"zzKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "zzData", ",", 
        RowBox[{"zzSettingsUsed", "[", "\"\<MatchingTolerance\>\"", "]"}]}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ZZ sweep seconds: \>\"", ",", "zzSeconds", 
    ",", "\"\<; parent sectors: \>\"", ",", 
    RowBox[{"Length", "[", "zzKeys", "]"}], ",", "\n", 
    " ", "\"\<; plotted groups: \>\"", ",", 
    RowBox[{"Length", "[", "zzGroups", "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", 
  RowBox[{
   RowBox[{"First", "[", "zzResults", "]"}], "[", "\"\<SectorTable\>\"", 
   "]"}], "]"}]}], "Input",ExpressionUUID->"75539606-50ec-e44f-8588-\
bf36f1f7efda"],

Cell["\<\
Every row in the displayed table is an independently diagonalized sector, \
including any compatible refinement at g=0. zzResults[[k]][\"SectorTable\"] \
is the classification at zzGUsed[[k]]. All 2^L eigenstates are included. \
Energy eigenvalues remain unchopped; only plotted y values are chopped. \
IPR=sum_z |<z|psi_n>|^4 in the original full-chain computational basis, with \
2^(-L)<=IPR<=1. Entropies use natural logarithms. No evolution, initial \
state, or dynamical quench is computed here; g labels a family of static \
Hamiltonians.\
\>", "Text",ExpressionUUID->"01c3ad0c-f4d0-344d-8732-9f5545c6283a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
10.5a Inspect the ZZ block reduction and actual endpoint sectors\
\>", "Subsection",ExpressionUUID->"fdc6dc48-b43a-674c-a361-ac613fca388e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzBlockAudit", "=", 
   RowBox[{"zzBlockCheck", "[", 
    RowBox[{
     RowBox[{"Last", "[", "zzGUsed", "]"}], ",", "zzSetup", ",", 
     RowBox[{"zzSettingsUsed", "[", "\"\<EDTolerance\>\"", "]"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"Dataset", "[", "zzBlockAudit", "]"}]}], "Input",ExpressionUUID->\
"219a8ae6-d8db-a64c-bd5d-e7d4147915b5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzAuditTable", "=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"Join", "[", 
       RowBox[{
        RowBox[{"<|", 
         RowBox[{"\"\<g\>\"", "->", 
          RowBox[{"#", "[", "\"\<g\>\"", "]"}]}], "|>"}], ",", 
        RowBox[{"#", "[", "\"\<Audit\>\"", "]"}]}], "]"}], "&"}], " ", "/@", 
     " ", "zzResults"}], ")"}]}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "zzAuditTable", "]"}]}], "Input",ExpressionUUID->\
"ccbf237b-2b94-6b4d-8adb-ddd52458287a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"zzZeroPoints", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"zzResults", ",", 
     RowBox[{
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"#", "[", "\"\<g\>\"", "]"}], "==", "0"}], "]"}], "&"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"zzZeroPoints", "===", 
     RowBox[{"{", "}"}]}], ",", 
    RowBox[{
    "Print", "[", "\"\<The supplied g grid contains no decoupled \
endpoint.\>\"", "]"}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"Print", "[", 
      RowBox[{"\"\<g=0 candidate charges: \>\"", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "zzZeroPoints", "]"}], 
         "[", "\"\<EndpointReport\>\"", "]"}], 
        "[", "\"\<CandidateEndpointCharges\>\"", "]"}]}], "]"}], ";", "\n", 
     " ", 
     RowBox[{"Print", "[", 
      RowBox[{"Dataset", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"First", "[", "zzZeroPoints", "]"}], 
         "[", "\"\<EndpointReport\>\"", "]"}], 
        "[", "\"\<SectorRefinements\>\"", "]"}], "]"}], "]"}]}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"e0a151a7-86a4-2e47-b477-1a6d54d00a61"],

Cell["\<\
Every row in EndpointReport[\"SectorRefinements\"] is an actual independently \
diagonalized child sector; its AdditionalLabels records only the charges \
compatible with that parent. EndpointRefinement in the old data format is a \
candidate list, not a claim that every charge was applied in every sector. \
Data recombines child eigenpairs into fixed parent labels only for the \
g-sweep plots. Do not compute level spacings across these recombined endpoint \
children.
For an audited full eigensystem at one g use \
zzOneED=edgeCheckedED[g,zzSetup,zzSettingsUsed[\"EDTolerance\"]]. The \
unchanged eigenket and sectorTable functions accept this result. Set the \
fourth argument to True for a small-chain full-spectrum check. The operator \
block reduction check verifies the identity H_ab; the reference \
transfer-matrix construction establishes integrability.\
\>", "Text",ExpressionUUID->"9cabb3fa-5642-0540-8c34-b4c37732605d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["10.6 Spectrum versus g", "Subsection",ExpressionUUID->"da7b509c-90f0-a143-a435-8f45c91b3c64"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Refresh", " ", "plotting", " ", "settings", " ", "without", " ", 
    "changing", " ", "the", " ", "computed", " ", 
    RowBox[{"Hamiltonians", "."}]}], " ", "*)"}], "\n", 
