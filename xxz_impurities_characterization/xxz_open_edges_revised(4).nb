        "  ", "\"\<Initial factor is fixed across Delta and stored in \
delta_dynamics.wxf.\>\"", ",", "\n", 
        "  ", "\"\<Entropies: natural logarithms. Local and pair operators: \
Pauli matrices.\>\"", ",", "\n", 
        "  ", "\"\<Connected ab = <sigma_1^a \
sigma_L^b>-<sigma_1^a><sigma_L^b>.\>\"", ",", "\n", 
        "  ", "\"\<Full survival for pure inputs; normalized full overlap for \
mixed inputs.\>\"", ",", "\n", 
        "  ", "\"\<InitialOverlap = Tr[rho_AB(0) rho_AB(t)].\>\"", ",", "\n", 
        "  ", "\"\<Colors: negative Delta red, zero purple, positive Delta \
blue.\>\""}], "\n", " ", "}"}], ",", "\"\<\\n\>\""}], "]"}], 
    ",", "\"\<Text\>\""}], "]"}], ";"}]}], "Input",ExpressionUUID->"6b098a9e-\
