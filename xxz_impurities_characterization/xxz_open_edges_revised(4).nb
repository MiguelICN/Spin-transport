Cell[CellGroupData[{

Cell["11.7 Edges-versus-bulk eigenvector entropy versus g", "Subsection",ExpressionUUID->"b7f79f93-49a4-754b-8e89-5625cb3b6cc7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"exEdgePlots", "=", 
   RowBox[{"edgePanels", "[", 
    RowBox[{
    "exData", ",", "exGUsed", ",", "exGroups", ",", "exUsed", 
     ",", "\"\<Exchange\>\"", ",", "\"\<EdgesEntropy\>\"", ",", "\n", 
     " ", "\"\<S_{AB|\\\\rm bulk}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Exchange edge coupling: edges versus bulk}\>\"", ",", 
     "\n", " ", 
     RowBox[{"exSettingsUsed", "[", "\"\<PlotChop\>\"", "]"}], ",", 
     RowBox[{"Lookup", "[", 
      RowBox[{"exSettingsUsed", ",", "\"\<MarkerSize\>\"", ",", "3"}], 
      "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"exEdgePlots", "[", 
  RowBox[{"[", "1", "]"}], "]"}]}], "Input",ExpressionUUID->"22bc5c49-45d9-\
1347-9ad3-7b82bbfdbddc"]
}, Closed]],

