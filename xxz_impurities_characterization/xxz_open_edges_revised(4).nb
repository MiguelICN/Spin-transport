Cell[BoxData[{
 RowBox[{
  RowBox[{"sgLinPlot", "=", 
   RowBox[{"sgPlot", "[", 
    RowBox[{"sgLinRun", ",", "sgLinStyle"}], "]"}]}], 
  ";"}], "\n", "sgLinPlot"}], "Input",ExpressionUUID->"4344baa6-5f86-004c-\
9e0d-c131f92f600b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["13.3.4 Export this run", "Subsubsection",ExpressionUUID->"6aeca493-3e0e-4245-971f-b40b49f4b3ae"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sgLinDirectory", "=", 
   RowBox[{"sgExport", "[", 
    RowBox[{
    "sgLinRun", ",", "sgLinPlot", ",", "sgLinStyle", ",", "\n", " ", 
     "sgLinOutputRoot", ",", "sgLinRunLabel"}], "]"}]}], ";"}]], "Input",Expre\
ssionUUID->"e0c7ebe9-554a-5548-bc3b-3630960f4df8"],

Cell["\<\
Style-only changes require only the plot/export cells. Changing L, sector, J, \
Delta, g grid, precision, rank window or numerical tolerances requires \
regenerating the grid and recomputing this run. Exports contain settings \
actually used, actual labels and dimensions, all g values, raw ratios, \
optional full selected-sector spectra, diagnostics and the plot. New numbered \
folders preserve earlier runs. A supplied g=0 is retained as a diagnostic \
endpoint with no mean.\
\>", "Text",ExpressionUUID->"10d2e1cd-771f-f540-972f-9ae636c61846"]
}, Open  ]]
}, Open  ]],

