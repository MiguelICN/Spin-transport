Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Edge", " ", "observables", " ", "from", " ", "the", " ", "4", " ", "x", " ",
      "environment"}], "-", 
    RowBox[{"rank", " ", "coefficient", " ", 
     RowBox[{"matrix", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"observables", "[", 
      RowBox[{"t_", ",", "a_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "r", ",", "a1", ",", "b1", ",", "sa", ",", "sb", ",", "sab", ",", "z",
          ",", "x", ",", "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"a", " ", ".", " ", 
          RowBox[{"ConjugateTranspose", "[", "a", "]"}]}]}], ";", 
        RowBox[{"a1", "=", 
         RowBox[{"traceB", "[", "r", "]"}]}], ";", 
        RowBox[{"b1", "=", 
         RowBox[{"traceA", "[", "r", "]"}]}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
         RowBox[{"entropy", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"a1", ",", "b1", ",", "r"}], "}"}]}]}], ";", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "z"}], "}"}], "=", 
         RowBox[{"PauliMatrix", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", " ", 
        RowBox[{"ma", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", " ", ".", " ", "a1"}], "]"}], "]"}]}], ";", 
        RowBox[{"mb", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", " ", ".", " ", "b1"}], "]"}], "]"}]}], ";", 
        RowBox[{"e", "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"herm", "[", "r", " ", "]"}], "]"}], "]"}], "]"}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<RhoAB\>\"", "->", "r"}], ",", 
          RowBox[{"\"\<RhoA\>\"", "->", "a1"}], ",", 
          RowBox[{"\"\<RhoB\>\"", "->", "b1"}], ",", 
          RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "  ", 
          RowBox[{"\"\<Purity\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"r", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
          RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
          RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "  ", 
          RowBox[{"\"\<MutualInfo\>\"", "->", 
           RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
          RowBox[{"\"\<Concurrence\>\"", "->", 
           RowBox[{"concurrence", "[", "a", "]"}]}], ",", 
          RowBox[{"\"\<Negativity\>\"", "->", 
           RowBox[{"negativity", "[", "r", "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<InitialOverlap\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"rho0", " ", ".", " ", "r"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
          RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "  ", 
          RowBox[{"\"\<ConnectedZZ\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"z", ",", "z"}], "]"}], " ", ".", " ", "r"}], "]"}], 
             "]"}], "-", 
            RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "  ", 
          RowBox[{"\"\<ConnectedXX\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"x", ",", "x"}], "]"}], " ", ".", " ", "r"}], "]"}], 
             "]"}], "-", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", " ", ".", " ", "a1"}], "]"}], "]"}], " ", 
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", " ", ".", " ", "b1"}], "]"}], "]"}]}]}]}], ",", 
          "\n", "  ", 
          RowBox[{"\"\<TraceError\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "r", "]"}], "-", "1."}], "]"}]}], ",", 
          RowBox[{"\"\<HermiticityError\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"r", "-", 
              RowBox[{"ConjugateTranspose", "[", "r", "]"}]}], 
             ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "  ", 
          RowBox[{"\"\<MinEigenvalue\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"timeChunk", "[", 
      RowBox[{"times_", ",", "engine_", ",", "rho0_", ",", "tol_"}], "]"}], 
     " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "records"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"evolveBatch", "[", 
          RowBox[{"times", ",", "engine"}], "]"}]}], ";", "\n", " ", 
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"observables", "[", 
            RowBox[{
             RowBox[{"times", "[", 
              RowBox[{"[", "k", " ", "]"}], "]"}], ",", 
             RowBox[{"partitionFactor", "[", 
              RowBox[{
               RowBox[{"a", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "All", ",", "k"}], " ", "]"}], "]"}], ",",
                "\n", "  ", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
               RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
             "rho0"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", 
             RowBox[{"Length", "[", "times", "]"}]}], "}"}]}], "]"}]}], ";", 
        "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
             "tol"}], " ", "&&", "\n", "  ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
             "]"}], "<", "tol"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}],
             ">=", 
            RowBox[{"-", "tol"}]}]}], ",", "\n", 
          "  ", "\"\<Reduced-state validation failed.\>\""}], "]"}], ";", 
        "records"}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"950f967f-a5a6-2041-ba66-b78146f7f04f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Linear", " ", "or", " ", "logarithmic", " ", "sampling"}], ",", 
    " ", 
    RowBox[{
     RowBox[{"including", " ", "t"}], "=", 
     RowBox[{"0.", " ", "Linear", " ", "dt", " ", "is", " ", 
      RowBox[{"nominal", ":", " ", 
       RowBox[{"the", " ", "last", " ", "step", " ", "may", " ", "be", " ", 
        RowBox[{"shorter", "."}]}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"timeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "t", "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"realQ", "[", 
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
         ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"Switch", "[", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\"\<Linear\>\"", ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"realQ", "[", 
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
            ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"t", "=", 
           RowBox[{"N", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                 RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
            "]"}]}], ";", "\n", "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"Last", "[", "t", "]"}], "-", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
             RowBox[{
              RowBox[{"10", "^", 
               RowBox[{"-", "12"}]}], " ", 
              RowBox[{"Max", "[", 
               RowBox[{"1.", ",", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "   ", 
            RowBox[{
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"-", "1"}], "]"}], "]"}], "=", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
            RowBox[{"AppendTo", "[", 
             RowBox[{"t", ",", 
              RowBox[{"N", "[", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
           "]"}], ";", "t"}], ",", "\n", " ", "\"\<Log\>\"", ",", 
         RowBox[{
          RowBox[{"check", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"0", "<", 
              RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
             RowBox[{"IntegerQ", "[", 
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
              "\n", "   ", 
             RowBox[{
              RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], 
            ",", "\"\<Invalid logarithmic grid.\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"t", "=", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"{", "0.", "}"}], ",", 
             RowBox[{"Exp", "[", 
              RowBox[{"Subdivide", "[", 
               RowBox[{
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
                 "]"}], ",", 
                RowBox[{"Log", "[", 
                 RowBox[{"N", "[", 
                  RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}],
                "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"t", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "=", 
           RowBox[{"N", "[", 
            RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ";", "t"}], ",",
          "\n", " ", "_", ",", 
         RowBox[{"check", "[", 
          RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
          "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}]}]], "Input",
 CellLabel->"In[48]:=",ExpressionUUID->"4727d25b-f2cf-ea4b-8e41-08c370f932b0"]
}, Closed]],

