Cell["4.3 Identify matching sectors", "Subsection",ExpressionUUID->"fa2f9cb0-b673-2f41-9f9c-a5b6399d0c67"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sweepKeys", " ", "=", " ", 
   RowBox[{"Keys", "[", 
    RowBox[{"First", "[", "sweepData", " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"AllTrue", "[", 
     RowBox[{"sweepData", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"AssociationQ", "[", "#", "]"}], " ", "&&", " ", 
        RowBox[{
         RowBox[{"Sort", "[", 
          RowBox[{"Keys", "[", "#", " ", "]"}], "]"}], "==", 
         RowBox[{"Sort", "[", "sweepKeys", "]"}]}], " ", "&&", "\n", " ", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"#", "[", "\"\<Energies\>\"", "]"}], "]"}], "&"}], " ", "/@",
            " ", 
           RowBox[{"Values", "[", "#", " ", "]"}]}], "]"}], "==", 
         RowBox[{"2", "^", 
          RowBox[{"sweepUsed", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], "]"}], 
    ",", "\"\<Incomplete sweep.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"sweepGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{"sweepKeys", ",", 
     RowBox[{
      RowBox[{"sameSpectrum", "[", 
       RowBox[{"#1", ",", "#2", ",", "sweepData", ",", "matchingTolerance"}], 
       "]"}], "&"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Sectors: \>\"", ",", 
    RowBox[{"Length", "[", "sweepKeys", "]"}], ",", "\"\<; groups: \>\"", ",", 
    RowBox[{"Length", "[", "sweepGroups", " ", "]"}]}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"8b368962-e0df-044f-a869-008e9f9afbdf"]
