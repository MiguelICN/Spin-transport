        RowBox[{
        "dynResults", ",", "dynTimes", ",", "dynModelUsed", ",", 
         "dynTimeUsed", ",", "spec"}], "]"}]}], ",", "\n", " ", 
      RowBox[{"{", 
       RowBox[{"spec", ",", "dynSpecsUsed"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Individual linear-time plots: \>\"", ",", 
    RowBox[{"Length", "[", "dynPlots", "]"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"3b85bbed-193a-6242-9d1b-fbd588d4cde0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"dynLogPlots", "=", 
