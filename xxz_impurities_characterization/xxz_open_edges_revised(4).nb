Cell["Time splitting and parallelization", "Subsection",ExpressionUUID->"f0d0129b-5875-6142-8b20-267c30cfc619"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Reuse", " ", "existing", " ", "kernels"}], ";", " ", 
    RowBox[{"no", " ", "kernels", " ", "are", " ", 
     RowBox[{"closed", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"startKernels", "[", "cfg_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", 
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"LaunchKernels", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "-", "n"}], " ", 
            "]"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"n", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Available parallel kernels: \>\"", ",", "n"}], "]"}], ";",
         "n"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Independent", " ", "Delta", " ", "points"}], ";", " ", 
     RowBox[{
     "full", " ", "eigenvectors", " ", "are", " ", "computed", " ", "at", " ",
       "each", " ", 
      RowBox[{"point", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"sweepParallel", "[", 
      RowBox[{"grid_", ",", "p_", ",", "tol_", ",", "cfg_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "n", "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", "\n", " ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "2"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "p", ",", "tol"}], "]"}], "&"}], " ", "/@", 
            " ", "grid"}], "]"}]}], "]"}], ";", "\n", " ", 
        RowBox[{"DistributeDefinitions", "[", "sweepPoint", "]"}], ";", "\n", 
        " ", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"pp", "=", "p"}], ",", 
            RowBox[{"tt", "=", "tol"}]}], "}"}], ",", 
          RowBox[{"ParallelMap", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"sweepPoint", "[", 
              RowBox[{"#", ",", "pp", ",", "tt"}], "]"}], "&"}], ",", "grid", 
            ",", 
            RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], 
         "]"}]}]}], "\n", "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"6760444a-ba56-b646-8205-1eb8fb73c800"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Batches", " ", "limit", " ", "memory"}], ";", " ", 
    RowBox[{"each", " ", "worker", " ", "gets", " ", "one", " ", "engine", " ", 
     RowBox[{"copy", "."}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"evolveChunks", "[", 
     RowBox[{
     "times_", ",", "engine_", ",", "rho0_", ",", "tol_", ",", "cfg_"}], 
     "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", "\n", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "batch", ",", "room", ",", "chunks", ",", "packets", ",", 
        "records", ",", "reference", ",", "error"}], "}"}], ",", "\n", " ", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"startKernels", "[", "cfg", "]"}]}], ";", 
       RowBox[{"room", "=", 
        RowBox[{
         RowBox[{"cfg", "[", "\"\<MemoryBudgetGB\>\"", "]"}], " ", 
         RowBox[{"1024.", "^", "3"}]}]}], ";", "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", ">=", "2"}], " ", "&&", " ", 
          RowBox[{
           RowBox[{"4.", " ", "n", " ", 
            RowBox[{"ByteCount", "[", "engine", "]"}]}], ">", "room"}]}], ",",
          "\n", "  ", 
         RowBox[{
          RowBox[{
          "Print", 
           "[", "\"\<Engine copies exceed the memory budget; using serial \
batches.\>\"", "]"}], ";", 
          RowBox[{"n", "=", "0"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"batch", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<BatchTimes\>\"", "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"1", ",", 
            RowBox[{"Floor", "[", 
             RowBox[{"room", "/", "\n", "  ", 
              RowBox[{"(", 
               RowBox[{"4.", " ", 
                RowBox[{"Max", "[", 
                 RowBox[{"1", ",", "n"}], "]"}], " ", "16", " ", 
                RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], " ", 
                RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], ")"}]}], 
             "]"}]}], "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"chunks", "=", 
        RowBox[{"Partition", "[", 
         RowBox[{"times", ",", 
          RowBox[{"UpTo", "[", "batch", " ", "]"}]}], "]"}]}], ";", "\n", " ", 
       RowBox[{"Print", "[", 
        RowBox[{"\"\<Time batches: \>\"", ",", 
         RowBox[{"Length", "[", "chunks", "]"}], 
         ",", "\"\<; maximum points per batch: \>\"", ",", "batch"}], "]"}], ";",
        "\n", " ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", ">=", "2"}], ",", "\n", "  ", 
         RowBox[{"(*", " ", 
          RowBox[{
          "Clear", " ", "both", " ", "worker", " ", "values", " ", "and", " ",
            "their", " ", "recorded", " ", "definitions", " ", "before", " ", 
           RowBox[{"reuse", "."}]}], " ", "*)"}], "\n", "  ", 
         RowBox[{
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"sharedEngine", "=", "engine"}], ";", 
          RowBox[{"sharedRho0", "=", "rho0"}], ";", 
          RowBox[{"sharedTolerance", "=", "tol"}], ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "timeChunk", ",", "sharedEngine", ",", "sharedRho0", ",", 
            "sharedTolerance"}], "]"}], ";", "\n", "  ", 
          RowBox[{"packets", "=", 
           RowBox[{"ParallelMap", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"timeChunk", "[", 
               RowBox[{
               "#", ",", "sharedEngine", ",", "sharedRho0", ",", 
                "sharedTolerance"}], "]"}], "&"}], ",", "\n", "   ", "chunks",
              ",", 
             RowBox[{"Method", "->", "\"\<CoarsestGrained\>\""}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"Clear", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], "]"}],
           ";", "\n", "  ", 
          RowBox[{"DistributeDefinitions", "[", 
           RowBox[{
           "sharedEngine", ",", "sharedRho0", ",", "sharedTolerance"}], 
           "]"}]}], ",", "\n", "  ", 
         RowBox[{"packets", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"timeChunk", "[", 
             RowBox[{"#", ",", "engine", ",", "rho0", ",", "tol"}], "]"}], 
            "&"}], " ", "/@", " ", "chunks"}]}]}], "]"}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"AllTrue", "[", 
          RowBox[{"packets", ",", "ListQ"}], "]"}], 
         ",", "\"\<A time batch failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"records", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{"packets", ",", "1"}], "]"}]}], ";", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Lookup", "[", 
           RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], "===", "times"}], 
         ",", "\"\<Time ordering failed.\>\""}], "]"}], ";", "\n", " ", 
       RowBox[{"reference", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"observables", "[", 
           RowBox[{"t", ",", 
            RowBox[{"partitionFactor", "[", 
             RowBox[{
              RowBox[{"evolve", "[", 
               RowBox[{"t", ",", "engine"}], "]"}], ",", 
              RowBox[{"{", 
               RowBox[{"1", ",", 
                RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
              RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}], ",", 
            "rho0"}], "]"}], ",", "\n", "  ", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"First", "[", "times", "]"}], ",", 
              RowBox[{"Last", "[", "times", "]"}]}], "}"}]}], "}"}]}], 
         "]"}]}], ";", "\n", " ", 
       RowBox[{"error", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"MapThread", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"#1", "[", "\"\<RhoAB\>\"", "]"}], "-", 
               RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "&"}], ",", "\n", "  ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"First", "[", "records", "]"}], ",", 
               RowBox[{"Last", "[", "records", "]"}]}], "}"}], ",", 
             "reference"}], "}"}]}], "]"}], "]"}]}], ";", "\n", " ", 
       RowBox[{"check", "[", 
        RowBox[{
         RowBox[{"error", "<", "tol"}], 
         ",", "\"\<Batched/single-time endpoint comparison failed.\>\""}], 
        "]"}], ";", "records"}]}], "\n", "]"}]}], ";"}]}]], "Input",
