           RowBox[{"Exp", "[", 
            RowBox[{"I", 
             RowBox[{"(", 
              RowBox[{"phi", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}], "q"}]}], ")"}]}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}]}]}]], "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"706ea72d-117d-f848-999c-47de0b536b91"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "Accept", " ", "a", " ", "vector", " ", "or", " ", "a", " ", "positive"}],
     ",", " ", 
    RowBox[{"trace", "-", 
     RowBox[{"one", " ", "density", " ", 
      RowBox[{"matrix", "."}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"stateFactor", "[", 
      RowBox[{"input_", ",", "dim_", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", "input", " ", "]"}], "]"}]}], ",", "e", ",",
          "v", ",", "keep"}], "}"}], ",", "\n", " ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{"x", ",", "NumericQ"}], "]"}], ",", 
          RowBox[{
           RowBox[{"check", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "x", "]"}], "==", "dim"}], " ", "&&", 
              " ", 
              RowBox[{
               RowBox[{"Norm", "[", "x", "]"}], ">", "0"}]}], 
             ",", "\"\<Invalid state vector.\>\""}], "]"}], ";", "\n", "  ", 
           RowBox[{"Return", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"x", "/", 
               RowBox[{"Norm", "[", "x", "]"}]}], "}"}], "]"}], "]"}]}]}], 
         "]"}], ";", "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixQ", "[", 
            RowBox[{"x", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Dimensions", "[", "x", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"dim", ",", "dim"}], "}"}]}]}], 
          ",", "\"\<Invalid density-matrix dimensions.\>\""}], "]"}], ";", 
        "\n", " ", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"x", "-", 
               RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "<=", "tol"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "x", "]"}], "-", "1"}], "]"}], "<=", 
            "tol"}]}], ",", "\n", 
          "  ", "\"\<Density matrix must be Hermitian with trace one.\>\""}], 
         "]"}], ";", "\n", " ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"herm", "[", "x", " ", "]"}], "]"}]}], ";", 
        RowBox[{"check", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", "e", " ", "]"}], "]"}], ">=", 
           RowBox[{"-", "tol"}]}], 
          ",", "\"\<Density matrix is not positive.\>\""}], "]"}], ";", "\n", 
        " ", 
        RowBox[{"e", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Re", "[", "e", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"e", "/=", 
         RowBox[{"Total", "[", "e", "]"}]}], ";", 
        RowBox[{"keep", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", "dim", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "#", " ", "]"}], "]"}], ">", "0"}], "&"}]}], 
          "]"}]}], ";", "\n", " ", 
        RowBox[{"Transpose", "[", 
         RowBox[{
          RowBox[{"Sqrt", "[", 
           RowBox[{"e", "[", 
            RowBox[{"[", "keep", " ", "]"}], "]"}], "]"}], " ", 
          RowBox[{"v", "[", 
           RowBox[{"[", "keep", " ", "]"}], "]"}]}], "]"}]}]}], "\n", "]"}]}],
     ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Reorder", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"edge", " ", "1"}], ",", 
        RowBox[{"edge", " ", "L"}], ",", "middle"}], ")"}], " ", "to", " ", 
      "physical", " ", "sites", " ", "1"}], ",", "...", ",", 
     RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"joinStates", "[", 
      RowBox[{"ef_", ",", "mf_", ",", "l_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"ef", ",", "mf"}], "]"}]}], "}"}], ",", "\n", " ", 
       RowBox[{"ArrayReshape", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"ArrayReshape", "[", 
            RowBox[{"a", ",", 
             RowBox[{"{", 
              RowBox[{"2", ",", "2", ",", 
               RowBox[{"2", "^", 
                RowBox[{"(", 
                 RowBox[{"l", "-", "2"}], ")"}]}], ",", 
               RowBox[{
                RowBox[{"Dimensions", "[", "a", "]"}], "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
           "  ", 
           RowBox[{"{", 
            RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"2", "^", "l"}], ",", 
           RowBox[{
            RowBox[{"Dimensions", "[", "a", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}]}], "\n", "]"}]}],
     ";"}]}]}]], "Input",
