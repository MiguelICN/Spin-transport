     ",", "\n", " ", 
     RowBox[{"\"\<MinEigenvalue\>\"", " ", "->", " ", 
      RowBox[{"Min", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}]}]}], 
    "\n", "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Max", "[", 
       RowBox[{"Values", "[", 
        RowBox[{"KeyDrop", "[", 
         RowBox[{"evoChecks", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}], 
       "]"}], "<", "validationTolerance"}], " ", "&&", "\n", " ", 
     RowBox[{
      RowBox[{"evoChecks", "[", "\"\<MinEigenvalue\>\"", "]"}], ">=", 
      RowBox[{"-", "validationTolerance"}]}]}], 
    ",", "\"\<Evolution validation failed.\>\""}], "]"}], 
  ";"}], "\n", "evoChecks"}], "Input",ExpressionUUID->"e39fb2bf-a8ad-fc45-\
902a-707bbe707841"]
