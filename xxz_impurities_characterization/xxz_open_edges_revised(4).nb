        "}"}], "]"}], ",", 
      RowBox[{"spectrumPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "spectrumPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<half_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"halfPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "halfPlots", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Do", "[", 
   RowBox[{
    RowBox[{"savePNG", "[", 
     RowBox[{
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"sweepDir", ",", 
         RowBox[{"\"\<edge_entropy_group_\>\"", "<>", 
          RowBox[{"ToString", "[", "k", "]"}], "<>", "\"\<.png\>\""}]}], 
        "}"}], "]"}], ",", 
      RowBox[{"edgeEntropyPlots", "[", 
       RowBox[{"[", "k", " ", "]"}], "]"}]}], "]"}], ",", "\n", " ", 
    RowBox[{"{", 
     RowBox[{"k", ",", 
      RowBox[{"Length", "[", "edgeEntropyPlots", "]"}]}], "}"}]}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Export", "[", 
   RowBox[{
    RowBox[{"FileNameJoin", "[", 
     RowBox[{"{", 
      RowBox[{"sweepDir", ",", "\"\<eigenstate_sweep.wxf\>\""}], "}"}], "]"}],
     ",", "\n", " ", 
    RowBox[{"<|", 
     RowBox[{
      RowBox[{"\"\<Model\>\"", "->", "sweepUsed"}], ",", 
      RowBox[{"\"\<DeltaGrid\>\"", "->", "deltaUsed"}], ",", 
      RowBox[{"\"\<Groups\>\"", "->", "sweepGroups"}], ",", 
      RowBox[{"\"\<Data\>\"", "->", "sweepData"}]}], "|>"}], 
    ",", "\"\<WXF\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Saved: \>\"", ",", "sweepDir"}], "]"}], ";"}]}], "Input",Expre\
ssionUUID->"00fe4f7a-25c1-3746-bf65-40ff475bfea6"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["5. Evolution: independent parameters and diagonalization", "Section",ExpressionUUID->"a86fc8e9-6d27-da41-9392-a33f2356a7e7"],

Cell[CellGroupData[{

Cell["5.1 Choose the Hamiltonian for this evolution", "Subsection",ExpressionUUID->"b2b76f8c-c7e8-e04e-a215-3068ea0eea88"],

Cell["\<\
Set all evolution parameters here, including Delta. Running the sweep is \
unnecessary.\
\>", "Text",ExpressionUUID->"1ab32945-426a-5e4d-951b-7534042f44c0"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoModel", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", " ", "->", " ", "8"}], ",", "\n", " ", 
     RowBox[{"\"\<J\>\"", " ", "->", " ", "1"}], ",", "\n", " ", 
     RowBox[{"\"\<Delta\>\"", " ", "->", " ", "0.5"}], ",", "\n", " ", 
     RowBox[{"\"\<h\>\"", " ", "->", " ", "0"}], ",", "\n", " ", 
     RowBox[{"\"\<bLeft\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<bRight\>\"", " ", "->", " ", "0"}]}], "\n", "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"evoLabel", " ", "=", " ", "\"\<evolution01_fieldLeft_0.01\>\""}], 
  ";"}]}], "Input",ExpressionUUID->"55e93431-7bf8-4746-ae56-0ed03bb77662"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.2 Choose the evolution time grid", "Subsection",ExpressionUUID->"ebbaf508-f770-944d-9e80-81279bfe2182"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evoTime", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", " ", "->", " ", "\"\<Linear\>\""}], ",", "\n", 
     " ", 
     RowBox[{"\"\<tMax\>\"", " ", "->", " ", "400."}], ",", "\n", " ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.1"}], ",", "\n", " ", 
     RowBox[{"\"\<tMinPositive\>\"", " ", "->", " ", "0.01"}], ",", "\n", " ", 
     RowBox[{"\"\<LogPoints\>\"", " ", "->", " ", "501"}]}], "\n", "|>"}]}], 
  ";"}]], "Input",ExpressionUUID->"3b3c12cd-9489-2c49-ae7c-762ca807bd3a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.3 Diagonalize this Hamiltonian", "Subsection",ExpressionUUID->"ab5b94e2-2a80-5340-9e7f-76de6071e6fe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoUsed", " ", "=", " ", "evoModel"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evoEDSeconds", ",", "evoED"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", 
    RowBox[{"sectorED", "[", 
     RowBox[{"evoUsed", ",", "edTolerance"}], " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoSectors", " ", "=", " ", 
   RowBox[{"sectorTable", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<ED seconds: \>\"", ",", "evoEDSeconds", 
    ",", "\"\<; tolerance: \>\"", ",", "edTolerance"}], "]"}], ";"}], "\n", 
 RowBox[{"Dataset", "[", "evoSectors", "]"}]}], "Input",ExpressionUUID->\
"ad3143e6-646c-bc40-bf96-46e531c3b674"]
}, Open  ]],

Cell[CellGroupData[{

Cell["5.4 Optional fixed-Delta eigenstate plots", "Subsection",ExpressionUUID->"dced8a61-1d6c-6f4a-a43b-6300cea3c360"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoEigenstates", " ", "=", " ", 
   RowBox[{"addEntropies", "[", "evoED", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoEnergies", " ", "=", " ", 
   RowBox[{"Lookup", "[", 
    RowBox[{
     RowBox[{"evoEigenstates", "[", "\"\<Sectors\>\"", "]"}], 
     ",", "\"\<Eigenvalues\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"evoGroups", " ", "=", " ", 
   RowBox[{"Gather", "[", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{"Length", "[", "evoEnergies", " ", "]"}], "]"}], ",", "\n", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#1", " ", "]"}], "]"}], "]"}], "==", 
        RowBox[{"Length", "[", 
         RowBox[{"evoEnergies", "[", 
          RowBox[{"[", "#2", " ", "]"}], "]"}], "]"}]}], " ", "&&", "\n", " ", 
       RowBox[{
        RowBox[{"maxAbs", "[", 
         RowBox[{
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#1", " ", "]"}], "]"}], "-", 
          RowBox[{"evoEnergies", "[", 
           RowBox[{"[", "#2", " ", "]"}], "]"}]}], "]"}], "<", 
        RowBox[{"matchingTolerance", " ", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"maxAbs", "[", "evoEnergies", " ", "]"}]}], "]"}]}]}]}], 
      "&"}]}], "]"}]}], ";"}]}], "Input",ExpressionUUID->"1a1f5677-c494-764d-\
b8d8-f99f769fd2b9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedEnergyPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<Eigenvalues\>\"", 
     ",", "\"\<E_n\>\"", ",", "\"\<\\\\text{Sector energies}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedHalfPlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<HalfEntropy\>\"", ",", "\n",
      " ", "\"\<S_{\\\\mathrm{half}}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Half-chain eigenstate entanglement}\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fixedEdgePlots", " ", "=", " ", 
   RowBox[{"fixedPanels", "[", 
    RowBox[{
    "evoEigenstates", ",", "evoGroups", ",", "\"\<EdgesEntropy\>\"", ",", 
     "\n", " ", "\"\<S_{AB|E}\\\\;(\\\\mathrm{nats})\>\"", 
     ",", "\"\<\\\\text{Edges versus middle eigenstate entanglement}\>\""}], 
    "]"}]}], ";"}]}], "Input",ExpressionUUID->"c16675e0-bafa-464d-905f-\
45f94bcbfe89"]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["6. Initial states for this evolution", "Section",ExpressionUUID->"0274fa0b-3195-fc44-a366-1d8e4e093d85"],

Cell[CellGroupData[{

Cell["6.1 Choose factorized or full-chain mode", "Subsection",ExpressionUUID->"9191d927-da1f-7d42-b9c6-047c82ca2b6f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"stateMode", " ", "=", " ", "\"\<Factorized\>\""}], ";"}], "   ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Choose", " ", "\"\<Factorized\>\"", " ", "or", " ", "\"\<Full\>\"", " ", 
    "here", " ", 
    RowBox[{"only", "."}]}], " ", "*)"}]}]], "Input",ExpressionUUID->\
"88f53d1a-588e-ca42-a098-507e93035e4b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.2 State of the two edge spins", "Subsection",ExpressionUUID->"58a0ac00-4b91-ce47-b902-e65805dae679"],

Cell["\<\
Used only in Factorized mode. Basis {00,01,10,11}; vector or 4 x 4 density \
matrix. One active assignment.\
\>", "Text",ExpressionUUID->"a024d72b-4785-5946-92e6-402e95db7f63"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"edgeState", " ", "=", " ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "1", ",", "1", ",", "1"}], "}"}], "/", "2"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", " ", 
    RowBox[{
     RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4."}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"6a79bd79-6c29-5c4d-9c20-d9c287b8d1aa"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.3 State of the middle spins", "Subsection",ExpressionUUID->"1f87019d-715d-3046-a4bb-a674e9758ff6"],

Cell["\<\
Physical order {2,...,L-1}. neel[n,0] starts with up on physical site 2. A \
middle helix starts its phase at site 2.\
\>", "Text",ExpressionUUID->"95e2cc42-7c21-1042-9530-149bb3b727eb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"middleState", " ", "=", " ", 
   RowBox[{"neel", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", "0"}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"productKet", "[", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "0"}], "}"}], ",", 
        RowBox[{
         RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"productKet", "[", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], ",", 
       RowBox[{
        RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], 
     "]"}], ",", " ", 
    RowBox[{
     RowBox[{"helix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", 
       RowBox[{"Pi", "/", "3"}]}], "]"}], "."}]}], " ", "*)"}]}]}], "Input",Ex\
pressionUUID->"cd014b68-9bb4-1e4e-985b-c72682c2c10f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.4 Full initial state", "Subsection",ExpressionUUID->"02556ca6-ab19-3a48-8dbb-591d859d0c15"],

Cell["\<\
Used only in Full mode. This default is a non-eigenstate initial condition. \
To study a stationary state deliberately, replace it with groundKet[evoED] or \
eigenket[evoED,sector,level].\
\>", "Text",ExpressionUUID->"e3bbdb44-7793-4d4d-95fd-4193b346f97b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fullState", " ", "=", " ", 
   RowBox[{"helix", "[", 
    RowBox[{
     RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], ",", 
     RowBox[{"Pi", "/", "3"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Alternatives", ":", " ", 
     RowBox[{"neel", "[", 
      RowBox[{"evoModel", "[", "\"\<L\>\"", "]"}], "]"}]}], ",", " ", 
    RowBox[{"groundKet", "[", "evoED", "]"}], ",", " ", 
    RowBox[{
     RowBox[{"eigenket", "[", 
      RowBox[{"evoED", ",", "3", ",", "1"}], "]"}], "."}]}], " ", 
   "*)"}]}]}], "Input",ExpressionUUID->"45dceaf6-dd4f-1f44-99e8-dee6767b139c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.5 Assemble and inspect the initial state", "Subsection",ExpressionUUID->"465412a8-9611-0a4d-927a-1173babb2d6e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"MemberQ", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\"\<Factorized\>\"", ",", "\"\<Full\>\""}], "}"}], ",", 
      "stateMode"}], "]"}], ",", "\"\<Invalid stateMode.\>\""}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"stateMode", "==", "\"\<Factorized\>\""}], ",", "\n", " ", 
    RowBox[{
     RowBox[{"edgeFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"edgeState", ",", "4", ",", "validationTolerance"}], "]"}]}], ";",
      "\n", " ", 
     RowBox[{"middleFactor", " ", "=", " ", 
      RowBox[{"stateFactor", "[", 
       RowBox[{"middleState", ",", 
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}], "-", "2"}], ")"}]}], ",",
         "validationTolerance"}], "]"}]}], ";", "\n", " ", 
     RowBox[{"fullFactor", " ", "=", " ", 
      RowBox[{"joinStates", "[", 
       RowBox[{"edgeFactor", ",", "middleFactor", ",", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", "\n", 
    " ", 
    RowBox[{"fullFactor", " ", "=", " ", 
     RowBox[{"stateFactor", "[", 
      RowBox[{"fullState", ",", 
       RowBox[{"2", "^", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], ",", 
       "validationTolerance"}], "]"}]}]}], "\n", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rhoEdge0", " ", "=", " ", 
    RowBox[{"reducedState", "[", 
     RowBox[{"fullFactor", ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
      RowBox[{"evoUsed", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Check", " ", "the", " ", "assembled", " ", "state"}], ",", " ", 
    RowBox[{"in", " ", "either", " ", "mode"}], ",", " ", 
    RowBox[{"including", " ", "pure", " ", "factorized", " ", 
     RowBox[{"inputs", "."}]}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Dimensions", "[", "fullFactor", "]"}], "[", 
      RowBox[{"[", "2", "]"}], "]"}], "==", "1"}], ",", "\n", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", "=", 
         RowBox[{"fullFactor", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"h", "=", 
         RowBox[{"evoED", "[", "\"\<Hamiltonian\>\"", "]"}]}]}], "}"}], ",", 
      "\n", "  ", 
      RowBox[{
       RowBox[{"initialEnergyResidual", "=", 
        RowBox[{"Norm", "[", 
         RowBox[{
          RowBox[{"h", ".", "v"}], "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Conjugate", "[", "v", "]"}], ".", "h", ".", "v"}], 
            ")"}], " ", "v"}]}], "]"}]}], ";", "\n", "  ", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"initialEnergyResidual", "<=", 
          RowBox[{"validationTolerance", " ", 
           RowBox[{"Max", "[", 
            RowBox[{"1.", ",", 
             RowBox[{"Norm", "[", 
              RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}]}], ",", "\n", 
         "   ", 
         RowBox[{"Print", "[", 
          RowBox[{"Style", "[", 
           
           RowBox[{"\"\<Initial state is an energy eigenstate within \
tolerance: reduced observables will be stationary.\>\"", ",", "DarkOrange"}], 
           "]"}], "]"}]}], "]"}]}]}], "]"}]}], "]"}], ";"}], "\n", 
 RowBox[{"MatrixForm", "[", "rhoEdge0", "]"}]}], "Input",ExpressionUUID->\
"11130515-e3a4-8a43-87ee-85581bfeae58"]
}, Open  ]],

Cell[CellGroupData[{

Cell["6.6 Prepare the evolution coefficients", "Subsection",ExpressionUUID->"225b3cc8-3f31-b347-bffb-8ebca57be67d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"engine", " ", "=", " ", 
   RowBox[{"makeEngine", "[", 
    RowBox[{"evoED", ",", "fullFactor"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Occupied sectors: \>\"", ",", 
    RowBox[{"Length", "[", 
     RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}], "]"}], ",", "\n", 
    " ", "\"\<; initial factor columns: \>\"", ",", 
    RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "]"}], ";"}]}], "Input",\
ExpressionUUID->"a8957abe-0c62-c84a-bd08-9e8e537e5950"]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["7. Evolution, observables, and exports", "Section",ExpressionUUID->"231502b5-baf9-ee4c-b2e6-ce59341f1ef8"],

Cell[CellGroupData[{

Cell["7.1 Generate the time grid", "Subsection",ExpressionUUID->"61f39122-84b7-7c49-a2f4-2ae0287bf7e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoTimeUsed", " ", "=", " ", "evoTime"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"times", " ", "=", " ", 
   RowBox[{"timeGrid", "[", "evoTimeUsed", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Time points: \>\"", ",", 
    RowBox[{"Length", "[", "times", "]"}], ",", "\"\<; last time: \>\"", ",", 
    RowBox[{"Last", "[", "times", " ", "]"}]}], "]"}], ";"}]}], "Input",Expres\
sionUUID->"e349a0c9-c4d6-2149-9eac-a3ff74a23053"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.2 Evolve and calculate edge observables", "Subsection",ExpressionUUID->"f3726f7d-901b-6b44-8593-b117517c7957"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{"evoUsed", "===", "evoModel"}], 
    ",", "\"\<Evolution parameters changed: rerun section 5.3 onward.\>\""}], 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"check", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"engine", "[", "\"\<Parameters\>\"", "]"}], "===", "evoUsed"}], 
    ",", "\"\<Engine belongs to another Hamiltonian: rerun section \
6.6.\>\""}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"evolutionSeconds", ",", "evoData"}], "}"}], " ", "=", " ", 
   RowBox[{"AbsoluteTiming", "[", "\n", " ", 
    RowBox[{"evolveChunks", "[", 
     RowBox[{
     "times", ",", "engine", ",", "rhoEdge0", ",", "validationTolerance", ",",
       "parallel"}], " ", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Evolution seconds: \>\"", ",", "evolutionSeconds"}], "]"}], 
  ";"}]}], "Input",ExpressionUUID->"ace93d14-cf34-454a-9d8a-e973bc7084c4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["7.3 Numerical checks", "Subsection",ExpressionUUID->"75670cba-4094-874c-bf0f-8b8cb6c9345a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"evoChecks", " ", "=", " ", 
   RowBox[{"<|", "\n", " ", 
    RowBox[{
     RowBox[{"\"\<InitialFactorError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"evolve", "[", 
          RowBox[{"0.", ",", "engine"}], "]"}], "-", "fullFactor"}], 
        ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", " ", 
     RowBox[{"\"\<InitialEdgeError\>\"", " ", "->", " ", 
      RowBox[{"Norm", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "evoData", "]"}], "[", "\"\<RhoAB\>\"", "]"}],
          "-", "rhoEdge0"}], ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", 
     " ", 
     RowBox[{"\"\<MaxTraceError\>\"", " ", "->", " ", 
      RowBox[{"Max", "[", 
       RowBox[{"Lookup", "[", 
        RowBox[{"evoData", ",", "\"\<TraceError\>\""}], "]"}], "]"}]}], ",", 
     "\n", " ", 
