Cell[CellGroupData[{

Cell["\<\
 4. Fixed-Delta ED: each sector independently, all eigenpairs retained \
\>", "Section",ExpressionUUID->"d724d572-f561-c048-b26c-985b48020606"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"fixedRun", " ", "=", " ", 
   RowBox[{"Catch", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"tag", ",", "groups", ",", "energySets"}], "}"}], ",", "\n", 
       "  ", 
       RowBox[{
        RowBox[{"tag", "=", 
         RowBox[{"runLabel", "<>", "\"\<_L\>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"model", "[", "\"\<L\>\"", "]"}], "]"}], "<>", "\"\<_J\>\"",
           "<>", 
          RowBox[{"XXZE`Token", "[", 
           RowBox[{"model", "[", "\"\<J\>\"", "]"}], "]"}], "<>", "\n", 
          "    ", "\"\<_h\>\"", "<>", 
          RowBox[{"XXZE`Token", "[", 
           RowBox[{"model", "[", "\"\<h\>\"", "]"}], "]"}], 
          "<>", "\"\<_bL\>\"", "<>", 
          RowBox[{"XXZE`Token", "[", 
           RowBox[{"model", "[", "\"\<bLeft\>\"", "]"}], "]"}], "<>", "\n", 
          "    ", "\"\<_bR\>\"", "<>", 
          RowBox[{"XXZE`Token", "[", 
           RowBox[{"model", "[", "\"\<bRight\>\"", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", "\n", "  ", 
        RowBox[{"runDirectory", "=", 
         RowBox[{"XXZE`NewDirectory", "[", 
          RowBox[{"outputRoot", ",", "tag"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"fixedEDSeconds", ",", "fixedED"}], "}"}], "=", 
         RowBox[{"AbsoluteTiming", "[", 
          RowBox[{"XXZE`Diagonalize", "[", 
           RowBox[{"deltaFixed", ",", "model", ",", "numerics"}], "]"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "fixedED", "]"}], ",", 
          RowBox[{"\"\<Fixed-Delta diagonalization failed: \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"fixedED", ",", "InputForm"}], "]"}]}]}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"fixedED", "=", 
         RowBox[{"XXZE`EigenstateEntropies", "[", "fixedED", "]"}]}], ";", 
        "\[IndentingNewLine]", "\n", "  ", 
        RowBox[{"sectorTable", "=", 
         RowBox[{"MapIndexed", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Sector\>\"", "->", 
               RowBox[{"First", "[", "#2", "]"}]}], ",", 
              RowBox[{"\"\<Labels\>\"", "->", 
               RowBox[{"#1", "[", "\"\<Labels\>\"", "]"}]}], ",", "\n", 
              "    ", 
              RowBox[{"\"\<Dimension\>\"", "->", 
               RowBox[{"#1", "[", "\"\<Dimension\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Emin\>\"", "->", 
               RowBox[{"First", "[", 
                RowBox[{"#1", "[", "\"\<Eigenvalues\>\"", "]"}], "]"}]}], ",",
               "\n", "    ", 
              RowBox[{"\"\<Emax\>\"", "->", 
