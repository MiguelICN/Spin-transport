                  RowBox[{"\"\<Indices\>\"", "->", "ids"}], ",", 
                  RowBox[{"\"\<Eigenvalues\>\"", "->", "e"}], ",", 
                  
                  RowBox[{"\"\<EigenvectorsInMagnetizationBasis\>\"", "->", 
