               "]"}]}], ",", "\n", "      ", 
             RowBox[{"{", 
              RowBox[{"s", ",", "spaces"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nDown", ",", "0", ",", "l"}], "}"}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Total", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"out", ",", "\"\<Dimension\>\""}], "]"}], "]"}], "==", 
