Cell[CellGroupData[{

Cell["\<\
 5. Delta sweep: spectra and both eigenstate entropies, equivalent sectors \
together \
\>", "Section",ExpressionUUID->"6b8ea457-c64f-9f4c-bc50-90b0ac9b2cab"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{
     "Every", " ", "sweep", " ", "point", " ", "computes", " ", "all", " ", 
      "eigenpairs", " ", "in", " ", "every", " ", 
      RowBox[{"sector", ".", " ", "Eigenvectors"}], " ", "are", "\n", "   ", 
      "used", " ", "to", " ", "compute", " ", "the", " ", "two", " ", 
      "entropies", " ", "and", " ", "then", " ", "released"}], ";", " ", 
     RowBox[{
      RowBox[{
      "the", " ", "compact", " ", "sweep", " ", "saves", "\n", "   ", 
       "energies", " ", "and", " ", 
       RowBox[{"entropies", ".", " ", "Full"}], " ", "vectors", " ", "at", " ",
        "deltaFixed", " ", "are", " ", "in", " ", 
       RowBox[{"fixedED", "/", "the"}], " ", 
       RowBox[{"WXF", ".", "\n", "   ", "Get"}], " ", "vectors", " ", "at", " ",
        "another", " ", "Delta", " ", "with", " ", 
       RowBox[{
        RowBox[{"XXZE`Diagonalize", "[", 
         RowBox[{"delta", ",", "model", ",", "numerics"}], "]"}], ".", "\n", 
        "   ", "At"}]}], " ", "+", 
      RowBox[{"/", 
       RowBox[{"-", "1"}]}]}]}], ",", " ", 
    RowBox[{
     RowBox[{"total", "-", 
      RowBox[{
      "spin", " ", "subblocks", " ", "are", " ", "merged", " ", "only", " ", 
       "for", " ", "the", " ", "Delta"}], "-", 
      RowBox[{"axis", " ", 
       RowBox[{"plots", ".", "\n", "   ", "Entropy"}], " ", "panels", " ", 
       "use", " ", "points", " ", "because", " ", "energy"}], "-", 
      RowBox[{
      "order", " ", "labels", " ", "need", " ", "not", " ", "track", " ", 
       "the", "\n", "   ", "same", " ", "eigenstate", " ", "through", " ", 
       RowBox[{"crossings", ".", " ", "Isospectral"}], " ", "grouping", " ", 
       "is", " ", "checked", " ", "on", " ", "the", "\n", "   ", "chosen", " ",
        "grid"}]}], ";", " ", 
     RowBox[{
     "it", " ", "is", " ", "not", " ", "a", " ", "proof", " ", "of", " ", 
      "equivalence", " ", "at", " ", "all", " ", "real", " ", 
      RowBox[{"Delta", "."}]}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"sweepRun", " ", "=", " ", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"TrueQ", "[", "runSweep", "]"}], " ", "&&", " ", 
        RowBox[{"AssociationQ", "[", "fixedRun", "]"}]}], ",", 
       RowBox[{"Catch", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"keys", ",", "valid", ",", "groups", ",", "dir"}], "}"}], 
           ",", "\n", "  ", 
           RowBox[{
            RowBox[{"XXZE`Require", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"Length", "[", "deltaSweep", "]"}], ">=", "2"}], " ", 
               "&&", " ", 
               RowBox[{"VectorQ", "[", 
                RowBox[{"deltaSweep", ",", "XXZE`RealQ"}], "]"}], " ", "&&", 
               "\n", "    ", 
               RowBox[{"And", "@@", 
                RowBox[{"Thread", "[", 
                 RowBox[{
                  RowBox[{"Differences", "[", 
                   RowBox[{"N", "[", "deltaSweep", "]"}], "]"}], ">", "0"}], 
                 "]"}]}]}], 
              ",", "\"\<deltaSweep must be a strictly increasing real list.\>\
\""}], "]"}], ";", "\n", "  ", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"sweepSeconds", ",", "sweepResults"}], "}"}], "=", 
             RowBox[{"AbsoluteTiming", "[", "\n", "    ", 
              RowBox[{"XXZE`ParallelSweep", "[", 
               RowBox[{
               "deltaSweep", ",", "model", ",", "numerics", ",", 
                "parallelSettings"}], "]"}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"XXZE`Require", "[", 
             RowBox[{
              RowBox[{"AllTrue", "[", 
               RowBox[{"sweepResults", ",", "AssociationQ"}], "]"}], 
              ",", "\"\<A Delta point failed; inspect sweepResults.\>\""}], 
             "]"}], ";", "\n", "  ", 
            RowBox[{"keys", "=", 
             RowBox[{"Keys", "[", 
              RowBox[{"First", "[", "sweepResults", "]"}], "]"}]}], ";", "\n",
             "  ", 
            RowBox[{"valid", "=", 
             RowBox[{"AllTrue", "[", 
              RowBox[{"sweepResults", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"Sort", "[", 
                   RowBox[{"Keys", "[", "#", "]"}], "]"}], "==", 
                  RowBox[{"Sort", "[", "keys", "]"}]}], " ", "&&", "\n", 
                 "    ", 
                 RowBox[{
                  RowBox[{"Total", "[", 
                   RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"#", " ", "[", "\"\<Energies\>\"", "]"}], "]"}], 
                    "&"}], " ", "/@", " ", 
                    RowBox[{"Values", "[", "#", "]"}]}], "]"}], "==", 
                  RowBox[{"2", "^", 
                   RowBox[{"model", "[", "\"\<L\>\"", "]"}]}]}]}], "&"}]}], 
              "]"}]}], ";", "\n", "  ", 
            RowBox[{"XXZE`Require", "[", 
             RowBox[{
             "valid", 
              ",", "\"\<The sweep has inconsistent sector labels or \
incomplete dimensions.\>\""}], "]"}], ";", "\n", "  ", 
            RowBox[{"groups", "=", 
             RowBox[{"Gather", "[", 
              RowBox[{"keys", ",", 
               RowBox[{
                RowBox[{"XXZE`IsospectralQ", "[", 
                 RowBox[{"#1", ",", "#2", ",", "sweepResults", ",", 
                  RowBox[{
                  "numerics", "[", "\"\<SpectrumMatchingTolerance\>\"", 
                   "]"}]}], "]"}], "&"}]}], "]"}]}], ";", "\n", "  ", 
            RowBox[{"dir", "=", 
             RowBox[{"XXZE`NewDirectory", "[", 
              RowBox[{"runDirectory", ",", "\"\<delta_sweep\>\""}], "]"}]}], ";",
             "\n", "  ", 
            RowBox[{"XXZE`SweepPlots", "[", 
             RowBox[{
             "sweepResults", ",", "deltaSweep", ",", "groups", ",", "model", ",",
               "plotSettings", ",", "dir"}], "]"}], ";", "\n", "  ", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", "saveData", "]"}], ",", 
              RowBox[{"XXZE`Save", "[", 
               RowBox[{
                RowBox[{"FileNameJoin", "[", 
                 RowBox[{"{", 
                  RowBox[{"dir", ",", "\"\<eigenstate_sweep.wxf\>\""}], "}"}],
                  "]"}], ",", "\n", "    ", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Model\>\"", "->", "model"}], ",", 
                  RowBox[{"\"\<DeltaGrid\>\"", "->", "deltaSweep"}], ",", 
                  RowBox[{"\"\<Seconds\>\"", "->", "sweepSeconds"}], ",", 
                  "\n", "      ", 
                  RowBox[{"\"\<SectorGroups\>\"", "->", "groups"}], ",", 
                  RowBox[{"\"\<Results\>\"", "->", "sweepResults"}]}], "|>"}],
                 ",", "\"\<WXF\>\""}], "]"}]}], "]"}], ";", "\n", "  ", 
            RowBox[{"Print", "[", 
             
             RowBox[{"\"\<Sweep seconds=\>\"", ",", "sweepSeconds", 
              ",", "\"\<; sectors=\>\"", ",", 
              RowBox[{"Length", "[", "keys", "]"}], ",", "\"\<; panels=\>\"", 
              ",", 
              RowBox[{"Length", "[", "groups", "]"}]}], "]"}], ";", "\n", 
            "  ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Directory\>\"", "->", "dir"}], ",", 
              RowBox[{"\"\<SectorGroups\>\"", "->", "groups"}]}], "|>"}]}]}], 
          "\n", "]"}], ",", "\"\<XXZFailure\>\""}], "]"}], ",", 
       RowBox[{"Missing", "[", "\"\<SweepSkipped\>\"", "]"}]}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"FailureQ", "[", "sweepRun", "]"}], ",", 
      RowBox[{"Print", "[", "sweepRun", "]"}]}], "]"}], ";"}], 
   "\n"}]}]], "Input",
 CellLabel->"In[77]:=",ExpressionUUID->"afdd7dc1-a656-3f48-9309-1715043e6394"],

