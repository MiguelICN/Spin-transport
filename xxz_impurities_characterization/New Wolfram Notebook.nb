Cell[CellGroupData[{

Cell["\<\
 2. Presentation, MaTeX labels, output files, and execution helpers \
\>", "Section",ExpressionUUID->"3e481cd1-64c3-b743-8f7e-6b6f6cbf7746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "This", " ", "section", " ", "contains", " ", "no", " ", "Hamiltonian", " ",
      "or", " ", "observable", " ", 
     RowBox[{"definitions", ".", "\n", "   ", "Chop"}], " ", "is", " ", 
     "applied", " ", "only", " ", "to", " ", "plotted", " ", "coordinates"}], 
    ",", " ", 
    RowBox[{"never", " ", "to", " ", "saved", " ", "raw", " ", 
     RowBox[{"data", ".", "\n", "   ", "Plot"}], " ", "captions", " ", 
     "carry", " ", "the", " ", "Hamiltonian", " ", "parameters"}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"not", " ", "initial"}], "-", 
      RowBox[{"state", " ", 
       RowBox[{"names", ".", "\n", "   ", "PNG"}], " ", "only"}]}], ";", " ", 
     RowBox[{"WXF", " ", "contains", " ", "numerical", " ", 
      RowBox[{"data", ".", " ", "A"}], " ", "numbered", " ", "rerun", " ", 
      "suffix", " ", "prevents", "\n", "   ", "overwriting"}]}], ",", " ", 
    RowBox[{
    "with", " ", "no", " ", "random", " ", "strings", " ", "or", " ", "times",
      " ", "in", " ", "the", " ", "folder", " ", 
     RowBox[{"name", "."}]}]}], " ", "*)"}], "\n", "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"XXZE`$TeXReady", "=", "Automatic"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`TeX", "[", 
      RowBox[{"s_String", ",", 
       RowBox[{"size_", ":", "16"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "g", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"XXZE`$TeXReady", "===", "Automatic"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"XXZE`$TeXReady", "=", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Needs", "[", "\"\<MaTeX`\>\"", "]"}], ";", "True"}], 
               ",", "False"}], "]"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"TrueQ", "[", "XXZE`$TeXReady", "]"}]}], ",", 
             RowBox[{
             "Print", 
              "[", "\"\<MaTeX unavailable; using native labels. Configure \
MaTeX as in the reference file.\>\"", "]"}]}], "]"}]}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", "XXZE`$TeXReady", "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"g", "=", 
            RowBox[{"Quiet", "[", 
             RowBox[{"Check", "[", 
              RowBox[{
               RowBox[{"MaTeX`MaTeX", "[", 
                RowBox[{"s", ",", 
                 RowBox[{"FontSize", "->", "size"}]}], "]"}], ",", 
               "$Failed"}], "]"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"MatchQ", "[", 
              RowBox[{"g", ",", "_Graphics"}], "]"}], ",", 
             RowBox[{"Return", "[", "g", "]"}]}], "]"}], ";", "\n", "    ", 
           RowBox[{"XXZE`$TeXReady", "=", "False"}], ";", 
           RowBox[{
           "Print", 
            "[", "\"\<MaTeX rendering failed; check TeX and Ghostscript \
configuration.\>\"", "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"Style", "[", 
         RowBox[{"s", ",", "Black", ",", 
          RowBox[{"FontFamily", "->", "\"\<Times\>\""}], ",", 
          RowBox[{"FontSize", "->", "size"}]}], "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`TeXNumber", "[", "x_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"s", ",", "parts"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", 
           RowBox[{"x", "==", "0"}], "]"}], ",", 
          RowBox[{"Return", "[", "\"\<0\>\"", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"TrueQ", "[", 
            RowBox[{"x", "==", 
             RowBox[{"Round", "[", "x", "]"}]}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "<", 
            RowBox[{"10", "^", "6"}]}]}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"ToString", "[", 
            RowBox[{"Round", "[", "x", "]"}], "]"}], "]"}]}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"s", "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"N", "[", "x", "]"}], ",", "InputForm"}], "]"}], ",", 
           RowBox[{
            RowBox[{"RegularExpression", "[", "\"\<`[0-9.]*\>\"", "]"}], 
            "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"parts", "=", 
         RowBox[{"StringSplit", "[", 
          RowBox[{"s", ",", "\"\<*^\>\""}], "]"}]}], ";", 
        RowBox[{
         RowBox[{"parts", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "=", 
         RowBox[{"StringReplace", "[", 
          RowBox[{
           RowBox[{"parts", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{"RegularExpression", "[", "\"\<\\\\.$\>\"", "]"}], 
            "->", "\"\<\>\""}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "parts", "]"}], "==", "2"}], ",", 
          RowBox[{
           RowBox[{"parts", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<>", "\"\<\\\\times 10^{\>\"", "<>", 
           RowBox[{"parts", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<>", "\"\<}\>\""}], ",", 
          RowBox[{"First", "[", "parts", "]"}]}], "]"}]}]}], "\n", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`Ticks", "[", 
      RowBox[{
       RowBox[{"lo_", "?", "NumericQ"}], ",", 
       RowBox[{"hi_", "?", "NumericQ"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"a", "=", "lo"}], ",", 
         RowBox[{"b", "=", "hi"}], ",", "pad"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"a", "==", "b"}], ",", 
          RowBox[{
           RowBox[{"pad", "=", 
            RowBox[{"Max", "[", 
             RowBox[{"1.", ",", 
              RowBox[{".05", " ", 
               RowBox[{"Abs", "[", "a", "]"}]}]}], "]"}]}], ";", 
           RowBox[{"a", "-=", "pad"}], ";", 
           RowBox[{"b", "+=", "pad"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"#", ",", 
             RowBox[{"XXZE`TeX", "[", 
              RowBox[{
               RowBox[{"XXZE`TeXNumber", "[", "#", "]"}], ",", "14"}], "]"}], 
             ",", 
             RowBox[{"{", 
              RowBox[{".012", ",", "0"}], "}"}]}], "}"}], "&"}], " ", "/@", 
          " ", 
          RowBox[{"FindDivisions", "[", 
           RowBox[{
