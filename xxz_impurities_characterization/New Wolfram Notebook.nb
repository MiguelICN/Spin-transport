           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"part", "==", "\"\<Abs\>\""}], ",", 
             RowBox[{"legends", "=", 
              RowBox[{"{", 
               
               RowBox[{"\"\<|\\\\rho_{A;01}|\>\"", 
                ",", "\"\<|\\\\rho_{B;01}|\>\""}], "}"}]}]}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"emit", "[", 
            RowBox[{
             RowBox[{"\"\<10_local_coherences_\>\"", "<>", "part"}], ",", 
             
             RowBox[{"\"\<\\\\text{Single-edge coherences: \>\"", "<>", 
              "part", "<>", "\"\<}\>\""}], ",", "\n", 
             "      ", "\"\<\\\\rho_{Q;01}(t)\>\"", ",", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"XXZE`MatrixSeries", "[", 
                RowBox[{
                "records", ",", "key", ",", "1", ",", "2", ",", "\n", 
                 "        ", 
                 RowBox[{"Switch", "[", 
                  RowBox[{
                  "part", ",", "\"\<Re\>\"", ",", "Re", ",", "\"\<Im\>\"", ",",
                    "Im", ",", "\"\<Abs\>\"", ",", "Abs"}], "]"}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"key", ",", 
                 RowBox[{"{", 
                  RowBox[{"\"\<RhoA\>\"", ",", "\"\<RhoB\>\""}], "}"}]}], 
                "}"}]}], "]"}], ",", "legends"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"{", 
           RowBox[{"part", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<Re\>\"", ",", "\"\<Im\>\"", ",", "\"\<Abs\>\""}], 
             "}"}]}], "}"}]}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Execution", " ", 
      RowBox[{"helpers", ":", " ", 
       RowBox[{"no", " ", "nested", " ", 
        RowBox[{"parallelism", ".", " ", "Sweep"}], " ", "points", " ", "are",
         " ", "parallel", " ", "tasks"}]}]}], ";", "\n", "   ", 
     RowBox[{
     "dynamics", " ", "uses", " ", "a", " ", "fixed", " ", "ED", " ", "with", 
      " ", "at", " ", "most", " ", "one", " ", "copied", " ", "engine", " ", 
      "per", " ", "time", " ", 
      RowBox[{"chunk", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`StartKernels", "[", "cfg_", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "available", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"TrueQ", "[", 
            RowBox[{"cfg", "[", "\"\<Enabled\>\"", "]"}], "]"}]}], ",", 
          RowBox[{"Return", "[", "0", "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"IntegerQ", "[", 
            RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "]"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ">=", "1"}]}], 
          ",", "\"\<Kernels must be a positive integer.\>\""}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"available", "=", 
         RowBox[{"Length", "[", 
          RowBox[{"Kernels", "[", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"available", "<", 
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
          RowBox[{"Quiet", "[", 
           RowBox[{"LaunchKernels", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], "-", "available"}],
             "]"}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"available", "=", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], ",", 
           RowBox[{"Length", "[", 
            RowBox[{"Kernels", "[", "]"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"available", "<", 
           RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}]}], ",", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Available parallel kernels: \>\"", ",", "available", ",",
             "\n", "    ", "\"\< (requested \>\"", ",", 
            RowBox[{"cfg", "[", "\"\<Kernels\>\"", "]"}], 
            ",", "\"\<). Check the local Mathematica kernel/license \
configuration.\>\""}], "]"}]}], "]"}], ";", "\n", "  ", "available"}]}], "\n",
       "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`ParallelSweep", "[", 
      RowBox[{"grid_", ",", "p_", ",", "num_", ",", "cfg_"}], "]"}], " ", ":=",
      " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "chunks", ",", "jobs", ",", "res"}], "}"}], ",", 
       "\n", "  ", 
       RowBox[{
        RowBox[{"n", "=", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Length", "[", "grid", "]"}], ",", 
           RowBox[{"XXZE`StartKernels", "[", "cfg", "]"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "2"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<Eigenstate sweep: serial.\>\"", "]"}], ";", 
           RowBox[{"Return", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"XXZE`SweepPoint", "[", 
               RowBox[{"#", ",", "p", ",", "num"}], "]"}], "&"}], " ", "/@", 
             " ", "grid"}], "]"}]}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"DistributeDefinitions", "[", "XXZE`SweepPoint", "]"}], ";", 
        "\n", "  ", 
        RowBox[{"chunks", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"grid", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"Length", "[", "grid", "]"}], "/", "n"}]}], "]"}]}],
               ";;", 
              RowBox[{"Floor", "[", 
               RowBox[{"k", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "grid", "]"}], "/", "n"}]}], "]"}]}], 
             "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Eigenstate sweep: \>\"", ",", "n", 
          ",", "\"\< parallel Delta chunks.\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"jobs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"gg", "=", "g"}], ",", 
               RowBox[{"pp", "=", "p"}], ",", 
               RowBox[{"nn", "=", "num"}]}], "}"}], ",", 
             RowBox[{"ParallelSubmit", "[", "\n", "    ", 
              RowBox[{
               RowBox[{
                RowBox[{"XXZE`SweepPoint", "[", 
                 RowBox[{"#", ",", "pp", ",", "nn"}], "]"}], "&"}], " ", "/@",
                " ", "gg"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"g", ",", "chunks"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"res", "=", 
         RowBox[{"WaitAll", "[", "jobs", "]"}]}], ";", 
        RowBox[{"Flatten", "[", 
         RowBox[{"res", ",", "1"}], "]"}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`ParallelTimes", "[", 
      RowBox[{
      "times_", ",", "engine_", ",", "rho0_", ",", "num_", ",", "cfg_"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "n", ",", "reserve", ",", "limit", ",", "chunks", ",", "jobs", ",", 
         "packets", ",", "records", ",", "reference", ",", "error"}], "}"}], ",",
        "\n", "  ", 
       RowBox[{
        RowBox[{"reserve", "=", 
         RowBox[{
          RowBox[{"4.", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"ByteCount", "[", "engine", "]"}], "+", 
             RowBox[{"ByteCount", "[", "rho0", "]"}]}], ")"}]}], "+", 
          RowBox[{"256.", " ", 
           RowBox[{"1024.", "^", "2"}]}]}]}], ";", "\n", "  ", 
        RowBox[{"limit", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1", ",", 
           RowBox[{"Floor", "[", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<MemoryBudgetGB\>\"", "]"}], " ", 
             RowBox[{
              RowBox[{"1024.", "^", "3"}], "/", "reserve"}]}], "]"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"n", "=", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"Length", "[", "times", "]"}], ",", "limit", ",", 
           RowBox[{"XXZE`StartKernels", "[", "cfg", "]"}]}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"n", "<", "2"}], ",", 
          RowBox[{
           RowBox[{"Print", "[", "\"\<Time evolution: serial.\>\"", "]"}], ";",
            "\n", "    ", 
           RowBox[{"packets", "=", 
            RowBox[{"XXZE`TimeChunk", "[", 
             RowBox[{"times", ",", "engine", ",", "rho0", ",", 
              RowBox[{"num", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"XXZE`Require", "[", 
            RowBox[{
             RowBox[{"AssociationQ", "[", "packets", "]"}], 
             ",", "\"\<Serial time evolution failed.\>\""}], "]"}], ";", "\n",
            "    ", 
           RowBox[{"Return", "[", 
            RowBox[{"packets", "[", "\"\<Results\>\"", "]"}], "]"}]}]}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"DistributeDefinitions", "[", "XXZE`TimeChunk", "]"}], ";", 
        "\n", "  ", 
        RowBox[{"chunks", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"times", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"1", "+", 
               RowBox[{"Floor", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}], " ", 
                 RowBox[{
                  RowBox[{"Length", "[", "times", "]"}], "/", "n"}]}], 
                "]"}]}], ";;", 
              RowBox[{"Floor", "[", 
               RowBox[{"k", " ", 
                RowBox[{
                 RowBox[{"Length", "[", "times", "]"}], "/", "n"}]}], "]"}]}],
              "]"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "n"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Time evolution: \>\"", ",", "n", 
          ",", "\"\< parallel chunks; \>\"", ",", 
          RowBox[{"Length", "[", "times", "]"}], ",", "\"\< samples.\>\""}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"jobs", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"tt", "=", "t"}], ",", 
               RowBox[{"ee", "=", "engine"}], ",", 
               RowBox[{"rr", "=", "rho0"}], ",", 
               RowBox[{"tol", "=", 
                RowBox[{"num", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}], 
              "}"}], ",", "\n", "    ", 
             RowBox[{"ParallelSubmit", "[", 
              RowBox[{"XXZE`TimeChunk", "[", 
               RowBox[{"tt", ",", "ee", ",", "rr", ",", "tol"}], "]"}], 
              "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "chunks"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"packets", "=", 
         RowBox[{"WaitAll", "[", "jobs", "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{"AllTrue", "[", 
           RowBox[{"packets", ",", "AssociationQ"}], "]"}], 
          ",", "\"\<A parallel time chunk failed.\>\""}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"records", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"packets", ",", "\"\<Results\>\""}], "]"}], ",", "1"}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Lookup", "[", 
            RowBox[{"records", ",", "\"\<Time\>\""}], "]"}], "===", "times"}],
           ",", "\"\<Parallel time ordering failed.\>\""}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"reference", "=", 
         RowBox[{"XXZE`TimeChunk", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"First", "[", "times", "]"}], ",", 
             RowBox[{"Last", "[", "times", "]"}]}], "}"}], ",", "engine", ",",
            "rho0", ",", 
           RowBox[{"num", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{"AssociationQ", "[", "reference", "]"}], 
          ",", "\"\<Serial endpoint validation failed.\>\""}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"error", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"MapThread", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Norm", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "[", "\"\<RhoAB\>\"", "]"}], "-", 
                RowBox[{"#2", "[", "\"\<RhoAB\>\"", "]"}]}], 
               ",", "\"\<Frobenius\>\""}], "]"}], "&"}], ",", "\n", "    ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"First", "[", "records", "]"}], ",", 
                RowBox[{"Last", "[", "records", "]"}]}], "}"}], ",", 
              RowBox[{"reference", "[", "\"\<Results\>\"", "]"}]}], "}"}]}], 
           "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{"error", "<", 
           RowBox[{"num", "[", "\"\<ValidationTolerance\>\"", "]"}]}], 
          ",", "\"\<Parallel/serial endpoint mismatch.\>\""}], "]"}], ";", 
        "\n", "  ", "records"}]}], "\n", "]"}]}], ";"}], "\n"}]}]], "Input",
 CellLabel->"In[44]:=",ExpressionUUID->"1bcc3a1f-8457-e34e-88ae-1f72a3943ab4"]
}, Closed]],

