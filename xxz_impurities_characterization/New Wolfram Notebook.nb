                  RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}], "]"}]}], 
             "]"}]}], ";", "\n", "    ", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Basis\>\"", "->", 
              RowBox[{"b", ".", 
               RowBox[{"Transpose", "[", "rows", "]"}]}]}], ",", 
             RowBox[{"\"\<Labels\>\"", "->", 
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", "\n", 
                "      ", 
                RowBox[{
                 RowBox[{"Switch", "[", 
                  RowBox[{
                  "name", ",", "\"\<S2\>\"", ",", "\"\<S\>\"", 
                   ",", "\"\<StaggeredS2\>\"", ",", "\"\<StaggeredS\>\"", ",",
                    "_", ",", "name"}], "]"}], "->", "label"}]}], "]"}]}]}], 
            "|>"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"g", ",", "groups"}], "}"}]}], "]"}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
