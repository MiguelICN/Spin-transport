        RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], "/", 
       RowBox[{"Sqrt", "[", "2", "]"}]}]}], ";", "   ", 
     RowBox[{"(*", " ", 
      RowBox[{"Bell", " ", "pair"}], " ", "*)"}], "\n", "   ", 
     RowBox[{
      RowBox[{"edgeInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}]}], ";", 
     "           ", 
     RowBox[{"(*", " ", 
      RowBox[{"|", 
       RowBox[{"10", ">"}]}], " ", "*)"}], "\n", "   ", 
     RowBox[{
      RowBox[{"edgeInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "4", "]"}], "/", "4"}]}], ";", " ", 
     RowBox[{"(*", " ", 
      RowBox[{"Mixed", " ", "edges"}], " ", "*)"}], "\n", "\n", "   ", 
     RowBox[{
      RowBox[{"Middle", " ", 
       RowBox[{"alternatives", ":", "\n", "   ", 
        RowBox[{"middleInitial", "[", 
         RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}]}]}], " ", ":=", " ", 
      RowBox[{"XXZE`ProductKet", "[", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "0"}], "}"}], ",", 
         RowBox[{
          RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}]}], "]"}], "]"}]}], 
     ";", "\n", "   ", 
     RowBox[{
      RowBox[{"middleInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{"XXZE`HelixKet", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"p", "[", "\"\<L\>\"", "]"}], "-", "2"}], ",", 
        RowBox[{"Pi", "/", "3"}]}], "]"}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"middleInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      "myMiddleState"}], ";", "\n", "\n", "   ", 
     RowBox[{
      RowBox[{"Full", "-", 
       RowBox[{"state", " ", 
        RowBox[{"examples", ":", " ", 
         RowBox[{"set", " ", 
          RowBox[{"initialStateSettings", "[", "\"\<Mode\>\"", "]"}]}]}]}]}], 
      "=", 
      RowBox[{
       RowBox[{"\"\<Full\>\"", " ", 
        RowBox[{"first", ".", "\n", "   ", 
         RowBox[{"fullInitial", "[", 
          RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}]}]}], " ", ":=", 
       " ", 
       RowBox[{"XXZE`Eigenvector", "[", 
        RowBox[{"ed", ",", "3", ",", "1"}], "]"}]}]}], ";", "\n", "     ", 
     RowBox[{"(*", " ", 
      RowBox[{
       RowBox[{"sector", " ", "3"}], ",", " ", 
       RowBox[{
        RowBox[{"first", " ", "eigenvector"}], ";", " ", 
        RowBox[{
        "inspect", " ", "sectorTable", " ", "for", " ", "its", " ", 
         "labels"}]}]}], " ", "*)"}], "\n", "   ", 
     RowBox[{
      RowBox[{"fullInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{"XXZE`NeelKet", "[", 
       RowBox[{"p", "[", "\"\<L\>\"", "]"}], "]"}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"fullInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{"XXZE`HelixKet", "[", 
       RowBox[{
        RowBox[{"p", "[", "\"\<L\>\"", "]"}], ",", 
        RowBox[{"Pi", "/", "3"}]}], "]"}]}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"fullInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      "myFullState"}], ";", "\n", "   ", 
     RowBox[{
      RowBox[{"fullInitial", "[", 
       RowBox[{"delta_", ",", "p_", ",", "ed_"}], "]"}], " ", ":=", " ", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", 
        RowBox[{"2", "^", 
         RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], "]"}], "/", 
       RowBox[{"2", "^", 
        RowBox[{"p", "[", "\"\<L\>\"", "]"}]}]}]}], ";", "\n", "   ", 
     RowBox[{
     "A", " ", "normalized", " ", "eigenvector", " ", "evolves", " ", "only", 
      " ", "by", " ", "a", " ", "phase"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"so", " ", "all", " ", "its", " ", "reduced"}], "-", 
      RowBox[{"state", "\n", "   ", "observables", " ", "are", " ", 
       RowBox[{"stationary", ".", " ", "Degenerate"}], " ", "ground"}], "-", 
      RowBox[{
      "state", " ", "selection", " ", "is", " ", "the", " ", "first", "\n", 
       "   ", "vector", " ", "in", " ", "the", " ", "first", " ", "lowest"}], 
      "-", 
      RowBox[{"energy", " ", "sector"}]}], ";", " ", 
     RowBox[{"choose", " ", "another", " ", "explicitly", " ", "if", " ", 
      RowBox[{"needed", "."}]}]}]}], "\n", "*)"}]}]}], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"da02541d-3eb8-0e42-a652-de719883dbba"],

Cell[BoxData[
 RowBox[{
  RowBox[{"timeSettings", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<Grid\>\"", " ", "->", " ", "\"\<Linear\>\""}], ",", 
     "        ", 
     RowBox[{"(*", " ", 
      RowBox[{"Linear", " ", "or", " ", "Log"}], " ", "*)"}], "\n", "  ", 
     RowBox[{"\"\<tMax\>\"", " ", "->", " ", "200."}], ",", "\n", "  ", 
     RowBox[{"\"\<dt\>\"", " ", "->", " ", "0.05"}], ",", "\n", "  ", 
     RowBox[{"\"\<tMinPositive\>\"", " ", "->", " ", "0.01"}], ",", "    ", 
     RowBox[{"(*", " ", 
      RowBox[{"Used", " ", "only", " ", "for", " ", "Log"}], " ", "*)"}], 
     "\n", "  ", 
     RowBox[{"\"\<LogPoints\>\"", " ", "->", " ", "501"}]}], "         ", 
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Positive", " ", "log", " ", "points"}], ";", " ", 
      RowBox[{"t", "=", 
       RowBox[{"0", " ", "is", " ", "also", " ", "included"}]}]}], " ", 
     "*)"}], "\n", "|>"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0005234596678467`*^9, 4.0005234942860527`*^9}},
