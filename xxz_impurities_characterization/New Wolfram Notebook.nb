Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"State", " ", 
    RowBox[{"constructors", ":", " ", 
     RowBox[{
      RowBox[{
      "pure", " ", "vectors", " ", "or", " ", "arbitrary", " ", "positive", " ",
        "density", " ", "matrices", "\n", "   ", "are", " ", "accepted", " ", 
       RowBox[{"below", ".", " ", "ProductKet"}], " ", "normalizes", " ", 
       "each", " ", "local", " ", "two"}], "-", 
      RowBox[{"component", " ", 
       RowBox[{"vector", "."}]}]}]}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`ProductKet", "[", "locals_List", "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "v", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "locals", "]"}], ">", "0"}], " ", "&&", 
           " ", 
           RowBox[{"AllTrue", "[", 
            RowBox[{"locals", ",", "\n", "    ", 
             RowBox[{
              RowBox[{
               RowBox[{"VectorQ", "[", 
                RowBox[{"#", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
               RowBox[{
                RowBox[{"Length", "[", "#", "]"}], "==", "2"}], " ", "&&", 
               " ", 
               RowBox[{
                RowBox[{"Norm", "[", "#", "]"}], ">", "0"}]}], "&"}]}], 
            "]"}]}], ",", "\n", 
          "    ", "\"\<ProductKet requires nonzero two-component local \
vectors.\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"v", "=", 
         RowBox[{"Fold", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Flatten", "[", 
             RowBox[{"KroneckerProduct", "[", 
              RowBox[{"#1", ",", 
               RowBox[{"N", "[", 
                RowBox[{"#2", "/", 
                 RowBox[{"Norm", "[", "#2", "]"}]}], "]"}]}], "]"}], "]"}], 
            "&"}], ",", " ", 
           RowBox[{"{", "1.", "}"}], ",", " ", "locals"}], "]"}]}], ";", " ", 
        RowBox[{"v", "/", 
         RowBox[{"Norm", "[", "v", "]"}]}]}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`NeelKet", "[", "n_Integer", "]"}], " ", ":=", " ", 
     RowBox[{"XXZE`ProductKet", "[", "\n", "  ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"OddQ", "[", "k", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "1"}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`HelixKet", "[", 
      RowBox[{"n_Integer", ",", 
       RowBox[{"q_", "?", "NumericQ"}], ",", 
       RowBox[{"theta_", ":", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{"phi_", ":", "0"}]}], "]"}], " ", ":=", " ", 
     RowBox[{"XXZE`ProductKet", "[", "\n", "  ", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"theta", "/", "2"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"I", 
             RowBox[{"(", 
              RowBox[{"phi", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}], "q"}]}], ")"}]}], "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"theta", "/", "2"}], "]"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"HelixKet", " ", "is", " ", "a", " ", "preparation"}], ",", " ", 
     RowBox[{
     "not", " ", "a", " ", "claim", " ", "that", " ", "it", " ", "is", " ", 
      "an", " ", "eigenstate", " ", "of", " ", "this", "\n", "   ", "open", " ",
       "Hermitian", " ", 
      RowBox[{"Hamiltonian", ".", " ", "No"}], " ", "tuned", " ", 
      "transverse", " ", "boundary", " ", "fields", " ", "are", " ", 
      RowBox[{"added", "."}]}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`StateFactor", "[", 
      RowBox[{
      "input_", ",", " ", "dim_Integer", ",", " ", "tol_", ",", " ", 
       "label_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "=", 
          RowBox[{"N", "[", 
           RowBox[{"Normal", "[", "input", "]"}], "]"}]}], ",", "e", ",", "v",
          ",", "keep", ",", "fac"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"VectorQ", "[", 
           RowBox[{"x", ",", "NumericQ"}], "]"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"XXZE`Require", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "x", "]"}], "==", "dim"}], " ", "&&", 
              " ", 
              RowBox[{
               RowBox[{"Norm", "[", "x", "]"}], ">", "0"}]}], ",", 
             RowBox[{"label", "<>", "\"\< has an invalid vector.\>\""}]}], 
            "]"}], ";", "\n", "    ", 
           RowBox[{"Return", "[", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"x", "/", 
               RowBox[{"Norm", "[", "x", "]"}]}], "}"}], "]"}], "]"}]}]}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"MatrixQ", "[", 
            RowBox[{"x", ",", "NumericQ"}], "]"}], " ", "&&", " ", 
           RowBox[{
            RowBox[{"Dimensions", "[", "x", "]"}], "==", 
            RowBox[{"{", 
             RowBox[{"dim", ",", "dim"}], "}"}]}]}], ",", "\n", "    ", 
          RowBox[{
          "label", 
           "<>", "\"\< must be a vector or density matrix of the required \
dimension.\>\""}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Norm", "[", 
             RowBox[{
              RowBox[{"x", "-", 
               RowBox[{"ConjugateTranspose", "[", "x", "]"}]}], 
              ",", "\"\<Frobenius\>\""}], "]"}], "<=", "tol"}], " ", "&&", 
           " ", 
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Tr", "[", "x", "]"}], "-", "1"}], "]"}], "<=", 
            "tol"}]}], ",", "\n", "    ", 
          RowBox[{
          "label", 
           "<>", "\"\< density matrix must be Hermitian with trace \
one.\>\""}]}], "]"}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"XXZE`Hermitian", "[", "x", "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Min", "[", 
            RowBox[{"Re", "[", "e", "]"}], "]"}], ">=", 
           RowBox[{"-", "tol"}]}], ",", 
          RowBox[{
          "label", 
           "<>", "\"\< density matrix has a negative eigenvalue.\>\""}]}], 
         "]"}], ";", "\n", "  ", 
        RowBox[{"e", "=", 
         RowBox[{"Clip", "[", 
          RowBox[{
           RowBox[{"Re", "[", "e", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "Infinity"}], "}"}]}], "]"}]}], ";", 
        RowBox[{"e", "=", 
         RowBox[{"e", "/", 
          RowBox[{"Total", "[", "e", "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"keep", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Range", "[", "dim", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"e", "[", 
              RowBox[{"[", "#", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], ";",
         "\n", "  ", 
        RowBox[{"fac", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{
           RowBox[{"Sqrt", "[", 
            RowBox[{"e", "[", 
             RowBox[{"[", "keep", "]"}], "]"}], "]"}], " ", 
           RowBox[{"v", "[", 
            RowBox[{"[", "keep", "]"}], "]"}]}], "]"}]}], ";", "fac"}]}], 
      "\n", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Tensor", " ", "order", " ", "AB"}], ",", 
     RowBox[{
     "E", " ", "is", " ", "rearranged", " ", "into", " ", "the", " ", 
      "physical", " ", "order", " ", "1"}], ",", "2", ",", "...", ",", 
     RowBox[{"L", "."}]}], " ", "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`JoinEdgeMiddle", "[", 
      RowBox[{
      "edgeFactor_", ",", " ", "middleFactor_", ",", " ", "l_Integer"}], 
      "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "a", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{"edgeFactor", ",", "middleFactor"}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"ArrayReshape", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{
            RowBox[{"ArrayReshape", "[", 
             RowBox[{"a", ",", 
              RowBox[{"{", 
               RowBox[{"2", ",", "2", ",", 
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{"l", "-", "2"}], ")"}]}], ",", 
                RowBox[{
                 RowBox[{"Dimensions", "[", "a", "]"}], "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "}"}]}], "]"}], ",", "\n", 
            "    ", 
            RowBox[{"{", 
             RowBox[{"1", ",", "3", ",", "2", ",", "4"}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"2", "^", "l"}], ",", 
