Cell[CellGroupData[{

Cell["\<\
 7. Evolve at deltaFixed, calculate edge observables, export MaTeX PNGs \
\>", "Section",ExpressionUUID->"2bdf1d6a-dce7-3347-b1aa-c7dd7b94bf7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dynamicsRun", " ", "=", " ", 
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{"AssociationQ", "[", "fixedRun", "]"}], ",", 
     RowBox[{"Catch", "[", 
      RowBox[{
       RowBox[{"Module", "[", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "fac", ",", "ef", ",", "mf", ",", "input", ",", "engine", ",", 
           "rho0", ",", "times", ",", "checks", ",", "dir", ",", "a0", ",", 
           "aEnd", ",", "initialRecord", ",", "purityFull"}], "}"}], ",", 
         "\n", "  ", 
         RowBox[{
          RowBox[{"XXZE`Require", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"fixedED", "[", "\"\<Parameters\>\"", "]"}], "===", 
              "model"}], " ", "&&", " ", 
             RowBox[{"TrueQ", "[", 
              RowBox[{
               RowBox[{"fixedED", "[", "\"\<Delta\>\"", "]"}], "==", 
               "deltaFixed"}], "]"}]}], ",", "\n", 
            "    ", "\"\<Model or Delta changed: rerun section 4 before \
dynamics.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"times", "=", 
           RowBox[{"XXZE`TimeGrid", "[", "timeSettings", "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"Switch", "[", 
           RowBox[{
            RowBox[{"initialStateSettings", "[", "\"\<Mode\>\"", "]"}], ",", 
            "\n", "    ", "\"\<Factorized\>\"", ",", "\n", "      ", 
            RowBox[{
             RowBox[{"input", "=", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Edge\>\"", "->", 
                 RowBox[{"edgeInitial", "[", 
                  RowBox[{"deltaFixed", ",", "model", ",", "fixedED"}], 
                  "]"}]}], ",", "\n", "        ", 
                RowBox[{"\"\<Middle\>\"", "->", 
                 RowBox[{"middleInitial", "[", 
                  RowBox[{"deltaFixed", ",", "model", ",", "fixedED"}], 
                  "]"}]}]}], "|>"}]}], ";", "\n", "      ", 
             RowBox[{"ef", "=", 
              RowBox[{"XXZE`StateFactor", "[", 
               RowBox[{
                RowBox[{"input", "[", "\"\<Edge\>\"", "]"}], ",", "4", ",", 
                RowBox[{"numerics", "[", "\"\<ValidationTolerance\>\"", "]"}],
                 ",", "\"\<Edges\>\""}], "]"}]}], ";", "\n", "      ", 
             RowBox[{"mf", "=", 
              RowBox[{"XXZE`StateFactor", "[", 
               RowBox[{
                RowBox[{"input", "[", "\"\<Middle\>\"", "]"}], ",", 
                RowBox[{"2", "^", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"model", "[", "\"\<L\>\"", "]"}], "-", "2"}], 
                  ")"}]}], ",", 
                RowBox[{"numerics", "[", "\"\<ValidationTolerance\>\"", "]"}],
                 ",", "\"\<Middle\>\""}], "]"}]}], ";", "\n", "      ", 
             RowBox[{"fac", "=", 
              RowBox[{"XXZE`JoinEdgeMiddle", "[", 
               RowBox[{"ef", ",", "mf", ",", 
                RowBox[{"model", "[", "\"\<L\>\"", "]"}]}], "]"}]}]}], ",", 
            "\n", "    ", "\"\<Full\>\"", ",", "\n", "      ", 
            RowBox[{
             RowBox[{"input", "=", 
              RowBox[{"<|", 
               RowBox[{"\"\<Full\>\"", "->", 
                RowBox[{"fullInitial", "[", 
                 RowBox[{"deltaFixed", ",", "model", ",", "fixedED"}], 
                 "]"}]}], "|>"}]}], ";", "\n", "      ", 
             RowBox[{"fac", "=", 
              RowBox[{"XXZE`StateFactor", "[", 
               RowBox[{
                RowBox[{"input", "[", "\"\<Full\>\"", "]"}], ",", 
                RowBox[{"2", "^", 
                 RowBox[{"model", "[", "\"\<L\>\"", "]"}]}], ",", 
                RowBox[{"numerics", "[", "\"\<ValidationTolerance\>\"", "]"}],
                 ",", "\"\<Full system\>\""}], "]"}]}]}], ",", "\n", "    ", 
            "_", ",", 
            RowBox[{"XXZE`Require", "[", 
             RowBox[{
             "False", 
              ",", "\"\<Initial mode must be Factorized or Full.\>\""}], 
             "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"rho0", "=", 
           RowBox[{"XXZE`ReducedFactor", "[", 
            RowBox[{"fac", ",", 
             RowBox[{"{", 
              RowBox[{"1", ",", 
               RowBox[{"model", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
             RowBox[{"model", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", "\n", 
          "  ", 
          RowBox[{"engine", "=", 
           RowBox[{"XXZE`EvolutionEngine", "[", 
            RowBox[{"fixedED", ",", "fac"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dynamicsSeconds", ",", "dynamicsResults"}], "}"}], "=", 
           RowBox[{"AbsoluteTiming", "[", "\n", "    ", 
            RowBox[{"XXZE`ParallelTimes", "[", 
             RowBox[{
             "times", ",", "engine", ",", "rho0", ",", "numerics", ",", 
              "parallelSettings"}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"XXZE`Require", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ListQ", "[", "dynamicsResults", "]"}], " ", "&&", " ", 
             RowBox[{"AllTrue", "[", 
              RowBox[{"dynamicsResults", ",", "AssociationQ"}], "]"}]}], ",", 
            "\n", "    ", "\"\<Time evolution returned an invalid \
result.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"a0", "=", 
           RowBox[{"XXZE`Evolve", "[", 
            RowBox[{"0.", ",", "engine"}], "]"}]}], ";", 
          RowBox[{"aEnd", "=", 
           RowBox[{"XXZE`Evolve", "[", 
            RowBox[{
             RowBox[{"Last", "[", "times", "]"}], ",", "engine"}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"checks", "=", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<InitialFactorError\>\"", "->", 
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{"a0", "-", "fac"}], ",", "\"\<Frobenius\>\""}], 
               "]"}]}], ",", "\n", "    ", 
             RowBox[{"\"\<InitialEdgeError\>\"", "->", 
              RowBox[{"Norm", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"First", "[", "dynamicsResults", "]"}], 
                  "[", "\"\<RhoAB\>\"", "]"}], "-", "rho0"}], 
                ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "    ", 
             RowBox[{"\"\<MaxTraceError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"dynamicsResults", ",", "\"\<TraceError\>\""}], "]"}],
                "]"}]}], ",", "\n", "    ", 
             RowBox[{"\"\<MaxHermiticityError\>\"", "->", 
              RowBox[{"Max", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"dynamicsResults", ",", "\"\<HermiticityError\>\""}], 
                "]"}], "]"}]}], ",", "\n", "    ", 
             RowBox[{"\"\<MinEigenvalue\>\"", "->", 
              RowBox[{"Min", "[", 
               RowBox[{"Lookup", "[", 
                RowBox[{"dynamicsResults", ",", "\"\<MinEigenvalue\>\""}], 
                "]"}], "]"}]}], ",", "\n", "    ", 
             RowBox[{"\"\<EndpointNormError\>\"", "->", 
              RowBox[{"Abs", "[", 
               RowBox[{
                RowBox[{"Tr", "[", 
                 RowBox[{
                  RowBox[{"ConjugateTranspose", "[", "aEnd", "]"}], ".", 
                  "aEnd"}], "]"}], "-", "1."}], "]"}]}]}], "|>"}]}], ";", 
          "\n", "  ", 
          RowBox[{"XXZE`Require", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"Max", "[", 
               RowBox[{"Values", "[", 
                RowBox[{"KeyDrop", "[", 
                 RowBox[{"checks", ",", "\"\<MinEigenvalue\>\""}], "]"}], 
                "]"}], "]"}], "<", 
              RowBox[{"numerics", "[", "\"\<ValidationTolerance\>\"", "]"}]}],
              " ", "&&", "\n", "    ", 
             RowBox[{
              RowBox[{"checks", "[", "\"\<MinEigenvalue\>\"", "]"}], ">=", 
              RowBox[{"-", 
               RowBox[{
               "numerics", "[", "\"\<ValidationTolerance\>\"", "]"}]}]}]}], ",",
             "\"\<Dynamics validation failed.\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"purityFull", "=", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "fac", "]"}], ".", "fac"}],
                ")"}], ".", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"ConjugateTranspose", "[", "fac", "]"}], ".", "fac"}],
                ")"}]}], "]"}], "]"}]}], ";", "\n", "  ", 
          RowBox[{"dir", "=", 
           RowBox[{"XXZE`NewDirectory", "[", 
            RowBox[{"runDirectory", ",", 
             RowBox[{"\"\<dynamics_Delta\>\"", "<>", 
              RowBox[{"XXZE`Token", "[", "deltaFixed", "]"}]}]}], "]"}]}], ";",
           "\n", "  ", 
          RowBox[{"XXZE`Save", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", "\"\<initial_states.wxf\>\""}], "}"}], 
             "]"}], ",", "\n", "    ", 
            RowBox[{"<|", 
             RowBox[{
              RowBox[{"\"\<Mode\>\"", "->", 
               RowBox[{"initialStateSettings", "[", "\"\<Mode\>\"", "]"}]}], ",", 
              RowBox[{"\"\<Inputs\>\"", "->", "input"}], ",", 
              RowBox[{"\"\<FullStateFactor\>\"", "->", "fac"}], ",", 
              RowBox[{"\"\<RhoAB0\>\"", "->", "rho0"}]}], "|>"}], 
            ",", "\"\<WXF\>\""}], "]"}], ";", "\n", "  ", 
          RowBox[{"XXZE`Save", "[", 
           RowBox[{
            RowBox[{"FileNameJoin", "[", 
             RowBox[{"{", 
              RowBox[{"dir", ",", "\"\<parameters.txt\>\""}], "}"}], "]"}], ",", 
            RowBox[{"ToString", "[", "\n", "    ", 
             RowBox[{
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Model\>\"", "->", "model"}], ",", 
                RowBox[{"\"\<Delta\>\"", "->", "deltaFixed"}], ",", 
                RowBox[{"\"\<TimeSettings\>\"", "->", "timeSettings"}], ",", 
                RowBox[{"\"\<TimeGrid\>\"", "->", "times"}], ",", "\n", 
                "      ", 
                RowBox[{"\"\<StateMode\>\"", "->", 
                 RowBox[{"initialStateSettings", "[", "\"\<Mode\>\"", "]"}]}],
                 ",", 
                RowBox[{"\"\<GlobalPurity\>\"", "->", "purityFull"}], ",", 
                "\n", "      ", 
                RowBox[{"\"\<StateDefinitions\>\"", "->", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"DownValues", "[", "edgeInitial", "]"}], ",", 
                   RowBox[{"DownValues", "[", "middleInitial", "]"}], ",", 
                   RowBox[{"DownValues", "[", "fullInitial", "]"}]}], "}"}]}],
                 ",", "\n", "      ", 
                RowBox[{"\"\<Numerics\>\"", "->", "numerics"}], ",", 
                
                RowBox[{"\"\<ParallelSettings\>\"", "->", 
                 "parallelSettings"}], ",", 
                RowBox[{"\"\<PlotSettings\>\"", "->", "plotSettings"}], ",", 
                "\n", "      ", 
                RowBox[{"\"\<Seconds\>\"", "->", "dynamicsSeconds"}], ",", 
                RowBox[{"\"\<Checks\>\"", "->", "checks"}], ",", "\n", 
                "      ", 
                
                RowBox[{"\"\<Notes\>\"", 
                 "->", "\"\<Pauli magnetizations; natural logs; reduced \
overlap is survival probability only for pure rhoAB0. Reduced entropy is \
bipartite entanglement only for a pure full state.\>\""}]}], "|>"}], ",", 
              "InputForm"}], "]"}], ",", "\"\<Text\>\""}], "]"}], ";", "\n", 
          "  ", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"TrueQ", "[", "saveData", "]"}], ",", 
            RowBox[{"XXZE`Save", "[", 
             RowBox[{
              RowBox[{"FileNameJoin", "[", 
               RowBox[{"{", 
                RowBox[{"dir", ",", "\"\<edge_dynamics.wxf\>\""}], "}"}], 
               "]"}], ",", "\n", "    ", 
              RowBox[{"<|", 
               RowBox[{
                RowBox[{"\"\<Model\>\"", "->", "model"}], ",", 
                RowBox[{"\"\<Delta\>\"", "->", "deltaFixed"}], ",", 
                RowBox[{"\"\<Checks\>\"", "->", "checks"}], ",", 
                RowBox[{"\"\<Results\>\"", "->", "dynamicsResults"}]}], 
               "|>"}], ",", "\"\<WXF\>\""}], "]"}]}], "]"}], ";", "\n", "  ", 
          RowBox[{"XXZE`DynamicsPlots", "[", 
           RowBox[{
           "dynamicsResults", ",", "model", ",", "deltaFixed", ",", 
            "timeSettings", ",", "plotSettings", ",", "dir"}], "]"}], ";", 
          "\n", "  ", 
          RowBox[{"Print", "[", 
           
           RowBox[{"\"\<Dynamics seconds=\>\"", ",", "dynamicsSeconds", 
            ",", "\"\<; checks=\>\"", ",", "checks"}], "]"}], ";", 
          RowBox[{"Print", "[", 
           RowBox[{"\"\<Saved: \>\"", ",", "dir"}], "]"}], ";", "\n", "  ", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Directory\>\"", "->", "dir"}], ",", 
            RowBox[{"\"\<Checks\>\"", "->", "checks"}], ",", 
            RowBox[{"\"\<GlobalPurity\>\"", "->", "purityFull"}]}], 
           "|>"}]}]}], "\n", "]"}], ",", "\"\<XXZFailure\>\""}], "]"}], ",", 
     RowBox[{"Missing", "[", "\"\<FixedEDFailed\>\"", "]"}]}], "]"}]}], 
  ";"}]], "Input",ExpressionUUID->"2fb422d3-b6b3-d54a-9c91-142f781994ce"]
}, Open  ]],

Cell[CellGroupData[{

Cell[" 8. Access results and reuse definitions ", "Section",ExpressionUUID->"1cacca58-d6f6-f544-b13f-437546f201b7"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"fixedED", "[", "\"\<Sectors\>\"", "]"}], "[", 
         RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Labels\>\"", "]"}], "\n", 
       "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"fixedED", "[", "\"\<Sectors\>\"", "]"}], "[", 
         RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<Eigenvalues\>\"", "]"}], "\n",
        "   ", 
       RowBox[{"XXZE`Eigenvector", "[", 
        RowBox[{"fixedED", ",", "k", ",", "r"}], "]"}], "                 ", 
       RowBox[{"(*", " ", 
        RowBox[{"Full", " ", 
         RowBox[{"2", "^", "L"}], " ", "vector"}], " ", "*)"}], "\n", "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"fixedED", "[", "\"\<Sectors\>\"", "]"}], "[", 
         RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<HalfEntropy\>\"", "]"}], "\n",
        "   ", 
       RowBox[{
        RowBox[{
         RowBox[{"fixedED", "[", "\"\<Sectors\>\"", "]"}], "[", 
         RowBox[{"[", "k", "]"}], "]"}], "[", "\"\<EdgesEntropy\>\"", "]"}], "\n",
        "   ", 
       RowBox[{
        RowBox[{"dynamicsResults", "[", 
         RowBox[{"[", "q", "]"}], "]"}], "[", "\"\<RhoAB\>\"", "]"}]}], " ", "//",
       " ", 
      RowBox[{"MatrixForm", "\n", "   ", 
       RowBox[{
        RowBox[{"dynamicsResults", "[", 
         RowBox[{"[", "q", "]"}], "]"}], "[", "\"\<RhoA\>\"", "]"}]}]}], " ", 
     "//", " ", 
     RowBox[{"MatrixForm", "\n", "   ", 
      RowBox[{
       RowBox[{"dynamicsResults", "[", 
        RowBox[{"[", "q", "]"}], "]"}], "[", "\"\<RhoB\>\"", "]"}]}]}], " ", "//",
     " ", 
    RowBox[{"MatrixForm", "\n", "   ", 
     RowBox[{
      RowBox[{"dynamicsResults", "[", 
       RowBox[{"[", "q", "]"}], "]"}], "[", "\"\<EigenvaluesAB\>\"", "]"}], "\n",
      "   ", 
     RowBox[{"XXZE`EdgesDensity", "[", 
      RowBox[{
       RowBox[{"XXZE`Eigenvector", "[", 
        RowBox[{"fixedED", ",", "k", ",", "r"}], "]"}], ",", 
       RowBox[{"model", "[", "\"\<L\>\"", "]"}]}], "]"}], "\n", "\n", "   ", 
     "Fresh", " ", "full", " ", "ED", " ", "at", " ", "another", " ", 
     "anisotropy"}]}], ",", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"without", " ", "changing", " ", 
      RowBox[{"plotting", "/", "state"}], " ", 
      RowBox[{"settings", ":", "\n", "   ", "otherED"}]}], "=", 
     RowBox[{"XXZE`Diagonalize", "[", 
      RowBox[{"1", ",", "model", ",", "numerics"}], "]"}]}], ";", "\n", "   ", 
    RowBox[{"otherED", "=", 
     RowBox[{"XXZE`EigenstateEntropies", "[", "otherED", "]"}]}], ";", "\n", 
    "   ", 
    RowBox[{
    "All", " ", "functions", " ", "are", " ", "globally", " ", "accessible", " ",
      "under", " ", "XXZE`"}], ";", " ", 
    RowBox[{"no", " ", 
     RowBox[{"Begin", "/", "End"}], " ", 
     RowBox[{"required", ".", "\n", "   ", "For"}], " ", "another", " ", 
     "initial", " ", "state", " ", "at", " ", "the", " ", "SAME", " ", 
     "model"}]}], ",", " ", 
   RowBox[{
   "edit", " ", "section", " ", "6", " ", "and", " ", "rerun", " ", "7.", "\n",
     "   ", "For", " ", "another", " ", "model", " ", "or", " ", 
    "deltaFixed"}], ",", " ", 
   RowBox[{"rerun", " ", "4", " ", "and", " ", "then", " ", 
    RowBox[{"5", "/", "7"}], " ", "as", " ", 
    RowBox[{"needed", "."}]}]}], "\n", "*)"}]], "Input",ExpressionUUID->\
"2bf252a5-8417-264f-ba3d-e8992ba5995f"]
