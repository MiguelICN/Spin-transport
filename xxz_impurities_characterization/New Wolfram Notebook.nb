Cell[CellGroupData[{

Cell["Diagonalizations", "Subsection",
 CellChangeTimes->{{4.0005230069872246`*^9, 4.0005230278477783`*^9}, {
  4.000523081234823*^9, 
  4.0005230878349667`*^9}},ExpressionUUID->"bddcd8a0-7fec-b24f-b303-\
327d93ff640d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"XXZE`Diagonalize", "[", 
    RowBox[{
     RowBox[{"delta_", "?", "NumericQ"}], ",", "p_Association", ",", 
     "num_Association"}], "]"}], " ", ":=", " ", 
   RowBox[{"Catch", "[", 
    RowBox[{
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"l", "=", 
          RowBox[{"p", "[", "\"\<L\>\"", "]"}]}], ",", "h", ",", "charges", ",",
          "active", ",", 
         RowBox[{"tol", "=", 
          RowBox[{"num", "[", "\"\<Tolerance\>\"", "]"}]}], ",", "scale", ",",
          "ids", ",", "hm", ",", "m", ",", "names", ",", "\n", "   ", 
         "spaces", ",", 
         RowBox[{"out", "=", 
          RowBox[{"{", "}"}]}], ",", "b", ",", "hs", ",", "e", ",", "v", ",", 
         "ord", ",", "groups", ",", "rows", ",", "residual", ",", "leak", ",",
          "records", ",", "orth"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"h", "=", 
         RowBox[{"XXZE`Hamiltonian", "[", 
          RowBox[{"delta", ",", "p"}], "]"}]}], ";", 
        RowBox[{"scale", "=", 
         RowBox[{"Max", "[", 
          RowBox[{"1.", ",", 
           RowBox[{"Norm", "[", 
            RowBox[{"h", ",", "Infinity"}], "]"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"charges", "=", 
         RowBox[{"XXZE`Charges", "[", 
          RowBox[{"l", ",", "delta", ",", "p"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"active", "=", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"Keys", "[", "charges", "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"XXZE`MaxAbs", "[", 
              RowBox[{
               RowBox[{"h", ".", 
                RowBox[{"charges", "[", "#", "]"}]}], "-", 
               RowBox[{
                RowBox[{"charges", "[", "#", "]"}], ".", "h"}]}], "]"}], "<", 
             RowBox[{"tol", " ", "scale"}]}], "&"}]}], "]"}]}], ";", "\n", 
        "  ", 
        RowBox[{"Do", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"m", "=", 
            RowBox[{
             RowBox[{"l", "/", "2"}], "-", "nDown"}]}], ";", "\n", "    ", 
           RowBox[{"ids", "=", 
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"Range", "[", 
               RowBox[{"2", "^", "l"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"Total", "[", 
                 RowBox[{"IntegerDigits", "[", 
                  RowBox[{
                   RowBox[{"#", "-", "1"}], ",", "2", ",", "l"}], "]"}], 
                 "]"}], "==", "nDown"}], "&"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"hm", "=", 
            RowBox[{"N", "[", 
             RowBox[{"Normal", "[", 
              RowBox[{"h", "[", 
               RowBox[{"[", 
                RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}]}], ";",
            "\n", "    ", 
           RowBox[{"names", "=", 
            RowBox[{"Select", "[", 
             RowBox[{"active", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"MemberQ", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"\"\<F\>\"", ",", "\"\<RF\>\""}], "}"}], ",", 
                   "#"}], "]"}]}], " ", "||", " ", 
                RowBox[{"m", "==", "0"}]}], "&"}]}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"names", "=", 
            RowBox[{"SortBy", "[", 
             RowBox[{"names", ",", 
              RowBox[{
               RowBox[{"Switch", "[", 
                RowBox[{"#", ",", 
                 RowBox[{"\"\<S2\>\"", "|", "\"\<StaggeredS2\>\""}], ",", "0",
                  ",", "\"\<R\>\"", ",", "1", ",", "_", ",", "2"}], "]"}], 
               "&"}]}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"spaces", "=", 
            RowBox[{"{", 
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Basis\>\"", "->", 
                RowBox[{"IdentityMatrix", "[", 
                 RowBox[{"Length", "[", "ids", "]"}], "]"}]}], ",", 
               RowBox[{"\"\<Labels\>\"", "->", 
                RowBox[{"<|", 
                 RowBox[{"\"\<m\>\"", "->", "m"}], "|>"}]}]}], "|>"}], 
             "}"}]}], ";", "\n", "    ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"spaces", "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"XXZE`SplitCharge", "[", 
                   RowBox[{"#", ",", 
                    RowBox[{"N", "[", 
                    RowBox[{"Normal", "[", 
                    RowBox[{
                    RowBox[{"charges", "[", "name", "]"}], "[", 
                    RowBox[{"[", 
                    RowBox[{"ids", ",", "ids"}], "]"}], "]"}], "]"}], "]"}], ",",
                     "\n", "        ", "name", ",", "tol"}], "]"}], "&"}], 
                 " ", "/@", " ", "spaces"}], ",", "1"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"name", ",", "names"}], "}"}]}], "]"}], ";", "\n", 
           "    ", 
           RowBox[{"Do", "[", "\n", "      ", 
            RowBox[{
             RowBox[{
              RowBox[{"b", "=", 
               RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ";", 
              RowBox[{"hs", "=", 
               RowBox[{"XXZE`Hermitian", "[", 
                RowBox[{
                 RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", "hm", ".",
                  "b"}], "]"}]}], ";", "\n", "      ", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"e", ",", "v"}], "}"}], "=", 
               RowBox[{"Eigensystem", "[", 
                RowBox[{"N", "[", "hs", "]"}], "]"}]}], ";", 
              RowBox[{"ord", "=", 
               RowBox[{"Ordering", "[", 
                RowBox[{"Re", "[", "e", "]"}], "]"}]}], ";", 
              RowBox[{"e", "=", 
               RowBox[{"Re", "[", 
                RowBox[{"e", "[", 
                 RowBox[{"[", "ord", "]"}], "]"}], "]"}]}], ";", 
              RowBox[{"v", "=", 
               RowBox[{"v", "[", 
                RowBox[{"[", "ord", "]"}], "]"}]}], ";", "\n", "      ", 
              RowBox[{"groups", "=", 
               RowBox[{"Gather", "[", 
