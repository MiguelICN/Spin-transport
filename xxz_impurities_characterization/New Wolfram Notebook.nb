          ",", "\"\<The sector dimensions are incomplete.\>\""}], "]"}], ";", 
        "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Delta\>\"", "->", "delta"}], ",", 
