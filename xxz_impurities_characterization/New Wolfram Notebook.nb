          "\n", "    ", 
          RowBox[{"\"\<MaxResidual\>\"", "->", 
           RowBox[{"Max", "[", 
            RowBox[{"Lookup", "[", 
             RowBox[{"out", ",", "\"\<Residual\>\""}], "]"}], "]"}]}]}], 
         "|>"}]}]}], "\n", "]"}], ",", "\"\<XXZFailure\>\""}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
