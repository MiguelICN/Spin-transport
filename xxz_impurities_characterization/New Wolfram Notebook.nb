 RowBox[{
  RowBox[{"model", " ", "=", " ", 
   RowBox[{"<|", "\n", "  ", 
    RowBox[{
     RowBox[{"\"\<L\>\"", " ", "->", " ", "6"}], ",", "                   ", 
