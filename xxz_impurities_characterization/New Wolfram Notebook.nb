           RowBox[{"{", 
            RowBox[{"s", ",", 
             RowBox[{"ed", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}]}], 
        ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Dimension\>\"", "->", 
           RowBox[{"Length", "[", "fac", "]"}]}], ",", 
          RowBox[{"\"\<Columns\>\"", "->", 
           RowBox[{
            RowBox[{"Dimensions", "[", "fac", "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<L\>\"", "->", 
           RowBox[{
            RowBox[{"ed", "[", "\"\<Parameters\>\"", "]"}], "[", "\"\<L\>\"", 
            "]"}]}], ",", 
          RowBox[{"\"\<Sectors\>\"", "->", "sectors"}]}], "|>"}]}]}], "\n", 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`Evolve", "[", 
      RowBox[{"t_", ",", "engine_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "a", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"0.", "+", 
            RowBox[{"0.", "I"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"engine", "[", "\"\<Dimension\>\"", "]"}], ",", 
             RowBox[{"engine", "[", "\"\<Columns\>\"", "]"}]}], "}"}]}], 
          "]"}]}], ";", "\n", "  ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"s", "[", "\"\<Indices\>\"", "]"}], ",", "All"}], "]"}],
             "]"}], " ", "+=", " ", 
           RowBox[{
            RowBox[{"s", "[", "\"\<V\>\"", "]"}], ".", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "I"}], " ", 
                RowBox[{"s", "[", "\"\<E\>\"", "]"}], " ", "t"}], "]"}], " ", 
              RowBox[{"s", "[", "\"\<C\>\"", "]"}]}], ")"}]}]}], ",", "\n", 
          "    ", 
          RowBox[{"{", 
           RowBox[{"s", ",", 
            RowBox[{"engine", "[", "\"\<Sectors\>\"", "]"}]}], "}"}]}], "]"}],
         ";", "a"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`Observables", "[", 
      RowBox[{"t_", ",", "rho_", ",", "rho0_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", "b", ",", "sa", ",", "sb", ",", "sab", ",", "z", ",", "x", ",",
          "ma", ",", "mb", ",", "e"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"a", "=", 
         RowBox[{"XXZE`TraceB", "[", "rho", "]"}]}], ";", 
        RowBox[{"b", "=", 
         RowBox[{"XXZE`TraceA", "[", "rho", "]"}]}], ";", "\n", "  ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"sa", ",", "sb", ",", "sab"}], "}"}], "=", 
         RowBox[{"XXZE`Entropy", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"a", ",", "b", ",", "rho"}], "}"}]}]}], ";", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "z"}], "}"}], "=", 
         RowBox[{"PauliMatrix", " ", "/@", " ", 
          RowBox[{"{", 
           RowBox[{"1", ",", "3"}], "}"}]}]}], ";", "\n", "  ", 
        RowBox[{"ma", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", ".", "a"}], "]"}], "]"}]}], ";", 
        RowBox[{"mb", "=", 
         RowBox[{"Re", "[", 
          RowBox[{"Tr", "[", 
           RowBox[{"z", ".", "b"}], "]"}], "]"}]}], ";", 
        RowBox[{"e", "=", 
         RowBox[{"Reverse", "[", 
          RowBox[{"Sort", "[", 
           RowBox[{"Re", "[", 
            RowBox[{"Eigenvalues", "[", 
             RowBox[{"XXZE`Hermitian", "[", "rho", "]"}], "]"}], "]"}], "]"}],
           "]"}]}], ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<Time\>\"", "->", "t"}], ",", 
          RowBox[{"\"\<RhoAB\>\"", "->", "rho"}], ",", 
          RowBox[{"\"\<RhoA\>\"", "->", "a"}], ",", 
          RowBox[{"\"\<RhoB\>\"", "->", "b"}], ",", 
          RowBox[{"\"\<EigenvaluesAB\>\"", "->", "e"}], ",", "\n", "    ", 
          RowBox[{"\"\<Purity\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"rho", ".", "rho"}], "]"}], "]"}]}], ",", 
          RowBox[{"\"\<EntropyA\>\"", "->", "sa"}], ",", 
          RowBox[{"\"\<EntropyB\>\"", "->", "sb"}], ",", 
          RowBox[{"\"\<EntropyAB\>\"", "->", "sab"}], ",", "\n", "    ", 
          RowBox[{"\"\<MutualInfo\>\"", "->", 
           RowBox[{"sa", "+", "sb", "-", "sab"}]}], ",", 
          RowBox[{"\"\<Concurrence\>\"", "->", 
           RowBox[{"XXZE`Concurrence", "[", "rho", "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<Negativity\>\"", "->", 
           RowBox[{"XXZE`Negativity", "[", "rho", "]"}]}], ",", 
          RowBox[{"\"\<InitialOverlap\>\"", "->", 
           RowBox[{"Re", "[", 
            RowBox[{"Tr", "[", 
             RowBox[{"rho0", ".", "rho"}], "]"}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<MagnetizationA\>\"", "->", "ma"}], ",", 
          RowBox[{"\"\<MagnetizationB\>\"", "->", "mb"}], ",", "\n", "    ", 
          RowBox[{"\"\<ConnectedZZ\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"z", ",", "z"}], "]"}], ".", "rho"}], "]"}], "]"}], "-", 
            RowBox[{"ma", " ", "mb"}]}]}], ",", "\n", "    ", 
          RowBox[{"\"\<ConnectedXX\>\"", "->", 
           RowBox[{
            RowBox[{"Re", "[", 
             RowBox[{"Tr", "[", 
              RowBox[{
               RowBox[{"KroneckerProduct", "[", 
                RowBox[{"x", ",", "x"}], "]"}], ".", "rho"}], "]"}], "]"}], "-", 
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", ".", "a"}], "]"}], "]"}], " ", 
             RowBox[{"Re", "[", 
              RowBox[{"Tr", "[", 
               RowBox[{"x", ".", "b"}], "]"}], "]"}]}]}]}], ",", "\n", "    ", 
          RowBox[{"\"\<TraceError\>\"", "->", 
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"Tr", "[", "rho", "]"}], "-", "1."}], "]"}]}], ",", "\n",
           "    ", 
          RowBox[{"\"\<HermiticityError\>\"", "->", 
           RowBox[{"Norm", "[", 
            RowBox[{
             RowBox[{"rho", "-", 
              RowBox[{"ConjugateTranspose", "[", "rho", "]"}]}], 
             ",", "\"\<Frobenius\>\""}], "]"}]}], ",", "\n", "    ", 
          RowBox[{"\"\<MinEigenvalue\>\"", "->", 
           RowBox[{"Last", "[", "e", "]"}]}]}], "|>"}]}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"14dfeaa1-37a0-4a4f-828f-44daf83b9261"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Time splitting for paralelization", "Subsection",
 CellChangeTimes->{{4.0005230069872246`*^9, 4.0005230278477783`*^9}, {
  4.000523114185911*^9, 
  4.0005231228619576`*^9}},ExpressionUUID->"645f0dfc-fdb0-5541-9d78-\
87e888907065"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"XXZE`TimeChunk", "[", 
    RowBox[{"times_", ",", "engine_", ",", "rho0_", ",", "tol_"}], "]"}], " ",
    ":=", " ", 
   RowBox[{"Catch", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", ",", "r", ",", "records"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"records", "=", 
         RowBox[{"Table", "[", "\n", "    ", 
          RowBox[{
           RowBox[{
            RowBox[{"a", "=", 
             RowBox[{"XXZE`Evolve", "[", 
              RowBox[{"t", ",", "engine"}], "]"}]}], ";", 
            RowBox[{"r", "=", 
             RowBox[{"XXZE`ReducedFactor", "[", 
              RowBox[{"a", ",", 
               RowBox[{"{", 
                RowBox[{"1", ",", 
                 RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "}"}], ",", 
               RowBox[{"engine", "[", "\"\<L\>\"", "]"}]}], "]"}]}], ";", 
            "\n", "    ", 
            RowBox[{"XXZE`Observables", "[", 
             RowBox[{"t", ",", "r", ",", "rho0"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "times"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<TraceError\>\""}], "]"}], "]"}], "<",
             "tol"}], " ", "&&", "\n", "    ", 
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<HermiticityError\>\""}], "]"}], 
             "]"}], "<", "tol"}], " ", "&&", "\n", "    ", 
           RowBox[{
            RowBox[{"Min", "[", 
             RowBox[{"Lookup", "[", 
              RowBox[{"records", ",", "\"\<MinEigenvalue\>\""}], "]"}], "]"}],
             ">=", 
            RowBox[{"-", "tol"}]}]}], ",", "\n", 
          "    ", "\"\<A reduced state failed trace, Hermiticity, or \
positivity validation.\>\""}], "]"}], ";", "\n", "  ", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<KernelID\>\"", "->", "$KernelID"}], ",", 
          RowBox[{"\"\<Results\>\"", "->", "records"}]}], "|>"}]}]}], "\n", 
      "]"}], ",", "\"\<XXZFailure\>\""}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"XXZE`TimeGrid", "[", "cfg_", "]"}], " ", ":=", " ", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "t", "}"}], ",", "\n", "  ", 
     RowBox[{
      RowBox[{"XXZE`Require", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"XXZE`RealQ", "[", 
          RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], " ", "&&", " ", 
         RowBox[{
          RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], ">", "0"}]}], 
        ",", "\"\<tMax must be positive.\>\""}], "]"}], ";", "\n", "  ", 
      RowBox[{"Switch", "[", 
       RowBox[{
        RowBox[{"cfg", "[", "\"\<Grid\>\"", "]"}], ",", "\n", 
        "    ", "\"\<Linear\>\"", ",", "\n", "      ", 
        RowBox[{
         RowBox[{"XXZE`Require", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"XXZE`RealQ", "[", 
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], "]"}], " ", "&&", " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], ">", "0"}]}], 
           ",", "\"\<dt must be positive.\>\""}], "]"}], ";", "\n", "      ", 
         RowBox[{"t", "=", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}], " ", 
            RowBox[{"Range", "[", 
             RowBox[{"0", ",", 
              RowBox[{"Floor", "[", 
               RowBox[{
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "/", 
                RowBox[{"cfg", "[", "\"\<dt\>\"", "]"}]}], "]"}]}], "]"}]}], 
           "]"}]}], ";", "\n", "      ", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Abs", "[", 
             RowBox[{
              RowBox[{"Last", "[", "t", "]"}], "-", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}], "<", 
            RowBox[{
             RowBox[{"10", "^", 
              RowBox[{"-", "12"}]}], " ", 
             RowBox[{"Max", "[", 
              RowBox[{"1.", ",", 
               RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], "]"}]}]}], ",", 
           "\n", "        ", 
           RowBox[{
            RowBox[{"t", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "=", 
            RowBox[{"N", "[", 
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], ",", 
           RowBox[{"AppendTo", "[", 
            RowBox[{"t", ",", 
             RowBox[{"N", "[", 
              RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}]}], "]"}]}], 
          "]"}], ";", "t"}], ",", "\n", "    ", "\"\<Log\>\"", ",", "\n", 
        "      ", 
        RowBox[{
         RowBox[{"XXZE`Require", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"XXZE`RealQ", "[", 
             RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], " ", "&&",
             "\n", "        ", 
            RowBox[{"0", "<", 
             RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "<", 
             RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}]}], " ", "&&", " ", 
            RowBox[{"IntegerQ", "[", 
             RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "]"}], " ", "&&",
             " ", 
            RowBox[{
             RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], ">=", "2"}]}], ",",
            "\n", "        ", "\"\<Log grid requires 0<tMinPositive<tMax and \
LogPoints>=2.\>\""}], "]"}], ";", "\n", "      ", 
         RowBox[{"Join", "[", 
          RowBox[{
           RowBox[{"{", "0.", "}"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{"Subdivide", "[", 
             RowBox[{
              RowBox[{"Log", "[", 
               RowBox[{"N", "[", 
                RowBox[{"cfg", "[", "\"\<tMinPositive\>\"", "]"}], "]"}], 
               "]"}], ",", 
              RowBox[{"Log", "[", 
               RowBox[{"N", "[", 
                RowBox[{"cfg", "[", "\"\<tMax\>\"", "]"}], "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"cfg", "[", "\"\<LogPoints\>\"", "]"}], "-", "1"}]}], 
             "]"}], "]"}]}], "]"}]}], ",", "\n", "    ", "_", ",", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{"False", ",", "\"\<Grid must be Linear or Log.\>\""}], 
         "]"}]}], "]"}]}]}], "\n", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  4.000522662367405*^9, {4.0005228222883244`*^9, 4.0005229055392056`*^9}, {
   4.0005229398217773`*^9, 4.0005229868019867`*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"cc0b365d-4bed-bb4f-acfb-cccbbf6b028e"]
}, Open  ]]
