Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Symmetries", " ", "and", " ", "deterministic", " ", "bases", " ", "in", " ",
     "degenerate", " ", 
    RowBox[{"eigenspaces", "."}]}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`CanonicalRows", "[", 
      RowBox[{"rows_", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p", ",", 
         RowBox[{"chosen", "=", 
          RowBox[{"{", "}"}]}], ",", "v"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "rows", "]"}], "==", "1"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"rows", "/", 
            RowBox[{"Norm", "[", 
             RowBox[{"First", "[", "rows", "]"}], "]"}]}], "]"}]}], "]"}], ";",
         "\n", "  ", 
        RowBox[{"p", "=", 
         RowBox[{
          RowBox[{"Transpose", "[", "rows", "]"}], ".", 
          RowBox[{"Conjugate", "[", "rows", "]"}]}]}], ";", "\n", "  ", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"v", "=", 
            RowBox[{"p", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "k"}], "]"}], "]"}]}], ";", "\n", "    ", 
           RowBox[{"Do", "[", 
            RowBox[{
             RowBox[{"v", "-=", 
              RowBox[{
               RowBox[{
                RowBox[{"Conjugate", "[", "w", "]"}], ".", "v"}], " ", 
               "w"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"w", ",", "chosen"}], "}"}]}], "]"}], ";", "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Norm", "[", "v", "]"}], ">", "tol"}], ",", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"chosen", ",", 
               RowBox[{"v", "/", 
                RowBox[{"Norm", "[", "v", "]"}]}]}], "]"}]}], "]"}], ";", 
           "\n", "    ", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", "chosen", "]"}], "==", 
              RowBox[{"Length", "[", "rows", "]"}]}], ",", 
             RowBox[{"Break", "[", "]"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", 
            RowBox[{"Length", "[", "p", "]"}]}], "}"}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"XXZE`Require", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "chosen", "]"}], "==", 
           RowBox[{"Length", "[", "rows", "]"}]}], 
          ",", "\"\<Degenerate eigenbasis construction failed.\>\""}], "]"}], 
        ";", "\n", "  ", "chosen"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`FixPhase", "[", 
      RowBox[{"v_", ",", "tol_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "k", "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"k", "=", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "v", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{"v", "[", 
               RowBox[{"[", "#", "]"}], "]"}], "]"}], ">", "tol"}], "&"}], ",",
            "1"}], "]"}]}], ";", 
        RowBox[{"v", " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", "I"}], " ", 
           RowBox[{"Arg", "[", 
            RowBox[{"v", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}]}], "]"}]}]}]}], "\n", 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`Charges", "[", 
      RowBox[{"l_Integer", ",", "delta_", ",", "p_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"d", "=", 
          RowBox[{"2", "^", "l"}]}], ",", "r", ",", "f", ",", "fields", ",", 
         RowBox[{"out", "=", 
          RowBox[{"<|", "|>"}]}], ",", "st", ",", "sx", ",", "sy", ",", 
         "sz"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{"fields", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{
           RowBox[{"p", "[", "\"\<h\>\"", "]"}], ",", "l"}], "]"}]}], ";", 
        "\n", "  ", 
        RowBox[{
         RowBox[{"fields", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+=", 
         RowBox[{"p", "[", "\"\<bLeft\>\"", "]"}]}], ";", 
        RowBox[{
         RowBox[{"fields", "[", 
          RowBox[{"[", 
           RowBox[{"-", "1"}], "]"}], "]"}], "+=", 
         RowBox[{"p", "[", "\"\<bRight\>\"", "]"}]}], ";", "\n", "  ", 
        RowBox[{"r", "=", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"1", "+", 
                 RowBox[{"FromDigits", "[", 
                  RowBox[{
                   RowBox[{"Reverse", "[", 
                    RowBox[{"IntegerDigits", "[", 
                    RowBox[{"k", ",", "2", ",", "l"}], "]"}], "]"}], ",", 
                   "2"}], "]"}]}], ",", 
                RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", "\n", 
             "    ", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"f", "=", 
         RowBox[{"SparseArray", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"d", "-", "k"}], ",", 
                RowBox[{"k", "+", "1"}]}], "}"}], "->", "1"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{"d", "-", "1"}]}], "}"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"d", ",", "d"}], "}"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"MapThread", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#1", "==", "#2"}], "]"}], "&"}], ",", 
             RowBox[{"{", 
              RowBox[{"fields", ",", 
               RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{"\"\<R\>\"", "->", "r"}]}], "]"}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"And", "@@", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"#", "==", "0"}], "]"}], "&"}], " ", "/@", " ", 
             "fields"}], ")"}]}], ",", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{"\"\<F\>\"", "->", "f"}]}], "]"}]}], "]"}], ";", "\n", 
        "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"And", "@@", 
            RowBox[{"MapThread", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{"#1", " ", "==", " ", 
                 RowBox[{"-", "#2"}]}], "]"}], "&"}], ",", 
              RowBox[{"{", 
               RowBox[{"fields", ",", 
                RowBox[{"Reverse", "[", "fields", "]"}]}], "}"}]}], "]"}]}], 
           " ", "&&", "\n", "    ", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"out", ",", "\"\<R\>\""}], "]"}], " ", "&&", " ", 
              RowBox[{"KeyExistsQ", "[", 
               RowBox[{"out", ",", "\"\<F\>\""}], "]"}]}], ")"}]}]}], ",", 
          RowBox[{"AssociateTo", "[", 
           RowBox[{"out", ",", 
            RowBox[{"\"\<RF\>\"", "->", 
             RowBox[{"r", ".", "f"}]}]}], "]"}]}], "]"}], ";", "\n", "  ", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"delta", "==", "1"}], "]"}], " ", "||", " ", 
             RowBox[{"TrueQ", "[", 
              RowBox[{"delta", " ", "==", " ", 
               RowBox[{"-", "1"}]}], "]"}]}], ")"}], " ", "&&", "\n", "    ", 
           RowBox[{"And", "@@", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"TrueQ", "[", 
                RowBox[{"#", "==", 
                 RowBox[{"First", "[", "fields", "]"}]}], "]"}], "&"}], " ", "/@",
               " ", "fields"}], ")"}]}]}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"st", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"TrueQ", "[", 
               RowBox[{"delta", "==", "1"}], "]"}], ",", 
              RowBox[{"ConstantArray", "[", 
               RowBox[{"1", ",", "l"}], "]"}], ",", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", 
                 RowBox[{"(", 
                  RowBox[{"k", "-", "1"}], ")"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"k", ",", "l"}], "}"}]}], "]"}]}], "]"}]}], ";", 
           "\n", "    ", 
           RowBox[{"sx", "=", 
            RowBox[{"Total", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"st", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], " ", 
                RowBox[{"XXZE`SiteOp", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"PauliMatrix", "[", "1", "]"}], "/", "2"}], ",", 
                  "k", ",", "l"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"sy", "=", 
            RowBox[{"Total", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"st", "[", 
                 RowBox[{"[", "k", "]"}], "]"}], " ", 
                RowBox[{"XXZE`SiteOp", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"PauliMatrix", "[", "2", "]"}], "/", "2"}], ",", 
                  "k", ",", "l"}], "]"}]}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"sz", "=", 
            RowBox[{"Total", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"XXZE`SiteOp", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"PauliMatrix", "[", "3", "]"}], "/", "2"}], ",", 
                 "k", ",", "l"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"k", ",", "l"}], "}"}]}], "]"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"AssociateTo", "[", 
            RowBox[{"out", ",", 
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"TrueQ", "[", 
                 RowBox[{"delta", "==", "1"}], "]"}], ",", "\"\<S2\>\"", 
                ",", "\"\<StaggeredS2\>\""}], "]"}], "->", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"sx", ".", "sx"}], "+", 
                RowBox[{"sy", ".", "sy"}], "+", 
                RowBox[{"sz", ".", "sz"}]}], ")"}]}]}], "]"}]}]}], "]"}], ";",
         "\n", "  ", "out"}]}], "\n", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"XXZE`SplitCharge", "[", 
      RowBox[{"s_", ",", "q_", ",", "name_", ",", "tol_"}], "]"}], " ", ":=", 
     " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"b", "=", 
          RowBox[{"s", "[", "\"\<Basis\>\"", "]"}]}], ",", "e", ",", "v", ",",
          "groups", ",", "label", ",", "rows"}], "}"}], ",", "\n", "  ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"e", ",", "v"}], "}"}], "=", 
         RowBox[{"Eigensystem", "[", 
          RowBox[{"N", "[", 
           RowBox[{"XXZE`Hermitian", "[", 
            RowBox[{
             RowBox[{"ConjugateTranspose", "[", "b", "]"}], ".", "q", ".", 
             "b"}], "]"}], "]"}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"groups", "=", 
         RowBox[{"Gather", "[", 
          RowBox[{
           RowBox[{"Range", "[", 
            RowBox[{"Length", "[", "e", "]"}], "]"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"Abs", "[", 
              RowBox[{
               RowBox[{"e", "[", 
                RowBox[{"[", "#1", "]"}], "]"}], "-", 
               RowBox[{"e", "[", 
                RowBox[{"[", "#2", "]"}], "]"}]}], "]"}], "<", "tol"}], 
            "&"}]}], "]"}]}], ";", "\n", "  ", 
        RowBox[{"Table", "[", "\n", "    ", 
         RowBox[{
          RowBox[{
           RowBox[{"rows", "=", 
            RowBox[{"XXZE`CanonicalRows", "[", 
             RowBox[{
              RowBox[{"Orthogonalize", "[", 
               RowBox[{"v", "[", 
                RowBox[{"[", "g", "]"}], "]"}], "]"}], ",", "tol"}], "]"}]}], 
           ";", "\n", "    ", 
           RowBox[{"label", "=", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<S2\>\"", ",", "\"\<StaggeredS2\>\""}], "}"}], ",",
                 "name"}], "]"}], ",", "\n", "      ", 
              RowBox[{"Round", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"-", "1"}], "+", 
                   RowBox[{"Sqrt", "[", 
                    RowBox[{"1", "+", 
                    RowBox[{"4", " ", 
                    RowBox[{"Re", "[", 
                    RowBox[{"Mean", "[", 
                    RowBox[{"e", "[", 
                    RowBox[{"[", "g", "]"}], "]"}], "]"}], "]"}]}]}], "]"}]}],
                   ")"}], "/", "2"}], ",", 
                RowBox[{"1", "/", "2"}]}], "]"}], ",", 
              RowBox[{"Round", "[", 
               RowBox[{"Re", "[", 
                RowBox[{"Mean", "[", 
