                 RowBox[{
                  RowBox[{
                   RowBox[{"Abs", "[", 
                    RowBox[{
                    RowBox[{"e", "[", 
                    RowBox[{"[", "#1", "]"}], "]"}], "-", 
                    RowBox[{"e", "[", 
                    RowBox[{"[", "#2", "]"}], "]"}]}], "]"}], "<", 
                   RowBox[{"tol", " ", "scale"}]}], "&"}]}], "]"}]}], ";", 
              "\n", "      ", 
              RowBox[{"Do", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"v", "[", 
                  RowBox[{"[", "g", "]"}], "]"}], "=", 
                 RowBox[{"XXZE`CanonicalRows", "[", 
                  RowBox[{
                   RowBox[{"Orthogonalize", "[", 
                    RowBox[{"v", "[", 
                    RowBox[{"[", "g", "]"}], "]"}], "]"}], ",", "tol"}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"g", ",", "groups"}], "}"}]}], "]"}], ";", "\n", 
              "      ", 
              RowBox[{"rows", "=", 
               RowBox[{"Transpose", "[", 
                RowBox[{"b", ".", 
                 RowBox[{"Transpose", "[", "v", "]"}]}], "]"}]}], ";", "\n", 
              "      ", 
              RowBox[{"rows", "=", 
               RowBox[{
                RowBox[{
                 RowBox[{"XXZE`FixPhase", "[", 
                  RowBox[{"#", ",", "tol"}], "]"}], "&"}], " ", "/@", " ", 
                "rows"}]}], ";", "\n", "      ", 
              RowBox[{"residual", "=", 
               RowBox[{"Max", "[", 
                RowBox[{"MapThread", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Norm", "[", 
                    RowBox[{
                    RowBox[{"hm", ".", "#2"}], "-", 
                    RowBox[{"#1", " ", "#2"}]}], "]"}], "&"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"e", ",", "rows"}], "}"}]}], "]"}], "]"}]}], ";", 
              "\n", "      ", 
              RowBox[{"orth", "=", 
               RowBox[{"XXZE`MaxAbs", "[", 
                RowBox[{
                 RowBox[{"rows", ".", 
                  RowBox[{"ConjugateTranspose", "[", "rows", "]"}]}], "-", 
                 RowBox[{"IdentityMatrix", "[", 
                  RowBox[{"Length", "[", "rows", "]"}], "]"}]}], "]"}]}], ";",
               "\n", "      ", 
              RowBox[{"leak", "=", 
               RowBox[{"XXZE`MaxAbs", "[", 
                RowBox[{
                 RowBox[{"hm", ".", "b"}], "-", 
                 RowBox[{"b", ".", "hs"}]}], "]"}]}], ";", "\n", "      ", 
              RowBox[{"XXZE`Require", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"residual", "<", 
                  RowBox[{"100", " ", "tol", " ", "scale"}]}], " ", "&&", " ", 
                 RowBox[{"leak", "<", 
                  RowBox[{"100", " ", "tol", " ", "scale"}]}], " ", "&&", " ", 
                 RowBox[{"orth", "<", 
                  RowBox[{"100", " ", "tol"}]}]}], ",", "\n", "        ", 
                RowBox[{"\"\<Sector eigenpairs failed validation: \>\"", "<>", 
                 RowBox[{"ToString", "[", 
                  RowBox[{
                   RowBox[{"s", "[", "\"\<Labels\>\"", "]"}], ",", 
                   "InputForm"}], "]"}]}]}], "]"}], ";", "\n", "      ", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"out", ",", 
                RowBox[{"<|", 
                 RowBox[{
                  RowBox[{"\"\<Labels\>\"", "->", 
                   RowBox[{"s", "[", "\"\<Labels\>\"", "]"}]}], ",", 
                  RowBox[{"\"\<Dimension\>\"", "->", 
