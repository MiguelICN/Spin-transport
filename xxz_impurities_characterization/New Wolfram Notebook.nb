Cell[" 6. Choose the initial state and time grid ", "Section",ExpressionUUID->"53ccf272-01d2-954b-8795-c5489739cf9f"],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
    RowBox[{
    "ONE", " ", "active", " ", "definition", " ", "per", " ", "state"}], ";", 
    " ", 
    RowBox[{
     RowBox[{"alternatives", " ", "below", " ", "are", " ", 
      RowBox[{"commented", ".", "\n", "   ", "Mode"}]}], "=", 
     RowBox[{"\"\<Factorized\>\"", ":", " ", 
      RowBox[{
      "edge", " ", "input", " ", "has", " ", "dimension", " ", "4"}]}]}], ";",
     " ", 
    RowBox[{
     RowBox[{
      RowBox[{"middle", " ", "input", " ", 
       RowBox[{
        RowBox[{"2", "^", 
         RowBox[{"(", 
          RowBox[{"L", "-", "2"}], ")"}]}], ".", "\n", "   ", "Each"}], " ", 
       "input", " ", "may", " ", "be", " ", "a", " ", "pure", " ", "vector", " ",
        "or", " ", "a", " ", "positive", " ", "trace"}], "-", 
      RowBox[{"one", " ", "density", " ", 
       RowBox[{"matrix", ".", "\n", "   ", "AB"}], " ", "may", " ", "be", " ",
        "internally", " ", 
       RowBox[{"entangled", ".", " ", "Mode"}]}]}], "=", 
     RowBox[{"\"\<Full\>\"", ":", " ", 
      RowBox[{"input", " ", "has", " ", "dimension", " ", 
       RowBox[{"2", "^", "L"}]}]}]}]}], ",", "\n", "   ", 
   RowBox[{"or", " ", "is", " ", "a", " ", 
    RowBox[{"2", "^", "L"}], " ", "x", " ", 
    RowBox[{"2", "^", "L"}], " ", "density", " ", "matrix"}], ",", " ", 
   RowBox[{
    RowBox[{"in", " ", "the", " ", "physical", " ", "site", " ", "order", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "...", ",", "L"}], "}"}], ".", "\n", "   ", "Full"}],
      " ", "mode", " ", "accepts", " ", "initially", " ", 
     RowBox[{"correlated", "/", "entangled"}], " ", "edges", " ", "and", " ", 
     RowBox[{"middle", ".", "\n", "   ", "delta"}], " ", "and", " ", "ed", " ",
      "are", " ", "supplied", " ", "to", " ", "all", " ", "generators"}], ";",
     " ", 
    RowBox[{"no", " ", "hidden", " ", "external", " ", "state", " ", 
     RowBox[{"cache", "."}]}]}]}], "\n", "*)"}]], "Input",
