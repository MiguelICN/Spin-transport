   "                      ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"Ha", ":", " ", 
    RowBox[{
     RowBox[{"2", "^", "L"}], " ", "x", " ", 
     RowBox[{"2", "^", "L"}], " ", "chain", " ", "Hamiltonian", " ", 
     RowBox[{"(", "numerical", ")"}]}]}], "                  ", "*)"}], "\n", 
  
  RowBox[{"(*", " ", 
   RowBox[{"beta", ":", " ", 
    RowBox[{"inverse", " ", "temperature", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"0", " ", "=", " ", 
        RowBox[{"infinite", " ", "T"}]}], ",", " ", 
       RowBox[{"Infinity", " ", "=", " ", 
        RowBox[{"T", "=", "0"}]}]}], ")"}]}]}], "   ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
   "===", "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
     "===", "===", "===", "===", "===", "===", "===", "===", "==="}], " ", 
   "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", "ThermalChainState", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"ThermalChainState", "[", 
      RowBox[{"Ha_", ",", " ", "beta_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", "\n", "  ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vals", ",", " ", "vecs", ",", " ", "weights", ",", " ", "Z"}], "}"}],
        ",", "\n", "  ", 
       RowBox[{"Which", "[", "\n", "    ", 
        RowBox[{"(*", " ", 
         RowBox[{"Infinite", " ", 
          RowBox[{"temperature", ":", " ", 
           RowBox[{"maximally", " ", "mixed", " ", "state"}]}]}], " ", "*)"}],
         "\n", "    ", 
        RowBox[{
         RowBox[{"beta", " ", "==", " ", "0."}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{"N", "[", 
           RowBox[{"IdentityMatrix", "[", 
            RowBox[{"Length", "[", "Ha", "]"}], "]"}], "]"}], " ", "/", " ", 
          RowBox[{"Length", "[", "Ha", "]"}]}], ",", "\n", "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"Zero", " ", 
           RowBox[{"temperature", ":", " ", 
            RowBox[{"ground", " ", "state", " ", "projector"}]}]}], " ", 
          "*)"}], "\n", "    ", 
         RowBox[{"beta", " ", "===", " ", "Infinity"}], ",", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"Eigensystem", "[", 
               RowBox[{"N", "[", "Ha", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "      ", 
          RowBox[{"Outer", "[", 
           RowBox[{"Times", ",", " ", 
            RowBox[{"vecs", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
            RowBox[{"Conjugate", "[", 
             RowBox[{"vecs", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], ",", "\n", 
         "\n", "    ", 
         RowBox[{"(*", " ", 
          RowBox[{"General", " ", 
           RowBox[{"case", ":", " ", 
            RowBox[{"Gibbs", " ", "state"}]}]}], " ", "*)"}], "\n", "    ", 
         "True", ",", "\n", "      ", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vals", ",", " ", "vecs"}], "}"}], " ", "=", " ", 
           RowBox[{"Transpose", "[", 
            RowBox[{"Sort", "[", 
             RowBox[{"Transpose", "[", 
              RowBox[{"Eigensystem", "[", 
               RowBox[{"N", "[", "Ha", "]"}], "]"}], "]"}], "]"}], "]"}]}], ";",
           "\n", "      ", 
          RowBox[{"(*", " ", 
           RowBox[{
            RowBox[{"Subtract", " ", 
             RowBox[{"Min", "[", "vals", "]"}], " ", "for", " ", "numerical", 
             " ", "stability"}], " ", "\[LongDash]", " ", 
            RowBox[{"cancels", " ", "in", " ", "ratio"}]}], " ", "*)"}], "\n",
           "      ", 
          RowBox[{"weights", " ", "=", " ", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"-", "beta"}], " ", "*", " ", 
             RowBox[{"(", 
              RowBox[{"vals", " ", "-", " ", 
               RowBox[{"Min", "[", "vals", "]"}]}], ")"}]}], "]"}]}], ";", 
          "\n", "      ", 
          RowBox[{"Z", " ", "=", " ", 
           RowBox[{"Total", "[", "weights", "]"}]}], ";", "\n", "      ", 
          RowBox[{
           RowBox[{"ConjugateTranspose", "[", "vecs", "]"}], " ", ".", " ", 
           RowBox[{"DiagonalMatrix", "[", 
            RowBox[{"N", "[", 
             RowBox[{"weights", " ", "/", " ", "Z"}], "]"}], "]"}], " ", ".", 
           " ", "vecs"}]}]}], "\n", "  ", "]"}]}], "\n", "]"}]}], 
    ";"}]}]}]], "Input",
