Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "Initial"}]}], " ", 
     RowBox[{"state", " ", "--"}]}], "-"}], " ", "*)"}], "\n", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Option", " ", 
     RowBox[{"A", ":", " ", 
      RowBox[{"Bell", " ", "state", " ", "on", " ", "spins"}]}]}], ",", " ", 
    RowBox[{"coherent", " ", "state", " ", "on", " ", "chain"}]}], 
   "          ", "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"bellState", " ", "=", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "1", ",", "1", ",", "0"}], "}"}], " ", "/", " ", 
      RowBox[{"Sqrt", "[", "2.", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rhoAB", "     ", "=", " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", " ", "bellState", ",", " ", 
       RowBox[{"Conjugate", "[", "bellState", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"rhoChain", "  ", "=", " ", 
      RowBox[{"Dyad", "[", 
       RowBox[{"coherentstate", "[", 
        RowBox[{
         RowBox[{"QubitStateFromBlochVector", "[", 
          RowBox[{"0.", ",", " ", "0"}], "]"}], ",", " ", "L"}], "]"}], 
       "]"}]}], ";"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"rhoChain", "  ", "=", " ", 
     RowBox[{"Dyad", "[", 
      RowBox[{"coherentstate", "[", 
       RowBox[{
        RowBox[{"QubitStateFromBlochVector", "[", 
         RowBox[{"1.", ",", " ", "0"}], "]"}], ",", " ", "L"}], "]"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rho0", "      ", "=", " ", 
     RowBox[{"BuildInitialStateCorrelated", "[", 
      RowBox[{"rhoAB", ",", " ", "rhoChain", ",", " ", "L"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"reference", " ", "for", " ", "spin", " ", "survival"}], " ", 
    "*)"}], "\n", 
