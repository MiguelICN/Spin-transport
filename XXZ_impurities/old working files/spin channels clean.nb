Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"ExtractTimeSeries", "[", "\"\<key\>\"", "]"}], " ", "gives", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t0", ",", "v0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t1", ",", "v1"}], "}"}], ",", "..."}], "}"}], " ", "ready", " ",
     "to", " ", "plot"}], " ", "*)"}], "\n", 
  RowBox[{
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"ExtractTimeSeries", "[", "\"\<Concurrence\>\"", "]"}], ",", 
     "\n", "  ", 
     RowBox[{"Frame", " ", "->", " ", "True"}], ",", " ", 
