              RowBox[{"Conjugate", "[", "phaseVec", "]"}], " ", ".", " ", 
              RowBox[{"(", 
               RowBox[{"absRhoE2", " ", ".", " ", "phaseVec"}], ")"}]}], 
             "]"}]}], ";", "\n", "    ", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "3.", " ", "Evolve", " ", "all", " ", "512", " ", "states", " ", 
             "simultaneously"}], " ", "*)"}], "\n", "    ", 
           RowBox[{"PsiEtMat", " ", "=", " ", 
            RowBox[{"phaseVec", " ", "*", " ", "PsiE0Mat"}]}], ";", "\n", 
           "    ", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "4.", " ", "Transform", " ", "all", " ", "states", " ", "to", " ",
              "position", " ", "basis", " ", "at", " ", "once", " ", "via", " ",
              "dense", " ", "BLAS"}], " ", "*)"}], "\n", "    ", 
           RowBox[{"PsiAbtMat", " ", "=", " ", 
            RowBox[{"Udag", " ", ".", " ", "PsiEtMat"}]}], ";", "\n", "    ", 
           "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
             RowBox[{"5.", " ", "Multi"}], "-", 
             RowBox[{
             "state", " ", "partial", " ", "trace", " ", "and", " ", 
              "ensemble", " ", "average", " ", "using", " ", "index", " ", 
              "maps"}]}], " ", "*)"}], "\n", "    ", 
           RowBox[{"M", " ", "=", " ", 
            RowBox[{"ArrayReshape", "[", "\n", "      ", 
             RowBox[{
              RowBox[{"Transpose", "[", 
               RowBox[{
                RowBox[{"ArrayReshape", "[", 
                 RowBox[{"PsiAbtMat", ",", " ", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", " ", 
                    RowBox[{"2", "^", "L"}], ",", " ", "2", ",", " ", 
                    "Nstates"}], "}"}]}], "]"}], ",", " ", 
                RowBox[{"{", 
                 RowBox[{"1", ",", " ", "3", ",", " ", "2", ",", " ", "4"}], 
                 "}"}]}], "]"}], ",", "\n", "      ", 
              RowBox[{"{", 
               RowBox[{"4", ",", " ", 
                RowBox[{
                 RowBox[{"2", "^", "L"}], " ", "*", " ", "Nstates"}]}], 
               "}"}]}], "\n", "    ", "]"}]}], ";", "\n", "    ", 
           RowBox[{"rhoAB", " ", "=", " ", 
            RowBox[{"M", " ", ".", " ", 
             RowBox[{"ConjugateTranspose", "[", "M", "]"}]}]}], ";", "\n", 
           "    ", "\n", "    ", 
           RowBox[{"(*", " ", 
            RowBox[{
            "6.", " ", "Compute", " ", "all", " ", "4", "x4", " ", "system", " ",
              "observables", " ", "exactly", " ", "as", " ", "before"}], " ", 
            "*)"}], "\n", "    ", 
           RowBox[{"obs", " ", "=", " ", 
            RowBox[{"ComputeAllObservables", "[", 
             RowBox[{"rhoAB", ",", " ", "rhoABref"}], "]"}]}], ";", "\n", 
           "    ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"<|", 
              RowBox[{
               RowBox[{"\"\<Time\>\"", " ", "->", " ", "t"}], ",", " ", 
               
               RowBox[{"\"\<SurvivalGlobal\>\"", " ", "->", " ", 
                "survGlobal"}]}], "|>"}], ",", " ", "obs"}], "]"}]}]}], "\n", 
         "  ", "]"}], ",", "\n", "  ", 
        RowBox[{"{", 
         RowBox[{"t", ",", " ", "tlist"}], "}"}], ",", "\n", "  ", 
        RowBox[{"DistributedContexts", " ", "->", " ", "None"}]}], "\n", 
       "]"}]}], ";"}], "]"}]}]}]], "Input",
